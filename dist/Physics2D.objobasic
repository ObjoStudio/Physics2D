Module Physics2D


# Axis-aligned bounding box, ported from upstream b2AABB in math_functions.h
# and src/aabb.c. Used by the broad phase, queries, and shape bounds.
#
# Both bounds are owned Vector2 objects. Factories build fresh boxes; the
# To-form of ray casting fills a caller-owned output.
Class AABB
## The lower bounds of the box.
Property LowerBound As Vector2
## The upper bounds of the box.
Property UpperBound As Vector2

## Creates a zero-area box at the origin.
Constructor()
Me.LowerBound = New Vector2(0.0, 0.0)
Me.UpperBound = New Vector2(0.0, 0.0)
End Constructor

## Creates a box from two corner vectors. The corners are copied.
Constructor(lower As Vector2, upper As Vector2)
Me.LowerBound = New Vector2(lower.X, lower.Y)
Me.UpperBound = New Vector2(upper.X, upper.Y)
End Constructor

## Copies another box.
Constructor(other As AABB)
Me.LowerBound = New Vector2(other.LowerBound.X, other.LowerBound.Y)
Me.UpperBound = New Vector2(other.UpperBound.X, other.UpperBound.Y)
End Constructor

## Returns True when the box bounds are finite and ordered, ported from
## upstream b2IsValidAABB.
Shared Function IsValid(a As AABB) As Boolean
If Not a.LowerBound.X.IsFinite() Or Not a.LowerBound.Y.IsFinite() Then
Return False
End If
If Not a.UpperBound.X.IsFinite() Or Not a.UpperBound.Y.IsFinite() Then
Return False
End If
Return a.UpperBound.X >= a.LowerBound.X And a.UpperBound.Y >= a.LowerBound.Y
End Function

## Returns True when the two boxes overlap, ported from upstream
## b2AABB_Overlaps.
Shared Function Overlaps(a As AABB, b As AABB) As Boolean
Return b.LowerBound.X <= a.UpperBound.X And b.UpperBound.X >= a.LowerBound.X And b.LowerBound.Y <= a.UpperBound.Y And b.UpperBound.Y >= a.LowerBound.Y
End Function

## Returns True when box a fully contains box b, ported from upstream
## b2AABB_Contains.
Shared Function Contains(a As AABB, b As AABB) As Boolean
Return b.LowerBound.X >= a.LowerBound.X And b.LowerBound.Y >= a.LowerBound.Y And b.UpperBound.X <= a.UpperBound.X And b.UpperBound.Y <= a.UpperBound.Y
End Function

## Returns the box centre as a new vector, ported from upstream
## b2AABB_Center.
Shared Function Center(a As AABB) As Vector2
Return New Vector2(0.5 * (a.LowerBound.X + a.UpperBound.X), 0.5 * (a.LowerBound.Y + a.UpperBound.Y))
End Function

## Returns the half-extents as a new vector, ported from upstream
## b2AABB_Extents.
Shared Function Extents(a As AABB) As Vector2
Return New Vector2(0.5 * (a.UpperBound.X - a.LowerBound.X), 0.5 * (a.UpperBound.Y - a.LowerBound.Y))
End Function

## Returns the union of two boxes as a new box, ported from upstream
## b2AABB_Union.
Shared Function Union(a As AABB, b As AABB) As AABB
Var result As New AABB
result.LowerBound.Set(Maths.Min(a.LowerBound.X, b.LowerBound.X), Maths.Min(a.LowerBound.Y, b.LowerBound.Y))
result.UpperBound.Set(Maths.Max(a.UpperBound.X, b.UpperBound.X), Maths.Max(a.UpperBound.Y, b.UpperBound.Y))
Return result
End Function

## Builds the smallest box containing the points inflated by radius, ported
## from upstream b2MakeAABB. The count must be positive and at most
## PhysicsConstants.MAX_POLYGON_VERTICES.
Shared Function Make(points() As Vector2, count As Integer, radius As Double) As AABB
Var result As New AABB
result.LowerBound.Set(points[0].X, points[0].Y)
result.UpperBound.Set(points[0].X, points[0].Y)
For i As Integer = 1 To count - 1
result.LowerBound.Set(Maths.Min(result.LowerBound.X, points[i].X), Maths.Min(result.LowerBound.Y, points[i].Y))
result.UpperBound.Set(Maths.Max(result.UpperBound.X, points[i].X), Maths.Max(result.UpperBound.Y, points[i].Y))
Next i
If radius > 0.0 Then
result.LowerBound.Set(result.LowerBound.X - radius, result.LowerBound.Y - radius)
result.UpperBound.Set(result.UpperBound.X + radius, result.UpperBound.Y + radius)
End If
Return result
End Function

## Returns the perimeter length of the box (twice width plus height), ported
## from upstream b2Perimeter. Used as the dynamic tree cost metric.
Shared Function Perimeter(a As AABB) As Double
Var wx As Double = a.UpperBound.X - a.LowerBound.X
Var wy As Double = a.UpperBound.Y - a.LowerBound.Y
Return 2.0 * (wx + wy)
End Function

## Returns the perimeter of the union of two boxes without constructing the
## union box, so hot tree code allocates nothing.
Shared Function UnionPerimeter(a As AABB, b As AABB) As Double
Var lowerX As Double = Maths.Min(a.LowerBound.X, b.LowerBound.X)
Var lowerY As Double = Maths.Min(a.LowerBound.Y, b.LowerBound.Y)
Var upperX As Double = Maths.Max(a.UpperBound.X, b.UpperBound.X)
Var upperY As Double = Maths.Max(a.UpperBound.Y, b.UpperBound.Y)
Return 2.0 * ((upperX - lowerX) + (upperY - lowerY))
End Function

## Expands box a in place to also contain box b and returns True when a grew,
## ported from upstream b2EnlargeAABB.
Shared Function Enlarge(a As AABB, b As AABB) As Boolean
Var changed As Boolean = False
If b.LowerBound.X < a.LowerBound.X Then
a.LowerBound.Set(b.LowerBound.X, a.LowerBound.Y)
changed = True
End If
If b.LowerBound.Y < a.LowerBound.Y Then
a.LowerBound.Set(a.LowerBound.X, b.LowerBound.Y)
changed = True
End If
If a.UpperBound.X < b.UpperBound.X Then
a.UpperBound.Set(b.UpperBound.X, a.UpperBound.Y)
changed = True
End If
If a.UpperBound.Y < b.UpperBound.Y Then
a.UpperBound.Set(a.UpperBound.X, b.UpperBound.Y)
changed = True
End If
Return changed
End Function

## Writes the union of boxes a and b into the caller-owned out box without
## allocating, and returns out. The reuse form of Union for warm tree and
## broad-phase code. Previous out contents are fully overwritten.
Shared Function UnionTo(a As AABB, b As AABB, out As AABB) As AABB
If a.LowerBound.X < b.LowerBound.X Then
out.LowerBound.Set(a.LowerBound.X, Maths.Min(a.LowerBound.Y, b.LowerBound.Y))
Else
out.LowerBound.Set(b.LowerBound.X, Maths.Min(a.LowerBound.Y, b.LowerBound.Y))
End If
If a.UpperBound.X > b.UpperBound.X Then
out.UpperBound.Set(a.UpperBound.X, Maths.Max(a.UpperBound.Y, b.UpperBound.Y))
Else
out.UpperBound.Set(b.UpperBound.X, Maths.Max(a.UpperBound.Y, b.UpperBound.Y))
End If
Return out
End Function

## Casts a ray from p1 to p2 against the box into a new output, ported from
## upstream b2AABB_RayCast following Real-time Collision Detection p179.
## Radii are not handled.
Shared Function RayCast(a As AABB, p1 As Vector2, p2 As Vector2) As CastOutput
Var result As New CastOutput
AABB.RayCastTo(a, p1, p2, result)
Return result
End Function

## Casts a ray from p1 to p2 against the box into the caller-owned out
## output and returns out. The reused-output form for warm loops. Previous
## output contents are fully overwritten.
Shared Function RayCastTo(a As AABB, p1 As Vector2, p2 As Vector2, out As CastOutput) As CastOutput
out.Normal.Set(0.0, 0.0)
out.Point.Set(0.0, 0.0)
out.Fraction = 0.0
out.Iterations = 0
out.Hit = False

Var tmin As Double = -1.7976931348623157e308
Var tmax As Double = 1.7976931348623157e308

Var dx As Double = p2.X - p1.X
Var dy As Double = p2.Y - p1.Y
Var absDx As Double = dx.Abs()
Var absDy As Double = dy.Abs()

Var normalX As Double = 0.0
Var normalY As Double = 0.0

# x-coordinate
Var eps As Double = 0.0000001192092896
If absDx < eps Then
# parallel
If p1.X < a.LowerBound.X Or a.UpperBound.X < p1.X Then
Return out
End If
Else
Var invD As Double = 1.0 / dx
Var t1 As Double = (a.LowerBound.X - p1.X) * invD
Var t2 As Double = (a.UpperBound.X - p1.X) * invD

# Sign of the normal vector.
Var s As Double = -1.0
If t1 > t2 Then
Var tmp As Double = t1
t1 = t2
t2 = tmp
s = 1.0
End If

# Push the min up.
If t1 > tmin Then
normalY = 0.0
normalX = s
tmin = t1
End If

# Pull the max down.
If t2 < tmax Then
tmax = t2
End If

If tmin > tmax Then
Return out
End If
End If

# y-coordinate
If absDy < eps Then
# parallel
If p1.Y < a.LowerBound.Y Or a.UpperBound.Y < p1.Y Then
Return out
End If
Else
Var invD As Double = 1.0 / dy
Var t1 As Double = (a.LowerBound.Y - p1.Y) * invD
Var t2 As Double = (a.UpperBound.Y - p1.Y) * invD

# Sign of the normal vector.
Var s As Double = -1.0
If t1 > t2 Then
Var tmp As Double = t1
t1 = t2
t2 = tmp
s = 1.0
End If

# Push the min up.
If t1 > tmin Then
normalX = 0.0
normalY = s
tmin = t1
End If

# Pull the max down.
If t2 < tmax Then
tmax = t2
End If

If tmin > tmax Then
Return out
End If
End If

# Does the ray start inside the box? Does it intersect beyond the segment?
If tmin < 0.0 Or 1.0 < tmin Then
Return out
End If

# Intersection.
out.Fraction = tmin
out.Normal.Set(normalX, normalY)
out.Point.Set(p1.X + tmin * dx, p1.Y + tmin * dy)
out.Hit = True
Return out
End Function
End Class

# Bit set over 64-bit words, ported from Box2D 3.1.1 bitset.c/bitset.h.
#
# Used by the engine to mark solver-set membership, enlarged proxies, and
# awake islands. Each word is one Objo Integer holding 64 bits; bit 63 is
# handled with two's-complement arithmetic, so no special case is needed.
#
# Layout mirrors upstream: Words.Count is the word capacity, WordCount is
# the number of words currently in use, and words above WordCount stay zero.
# After capacity warm-up, set/clear/get/union/collect allocate nothing;
# SetBitGrow and SetCountAndClear allocate only when capacity must grow.
Class BitSet
## Backing words. Its Count is the word capacity.
Property Words() As Integer
## Number of words currently in use in [0, WordCount).
Property WordCount As Integer

## Creates a set covering bit indices [0, bitCapacity) with all bits clear.
## Unlike upstream, which creates an empty set and calls SetBitCountAndClear
## before first use, the constructor makes the reserved range immediately
## usable; SetCountAndClear remains the step-loop reset path.
Constructor(bitCapacity As Integer)
Me.Words = New Array(Of Integer)
Me.WordCount = 0
Var wordCapacity As Integer = (bitCapacity + 63) \ 64
Me.ReserveWords(wordCapacity)
Me.WordCount = wordCapacity
End Constructor

## Sets the used word count for the given bit count and clears those words.
## Grows capacity with the upstream 1.5x policy when needed; capacity is
## otherwise retained so repeated steps reuse the same storage.
Sub SetCountAndClear(bitCount As Integer)
Var wordCount As Integer = (bitCount + 63) \ 64
If Me.Words.Count < wordCount Then
Me.ReserveWords(bitCount + (bitCount \ 2))
End If
Me.WordCount = wordCount
For i As Integer = 0 To Me.WordCount - 1
Me.Words[i] = 0
Next i
End Sub

## Sets one bit. The bit must be inside the current word count.
Sub SetBit(bitIndex As Integer)
Var wordIndex As Integer = bitIndex \ 64
Var bitMask As Integer = 1.ShiftLeft(bitIndex Mod 64)
If wordIndex >= Me.WordCount Then
Throw New InvalidArgumentException("BitSet.SetBit index outside word count")
End If
Me.Words[wordIndex] = Me.Words[wordIndex].BitOr(bitMask)
End Sub

## Sets one bit, growing the used word count (and capacity when needed).
Sub SetBitGrow(bitIndex As Integer)
Var wordIndex As Integer = bitIndex \ 64
Var bitMask As Integer = 1.ShiftLeft(bitIndex Mod 64)
If wordIndex >= Me.WordCount Then
Me.Grow(wordIndex + 1)
End If
Me.Words[wordIndex] = Me.Words[wordIndex].BitOr(bitMask)
End Sub

## Clears one bit. Clearing beyond the used word count does nothing,
## matching upstream.
Sub ClearBit(bitIndex As Integer)
Var wordIndex As Integer = bitIndex \ 64
Var bitMask As Integer = 1.ShiftLeft(bitIndex Mod 64)
If wordIndex >= Me.WordCount Then
Return
End If
Me.Words[wordIndex] = Me.Words[wordIndex].BitAnd(bitMask.BitNot())
End Sub

## Returns True when the bit is set. Bits beyond the used word count are clear.
Function GetBit(bitIndex As Integer) As Boolean
Var wordIndex As Integer = bitIndex \ 64
If wordIndex >= Me.WordCount Then
Return False
End If
Return Me.Words[wordIndex].BitAnd(1.ShiftLeft(bitIndex Mod 64)) <> 0
End Function

## Grows the used word count to exactly wordCount words (covering bits up to
## wordCount * 64 - 1), expanding capacity by the upstream 1.5x policy when
## required. Existing bits are preserved. Matches upstream b2GrowBitSet.
Sub Grow(wordCount As Integer)
If wordCount <= Me.WordCount Then
Throw New InvalidArgumentException("BitSet.Grow count must exceed current words")
End If
If Me.Words.Count < wordCount Then
Me.ReserveWords(wordCount + (wordCount \ 2))
End If
For i As Integer = Me.WordCount To wordCount - 1
Me.Words[i] = 0
Next i
Me.WordCount = wordCount
End Sub

## Union of other into this set in place. Both sets must have the same used
## word count, matching upstream b2InPlaceUnion.
Sub InPlaceUnion(other As BitSet)
If other.WordCount <> Me.WordCount Then
Throw New InvalidArgumentException("BitSet union word counts differ")
End If
For i As Integer = 0 To Me.WordCount - 1
Me.Words[i] = Me.Words[i].BitOr(other.Words[i])
Next i
End Sub

## Appends every set bit index, ascending, to the sink list without clearing
## it. Clear the sink first when reusing it across steps. Allocation-free
## once the sink has capacity.
Sub CollectSetBits(sink As IntegerList)
For i As Integer = 0 To Me.WordCount - 1
Var word As Integer = Me.Words[i]
While word <> 0
Var bit As Integer = PhysicsMaths.TrailingZeros(word)
sink.Append(i * 64 + bit)
word = word.BitAnd(word - 1)
Wend
Next i
End Sub

## Number of set bits.
Function CountSetBits() As Integer
Var tally As Integer = 0
For i As Integer = 0 To Me.WordCount - 1
Var word As Integer = Me.Words[i]
While word <> 0
word = word.BitAnd(word - 1)
tally = tally + 1
Wend
Next i
Return tally
End Function

## True when at least one bit is set.
Function AnySet() As Boolean
For i As Integer = 0 To Me.WordCount - 1
If Me.Words[i] <> 0 Then
Return True
End If
Next i
Return False
End Function

## Validates internal invariants: word bounds and zeroed words above WordCount.
Sub Validate()
If Me.WordCount < 0 Or Me.WordCount > Me.Words.Count Then
Throw New RuntimeException("BitSet word count outside capacity")
End If
For i As Integer = Me.WordCount To Me.Words.Count - 1
If Me.Words[i] <> 0 Then
Throw New RuntimeException("BitSet has bits above the used word count")
End If
Next i
End Sub

## Ensures room for wordCapacity words, extending with zeros when needed.
Private Sub ReserveWords(wordCapacity As Integer)
While Me.Words.Count < wordCapacity
Me.Words.Append(0)
Wend
End Sub
End Class

# Body façade, ported from upstream b2Body in body.h plus the b2Body_* API
# family in box2d.h. A body is owned by its world: the world stores one Body
# per slot in a sparse array, destruction reclaims the slot and increments
# the generation, and stale façades fail IsValid. The heavy lifecycle logic
# (solver-set moves, mass updates, proxy sync) lives on World; the façade
# delegates every mutation there.
#
# Contact, joint, and island bookkeeping arrives with Stages 7 and 9.
Class Body
## Owning world. Set at creation and never changed.
Property Owner As World
## Slot index of this body in the world body store.
Property Id As Integer
## Generation counter, incremented when the slot is freed and reused.
Property Generation As Integer
## Whether this body is live. Stale façades keep the object but flip this.
Property Live As Boolean
## Solver set index: 0 static, 1 disabled, 2 awake, 3+ sleeping sets.
Property SetIndex As Integer
## Dense-record index of this body inside its solver set.
Property LocalIndex As Integer
## Head of the doubly linked shape list.
Property HeadShapeId As Integer
## Number of shapes attached to this body.
Property ShapeCount As Integer
## Head of the doubly linked chain list.
Property HeadChainId As Integer
## Head of the doubly linked contact list as a contact edge key:
## (contactId << 1) | edgeIndex.
Property HeadContactKey As Integer
## Number of contacts attached to this body.
Property ContactCount As Integer
## Head of the doubly linked joint list as a joint edge key:
## (jointId << 1) | edgeIndex.
Property HeadJointKey As Integer
## Number of joints attached to this body.
Property JointCount As Integer
## Island this body belongs to. NULL_INDEX for static and disabled bodies.
Property IslandId As Integer
## Doubly linked island list: previous body.
Property IslandPrev As Integer
## Doubly linked island list: next body.
Property IslandNext As Integer
## Index of this body's moved-body event in the current step, or -1. Set by
## the finalize stage and consumed by island sleeping. Internal.
Property MoveEventIndex As Integer
## Total mass from shapes (kilograms). Overridden by SetMassData.
Property Mass As Double
## Rotational inertia about the centre of mass. Overridden by SetMassData.
Property Inertia As Double
## Below this speed a body may sleep (metres per second).
Property SleepThreshold As Double
## Time spent below the sleep threshold (seconds).
Property SleepTime As Double
## The body type.
Property Type As BodyType
## Whether this body may ever sleep.
Property EnableSleep As Boolean
## Whether rotation is locked.
Property FixedRotation As Boolean
## Whether the speed cap engaged in the last step.
Property IsSpeedCapped As Boolean
## Whether the body is marked during island traversal. Solver bookkeeping
## from Stage 7.
Property IsMarked As Boolean
## Optional body name, truncated to 31 characters like upstream.
Property Name As String
## User data owned by the application. Never read by the solver.
Property UserData As Object

## Creates an empty, unbound body. Only the world may construct live bodies;
## the zero-argument form exists for sparse array capacity.
Constructor()
Me.Owner = Nothing
Me.Id = PhysicsConstants.NULL_INDEX
Me.Generation = PhysicsConstants.INVALID_GENERATION
Me.Live = False
Me.SetIndex = PhysicsConstants.NULL_INDEX
Me.LocalIndex = PhysicsConstants.NULL_INDEX
Me.HeadShapeId = PhysicsConstants.NULL_INDEX
Me.ShapeCount = 0
Me.HeadChainId = PhysicsConstants.NULL_INDEX
Me.HeadContactKey = PhysicsConstants.NULL_INDEX
Me.ContactCount = 0
Me.HeadJointKey = PhysicsConstants.NULL_INDEX
Me.JointCount = 0
Me.IslandId = PhysicsConstants.NULL_INDEX
Me.IslandPrev = PhysicsConstants.NULL_INDEX
Me.IslandNext = PhysicsConstants.NULL_INDEX
Me.MoveEventIndex = -1
Me.Mass = 0.0
Me.Inertia = 0.0
Me.SleepThreshold = 0.0
Me.SleepTime = 0.0
Me.Type = BodyType.StaticBody
Me.EnableSleep = True
Me.FixedRotation = False
Me.IsSpeedCapped = False
Me.IsMarked = False
Me.Name = ""
Me.UserData = Nothing
End Constructor

## Returns True when this façade still addresses a live body.
Function IsValid() As Boolean
If Me.Owner = Nothing Or Not Me.Live Then
Return False
End If
Return Me.Owner.Bodies[Me.Id] = Me
End Function

## Throws a descriptive exception when this façade is stale. All mutating
## and reading members call this first.
Sub Validate()
If Not Me.IsValid() Then
Throw New RuntimeException("Body façade is no longer valid")
End If
End Sub

## Returns the owning world façade.
Function GetWorld() As World
Me.Validate()
Return Me.Owner
End Function

## The body type. Named GetBodyType because every Objo object already has a
## GetType method from the root class.
Function GetBodyType() As BodyType
Me.Validate()
Return Me.Type
End Function

## The body name.
Function GetName() As String
Me.Validate()
Return Me.Name
End Function

## Sets the body name, truncated to 31 characters like upstream.
Sub SetName(name As String)
Me.Validate()
If name = Nothing Then
Me.Name = ""
Return
End If
If name.Length > 31 Then
Me.Name = name.Substring(0, 31)
Return
End If
Me.Name = name
End Sub

## User data owned by the application. Never read by the solver.
Function GetUserData() As Object
Me.Validate()
Return Me.UserData
End Function

## Sets user data owned by the application.
Sub SetUserData(userData As Object)
Me.Validate()
Me.UserData = userData
End Sub

## The world position of the body origin.
Function GetPosition() As Vector2
Me.Validate()
Return Me.Owner.GetBodyTransform(Me).P
End Function

## The world rotation of the body.
Function GetRotation() As Rot
Me.Validate()
Return Me.Owner.GetBodyTransform(Me).Q
End Function

## The world transform of the body origin. The result is a copy.
Function GetTransform() As Transform
Me.Validate()
Return Me.Owner.GetBodyTransform(Me)
End Function

## Converts a world point to the body frame, ported from
## b2Body_GetLocalPoint.
Function GetLocalPoint(worldPoint As Vector2) As Vector2
Me.Validate()
Return Transform.InvTransformPoint(Me.Owner.GetBodyTransform(Me), worldPoint)
End Function

## Converts a local point to the world frame, ported from
## b2Body_GetWorldPoint.
Function GetWorldPoint(localPoint As Vector2) As Vector2
Me.Validate()
Return Transform.TransformPoint(Me.Owner.GetBodyTransform(Me), localPoint)
End Function

## Converts a world vector to the body frame, ported from
## b2Body_GetLocalVector.
Function GetLocalVector(worldVector As Vector2) As Vector2
Me.Validate()
Return Rot.InvRotateVector(Me.Owner.GetBodyTransform(Me).Q, worldVector)
End Function

## Converts a local vector to the world frame, ported from
## b2Body_GetWorldVector.
Function GetWorldVector(localVector As Vector2) As Vector2
Me.Validate()
Return Rot.RotateVector(Me.Owner.GetBodyTransform(Me).Q, localVector)
End Function

## Teleports the body to a new transform and refreshes shape proxies,
## ported from b2Body_SetTransform. Rejected while the world is locked.
Sub SetTransform(position As Vector2, rotation As Rot)
Me.Validate()
Me.Owner.SetBodyTransform(Me, position, rotation)
End Sub

## The linear velocity of the centre of mass.
Function GetLinearVelocity() As Vector2
Me.Validate()
Return Me.Owner.GetBodyLinearVelocity(Me)
End Function

## Sets the linear velocity of the centre of mass, waking the body for a
## non-zero velocity, ported from b2Body_SetLinearVelocity.
Sub SetLinearVelocity(linearVelocity As Vector2)
Me.Validate()
Me.Owner.SetBodyLinearVelocity(Me, linearVelocity)
End Sub

## The angular velocity in radians per second.
Function GetAngularVelocity() As Double
Me.Validate()
Return Me.Owner.GetBodyAngularVelocity(Me)
End Function

## Sets the angular velocity in radians per second, waking the body for a
## non-zero velocity, ported from b2Body_SetAngularVelocity.
Sub SetAngularVelocity(angularVelocity As Double)
Me.Validate()
Me.Owner.SetBodyAngularVelocity(Me, angularVelocity)
End Sub

## Drives the body towards the target transform over the given time step,
## ported from b2Body_SetTargetTransform. Ignored for static bodies and
## non-positive time steps.
Sub SetTargetTransform(target As Transform, timeStep As Double)
Me.Validate()
Me.Owner.SetBodyTargetTransform(Me, target, timeStep)
End Sub

## Velocity of a point in the body frame, ported from
## b2Body_GetLocalPointVelocity.
Function GetLocalPointVelocity(localPoint As Vector2) As Vector2
Me.Validate()
Return Me.Owner.GetBodyLocalPointVelocity(Me, localPoint)
End Function

## Velocity of a world point attached to the body, ported from

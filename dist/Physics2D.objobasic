# Joint constraint solver, ported from the prepare/warm-start/solve bodies in
# joint.c and distance_joint.c. The dispatch collapses upstream's function
# tables into type checks on the store's Type column; the per-family maths is
# a direct scalar port in the ContactSolver idiom, reading and writing the
# JointSims columns of one row. The overflow colour runs its own entry points
# so the solve order matches upstream's serial overflow work.
Class JointSolver
## Prepares one joint row for the step, ported from b2PrepareJoint. Clamps
## the solver hertz against the substep rate before refreshing softness.
Shared Sub PrepareJoint(sims As JointSims, index As Integer, context As StepContext)
Var hertz As Double = sims.ConstraintHertz.Items[index]
If hertz > 0.25 * context.InvH Then
hertz = 0.25 * context.InvH
End If
Softness.MakeTo(hertz, sims.ConstraintDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.SoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.SoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.SoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale
If sims.Type.Items[index] = Integer(JointType.DistanceJoint) Then
PrepareDistanceJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.MouseJoint) Then
PrepareMouseJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.MotorJoint) Then
PrepareMotorJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.RevoluteJoint) Then
PrepareRevoluteJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.PrismaticJoint) Then
PreparePrismaticJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.WeldJoint) Then
PrepareWeldJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.WheelJoint) Then
PrepareWheelJoint(sims, index, context)
End If
End Sub

## Prepares one distance joint row, ported from b2PrepareDistanceJoint.
Private Shared Sub PrepareDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Initial anchors in world space relative to the body centres.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY
sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]

Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var sepX As Double = sims.DeltaCenterX.Items[index] + rBX - rAX
Var sepY As Double = sims.DeltaCenterY.Items[index] + rBY - rAY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

# Compute effective mass.
Var crA As Double = rAX * axisY - rAY * axisX
Var crB As Double = rBX * axisY - rBY * axisX
Var k As Double = sims.InvMassA.Items[index] + sims.InvMassB.Items[index] + sims.InvIA.Items[index] * crA * crA + sims.InvIB.Items[index] * crB * crB
If k > 0.0 Then
sims.AxialMass.Items[index] = 1.0 / k
Else
sims.AxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.Hertz.Items[index], sims.DampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.DistanceSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.DistanceSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.DistanceSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.Impulse.Items[index] = 0.0
sims.LowerImpulse.Items[index] = 0.0
sims.UpperImpulse.Items[index] = 0.0
sims.MotorImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored impulses to the body states before iterating, ported from
## b2WarmStartDistanceJoint.
Shared Sub WarmStartDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]

Var dsX As Double = dpBX - dpAX + rBX - rAX
Var dsY As Double = dpBY - dpAY + rBY - rAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

Var axialImpulse As Double = sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]
Var pX As Double = axialImpulse * axisX
Var pY As Double = axialImpulse * axisY

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = states.LVX.Items[indexA] - mA * pX
states.LVY.Items[indexA] = states.LVY.Items[indexA] - mA * pY
states.AngularVelocity.Items[indexA] = states.AngularVelocity.Items[indexA] - iA * (rAX * pY - rAY * pX)
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = states.LVX.Items[indexB] + mB * pX
states.LVY.Items[indexB] = states.LVY.Items[indexB] + mB * pY
states.AngularVelocity.Items[indexB] = states.AngularVelocity.Items[indexB] + iB * (rBX * pY - rBY * pX)
End If
End Sub

## Runs one velocity iteration with optional soft-step bias, ported from
## b2SolveDistanceJoint.
Shared Sub SolveDistanceJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Current anchors and separation. The scratch record is reused across
# every joint solve within a step, ported from the C stack locals of
# b2SolveDistanceJoint. The axis is reset first: with coincident anchors
# the separation is degenerate, and a stale axis from a previously solved
# joint would apply impulses along a phantom direction.
Var scratch As DistanceJointScratch = context.JointScratch
scratch.RAX = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
scratch.RAY = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
scratch.RBX = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
scratch.RBY = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dsX As Double = dpBX - dpAX + scratch.RBX - scratch.RAX
Var dsY As Double = dpBY - dpAY + scratch.RBY - scratch.RAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
scratch.AxisX = 0.0
scratch.AxisY = 0.0
scratch.Length = Maths.Sqrt(sepX * sepX + sepY * sepY)
If scratch.Length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / scratch.Length
scratch.AxisX = invLength * sepX
scratch.AxisY = invLength * sepY
End If

Var vrX As Double = vBX - wB * scratch.RBY - (vAX - wA * scratch.RAY)
Var vrY As Double = vBY + wB * scratch.RBX - (vAY + wA * scratch.RAX)
Var vDotAxis As Double = vrX * scratch.AxisX + vrY * scratch.AxisY

If sims.EnableSpring.Items[index] = 1 And (sims.MinLength.Items[index] < sims.MaxLength.Items[index] Or sims.EnableLimit.Items[index] = 0) Then
# Soft constraint with spring, limits, and motor.
If sims.Hertz.Items[index] > 0.0 Then
Var C As Double = scratch.Length - sims.Length.Items[index]
Var bias As Double = sims.DistanceSoftnessBiasRate.Items[index] * C
Var m As Double = sims.DistanceSoftnessMassScale.Items[index] * sims.AxialMass.Items[index]
Var impulse As Double = -m * (vDotAxis + bias) - sims.DistanceSoftnessImpulseScale.Items[index] * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If sims.EnableLimit.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceLowerLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
SolveDistanceUpperLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If

If sims.EnableMotor.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceMotor(scratch, sims, index, context, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If
Else
# Rigid constraint.
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
bias = sims.SoftnessBiasRate.Items[index] * (scratch.Length - sims.Length.Items[index])
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

Var impulse As Double = -massScale * sims.AxialMass.Items[index] * (vDotAxis + bias) - impulseScale * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Solves the lower length limit of a soft distance joint, ported from the
## lower-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceLowerLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var lowerCdot As Double = vrX * scratch.AxisX + vrY * scratch.AxisY
Var lowerC As Double = scratch.Length - sims.MinLength.Items[index]
Var lowerBias As Double = 0.0
Var lowerMassCoeff As Double = 1.0
Var lowerImpulseCoeff As Double = 0.0
If lowerC > 0.0 Then
# Speculative.
lowerBias = lowerC * context.InvH
ElseIf useBias Then
lowerBias = sims.SoftnessBiasRate.Items[index] * lowerC
lowerMassCoeff = sims.SoftnessMassScale.Items[index]
lowerImpulseCoeff = sims.SoftnessImpulseScale.Items[index]
End If
Var lowerImpulse As Double = -lowerMassCoeff * sims.AxialMass.Items[index] * (lowerCdot + lowerBias) - lowerImpulseCoeff * sims.LowerImpulse.Items[index]
Var newLowerImpulse As Double = sims.LowerImpulse.Items[index] + lowerImpulse
If newLowerImpulse < 0.0 Then
newLowerImpulse = 0.0
End If
lowerImpulse = newLowerImpulse - sims.LowerImpulse.Items[index]
sims.LowerImpulse.Items[index] = newLowerImpulse

Var lowerPX As Double = lowerImpulse * scratch.AxisX
Var lowerPY As Double = lowerImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * lowerPX
scratch.VAY = scratch.VAY - mA * lowerPY
scratch.WA = scratch.WA - iA * (scratch.RAX * lowerPY - scratch.RAY * lowerPX)
scratch.VBX = scratch.VBX + mB * lowerPX
scratch.VBY = scratch.VBY + mB * lowerPY
scratch.WB = scratch.WB + iB * (scratch.RBX * lowerPY - scratch.RBY * lowerPX)
End Sub

## Solves the upper length limit of a soft distance joint, ported from the
## upper-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceUpperLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrUX As Double = scratch.VAX - scratch.WA * scratch.RAY - (scratch.VBX - scratch.WB * scratch.RBY)
Var vrUY As Double = scratch.VAY + scratch.WA * scratch.RAX - (scratch.VBY + scratch.WB * scratch.RBX)
Var upperCdot As Double = vrUX * scratch.AxisX + vrUY * scratch.AxisY
Var upperC As Double = sims.MaxLength.Items[index] - scratch.Length
Var upperBias As Double = 0.0
Var upperMassScale As Double = 1.0
Var upperImpulseScale As Double = 0.0
If upperC > 0.0 Then
# Speculative.
upperBias = upperC * context.InvH
ElseIf useBias Then
upperBias = sims.SoftnessBiasRate.Items[index] * upperC
upperMassScale = sims.SoftnessMassScale.Items[index]
upperImpulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var upperImpulse As Double = -upperMassScale * sims.AxialMass.Items[index] * (upperCdot + upperBias) - upperImpulseScale * sims.UpperImpulse.Items[index]
Var newUpperImpulse As Double = sims.UpperImpulse.Items[index] + upperImpulse
If newUpperImpulse < 0.0 Then
newUpperImpulse = 0.0
End If
upperImpulse = newUpperImpulse - sims.UpperImpulse.Items[index]
sims.UpperImpulse.Items[index] = newUpperImpulse

Var upperPX As Double = -upperImpulse * scratch.AxisX
Var upperPY As Double = -upperImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * upperPX
scratch.VAY = scratch.VAY - mA * upperPY
scratch.WA = scratch.WA - iA * (scratch.RAX * upperPY - scratch.RAY * upperPX)
scratch.VBX = scratch.VBX + mB * upperPX
scratch.VBY = scratch.VBY + mB * upperPY
scratch.WB = scratch.WB + iB * (scratch.RBX * upperPY - scratch.RBY * upperPX)
End Sub

## Solves the distance joint motor, ported from the motor block of
## b2SolveDistanceJoint.
Private Shared Sub SolveDistanceMotor(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrMX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrMY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var motorCdot As Double = vrMX * scratch.AxisX + vrMY * scratch.AxisY
Var motorImpulse As Double = sims.AxialMass.Items[index] * (sims.MotorSpeed.Items[index] - motorCdot)
Var oldMotorImpulse As Double = sims.MotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.MaxMotorForce.Items[index]
Var newMotorImpulse As Double = sims.MotorImpulse.Items[index] + motorImpulse
If newMotorImpulse > maxImpulse Then
newMotorImpulse = maxImpulse
ElseIf newMotorImpulse < -maxImpulse Then
newMotorImpulse = -maxImpulse
End If
sims.MotorImpulse.Items[index] = newMotorImpulse
motorImpulse = newMotorImpulse - oldMotorImpulse

Var motorPX As Double = motorImpulse * scratch.AxisX
Var motorPY As Double = motorImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * motorPX
scratch.VAY = scratch.VAY - mA * motorPY
scratch.WA = scratch.WA - iA * (scratch.RAX * motorPY - scratch.RAY * motorPX)
scratch.VBX = scratch.VBX + mB * motorPX
scratch.VBY = scratch.VBY + mB * motorPY
scratch.WB = scratch.WB + iB * (scratch.RBX * motorPY - scratch.RBY * motorPX)
End Sub

## Prepares one mouse joint row, ported from b2PrepareMouseJoint. Only body
## B matters: body A is assumed static and is never touched by the solver.
## The linear mass is the inverse of the symmetric 2x2 body-B constraint
## matrix, stored as three scalars because the matrix is symmetric by
## construction. Upstream asserts body B is awake; rows outside the graph
## are never prepared in this port, and a non-awake body B yields a
## NULL_INDEX state row that the warm-start and solve kernels skip.
Private Shared Sub PrepareMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

Var localDX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localDY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localDX - qsB * localDY
sims.AnchorBY.Items[index] = qsB * localDX + qcB * localDY

Softness.MakeTo(sims.MouseHertz.Items[index], sims.MouseDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.MouseLinearSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.MouseLinearSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.MouseLinearSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

# Upstream fixes the angular softness at 0.5 Hz with a 0.1 damping ratio
# to reduce the dragged body's spin without fighting user torque.
Softness.MakeTo(0.5, 0.1, context.H, context.SoftnessScratch)
sims.MouseAngularSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.MouseAngularSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.MouseAngularSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var k11 As Double = mB + iB * rBY * rBY
Var k12 As Double = -iB * rBX * rBY
Var k22 As Double = mB + iB * rBX * rBX
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
sims.MouseLinearMassXX.Items[index] = det * k22
sims.MouseLinearMassXY.Items[index] = -det * k12
sims.MouseLinearMassYY.Items[index] = det * k11
sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - sims.MouseTargetX.Items[index]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - sims.MouseTargetY.Items[index]

If context.WarmStartScale = 0.0 Then
sims.MouseLinearImpulseX.Items[index] = 0.0
sims.MouseLinearImpulseY.Items[index] = 0.0
sims.MouseAngularImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored mouse joint impulses to body B before iterating, ported
## from b2WarmStartMouseJoint.
Shared Sub WarmStartMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var indexB As Integer = sims.IndexB.Items[index]
If indexB = PhysicsConstants.NULL_INDEX Then
Return
End If
Var states As BodyStates = context.States
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var dqBC As Double = states.DRC.Items[indexB]
Var dqBS As Double = states.DRS.Items[indexB]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.MouseLinearImpulseX.Items[index]
Var pY As Double = sims.MouseLinearImpulseY.Items[index]
states.LVX.Items[indexB] = states.LVX.Items[indexB] + mB * pX
states.LVY.Items[indexB] = states.LVY.Items[indexB] + mB * pY
states.AngularVelocity.Items[indexB] = states.AngularVelocity.Items[indexB] + iB * (rBX * pY - rBY * pX + sims.MouseAngularImpulse.Items[index])
End Sub

## Runs one velocity iteration for one mouse joint row, ported from
## b2SolveMouseJoint. Upstream ignores the bias flag: the mouse joint is a
## soft constraint whose bias comes from its own spring softness.
Shared Sub SolveMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var indexB As Integer = sims.IndexB.Items[index]
If indexB = PhysicsConstants.NULL_INDEX Then
Return
End If
Var states As BodyStates = context.States
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var vBX As Double = states.LVX.Items[indexB]
Var vBY As Double = states.LVY.Items[indexB]
Var wB As Double = states.AngularVelocity.Items[indexB]

# Soft angular damping with no bias term to reduce rotation speed.
Var angularImpulse As Double = 0.0
If iB > 0.0 Then
angularImpulse = -wB / iB
End If
angularImpulse = sims.MouseAngularSoftnessMassScale.Items[index] * angularImpulse - sims.MouseAngularSoftnessImpulseScale.Items[index] * sims.MouseAngularImpulse.Items[index]
sims.MouseAngularImpulse.Items[index] = sims.MouseAngularImpulse.Items[index] + angularImpulse
wB = wB + iB * angularImpulse

Var maxImpulse As Double = sims.MouseMaxForce.Items[index] * context.H
Var dqBC As Double = states.DRC.Items[indexB]
Var dqBS As Double = states.DRS.Items[indexB]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var cdotX As Double = vBX - wB * rBY
Var cdotY As Double = vBY + wB * rBX
Var sepX As Double = states.DPX.Items[indexB] + rBX + sims.DeltaCenterX.Items[index]
Var sepY As Double = states.DPY.Items[indexB] + rBY + sims.DeltaCenterY.Items[index]
Var biasRate As Double = sims.MouseLinearSoftnessBiasRate.Items[index]
Var rhsX As Double = cdotX + biasRate * sepX
Var rhsY As Double = cdotY + biasRate * sepY
Var bX As Double = sims.MouseLinearMassXX.Items[index] * rhsX + sims.MouseLinearMassXY.Items[index] * rhsY
Var bY As Double = sims.MouseLinearMassXY.Items[index] * rhsX + sims.MouseLinearMassYY.Items[index] * rhsY
Var massScale As Double = sims.MouseLinearSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.MouseLinearSoftnessImpulseScale.Items[index]
Var oldX As Double = sims.MouseLinearImpulseX.Items[index]
Var oldY As Double = sims.MouseLinearImpulseY.Items[index]
Var totalX As Double = oldX - massScale * bX - impulseScale * oldX
Var totalY As Double = oldY - massScale * bY - impulseScale * oldY

# Clamp the accumulated impulse magnitude, porting b2Normalize's
# degenerate branch: below the float epsilon the upstream normalization
# returns zero rather than a unit direction.
Var mag As Double = Maths.Sqrt(totalX * totalX + totalY * totalY)
If mag > maxImpulse Then
If mag >= PhysicsConstants.FLT_EPSILON Then
Var scale As Double = maxImpulse / mag
totalX = scale * totalX
totalY = scale * totalY
Else
totalX = 0.0
totalY = 0.0
End If
End If
sims.MouseLinearImpulseX.Items[index] = totalX
sims.MouseLinearImpulseY.Items[index] = totalY

Var deltaX As Double = totalX - oldX
Var deltaY As Double = totalY - oldY
vBX = vBX + mB * deltaX
vBY = vBY + mB * deltaY
wB = wB + iB * (rBX * deltaY - rBY * deltaX)
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End Sub

## Prepares one motor joint row, ported from b2PrepareMotorJoint. The motor
## constraint drives the relative pose, so both bodies contribute to the
## mass matrix. The linear mass is the inverse of the symmetric 2x2
## combined constraint matrix, stored as three scalars because the matrix
## is symmetric by construction. Upstream asserts at least one body is
## awake; a non-awake body stores a NULL_INDEX state row that the warm-start
## and solve kernels replace with an identity dummy, exactly like the
## upstream dummy b2BodyState for static bodies.
Private Shared Sub PrepareMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Anchors at the body origins offset by the local centres; the motor
# joint creation writes zero local anchors.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA] - sims.MotorLinearOffsetX.Items[index]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA] - sims.MotorLinearOffsetY.Items[index]
# Relative angle with scalar components: constructing intermediate Rot
# values here would allocate twice per prepared row per step.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.MotorDeltaAngle.Items[index] = PhysicsMaths.Atan2(relS, relC) - sims.MotorAngularOffset.Items[index]

Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var k11 As Double = mA + mB + rAY * rAY * iA + rBY * rBY * iB
Var k12 As Double = -(rAY * rAX * iA + rBY * rBX * iB)
Var k22 As Double = mA + mB + rAX * rAX * iA + rBX * rBX * iB
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
sims.MotorLinearMassXX.Items[index] = det * k22
sims.MotorLinearMassXY.Items[index] = -det * k12
sims.MotorLinearMassYY.Items[index] = det * k11
Var ka As Double = iA + iB
If ka > 0.0 Then
sims.MotorAngularMass.Items[index] = 1.0 / ka
Else
sims.MotorAngularMass.Items[index] = 0.0
End If

If context.WarmStartScale = 0.0 Then
sims.MotorLinearImpulseX.Items[index] = 0.0
sims.MotorLinearImpulseY.Items[index] = 0.0
sims.MotorAngularImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored motor joint impulses to both body states before
## iterating, ported from b2WarmStartMotorJoint. Non-awake bodies use an
## identity dummy state, matching the upstream static-body path.
Shared Sub WarmStartMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.MotorLinearImpulseX.Items[index]
Var pY As Double = sims.MotorLinearImpulseY.Items[index]
Var angularImpulse As Double = sims.MotorAngularImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (rAX * pY - rAY * pX + angularImpulse)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (rBX * pY - rBY * pX + angularImpulse)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one motor joint row, ported from
## b2SolveMotorJoint. Upstream ignores the bias flag: the motor bias comes
## from the correction factor, not the solver softness.
Shared Sub SolveMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Angular constraint: unwind the relative angle and drive it toward the
# offset with the correction-factor bias. The relative angle uses scalar
# components because two Rot allocations per solve iteration would break
# the zero-allocation step gate.
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var angularSeparation As Double = PhysicsMaths.Atan2(relS, relC) + sims.MotorDeltaAngle.Items[index]
angularSeparation = PhysicsMaths.UnwindAngle(angularSeparation)
Var angularBias As Double = context.InvH * sims.MotorCorrectionFactor.Items[index] * angularSeparation
Var angularCdot As Double = wB - wA
Var angularImpulse As Double = -sims.MotorAngularMass.Items[index] * (angularCdot + angularBias)
Var maxTorqueImpulse As Double = context.H * sims.MotorMaxTorque.Items[index]
Var newAngularImpulse As Double = sims.MotorAngularImpulse.Items[index] + angularImpulse
If newAngularImpulse > maxTorqueImpulse Then
newAngularImpulse = maxTorqueImpulse
ElseIf newAngularImpulse < -maxTorqueImpulse Then
newAngularImpulse = -maxTorqueImpulse
End If
angularImpulse = newAngularImpulse - sims.MotorAngularImpulse.Items[index]
sims.MotorAngularImpulse.Items[index] = newAngularImpulse
wA = wA - iA * angularImpulse
wB = wB + iB * angularImpulse

# Linear constraint.
Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dsX As Double = dpBX - dpAX + rBX - rAX
Var dsY As Double = dpBY - dpAY + rBY - rAY
Var biasRate As Double = context.InvH * sims.MotorCorrectionFactor.Items[index]
Var rhsX As Double = vBX - wB * rBY - (vAX - wA * rAY) + biasRate * (sims.DeltaCenterX.Items[index] + dsX)
Var rhsY As Double = vBY + wB * rBX - (vAY + wA * rAX) + biasRate * (sims.DeltaCenterY.Items[index] + dsY)
Var bX As Double = sims.MotorLinearMassXX.Items[index] * rhsX + sims.MotorLinearMassXY.Items[index] * rhsY
Var bY As Double = sims.MotorLinearMassXY.Items[index] * rhsX + sims.MotorLinearMassYY.Items[index] * rhsY
Var oldX As Double = sims.MotorLinearImpulseX.Items[index]
Var oldY As Double = sims.MotorLinearImpulseY.Items[index]
Var totalX As Double = oldX - bX
Var totalY As Double = oldY - bY

# Clamp the accumulated impulse magnitude, porting b2Normalize's
# degenerate branch: below the float epsilon the upstream normalization
# returns zero rather than a unit direction.
Var maxForceImpulse As Double = context.H * sims.MotorMaxForce.Items[index]
Var magSquared As Double = totalX * totalX + totalY * totalY
If magSquared > maxForceImpulse * maxForceImpulse Then
Var mag As Double = Maths.Sqrt(magSquared)
If mag >= PhysicsConstants.FLT_EPSILON Then
Var scale As Double = maxForceImpulse / mag
totalX = scale * totalX
totalY = scale * totalY
Else
totalX = 0.0
totalY = 0.0
End If
End If
sims.MotorLinearImpulseX.Items[index] = totalX
sims.MotorLinearImpulseY.Items[index] = totalY

Var deltaX As Double = totalX - oldX
Var deltaY As Double = totalY - oldY
vAX = vAX - mA * deltaX
vAY = vAY - mA * deltaY
wA = wA - iA * (rAX * deltaY - rAY * deltaX)
vBX = vBX + mB * deltaX
vBY = vBY + mB * deltaY
wB = wB + iB * (rBX * deltaY - rBY * deltaX)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the motor joint row applied this step, ported from
## b2GetMotorJointForce.
Shared Function GetMotorJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.MotorLinearImpulseX.Items[index], scale * sims.MotorLinearImpulseY.Items[index])
End Function

## Torque the motor joint row applied this step, ported from
## b2GetMotorJointTorque.
Shared Function GetMotorJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.MotorAngularImpulse.Items[index]
End Function

## Prepares one revolute joint row, ported from b2PrepareRevoluteJoint.
## The hinge pins the two anchor points together and measures the relative
## angle against the reference angle, so both bodies contribute to every
## block. Anchors come from the definition's local anchors. The spring
## softness is prepared from the definition hertz and damping ratio; the
## base constraint softness (used by the limits and the point-to-point
## block) is prepared by the common joint prepare. A non-awake body stores
## a NULL_INDEX state row that the kernels replace with an identity dummy.
Private Shared Sub PrepareRevoluteJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Initial anchors in world space from the definition's local anchors.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]
# Relative angle with scalar components; see the motor prepare note.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.RevoluteDeltaAngle.Items[index] = PhysicsMaths.Atan2(relS, relC)

Var ka As Double = sims.InvIA.Items[index] + sims.InvIB.Items[index]
If ka > 0.0 Then
sims.RevoluteAxialMass.Items[index] = 1.0 / ka
Else
sims.RevoluteAxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.RevoluteHertz.Items[index], sims.RevoluteDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.RevoluteSpringSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.RevoluteSpringSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.RevoluteSpringSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.RevoluteLinearImpulseX.Items[index] = 0.0
sims.RevoluteLinearImpulseY.Items[index] = 0.0
sims.RevoluteSpringImpulse.Items[index] = 0.0
sims.RevoluteMotorImpulse.Items[index] = 0.0
sims.RevoluteLowerImpulse.Items[index] = 0.0
sims.RevoluteUpperImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored revolute joint impulses to both body states before
## iterating, ported from b2WarmStartRevoluteJoint. The axial impulse
## bundles the spring, motor, and limit contributions.
Shared Sub WarmStartRevoluteJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.RevoluteLinearImpulseX.Items[index]
Var pY As Double = sims.RevoluteLinearImpulseY.Items[index]
Var axialImpulse As Double = sims.RevoluteSpringImpulse.Items[index] + sims.RevoluteMotorImpulse.Items[index] + sims.RevoluteLowerImpulse.Items[index] - sims.RevoluteUpperImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (rAX * pY - rAY * pX + axialImpulse)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (rBX * pY - rBY * pX + axialImpulse)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one revolute joint row, ported from
## b2SolveRevoluteJoint: spring, motor, lower and upper limits, then the
## point-to-point block. The fixed-rotation guard skips the axial blocks
## exactly like upstream; the point-to-point block always runs.
Shared Sub SolveRevoluteJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var fixedRotation As Boolean = (iA + iB = 0.0)

# Solve spring.
If sims.EnableSpring.Items[index] <> 0 And fixedRotation = False Then
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var jointAngle As Double = PhysicsMaths.Atan2(relS, relC) + sims.RevoluteDeltaAngle.Items[index]
Var C As Double = PhysicsMaths.UnwindAngle(jointAngle - sims.RevoluteTargetAngle.Items[index])
Var bias As Double = sims.RevoluteSpringSoftnessBiasRate.Items[index] * C
Var massScale As Double = sims.RevoluteSpringSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.RevoluteSpringSoftnessImpulseScale.Items[index]
Var Cdot As Double = wB - wA
Var impulse As Double = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.RevoluteSpringImpulse.Items[index]
sims.RevoluteSpringImpulse.Items[index] = sims.RevoluteSpringImpulse.Items[index] + impulse
wA = wA - iA * impulse
wB = wB + iB * impulse
End If

# Solve motor constraint.
If sims.EnableMotor.Items[index] <> 0 And fixedRotation = False Then
Var Cdot As Double = wB - wA - sims.RevoluteMotorSpeed.Items[index]
Var impulse As Double = -sims.RevoluteAxialMass.Items[index] * Cdot
Var oldImpulse As Double = sims.RevoluteMotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.RevoluteMaxMotorTorque.Items[index]
Var newImpulse As Double = oldImpulse + impulse
If newImpulse > maxImpulse Then
newImpulse = maxImpulse
ElseIf newImpulse < -maxImpulse Then
newImpulse = -maxImpulse
End If
sims.RevoluteMotorImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
wA = wA - iA * impulse
wB = wB + iB * impulse
End If

If sims.EnableLimit.Items[index] <> 0 And fixedRotation = False Then
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var jointAngle As Double = PhysicsMaths.UnwindAngle(PhysicsMaths.Atan2(relS, relC) + sims.RevoluteDeltaAngle.Items[index] - sims.RevoluteReferenceAngle.Items[index])

# Lower limit.
Var C As Double = jointAngle - sims.RevoluteLowerAngle.Items[index]
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If C > 0.0 Then
# Speculation.
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var Cdot As Double = wB - wA
Var oldImpulse As Double = sims.RevoluteLowerImpulse.Items[index]
Var impulse As Double = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * oldImpulse
Var newImpulse As Double = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.RevoluteLowerImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
wA = wA - iA * impulse
wB = wB + iB * impulse

# Upper limit: signs are flipped to keep C positive when the constraint
# is satisfied, which also keeps the impulse positive when active.
C = sims.RevoluteUpperAngle.Items[index] - jointAngle
bias = 0.0
massScale = 1.0
impulseScale = 0.0
If C > 0.0 Then
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

# Sign flipped on Cdot.
Cdot = wA - wB
oldImpulse = sims.RevoluteUpperImpulse.Items[index]
impulse = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * oldImpulse
newImpulse = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.RevoluteUpperImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse

# Sign flipped on applied impulse.
wA = wA + iA * impulse
wB = wB - iB * impulse
End If

# Solve point-to-point constraint. The 2x2 combined matrix is symmetric
# by construction and solved inline with the guarded inverse determinant
# of upstream b2Solve22.
Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var cdX As Double = vBX - wB * rBY - (vAX - wA * rAY)
Var cdY As Double = vBY + wB * rBX - (vAY + wA * rAX)
Var biasX As Double = 0.0
Var biasY As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
Var sepX As Double = dpBX - dpAX + rBX - rAX + sims.DeltaCenterX.Items[index]
Var sepY As Double = dpBY - dpAY + rBY - rAY + sims.DeltaCenterY.Items[index]
biasX = sims.SoftnessBiasRate.Items[index] * sepX
biasY = sims.SoftnessBiasRate.Items[index] * sepY
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var k11 As Double = mA + mB + rAY * rAY * iA + rBY * rBY * iB
Var k12 As Double = -(rAY * rAX * iA + rBY * rBX * iB)
Var k22 As Double = mA + mB + rAX * rAX * iA + rBX * rBX * iB
Var rhsX As Double = cdX + biasX
Var rhsY As Double = cdY + biasY
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
Var bX As Double = det * (k22 * rhsX - k12 * rhsY)
Var bY As Double = det * (k11 * rhsY - k12 * rhsX)
Var oldX As Double = sims.RevoluteLinearImpulseX.Items[index]
Var oldY As Double = sims.RevoluteLinearImpulseY.Items[index]
Var impX As Double = -massScale * bX - impulseScale * oldX
Var impY As Double = -massScale * bY - impulseScale * oldY
sims.RevoluteLinearImpulseX.Items[index] = oldX + impX
sims.RevoluteLinearImpulseY.Items[index] = oldY + impY

vAX = vAX - mA * impX
vAY = vAY - mA * impY
wA = wA - iA * (rAX * impY - rAY * impX)
vBX = vBX + mB * impX
vBY = vBY + mB * impY
wB = wB + iB * (rBX * impY - rBY * impX)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the revolute joint row applied this step, ported from
## b2GetRevoluteJointForce.
Shared Function GetRevoluteJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.RevoluteLinearImpulseX.Items[index], scale * sims.RevoluteLinearImpulseY.Items[index])
End Function

## Torque the revolute joint row applied this step, ported from
## b2GetRevoluteJointTorque: the motor and limit impulses combined.
Shared Function GetRevoluteJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * (sims.RevoluteMotorImpulse.Items[index] + sims.RevoluteLowerImpulse.Items[index] - sims.RevoluteUpperImpulse.Items[index])
End Function

## Prepares one prismatic joint row, ported from b2PreparePrismaticJoint.
## The slider allows translation along one body-A axis and pins the
## relative angle, so both bodies contribute to every block. The axis and
## anchors rotate with body A's transform; the axial effective mass uses
## the torque arms about the anchor line, computed once per step. A
## non-awake body stores a NULL_INDEX state row that the kernels replace
## with an identity dummy.
Private Shared Sub PreparePrismaticJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]

# Anchors and axis in world space from the definition's local values.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY
Var axisLX As Double = sims.PrismaticLocalAxisX.Items[index]
Var axisLY As Double = sims.PrismaticLocalAxisY.Items[index]
Var axisX As Double = qcA * axisLX - qsA * axisLY
Var axisY As Double = qsA * axisLX + qcA * axisLY
sims.PrismaticAxisX.Items[index] = axisX
sims.PrismaticAxisY.Items[index] = axisY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]
# Relative angle minus the reference angle, unwound, with scalar
# components; see the motor prepare note.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.PrismaticDeltaAngle.Items[index] = PhysicsMaths.UnwindAngle(PhysicsMaths.Atan2(relS, relC) - sims.PrismaticReferenceAngle.Items[index])

# Axial effective mass from the torque arms about the anchor line.
Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var dX As Double = sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = sims.DeltaCenterY.Items[index] + rBY - rAY
Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var k As Double = mA + mB + iA * a1 * a1 + iB * a2 * a2
If k > 0.0 Then
sims.PrismaticAxialMass.Items[index] = 1.0 / k
Else
sims.PrismaticAxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.PrismaticHertz.Items[index], sims.PrismaticDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.PrismaticSpringSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.PrismaticSpringSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.PrismaticSpringSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.PrismaticImpulseX.Items[index] = 0.0
sims.PrismaticImpulseY.Items[index] = 0.0
sims.PrismaticSpringImpulse.Items[index] = 0.0
sims.PrismaticMotorImpulse.Items[index] = 0.0
sims.PrismaticLowerImpulse.Items[index] = 0.0
sims.PrismaticUpperImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored prismatic joint impulses to both body states before
## iterating, ported from b2WarmStartPrismaticJoint. The axial impulse
## bundles the spring, motor, and limit impulses; the perpendicular and
## angular impulses apply through the anchor-line torque arms.
Shared Sub WarmStartPrismaticJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dX As Double = dpBX - dpAX + sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = dpBY - dpAY + sims.DeltaCenterY.Items[index] + rBY - rAY
Var axisLX As Double = sims.PrismaticAxisX.Items[index]
Var axisLY As Double = sims.PrismaticAxisY.Items[index]
Var axisX As Double = dqAC * axisLX - dqAS * axisLY
Var axisY As Double = dqAS * axisLX + dqAC * axisLY

# Impulse is applied at the anchor point on body B.
Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX
Var axialImpulse As Double = sims.PrismaticSpringImpulse.Items[index] + sims.PrismaticMotorImpulse.Items[index] + sims.PrismaticLowerImpulse.Items[index] - sims.PrismaticUpperImpulse.Items[index]

Var perpX As Double = -axisY
Var perpY As Double = axisX
Var s1 As Double = (dX + rAX) * perpY - (dY + rAY) * perpX
Var s2 As Double = rBX * perpY - rBY * perpX
Var perpImpulse As Double = sims.PrismaticImpulseX.Items[index]
Var angleImpulse As Double = sims.PrismaticImpulseY.Items[index]

Var pX As Double = axialImpulse * axisX + perpImpulse * perpX
Var pY As Double = axialImpulse * axisY + perpImpulse * perpY
Var la As Double = axialImpulse * a1 + perpImpulse * s1 + angleImpulse
Var lb As Double = axialImpulse * a2 + perpImpulse * s2 + angleImpulse

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * la
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * lb

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one prismatic joint row, ported from
## b2SolvePrismaticJoint: axial spring, motor, and limits, then the
## perpendicular-plus-angular block solve.
Shared Sub SolvePrismaticJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dX As Double = dpBX - dpAX + sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = dpBY - dpAY + sims.DeltaCenterY.Items[index] + rBY - rAY
Var axisLX As Double = sims.PrismaticAxisX.Items[index]
Var axisLY As Double = sims.PrismaticAxisY.Items[index]
Var axisX As Double = dqAC * axisLX - dqAS * axisLY
Var axisY As Double = dqAS * axisLX + dqAC * axisLY
Var translation As Double = axisX * dX + axisY * dY

# Torque arms for axial forces.
Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX
Var axialMass As Double = sims.PrismaticAxialMass.Items[index]

# Spring constraint: applied even during relax.
If sims.EnableSpring.Items[index] <> 0 Then
Var C As Double = translation - sims.PrismaticTargetTranslation.Items[index]
Var bias As Double = sims.PrismaticSpringSoftnessBiasRate.Items[index] * C
Var massScale As Double = sims.PrismaticSpringSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.PrismaticSpringSoftnessImpulseScale.Items[index]
Var Cdot As Double = axisX * (vBX - vAX) + axisY * (vBY - vAY) + a2 * wB - a1 * wA
Var deltaImpulse As Double = -massScale * axialMass * (Cdot + bias) - impulseScale * sims.PrismaticSpringImpulse.Items[index]
sims.PrismaticSpringImpulse.Items[index] = sims.PrismaticSpringImpulse.Items[index] + deltaImpulse
Var pX As Double = deltaImpulse * axisX
Var pY As Double = deltaImpulse * axisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (deltaImpulse * a1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (deltaImpulse * a2)
End If

# Motor constraint.
If sims.EnableMotor.Items[index] <> 0 Then
Var Cdot As Double = axisX * (vBX - vAX) + axisY * (vBY - vAY) + a2 * wB - a1 * wA
Var impulse As Double = axialMass * (sims.PrismaticMotorSpeed.Items[index] - Cdot)
Var oldImpulse As Double = sims.PrismaticMotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.PrismaticMaxMotorForce.Items[index]
Var newImpulse As Double = oldImpulse + impulse
If newImpulse > maxImpulse Then
newImpulse = maxImpulse
ElseIf newImpulse < -maxImpulse Then
newImpulse = -maxImpulse
End If
sims.PrismaticMotorImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
Var pX As Double = impulse * axisX
Var pY As Double = impulse * axisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (impulse * a1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (impulse * a2)
End If

If sims.EnableLimit.Items[index] <> 0 Then
# Lower limit.
Var C As Double = translation - sims.PrismaticLowerTranslation.Items[index]
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If C > 0.0 Then
# Speculation.
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var oldImpulse As Double = sims.PrismaticLowerImpulse.Items[index]
Var Cdot As Double = axisX * (vBX - vAX) + axisY * (vBY - vAY) + a2 * wB - a1 * wA
Var impulse As Double = -axialMass * massScale * (Cdot + bias) - impulseScale * oldImpulse
Var newImpulse As Double = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.PrismaticLowerImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
Var pX As Double = impulse * axisX
Var pY As Double = impulse * axisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (impulse * a1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (impulse * a2)

# Upper limit: signs flipped to keep C positive when satisfied.
C = sims.PrismaticUpperTranslation.Items[index] - translation
bias = 0.0
massScale = 1.0
impulseScale = 0.0
If C > 0.0 Then
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
oldImpulse = sims.PrismaticUpperImpulse.Items[index]
# Sign flipped.
Cdot = axisX * (vAX - vBX) + axisY * (vAY - vBY) + a1 * wA - a2 * wB
impulse = -axialMass * massScale * (Cdot + bias) - impulseScale * oldImpulse
newImpulse = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.PrismaticUpperImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
pX = impulse * axisX
pY = impulse * axisY
# Sign flipped.
vAX = vAX + mA * pX
vAY = vAY + mA * pY
wA = wA + iA * (impulse * a1)
vBX = vBX - mB * pX
vBY = vBY - mB * pY
wB = wB - iB * (impulse * a2)
End If

# Perpendicular-plus-angular block solve. The combined matrix is
# symmetric by construction and solved inline with the guarded inverse
# determinant of upstream b2Solve22.
Var perpX As Double = -axisY
Var perpY As Double = axisX
Var s1 As Double = (dX + rAX) * perpY - (dY + rAY) * perpX
Var s2 As Double = rBX * perpY - rBY * perpX
Var cdX As Double = perpX * (vBX - vAX) + perpY * (vBY - vAY) + s2 * wB - s1 * wA
Var cdY As Double = wB - wA
Var biasX As Double = 0.0
Var biasY As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
Var cX As Double = perpX * dX + perpY * dY
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var cY As Double = PhysicsMaths.Atan2(relS, relC) + sims.PrismaticDeltaAngle.Items[index]
biasX = sims.SoftnessBiasRate.Items[index] * cX
biasY = sims.SoftnessBiasRate.Items[index] * cY
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var k11 As Double = mA + mB + iA * s1 * s1 + iB * s2 * s2
Var k12 As Double = iA * s1 + iB * s2
Var k22 As Double = iA + iB
If k22 = 0.0 Then
# For bodies with fixed rotation.
k22 = 1.0
End If
Var rhsX As Double = cdX + biasX
Var rhsY As Double = cdY + biasY
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
Var bX As Double = det * (k22 * rhsX - k12 * rhsY)
Var bY As Double = det * (k11 * rhsY - k12 * rhsX)
Var oldX As Double = sims.PrismaticImpulseX.Items[index]
Var oldY As Double = sims.PrismaticImpulseY.Items[index]
Var impX As Double = -massScale * bX - impulseScale * oldX
Var impY As Double = -massScale * bY - impulseScale * oldY
sims.PrismaticImpulseX.Items[index] = oldX + impX
sims.PrismaticImpulseY.Items[index] = oldY + impY

Var pX As Double = impX * perpX
Var pY As Double = impX * perpY
Var la As Double = impX * s1 + impY
Var lb As Double = impX * s2 + impY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * la
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * lb

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the prismatic joint row applied this step, ported from
## b2GetPrismaticJointForce: the perpendicular and axial components
## combined in world space.
Shared Function GetPrismaticJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var axisX As Double = sims.PrismaticAxisX.Items[index]
Var axisY As Double = sims.PrismaticAxisY.Items[index]
Var perpX As Double = -axisY
Var perpY As Double = axisX
Var perpForce As Double = invH * sims.PrismaticImpulseX.Items[index]
Var axialForce As Double = invH * (sims.PrismaticMotorImpulse.Items[index] + sims.PrismaticLowerImpulse.Items[index] - sims.PrismaticUpperImpulse.Items[index])
Return New Vector2(perpForce * perpX + axialForce * axisX, perpForce * perpY + axialForce * axisY)
End Function

## Torque the prismatic joint row applied this step, ported from
## b2GetPrismaticJointTorque: the angular part of the block impulse.
Shared Function GetPrismaticJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.PrismaticImpulseY.Items[index]
End Function

## Prepares one weld joint row, ported from b2PrepareWeldJoint. The weld
## pins both anchor points and the relative angle. A zero hertz copies the
## base constraint softness into the weld softness columns, matching the
## upstream fallback; otherwise the softness comes from the definition's
## hertz and damping ratio. A non-awake body stores a NULL_INDEX state row
## that the kernels replace with an identity dummy.
Private Shared Sub PrepareWeldJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]
# Relative angle minus the reference angle, unwound, with scalar
# components; see the motor prepare note.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.WeldDeltaAngle.Items[index] = PhysicsMaths.UnwindAngle(PhysicsMaths.Atan2(relS, relC) - sims.WeldReferenceAngle.Items[index])

Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var ka As Double = iA + iB
If ka > 0.0 Then
sims.WeldAxialMass.Items[index] = 1.0 / ka
Else
sims.WeldAxialMass.Items[index] = 0.0
End If

# Zero hertz falls back to the base constraint softness, matching the
# upstream prepare exactly.
If sims.WeldLinearHertz.Items[index] = 0.0 Then
sims.WeldLinearSoftnessBiasRate.Items[index] = sims.SoftnessBiasRate.Items[index]
sims.WeldLinearSoftnessMassScale.Items[index] = sims.SoftnessMassScale.Items[index]
sims.WeldLinearSoftnessImpulseScale.Items[index] = sims.SoftnessImpulseScale.Items[index]
Else
Softness.MakeTo(sims.WeldLinearHertz.Items[index], sims.WeldLinearDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.WeldLinearSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.WeldLinearSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.WeldLinearSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale
End If
If sims.WeldAngularHertz.Items[index] = 0.0 Then
sims.WeldAngularSoftnessBiasRate.Items[index] = sims.SoftnessBiasRate.Items[index]
sims.WeldAngularSoftnessMassScale.Items[index] = sims.SoftnessMassScale.Items[index]
sims.WeldAngularSoftnessImpulseScale.Items[index] = sims.SoftnessImpulseScale.Items[index]
Else
Softness.MakeTo(sims.WeldAngularHertz.Items[index], sims.WeldAngularDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.WeldAngularSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.WeldAngularSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.WeldAngularSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale
End If

If context.WarmStartScale = 0.0 Then
sims.WeldLinearImpulseX.Items[index] = 0.0
sims.WeldLinearImpulseY.Items[index] = 0.0
sims.WeldAngularImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored weld joint impulses to both body states before
## iterating, ported from b2WarmStartWeldJoint. Non-awake bodies use an
## identity dummy state, matching the upstream static-body path.
Shared Sub WarmStartWeldJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.WeldLinearImpulseX.Items[index]
Var pY As Double = sims.WeldLinearImpulseY.Items[index]
Var angularImpulse As Double = sims.WeldAngularImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (rAX * pY - rAY * pX + angularImpulse)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (rBX * pY - rBY * pX + angularImpulse)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one weld joint row, ported from
## b2SolveWeldJoint: the angular constraint, then the linear 2x2 block.
## The soft bias applies whenever the solver asks for bias or the weld is
## softened, matching the upstream condition.
Shared Sub SolveWeldJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Angular constraint.
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Or sims.WeldAngularHertz.Items[index] > 0.0 Then
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var C As Double = PhysicsMaths.Atan2(relS, relC) + sims.WeldDeltaAngle.Items[index]
bias = sims.WeldAngularSoftnessBiasRate.Items[index] * C
massScale = sims.WeldAngularSoftnessMassScale.Items[index]
impulseScale = sims.WeldAngularSoftnessImpulseScale.Items[index]
End If
Var Cdot As Double = wB - wA
Var impulse As Double = -massScale * sims.WeldAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.WeldAngularImpulse.Items[index]
sims.WeldAngularImpulse.Items[index] = sims.WeldAngularImpulse.Items[index] + impulse
wA = wA - iA * impulse
wB = wB + iB * impulse

# Linear constraint. The combined matrix is symmetric by construction and
# solved inline with the guarded inverse determinant of upstream
# b2Solve22.
Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var biasX As Double = 0.0
Var biasY As Double = 0.0
massScale = 1.0
impulseScale = 0.0
If useBias Or sims.WeldLinearHertz.Items[index] > 0.0 Then
Var cx As Double = dpBX - dpAX + rBX - rAX + sims.DeltaCenterX.Items[index]
Var cy As Double = dpBY - dpAY + rBY - rAY + sims.DeltaCenterY.Items[index]
biasX = sims.WeldLinearSoftnessBiasRate.Items[index] * cx
biasY = sims.WeldLinearSoftnessBiasRate.Items[index] * cy
massScale = sims.WeldLinearSoftnessMassScale.Items[index]
impulseScale = sims.WeldLinearSoftnessImpulseScale.Items[index]
End If
Var cdX As Double = vBX - wB * rBY - (vAX - wA * rAY)
Var cdY As Double = vBY + wB * rBX - (vAY + wA * rAX)
Var k11 As Double = mA + mB + rAY * rAY * iA + rBY * rBY * iB
Var k12 As Double = -(rAY * rAX * iA + rBY * rBX * iB)
Var k22 As Double = mA + mB + rAX * rAX * iA + rBX * rBX * iB
Var rhsX As Double = cdX + biasX
Var rhsY As Double = cdY + biasY
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
Var bX As Double = det * (k22 * rhsX - k12 * rhsY)
Var bY As Double = det * (k11 * rhsY - k12 * rhsX)
Var oldX As Double = sims.WeldLinearImpulseX.Items[index]
Var oldY As Double = sims.WeldLinearImpulseY.Items[index]
Var impX As Double = -massScale * bX - impulseScale * oldX
Var impY As Double = -massScale * bY - impulseScale * oldY
sims.WeldLinearImpulseX.Items[index] = oldX + impX
sims.WeldLinearImpulseY.Items[index] = oldY + impY

vAX = vAX - mA * impX
vAY = vAY - mA * impY
wA = wA - iA * (rAX * impY - rAY * impX)
vBX = vBX + mB * impX
vBY = vBY + mB * impY
wB = wB + iB * (rBX * impY - rBY * impX)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the weld joint row applied this step, ported from
## b2GetWeldJointForce.
Shared Function GetWeldJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.WeldLinearImpulseX.Items[index], scale * sims.WeldLinearImpulseY.Items[index])
End Function

## Torque the weld joint row applied this step, ported from
## b2GetWeldJointTorque.
Shared Function GetWeldJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.WeldAngularImpulse.Items[index]
End Function

## Prepares one wheel joint row, ported from b2PrepareWheelJoint. The
## wheel keeps body B on the axis line, applies the suspension spring and
## translation limits along the axis, and drives the wheel spin with a
## torque-clamped motor; body B's rotation is otherwise free. A non-awake
## body stores a NULL_INDEX state row that the kernels replace with an
## identity dummy.
Private Shared Sub PrepareWheelJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY
Var axisLX As Double = sims.WheelLocalAxisX.Items[index]
Var axisLY As Double = sims.WheelLocalAxisY.Items[index]
sims.WheelAxisX.Items[index] = qcA * axisLX - qsA * axisLY
sims.WheelAxisY.Items[index] = qsA * axisLX + qcA * axisLY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]

# Effective masses from the perpendicular and axial torque arms.
Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var dX As Double = sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = sims.DeltaCenterY.Items[index] + rBY - rAY
Var axisX As Double = sims.WheelAxisX.Items[index]
Var axisY As Double = sims.WheelAxisY.Items[index]
Var perpX As Double = -axisY
Var perpY As Double = axisX
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var s1 As Double = (dX + rAX) * perpY - (dY + rAY) * perpX
Var s2 As Double = rBX * perpY - rBY * perpX
Var kp As Double = mA + mB + iA * s1 * s1 + iB * s2 * s2
If kp > 0.0 Then
sims.WheelPerpMass.Items[index] = 1.0 / kp
Else
sims.WheelPerpMass.Items[index] = 0.0
End If
Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX
Var ka As Double = mA + mB + iA * a1 * a1 + iB * a2 * a2
If ka > 0.0 Then
sims.WheelAxialMass.Items[index] = 1.0 / ka
Else
sims.WheelAxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.WheelHertz.Items[index], sims.WheelDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.WheelSpringSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.WheelSpringSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.WheelSpringSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

Var km As Double = iA + iB
If km > 0.0 Then
sims.WheelMotorMass.Items[index] = 1.0 / km
Else
sims.WheelMotorMass.Items[index] = 0.0
End If

If context.WarmStartScale = 0.0 Then
sims.WheelPerpImpulse.Items[index] = 0.0
sims.WheelSpringImpulse.Items[index] = 0.0
sims.WheelMotorImpulse.Items[index] = 0.0
sims.WheelLowerImpulse.Items[index] = 0.0
sims.WheelUpperImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored wheel joint impulses to both body states before
## iterating, ported from b2WarmStartWheelJoint. The axial impulse bundles
## the spring and limit impulses; the motor impulse acts on the spin.
Shared Sub WarmStartWheelJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dX As Double = dpBX - dpAX + sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = dpBY - dpAY + sims.DeltaCenterY.Items[index] + rBY - rAY
Var axisLX As Double = sims.WheelAxisX.Items[index]
Var axisLY As Double = sims.WheelAxisY.Items[index]
Var axisX As Double = dqAC * axisLX - dqAS * axisLY
Var axisY As Double = dqAS * axisLX + dqAC * axisLY
Var perpX As Double = -axisY
Var perpY As Double = axisX

Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX
Var s1 As Double = (dX + rAX) * perpY - (dY + rAY) * perpX
Var s2 As Double = rBX * perpY - rBY * perpX
Var axialImpulse As Double = sims.WheelSpringImpulse.Items[index] + sims.WheelLowerImpulse.Items[index] - sims.WheelUpperImpulse.Items[index]

Var pX As Double = axialImpulse * axisX + sims.WheelPerpImpulse.Items[index] * perpX
Var pY As Double = axialImpulse * axisY + sims.WheelPerpImpulse.Items[index] * perpY
Var la As Double = axialImpulse * a1 + sims.WheelPerpImpulse.Items[index] * s1 + sims.WheelMotorImpulse.Items[index]
Var lb As Double = axialImpulse * a2 + sims.WheelPerpImpulse.Items[index] * s2 + sims.WheelMotorImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * la
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * lb

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one wheel joint row, ported from
## b2SolveWheelJoint: torque-clamped motor, suspension spring, translation
## limits, then the perpendicular point-to-line block.
Shared Sub SolveWheelJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dX As Double = dpBX - dpAX + sims.DeltaCenterX.Items[index] + rBX - rAX
Var dY As Double = dpBY - dpAY + sims.DeltaCenterY.Items[index] + rBY - rAY
Var axisLX As Double = sims.WheelAxisX.Items[index]
Var axisLY As Double = sims.WheelAxisY.Items[index]
Var axisX As Double = dqAC * axisLX - dqAS * axisLY
Var axisY As Double = dqAS * axisLX + dqAC * axisLY
Var translation As Double = axisX * dX + axisY * dY
Var a1 As Double = (dX + rAX) * axisY - (dY + rAY) * axisX
Var a2 As Double = rBX * axisY - rBY * axisX

Var fixedRotation As Boolean = (iA + iB = 0.0)

# Motor constraint.
If sims.EnableMotor.Items[index] <> 0 And fixedRotation = False Then
Var Cdot As Double = wB - wA - sims.WheelMotorSpeed.Items[index]
Var impulse As Double = -sims.WheelMotorMass.Items[index] * Cdot
Var oldImpulse As Double = sims.WheelMotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.WheelMaxMotorTorque.Items[index]
Var newImpulse As Double = oldImpulse + impulse
If newImpulse > maxImpulse Then
newImpulse = maxImpulse
ElseIf newImpulse < -maxImpulse Then
newImpulse = -maxImpulse
End If
sims.WheelMotorImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
wA = wA - iA * impulse
wB = wB + iB * impulse
End If

# Spring constraint: a real spring, applied even during relax. The wheel
# spring drives the translation toward zero, matching the upstream C.
If sims.EnableSpring.Items[index] <> 0 Then
Var C As Double = translation
Var bias As Double = sims.WheelSpringSoftnessBiasRate.Items[index] * C
Var massScale As Double = sims.WheelSpringSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.WheelSpringSoftnessImpulseScale.Items[index]
Var Cdot As Double = axisX * (vBX - vAX) + axisY * (vBY - vAY) + a2 * wB - a1 * wA
Var impulse As Double = -massScale * sims.WheelAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.WheelSpringImpulse.Items[index]
sims.WheelSpringImpulse.Items[index] = sims.WheelSpringImpulse.Items[index] + impulse
Var pX As Double = impulse * axisX
Var pY As Double = impulse * axisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (impulse * a1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (impulse * a2)
End If

If sims.EnableLimit.Items[index] <> 0 Then
# Lower limit.
Var C As Double = translation - sims.WheelLowerTranslation.Items[index]
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If C > 0.0 Then
# Speculation.
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var Cdot As Double = axisX * (vBX - vAX) + axisY * (vBY - vAY) + a2 * wB - a1 * wA
Var impulse As Double = -massScale * sims.WheelAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.WheelLowerImpulse.Items[index]
Var oldImpulse As Double = sims.WheelLowerImpulse.Items[index]
Var newImpulse As Double = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.WheelLowerImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
Var pX As Double = impulse * axisX
Var pY As Double = impulse * axisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (impulse * a1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (impulse * a2)

# Upper limit: signs flipped to keep C positive when satisfied.
C = sims.WheelUpperTranslation.Items[index] - translation
bias = 0.0
massScale = 1.0
impulseScale = 0.0
If C > 0.0 Then
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

# Sign flipped on Cdot.
Cdot = axisX * (vAX - vBX) + axisY * (vAY - vBY) + a1 * wA - a2 * wB
impulse = -massScale * sims.WheelAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.WheelUpperImpulse.Items[index]
oldImpulse = sims.WheelUpperImpulse.Items[index]
newImpulse = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.WheelUpperImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
pX = impulse * axisX
pY = impulse * axisY
# Sign flipped on applied impulse.
vAX = vAX + mA * pX
vAY = vAY + mA * pY
wA = wA + iA * (impulse * a1)
vBX = vBX - mB * pX
vBY = vBY - mB * pY
wB = wB - iB * (impulse * a2)
End If

# Point-to-line constraint.
Var perpX As Double = -axisY
Var perpY As Double = axisX
Var s1 As Double = (dX + rAX) * perpY - (dY + rAY) * perpX
Var s2 As Double = rBX * perpY - rBY * perpX
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
Var C As Double = perpX * dX + perpY * dY
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var Cdot As Double = perpX * (vBX - vAX) + perpY * (vBY - vAY) + s2 * wB - s1 * wA
Var impulse As Double = -massScale * sims.WheelPerpMass.Items[index] * (Cdot + bias) - impulseScale * sims.WheelPerpImpulse.Items[index]
sims.WheelPerpImpulse.Items[index] = sims.WheelPerpImpulse.Items[index] + impulse
Var pX As Double = impulse * perpX
Var pY As Double = impulse * perpY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (impulse * s1)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (impulse * s2)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the wheel joint row applied this step, ported from
## b2GetWheelJointForce: the perpendicular and axial components combined
## in world space.
Shared Function GetWheelJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var axisX As Double = sims.WheelAxisX.Items[index]
Var axisY As Double = sims.WheelAxisY.Items[index]
Var perpX As Double = -axisY
Var perpY As Double = axisX
Var perpForce As Double = invH * sims.WheelPerpImpulse.Items[index]
Var axialForce As Double = invH * (sims.WheelSpringImpulse.Items[index] + sims.WheelLowerImpulse.Items[index] - sims.WheelUpperImpulse.Items[index])
Return New Vector2(perpForce * perpX + axialForce * axisX, perpForce * perpY + axialForce * axisY)
End Function

## Torque the wheel joint row applied this step, ported from
## b2GetWheelJointTorque: the motor impulse rate.
Shared Function GetWheelJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.WheelMotorImpulse.Items[index]
End Function

## Total force the mouse joint row applied this step, ported from
## b2GetMouseJointForce.
Shared Function GetMouseJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.MouseLinearImpulseX.Items[index], scale * sims.MouseLinearImpulseY.Items[index])
End Function

## Torque the mouse joint row applied this step, ported from
## b2GetMouseJointTorque.
Shared Function GetMouseJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.MouseAngularImpulse.Items[index]
End Function

## Total force the distance joint row applied this step, ported from
## b2GetDistanceJointForce.
Shared Function GetDistanceJointForce(world As World, sims As JointSims, index As Integer) As Vector2
Var transformA As Transform = world.GetBodyTransformById(sims.BodyIdA.Items[index])
Var transformB As Transform = world.GetBodyTransformById(sims.BodyIdB.Items[index])
Var pA As Vector2 = Transform.TransformPoint(transformA, New Vector2(sims.LocalOriginAnchorAX.Items[index], sims.LocalOriginAnchorAY.Items[index]))
Var pB As Vector2 = Transform.TransformPoint(transformB, New Vector2(sims.LocalOriginAnchorBX.Items[index], sims.LocalOriginAnchorBY.Items[index]))
Var d As Vector2 = pB - pA
Var length As Double = d.Length()
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * d.X
axisY = invLength * d.Y
End If
Var force As Double = (sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]) * world.InvH
Return New Vector2(force * axisX, force * axisY)
End Function
End Class

# Joint family discriminator, ported from upstream b2JointType in types.h.
# Values match upstream so solver dispatch and serialisation stay aligned.
Enum JointType
## Rigid or springy rope constraint between two anchor points.
DistanceJoint
## Collision filter override between two bodies; has no solver behaviour.
FilterJoint
## Soft constraint pulling body B to an offset pose relative to body A.
MotorJoint
## Soft constraint dragging a body anchor toward a world target.
MouseJoint
## Translation along a body-A axis with optional spring, limits, and motor.
PrismaticJoint
## Rotation about a shared anchor with optional spring, limits, and motor.
RevoluteJoint
## Rigid or soft relative-pose lock between two bodies.
WeldJoint
## Wheel: translation along a body-A axis plus rotation about the anchor.
WheelJoint
End Enum

# A contact manifold describing the contact points between colliding
# shapes, ported from upstream b2Manifold in collision.h. Box2D uses
# speculative collision so some contact points may be separated.
#
# Collision functions write into existing manifolds (the To-forms), so a
# warm loop reuses one Manifold and allocates nothing. Every geometry field
# is overwritten on each call.
Class Manifold
## The unit normal vector in world space, pointing from shape A to shape B.
## Zero when the manifold is empty.
Property Normal As Vector2

## Angular impulse applied for rolling resistance. N * m * s.
Property RollingImpulse As Double

## First manifold point. Only meaningful when PointCount is at least one.
Property Point1 As ManifoldPoint

## Second manifold point. Only meaningful when PointCount is two.
Property Point2 As ManifoldPoint

## The number of contact points: 0, 1, or 2.
Property PointCount As Integer

## Lazily created reusable workspace for collision functions.
Property mScratch As CollideScratch

## Creates an empty manifold.
Constructor()
Me.Normal = New Vector2(0.0, 0.0)
Me.RollingImpulse = 0.0
Me.Point1 = New ManifoldPoint
Me.Point2 = New ManifoldPoint
Me.PointCount = 0
Me.mScratch = Nothing
End Constructor

## Resets the manifold to the empty state in place and returns it.
Function Reset() As Manifold
Me.Normal.Set(0.0, 0.0)
Me.RollingImpulse = 0.0
Me.Point1.Reset()
Me.Point2.Reset()
Me.PointCount = 0
Return Me
End Function

## Copies every field from another manifold into this one, including the
## full contact points. Used to snapshot manifolds for events.
Sub AssignFrom(other As Manifold)
Me.Normal.Set(other.Normal.X, other.Normal.Y)
Me.RollingImpulse = other.RollingImpulse
Me.Point1.AssignFrom(other.Point1)
Me.Point2.AssignFrom(other.Point2)
Me.PointCount = other.PointCount
End Sub

## Returns the lazily created reusable workspace. Engine code only.
Function Scratch() As CollideScratch
If Me.mScratch = Nothing Then
Me.mScratch = New CollideScratch
End If
Return Me.mScratch
End Function
End Class

# One contact point of a collision manifold, ported from upstream
# b2ManifoldPoint in collision.h.
#
# Collision functions write into existing manifold points in place, so a
# warm loop reuses one Manifold and allocates nothing. Solver fields
# (impulses, normal velocity, persistence) are zero on creation and managed
# by the solver in a later stage.
Class ManifoldPoint
## Location of the contact point in world space. Subject to precision loss
## at large coordinates. Only used for debugging.
Property Point As Vector2

## Location of the contact point relative to shape A's origin in world
## space. When used internally by the solver, this is relative to the body
## centre of mass.
Property AnchorA As Vector2

## Location of the contact point relative to shape B's origin in world
## space. When used internally by the solver, this is relative to the body
## centre of mass.
Property AnchorB As Vector2

## The separation of the contact point, negative if penetrating.
Property Separation As Double

## The impulse along the manifold normal vector.
Property NormalImpulse As Double

## The friction impulse.
Property TangentImpulse As Double

## The total normal impulse applied across sub-stepping and restitution.
## This identifies speculative contact points that had an interaction in
## the time step.
Property TotalNormalImpulse As Double

## Relative normal velocity pre-solve. Used for hit events. If the normal
## impulse is zero then there was no hit. Negative means the shapes are
## approaching.
Property NormalVelocity As Double

## Uniquely identifies a contact point between two shapes. Upstream stores
## a uint16; Physics2D uses an Integer holding the same 0..65535 value.
Property Id As Integer

## Did this contact point exist in the previous step?
Property Persisted As Boolean

## Creates a zero point.
Constructor()
Me.Point = New Vector2(0.0, 0.0)
Me.AnchorA = New Vector2(0.0, 0.0)
Me.AnchorB = New Vector2(0.0, 0.0)
Me.Separation = 0.0
Me.NormalImpulse = 0.0
Me.TangentImpulse = 0.0
Me.TotalNormalImpulse = 0.0
Me.NormalVelocity = 0.0
Me.Id = 0
Me.Persisted = False
End Constructor

## Resets the geometry fields to zero. Solver fields are also reset; the
## solver copies them out before regenerating manifolds.
Function Reset() As ManifoldPoint
Me.Point.Set(0.0, 0.0)
Me.AnchorA.Set(0.0, 0.0)
Me.AnchorB.Set(0.0, 0.0)
Me.Separation = 0.0
Me.NormalImpulse = 0.0
Me.TangentImpulse = 0.0
Me.TotalNormalImpulse = 0.0
Me.NormalVelocity = 0.0
Me.Id = 0
Me.Persisted = False
Return Me
End Function

## Copies every field from another manifold point into this one. Used to
## snapshot manifolds for events.
Sub AssignFrom(other As ManifoldPoint)
Me.Point.Set(other.Point.X, other.Point.Y)
Me.AnchorA.Set(other.AnchorA.X, other.AnchorA.Y)
Me.AnchorB.Set(other.AnchorB.X, other.AnchorB.Y)
Me.Separation = other.Separation
Me.NormalImpulse = other.NormalImpulse
Me.TangentImpulse = other.TangentImpulse
Me.TotalNormalImpulse = other.TotalNormalImpulse
Me.NormalVelocity = other.NormalVelocity
Me.Id = other.Id
Me.Persisted = other.Persisted
End Sub
End Class

# Mass data computed for a shape, ported from upstream b2MassData in
# collision.h.
#
# Mass is in kilograms. The centre is the shape centroid relative to the
# shape origin. Rotational inertia is about the local origin, not the centre
# of mass.
Class MassData
## The mass of the shape in kilograms.
Property Mass As Double
## The position of the shape's centroid relative to the shape's origin.
Property Center As Vector2
## The rotational inertia of the shape about the local origin.
Property RotationalInertia As Double

## Creates zero mass data at the origin.
Constructor()
Me.Mass = 0.0
Me.Center = New Vector2(0.0, 0.0)
Me.RotationalInertia = 0.0
End Constructor

## Copies another mass data record. The centre is copied, not aliased.
Constructor(other As MassData)
Me.Mass = other.Mass
Me.Center = New Vector2(other.Center.X, other.Center.Y)
Me.RotationalInertia = other.RotationalInertia
End Constructor

## Fills this record from another in place and returns this record. The
## reused-output form for warm loops.
Function SetFrom(other As MassData) As MassData
Me.Mass = other.Mass
Me.Center.Set(other.Center.X, other.Center.Y)
Me.RotationalInertia = other.RotationalInertia
Return Me
End Function
End Class

# Public motor joint façade, ported from the b2MotorJoint_* surface in
# motor_joint.c. The motor joint drives body B toward a position and angle
# offset relative to body A, applying up to the maximum force and torque.
# Tuning changes deliberately do not wake the bodies, matching upstream; the
# solver picks up new values on the next step, and a sleeping body B keeps
# sleeping until the application wakes it. Maximum force and torque clamp
# negative inputs to zero like upstream b2MotorJoint_SetMaxForce and
# b2MotorJoint_SetMaxTorque, while non-finite inputs throw. The façade reads
# and writes its row in the owning JointSims store.
Class MotorJoint Inherits Joint
## Moves the linear offset target, ported from b2MotorJoint_SetLinearOffset.
## The offset is a tuning value: changing it does not wake the attached
## bodies, so wake body B explicitly when retargeting a sleeping joint.
Sub SetLinearOffset(linearOffset As Vector2)
Me.SetLinearOffset(linearOffset.X, linearOffset.Y)
End Sub

## Scalar form of SetLinearOffset. Prefer this overload in per-frame move
## loops: the vector form constructs a Vector2 argument, which allocates
## one object at the call site, while this form allocates nothing.
Sub SetLinearOffset(x As Double, y As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not x.IsFinite() Or Not y.IsFinite() Then
Throw New InvalidArgumentException("Motor joint linear offset must be finite")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
store.MotorLinearOffsetX.Items[Me.LocalIndex] = x
store.MotorLinearOffsetY.Items[Me.LocalIndex] = y
End Sub

## Linear offset target, ported from b2MotorJoint_GetLinearOffset. Returns
## a new Vector2 copy; safe to retain.
Function GetLinearOffset() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.MotorLinearOffsetX.Items[Me.LocalIndex], store.MotorLinearOffsetY.Items[Me.LocalIndex])
End Function

## Moves the angular offset target in radians, ported from
## b2MotorJoint_SetAngularOffset. The motor drives along the shortest arc.
Sub SetAngularOffset(angularOffset As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not angularOffset.IsFinite() Then
Throw New InvalidArgumentException("Motor joint angular offset must be finite")
End If
Me.Owner.GetJointSims(Me).MotorAngularOffset.Items[Me.LocalIndex] = angularOffset
End Sub

## Angular offset target in radians, ported from
## b2MotorJoint_GetAngularOffset.
Function GetAngularOffset() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MotorAngularOffset.Items[Me.LocalIndex]
End Function

## Maximum force magnitude in newtons, ported from b2MotorJoint_SetMaxForce.
## Negative values clamp to zero like upstream; non-finite values throw.
Sub SetMaxForce(maxForce As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not maxForce.IsFinite() Then
Throw New InvalidArgumentException("Motor joint max force must be finite")
End If
If maxForce < 0.0 Then
maxForce = 0.0
End If
Me.Owner.GetJointSims(Me).MotorMaxForce.Items[Me.LocalIndex] = maxForce
End Sub

## Maximum force magnitude in newtons, ported from b2MotorJoint_GetMaxForce.
Function GetMaxForce() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MotorMaxForce.Items[Me.LocalIndex]
End Function

## Maximum torque magnitude in newton-metres, ported from
## b2MotorJoint_SetMaxTorque. Negative values clamp to zero like upstream;
## non-finite values throw.
Sub SetMaxTorque(maxTorque As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not maxTorque.IsFinite() Then
Throw New InvalidArgumentException("Motor joint max torque must be finite")
End If
If maxTorque < 0.0 Then
maxTorque = 0.0
End If
Me.Owner.GetJointSims(Me).MotorMaxTorque.Items[Me.LocalIndex] = maxTorque
End Sub

## Maximum torque magnitude in newton-metres, ported from
## b2MotorJoint_GetMaxTorque.
Function GetMaxTorque() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MotorMaxTorque.Items[Me.LocalIndex]
End Function

## Position correction factor, ported from b2MotorJoint_SetCorrectionFactor.
## Values clamp into [0, 1] like upstream.
Sub SetCorrectionFactor(correctionFactor As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not correctionFactor.IsFinite() Then
Throw New InvalidArgumentException("Motor joint correction factor must be finite")
End If
If correctionFactor < 0.0 Then
correctionFactor = 0.0
ElseIf correctionFactor > 1.0 Then
correctionFactor = 1.0
End If
Me.Owner.GetJointSims(Me).MotorCorrectionFactor.Items[Me.LocalIndex] = correctionFactor
End Sub

## Position correction factor, ported from
## b2MotorJoint_GetCorrectionFactor.
Function GetCorrectionFactor() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MotorCorrectionFactor.Items[Me.LocalIndex]
End Function
End Class

# Motor joint definition, ported from upstream b2MotorJointDef and
# b2DefaultMotorJointDef in types.h and joint.c. Defaults match upstream:
# zero offsets, one newton maximum force, one newton-metre maximum torque,
# 0.3 correction factor. The joint drives body B toward a pose relative to
# body A rather than holding anchors together.
Class MotorJointDefinition
## First attached body, ported from b2MotorJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, driven toward the offset pose.
Property BodyB As Body
## Target position of body B minus body A in body A's frame, in metres.
Property LinearOffset As Vector2
## Target body B angle minus body A angle in radians.
Property AngularOffset As Double
## Maximum linear force magnitude, typically in newtons.
Property MaxForce As Double
## Maximum torque magnitude, typically in newton-metres.
Property MaxTorque As Double
## Position correction factor in [0, 1]; higher values close the pose gap
## faster. Clamped to the range like upstream.
Property CorrectionFactor As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LinearOffset = New Vector2(0.0, 0.0)
Me.AngularOffset = 0.0
Me.MaxForce = 1.0
Me.MaxTorque = 1.0
Me.CorrectionFactor = 0.3
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Public mouse joint façade, ported from the b2MouseJoint_* surface in
# mouse_joint.c. The mouse joint is a soft constraint that drags body B's
# anchor point toward a world-space target; body A is assumed static, as
# upstream documents. Tuning changes deliberately do not wake the bodies,
# matching upstream; the solver picks up new values on the next step, and a
# sleeping body B keeps sleeping until the application wakes it (the sample
# app wakes the dragged body explicitly). The façade reads and writes its
# row in the owning JointSims store.
Class MouseJoint Inherits Joint
## Moves the world-space drag target, ported from b2MouseJoint_SetTarget.
## The target is a tuning value: changing it does not wake the attached
## bodies, so wake body B explicitly when dragging a sleeping body.
Sub SetTarget(target As Vector2)
Me.SetTarget(target.X, target.Y)
End Sub

## Scalar form of SetTarget. Prefer this overload in per-frame drag loops:
## the vector form constructs a Vector2 argument, which allocates one
## object at the call site, while this form allocates nothing.
Sub SetTarget(x As Double, y As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not x.IsFinite() Or Not y.IsFinite() Then
Throw New InvalidArgumentException("Mouse joint target must be finite")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
store.MouseTargetX.Items[Me.LocalIndex] = x
store.MouseTargetY.Items[Me.LocalIndex] = y
End Sub

## World-space drag target, ported from b2MouseJoint_GetTarget. Returns a
## new Vector2 copy; safe to retain.
Function GetTarget() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.MouseTargetX.Items[Me.LocalIndex], store.MouseTargetY.Items[Me.LocalIndex])
End Function

## Spring stiffness in hertz, ported from b2MouseJoint_SetSpringHertz.
Sub SetSpringHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not hertz.IsFinite() Or hertz < 0.0 Then
Throw New InvalidArgumentException("Mouse joint hertz must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).MouseHertz.Items[Me.LocalIndex] = hertz
End Sub

## Spring stiffness in hertz, ported from b2MouseJoint_GetSpringHertz.
Function GetSpringHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MouseHertz.Items[Me.LocalIndex]
End Function

## Spring damping ratio, ported from b2MouseJoint_SetSpringDampingRatio.
Sub SetSpringDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not dampingRatio.IsFinite() Or dampingRatio < 0.0 Then
Throw New InvalidArgumentException("Mouse joint damping ratio must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).MouseDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Spring damping ratio, ported from b2MouseJoint_GetSpringDampingRatio.
Function GetSpringDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MouseDampingRatio.Items[Me.LocalIndex]
End Function

## Maximum force magnitude in newtons, ported from b2MouseJoint_SetMaxForce.
Sub SetMaxForce(maxForce As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not maxForce.IsFinite() Or maxForce < 0.0 Then
Throw New InvalidArgumentException("Mouse joint max force must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).MouseMaxForce.Items[Me.LocalIndex] = maxForce
End Sub

## Maximum force magnitude in newtons, ported from b2MouseJoint_GetMaxForce.
Function GetMaxForce() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MouseMaxForce.Items[Me.LocalIndex]
End Function

## Current world-space position of the dragged anchor on body B. Physics2D
## addition: upstream samples compute this from body transforms directly.
## Allocation note: returns a new Vector2 copy each call.
Function GetAnchorB() As Vector2
Me.CheckValid()
Var transformB As Transform = Me.Owner.GetBodyTransformById(Me.Edge1BodyId)
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return Transform.TransformPoint(transformB, New Vector2(store.LocalOriginAnchorBX.Items[Me.LocalIndex], store.LocalOriginAnchorBY.Items[Me.LocalIndex]))
End Function
End Class

# Mouse joint definition, ported from upstream b2MouseJointDef and
# b2DefaultMouseJointDef in types.h and joint.c. Defaults match upstream:
# four hertz spring, unit damping ratio, one newton maximum force. The first
# body is assumed static, as upstream documents; only body B moves.
Class MouseJointDefinition
## First attached body. Assumed static, ported from b2MouseJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, dragged toward the target.
Property BodyB As Body
## Initial target point in world space, in metres.
Property Target As Vector2
## Spring stiffness in hertz.
Property Hertz As Double
## Spring damping ratio, non-dimensional.
Property DampingRatio As Double
## Maximum force magnitude, typically in newtons.
Property MaxForce As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.Target = New Vector2(0.0, 0.0)
Me.Hertz = 4.0
Me.DampingRatio = 1.0
Me.MaxForce = 1.0
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Character-mover plane geometry, ported from upstream mover.c. The plane
# solver relaxes a desired translation against collision planes; the
# vector clipper removes velocity into planes that registered push.
# The collide helpers port upstream b2CollideMoverAndCircle/Capsule/
# Polygon/Segment in geometry.c: GJK shape distance between the shape and
# the mover capsule with the shape radius excluded from the proxy, and a
# hit plane when the distance reaches the total radius.
Class Mover
## Collides a circle with a mover capsule in local space, ported from
## b2CollideMoverAndCircle.
Shared Function CollideCircle(shape As Circle, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Center]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 1, 0.0)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a capsule with a mover capsule in local space, ported from
## b2CollideMoverAndCapsule.
Shared Function CollideCapsule(shape As Capsule, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Center1, shape.Center2]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 2, 0.0)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a polygon with a mover capsule in local space, ported from
## b2CollideMoverAndPolygon.
Shared Function CollidePolygon(shape As Polygon, mover As Capsule) As PlaneResult
Var proxyA As ShapeProxy = ShapeProxy.Make(shape.Vertices, shape.Count, shape.Radius)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a segment with a mover capsule in local space, ported from
## b2CollideMoverAndSegment. The segment radius is excluded from the total
## radius exactly like upstream, keeping chain ghost behaviour.
Shared Function CollideSegment(shape As Segment, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Point1, shape.Point2]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 2, 0.0)
Return CollideProxy(proxyA, mover.Radius, mover)
End Function

## Shared collide body: shape distance between the shape proxy and the
## mover capsule (radii excluded from the distance query), then a hit
## plane when the distance reaches the total radius.
Private Shared Function CollideProxy(proxyA As ShapeProxy, totalRadius As Double, mover As Capsule) As PlaneResult
Var input As New DistanceInput
input.ProxyA = proxyA
Var moverPoints() As Vector2 = [mover.Center1, mover.Center2]
input.ProxyB = ShapeProxy.Make(moverPoints, 2, mover.Radius)
input.TransformA = New Transform(New Vector2(0.0, 0.0), New Rot(1.0, 0.0))
input.TransformB = New Transform(New Vector2(0.0, 0.0), New Rot(1.0, 0.0))
input.UseRadii = False
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)
If output.Distance <= totalRadius Then
Var result As New PlaneResult
result.Plane = New Plane(output.Normal.X, output.Normal.Y, totalRadius - output.Distance)
result.Point = New Vector2(output.PointA.X, output.PointA.Y)
result.Hit = True
Return result
End If
Return New PlaneResult
End Function

## Solves the position of a mover that satisfies the given collision
## planes into a new result. The planes' Push values are updated in place,
## matching upstream b2SolvePlanes.
Shared Function SolvePlanes(targetDelta As Vector2, planes() As CollisionPlane, count As Integer) As PlaneSolverResult
Var out As New PlaneSolverResult
Mover.SolvePlanesTo(targetDelta, planes, count, out)
Return out
End Function

## Solves the position of a mover that satisfies the given collision
## planes into the caller-owned out result and returns out.
Shared Function SolvePlanesTo(targetDelta As Vector2, planes() As CollisionPlane, count As Integer, out As PlaneSolverResult) As PlaneSolverResult
For i As Integer = 0 To count - 1
planes[i].Push = 0.0
Next i

Var deltaX As Double = targetDelta.X
Var deltaY As Double = targetDelta.Y
Var tolerance As Double = PhysicsConstants.LINEAR_SLOP

Var iteration As Integer = 0
Var converged As Boolean = False
While iteration < 20 And converged = False
Var totalPush As Double = 0.0
For planeIndex As Integer = 0 To count - 1
Var plane As CollisionPlane = planes[planeIndex]

# Add slop to prevent jitter. The separation is evaluated against the
# running delta, matching b2PlaneSeparation(plane, delta).
Var separation As Double = plane.Plane.Normal.X * deltaX + plane.Plane.Normal.Y * deltaY - plane.Plane.Offset + PhysicsConstants.LINEAR_SLOP
Var push As Double = -separation

# Clamp accumulated push.
Var accumulatedPush As Double = plane.Push
Var updated As Double = plane.Push + push
If updated < 0.0 Then
updated = 0.0
ElseIf updated > plane.PushLimit Then
updated = plane.PushLimit
End If
plane.Push = updated
push = updated - accumulatedPush
deltaX = deltaX + push * plane.Plane.Normal.X
deltaY = deltaY + push * plane.Plane.Normal.Y

# Track maximum push for convergence.
Var absPush As Double = push
If absPush < 0.0 Then
absPush = -absPush
End If
totalPush = totalPush + absPush
Next planeIndex

If totalPush < tolerance Then
converged = True
Else
iteration = iteration + 1
End If
Wend

out.Translation.Set(deltaX, deltaY)
out.IterationCount = iteration
Return out
End Function

## Clips the velocity against the given collision planes and returns the
## clipped vector. Planes with zero push or ClipVelocity set to false are
## skipped, ported from upstream b2ClipVector.
Shared Function ClipVector(vector As Vector2, planes() As CollisionPlane, count As Integer) As Vector2
Var vX As Double = vector.X
Var vY As Double = vector.Y

For planeIndex As Integer = 0 To count - 1
Var plane As CollisionPlane = planes[planeIndex]
If plane.Push = 0.0 Or plane.ClipVelocity = False Then
Continue
End If

Var dot As Double = vX * plane.Plane.Normal.X + vY * plane.Plane.Normal.Y
If dot < 0.0 Then
vX = vX - dot * plane.Plane.Normal.X
vY = vY - dot * plane.Plane.Normal.Y
End If
Next planeIndex

Return New Vector2(vX, vY)
End Function
End Class

# Deterministic integer pair-key hash set, ported from Box2D 3.1.1 table.c.
#
# The broad phase stores shape pair keys here so the same pair is not turned
# into a contact twice (upstream b2HashSet used as the broad-phase pairSet).
# It is an open-addressing table over power-of-two capacity with linear
# probing and backshift removal, so there are no tombstones and no per-entry
# objects. Storage is two parallel Integer arrays (keys and hashes) following
# the Stage 2 parallel-scalar-array decision.
#
# Sentinel rules, matching upstream:
# - Key 0 is reserved and rejected; pair keys of distinct nonzero ids are
#   always nonzero.
# - Stored hash 0 marks an empty slot. Upstream asserts the computed hash is
#   never zero; this port deterministically maps a zero hash to 1 instead.
# - Hashes are full 32-bit values reduced from the 64-bit Murmur finaliser.
#
# After capacity warm-up, Add, Remove, and Contains allocate nothing. Clear
# is linear in capacity, matching the upstream memset.
Class PairKeySet
## Backing keys. Empty slots hold 0. Index directly only in hot engine code.
Property Keys() As Integer
## Backing hashes; 0 marks an empty slot.
Property Hashes() As Integer
## Number of stored keys.
Property Count As Integer
## Table capacity in slots; always a power of two.
Private Property mCapacity As Integer

## Creates a set. Capacity rounds up to a power of two, minimum 16.
Constructor(capacityHint As Integer)
Var capacity As Integer = 16
If capacityHint > 16 Then
capacity = PhysicsMaths.RoundUpPowerOfTwo(capacityHint)
End If
Me.Keys = New Array(Of Integer)
Me.Hashes = New Array(Of Integer)
Me.Count = 0
Me.mCapacity = capacity
Me.ReserveArrays(Me.mCapacity)
End Constructor

## Builds the canonical pair key for one unordered pair. Values are packed
## as 32-bit halves, matching upstream; engine ids are always non-negative.
## Keys of distinct nonzero values are nonzero; the result is reserved as a
## set key.
Shared Function PairKey(a As Integer, b As Integer) As Integer
Var small As Integer = a
Var large As Integer = b
If a > b Then
small = b
large = a
End If
Var key As Integer = small.ShiftLeft(32).BitOr(large.BitAnd(4294967295))
If key = 0 Then
Throw New InvalidArgumentException("PairKey(0, 0) is the reserved empty key")
End If
Return key
End Function

## Adds one key. Returns True when the key was already present.
Function Add(key As Integer) As Boolean
If key = 0 Then
Throw New InvalidArgumentException("PairKeySet key 0 is reserved")
End If
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var index As Integer = Me.FindSlot(key, hash)
If Me.Hashes[index] <> 0 Then
Return True
End If
If 2 * Me.Count >= Me.mCapacity Then
Me.Grow()
index = Me.FindSlot(key, hash)
End If
Me.Keys[index] = key
Me.Hashes[index] = hash
Me.Count = Me.Count + 1
Return False
End Function

## Removes one key. Returns True when the key was found. Removal backshifts
## later probe-chain entries so every stored key stays reachable.
Function Remove(key As Integer) As Boolean
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var i As Integer = Me.FindSlot(key, hash)
If Me.Hashes[i] = 0 Then
Return False
End If

Me.Keys[i] = 0
Me.Hashes[i] = 0
Me.Count = Me.Count - 1

# Backshift: close the gap so probe chains from every hash still reach
# their slot. The cyclic-interval test decides which neighbours to move.
Var j As Integer = i
Var scanning As Boolean = True
While scanning
j = (j + 1).BitAnd(Me.mCapacity - 1)
If Me.Hashes[j] = 0 Then
scanning = False
Else
Var k As Integer = Me.Hashes[j].BitAnd(Me.mCapacity - 1)
Var skipMove As Boolean = False
If i <= j Then
If i < k And k <= j Then
skipMove = True
End If
Else
If i < k Or k <= j Then
skipMove = True
End If
End If
If Not skipMove Then
Me.Keys[i] = Me.Keys[j]
Me.Hashes[i] = Me.Hashes[j]
Me.Keys[j] = 0
Me.Hashes[j] = 0
i = j
End If
End If
Wend
Return True
End Function

## Returns True when the key is present. Zero is rejected because it is the
## reserved empty marker, matching the upstream assertion.
Function Contains(key As Integer) As Boolean
If key = 0 Then
Throw New InvalidArgumentException("PairKeySet key 0 is reserved")
End If
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var index As Integer = Me.FindSlot(key, hash)
Return Me.Keys[index] = key
End Function

## Empties the set. Capacity is retained; zeroing matches the upstream memset.
Sub Clear()
For i As Integer = 0 To Me.mCapacity - 1
Me.Keys[i] = 0
Me.Hashes[i] = 0
Next i
Me.Count = 0
End Sub

## Current table capacity in slots; always a power of two.
Function Capacity() As Integer
Return Me.mCapacity
End Function

## Validates internal invariants: capacity is a power of two, every stored
## key is nonzero with a matching stored hash, counts agree, and every key
## still probes to its own slot.
Sub Validate()
If Not PhysicsMaths.IsPowerOfTwo(Me.mCapacity) Then
Throw New RuntimeException("PairKeySet capacity is not a power of two")
End If
If Me.Count < 0 Or Me.Count > Me.mCapacity Then
Throw New RuntimeException("PairKeySet count outside capacity")
End If
Var tally As Integer = 0
For i As Integer = 0 To Me.mCapacity - 1
If Me.Hashes[i] <> 0 Then
tally = tally + 1
If Me.Keys[i] = 0 Then
Throw New RuntimeException("PairKeySet empty key in occupied slot")
End If
Var expectedHash As Integer = PhysicsMaths.HashKey(Me.Keys[i])
If expectedHash = 0 Then
expectedHash = 1
End If
If Me.Hashes[i] <> expectedHash Then
Throw New RuntimeException("PairKeySet stored hash mismatch")
End If
If Me.FindSlot(Me.Keys[i], Me.Hashes[i]) <> i Then
Throw New RuntimeException("PairKeySet key does not probe to its slot")
End If
End If
Next i
If tally <> Me.Count Then
Throw New RuntimeException("PairKeySet tally disagrees with count")
End If
End Sub

## Walks the probe chain until the key or an empty slot is found.
Private Function FindSlot(key As Integer, hash As Integer) As Integer
Var index As Integer = hash.BitAnd(Me.mCapacity - 1)
While Me.Hashes[index] <> 0 And Me.Keys[index] <> key
index = (index + 1).BitAnd(Me.mCapacity - 1)
Wend
Return index
End Function

## Doubles the capacity and reinserts every stored key.
Private Sub Grow()
Var oldKeys() As Integer = Me.Keys
Var oldHashes() As Integer = Me.Hashes
Var oldCapacity As Integer = Me.mCapacity
Me.mCapacity = oldCapacity * 2
Me.Keys = New Array(Of Integer)
Me.Hashes = New Array(Of Integer)
Me.ReserveArrays(Me.mCapacity)
Me.Count = 0
For i As Integer = 0 To oldCapacity - 1
If oldHashes[i] <> 0 Then
Me.InsertHaveCapacity(oldKeys[i], oldHashes[i])
End If
Next i
End Sub

## Inserts a key known to fit, used only by Grow.
Private Sub InsertHaveCapacity(key As Integer, hash As Integer)
Var index As Integer = Me.FindSlot(key, hash)
Me.Keys[index] = key
Me.Hashes[index] = hash
Me.Count = Me.Count + 1
End Sub

## Ensures both backing arrays have room for capacity zeroed slots.
Private Sub ReserveArrays(capacity As Integer)
While Me.Keys.Count < capacity
Me.Keys.Append(0)
Me.Hashes.Append(0)
Wend
End Sub
End Class

# Physics tuning constants and identity sentinels.
#
# Ported from Box2D 3.1.1 src/constants.h, plus the null-index sentinel from
# src/core.h. Units are metres, kilograms, seconds, and radians. Upstream
# scales several lengths by a user-settable b2_lengthUnitsPerMeter; Physics2D
# fixes one metre per length unit, so every length here is a plain metre
# value. B2_MAX_WORKERS and B2_MAX_WORLDS are excluded because Physics2D has
# no task system and worlds are ordinary Objo objects.
#
# These values are internal infrastructure: they shape solver behaviour and
# must not change without re-baselining the golden fixtures.
Class PhysicsConstants
## Sentinel slot index meaning "no slot". Never confuse it with slot 0.
Public Const NULL_INDEX As Integer = -1

## Solver set indices, ported from the b2_*Set constants in core.h.
Public Const STATIC_SET As Integer = 0

## Solver set index of the disabled set.
Public Const DISABLED_SET As Integer = 1

## Solver set index of the awake set.
Public Const AWAKE_SET As Integer = 2

## First per-island sleeping solver set index.
Public Const FIRST_SLEEPING_SET As Integer = 3

## Sentinel generation that can never validate. Issued generations start at 1.
Public Const INVALID_GENERATION As Integer = 0

## Position magnitude treated as a runaway simulation (metres). Upstream B2_HUGE.
Public Const POSITION_LIMIT As Double = 100000.0

## Category bits used when a definition does not set its own. Upstream
## B2_DEFAULT_CATEGORY_BITS.
Public Const DEFAULT_CATEGORY_BITS As Integer = 1

## Mask bits that collide with every category. All bits set, expressed as the
## two's-complement Integer -1. Upstream B2_DEFAULT_MASK_BITS.
Public Const DEFAULT_MASK_BITS As Integer = -1

## Small length used as a collision and constraint tolerance (metres). 0.5 cm.
## Changing this materially affects stability.
Public Const LINEAR_SLOP As Double = 0.005

## 32-bit float machine epsilon, promoted to Double. Upstream uses FLT_EPSILON
## for float-precision guards; Physics2D keeps the same value so guard
## behaviour matches the pinned C release.
Public Const FLT_EPSILON As Double = 0.0000001192092896

## Pi. Matches upstream B2_PI.
Public Const PI As Double = 3.14159265358979323846

## Maximum rotation of a body per time step (radians). Prevents numerical
## problems; values of half pi or more would break continuous collision.
Public Const MAX_ROTATION As Double = 0.7853981633974483

## Limited speculative collision distance (metres). Reduces jitter. 2 cm.
## Changing this materially affects performance and stability.
Public Const SPECULATIVE_DISTANCE As Double = 0.02

## Extra margin added to dynamic tree bounds (metres). Lets proxies move a
## small amount without triggering a tree adjustment. 5 cm.
Public Const AABB_MARGIN As Double = 0.05

## Time a body must stay slow before it may sleep (seconds).
Public Const TIME_TO_SLEEP As Double = 0.5

## Default joint stiffness in hertz.
Public Const JOINT_CONSTRAINT_HERTZ As Double = 60.0

## Default joint damping ratio.
Public Const JOINT_CONSTRAINT_DAMPING_RATIO As Double = 2.0

## Constraint graph colour count. Constraints that cannot find a colour join
## the overflow set, which is solved single-threaded.
Public Const GRAPH_COLOUR_COUNT As Integer = 12
## Index of the overflow colour inside the constraint graph.
Public Const GRAPH_OVERFLOW_INDEX As Integer = 11

## Maximum number of vertices on a convex polygon. Changing this affects
## performance even when fewer vertices are used.
Public Const MAX_POLYGON_VERTICES As Integer = 8

## Dynamic tree node flag: the node slot is allocated.
Public Const NODE_ALLOCATED_FLAG As Integer = 1

## Dynamic tree node flag: the node bounds were enlarged past their margin.
Public Const NODE_ENLARGED_FLAG As Integer = 2

## Dynamic tree node flag: the node is a leaf holding a proxy.
Public Const NODE_LEAF_FLAG As Integer = 4
End Class

# Deterministic maths helpers required by the Box2D 3.1.1 algorithms.
#
# Ported from upstream src/math_functions.c. Box2D deliberately avoids
# platform trigonometric library calls so simulations behave identically on
# every machine; Physics2D preserves that intent by porting the same
# approximations over Double arithmetic. These functions are internal
# infrastructure used by rotation, joint, and solver code.
#
# Error notes (measured against the platform library on the reference
# machine, double arithmetic):
# - Atan2 differs from the platform atan2 by at most about 2.8e-5 radians.
# - ComputeCosSin differs from the platform sin/cos by at most about 1.7e-3,
#   the intrinsic error of upstream's Bhaskara-style approximation; after
#   normalisation the pair stays on the unit circle to rounding precision.
Class PhysicsMaths
## Two pi as a Double.
Public Const TWO_PI As Double = 6.283185307179586

## Wraps any angle into [-pi, pi] the way upstream b2UnwindAngle does.
## Upstream calls remainder(radians, 2 pi), which rounds the quotient
## half-to-even; the same policy is applied here.
Shared Function UnwindAngle(radians As Double) As Double
Var quotient As Double = radians / TWO_PI
Var rounded As Double = Maths.Round(quotient, RoundingMode.ToEven)
Return radians - rounded * TWO_PI
End Function

## True when the vector is a unit vector within the upstream tolerance,
## ported from b2IsNormalized: the squared length differs from one by less
## than 100 float epsilons.
Shared Function IsNormalized(a As Vector2) As Boolean
Var aa As Double = a.X * a.X + a.Y * a.Y
Return Maths.Abs(1.0 - aa) < 100.0 * PhysicsConstants.FLT_EPSILON
End Function

## Deterministic arctangent ported from upstream b2Atan2. The minimax
## polynomial was tuned for 32-bit floats; Physics2D keeps the same formula
## and constants so angle results follow upstream behaviour.
Shared Function Atan2(y As Double, x As Double) As Double
# Added check for (0,0) to match atan2 and avoid NaN.
If x = 0.0 And y = 0.0 Then
Return 0.0
End If

Var ax As Double = Maths.Abs(x)
Var ay As Double = Maths.Abs(y)
Var mx As Double = Maths.Max(ay, ax)
Var mn As Double = Maths.Min(ay, ax)
Var a As Double = mn / mx

# Minimax polynomial approximation to atan(a) on [0, 1].
Var s As Double = a * a
Var c As Double = s * a
Var q As Double = s * s
Var r As Double = 0.024840285 * q + 0.18681418
Var t As Double = -0.094097948 * q - 0.33213072
r = r * s + t
r = r * c + a

# Map to the full circle.
If ay > ax Then
r = 1.57079637 - r
End If

If x < 0.0 Then
r = 3.14159274 - r
End If

If y < 0.0 Then
r = -r
End If

Return r
End Function

## Computes the deterministic cosine and sine pair from upstream
## b2ComputeCosSin into a caller-owned result object and returns it. The
## result is normalised to the unit circle. Use this form in warm code to
## avoid allocation; the single-argument overload is the allocating form.
Shared Function ComputeCosSin(radians As Double, out As CosSin) As CosSin
Var x As Double = UnwindAngle(radians)
Var pi2 As Double = Maths.PI * Maths.PI

# Cosine needs the angle in [-pi/2, pi/2].
Var c As Double = 0.0
If x < -1.5707963267948966 Then
Var y As Double = x + Maths.PI
Var y2 As Double = y * y
c = -(pi2 - 4.0 * y2) / (pi2 + y2)
ElseIf x > 1.5707963267948966 Then
Var y As Double = x - Maths.PI
Var y2 As Double = y * y
c = -(pi2 - 4.0 * y2) / (pi2 + y2)
Else
Var y2 As Double = x * x
c = (pi2 - 4.0 * y2) / (pi2 + y2)
End If

# Sine needs the angle in [0, pi].
Var s As Double = 0.0
If x < 0.0 Then
Var y As Double = x + Maths.PI
s = -16.0 * y * (Maths.PI - y) / (5.0 * pi2 - 4.0 * y * (Maths.PI - y))
Else
s = 16.0 * x * (Maths.PI - x) / (5.0 * pi2 - 4.0 * x * (Maths.PI - x))
End If

Var mag As Double = Maths.Sqrt(s * s + c * c)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If

out.Cos = c * invMag
out.Sin = s * invMag
Return out
End Function

## Allocating convenience overload of ComputeCosSin. Suitable for cold paths
## such as construction and examples; step-loop code should use the
## caller-owned output overload.
Shared Function ComputeCosSin(radians As Double) As CosSin
Return ComputeCosSin(radians, New CosSin)
End Function

## Counts trailing zero bits of a nonzero Integer. Returns 64 for zero,
## a defined value the caller must not treat as a bit index. Objo has no
## intrinsic for this, so a comparison ladder keeps it allocation-free.
Shared Function TrailingZeros(value As Integer) As Integer
If value = 0 Then
Return 64
End If

Var count As Integer = 0
Var v As Integer = value
If v.BitAnd(4294967295) = 0 Then
count = count + 32
v = v.ShiftRight(32)
End If
If v.BitAnd(65535) = 0 Then
count = count + 16
v = v.ShiftRight(16)
End If
If v.BitAnd(255) = 0 Then
count = count + 8
v = v.ShiftRight(8)
End If
If v.BitAnd(15) = 0 Then
count = count + 4
v = v.ShiftRight(4)
End If
If v.BitAnd(3) = 0 Then
count = count + 2
v = v.ShiftRight(2)
End If
If v.BitAnd(1) = 0 Then
count = count + 1
End If
Return count
End Function

## Returns True when the value is a positive power of two. Unlike upstream
## b2IsPowerOf2, zero is rejected here because capacity callers never pass
## zero and a positive-only contract avoids surprising results.
Shared Function IsPowerOfTwo(value As Integer) As Boolean
Return value > 0 And value.BitAnd(value - 1) = 0
End Function

## Number of bits needed to hold any value up to value - 1, ported from
## upstream b2BoundingPowerOf2: the minimum is one and the result is
## ceiling(log2(value)) for values above two.
Shared Function BoundingPowerOfTwo(value As Integer) As Integer
If value <= 1 Then
Return 1
End If
Var v As Integer = value - 1
Var bits As Integer = 1
While v > 1
v = v.ShiftRight(1)
bits = bits + 1
Wend
Return bits
End Function

## Rounds the value up to the nearest power of two, ported from upstream
## b2RoundUpPowerOf2. Values of one or less round to one.
Shared Function RoundUpPowerOfTwo(value As Integer) As Integer
If value <= 1 Then
Return 1
End If

Var v As Integer = value - 1
v = v.BitOr(v.ShiftRight(1))
v = v.BitOr(v.ShiftRight(2))
v = v.BitOr(v.ShiftRight(4))
v = v.BitOr(v.ShiftRight(8))
v = v.BitOr(v.ShiftRight(16))
v = v.BitOr(v.ShiftRight(32))
Return v + 1
End Function

## Murmur3 64-bit finaliser over the key, reduced to 32 bits, ported from
## upstream b2KeyHash. Pair keys built from ordered integer pairs mix well
## with this hash. Deterministic on every platform because it uses only
## integer arithmetic; shifts are logical, matching the unsigned upstream
## form.
Shared Function HashKey(key As Integer) As Integer
Var h As Integer = key
h = h.BitXor(LogicalShiftRight(h, 33))
h = h * -49064778989728563
h = h.BitXor(LogicalShiftRight(h, 33))
h = h * -4265267296055464877
h = h.BitXor(LogicalShiftRight(h, 33))
Return h.BitAnd(4294967295)
End Function

## Logical (unsigned) right shift. Objo's ShiftRight is arithmetic, so the
## sign bits are masked off afterwards to match the unsigned C form.
Private Shared Function LogicalShiftRight(value As Integer, count As Integer) As Integer
Return value.ShiftRight(count).BitAnd((1.ShiftLeft(64 - count)) - 1)
End Function
End Class

# A plane in 2D: signed separation = dot(normal, point) - offset, ported
# from upstream b2Plane in math_functions.h. The normal must be a unit
# vector for the separation to be a true distance.
Class Plane
## The unit normal of the plane.
Property Normal As Vector2

## The offset of the plane along its normal.
Property Offset As Double

## Creates a plane with a zero normal and offset.
Constructor()
Me.Normal = New Vector2(0.0, 0.0)
Me.Offset = 0.0
End Constructor

## Creates a plane from a unit normal and offset.
Constructor(normalX As Double, normalY As Double, offset As Double)
Me.Normal = New Vector2(normalX, normalY)
Me.Offset = offset
End Constructor

## Returns the signed separation of the point from the plane, ported from
## upstream b2PlaneSeparation.
Function Separation(point As Vector2) As Double
Return Me.Normal.X * point.X + Me.Normal.Y * point.Y - Me.Offset
End Function
End Class

# The collision plane between a mover and a convex shape, ported from
# upstream b2PlaneResult in collision.h. World queries produce these; the
# character mover consumes them.
Class PlaneResult
## The collision plane between the mover and a convex shape.
Property Plane As Plane

## The collision point on the shape.
Property Point As Vector2

## True when the collision registered a hit; otherwise ignore the plane.
Property Hit As Boolean

## Creates an empty result.
Constructor()
Me.Plane = New Plane
Me.Point = New Vector2(0.0, 0.0)
Me.Hit = False
End Constructor

## Creates a result from its fields.
Constructor(plane As Plane, point As Vector2, hit As Boolean)
Me.Plane = plane
Me.Point = point
Me.Hit = hit
End Constructor
End Class

# The result of the plane solver, ported from upstream b2PlaneSolverResult
# in collision.h.
Class PlaneSolverResult
## The translation of the mover that satisfies the planes.
Property Translation As Vector2

## The number of iterations the solver used, for diagnostics.
Property IterationCount As Integer

## Creates an empty result.
Constructor()
Me.Translation = New Vector2(0.0, 0.0)
Me.IterationCount = 0
End Constructor

## Resets the result in place and returns it for warm reuse.
Function Reset() As PlaneSolverResult
Me.Translation.Set(0.0, 0.0)
Me.IterationCount = 0
Return Me
End Function
End Class

# A solid convex polygon with counter-clockwise winding, ported from upstream
# b2Polygon in collision.h and the factory functions in geometry.c.
#
# The interior lies to the left of each edge. Polygons hold at most
# MAX_POLYGON_VERTICES vertices. Use the Shared factories (MakeBox,
# MakePolygon, and friends) instead of the raw constructor: the factories
# compute normals and centroid and validate their input. Vertices and normals
# are owned arrays, copied on construction, so editing the polygon never
# mutates caller data and factory input never mutates the polygon.
Class Polygon
## The polygon vertices.
Property Vertices() As Vector2
## The outward normal vectors of the polygon sides.
Property Normals() As Vector2
## The centroid of the polygon.
Property Centroid As Vector2
## The external radius for rounded polygons.
Property Radius As Double
## The number of polygon vertices.
Property Count As Integer

## Creates an empty polygon. Use the Shared factories instead.
Constructor()
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)
Me.Centroid = New Vector2(0.0, 0.0)
Me.Radius = 0.0
Me.Count = 0
End Constructor

## Builds a polygon from a validated hull, ported from upstream b2MakePolygon.
## Throws InvalidArgumentException when the hull is not valid or the radius
## is negative or not finite.
Constructor(hullData As Hull, radius As Double)
If Not Hull.Validate(hullData) Then
Throw New InvalidArgumentException("Polygon hull must be valid")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If

Me.Count = hullData.Count
Me.Radius = radius
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)

# Copy vertices.
For i As Integer = 0 To Me.Count - 1
Me.Vertices.Append(New Vector2(hullData.Points[i].X, hullData.Points[i].Y))
Next i

# Compute normals. Valid hull edges have non-zero length.
Polygon.ComputeNormals(Me.Vertices, Me.Normals, Me.Count)
Me.Centroid = Polygon.ComputeCentroid(Me.Vertices, Me.Count)
End Constructor

## Internal raw constructor used by factories and collide helpers. Copies the
## supplied arrays. Callers must guarantee valid, convex, counter-clockwise
## geometry with unit normals.
Constructor(vertices() As Vector2, normals() As Vector2, centroid As Vector2, radius As Double, count As Integer)
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)
For i As Integer = 0 To count - 1
Me.Vertices.Append(New Vector2(vertices[i].X, vertices[i].Y))
Me.Normals.Append(New Vector2(normals[i].X, normals[i].Y))
Next i
Me.Centroid = New Vector2(centroid.X, centroid.Y)
Me.Radius = radius
Me.Count = count
End Constructor

## Builds a polygon from a hull with a position and rotation offset, ported
## from upstream b2MakeOffsetPolygon (zero radius).
Shared Function MakeOffsetPolygon(hull As Hull, position As Vector2, rotation As Rot) As Polygon
Return Polygon.MakeOffsetRoundedPolygon(hull, position, rotation, 0.0)
End Function

## Builds a rounded polygon from a hull with a position and rotation offset,
## ported from upstream b2MakeOffsetRoundedPolygon.
Shared Function MakeOffsetRoundedPolygon(hullData As Hull, position As Vector2, rotation As Rot, radius As Double) As Polygon
If Not Hull.Validate(hullData) Then
Throw New InvalidArgumentException("Polygon hull must be valid")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If

Var shape As New Polygon
shape.Count = hullData.Count
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)

# Copy transformed vertices.
For i As Integer = 0 To shape.Count - 1
Var x As Double = rotation.C * hullData.Points[i].X - rotation.S * hullData.Points[i].Y + position.X
Var y As Double = rotation.S * hullData.Points[i].X + rotation.C * hullData.Points[i].Y + position.Y
shape.Vertices.Append(New Vector2(x, y))
Next i

Polygon.ComputeNormals(shape.Vertices, shape.Normals, shape.Count)
shape.Centroid = Polygon.ComputeCentroid(shape.Vertices, shape.Count)
Return shape
End Function

## Builds a square with the given half width, ported from upstream
## b2MakeSquare.
Shared Function MakeSquare(halfWidth As Double) As Polygon
Return Polygon.MakeBox(halfWidth, halfWidth)
End Function

## Builds an axis-aligned box from half extents, ported from upstream
## b2MakeBox. Throws InvalidArgumentException when a half extent is not
## finite or not positive.
Shared Function MakeBox(halfWidth As Double, halfHeight As Double) As Polygon
If Not halfWidth.IsFinite() Or halfWidth <= 0.0 Then
Throw New InvalidArgumentException("Box half width must be finite and positive")
End If
If Not halfHeight.IsFinite() Or halfHeight <= 0.0 Then
Throw New InvalidArgumentException("Box half height must be finite and positive")
End If

Var shape As New Polygon
shape.Count = 4
shape.Radius = 0.0
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
shape.Vertices.Append(New Vector2(-halfWidth, -halfHeight))
shape.Vertices.Append(New Vector2(halfWidth, -halfHeight))
shape.Vertices.Append(New Vector2(halfWidth, halfHeight))
shape.Vertices.Append(New Vector2(-halfWidth, halfHeight))
shape.Normals.Append(New Vector2(0.0, -1.0))
shape.Normals.Append(New Vector2(1.0, 0.0))
shape.Normals.Append(New Vector2(0.0, 1.0))
shape.Normals.Append(New Vector2(-1.0, 0.0))
shape.Centroid = New Vector2(0.0, 0.0)
Return shape
End Function

## Builds a rounded axis-aligned box, ported from upstream b2MakeRoundedBox.
Shared Function MakeRoundedBox(halfWidth As Double, halfHeight As Double, radius As Double) As Polygon
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If
Var shape As Polygon = Polygon.MakeBox(halfWidth, halfHeight)
shape.Radius = radius
Return shape
End Function

## Builds an offset box: half extents placed at centre with rotation, ported
## from upstream b2MakeOffsetBox.
Shared Function MakeOffsetBox(halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot) As Polygon
Return Polygon.MakeOffsetRoundedBox(halfWidth, halfHeight, center, rotation, 0.0)
End Function

## Builds an offset rounded box, ported from upstream
## b2MakeOffsetRoundedBox.
Shared Function MakeOffsetRoundedBox(halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot, radius As Double) As Polygon
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If
If Not halfWidth.IsFinite() Or halfWidth <= 0.0 Then
Throw New InvalidArgumentException("Box half width must be finite and positive")
End If
If Not halfHeight.IsFinite() Or halfHeight <= 0.0 Then
Throw New InvalidArgumentException("Box half height must be finite and positive")
End If

Var shape As New Polygon
shape.Count = 4
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, -1.0, -1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, 1.0, -1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, 1.0, 1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, -1.0, 1.0)
Polygon.AppendTransformedNormal(shape, rotation, 0.0, -1.0)
Polygon.AppendTransformedNormal(shape, rotation, 1.0, 0.0)
Polygon.AppendTransformedNormal(shape, rotation, 0.0, 1.0)
Polygon.AppendTransformedNormal(shape, rotation, -1.0, 0.0)
shape.Centroid = New Vector2(center.X, center.Y)
Return shape
End Function

## Returns a transformed copy of the polygon, ported from upstream
## b2TransformPolygon.
Shared Function TransformPolygon(transform As Transform, polygon As Polygon) As Polygon
Var result As New Polygon
result.Count = polygon.Count
result.Radius = polygon.Radius
For i As Integer = 0 To polygon.Count - 1
Var vx As Double = transform.Q.C * polygon.Vertices[i].X - transform.Q.S * polygon.Vertices[i].Y + transform.P.X
Var vy As Double = transform.Q.S * polygon.Vertices[i].X + transform.Q.C * polygon.Vertices[i].Y + transform.P.Y
result.Vertices.Append(New Vector2(vx, vy))
Var nx As Double = transform.Q.C * polygon.Normals[i].X - transform.Q.S * polygon.Normals[i].Y
Var ny As Double = transform.Q.S * polygon.Normals[i].X + transform.Q.C * polygon.Normals[i].Y
result.Normals.Append(New Vector2(nx, ny))
Next i
Var cx As Double = transform.Q.C * polygon.Centroid.X - transform.Q.S * polygon.Centroid.Y + transform.P.X
Var cy As Double = transform.Q.S * polygon.Centroid.X + transform.Q.C * polygon.Centroid.Y + transform.P.Y
result.Centroid.Set(cx, cy)
Return result
End Function

## Builds the two-vertex capsule polygon used by collide dispatch, ported
## from the private upstream b2MakeCapsule in manifold.c.
Shared Function MakeCapsulePolygon(p1 As Vector2, p2 As Vector2, radius As Double) As Polygon
Var shape As New Polygon
shape.Count = 2
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
shape.Vertices.Append(New Vector2(p1.X, p1.Y))
shape.Vertices.Append(New Vector2(p2.X, p2.Y))
shape.Centroid.Set(0.5 * (p1.X + p2.X), 0.5 * (p1.Y + p2.Y))

Var dx As Double = p2.X - p1.X
Var dy As Double = p2.Y - p1.Y
Var len As Double = Maths.Sqrt(dx * dx + dy * dy)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
# Normal points to the right of the axis.
Var nx As Double = dy * invLen
Var ny As Double = -dx * invLen
shape.Normals.Append(New Vector2(nx, ny))
shape.Normals.Append(New Vector2(-nx, -ny))
Return shape
End Function

## Appends one box corner transformed by centre and rotation.
Shared Sub AppendTransformedCorner(shape As Polygon, halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot, signX As Double, signY As Double)
Var lx As Double = signX * halfWidth
Var ly As Double = signY * halfHeight
Var x As Double = rotation.C * lx - rotation.S * ly + center.X
Var y As Double = rotation.S * lx + rotation.C * ly + center.Y
shape.Vertices.Append(New Vector2(x, y))
End Sub

## Appends one box face normal transformed by the rotation.
Shared Sub AppendTransformedNormal(shape As Polygon, rotation As Rot, nx As Double, ny As Double)
Var x As Double = rotation.C * nx - rotation.S * ny
Var y As Double = rotation.S * nx + rotation.C * ny
shape.Normals.Append(New Vector2(x, y))
End Sub

## Computes outward unit normals for a counter-clockwise vertex loop.
Shared Sub ComputeNormals(vertices() As Vector2, normals() As Vector2, count As Integer)
For i As Integer = 0 To count - 1
Var i1 As Integer = i
Var i2 As Integer = i
If i1 < count - 1 Then
i2 = i1 + 1
Else
i2 = 0
End If
Var ex As Double = vertices[i2].X - vertices[i1].X
Var ey As Double = vertices[i2].Y - vertices[i1].Y
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
# b2CrossVS(edge, 1) rotates the edge left; outward for CCW winding.
normals.Append(New Vector2(ey * invLen, -ex * invLen))
Next i
End Sub

## Area-weighted centroid via triangle fans, ported from the private
## upstream b2ComputePolygonCentroid.
Shared Function ComputeCentroid(vertices() As Vector2, count As Integer) As Vector2
Var centerX As Double = 0.0
Var centerY As Double = 0.0
Var area As Double = 0.0

# Use the first vertex as reference point to reduce round-off error.
Var ox As Double = vertices[0].X
Var oy As Double = vertices[0].Y

Var inv3 As Double = 1.0 / 3.0

For i As Integer = 1 To count - 2
# Triangle edges.
Var e1x As Double = vertices[i].X - ox
Var e1y As Double = vertices[i].Y - oy
Var e2x As Double = vertices[i + 1].X - ox
Var e2y As Double = vertices[i + 1].Y - oy
Var a As Double = 0.5 * (e1x * e2y - e1y * e2x)

# Area weighted centroid.
Var w As Double = a * inv3
centerX = centerX + w * (e1x + e2x)
centerY = centerY + w * (e1y + e2y)
area = area + a
Next i

If area <= 0.0000001192092896 Then
Throw New RuntimeException("Polygon area is degenerate")
End If

Var invArea As Double = 1.0 / area
Return New Vector2(ox + centerX * invArea, oy + centerY * invArea)
End Function
## Computes the mass data of the polygon, ported from upstream
## b2ComputePolygonMass. One- and two-vertex polygons delegate to the
## circle and capsule mass. Rounded polygons approximate their mass by
## pushing vertices outward. Inertia is about the local origin.
Function ComputeMass(density As Double) As MassData
Var data As New MassData
Return Me.ComputeMassTo(density, data)
End Function

## Caller-owned output form of ComputeMass for warm paths. The plain
## polygon path allocates nothing; rounded polygons still build a temporary
## pushed-out vertex array and are treated as a cold path.
Function ComputeMassTo(density As Double, out As MassData) As MassData
Var vertices As Array(Of Vector2) = Me.Vertices
If Me.Radius > 0.0 Then
# Approximate the mass of rounded polygons by pushing out the vertices.
Var pushed As New Array(Of Vector2)
Var sqrt2 As Double = 1.412
For i As Integer = 0 To Me.Count - 1
Var j As Integer = i - 1
If i = 0 Then
j = Me.Count - 1
End If
Var n1 As Vector2 = Me.Normals[j]
Var n2 As Vector2 = Me.Normals[i]
Var midX As Double = n1.X + n2.X
Var midY As Double = n1.Y + n2.Y
Var midLen As Double = Maths.Sqrt(midX * midX + midY * midY)
If midLen > PhysicsConstants.FLT_EPSILON Then
midX = midX / midLen
midY = midY / midLen
Else
midX = 0.0
midY = 0.0
End If
pushed.Append(New Vector2(Me.Vertices[i].X + sqrt2 * Me.Radius * midX, Me.Vertices[i].Y + sqrt2 * Me.Radius * midY))
Next i
vertices = pushed
End If

Var centerX As Double = 0.0
Var centerY As Double = 0.0
Var area As Double = 0.0
Var rotationalInertia As Double = 0.0

# Reference point for forming triangles: the first vertex reduces
# round-off error.
Var rx As Double = vertices[0].X
Var ry As Double = vertices[0].Y

Var inv3 As Double = 1.0 / 3.0

For i As Integer = 1 To Me.Count - 2
# Triangle edges.
Var e1x As Double = vertices[i].X - rx
Var e1y As Double = vertices[i].Y - ry
Var e2x As Double = vertices[i + 1].X - rx
Var e2y As Double = vertices[i + 1].Y - ry

Var crossD As Double = e1x * e2y - e1y * e2x

Var triangleArea As Double = 0.5 * crossD
area = area + triangleArea

# Area weighted centroid, r at origin.
Var sumX As Double = e1x + e2x
Var sumY As Double = e1y + e2y
centerX = centerX + triangleArea * inv3 * sumX
centerY = centerY + triangleArea * inv3 * sumY

Var intx2 As Double = e1x * e1x + e2x * e1x + e2x * e2x
Var inty2 As Double = e1y * e1y + e2y * e1y + e2y * e2y

rotationalInertia = rotationalInertia + (0.25 * inv3 * crossD) * (intx2 + inty2)
Next i

# Total mass.
out.Mass = density * area

# Centre of mass, shifted back from the origin at r.
If area <= PhysicsConstants.FLT_EPSILON Then
Throw New RuntimeException("Polygon area must be positive")
End If
Var invArea As Double = 1.0 / area
out.Center.Set(rx + centerX * invArea, ry + centerY * invArea)

# Inertia tensor relative to the local origin.
out.RotationalInertia = density * rotationalInertia

# Shift to the centre of mass.
Var cc As Double = out.Center.X * out.Center.X + out.Center.Y * out.Center.Y
Var localX As Double = centerX * invArea
Var localY As Double = centerY * invArea
Var c2 As Double = localX * localX + localY * localY
out.RotationalInertia = out.RotationalInertia + out.Mass * (cc - c2)

Return out
End Function

## Computes the world-space AABB of the transformed polygon, ported from
## upstream b2ComputePolygonAABB.
Function ComputeAABB(transform As Transform) As AABB
Return Me.ComputeAABBTo(transform, New AABB)
End Function

## Caller-owned output form of ComputeAABB for warm paths.
Function ComputeAABBTo(transform As Transform, out As AABB) As AABB
If Me.Count <= 0 Then
Throw New RuntimeException("Polygon must hold at least one vertex")
End If
Var lowerX As Double = transform.Q.C * Me.Vertices[0].X - transform.Q.S * Me.Vertices[0].Y + transform.P.X
Var lowerY As Double = transform.Q.S * Me.Vertices[0].X + transform.Q.C * Me.Vertices[0].Y + transform.P.Y
Var upperX As Double = lowerX
Var upperY As Double = lowerY
For i As Integer = 1 To Me.Count - 1
Var vx As Double = transform.Q.C * Me.Vertices[i].X - transform.Q.S * Me.Vertices[i].Y + transform.P.X
Var vy As Double = transform.Q.S * Me.Vertices[i].X + transform.Q.C * Me.Vertices[i].Y + transform.P.Y
If vx < lowerX Then
lowerX = vx
End If
If vy < lowerY Then
lowerY = vy
End If
If vx > upperX Then
upperX = vx
End If
If vy > upperY Then
upperY = vy
End If
Next i
out.LowerBound.Set(lowerX - Me.Radius, lowerY - Me.Radius)
out.UpperBound.Set(upperX + Me.Radius, upperY + Me.Radius)
Return out
End Function

## Determines whether the point lies within the polygon, ported from
## upstream b2PointInPolygon. Uses the GJK distance between the polygon's
## point cloud and the single query point.
Function ContainsPoint(point As Vector2) As Boolean
Var input As New DistanceInput
input.ProxyA = ShapeProxy.Make(Me.Vertices, Me.Count, 0.0)
Var onePoint As New Array(Of Vector2)
onePoint.Append(point)
input.ProxyB = ShapeProxy.Make(onePoint, 1, 0.0)
input.UseRadii = False
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)
Return output.Distance <= Me.Radius
End Function
End Class

# Public prismatic joint façade, ported from the b2PrismaticJoint_* surface
# in prismatic_joint.c. The joint lets two bodies slide along one axis; a
# spring, limits, and a motor optionally act on that translation. Tuning
# changes deliberately do not wake the bodies, matching upstream; the
# solver picks up new values on the next step. Enabling or disabling the
# spring, limits, or motor clears the corresponding accumulated impulses
# exactly like the upstream toggles. Setters store plain values where
# upstream stores plain values and throw where upstream asserts. The façade
# reads and writes its row in the owning JointSims store.
Class PrismaticJoint Inherits Joint
## Enables the linear spring, ported from b2PrismaticJoint_EnableSpring.
## Toggling clears the accumulated spring impulse.
Sub EnableSpring(enableSpring As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableSpring Then
flag = 1
End If
If flag <> store.EnableSpring.Items[Me.LocalIndex] Then
store.EnableSpring.Items[Me.LocalIndex] = flag
store.PrismaticSpringImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the linear spring is active, ported from
## b2PrismaticJoint_IsSpringEnabled.
Function IsSpringEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableSpring.Items[Me.LocalIndex] <> 0
End Function

## Spring stiffness in hertz, ported from b2PrismaticJoint_SetSpringHertz.
Sub SetSpringHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).PrismaticHertz.Items[Me.LocalIndex] = hertz
End Sub

## Spring stiffness in hertz, ported from b2PrismaticJoint_GetSpringHertz.
Function GetSpringHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticHertz.Items[Me.LocalIndex]
End Function

## Spring damping ratio, ported from
## b2PrismaticJoint_SetSpringDampingRatio.
Sub SetSpringDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).PrismaticDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Spring damping ratio, ported from
## b2PrismaticJoint_GetSpringDampingRatio.
Function GetSpringDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticDampingRatio.Items[Me.LocalIndex]
End Function

## Target translation in metres, ported from
## b2PrismaticJoint_SetTargetTranslation. Changes apply from the next step
## and do not wake the bodies.
Sub SetTargetTranslation(translation As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).PrismaticTargetTranslation.Items[Me.LocalIndex] = translation
End Sub

## Target translation in metres, ported from
## b2PrismaticJoint_GetTargetTranslation.
Function GetTargetTranslation() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticTargetTranslation.Items[Me.LocalIndex]
End Function

## Current translation in metres along the axis, ported from
## b2PrismaticJoint_GetTranslation: the body B anchor point minus the
## body A anchor point projected on the live axis. Allocates the returned
## query vectors.
Function GetTranslation() As Double
Me.CheckValid()
Var transformA As Transform = Me.Owner.GetBodyTransform(Me.GetBodyA())
Var transformB As Transform = Me.Owner.GetBodyTransform(Me.GetBodyB())
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var axisX As Double = transformA.Q.C * store.PrismaticLocalAxisX.Items[Me.LocalIndex] - transformA.Q.S * store.PrismaticLocalAxisY.Items[Me.LocalIndex]
Var axisY As Double = transformA.Q.S * store.PrismaticLocalAxisX.Items[Me.LocalIndex] + transformA.Q.C * store.PrismaticLocalAxisY.Items[Me.LocalIndex]
# Anchor points in world space.
Var localA As Vector2 = Me.GetLocalAnchorA()
Var localB As Vector2 = Me.GetLocalAnchorB()
Var pAX As Double = transformA.P.X + transformA.Q.C * localA.X - transformA.Q.S * localA.Y
Var pAY As Double = transformA.P.Y + transformA.Q.S * localA.X + transformA.Q.C * localA.Y
Var pBX As Double = transformB.P.X + transformB.Q.C * localB.X - transformB.Q.S * localB.Y
Var pBY As Double = transformB.P.Y + transformB.Q.S * localB.X + transformB.Q.C * localB.Y
Return (pBX - pAX) * axisX + (pBY - pAY) * axisY
End Function

## Current translation speed in metres per second, ported from
## b2PrismaticJoint_GetSpeed. Allocates the returned query vectors.
Function GetSpeed() As Double
Me.CheckValid()
Var bodyA As Body = Me.GetBodyA()
Var bodyB As Body = Me.GetBodyB()
Var transformA As Transform = Me.Owner.GetBodyTransform(bodyA)
Var transformB As Transform = Me.Owner.GetBodyTransform(bodyB)
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var axisX As Double = transformA.Q.C * store.PrismaticLocalAxisX.Items[Me.LocalIndex] - transformA.Q.S * store.PrismaticLocalAxisY.Items[Me.LocalIndex]
Var axisY As Double = transformA.Q.S * store.PrismaticLocalAxisX.Items[Me.LocalIndex] + transformA.Q.C * store.PrismaticLocalAxisY.Items[Me.LocalIndex]
# Anchor offsets from the centres of mass in world space.
Var localA As Vector2 = Me.GetLocalAnchorA()
Var localB As Vector2 = Me.GetLocalAnchorB()
Var centerLocalA As Vector2 = bodyA.GetLocalCenterOfMass()
Var centerLocalB As Vector2 = bodyB.GetLocalCenterOfMass()
Var rAX As Double = transformA.Q.C * (localA.X - centerLocalA.X) - transformA.Q.S * (localA.Y - centerLocalA.Y)
Var rAY As Double = transformA.Q.S * (localA.X - centerLocalA.X) + transformA.Q.C * (localA.Y - centerLocalA.Y)
Var rBX As Double = transformB.Q.C * (localB.X - centerLocalB.X) - transformB.Q.S * (localB.Y - centerLocalB.Y)
Var rBY As Double = transformB.Q.S * (localB.X - centerLocalB.X) + transformB.Q.C * (localB.Y - centerLocalB.Y)
Var centerA As Vector2 = Me.Owner.GetBodyWorldCenterOfMass(bodyA)
Var centerB As Vector2 = Me.Owner.GetBodyWorldCenterOfMass(bodyB)
Var dX As Double = centerB.X - centerA.X + rBX - rAX
Var dY As Double = centerB.Y - centerA.Y + rBY - rAY
Var vA As Vector2 = Me.Owner.GetBodyLinearVelocity(bodyA)
Var vB As Vector2 = Me.Owner.GetBodyLinearVelocity(bodyB)
Var wA As Double = Me.Owner.GetBodyAngularVelocity(bodyA)
Var wB As Double = Me.Owner.GetBodyAngularVelocity(bodyB)
Var vRelX As Double = vB.X - wB * rBY - (vA.X - wA * rAY)
Var vRelY As Double = vB.Y + wB * rBX - (vA.Y + wA * rAX)
Return dX * (wA * axisY) - dY * (wA * axisX) + axisX * vRelX + axisY * vRelY
End Function

## Enables the translation limits, ported from
## b2PrismaticJoint_EnableLimit. Toggling clears both accumulated limit
## impulses.
Sub EnableLimit(enableLimit As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableLimit Then
flag = 1
End If
If flag <> store.EnableLimit.Items[Me.LocalIndex] Then
store.EnableLimit.Items[Me.LocalIndex] = flag
store.PrismaticLowerImpulse.Items[Me.LocalIndex] = 0.0
store.PrismaticUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the translation limits are active, ported from
## b2PrismaticJoint_IsLimitEnabled.
Function IsLimitEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableLimit.Items[Me.LocalIndex] <> 0
End Function

## Lower translation limit in metres, ported from
## b2PrismaticJoint_GetLowerLimit.
Function GetLowerLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticLowerTranslation.Items[Me.LocalIndex]
End Function

## Upper translation limit in metres, ported from
## b2PrismaticJoint_GetUpperLimit.
Function GetUpperLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticUpperTranslation.Items[Me.LocalIndex]
End Function

## Sets both translation limits in metres, ported from
## b2PrismaticJoint_SetLimits. The lower limit must not exceed the upper
## limit, matching the upstream assertion; changing the values clears both
## accumulated limit impulses.
Sub SetLimits(lower As Double, upper As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not lower.IsFinite() Or Not upper.IsFinite() Then
Throw New InvalidArgumentException("Prismatic joint limits must be finite")
End If
If lower > upper Then
Throw New InvalidArgumentException("Prismatic joint lower limit must not exceed the upper limit")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
If lower <> store.PrismaticLowerTranslation.Items[Me.LocalIndex] Or upper <> store.PrismaticUpperTranslation.Items[Me.LocalIndex] Then
store.PrismaticLowerTranslation.Items[Me.LocalIndex] = lower
store.PrismaticUpperTranslation.Items[Me.LocalIndex] = upper
store.PrismaticLowerImpulse.Items[Me.LocalIndex] = 0.0
store.PrismaticUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## Enables the translation motor, ported from
## b2PrismaticJoint_EnableMotor. Toggling clears the accumulated motor
## impulse.
Sub EnableMotor(enableMotor As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableMotor Then
flag = 1
End If
If flag <> store.EnableMotor.Items[Me.LocalIndex] Then
store.EnableMotor.Items[Me.LocalIndex] = flag
store.PrismaticMotorImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the translation motor is active, ported from
## b2PrismaticJoint_IsMotorEnabled.
Function IsMotorEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableMotor.Items[Me.LocalIndex] <> 0
End Function

## Desired motor speed in metres per second, ported from
## b2PrismaticJoint_SetMotorSpeed. Changes apply from the next step.
Sub SetMotorSpeed(motorSpeed As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).PrismaticMotorSpeed.Items[Me.LocalIndex] = motorSpeed
End Sub

## Desired motor speed in metres per second, ported from
## b2PrismaticJoint_GetMotorSpeed.
Function GetMotorSpeed() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticMotorSpeed.Items[Me.LocalIndex]
End Function

## Maximum motor force in newtons, ported from
## b2PrismaticJoint_SetMaxMotorForce. Changes apply from the next step.
Sub SetMaxMotorForce(force As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).PrismaticMaxMotorForce.Items[Me.LocalIndex] = force
End Sub

## Maximum motor force in newtons, ported from
## b2PrismaticJoint_GetMaxMotorForce.
Function GetMaxMotorForce() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticMaxMotorForce.Items[Me.LocalIndex]
End Function

## Force the motor applied this step in newtons, ported from
## b2PrismaticJoint_GetMotorForce.
Function GetMotorForce() As Double
Me.CheckValid()
Return Me.Owner.InvH * Me.Owner.GetJointSims(Me).PrismaticMotorImpulse.Items[Me.LocalIndex]
End Function

## The constrained reference angle in radians, ported from
## b2Joint_GetReferenceAngle for the prismatic family.
Override Function GetReferenceAngle() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).PrismaticReferenceAngle.Items[Me.LocalIndex]
End Function

## The local axis in body A's frame, ported from b2Joint_GetLocalAxisA for
## the prismatic family. Returns a new Vector2 copy; safe to retain.
Override Function GetLocalAxisA() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.PrismaticLocalAxisX.Items[Me.LocalIndex], store.PrismaticLocalAxisY.Items[Me.LocalIndex])
End Function
End Class

# Prismatic joint definition, ported from upstream b2PrismaticJointDef and
# b2DefaultPrismaticJointDef in types.h and joint.c. Defaults match
# upstream: coincident local anchors, unit Y axis, zero reference angle,
# target, tuning, limits, and motor, with all three features disabled.
# A prismatic joint allows two bodies to translate along one axis and
# optionally drives or limits that translation.
Class PrismaticJointDefinition
## First attached body, ported from b2PrismaticJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, ported from b2PrismaticJointDef.bodyIdB.
Property BodyB As Body
## Local anchor point relative to body A's origin, in metres.
Property LocalAnchorA As Vector2
## Local anchor point relative to body B's origin, in metres.
Property LocalAnchorB As Vector2
## Local translation unit axis in body A's frame. Defaults to the world X
## axis like upstream; normalized at creation.
Property LocalAxisA As Vector2
## The constrained angle between the bodies in the reference state:
## body B angle minus body A angle, in radians.
Property ReferenceAngle As Double
## Target translation for the spring in metres. The spring-damper drives
## toward this translation.
Property TargetTranslation As Double
## True when the linear spring along the axis is active.
Property EnableSpring As Boolean
## Spring stiffness in hertz.
Property Hertz As Double
## Spring damping ratio, non-dimensional.
Property DampingRatio As Double
## True when the translation limits are active.
Property EnableLimit As Boolean
## Lower translation limit in metres.
Property LowerTranslation As Double
## Upper translation limit in metres.
Property UpperTranslation As Double
## True when the translation motor is active.
Property EnableMotor As Boolean
## Maximum motor force, typically in newtons.
Property MaxMotorForce As Double
## Desired motor speed in metres per second.
Property MotorSpeed As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LocalAnchorA = New Vector2(0.0, 0.0)
Me.LocalAnchorB = New Vector2(0.0, 0.0)
Me.LocalAxisA = New Vector2(1.0, 0.0)
Me.ReferenceAngle = 0.0
Me.TargetTranslation = 0.0
Me.EnableSpring = False
Me.Hertz = 0.0
Me.DampingRatio = 0.0
Me.EnableLimit = False
Me.LowerTranslation = 0.0
Me.UpperTranslation = 0.0
Me.EnableMotor = False
Me.MaxMotorForce = 0.0
Me.MotorSpeed = 0.0
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Query filtering for world queries, ported from upstream b2QueryFilter in
# types.h. A shape is visited when its category intersects the query mask and
# its mask intersects the query category.
Class QueryFilter
## The collision category bits this query accepts.
Property CategoryBits As Integer
## The collision category bits this query looks for.
Property MaskBits As Integer

## Creates the default query filter, matching upstream b2DefaultQueryFilter.
Constructor()
Me.CategoryBits = PhysicsConstants.DEFAULT_CATEGORY_BITS
Me.MaskBits = PhysicsConstants.DEFAULT_MASK_BITS
End Constructor

## Copies another query filter.
Constructor(other As QueryFilter)
Me.CategoryBits = other.CategoryBits
Me.MaskBits = other.MaskBits
End Constructor

## Returns True when a shape with the given shape filter passes this query
## filter, ported from upstream b2ShouldQueryCollide.
Shared Function ShouldCollide(shapeFilter As Filter, queryFilter As QueryFilter) As Boolean
If shapeFilter.CategoryBits.BitAnd(queryFilter.MaskBits) = 0 Then
Return False
End If
Return shapeFilter.MaskBits.BitAnd(queryFilter.CategoryBits) <> 0
End Function
End Class

# Low level ray cast input, ported from upstream b2RayCastInput in
# collision.h. The ray extends from origin along translation, clipped to
# maxFraction of the translation.
#
# Both vectors are owned copies, so building an input from existing vectors
# never aliases them.
Class RayCastInput
## Start point of the ray cast.
Property Origin As Vector2
## Translation of the ray cast.
Property Translation As Vector2
## The maximum fraction of the translation to consider, typically 1.
Property MaxFraction As Double

## Creates a zero-length ray covering the full translation fraction.
Constructor()
Me.Origin = New Vector2(0.0, 0.0)
Me.Translation = New Vector2(0.0, 0.0)
Me.MaxFraction = 1.0
End Constructor

## Creates a ray from an origin, translation, and maximum fraction. The
## vectors are copied.
Constructor(origin As Vector2, translation As Vector2, maxFraction As Double)
Me.Origin = New Vector2(origin.X, origin.Y)
Me.Translation = New Vector2(translation.X, translation.Y)
Me.MaxFraction = maxFraction
End Constructor

## Returns True when the input components are finite and the fraction is in
## [0, POSITION_LIMIT), ported from upstream b2IsValidRay.
Shared Function IsValid(input As RayCastInput) As Boolean
If Not input.Origin.X.IsFinite() Or Not input.Origin.Y.IsFinite() Then
Return False
End If
If Not input.Translation.X.IsFinite() Or Not input.Translation.Y.IsFinite() Then
Return False
End If
If Not input.MaxFraction.IsFinite() Then
Return False
End If
Return 0.0 <= input.MaxFraction And input.MaxFraction < PhysicsConstants.POSITION_LIMIT
End Function
End Class

# Public revolute joint façade, ported from the b2RevoluteJoint_* surface in
# revolute_joint.c. The joint pins two bodies at a hinge point; a spring,
# limits, and a motor optionally act on the relative angle. Tuning changes
# deliberately do not wake the bodies, matching upstream; the solver picks
# up new values on the next step. Enabling or disabling the spring, limits,
# or motor clears the corresponding accumulated impulses exactly like the
# upstream toggles. Setters store plain values where upstream stores plain
# values and throw where upstream asserts. The façade reads and writes its
# row in the owning JointSims store.
Class RevoluteJoint Inherits Joint
## Enables the rotational spring, ported from b2RevoluteJoint_EnableSpring.
## Toggling clears the accumulated spring impulse.
Sub EnableSpring(enableSpring As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableSpring Then
flag = 1
End If
If flag <> store.EnableSpring.Items[Me.LocalIndex] Then
store.EnableSpring.Items[Me.LocalIndex] = flag
store.RevoluteSpringImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the rotational spring is active, ported from
## b2RevoluteJoint_IsSpringEnabled.
Function IsSpringEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableSpring.Items[Me.LocalIndex] <> 0
End Function

## Rotational spring stiffness in hertz, ported from
## b2RevoluteJoint_SetSpringHertz. Changes apply from the next step.
Sub SetSpringHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).RevoluteHertz.Items[Me.LocalIndex] = hertz
End Sub

## Rotational spring stiffness in hertz, ported from
## b2RevoluteJoint_GetSpringHertz.
Function GetSpringHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteHertz.Items[Me.LocalIndex]
End Function

## Rotational spring damping ratio, ported from
## b2RevoluteJoint_SetSpringDampingRatio. Changes apply from the next step.
Sub SetSpringDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).RevoluteDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Rotational spring damping ratio, ported from
## b2RevoluteJoint_GetSpringDampingRatio.
Function GetSpringDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteDampingRatio.Items[Me.LocalIndex]
End Function

## Target angle of the rotational spring in radians, ported from
## b2RevoluteJoint_SetTargetAngle. Changes apply from the next step and do
## not wake the bodies.
Sub SetTargetAngle(angle As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).RevoluteTargetAngle.Items[Me.LocalIndex] = angle
End Sub

## Target angle of the rotational spring in radians, ported from
## b2RevoluteJoint_GetTargetAngle.
Function GetTargetAngle() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteTargetAngle.Items[Me.LocalIndex]
End Function

## Current joint angle in radians, ported from b2RevoluteJoint_GetAngle:
## the live relative body angle minus the reference angle, wrapped into
## [-pi, pi].
Function GetAngle() As Double
Me.CheckValid()
Var transformA As Transform = Me.Owner.GetBodyTransform(Me.GetBodyA())
Var transformB As Transform = Me.Owner.GetBodyTransform(Me.GetBodyB())
Var angle As Double = Rot.RelativeAngle(transformB.Q, transformA.Q) - Me.Owner.GetJointSims(Me).RevoluteReferenceAngle.Items[Me.LocalIndex]
Return PhysicsMaths.UnwindAngle(angle)
End Function

## Enables the angle limits, ported from b2RevoluteJoint_EnableLimit.
## Toggling clears both accumulated limit impulses.
Sub EnableLimit(enableLimit As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableLimit Then
flag = 1
End If
If flag <> store.EnableLimit.Items[Me.LocalIndex] Then
store.EnableLimit.Items[Me.LocalIndex] = flag
store.RevoluteLowerImpulse.Items[Me.LocalIndex] = 0.0
store.RevoluteUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the angle limits are active, ported from
## b2RevoluteJoint_IsLimitEnabled.
Function IsLimitEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableLimit.Items[Me.LocalIndex] <> 0
End Function

## Lower angle limit in radians, ported from
## b2RevoluteJoint_GetLowerLimit.
Function GetLowerLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteLowerAngle.Items[Me.LocalIndex]
End Function

## Upper angle limit in radians, ported from
## b2RevoluteJoint_GetUpperLimit.
Function GetUpperLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteUpperAngle.Items[Me.LocalIndex]
End Function

## Sets both angle limits in radians, ported from
## b2RevoluteJoint_SetLimits. The lower limit must not exceed the upper
## limit and both must lie within [-0.99 pi, 0.99 pi], matching the
## upstream assertions; changing the values clears both accumulated limit
## impulses.
Sub SetLimits(lower As Double, upper As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not lower.IsFinite() Or Not upper.IsFinite() Then
Throw New InvalidArgumentException("Revolute joint limits must be finite")
End If
If lower > upper Then
Throw New InvalidArgumentException("Revolute joint lower limit must not exceed the upper limit")
End If
If lower < -0.99 * PhysicsConstants.PI Or upper > 0.99 * PhysicsConstants.PI Then
Throw New InvalidArgumentException("Revolute joint limits must lie within [-0.99 pi, 0.99 pi]")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
If lower <> store.RevoluteLowerAngle.Items[Me.LocalIndex] Or upper <> store.RevoluteUpperAngle.Items[Me.LocalIndex] Then
store.RevoluteLowerAngle.Items[Me.LocalIndex] = lower
store.RevoluteUpperAngle.Items[Me.LocalIndex] = upper
store.RevoluteLowerImpulse.Items[Me.LocalIndex] = 0.0
store.RevoluteUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## Enables the rotational motor, ported from b2RevoluteJoint_EnableMotor.
## Toggling clears the accumulated motor impulse.
Sub EnableMotor(enableMotor As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableMotor Then
flag = 1
End If
If flag <> store.EnableMotor.Items[Me.LocalIndex] Then
store.EnableMotor.Items[Me.LocalIndex] = flag
store.RevoluteMotorImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the rotational motor is active, ported from
## b2RevoluteJoint_IsMotorEnabled.
Function IsMotorEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableMotor.Items[Me.LocalIndex] <> 0
End Function

## Desired motor speed in radians per second, ported from
## b2RevoluteJoint_SetMotorSpeed. Changes apply from the next step.
Sub SetMotorSpeed(motorSpeed As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).RevoluteMotorSpeed.Items[Me.LocalIndex] = motorSpeed
End Sub

## Desired motor speed in radians per second, ported from
## b2RevoluteJoint_GetMotorSpeed.
Function GetMotorSpeed() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteMotorSpeed.Items[Me.LocalIndex]
End Function

## Maximum motor torque in newton-metres, ported from
## b2RevoluteJoint_SetMaxMotorTorque. Changes apply from the next step.
Sub SetMaxMotorTorque(torque As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).RevoluteMaxMotorTorque.Items[Me.LocalIndex] = torque
End Sub

## Maximum motor torque in newton-metres, ported from
## b2RevoluteJoint_GetMaxMotorTorque.
Function GetMaxMotorTorque() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).RevoluteMaxMotorTorque.Items[Me.LocalIndex]
End Function

## Torque the motor applied this step in newton-metres, ported from
## b2RevoluteJoint_GetMotorTorque.
Function GetMotorTorque() As Double
Me.CheckValid()
Return Me.Owner.InvH * Me.Owner.GetJointSims(Me).RevoluteMotorImpulse.Items[Me.LocalIndex]
End Function
End Class

# Revolute joint definition, ported from upstream b2RevoluteJointDef and
# b2DefaultRevoluteJointDef in types.h and joint.c. Defaults match upstream:
# coincident local anchors, zero reference and target angles, no spring,
# no limits, no motor. A revolute joint pins two bodies together at a
# hinge point and optionally drives or limits the relative angle.
Class RevoluteJointDefinition
## First attached body, ported from b2RevoluteJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, ported from b2RevoluteJointDef.bodyIdB.
Property BodyB As Body
## Local anchor point relative to body A's origin, in metres.
Property LocalAnchorA As Vector2
## Local anchor point relative to body B's origin, in metres.
Property LocalAnchorB As Vector2
## Body B angle minus body A angle in the reference state, in radians.
## Defines the zero angle for the joint angle, limits, and target.
Property ReferenceAngle As Double
## Target angle for the rotational spring in radians. The spring-damper
## drives toward this angle.
Property TargetAngle As Double
## True when the rotational spring is active.
Property EnableSpring As Boolean
## Rotational spring stiffness in hertz.
Property Hertz As Double
## Rotational spring damping ratio, non-dimensional.
Property DampingRatio As Double
## True when the angle limits are active.
Property EnableLimit As Boolean
## Lower angle limit in radians. Upstream requires at least -0.99 pi.
Property LowerAngle As Double
## Upper angle limit in radians. Upstream requires at most 0.99 pi.
Property UpperAngle As Double
## True when the rotational motor is active.
Property EnableMotor As Boolean
## Maximum motor torque, typically in newton-metres.
Property MaxMotorTorque As Double
## Desired motor speed in radians per second.
Property MotorSpeed As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LocalAnchorA = New Vector2(0.0, 0.0)
Me.LocalAnchorB = New Vector2(0.0, 0.0)
Me.ReferenceAngle = 0.0
Me.TargetAngle = 0.0
Me.EnableSpring = False
Me.Hertz = 0.0
Me.DampingRatio = 0.0
Me.EnableLimit = False
Me.LowerAngle = 0.0
Me.UpperAngle = 0.0
Me.EnableMotor = False
Me.MaxMotorTorque = 0.0
Me.MotorSpeed = 0.0
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Cosine/sine rotation, ported from upstream b2Rot in math_functions.h and
# math_functions.c. A rotation stores the cosine and sine of its angle so
# rotating vectors costs no trigonometric calls.
#
# Vector2 is a reference type in Objo, so the To-forms of vector helpers fill
# a caller-owned vector and return it, while the plain forms allocate a new
# vector. Hot engine code reads the C and S components directly and writes
# vector results with Set, mirroring the upstream scalar arithmetic.
#
# Rot.Make uses the deterministic ComputeCosSin approximation, matching
# upstream b2MakeRot, so angles behave identically on every machine.
Class Rot
## The cosine of the rotation angle.
Property C As Double
## The sine of the rotation angle.
Property S As Double

## Creates the identity rotation.
Constructor()
Me.C = 1.0
Me.S = 0.0
End Constructor

## Creates a rotation from explicit cosine and sine values.
Constructor(c As Double, s As Double)
Me.C = c
Me.S = s
End Constructor

## Copies another rotation's components.
Constructor(q As Rot)
Me.C = q.C
Me.S = q.S
End Constructor

## Sets both components in place and returns this rotation.
Function SetComponents(c As Double, s As Double) As Rot
Me.C = c
Me.S = s
Return Me
End Function

## Sets both components from another rotation in place and returns this
## rotation.
Function SetFrom(q As Rot) As Rot
Me.C = q.C
Me.S = q.S
Return Me
End Function

## Returns a new identity rotation.
Shared Function Identity() As Rot
Return New Rot(1.0, 0.0)
End Function

## Builds a rotation from an angle in radians using the deterministic
## cosine/sine approximation, matching upstream b2MakeRot.
Shared Function Make(radians As Double) As Rot
Var pair As CosSin = PhysicsMaths.ComputeCosSin(radians)
Return New Rot(pair.Cos, pair.Sin)
End Function

## Multiplies two rotations q * r, ported from upstream b2MulRot.
Shared Function Mul(q As Rot, r As Rot) As Rot
Return New Rot(q.C * r.C - q.S * r.S, q.S * r.C + q.C * r.S)
End Function

## Transpose-multiplies two rotations qT * r, ported from upstream
## b2InvMulRot. The result is the relative rotation from q to r.
Shared Function InvMul(q As Rot, r As Rot) As Rot
Return New Rot(q.C * r.C + q.S * r.S, q.C * r.S - q.S * r.C)
End Function

## Normalises the rotation to the unit circle, ported from upstream
## b2NormalizeRot. A zero rotation normalises to zero components; treat the
## result as invalid in that case.
Shared Function Normalize(q As Rot) As Rot
Var mag As Double = Maths.Sqrt(q.S * q.S + q.C * q.C)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
Return New Rot(q.C * invMag, q.S * invMag)
End Function

## Normalises the caller-owned out rotation to the unit circle and returns
## out. The reused-output form for warm loops.
Shared Function NormalizeTo(q As Rot, out As Rot) As Rot
Var mag As Double = Maths.Sqrt(q.S * q.S + q.C * q.C)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
Return out.SetComponents(q.C * invMag, q.S * invMag)
End Function

## Integrates a rotation over a small angle step, ported from upstream
## b2IntegrateRotation. Used by the solver to advance rotations; hot solver
## code works on scalar components instead.
Shared Function Integrate(q1 As Rot, deltaAngle As Double) As Rot
Var c As Double = q1.C - deltaAngle * q1.S
Var s As Double = q1.S + deltaAngle * q1.C
Var mag As Double = Maths.Sqrt(s * s + c * c)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
Return New Rot(c * invMag, s * invMag)
End Function

## Normalised linear interpolation between two rotations, ported from
## upstream b2NLerp.
Shared Function NLerp(q1 As Rot, q2 As Rot, t As Double) As Rot
Var omt As Double = 1.0 - t
Var c As Double = omt * q1.C + t * q2.C
Var s As Double = omt * q1.S + t * q2.S
Var mag As Double = Maths.Sqrt(s * s + c * c)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
Return New Rot(c * invMag, s * invMag)
End Function

## Returns the rotation angle in radians in [-pi, pi], ported from upstream
## b2Rot_GetAngle using the deterministic Atan2.
Shared Function GetAngle(q As Rot) As Double
Return PhysicsMaths.Atan2(q.S, q.C)
End Function

## Returns the rotation's x-axis as a new unit vector, ported from upstream
## b2Rot_GetXAxis.
Shared Function ToXAxis(q As Rot) As Vector2
Return New Vector2(q.C, q.S)
End Function

## Returns the rotation's y-axis as a new unit vector, ported from upstream
## b2Rot_GetYAxis.
Shared Function ToYAxis(q As Rot) As Vector2
Return New Vector2(-q.S, q.C)
End Function

## Returns the relative angle between b and a (rot_b * inv(rot_a)), ported
## from upstream b2RelativeAngle.
Shared Function RelativeAngle(b As Rot, a As Rot) As Double
Var s As Double = b.S * a.C - b.C * a.S
Var c As Double = b.C * a.C + b.S * a.S
Return PhysicsMaths.Atan2(s, c)
End Function

## Computes the angular velocity needed to rotate from q1 to q2 over the
## inverse time step invH, ported from upstream b2ComputeAngularVelocity.
Shared Function ComputeAngularVelocity(q1 As Rot, q2 As Rot, invH As Double) As Double
Return invH * (q2.S * q1.C - q2.C * q1.S)
End Function

## Returns True when the rotation magnitude stays within the upstream
## normalisation tolerance, ported from b2IsNormalizedRot.
Shared Function IsNormalized(q As Rot) As Boolean
Var qq As Double = q.S * q.S + q.C * q.C
Return 1.0 - 0.0006 < qq And qq < 1.0 + 0.0006
End Function

## Returns True when the rotation components are finite and normalised,
## ported from upstream b2IsValidRotation.
Shared Function IsValid(q As Rot) As Boolean
If Not q.C.IsFinite() Or Not q.S.IsFinite() Then
Return False
End If
Return Rot.IsNormalized(q)
End Function

## Computes the rotation between two unit vectors, ported from upstream
## b2ComputeRotationBetweenUnitVectors. Both inputs must be unit length;
## the result is normalised.
Shared Function ComputeRotationBetweenUnitVectors(v1 As Vector2, v2 As Vector2) As Rot
Return Rot.Normalize(New Rot(Vector2.Dot(v1, v2), Vector2.Cross(v1, v2)))
End Function

## Rotates a vector into a new vector, ported from upstream b2RotateVector.
Shared Function RotateVector(q As Rot, v As Vector2) As Vector2
Return New Vector2(q.C * v.X - q.S * v.Y, q.S * v.X + q.C * v.Y)
End Function

## Rotates a vector into the caller-owned out vector and returns out. The
## reused-output form for warm loops; results match RotateVector exactly.
Shared Function RotateVectorTo(q As Rot, v As Vector2, out As Vector2) As Vector2
Return out.Set(q.C * v.X - q.S * v.Y, q.S * v.X + q.C * v.Y)
End Function

## Inverse-rotates a vector into a new vector, ported from upstream
## b2InvRotateVector.
Shared Function InvRotateVector(q As Rot, v As Vector2) As Vector2
Return New Vector2(q.C * v.X + q.S * v.Y, -q.S * v.X + q.C * v.Y)
End Function

## Inverse-rotates a vector into the caller-owned out vector and returns
## out. The reused-output form for warm loops.
Shared Function InvRotateVectorTo(q As Rot, v As Vector2, out As Vector2) As Vector2
Return out.Set(q.C * v.X + q.S * v.Y, -q.S * v.X + q.C * v.Y)
End Function
End Class

# A line segment with two-sided collision, ported from upstream b2Segment in
# collision.h. Chain shapes build one-sided segments instead; see
# ChainSegment.
#
# Constructors validate their input and copy vector arguments. Segments have
# no mass and no interior, so there is no mass computation or point test.
Class Segment
## The first point.
Property Point1 As Vector2
## The second point.
Property Point2 As Vector2

## Creates a segment between two points. The points are copied. Throws
## InvalidArgumentException when either point is not finite.
Constructor(point1 As Vector2, point2 As Vector2)
If Not point1.X.IsFinite() Or Not point1.Y.IsFinite() Then
Throw New InvalidArgumentException("Segment first point must be finite")
End If
If Not point2.X.IsFinite() Or Not point2.Y.IsFinite() Then
Throw New InvalidArgumentException("Segment second point must be finite")
End If
Me.Point1 = New Vector2(point1.X, point1.Y)
Me.Point2 = New Vector2(point2.X, point2.Y)
End Constructor

## Creates a segment from four scalar coordinates. The components must be
## finite.
Constructor(x1 As Double, y1 As Double, x2 As Double, y2 As Double)
If Not x1.IsFinite() Or Not y1.IsFinite() Or Not x2.IsFinite() Or Not y2.IsFinite() Then
Throw New InvalidArgumentException("Segment points must be finite")
End If
Me.Point1 = New Vector2(x1, y1)
Me.Point2 = New Vector2(x2, y2)
End Constructor

## Copies another segment.
Constructor(other As Segment)
Me.Point1 = New Vector2(other.Point1.X, other.Point1.Y)
Me.Point2 = New Vector2(other.Point2.X, other.Point2.Y)
End Constructor
## Computes the world-space AABB of the transformed segment, ported from
## upstream b2ComputeSegmentAABB.
Function ComputeAABB(transform As Transform) As AABB
Return Me.ComputeAABBTo(transform, New AABB)
End Function

## Caller-owned output form of ComputeAABB for warm paths.
Function ComputeAABBTo(transform As Transform, out As AABB) As AABB
Var v1x As Double = transform.Q.C * Me.Point1.X - transform.Q.S * Me.Point1.Y + transform.P.X
Var v1y As Double = transform.Q.S * Me.Point1.X + transform.Q.C * Me.Point1.Y + transform.P.Y
Var v2x As Double = transform.Q.C * Me.Point2.X - transform.Q.S * Me.Point2.Y + transform.P.X
Var v2y As Double = transform.Q.S * Me.Point2.X + transform.Q.C * Me.Point2.Y + transform.P.Y
out.LowerBound.Set(Maths.Min(v1x, v2x), Maths.Min(v1y, v2y))
out.UpperBound.Set(Maths.Max(v1x, v2x), Maths.Max(v1y, v2y))
Return out
End Function
End Class

# Result of computing the distance between two line segments, ported from
# upstream b2SegmentDistanceResult in collision.h.
#
# The closest-point vectors are owned and reused by the To-form of the
# distance computation.
Class SegmentDistanceResult
## The closest point on the first segment.
Property Closest1 As Vector2
## The closest point on the second segment.
Property Closest2 As Vector2
## The barycentric coordinate on the first segment.
Property Fraction1 As Double
## The barycentric coordinate on the second segment.
Property Fraction2 As Double
## The squared distance between the closest points.
Property DistanceSquared As Double

## Creates a zero result.
Constructor()
Me.Closest1 = New Vector2(0.0, 0.0)
Me.Closest2 = New Vector2(0.0, 0.0)
Me.Fraction1 = 0.0
Me.Fraction2 = 0.0
Me.DistanceSquared = 0.0
End Constructor
End Class

# One sensor's double-buffered overlap list, ported from b2Sensor in
# sensor.h. The world keeps one record per sensor shape; overlaps reference
# visitor shapes by slot and generation so a destroyed visitor ends the
# overlap instead of leaking it.
Class Sensor
## The sensor shape's slot.
Property ShapeId As Integer
## Previous-step overlap shape slots.
Property Overlap1Ids As IntegerList
## Previous-step overlap generations.
Property Overlap1Gens As IntegerList
## Current-step overlap shape slots.
Property Overlap2Ids As IntegerList
## Current-step overlap generations.
Property Overlap2Gens As IntegerList

## Creates an empty sensor record for one shape.
Constructor(shapeId As Integer)
Me.ShapeId = shapeId
Me.Overlap1Ids = New IntegerList
Me.Overlap1Gens = New IntegerList
Me.Overlap2Ids = New IntegerList
Me.Overlap2Gens = New IntegerList
End Constructor
End Class

# Tree query callback for sensor overlaps, ported from b2SensorQueryCallback
# in sensor.c. The world owns one instance reused per sensor pass; each visit
# runs the overlap test and appends the visitor to the sensor's current
# overlap buffer on a hit.
Class SensorQueryCallback Inherits TreeQueryCallback
## Owning world.
Property World As World
## Sensor record under test.
Property Sensor As Sensor
## Sensor shape under test.
Property SensorShape As Shape
## Sensor body transform.
Property Transform As Transform

## Tests one candidate shape for overlap with the sensor shape.
Override Function VisitLeaf(proxyId As Integer, userData As Integer) As Boolean
Pragma Unused proxyId
Return Me.World.SensorOverlapTest(userData, Me.Sensor, Me.SensorShape, Me.Transform)
End Function
End Class

# Engine-internal separating axis function for the time-of-impact root
# finder, ported from upstream b2SeparationFunction in distance.c. The
# proxies are aliased read-only and the sweeps are copied on make.
Class SeparationFunction
## Which feature defines the separating axis.
Private Property mType As Integer

## pointsType: the axis runs between two witness points.
Private Const POINTS_TYPE As Integer = 0
## faceAType: the axis is a face normal on shape A.
Private Const FACE_A_TYPE As Integer = 1
## faceBType: the axis is a face normal on shape B.
Private Const FACE_B_TYPE As Integer = 2

## The proxy for shape A.
Property ProxyA As ShapeProxy
## The proxy for shape B.
Property ProxyB As ShapeProxy
## The movement of shape A.
Property SweepA As Sweep
## The movement of shape B.
Property SweepB As Sweep
## Reused transform holder for shape A queries.
Property TransformA As Transform
## Reused transform holder for shape B queries.
Property TransformB As Transform
## Local anchor of the separating feature.
Property LocalPoint As Vector2
## The separating axis in world space at t1.
Property Axis As Vector2
## Reused result holder for FindMinSeparation.
Private Property mResult As SeparationResult

## Creates an uninitialised function.
Constructor()
Me.ProxyA = Nothing
Me.ProxyB = Nothing
Me.SweepA = Nothing
Me.SweepB = Nothing
Me.LocalPoint = New Vector2(0.0, 0.0)
Me.Axis = New Vector2(0.0, 0.0)
Me.mType = 0
Me.mResult = Nothing
End Constructor

## Builds the separation function from the cached simplex, ported from
## upstream b2MakeSeparationFunction.
## Refills the separation function from the cached simplex in place,
## ported from upstream b2MakeSeparationFunction. The warm path reuses one
## function and its sweeps.
Function Setup(cache As SimplexCache, proxyA As ShapeProxy, sweepA As Sweep, proxyB As ShapeProxy, sweepB As Sweep, t1 As Double) As SeparationFunction
Me.ProxyA = proxyA
Me.ProxyB = proxyB
Var count As Integer = cache.Count
If count <= 0 Or count >= 3 Then
Throw New RuntimeException("Separation function needs one or two cached points")
End If

If Me.SweepA = Nothing Then
Me.SweepA = New Sweep
Me.SweepB = New Sweep
Me.TransformA = New Transform
Me.TransformB = New Transform
End If
Me.SweepA.LocalCenter.Set(sweepA.LocalCenter.X, sweepA.LocalCenter.Y)
Me.SweepA.C1.Set(sweepA.C1.X, sweepA.C1.Y)
Me.SweepA.C2.Set(sweepA.C2.X, sweepA.C2.Y)
Me.SweepA.Q1.SetComponents(sweepA.Q1.C, sweepA.Q1.S)
Me.SweepA.Q2.SetComponents(sweepA.Q2.C, sweepA.Q2.S)
Me.SweepB.LocalCenter.Set(sweepB.LocalCenter.X, sweepB.LocalCenter.Y)
Me.SweepB.C1.Set(sweepB.C1.X, sweepB.C1.Y)
Me.SweepB.C2.Set(sweepB.C2.X, sweepB.C2.Y)
Me.SweepB.Q1.SetComponents(sweepB.Q1.C, sweepB.Q1.S)
Me.SweepB.Q2.SetComponents(sweepB.Q2.C, sweepB.Q2.S)

Sweep.GetTransformTo(sweepA, t1, Me.TransformA)
Sweep.GetTransformTo(sweepB, t1, Me.TransformB)
Var xfA As Transform = Me.TransformA
Var xfB As Transform = Me.TransformB

If count = 1 Then
Me.mType = SeparationFunction.POINTS_TYPE
Var localPointA As Vector2 = proxyA.Points[cache.IndexA[0]]
Var localPointB As Vector2 = proxyB.Points[cache.IndexB[0]]
Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y
Var dirX As Double = pointBX - pointAX
Var dirY As Double = pointBY - pointAY
Var length As Double = Maths.Sqrt(dirX * dirX + dirY * dirY)
If length > PhysicsConstants.FLT_EPSILON Then
Me.Axis.Set(dirX / length, dirY / length)
Else
Me.Axis.Set(0.0, 0.0)
End If
Me.LocalPoint.Set(0.0, 0.0)
Return Me
End If

If cache.IndexA[0] = cache.IndexA[1] Then
# Two points on B and one on A.
Me.mType = SeparationFunction.FACE_B_TYPE
Var localPointB1 As Vector2 = proxyB.Points[cache.IndexB[0]]
Var localPointB2 As Vector2 = proxyB.Points[cache.IndexB[1]]

Var edgeX As Double = localPointB2.X - localPointB1.X
Var edgeY As Double = localPointB2.Y - localPointB1.Y
# crossVS(edge, 1) = (edge.y, -edge.x).
Var axisX As Double = edgeY
Var axisY As Double = -edgeX
Var axisLength As Double = Maths.Sqrt(axisX * axisX + axisY * axisY)
If axisLength > PhysicsConstants.FLT_EPSILON Then
axisX = axisX / axisLength
axisY = axisY / axisLength
Else
axisX = 0.0
axisY = 0.0
End If
Me.Axis.Set(axisX, axisY)
Var normalX As Double = xfB.Q.C * axisX - xfB.Q.S * axisY
Var normalY As Double = xfB.Q.S * axisX + xfB.Q.C * axisY

Me.LocalPoint.Set(0.5 * (localPointB1.X + localPointB2.X), 0.5 * (localPointB1.Y + localPointB2.Y))
Var pointBX As Double = xfB.Q.C * Me.LocalPoint.X - xfB.Q.S * Me.LocalPoint.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * Me.LocalPoint.X + xfB.Q.C * Me.LocalPoint.Y + xfB.P.Y

Var localPointA As Vector2 = proxyA.Points[cache.IndexA[0]]
Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y

Var s As Double = (pointAX - pointBX) * normalX + (pointAY - pointBY) * normalY
If s < 0.0 Then
Me.Axis.Set(-axisX, -axisY)
End If
Return Me
End If

# Two points on A and one or two points on B.
Me.mType = SeparationFunction.FACE_A_TYPE
Var localPointA1 As Vector2 = proxyA.Points[cache.IndexA[0]]
Var localPointA2 As Vector2 = proxyA.Points[cache.IndexA[1]]

Var edgeX As Double = localPointA2.X - localPointA1.X
Var edgeY As Double = localPointA2.Y - localPointA1.Y
# crossVS(edge, 1) = (edge.y, -edge.x).
Var axisX As Double = edgeY
Var axisY As Double = -edgeX
Var axisLength As Double = Maths.Sqrt(axisX * axisX + axisY * axisY)
If axisLength > PhysicsConstants.FLT_EPSILON Then
axisX = axisX / axisLength
axisY = axisY / axisLength
Else
axisX = 0.0
axisY = 0.0
End If
Me.Axis.Set(axisX, axisY)
Var normalX As Double = xfA.Q.C * axisX - xfA.Q.S * axisY
Var normalY As Double = xfA.Q.S * axisX + xfA.Q.C * axisY

Me.LocalPoint.Set(0.5 * (localPointA1.X + localPointA2.X), 0.5 * (localPointA1.Y + localPointA2.Y))
Var pointAX As Double = xfA.Q.C * Me.LocalPoint.X - xfA.Q.S * Me.LocalPoint.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * Me.LocalPoint.X + xfA.Q.C * Me.LocalPoint.Y + xfA.P.Y

Var localPointB As Vector2 = proxyB.Points[cache.IndexB[0]]
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y

Var s As Double = (pointBX - pointAX) * normalX + (pointBY - pointAY) * normalY
If s < 0.0 Then
Me.Axis.Set(-axisX, -axisY)
End If
Return Me
End Function

## Builds the separation function from the cached simplex into a new
## instance, ported from upstream b2MakeSeparationFunction.
Shared Function Make(cache As SimplexCache, proxyA As ShapeProxy, sweepA As Sweep, proxyB As ShapeProxy, sweepB As Sweep, t1 As Double) As SeparationFunction
Return (New SeparationFunction).Setup(cache, proxyA, sweepA, proxyB, sweepB, t1)
End Function

## Finds the minimum separation at time t and stores the support indices in
## the reused result, ported from upstream b2FindMinSeparation.
Function FindMinSeparation(t As Double) As SeparationResult
If Me.mResult = Nothing Then
Me.mResult = New SeparationResult
End If
If Me.TransformA = Nothing Then
Me.TransformA = New Transform
Me.TransformB = New Transform
End If
Sweep.GetTransformTo(Me.SweepA, t, Me.TransformA)
Sweep.GetTransformTo(Me.SweepB, t, Me.TransformB)
Var xfA As Transform = Me.TransformA
Var xfB As Transform = Me.TransformB

If Me.mType = SeparationFunction.POINTS_TYPE Then
Var axisAX As Double = xfA.Q.C * Me.Axis.X + xfA.Q.S * Me.Axis.Y
Var axisAY As Double = -xfA.Q.S * Me.Axis.X + xfA.Q.C * Me.Axis.Y
Var invAxisBX As Double = -Me.Axis.X
Var invAxisBY As Double = -Me.Axis.Y
Var axisBX As Double = xfB.Q.C * invAxisBX + xfB.Q.S * invAxisBY
Var axisBY As Double = -xfB.Q.S * invAxisBX + xfB.Q.C * invAxisBY

Me.mResult.IndexA = Distance.FindSupport(Me.ProxyA, axisAX, axisAY)
Me.mResult.IndexB = Distance.FindSupport(Me.ProxyB, axisBX, axisBY)

Var localPointA As Vector2 = Me.ProxyA.Points[Me.mResult.IndexA]
Var localPointB As Vector2 = Me.ProxyB.Points[Me.mResult.IndexB]

Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y

Me.mResult.Separation = (pointBX - pointAX) * Me.Axis.X + (pointBY - pointAY) * Me.Axis.Y
Return Me.mResult
End If

If Me.mType = SeparationFunction.FACE_A_TYPE Then
Var normalX As Double = xfA.Q.C * Me.Axis.X - xfA.Q.S * Me.Axis.Y
Var normalY As Double = xfA.Q.S * Me.Axis.X + xfA.Q.C * Me.Axis.Y
Var pointAX As Double = xfA.Q.C * Me.LocalPoint.X - xfA.Q.S * Me.LocalPoint.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * Me.LocalPoint.X + xfA.Q.C * Me.LocalPoint.Y + xfA.P.Y

Var invNormalX As Double = -normalX
Var invNormalY As Double = -normalY
Var axisBX As Double = xfB.Q.C * invNormalX + xfB.Q.S * invNormalY
Var axisBY As Double = -xfB.Q.S * invNormalX + xfB.Q.C * invNormalY

Me.mResult.IndexA = -1
Me.mResult.IndexB = Distance.FindSupport(Me.ProxyB, axisBX, axisBY)

Var localPointB As Vector2 = Me.ProxyB.Points[Me.mResult.IndexB]
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y

Me.mResult.Separation = (pointBX - pointAX) * normalX + (pointBY - pointAY) * normalY
Return Me.mResult
End If

# FACE_B_TYPE.
Var normalX As Double = xfB.Q.C * Me.Axis.X - xfB.Q.S * Me.Axis.Y
Var normalY As Double = xfB.Q.S * Me.Axis.X + xfB.Q.C * Me.Axis.Y
Var pointBX As Double = xfB.Q.C * Me.LocalPoint.X - xfB.Q.S * Me.LocalPoint.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * Me.LocalPoint.X + xfB.Q.C * Me.LocalPoint.Y + xfB.P.Y

Var invNormalX As Double = -normalX
Var invNormalY As Double = -normalY
Var axisAX As Double = xfA.Q.C * invNormalX + xfA.Q.S * invNormalY
Var axisAY As Double = -xfA.Q.S * invNormalX + xfA.Q.C * invNormalY

Me.mResult.IndexB = -1
Me.mResult.IndexA = Distance.FindSupport(Me.ProxyA, axisAX, axisAY)

Var localPointA As Vector2 = Me.ProxyA.Points[Me.mResult.IndexA]
Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y

Me.mResult.Separation = (pointAX - pointBX) * normalX + (pointAY - pointBY) * normalY
Return Me.mResult
End Function

## Evaluates the separation of the witness points at time t, ported from
## upstream b2EvaluateSeparation.
Function EvaluateSeparation(indexA As Integer, indexB As Integer, t As Double) As Double
If Me.mResult = Nothing Then
Me.mResult = New SeparationResult
End If
If Me.TransformA = Nothing Then
Me.TransformA = New Transform
Me.TransformB = New Transform
End If
Sweep.GetTransformTo(Me.SweepA, t, Me.TransformA)
Sweep.GetTransformTo(Me.SweepB, t, Me.TransformB)
Var xfA As Transform = Me.TransformA
Var xfB As Transform = Me.TransformB

If Me.mType = SeparationFunction.POINTS_TYPE Then
Var localPointA As Vector2 = Me.ProxyA.Points[indexA]
Var localPointB As Vector2 = Me.ProxyB.Points[indexB]
Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y

Return (pointBX - pointAX) * Me.Axis.X + (pointBY - pointAY) * Me.Axis.Y
End If

If Me.mType = SeparationFunction.FACE_A_TYPE Then
Var normalX As Double = xfA.Q.C * Me.Axis.X - xfA.Q.S * Me.Axis.Y
Var normalY As Double = xfA.Q.S * Me.Axis.X + xfA.Q.C * Me.Axis.Y
Var pointAX As Double = xfA.Q.C * Me.LocalPoint.X - xfA.Q.S * Me.LocalPoint.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * Me.LocalPoint.X + xfA.Q.C * Me.LocalPoint.Y + xfA.P.Y

Var localPointB As Vector2 = Me.ProxyB.Points[indexB]
Var pointBX As Double = xfB.Q.C * localPointB.X - xfB.Q.S * localPointB.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * localPointB.X + xfB.Q.C * localPointB.Y + xfB.P.Y

Return (pointBX - pointAX) * normalX + (pointBY - pointAY) * normalY
End If

# FACE_B_TYPE.
Var normalX As Double = xfB.Q.C * Me.Axis.X - xfB.Q.S * Me.Axis.Y
Var normalY As Double = xfB.Q.S * Me.Axis.X + xfB.Q.C * Me.Axis.Y
Var pointBX As Double = xfB.Q.C * Me.LocalPoint.X - xfB.Q.S * Me.LocalPoint.Y + xfB.P.X
Var pointBY As Double = xfB.Q.S * Me.LocalPoint.X + xfB.Q.C * Me.LocalPoint.Y + xfB.P.Y

Var localPointA As Vector2 = Me.ProxyA.Points[indexA]
Var pointAX As Double = xfA.Q.C * localPointA.X - xfA.Q.S * localPointA.Y + xfA.P.X
Var pointAY As Double = xfA.Q.S * localPointA.X + xfA.Q.C * localPointA.Y + xfA.P.Y

Return (pointAX - pointBX) * normalX + (pointAY - pointBY) * normalY
End Function
End Class

# Engine-internal holder for the support indices found by
# SeparationFunction.FindMinSeparation. Reused across calls.
Class SeparationResult
## Support index on proxy A. Negative for face-B queries.
Property IndexA As Integer
## Support index on proxy B. Negative for face-A queries.
Property IndexB As Integer
## The minimum separation at the queried time.
Property Separation As Double

## Creates a result with invalid indices.
Constructor()
Me.IndexA = -1
Me.IndexB = -1
Me.Separation = 0.0
End Constructor
End Class

# Shape façade, ported from upstream b2Shape in shape.h plus the b2Shape_*
# API family in box2d.h. A shape is owned by its world: the world stores one
# Shape per slot in a sparse array, destroys reclaim the slot and increment
# the generation, and stale façades fail IsValid. Geometry is stored as owned
# value objects, exactly one of which is non-null per shape type. Chain
# segment geometry carries the owning chain's slot index.
#
# Creation goes through Body.CreateCircle and friends; destruction through
# Shape.Destroy or the owning body/world cascade.
Class Shape
## Owning world. Set at creation and never changed.
Property Owner As World
## Slot index of this shape in the world shape store.
Property Id As Integer
## Generation counter, incremented when the slot is freed and reused.
Property Generation As Integer
## Whether this shape is live. Stale façades keep the object but flip this.
Property Live As Boolean
## Slot index of the owning body.
Property BodyId As Integer
## Previous shape in the body's doubly linked shape list.
Property PrevShapeId As Integer
## Next shape in the body's doubly linked shape list.
Property NextShapeId As Integer
## Sensor store index, or the null sentinel. The sensor store arrives in
## Stage 8; until then this stays null and IsSensor reports the definition.
Property SensorIndex As Integer
## The geometry type of this shape.
Property Type As ShapeType
## Density in kilograms per square metre.
Property Density As Double
## Coefficient of friction.
Property Friction As Double
## Coefficient of restitution.
Property Restitution As Double
## Rolling resistance.
Property RollingResistance As Double
## Surface tangent speed in metres per second.
Property TangentSpeed As Double
## User material identifier used by mixers.
Property UserMaterialId As Integer
## Debug-draw colour override. Zero means no override.
Property CustomColor As Integer
## Axis-aligned bounding box including the speculative margin.
Property AABB As AABB
## Fat AABB stored for tree move decisions.
Property FatAABB As AABB
## Local centroid of the geometry.
Property LocalCentroid As Vector2
## Broad-phase proxy key, or the null sentinel when the body is disabled.
Property ProxyKey As Integer
## Collision filter.
Property Filter As Filter
## User data owned by the application. Never read by the solver.
Property UserData As Object
## Whether this shape reports sensor events.
Property EnableSensorEvents As Boolean
## Whether this shape reports contact events.
Property EnableContactEvents As Boolean
## Whether this shape reports hit events.
Property EnableHitEvents As Boolean
## Whether this shape reports pre-solve events.
Property EnablePreSolveEvents As Boolean
## Whether the AABB was enlarged by a shape change and the proxy needs
## attention. Consumed by contact updates from Stage 7.
Property EnlargedAABB As Boolean
## Whether this shape was created as a sensor. The sensor store itself
## arrives in Stage 8.
Property IsSensorFlag As Boolean
## Circle geometry when Type is CircleShape.
Property Circle As Circle
## Capsule geometry when Type is CapsuleShape.
Property Capsule As Capsule
## Segment geometry when Type is SegmentShape.
Property Segment As Segment
## Polygon geometry when Type is PolygonShape.
Property Polygon As Polygon
## Chain segment geometry when Type is ChainSegmentShape.
Property ChainSegment As ChainSegment
## Distance proxy over the local geometry, rebuilt on creation and geometry
## change, used by overlap and closest-point queries.
Property DistanceProxy As ShapeProxy

## Creates an empty, unbound shape. Only the world may construct live
## shapes; the zero-argument form exists for sparse array capacity.
Constructor()
Me.Owner = Nothing
Me.Id = PhysicsConstants.NULL_INDEX
Me.Generation = PhysicsConstants.INVALID_GENERATION
Me.Live = False
Me.BodyId = PhysicsConstants.NULL_INDEX
Me.PrevShapeId = PhysicsConstants.NULL_INDEX
Me.NextShapeId = PhysicsConstants.NULL_INDEX
Me.SensorIndex = PhysicsConstants.NULL_INDEX
Me.Type = ShapeType.CircleShape
Me.Density = 0.0
Me.Friction = 0.0
Me.Restitution = 0.0
Me.RollingResistance = 0.0
Me.TangentSpeed = 0.0
Me.UserMaterialId = 0
Me.CustomColor = 0
Me.AABB = New AABB
Me.FatAABB = New AABB
Me.LocalCentroid = New Vector2(0.0, 0.0)
Me.ProxyKey = PhysicsConstants.NULL_INDEX
Me.Filter = New Filter()
Me.UserData = Nothing
Me.EnableSensorEvents = False
Me.EnableContactEvents = False
Me.EnableHitEvents = False
Me.EnablePreSolveEvents = False
Me.EnlargedAABB = False
Me.IsSensorFlag = False
Me.Circle = Nothing
Me.Capsule = Nothing
Me.Segment = Nothing
Me.Polygon = Nothing
Me.ChainSegment = Nothing
Me.DistanceProxy = New ShapeProxy
End Constructor

## Returns True when this façade still addresses a live shape.
Function IsValid() As Boolean
If Me.Owner = Nothing Or Not Me.Live Then
Return False
End If
Return Me.Owner.Shapes[Me.Id] = Me
End Function

## Throws a descriptive exception when this façade is stale. All mutating
## and reading members call this first.
Sub Validate()
If Not Me.IsValid() Then
Throw New RuntimeException("Shape façade is no longer valid")
End If
End Sub

## Returns the owning body façade.
Function GetBody() As Body
Me.Validate()
Return Me.Owner.Bodies[Me.BodyId]
End Function

## Returns the owning world façade.
Function GetWorld() As World
Me.Validate()
Return Me.Owner
End Function

## The geometry type of this shape. Named GetShapeType because every Objo
## object already has a GetType method from the root class.
Function GetShapeType() As ShapeType
Me.Validate()
Return Me.Type
End Function

## Whether this shape was created as a sensor.
Function IsSensor() As Boolean
Me.Validate()
Return Me.IsSensorFlag
End Function

## The axis-aligned bounding box including the speculative margin. The
## result is a copy, so editing it never corrupts the shape.
Function GetAABB() As AABB
Me.Validate()
Return New AABB(Me.AABB)
End Function

## User data owned by the application.
Function GetUserData() As Object
Me.Validate()
Return Me.UserData
End Function

## Sets user data owned by the application.
Sub SetUserData(userData As Object)
Me.Validate()
Me.UserData = userData
End Sub

## Event flag accessors, ported from the b2Shape_Enable*Event family.

## Sets whether this shape reports sensor events.
Sub SetSensorEventsEnabled(flag As Boolean)
Me.Validate()
Me.EnableSensorEvents = flag
End Sub

## Whether this shape reports sensor events.
Function AreSensorEventsEnabled() As Boolean
Me.Validate()
Return Me.EnableSensorEvents
End Function

## Sets whether this shape reports contact events.
Sub SetContactEventsEnabled(flag As Boolean)
Me.Validate()
Me.EnableContactEvents = flag
End Sub

## Whether this shape reports contact events.
Function AreContactEventsEnabled() As Boolean
Me.Validate()
Return Me.EnableContactEvents
End Function

## Sets whether this shape reports contact hit events.
Sub SetHitEventsEnabled(flag As Boolean)
Me.Validate()
Me.EnableHitEvents = flag
End Sub

## Whether this shape reports contact hit events.
Function AreHitEventsEnabled() As Boolean
Me.Validate()
Return Me.EnableHitEvents
End Function

## Sets whether this shape reports pre-solve events.
Sub SetPreSolveEventsEnabled(flag As Boolean)
Me.Validate()
Me.EnablePreSolveEvents = flag
End Sub

## Whether this shape reports pre-solve events.
Function ArePreSolveEventsEnabled() As Boolean
Me.Validate()
Return Me.EnablePreSolveEvents
End Function

## Returns a copy of the circle geometry. Throws when the shape is not a
## circle, matching the upstream assertion.
Function GetCircle() As Circle
Me.Validate()
If Me.Type <> ShapeType.CircleShape Then
Throw New RuntimeException("Shape is not a circle")
End If
Return New Circle(Me.Circle)
End Function

## Returns a copy of the capsule geometry. Throws when the shape is not a
## capsule, matching the upstream assertion.
Function GetCapsule() As Capsule
Me.Validate()
If Me.Type <> ShapeType.CapsuleShape Then
Throw New RuntimeException("Shape is not a capsule")
End If
Return New Capsule(Me.Capsule)
End Function

## Returns a copy of the segment geometry. Throws when the shape is not a
## segment, matching the upstream assertion.
Function GetSegment() As Segment
Me.Validate()
If Me.Type <> ShapeType.SegmentShape Then
Throw New RuntimeException("Shape is not a segment")
End If
Return New Segment(Me.Segment)
End Function

## Returns a copy of the chain segment geometry, including ghost vertices.
## Throws when the shape is not a chain segment, matching the upstream
## assertion.
Function GetChainSegment() As ChainSegment
Me.Validate()
If Me.Type <> ShapeType.ChainSegmentShape Then
Throw New RuntimeException("Shape is not a chain segment")
End If
Return New ChainSegment(Me.ChainSegment)
End Function

## Returns a deep copy of the polygon geometry. Throws when the shape is not
## a polygon, matching the upstream assertion.
Function GetPolygon() As Polygon
Me.Validate()
If Me.Type <> ShapeType.PolygonShape Then
Throw New RuntimeException("Shape is not a polygon")
End If
Return New Polygon(Me.Polygon.Vertices, Me.Polygon.Normals, Me.Polygon.Centroid, Me.Polygon.Radius, Me.Polygon.Count)
End Function

## Replaces the shape geometry with a circle and rebuilds the proxy,
## ported from b2Shape_SetCircle.
Sub SetCircle(circle As Circle)
Me.Validate()
Me.Owner.SetShapeGeometryCircle(Me, circle)
End Sub

## Replaces the shape geometry with a capsule and rebuilds the proxy,
## ported from b2Shape_SetCapsule.
Sub SetCapsule(capsule As Capsule)
Me.Validate()
Me.Owner.SetShapeGeometryCapsule(Me, capsule)
End Sub

## Replaces the shape geometry with a segment and rebuilds the proxy,
## ported from b2Shape_SetSegment.
Sub SetSegment(segment As Segment)
Me.Validate()
Me.Owner.SetShapeGeometrySegment(Me, segment)
End Sub

## Replaces the shape geometry with a polygon and rebuilds the proxy,
## ported from b2Shape_SetPolygon.
Sub SetPolygon(polygon As Polygon)
Me.Validate()
Me.Owner.SetShapeGeometryPolygon(Me, polygon)
End Sub

## The shape density in kilograms per square metre.
Function GetDensity() As Double
Me.Validate()
Return Me.Density
End Function

## Sets the shape density and optionally recomputes body mass, ported from
## b2Shape_SetDensity.
Sub SetDensity(density As Double, updateBodyMass As Boolean)
Me.Validate()
Me.Owner.SetShapeDensity(Me, density, updateBodyMass)
End Sub

## The coefficient of friction.
Function GetFriction() As Double
Me.Validate()
Return Me.Friction
End Function

## Sets the coefficient of friction.
Sub SetFriction(friction As Double)
Me.Validate()
Me.Friction = friction
End Sub

## The coefficient of restitution.
Function GetRestitution() As Double
Me.Validate()
Return Me.Restitution
End Function


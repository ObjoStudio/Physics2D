Function GetMassData() As MassData
Me.Validate()
Return Me.Owner.GetBodyMassData(Me)
End Function

## Overrides the mass data, ported from b2Body_SetMassData.
Sub SetMassData(massData As MassData)
Me.Validate()
Me.Owner.SetBodyMassData(Me, massData)
End Sub

## Recomputes mass data from the attached shapes, ported from
## b2Body_ApplyMassFromShapes.
Sub ApplyMassFromShapes()
Me.Validate()
Me.Owner.UpdateBodyMassData(Me)
End Sub

## Linear damping in kilograms per second.
Function GetLinearDamping() As Double
Me.Validate()
Return Me.Owner.GetBodyLinearDamping(Me)
End Function

## Sets linear damping in kilograms per second.
Sub SetLinearDamping(linearDamping As Double)
Me.Validate()
Me.Owner.SetBodyLinearDamping(Me, linearDamping)
End Sub

## Angular damping in kilograms per second.
Function GetAngularDamping() As Double
Me.Validate()
Return Me.Owner.GetBodyAngularDamping(Me)
End Function

## Sets angular damping in kilograms per second.
Sub SetAngularDamping(angularDamping As Double)
Me.Validate()
Me.Owner.SetBodyAngularDamping(Me, angularDamping)
End Sub

## The gravity scale.
Function GetGravityScale() As Double
Me.Validate()
Return Me.Owner.GetBodyGravityScale(Me)
End Function

## Sets the gravity scale.
Sub SetGravityScale(gravityScale As Double)
Me.Validate()
Me.Owner.SetBodyGravityScale(Me, gravityScale)
End Sub

## Whether the body is in the awake set.
Function IsAwake() As Boolean
Me.Validate()
Return Me.SetIndex = 2
End Function

## Wakes or sleeps the body, ported from b2Body_SetAwake. Sleeping applies
## to this body alone in Stage 6; island-wide sleeping arrives in Stage 7.
Sub SetAwake(awake As Boolean)
Me.Validate()
Me.Owner.SetBodyAwake(Me, awake)
End Sub

## Whether the body is enabled (not in the disabled set).
Function IsEnabled() As Boolean
Me.Validate()
Return Me.SetIndex <> 1
End Function

## Enables a disabled body, ported from b2Body_Enable.
Sub Enable()
Me.Validate()
Me.Owner.EnableBody(Me)
End Sub

## Disables a live body, ported from b2Body_Disable.
Sub Disable()
Me.Validate()
Me.Owner.DisableBody(Me)
End Sub

## Whether the body may ever sleep.
Function IsSleepEnabled() As Boolean
Me.Validate()
Return Me.EnableSleep
End Function

## Enables or disables sleeping for this body, waking it when disabled,
## ported from b2Body_EnableSleep. Named SetEnableSleep because EnableSleep
## names the property.
Sub SetEnableSleep(enableSleep As Boolean)
Me.Validate()
Me.Owner.SetBodyEnableSleep(Me, enableSleep)
End Sub

## The sleep speed threshold in metres per second.
Function GetSleepThreshold() As Double
Me.Validate()
Return Me.SleepThreshold
End Function

## Sets the sleep speed threshold in metres per second.
Sub SetSleepThreshold(sleepThreshold As Double)
Me.Validate()
Me.SleepThreshold = sleepThreshold
End Sub

## Whether rotation is locked.
Function IsFixedRotation() As Boolean
Me.Validate()
Return Me.FixedRotation
End Function

## Locks or unlocks rotation and recomputes mass, ported from
## b2Body_SetFixedRotation.
Sub SetFixedRotation(flag As Boolean)
Me.Validate()
Me.Owner.SetBodyFixedRotation(Me, flag)
End Sub

## Whether the body is treated as a bullet for continuous collision.
Function IsBullet() As Boolean
Me.Validate()
Return Me.Owner.GetBodySim(Me).IsBullet.Items[Me.LocalIndex] <> 0
End Function

## Sets the bullet flag, ported from b2Body_SetBullet.
Sub SetBullet(flag As Boolean)
Me.Validate()
Var bulletValue As Integer = 0
If flag Then
bulletValue = 1
End If
Me.Owner.GetBodySim(Me).IsBullet.Items[Me.LocalIndex] = bulletValue
End Sub

## Enables or disables contact begin/end events on every shape attached to
## the body, ported from b2Body_EnableContactEvents. The body-level switch
## writes through to each attached shape's event flag; new shapes start
## from the definition default, so call this again after adding shapes.
Sub EnableContactEvents(flag As Boolean)
Me.Validate()
Me.Owner.CheckNotLocked()
Var shapeId As Integer = Me.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
shape.EnableContactEvents = flag
shapeId = shape.NextShapeId
Wend
End Sub

## Enables or disables hit events on every shape attached to the body,
## ported from b2Body_EnableHitEvents. The body-level switch writes
## through to each attached shape's event flag; new shapes start from the
## definition default, so call this again after adding shapes.
Sub EnableHitEvents(flag As Boolean)
Me.Validate()
Me.Owner.CheckNotLocked()
Var shapeId As Integer = Me.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
shape.EnableHitEvents = flag
shapeId = shape.NextShapeId
Wend
End Sub

## True when every shape attached to the body reports contact events,
## ported from b2Body_AreContactEventsEnabled. False when the body has no
## shapes or any shape has the flag disabled.
Function AreContactEventsEnabled() As Boolean
Me.Validate()
If Me.HeadShapeId = PhysicsConstants.NULL_INDEX Then
Return False
End If
Var shapeId As Integer = Me.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
If shape.EnableContactEvents = False Then
Return False
End If
shapeId = shape.NextShapeId
Wend
Return True
End Function

## True when every shape attached to the body reports hit events, ported
## from b2Body_AreHitEventsEnabled. False when the body has no shapes or
## any shape has the flag disabled.
Function AreHitEventsEnabled() As Boolean
Me.Validate()
If Me.HeadShapeId = PhysicsConstants.NULL_INDEX Then
Return False
End If
Var shapeId As Integer = Me.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
If shape.EnableHitEvents = False Then
Return False
End If
shapeId = shape.NextShapeId
Wend
Return True
End Function

## The number of attached shapes.
Function GetShapeCount() As Integer
Me.Validate()
Return Me.ShapeCount
End Function

## Returns the attached shape façades in a fresh array. Allocating
## convenience for cold paths.
Function GetShapes() As Array(Of Shape)
Me.Validate()
Var results As New Array(Of Shape)
Var shapeId As Integer = Me.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
results.Append(shape)
shapeId = shape.NextShapeId
Wend
Return results
End Function

## The number of attached joints, ported from b2Body_GetJointCount.
Function GetJointCount() As Integer
Me.Validate()
Return Me.JointCount
End Function

## Returns the attached joint façades in a fresh array, ported from
## b2Body_GetJoints. Allocating convenience for cold paths.
Function GetJoints() As Array(Of Joint)
Me.Validate()
Var results As New Array(Of Joint)
Var jointKey As Integer = Me.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Owner.Joints[jointId]
results.Append(joint)
If edgeIndex = 0 Then
jointKey = joint.Edge0NextKey
Else
jointKey = joint.Edge1NextKey
End If
Wend
Return results
End Function

## Computes the union of attached shape bounds, ported from
## b2Body_ComputeAABB. A body without shapes reports its origin point.
Function ComputeAABB() As AABB
Me.Validate()
Return Me.Owner.ComputeBodyAABB(Me)
End Function

## Changes the body type, ported from b2Body_SetType.
Sub SetType(bodyType As BodyType)
Me.Validate()
Me.Owner.SetBodyType(Me, bodyType)
End Sub

## Creates a circle shape on this body, ported from b2Body_CreateCircle.
Function CreateCircle(def As ShapeDefinition, circle As Circle) As Shape
Me.Validate()
Return Me.Owner.CreateCircleShape(Me, def, circle)
End Function

## Creates a capsule shape on this body, ported from b2Body_CreateCapsule.
## A degenerate capsule collapses to a circle exactly like upstream.
Function CreateCapsule(def As ShapeDefinition, capsule As Capsule) As Shape
Me.Validate()
Return Me.Owner.CreateCapsuleShape(Me, def, capsule)
End Function

## Creates a polygon shape on this body, ported from b2Body_CreatePolygon.
Function CreatePolygon(def As ShapeDefinition, polygon As Polygon) As Shape
Me.Validate()
Return Me.Owner.CreatePolygonShape(Me, def, polygon)
End Function

## Creates a segment shape on this body, ported from b2Body_CreateSegment.
## Degenerate segments are rejected exactly like upstream.
Function CreateSegment(def As ShapeDefinition, segment As Segment) As Shape
Me.Validate()
Return Me.Owner.CreateSegmentShape(Me, def, segment)
End Function

## Destroys this body, its shapes, and its chains, ported from
## b2DestroyBody. Idempotent on already-destroyed façades.
Sub Destroy()
If Not Me.IsValid() Then
Return
End If
Me.Owner.DestroyBody(Me)
End Sub
End Class

# Body definition passed to World.CreateBody, ported from upstream b2BodyDef
# in types.h. The constructor sets the same defaults as b2DefaultBodyDef.
Class BodyDefinition
## The body type: StaticBody, KinematicBody, or DynamicBody.
Property Type As BodyType
## The initial world position of the body origin.
Property Position As Vector2
## The initial world rotation of the body.
Property Rotation As Rot
## The initial linear velocity of the centre of mass.
Property LinearVelocity As Vector2
## The initial angular velocity in radians per second.
Property AngularVelocity As Double
## Linear damping (kg per second).
Property LinearDamping As Double
## Angular damping (kg per second).
Property AngularDamping As Double
## Scales gravity: zero disables it, one applies full gravity.
Property GravityScale As Double
## Below this speed a body may sleep (metres per second).
Property SleepThreshold As Double
## Whether this body may ever sleep.
Property EnableSleep As Boolean
## Whether the body starts awake. Sleeping is forced off when sleep is
## disabled or the body is disabled.
Property IsAwake As Boolean
## Whether the body starts enabled.
Property IsEnabled As Boolean
## Whether this body is treated as a bullet for continuous collision.
Property IsBullet As Boolean
## Whether rotation is locked.
Property FixedRotation As Boolean
## Whether fast rotation is allowed to exceed the rotation cap in a step.
Property AllowFastRotation As Boolean
## Optional body name, truncated to 31 characters like upstream.
Property Name As String
## User data owned by the application, copied to the created body. Never read by the solver.
Property UserData As Object

## Creates the default body definition, matching upstream b2DefaultBodyDef.
Constructor()
Me.Type = BodyType.StaticBody
Me.Position = New Vector2(0.0, 0.0)
Me.Rotation = New Rot()
Me.LinearVelocity = New Vector2(0.0, 0.0)
Me.AngularVelocity = 0.0
Me.LinearDamping = 0.0
Me.AngularDamping = 0.0
Me.GravityScale = 1.0
Me.SleepThreshold = 0.05
Me.EnableSleep = True
Me.IsAwake = True
Me.IsEnabled = True
Me.IsBullet = False
Me.FixedRotation = False
Me.AllowFastRotation = False
Me.Name = ""
Me.UserData = Nothing
End Constructor
End Class

# Dense per-body simulation state for one solver set, ported from upstream
# b2BodySim in body.h. Decision 0004 selects parallel scalar arrays for body
# state, so every field is one list indexed by the owning body's local index.
# Flags are stored as separate 0/1 lists for clarity; none of these fields
# hold object references, so set transfers copy scalars only.
Class BodySims
## World position of the body origin, x component.
Property PX As DoubleList
## World position of the body origin, y component.
Property PY As DoubleList
## Body rotation, cosine component.
Property QC As DoubleList
## Body rotation, sine component.
Property QS As DoubleList
## World centre of mass, x component.
Property CenterX As DoubleList
## World centre of mass, y component.
Property CenterY As DoubleList
## Rotation at the start of the step, cosine component.
Property R0C As DoubleList
## Rotation at the start of the step, sine component.
Property R0S As DoubleList
## Centre of mass at the start of the step, x component.
Property C0X As DoubleList
## Centre of mass at the start of the step, y component.
Property C0Y As DoubleList
## Local centre of mass relative to the body origin, x component.
Property LCX As DoubleList
## Local centre of mass relative to the body origin, y component.
Property LCY As DoubleList
## Accumulated force, x component.
Property ForceX As DoubleList
## Accumulated force, y component.
Property ForceY As DoubleList
## Accumulated torque.
Property Torque As DoubleList
## Inverse mass. Zero for static and kinematic bodies.
Property InvMass As DoubleList
## Inverse rotational inertia about the centre of mass.
Property InvInertia As DoubleList
## Minimum shape extent relative to the local centre of mass.
Property MinExtent As DoubleList
## Maximum shape extent relative to the local centre of mass.
Property MaxExtent As DoubleList
## Linear damping (kg per second).
Property LinearDamping As DoubleList
## Angular damping (kg per second).
Property AngularDamping As DoubleList
## Gravity scale.
Property GravityScale As DoubleList
## Index of the owning body in the world body store.
Property BodyId As IntegerList
## Whether the body is treated as a bullet for continuous collision.
Property IsBullet As IntegerList
## Whether the body moved fast enough to require continuous collision.
Property IsFast As IntegerList
## Whether the speed cap engaged in the last step.
Property IsSpeedCapped As IntegerList
## Whether fast rotation may exceed the rotation cap in a step.
Property AllowFastRotation As IntegerList
## Whether an AABB was enlarged by a shape change and needs proxy attention.
Property EnlargeAABB As IntegerList

## Creates empty sim storage with the upstream initial reserve of 16 bodies.
Constructor()
Me.PX = New DoubleList(16)
Me.PY = New DoubleList(16)
Me.QC = New DoubleList(16)
Me.QS = New DoubleList(16)
Me.CenterX = New DoubleList(16)
Me.CenterY = New DoubleList(16)
Me.R0C = New DoubleList(16)
Me.R0S = New DoubleList(16)
Me.C0X = New DoubleList(16)
Me.C0Y = New DoubleList(16)
Me.LCX = New DoubleList(16)
Me.LCY = New DoubleList(16)
Me.ForceX = New DoubleList(16)
Me.ForceY = New DoubleList(16)
Me.Torque = New DoubleList(16)
Me.InvMass = New DoubleList(16)
Me.InvInertia = New DoubleList(16)
Me.MinExtent = New DoubleList(16)
Me.MaxExtent = New DoubleList(16)
Me.LinearDamping = New DoubleList(16)
Me.AngularDamping = New DoubleList(16)
Me.GravityScale = New DoubleList(16)
Me.BodyId = New IntegerList(16)
Me.IsBullet = New IntegerList(16)
Me.IsFast = New IntegerList(16)
Me.IsSpeedCapped = New IntegerList(16)
Me.AllowFastRotation = New IntegerList(16)
Me.EnlargeAABB = New IntegerList(16)
End Constructor

## Number of bodies stored in this set.
Function Count() As Integer
Return Me.BodyId.Count
End Function

## Appends a zeroed sim record and returns its local index. The caller fills
## position, rotation, extents, damping, gravity scale, and body identity.
Function Add() As Integer
Me.PX.Append(0.0)
Me.PY.Append(0.0)
Me.QC.Append(1.0)
Me.QS.Append(0.0)
Me.CenterX.Append(0.0)
Me.CenterY.Append(0.0)
Me.R0C.Append(1.0)
Me.R0S.Append(0.0)
Me.C0X.Append(0.0)
Me.C0Y.Append(0.0)
Me.LCX.Append(0.0)
Me.LCY.Append(0.0)
Me.ForceX.Append(0.0)
Me.ForceY.Append(0.0)
Me.Torque.Append(0.0)
Me.InvMass.Append(0.0)
Me.InvInertia.Append(0.0)
Me.MinExtent.Append(0.0)
Me.MaxExtent.Append(0.0)
Me.LinearDamping.Append(0.0)
Me.AngularDamping.Append(0.0)
Me.GravityScale.Append(1.0)
Me.BodyId.Append(PhysicsConstants.NULL_INDEX)
Me.IsBullet.Append(0)
Me.IsFast.Append(0)
Me.IsSpeedCapped.Append(0)
Me.AllowFastRotation.Append(0)
Me.EnlargeAABB.Append(0)
Return Me.BodyId.Count - 1
End Function

## Removes the record at index by swapping in the last record. Returns the
## local index the displaced record moved from, or the null sentinel when the
## removed record was already last.
Function RemoveSwap(index As Integer) As Integer
Me.PX.RemoveSwap(index)
Me.PY.RemoveSwap(index)
Me.QC.RemoveSwap(index)
Me.QS.RemoveSwap(index)
Me.CenterX.RemoveSwap(index)
Me.CenterY.RemoveSwap(index)
Me.R0C.RemoveSwap(index)
Me.R0S.RemoveSwap(index)
Me.C0X.RemoveSwap(index)
Me.C0Y.RemoveSwap(index)
Me.LCX.RemoveSwap(index)
Me.LCY.RemoveSwap(index)
Me.ForceX.RemoveSwap(index)
Me.ForceY.RemoveSwap(index)
Me.Torque.RemoveSwap(index)
Me.InvMass.RemoveSwap(index)
Me.InvInertia.RemoveSwap(index)
Me.MinExtent.RemoveSwap(index)
Me.MaxExtent.RemoveSwap(index)
Me.LinearDamping.RemoveSwap(index)
Me.AngularDamping.RemoveSwap(index)
Me.GravityScale.RemoveSwap(index)
Var movedIndex As Integer = Me.BodyId.RemoveSwap(index)
Me.IsBullet.RemoveSwap(index)
Me.IsFast.RemoveSwap(index)
Me.IsSpeedCapped.RemoveSwap(index)
Me.AllowFastRotation.RemoveSwap(index)
Me.EnlargeAABB.RemoveSwap(index)
Return movedIndex
End Function

## Copies every field of the record at sourceIndex onto the record at
## targetIndex. Both indices are in this storage. Ported from the memcpy in
## upstream b2TransferBody, used here for set-to-set moves.
Sub CopyRecordTo(targetIndex As Integer, source As BodySims, sourceIndex As Integer)
Me.PX.Items[targetIndex] = source.PX.Items[sourceIndex]
Me.PY.Items[targetIndex] = source.PY.Items[sourceIndex]
Me.QC.Items[targetIndex] = source.QC.Items[sourceIndex]
Me.QS.Items[targetIndex] = source.QS.Items[sourceIndex]
Me.CenterX.Items[targetIndex] = source.CenterX.Items[sourceIndex]
Me.CenterY.Items[targetIndex] = source.CenterY.Items[sourceIndex]
Me.R0C.Items[targetIndex] = source.R0C.Items[sourceIndex]
Me.R0S.Items[targetIndex] = source.R0S.Items[sourceIndex]
Me.C0X.Items[targetIndex] = source.C0X.Items[sourceIndex]
Me.C0Y.Items[targetIndex] = source.C0Y.Items[sourceIndex]
Me.LCX.Items[targetIndex] = source.LCX.Items[sourceIndex]
Me.LCY.Items[targetIndex] = source.LCY.Items[sourceIndex]
Me.ForceX.Items[targetIndex] = source.ForceX.Items[sourceIndex]
Me.ForceY.Items[targetIndex] = source.ForceY.Items[sourceIndex]
Me.Torque.Items[targetIndex] = source.Torque.Items[sourceIndex]
Me.InvMass.Items[targetIndex] = source.InvMass.Items[sourceIndex]
Me.InvInertia.Items[targetIndex] = source.InvInertia.Items[sourceIndex]
Me.MinExtent.Items[targetIndex] = source.MinExtent.Items[sourceIndex]
Me.MaxExtent.Items[targetIndex] = source.MaxExtent.Items[sourceIndex]
Me.LinearDamping.Items[targetIndex] = source.LinearDamping.Items[sourceIndex]
Me.AngularDamping.Items[targetIndex] = source.AngularDamping.Items[sourceIndex]
Me.GravityScale.Items[targetIndex] = source.GravityScale.Items[sourceIndex]
Me.BodyId.Items[targetIndex] = source.BodyId.Items[sourceIndex]
Me.IsBullet.Items[targetIndex] = source.IsBullet.Items[sourceIndex]
Me.IsFast.Items[targetIndex] = source.IsFast.Items[sourceIndex]
Me.IsSpeedCapped.Items[targetIndex] = source.IsSpeedCapped.Items[sourceIndex]
Me.AllowFastRotation.Items[targetIndex] = source.AllowFastRotation.Items[sourceIndex]
Me.EnlargeAABB.Items[targetIndex] = source.EnlargeAABB.Items[sourceIndex]
End Sub

## Returns the storage to its initial empty state. Capacity is retained so a
## warmed world rebuilds without allocation.
Sub ClearAll()
Me.PX.Clear()
Me.PY.Clear()
Me.QC.Clear()
Me.QS.Clear()
Me.CenterX.Clear()
Me.CenterY.Clear()
Me.R0C.Clear()
Me.R0S.Clear()
Me.C0X.Clear()
Me.C0Y.Clear()
Me.LCX.Clear()
Me.LCY.Clear()
Me.ForceX.Clear()
Me.ForceY.Clear()
Me.Torque.Clear()
Me.InvMass.Clear()
Me.InvInertia.Clear()
Me.MinExtent.Clear()
Me.MaxExtent.Clear()
Me.LinearDamping.Clear()
Me.AngularDamping.Clear()
Me.GravityScale.Clear()
Me.BodyId.Clear()
Me.IsBullet.Clear()
Me.IsFast.Clear()
Me.IsSpeedCapped.Clear()
Me.AllowFastRotation.Clear()
Me.EnlargeAABB.Clear()
End Sub
End Class

# Dense per-body velocity state for one solver set, ported from upstream
# b2BodyState in body.h. Only the awake set stores body states: sleeping and
# static bodies carry no velocity state. Decision 0004 selects parallel
# scalar arrays, so every field is one list indexed by the owning body's
# local index within the set.
Class BodyStates
## Linear velocity of the centre of mass, x component.
Property LVX As DoubleList
## Linear velocity of the centre of mass, y component.
Property LVY As DoubleList
## Angular velocity in radians per second.
Property AngularVelocity As DoubleList
## Solver flags, ported from upstream b2BodyState flags. Meaningless until
## the Soft Step solver lands in Stage 7.
Property Flags As IntegerList
## Substep position correction, x component.
Property DPX As DoubleList
## Substep position correction, y component.
Property DPY As DoubleList
## Substep rotation correction, cosine component.
Property DRC As DoubleList
## Substep rotation correction, sine component.
Property DRS As DoubleList

## Creates empty state storage with the upstream initial reserve of 16.
Constructor()
Me.LVX = New DoubleList(16)
Me.LVY = New DoubleList(16)
Me.AngularVelocity = New DoubleList(16)
Me.Flags = New IntegerList(16)
Me.DPX = New DoubleList(16)
Me.DPY = New DoubleList(16)
Me.DRC = New DoubleList(16)
Me.DRS = New DoubleList(16)
End Constructor

## Number of states stored in this set.
Function Count() As Integer
Return Me.Flags.Count
End Function

## Appends an identity state, ported from upstream b2_identityBodyState, and
## returns its local index.
Function Add() As Integer
Me.LVX.Append(0.0)
Me.LVY.Append(0.0)
Me.AngularVelocity.Append(0.0)
Me.Flags.Append(0)
Me.DPX.Append(0.0)
Me.DPY.Append(0.0)
Me.DRC.Append(1.0)
Me.DRS.Append(0.0)
Return Me.Flags.Count - 1
End Function

## Returns the storage to its initial empty state. Capacity is retained so a
## warmed world rebuilds without allocation.
Sub ClearAll()
Me.LVX.Clear()
Me.LVY.Clear()
Me.AngularVelocity.Clear()
Me.Flags.Clear()
Me.DPX.Clear()
Me.DPY.Clear()
Me.DRC.Clear()
Me.DRS.Clear()
End Sub

## Removes the state at index by swapping in the last state. Returns the
## local index the displaced state moved from, or the null sentinel when the
## removed state was already last.
Function RemoveSwap(index As Integer) As Integer
Me.LVX.RemoveSwap(index)
Me.LVY.RemoveSwap(index)
Me.AngularVelocity.RemoveSwap(index)
Var movedIndex As Integer = Me.Flags.RemoveSwap(index)
Me.DPX.RemoveSwap(index)
Me.DPY.RemoveSwap(index)
Me.DRC.RemoveSwap(index)
Me.DRS.RemoveSwap(index)
Return movedIndex
End Function
End Class

# Kind of body owning a broad-phase proxy, ported from upstream b2BodyType
# in types.h. The numeric values double as indices into the broad-phase tree
# array: Static is index 0, Kinematic index 1, and Dynamic index 2.
Enum BodyType
StaticBody
KinematicBody
DynamicBody
End Enum

# Broad phase, ported from Box2D 3.1.1 src/broad_phase.c. One dynamic tree
# per body type (static, kinematic, dynamic), a move buffer of proxies that
# moved significantly, and a shape-pair set tracking existing contacts.
#
# The broad phase does not persist pairs. UpdatePairs reports potentially new
# pairs once per moved proxy through a BroadPhasePairSink, in deterministic
# move order, after move-set and pair-set de-duplication and the sink's own
# collision filter. The world (Stage 6) supplies the sink, registers pair
# keys in PairSet as contacts appear, and consumes BufferMove from body
# movement.
#
# Proxy keys pack the proxy type into the low two bits and the tree proxy id
# above them, mirroring upstream B2_PROXY_KEY. Move-set keys add one so the
# reserved key zero never enters the set.
#
# Like upstream, the static tree is only buffered for pairing when
# explicitly forced (invoke-contact-creation semantics), while kinematic and
# dynamic proxies always pair.
Class BroadPhase
## The three proxy trees indexed by body type: static, kinematic, dynamic.
Property Trees As Array(Of DynamicTree)
## Set of moved proxy keys plus one; zero stays reserved.
Property MoveSet As PairKeySet
## Moved proxy keys in deterministic arrival order, parallel to MoveSet.
Property MoveArray As IntegerList
## Set of shape pair keys that already have a contact.
Property PairSet As PairKeySet

## Pair pool: shape index A per recorded pair.
Private Property mPairShapeIndexA As IntegerList
## Pair pool: shape index B per recorded pair.
Private Property mPairShapeIndexB As IntegerList
## Pair pool: next pair index threading each per-proxy result list.
Private Property mPairNext As IntegerList
## Number of pairs in the pool for the current UpdatePairs traversal.
Private Property mPairCount As Integer
## Head pair index per moved proxy, parallel to the move buffer.
Private Property mResultHeads As IntegerList
## Reused pair query context handed to tree queries.
Private Property mContext As BroadPhaseQueryContext
## Reused fat bounds of the moved proxy being paired.
Private Property mFatBounds As AABB
## Reused traversal stats for pair queries.
Private Property mStats As TreeStats

## Number of pairs recorded by the current UpdatePairs traversal.
Property PairCount As Integer

## Creates a broad phase with the upstream initial capacities.
Constructor()
Me.Trees = New Array(Of DynamicTree)
For i As Integer = 0 To 2
Me.Trees.Append(New DynamicTree)
Next i
Me.MoveSet = New PairKeySet(16)
Me.MoveArray = New IntegerList(16)
Me.PairSet = New PairKeySet(32)
Me.mPairShapeIndexA = New IntegerList(64)
Me.mPairShapeIndexB = New IntegerList(64)
Me.mPairNext = New IntegerList(64)
Me.mPairCount = 0
Me.PairCount = 0
Me.mResultHeads = New IntegerList(16)
Me.mContext = Nothing
Me.mFatBounds = New AABB
Me.mStats = New TreeStats
End Constructor

## Returns the tree index encoded in the low two bits of a proxy key.
Shared Function ProxyType(proxyKey As Integer) As Integer
Return proxyKey.BitAnd(3)
End Function

## Returns the tree proxy id encoded above the type bits of a proxy key.
Shared Function ProxyId(proxyKey As Integer) As Integer
Return proxyKey.ShiftRight(2)
End Function

## Packs a tree proxy id and body type index into a proxy key.
Shared Function MakeProxyKey(proxyId As Integer, typeIndex As Integer) As Integer
Return proxyId.ShiftLeft(2).BitOr(typeIndex)
End Function

## Adds a moved proxy to the move buffer. Called by the world whenever a
## proxy moved enough to deserve a pair query. Adding twice keeps only the
## first arrival, mirroring upstream b2BufferMove.
Sub BufferMove(queryProxyKey As Integer)
# Adding 1 because 0 is the reserved sentinel.
Var alreadyAdded As Boolean = Me.MoveSet.Add(queryProxyKey + 1)
If alreadyAdded = False Then
Me.MoveArray.Append(queryProxyKey)
End If
End Sub

## Creates a proxy in the tree for its body type and returns the proxy key.
## Static proxies only buffer a move when forcePairCreation is set, so new
## static shapes do not pair with already-moved proxies unless requested.
Function CreateProxy(proxyType As BodyType, box As AABB, categoryBits As Integer, shapeIndex As Integer, forcePairCreation As Boolean) As Integer
Var typeIndex As Integer = Integer(proxyType)
If typeIndex < 0 Or typeIndex > 2 Then
Throw New InvalidArgumentException("BroadPhase.CreateProxy invalid body type")
End If
Var proxyId As Integer = Me.Trees[typeIndex].CreateProxy(box, categoryBits, shapeIndex)
Var proxyKey As Integer = BroadPhase.MakeProxyKey(proxyId, typeIndex)
If typeIndex <> Integer(BodyType.StaticBody) Or forcePairCreation Then
Me.BufferMove(proxyKey)
End If
Return proxyKey
End Function

## Destroys a proxy and removes it from the move buffer.
Sub DestroyProxy(proxyKey As Integer)
If Me.MoveArray.Count <> Me.MoveSet.Count Then
Throw New RuntimeException("BroadPhase move buffer and move set disagree")
End If
Me.UnBufferMove(proxyKey)

Var typeIndex As Integer = BroadPhase.ProxyType(proxyKey)
Var proxyId As Integer = BroadPhase.ProxyId(proxyKey)

If typeIndex < 0 Or typeIndex > 2 Then
Throw New InvalidArgumentException("BroadPhase.DestroyProxy invalid body type")
End If
Me.Trees[typeIndex].DestroyProxy(proxyId)
End Sub

## Moves a proxy to new bounds and buffers the move.
Sub MoveProxy(proxyKey As Integer, box As AABB)
Var typeIndex As Integer = BroadPhase.ProxyType(proxyKey)
Var proxyId As Integer = BroadPhase.ProxyId(proxyKey)

Me.Trees[typeIndex].MoveProxy(proxyId, box)
Me.BufferMove(proxyKey)
End Sub

## Enlarges a proxy in place to bounds strictly containing the old bounds
## and buffers the move. The new bounds must not be contained by the old
## bounds.
Sub EnlargeProxy(proxyKey As Integer, box As AABB)
If proxyKey = PhysicsConstants.NULL_INDEX Then
Throw New InvalidArgumentException("BroadPhase.EnlargeProxy null proxy key")
End If
Var typeIndex As Integer = BroadPhase.ProxyType(proxyKey)
Var proxyId As Integer = BroadPhase.ProxyId(proxyKey)

If typeIndex = Integer(BodyType.StaticBody) Then
Throw New RuntimeException("BroadPhase.EnlargeProxy static proxies cannot enlarge")
End If

Me.Trees[typeIndex].EnlargeProxy(proxyId, box)
Me.BufferMove(proxyKey)
End Sub

## Rebuilds the dynamic and kinematic trees optimally after enlargement,
## mirroring upstream b2BroadPhase_RebuildTrees. The static tree is not
## rebuilt because static proxies never enlarge.
Sub RebuildTrees()
Me.Trees[Integer(BodyType.DynamicBody)].Rebuild(False)
Me.Trees[Integer(BodyType.KinematicBody)].Rebuild(False)
End Sub

## Rebuilds the static tree with a full quality build, ported from the
## static-tree branch of b2World_RebuildStaticTree. The step path only
## enlarges proxies, so static geometry moved through transform writes
## needs this call to restore optimal tree quality.
Sub RebuildStaticTree()
Me.Trees[Integer(BodyType.StaticBody)].Rebuild(True)
End Sub

## Returns the shape index carried by a proxy.
Function GetShapeIndex(proxyKey As Integer) As Integer
Var typeIndex As Integer = BroadPhase.ProxyType(proxyKey)
Var proxyId As Integer = BroadPhase.ProxyId(proxyKey)

Return Me.Trees[typeIndex].GetUserData(proxyId)
End Function

## Returns True when the bounds of the two proxies overlap.
Function TestOverlap(proxyKeyA As Integer, proxyKeyB As Integer) As Boolean
Var typeIndexA As Integer = BroadPhase.ProxyType(proxyKeyA)
Var proxyIdA As Integer = BroadPhase.ProxyId(proxyKeyA)
Var typeIndexB As Integer = BroadPhase.ProxyType(proxyKeyB)
Var proxyIdB As Integer = BroadPhase.ProxyId(proxyKeyB)

Var aabbA As AABB = Me.Trees[typeIndexA].GetAABB(proxyIdA)
Var aabbB As AABB = Me.Trees[typeIndexB].GetAABB(proxyIdB)
Return AABB.Overlaps(aabbA, aabbB)
End Function

## Removes a proxy from the move buffer and set, mirroring upstream
## b2UnBufferMove.
Private Sub UnBufferMove(proxyKey As Integer)
Var found As Boolean = Me.MoveSet.Remove(proxyKey + 1)

If found Then
# Purge from the move buffer with a linear search; order is preserved.
Var count As Integer = Me.MoveArray.Count
For i As Integer = 0 To count - 1
If Me.MoveArray.Items[i] = proxyKey Then
Me.MoveArray.RemoveSwap(i)
Break
End If
Next i
End If
End Sub

## Appends one discovered pair to the per-proxy result list without
## allocating in the warmed steady state. The per-slot lists thread through
## the pair pool in discovery order so consumption walks them LIFO, exactly
## like the upstream linked pair lists.
Sub RecordPair(shapeIndexA As Integer, shapeIndexB As Integer, resultSlot As Integer)
Me.mPairShapeIndexA.Append(shapeIndexA)
Me.mPairShapeIndexB.Append(shapeIndexB)
Me.mPairNext.Append(Me.mResultHeads.Items[resultSlot])
Me.mResultHeads.Items[resultSlot] = Me.mPairCount
Me.mPairCount = Me.mPairCount + 1
Me.PairCount = Me.mPairCount
End Sub

## Finds candidate pairs for every proxy in the move buffer and reports them
## through the sink in deterministic move order. The sink filters pairs at
## record time and receives accepted pairs afterwards. The move buffer and
## set are cleared at the end, mirroring upstream b2UpdateBroadPhasePairs
## without the threading and arena machinery.
##
## The traversal fat bounds of the moved proxy are queried with the tree's
## own stored bounds, which already carry the margin the world applies when
## moving proxies.
Sub UpdatePairs(sink As BroadPhasePairSink)
Var moveCount As Integer = Me.MoveArray.Count
If Me.MoveArray.Count <> Me.MoveSet.Count Then
Throw New RuntimeException("BroadPhase move buffer and move set disagree")
End If

Me.PairCount = 0
Me.mPairCount = 0
# The pair pool restarts every update: clear the lists so their indices
# stay aligned with mPairCount. Capacity is retained, so the warmed
# steady state still allocates nothing.
Me.mPairShapeIndexA.Clear()
Me.mPairShapeIndexB.Clear()
Me.mPairNext.Clear()
If moveCount = 0 Then
Return
End If

If Me.mContext = Nothing Then
Me.mContext = New BroadPhaseQueryContext
End If
Me.mContext.Owner = Me
Me.mContext.Sink = sink

# One result head per moved proxy. The list is reserved so the warmed
# steady state never grows it.
Me.mResultHeads.Clear()
If Me.mResultHeads.Capacity() < moveCount Then
Me.mResultHeads.Reserve(moveCount + (moveCount \ 2))
End If
For i As Integer = 0 To moveCount - 1
Me.mResultHeads.Append(-1)
Next i

For i As Integer = 0 To moveCount - 1
Var proxyKey As Integer = Me.MoveArray.Items[i]
If proxyKey = PhysicsConstants.NULL_INDEX Then
# Proxy was destroyed after it moved.
Continue
End If

Var proxyType As Integer = BroadPhase.ProxyType(proxyKey)
Var proxyId As Integer = BroadPhase.ProxyId(proxyKey)
Me.mContext.QueryProxyKey = proxyKey
Me.mContext.ResultSlot = i

Var baseTree As DynamicTree = Me.Trees[proxyType]

# We have to query the tree with the fat bounds so that we do not fail
# to create a contact that may touch later.
Var fatAABB As AABB = Me.mFatBounds
baseTree.GetAABBTo(proxyId, fatAABB)
Me.mContext.QueryShapeIndex = baseTree.GetUserData(proxyId)

# Query trees. Only dynamic proxies collide with kinematic and static
# proxies, using the default mask bits so group filtering keeps working.
If proxyType = Integer(BodyType.DynamicBody) Then
Me.mContext.QueryTreeType = Integer(BodyType.KinematicBody)
Me.Trees[Integer(BodyType.KinematicBody)].QueryTo(fatAABB, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContext, Me.mStats)

Me.mContext.QueryTreeType = Integer(BodyType.StaticBody)
Me.Trees[Integer(BodyType.StaticBody)].QueryTo(fatAABB, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContext, Me.mStats)
End If

# All proxies collide with dynamic proxies.
Me.mContext.QueryTreeType = Integer(BodyType.DynamicBody)
Me.Trees[Integer(BodyType.DynamicBody)].QueryTo(fatAABB, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContext, Me.mStats)
Next i

# Consume the pairs in deterministic move order.
For i As Integer = 0 To moveCount - 1
Var pairIndex As Integer = Me.mResultHeads.Items[i]
While pairIndex <> -1
sink.AcceptPair(Me.mPairShapeIndexA.Items[pairIndex], Me.mPairShapeIndexB.Items[pairIndex])
pairIndex = Me.mPairNext.Items[pairIndex]
Wend
Next i

# Reset the move buffer.
Me.MoveArray.Clear()
Me.MoveSet.Clear()
End Sub

## Validates the dynamic and kinematic trees, mirroring upstream
## b2ValidateBroadphase.
Sub Validate()
Me.Trees[Integer(BodyType.DynamicBody)].Validate()
Me.Trees[Integer(BodyType.KinematicBody)].Validate()
End Sub

## Returns the broad phase to a freshly created state, retaining every list
## and tree capacity so a warmed world rebuilds without allocation. Used by
## World.Clear.
Sub Clear()
For i As Integer = 0 To 2
Me.Trees[i].Destroy()
Next i
Me.MoveSet.Clear()
Me.MoveArray.Clear()
Me.PairSet.Clear()
Me.mPairShapeIndexA.Clear()
Me.mPairShapeIndexB.Clear()
Me.mPairNext.Clear()
Me.mPairCount = 0
Me.PairCount = 0
Me.mResultHeads.Clear()
End Sub

## Checks that no node in any tree carries the enlarged flag, mirroring
## upstream b2ValidateNoEnlarged. Only meaningful after a full rebuild of
## every tree.
Sub ValidateNoEnlarged()
For j As Integer = 0 To 2
Me.Trees[j].ValidateNoEnlarged()
Next j
End Sub
End Class

# Client sink receiving candidate shape pairs from the broad phase, the
# Physics2D counterpart of the pair callback and contact-creation halves of
# upstream b2PairQueryCallback and b2UpdateBroadPhasePairs.
#
# The world (Stage 6) implements this to run its collision filters and
# create contacts. ShouldCollide is called while pairs are discovered, so
# rejected candidates never enter the pair buffer; AcceptPair is called
# afterwards in deterministic move order.
Abstract Class BroadPhasePairSink
## Returns True when the two shapes may collide, mirroring the shape and
## body filter checks upstream b2PairQueryCallback runs at record time.
Abstract Function ShouldCollide(shapeIndexA As Integer, shapeIndexB As Integer) As Boolean

## Receives one candidate pair after discovery completes, in deterministic
## move-buffer order, mirroring the contact creation loop of upstream
## b2UpdateBroadPhasePairs.
Abstract Sub AcceptPair(shapeIndexA As Integer, shapeIndexB As Integer)
End Class

# Engine-internal tree query callback that gathers candidate pairs for one
# moved proxy, ported from upstream b2PairQueryCallback and
# b2QueryPairContext. One instance is owned by the BroadPhase and reused for
# every moved proxy. Not part of the public engine surface.
Class BroadPhaseQueryContext Inherits TreeQueryCallback

## The broad phase that owns this context.
Property Owner As BroadPhase
## The pair sink that filters and receives pairs.
Property Sink As BroadPhasePairSink
## Tree currently being queried: 0 static, 1 kinematic, 2 dynamic.
Property QueryTreeType As Integer
## Proxy key of the moved proxy driving this query.
Property QueryProxyKey As Integer
## Shape index carried by the moved proxy.
Property QueryShapeIndex As Integer
## Move-buffer slot whose result list receives discovered pairs.
Property ResultSlot As Integer

## Creates an unbound context.
Constructor()
Me.Owner = Nothing
Me.Sink = Nothing
Me.QueryTreeType = 0
Me.QueryProxyKey = 0
Me.QueryShapeIndex = 0
Me.ResultSlot = 0
End Constructor

## Tree query callback: de-duplicates, applies the sink filter, and records
## surviving pairs. Always returns True to continue traversal.
Function VisitLeaf(proxyId As Integer, userData As Integer) As Boolean
Var owner As BroadPhase = Me.Owner

Var shapeId As Integer = userData
Var proxyKey As Integer = BroadPhase.MakeProxyKey(proxyId, Me.QueryTreeType)
Var queryProxyKey As Integer = Me.QueryProxyKey

# A proxy cannot form a pair with itself.
If proxyKey = queryProxyKey Then
Return True
End If

Var treeType As Integer = Me.QueryTreeType
Var queryProxyType As Integer = BroadPhase.ProxyType(queryProxyKey)

# De-duplication: prevent duplicate pairs when both proxies are moving.
If queryProxyType = Integer(BodyType.DynamicBody) Then
If treeType = Integer(BodyType.DynamicBody) And proxyKey < queryProxyKey Then
If owner.MoveSet.Contains(proxyKey + 1) Then
# Both proxies are moving. Avoid duplicate pairs.
Return True
End If
End If
Else
# Kinematic and static proxies only ever query the dynamic tree.
If treeType <> Integer(BodyType.DynamicBody) Then
Throw New RuntimeException("BroadPhase pair query tree type mismatch")
End If
If owner.MoveSet.Contains(proxyKey + 1) Then
# Both proxies are moving. Avoid duplicate pairs.
Return True
End If
End If

Var pairKey As Integer = PairKeySet.PairKey(shapeId, Me.QueryShapeIndex)
If owner.PairSet.Contains(pairKey) Then
# Contact already exists.
Return True
End If

Var shapeIdA As Integer = shapeId
Var shapeIdB As Integer = Me.QueryShapeIndex
If proxyKey >= queryProxyKey Then
shapeIdA = Me.QueryShapeIndex
shapeIdB = shapeId
End If

If Me.Sink.ShouldCollide(shapeIdA, shapeIdB) = False Then
Return True
End If

owner.RecordPair(shapeIdA, shapeIdB, Me.ResultSlot)

# Continue the query.
Return True
End Function
End Class

# A solid capsule: two semicircles connected by a rectangle, ported from
# upstream b2Capsule in collision.h.
#
# Constructors validate their input and copy vector arguments. A capsule with
# coincident endpoints behaves as a circle in every algorithm, matching
# upstream.
Class Capsule
## Local centre of the first semicircle.
Property Center1 As Vector2
## Local centre of the second semicircle.
Property Center2 As Vector2
## The radius of the semicircles.
Property Radius As Double

## Creates a capsule from two endpoints and a radius. The endpoints are
## copied. Throws InvalidArgumentException when an endpoint or the radius is
## not finite or the radius is negative.
Constructor(center1 As Vector2, center2 As Vector2, radius As Double)
If Not center1.X.IsFinite() Or Not center1.Y.IsFinite() Then
Throw New InvalidArgumentException("Capsule first centre must be finite")
End If
If Not center2.X.IsFinite() Or Not center2.Y.IsFinite() Then
Throw New InvalidArgumentException("Capsule second centre must be finite")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Capsule radius must be finite and non-negative")
End If
Me.Center1 = New Vector2(center1.X, center1.Y)
Me.Center2 = New Vector2(center2.X, center2.Y)
Me.Radius = radius
End Constructor

## Copies another capsule.
Constructor(other As Capsule)
Me.Center1 = New Vector2(other.Center1.X, other.Center1.Y)
Me.Center2 = New Vector2(other.Center2.X, other.Center2.Y)
Me.Radius = other.Radius
End Constructor
## Computes the mass data of the capsule, ported from upstream
## b2ComputeCapsuleMass. Inertia is about the local origin.
Function ComputeMass(density As Double) As MassData
Var data As New MassData
Return Me.ComputeMassTo(density, data)
End Function

## Caller-owned output form of ComputeMass for warm paths.
Function ComputeMassTo(density As Double, out As MassData) As MassData
Var radius As Double = Me.Radius
Var rr As Double = radius * radius
Var p1x As Double = Me.Center1.X
Var p1y As Double = Me.Center1.Y
Var p2x As Double = Me.Center2.X
Var p2y As Double = Me.Center2.Y
Var ex As Double = p2x - p1x
Var ey As Double = p2y - p1y
Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
Var ll As Double = length * length

Var circleMass As Double = density * (PhysicsConstants.PI * radius * radius)
Var boxMass As Double = density * (2.0 * radius * length)

out.Mass = circleMass + boxMass
out.Center.Set(0.5 * (p1x + p2x), 0.5 * (p1y + p2y))

# Two offset half circles, both halves add up to a full circle and each
# half is offset by half length. Apply the parallel-axis theorem twice.
# Half circle centroid: lc = 4r / 3pi.
Var lc As Double = 4.0 * radius / (3.0 * PhysicsConstants.PI)

# Half length of the rectangular portion of the capsule.
Var h As Double = 0.5 * length

Var circleInertia As Double = circleMass * (0.5 * rr + h * h + 2.0 * h * lc)
Var boxInertia As Double = boxMass * (4.0 * rr + ll) / 12.0
out.RotationalInertia = circleInertia + boxInertia

# Inertia about the local origin.
Var cc As Double = out.Center.X * out.Center.X + out.Center.Y * out.Center.Y
out.RotationalInertia = out.RotationalInertia + out.Mass * cc

Return out
End Function

## Computes the world-space AABB of the transformed capsule, ported from
## upstream b2ComputeCapsuleAABB.
Function ComputeAABB(transform As Transform) As AABB
Return Me.ComputeAABBTo(transform, New AABB)
End Function

## Caller-owned output form of ComputeAABB for warm paths.
Function ComputeAABBTo(transform As Transform, out As AABB) As AABB
Var v1x As Double = transform.Q.C * Me.Center1.X - transform.Q.S * Me.Center1.Y + transform.P.X
Var v1y As Double = transform.Q.S * Me.Center1.X + transform.Q.C * Me.Center1.Y + transform.P.Y
Var v2x As Double = transform.Q.C * Me.Center2.X - transform.Q.S * Me.Center2.Y + transform.P.X
Var v2y As Double = transform.Q.S * Me.Center2.X + transform.Q.C * Me.Center2.Y + transform.P.Y
out.LowerBound.Set(Maths.Min(v1x, v2x) - Me.Radius, Maths.Min(v1y, v2y) - Me.Radius)
out.UpperBound.Set(Maths.Max(v1x, v2x) + Me.Radius, Maths.Max(v1y, v2y) + Me.Radius)
Return out
End Function

## Determines whether the point lies within the capsule, ported from
## upstream b2PointInCapsule.
Function ContainsPoint(point As Vector2) As Boolean
Var rr As Double = Me.Radius * Me.Radius
Var p1x As Double = Me.Center1.X
Var p1y As Double = Me.Center1.Y
Var p2x As Double = Me.Center2.X
Var p2y As Double = Me.Center2.Y
Var dx As Double = p2x - p1x
Var dy As Double = p2y - p1y
Var dd As Double = dx * dx + dy * dy
If dd = 0.0 Then
# Capsule is really a circle.
Var cdx As Double = point.X - p1x
Var cdy As Double = point.Y - p1y
Return cdx * cdx + cdy * cdy <= rr
End If

# Closest point on the capsule segment: c = p1 + t * d.
Var t As Double = ((point.X - p1x) * dx + (point.Y - p1y) * dy) / dd
If t < 0.0 Then
t = 0.0
End If
If t > 1.0 Then
t = 1.0
End If
Var cx As Double = p1x + t * dx
Var cy As Double = p1y + t * dy
Var cdx As Double = point.X - cx
Var cdy As Double = point.Y - cy
Return cdx * cdx + cdy * cdy <= rr
End Function
End Class

# Low level ray cast or shape cast output, ported from upstream b2CastOutput
# in collision.h. A miss leaves fraction zero, normal and point zero, and hit
# False. Initial overlap returns a zero fraction with the hit point set.
#
# Collision functions write into existing output objects (the To-forms), so a
# warm loop can reuse one output and allocate nothing. All fields are
# overwritten on every cast, so reuse never observes stale results.
Class CastOutput
## The surface normal at the hit point. Zero on a miss.
Property Normal As Vector2
## The surface hit point. Zero on a miss.
Property Point As Vector2
## The fraction of the input translation at collision. Zero on a miss.
Property Fraction As Double
## The number of iterations used. Zero on a miss.
Property Iterations As Integer
## Did the cast hit?
Property Hit As Boolean

## Internal reusable workspace for the warm shape-cast path.
Private Property mScratch As CastScratch

## Creates a miss output at the origin.
Constructor()
Me.Normal = New Vector2(0.0, 0.0)
Me.Point = New Vector2(0.0, 0.0)
Me.Fraction = 0.0
Me.Iterations = 0
Me.Hit = False
Me.mScratch = Nothing
End Constructor

## Returns the internal workspace, creating it on first use. Engine code
## only; creating the workspace once per output keeps warm casts
## allocation-free.
Function Scratch() As CastScratch
If Me.mScratch = Nothing Then
Me.mScratch = New CastScratch
End If
Return Me.mScratch
End Function

## Resets every field to the miss state in place and returns this output.
Function Reset() As CastOutput
Me.Normal.Set(0.0, 0.0)
Me.Point.Set(0.0, 0.0)
Me.Fraction = 0.0
Me.Iterations = 0
Me.Hit = False
Return Me
End Function

## Copies another output's fields in place and returns this output.
Function SetFrom(other As CastOutput) As CastOutput
Me.Normal.Set(other.Normal.X, other.Normal.Y)
Me.Point.Set(other.Point.X, other.Point.Y)
Me.Fraction = other.Fraction
Me.Iterations = other.Iterations
Me.Hit = other.Hit
Return Me
End Function
End Class

# Engine-internal reusable workspace for the warm shape-cast path. Owned by
# a CastOutput and created lazily so repeated casts allocate nothing. Not
# part of the public engine surface.
Class CastScratch
## Distance input prepared from the pair cast input. Its proxies alias the
## cast input's proxies; its transforms alias the cast input's transform A
## and the scratch transform B.
Property DistanceInput As DistanceInput
## Distance output reused across cast iterations.
Property DistanceOutput As DistanceOutput
## Warm start cache reused across casts and iterations.
Property Cache As SimplexCache
## Transform B moved to the current cast fraction. Mutated per iteration.
Property MovedTransformB As Transform

## Creates the workspace with empty storage.
Constructor()
Me.DistanceInput = New DistanceInput
Me.DistanceOutput = New DistanceOutput
Me.Cache = New SimplexCache
Me.MovedTransformB = New Transform
End Constructor
End Class

# Ray casts and shape casts, ported from upstream geometry.c ray cast
# functions and distance.c b2ShapeCast.
#
# Every function has a cold form that returns a new CastOutput and a warm
# To-form that fills the caller-owned output and returns it. The To-forms
# keep all arithmetic scalar so steady-state casting allocates nothing; the
# GJK shape cast reuses simplex and distance workspaces attached to the
# output.
#
# Upstream validates ray inputs with debug-only asserts. Physics2D release
# behaviour matches: cast inputs are assumed valid; use
# RayCastInput.IsValid to check inputs when needed.
Class Casts
## Casts a ray against a circle into a new output, ported from upstream
## b2RayCastCircle.
Shared Function RayCastCircle(input As RayCastInput, shape As Circle) As CastOutput
Var out As New CastOutput
Casts.RayCastCircleCoreTo(input, shape.Center.X, shape.Center.Y, shape.Radius, out)
Return out
End Function

## Casts a ray against a circle into the caller-owned out output and returns
## out. The reused-output form for warm loops.
Shared Function RayCastCircleTo(input As RayCastInput, shape As Circle, out As CastOutput) As CastOutput
Return Casts.RayCastCircleCoreTo(input, shape.Center.X, shape.Center.Y, shape.Radius, out)
End Function

## Scalar core of the circle ray cast so capsules can fall back without
## building a temporary circle, mirroring upstream.
Shared Function RayCastCircleCoreTo(input As RayCastInput, centerX As Double, centerY As Double, radius As Double, out As CastOutput) As CastOutput
out.Reset()

Var sx As Double = input.Origin.X - centerX
Var sy As Double = input.Origin.Y - centerY
Var rr As Double = radius * radius

Var tx As Double = input.Translation.X
Var ty As Double = input.Translation.Y
Var length As Double = Maths.Sqrt(tx * tx + ty * ty)
Var dx As Double = 0.0
Var dy As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
dx = invLength * tx
dy = invLength * ty
End If

If length = 0.0 Then
# Zero length ray.
If sx * sx + sy * sy < rr Then
# Initial overlap.
out.Point.Set(input.Origin.X, input.Origin.Y)
out.Hit = True
End If
Return out
End If

# Find the closest point on the ray to the circle centre.

# Solve: dot(s + t * d, d) = 0.
Var t As Double = -(sx * dx + sy * dy)

# c is the closest point on the line to the origin.
Var cx As Double = sx + t * dx
Var cy As Double = sy + t * dy

Var cc As Double = cx * cx + cy * cy

If cc > rr Then
# Closest point is outside the circle.
Return out
End If

# Pythagoras.
Var h As Double = Maths.Sqrt(rr - cc)

Var fraction As Double = t - h

If fraction < 0.0 Or input.MaxFraction * length < fraction Then
# The intersection point is outside the range of the ray segment.
If sx * sx + sy * sy < rr Then
# Initial overlap.
out.Point.Set(input.Origin.X, input.Origin.Y)
out.Hit = True
End If
Return out
End If

# Hit point relative to the centre.
Var hx As Double = sx + fraction * dx
Var hy As Double = sy + fraction * dy

Var invNormalLength As Double = 0.0
Var normalLength As Double = Maths.Sqrt(hx * hx + hy * hy)
If normalLength > 0.0 Then
invNormalLength = 1.0 / normalLength
End If
Var nx As Double = hx * invNormalLength
Var ny As Double = hy * invNormalLength

out.Fraction = fraction / length
out.Normal.Set(nx, ny)
out.Point.Set(centerX + radius * nx, centerY + radius * ny)
out.Hit = True
Return out
End Function

## Casts a ray against a capsule into a new output, ported from upstream
## b2RayCastCapsule.
Shared Function RayCastCapsule(input As RayCastInput, shape As Capsule) As CastOutput
Var out As New CastOutput
Casts.RayCastCapsuleTo(input, shape, out)
Return out
End Function

## Casts a ray against a capsule into the caller-owned out output and returns
## out. The reused-output form for warm loops.
Shared Function RayCastCapsuleTo(input As RayCastInput, shape As Capsule, out As CastOutput) As CastOutput
out.Reset()

Var v1x As Double = shape.Center1.X
Var v1y As Double = shape.Center1.Y
Var v2x As Double = shape.Center2.X
Var v2y As Double = shape.Center2.Y
Var ex As Double = v2x - v1x
Var ey As Double = v2y - v1y

Var capsuleLength As Double = Maths.Sqrt(ex * ex + ey * ey)
Var ax As Double = 0.0
Var ay As Double = 0.0
If capsuleLength > PhysicsConstants.FLT_EPSILON Then
Var invCapsuleLength As Double = 1.0 / capsuleLength
ax = invCapsuleLength * ex
ay = invCapsuleLength * ey
End If

If capsuleLength < PhysicsConstants.FLT_EPSILON Then
# Capsule is really a circle.
Return Casts.RayCastCircleCoreTo(input, v1x, v1y, shape.Radius, out)
End If

Var p1x As Double = input.Origin.X
Var p1y As Double = input.Origin.Y
Var dx As Double = input.Translation.X
Var dy As Double = input.Translation.Y

# Ray from capsule start to ray start.
Var qx As Double = p1x - v1x
Var qy As Double = p1y - v1y
Var qa As Double = qx * ax + qy * ay

# Vector to ray start that is perpendicular to the capsule axis.
Var qpx As Double = qx - qa * ax
Var qpy As Double = qy - qa * ay

Var radius As Double = shape.Radius

# Does the ray start within the infinite length capsule?
If qpx * qpx + qpy * qpy < radius * radius Then
If qa < 0.0 Then
# Start point behind the capsule segment.
Return Casts.RayCastCircleCoreTo(input, v1x, v1y, radius, out)
End If

If qa > capsuleLength Then
# Start point ahead of the capsule segment.
Return Casts.RayCastCircleCoreTo(input, v2x, v2y, radius, out)
End If

# The ray starts inside the capsule: no hit.
out.Point.Set(p1x, p1y)
out.Hit = True
Return out
End If

# Perpendicular to the capsule axis, pointing right.
Var nx As Double = ay
Var ny As Double = -ax

Var rayLength As Double = Maths.Sqrt(dx * dx + dy * dy)
Var ux As Double = 0.0
Var uy As Double = 0.0
If rayLength > PhysicsConstants.FLT_EPSILON Then
Var invRayLength As Double = 1.0 / rayLength
ux = invRayLength * dx
uy = invRayLength * dy
End If

# Intersect the ray with the infinite length capsule.
# v1 + radius * n + s1 * a = p1 + s2 * u
# s1 * a - s2 * u = b, where b = q - radius * n or b = q + radius * n.

# Cramer's rule [a -u].
Var den As Double = -ax * uy + ux * ay
If -PhysicsConstants.FLT_EPSILON < den And den < PhysicsConstants.FLT_EPSILON Then
# The ray is parallel to the capsule and outside the infinite capsule.
Return out
End If

Var b1x As Double = qx - radius * nx
Var b1y As Double = qy - radius * ny
Var b2x As Double = qx + radius * nx
Var b2y As Double = qy + radius * ny

Var invDen As Double = 1.0 / den

# Cramer's rule [a b1].
Var s21 As Double = (ax * b1y - b1x * ay) * invDen

# Cramer's rule [a b2].
Var s22 As Double = (ax * b2y - b2x * ay) * invDen

Var s2 As Double = 0.0
Var bx As Double = 0.0
Var by As Double = 0.0
If s21 < s22 Then
s2 = s21
bx = b1x
by = b1y
Else
s2 = s22
bx = b2x
by = b2y
nx = -nx
ny = -ny
End If

If s2 < 0.0 Or input.MaxFraction * rayLength < s2 Then
Return out
End If

# Cramer's rule [b -u].
Var s1 As Double = (-bx * uy + ux * by) * invDen

If s1 < 0.0 Then
# The ray passes behind the capsule segment.
Return Casts.RayCastCircleCoreTo(input, v1x, v1y, radius, out)
ElseIf capsuleLength < s1 Then
# The ray passes ahead of the capsule segment.
Return Casts.RayCastCircleCoreTo(input, v2x, v2y, radius, out)
Else
# The ray hits the capsule side.
out.Fraction = s2 / rayLength
Var lerpT As Double = s1 / capsuleLength
Var px As Double = v1x + lerpT * (v2x - v1x) + radius * nx
Var py As Double = v1y + lerpT * (v2y - v1y) + radius * ny
out.Point.Set(px, py)
out.Normal.Set(nx, ny)
out.Hit = True
Return out
End If
End Function

## Casts a ray against a line segment into a new output, ported from
## upstream b2RayCastSegment. A one-sided segment skips collisions from the
## left side.
Shared Function RayCastSegment(input As RayCastInput, shape As Segment, oneSided As Boolean) As CastOutput
Var out As New CastOutput
Casts.RayCastSegmentTo(input, shape, oneSided, out)
Return out
End Function

## Casts a ray against a line segment into the caller-owned out output and
## returns out. The reused-output form for warm loops.
Shared Function RayCastSegmentTo(input As RayCastInput, shape As Segment, oneSided As Boolean, out As CastOutput) As CastOutput
out.Reset()

Var v1x As Double = shape.Point1.X
Var v1y As Double = shape.Point1.Y
Var v2x As Double = shape.Point2.X
Var v2y As Double = shape.Point2.Y
Var p1x As Double = input.Origin.X
Var p1y As Double = input.Origin.Y
Var dx As Double = input.Translation.X
Var dy As Double = input.Translation.Y

If oneSided Then
# Skip left-side collision: cross(origin - point1, point2 - point1).
Var offset As Double = (p1x - v1x) * (v2y - v1y) - (p1y - v1y) * (v2x - v1x)
If offset < 0.0 Then
Return out
End If
End If

Var ex As Double = v2x - v1x
Var ey As Double = v2y - v1y

Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
Var eUnitX As Double = 0.0
Var eUnitY As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
eUnitX = invLength * ex
eUnitY = invLength * ey
End If
If length = 0.0 Then
Return out
End If

# Normal points to the right, looking from v1 towards v2.
Var nx As Double = eUnitY
Var ny As Double = -eUnitX

# Intersect the ray with the infinite segment using the normal, similar to
# intersecting a ray with an infinite plane.
# p = p1 + t * d
# dot(normal, p - v1) = 0
# dot(normal, p1 - v1) + t * dot(normal, d) = 0
Var numerator As Double = nx * (v1x - p1x) + ny * (v1y - p1y)
Var denominator As Double = nx * dx + ny * dy

If denominator = 0.0 Then
# Parallel.
Return out
End If

Var t As Double = numerator / denominator
If t < 0.0 Or input.MaxFraction < t Then
# Out of ray range.
Return out
End If

# Intersection point on the infinite segment.
Var px As Double = p1x + t * dx
Var py As Double = p1y + t * dy

# Compute the position of p along the segment.
# p = v1 + s * e
Var s As Double = (px - v1x) * eUnitX + (py - v1y) * eUnitY
If s < 0.0 Or length < s Then
# Out of segment range.
Return out
End If

If numerator > 0.0 Then
nx = -nx
ny = -ny
End If

out.Fraction = t
out.Point.Set(px, py)
out.Normal.Set(nx, ny)
out.Hit = True
Return out
End Function

## Casts a ray against a convex polygon into a new output, ported from
## upstream b2RayCastPolygon.
Shared Function RayCastPolygon(input As RayCastInput, shape As Polygon) As CastOutput
Var out As New CastOutput
Casts.RayCastPolygonTo(input, shape, out)
Return out
End Function

## Casts a ray against a convex polygon into the caller-owned out output and
## returns out. The reused-output form for warm loops.
Shared Function RayCastPolygonTo(input As RayCastInput, shape As Polygon, out As CastOutput) As CastOutput
out.Reset()

If shape.Radius = 0.0 Then
# Shift all math to the first vertex since the polygon may be far from
# the origin.
Var baseX As Double = shape.Vertices[0].X
Var baseY As Double = shape.Vertices[0].Y
Var p1x As Double = input.Origin.X - baseX
Var p1y As Double = input.Origin.Y - baseY
Var dx As Double = input.Translation.X
Var dy As Double = input.Translation.Y

Var lower As Double = 0.0
Var upper As Double = input.MaxFraction
Var index As Integer = -1

For i As Integer = 0 To shape.Count - 1
# p = p1 + a * d
# dot(normal, p - v) = 0
# dot(normal, p1 - v) + a * dot(normal, d) = 0
Var vertexX As Double = shape.Vertices[i].X - baseX
Var vertexY As Double = shape.Vertices[i].Y - baseY
Var nrmX As Double = shape.Normals[i].X
Var nrmY As Double = shape.Normals[i].Y
Var numerator As Double = nrmX * (vertexX - p1x) + nrmY * (vertexY - p1y)
Var denominator As Double = nrmX * dx + nrmY * dy

If denominator = 0.0 Then
If numerator < 0.0 Then
Return out
End If
Else
# Note: we want the predicate without division:
# lower < numerator / denominator, where denominator < 0. Since
# denominator < 0, flip the inequality:
# lower < numerator / denominator <==> denominator * lower > numerator.
If denominator < 0.0 And numerator < lower * denominator Then
# Increase lower: the segment enters this half-space.
lower = numerator / denominator
index = i
ElseIf denominator > 0.0 And numerator < upper * denominator Then
# Decrease upper: the segment exits this half-space.
upper = numerator / denominator
End If
End If

If upper < lower Then
# The ray misses.
Return out
End If
Next i

If index >= 0 Then
out.Fraction = lower
out.Normal.Set(shape.Normals[index].X, shape.Normals[index].Y)
out.Point.Set(input.Origin.X + lower * dx, input.Origin.Y + lower * dy)
out.Hit = True
Else
# Initial overlap.
out.Point.Set(input.Origin.X, input.Origin.Y)
out.Hit = True
End If

Return out
End If

# A rounded polygon needs the GJK shape cast.
Var originList As New Array(Of Vector2)
originList.Append(input.Origin)
Var pairInput As New ShapeCastPairInput
pairInput.ProxyA = ShapeProxy.MakeImpl(shape.Vertices, shape.Count, shape.Radius, 0.0, 0.0, 1.0, 0.0)
pairInput.ProxyB = ShapeProxy.Make(originList, 1, 0.0)
pairInput.TranslationB.Set(input.Translation.X, input.Translation.Y)
pairInput.MaxFraction = input.MaxFraction
Return Casts.ShapeCast(pairInput)
End Function

## Casts shape B along its translation against shape A into a new output,
## ported from upstream b2ShapeCast. Initial overlap is treated as a hit
## with a zero fraction unless encroachment is allowed.
Shared Function ShapeCast(input As ShapeCastPairInput) As CastOutput
Var out As New CastOutput
Casts.ShapeCastTo(input, out)
Return out
End Function

## Casts shape B along its translation against shape A into the caller-owned
## out output and returns out. The reused-output form for warm loops: the
## distance workspaces live on the output's scratch, so steady-state
## casting allocates nothing.
Shared Function ShapeCastTo(input As ShapeCastPairInput, out As CastOutput) As CastOutput
# Compute tolerance.
Var linearSlop As Double = PhysicsConstants.LINEAR_SLOP
Var totalRadius As Double = input.ProxyA.Radius + input.ProxyB.Radius
Var target As Double = linearSlop
If totalRadius - linearSlop > target Then
target = totalRadius - linearSlop
End If
Var tolerance As Double = 0.25 * linearSlop

# Prepare the reusable distance query.
Var scratch As CastScratch = out.Scratch()
Var distanceInput As DistanceInput = scratch.DistanceInput
distanceInput.ProxyA = input.ProxyA
distanceInput.ProxyB = input.ProxyB
distanceInput.TransformA = input.TransformA
distanceInput.TransformB = scratch.MovedTransformB
distanceInput.UseRadii = False
scratch.MovedTransformB.P.Set(input.TransformB.P.X, input.TransformB.P.Y)
scratch.MovedTransformB.Q.SetComponents(input.TransformB.Q.C, input.TransformB.Q.S)

Var cache As SimplexCache = scratch.Cache
cache.Clear()

Var delta2X As Double = input.TranslationB.X
Var delta2Y As Double = input.TranslationB.Y

out.Reset()

Var fraction As Double = 0.0
Var maxIterations As Integer = 20
Var iteration As Integer = 0
While iteration < maxIterations
out.Iterations = out.Iterations + 1

Var distanceOutput As DistanceOutput = scratch.DistanceOutput
Distance.ShapeDistanceTo(distanceInput, cache, distanceOutput)

If distanceOutput.Distance < target + tolerance Then
If iteration = 0 Then
If input.CanEncroach And distanceOutput.Distance > 2.0 * linearSlop Then
# Allow shapes with a radius to move slightly closer.
target = distanceOutput.Distance - linearSlop
Else
# Initial overlap. Compute a common point.
Var ra As Double = input.ProxyA.Radius
Var rb As Double = input.ProxyB.Radius
Var c1x As Double = distanceOutput.PointA.X + ra * distanceOutput.Normal.X
Var c1y As Double = distanceOutput.PointA.Y + ra * distanceOutput.Normal.Y
Var c2x As Double = distanceOutput.PointB.X - rb * distanceOutput.Normal.X
Var c2y As Double = distanceOutput.PointB.Y - rb * distanceOutput.Normal.Y
out.Point.Set(0.5 * (c1x + c2x), 0.5 * (c1y + c2y))
out.Hit = True
Return out
End If
Else
# Regular hit.
out.Fraction = fraction
Var px As Double = distanceOutput.PointA.X + input.ProxyA.Radius * distanceOutput.Normal.X
Var py As Double = distanceOutput.PointA.Y + input.ProxyA.Radius * distanceOutput.Normal.Y
out.Point.Set(px, py)
out.Normal.Set(distanceOutput.Normal.X, distanceOutput.Normal.Y)
out.Hit = True
Return out
End If
End If

# Check if the shapes are approaching each other.
Var denominator As Double = delta2X * distanceOutput.Normal.X + delta2Y * distanceOutput.Normal.Y
If denominator >= 0.0 Then
# Miss.
Return out
End If

# Advance the sweep.
fraction = fraction + (target - distanceOutput.Distance) / denominator
If fraction >= input.MaxFraction Then
# Miss.
Return out
End If

scratch.MovedTransformB.P.Set(input.TransformB.P.X + fraction * delta2X, input.TransformB.P.Y + fraction * delta2Y)
iteration = iteration + 1
Wend

# Failure.
Return out
End Function

## Shape casts a circle shape, ported from upstream b2ShapeCastCircle.
Shared Function ShapeCastCircle(input As ShapeCastInput, shape As Circle) As CastOutput
Return Casts.ShapeCastViaProxy(input, shape.Center.X, shape.Center.Y, 1, shape.Radius)
End Function

## Shape casts a capsule shape, ported from upstream b2ShapeCastCapsule.
Shared Function ShapeCastCapsule(input As ShapeCastInput, shape As Capsule) As CastOutput
Var points As New Array(Of Vector2)
points.Append(shape.Center1)
points.Append(shape.Center2)
Return Casts.ShapeCastViaProxyPoints(input, points, 2, shape.Radius)
End Function

## Shape casts a line segment, ported from upstream b2ShapeCastSegment.
Shared Function ShapeCastSegment(input As ShapeCastInput, shape As Segment) As CastOutput
Var points As New Array(Of Vector2)
points.Append(shape.Point1)
points.Append(shape.Point2)
Return Casts.ShapeCastViaProxyPoints(input, points, 2, 0.0)
End Function

## Shape casts a convex polygon, ported from upstream b2ShapeCastPolygon.
Shared Function ShapeCastPolygon(input As ShapeCastInput, shape As Polygon) As CastOutput
Return Casts.ShapeCastViaProxyPoints(input, shape.Vertices, shape.Count, shape.Radius)
End Function

## Builds a one-point proxy for the shape and delegates to the pair cast.
Shared Function ShapeCastViaProxy(input As ShapeCastInput, x As Double, y As Double, count As Integer, radius As Double) As CastOutput
Var points As New Array(Of Vector2)
points.Append(New Vector2(x, y))
Return Casts.ShapeCastViaProxyPoints(input, points, count, radius)
End Function

## Builds a proxy from the given point cloud and delegates to the pair
## cast. Cold path: allocates the pair input per call.
Shared Function ShapeCastViaProxyPoints(input As ShapeCastInput, points() As Vector2, count As Integer, radius As Double) As CastOutput
Var pairInput As New ShapeCastPairInput
pairInput.ProxyA = ShapeProxy.Make(points, count, radius)
pairInput.ProxyB = input.Proxy
pairInput.TranslationB.Set(input.Translation.X, input.Translation.Y)
pairInput.MaxFraction = input.MaxFraction
pairInput.CanEncroach = input.CanEncroach
Return Casts.ShapeCast(pairInput)
End Function
End Class

# Chain façade, ported from upstream b2ChainShape in shape.h plus the
# b2Chain_* API family in box2d.h. A chain owns its segment shapes: creating
# a chain creates one chain-segment shape per solid segment, and destroying
# the chain destroys those shapes. Materials are stored per point the same
# way upstream stores the material array.
#
# Creation goes through World.CreateChain; destruction through Chain.Destroy
# or the owning body/world cascade.
Class Chain
## Owning world. Set at creation and never changed.
Property Owner As World
## Slot index of this chain in the world chain store.
Property Id As Integer
## Generation counter, incremented when the slot is freed and reused.
Property Generation As Integer
## Whether this chain is live. Stale façades keep the object but flip this.
Property Live As Boolean
## Slot index of the owning body.
Property BodyId As Integer
## Previous chain in the body's doubly linked chain list.
Property PrevChainId As Integer
## Next chain in the body's doubly linked chain list.
Property NextChainId As Integer
## Number of solid segments, one per stored shape index.
Property SegmentCount As Integer
## Number of materials: one for the whole chain or one per point.
Property MaterialCount As Integer
## Surface materials, copied at creation.
Property Materials As Array(Of SurfaceMaterial)
## Slot index of the segment shape for each solid segment, in order.
Property ShapeIndices As IntegerList
## Whether the chain wraps back to the first point.
Property IsLoop As Boolean
## Collision filter copied to every segment shape.
Property Filter As Filter
## User data copied by reference to every segment shape. Never read by
## the solver.
Property UserData As Object

## Creates an empty, unbound chain. Only the world may construct live
## chains; the zero-argument form exists for sparse array capacity.
Constructor()
Me.Owner = Nothing
Me.Id = PhysicsConstants.NULL_INDEX
Me.Generation = PhysicsConstants.INVALID_GENERATION
Me.Live = False
Me.BodyId = PhysicsConstants.NULL_INDEX
Me.PrevChainId = PhysicsConstants.NULL_INDEX
Me.NextChainId = PhysicsConstants.NULL_INDEX
Me.SegmentCount = 0
Me.MaterialCount = 0
Me.Materials = New Array(Of SurfaceMaterial)
Me.ShapeIndices = New IntegerList(16)
Me.IsLoop = False
Me.Filter = New Filter()
Me.UserData = Nothing
End Constructor

## Returns True when this façade still addresses a live chain.
Function IsValid() As Boolean
If Me.Owner = Nothing Or Not Me.Live Then
Return False
End If
Return Me.Owner.Chains[Me.Id] = Me
End Function

## Throws a descriptive exception when this façade is stale.
Sub Validate()
If Not Me.IsValid() Then
Throw New RuntimeException("Chain façade is no longer valid")
End If
End Sub

## Returns the owning world façade.
Function GetWorld() As World
Me.Validate()
Return Me.Owner
End Function

## Returns the owning body façade.
Function GetBody() As Body
Me.Validate()
Return Me.Owner.Bodies[Me.BodyId]
End Function

## The number of solid segments.
Function GetSegmentCount() As Integer
Me.Validate()
Return Me.SegmentCount
End Function

## Returns the segment shape façades in a fresh array. Allocating
## convenience for cold paths.
Function GetSegments() As Array(Of Shape)
Me.Validate()
Var results As New Array(Of Shape)
For i As Integer = 0 To Me.SegmentCount - 1
results.Append(Me.Owner.Shapes[Me.ShapeIndices.Items[i]])
Next i
Return results
End Function

## The chain friction.
Function GetFriction() As Double
Me.Validate()
Return Me.Materials[0].Friction
End Function

## Sets the friction of every material in the chain and its segment shapes,
## ported from b2Chain_SetFriction.
Sub SetFriction(friction As Double)
Me.Validate()
For i As Integer = 0 To Me.MaterialCount - 1
Me.Materials[i].Friction = friction
Next i
For j As Integer = 0 To Me.SegmentCount - 1
Me.Owner.Shapes[Me.ShapeIndices.Items[j]].Friction = friction
Next j
End Sub

## The chain restitution.
Function GetRestitution() As Double
Me.Validate()
Return Me.Materials[0].Restitution
End Function

## Sets the restitution of every material in the chain and its segment
## shapes, ported from b2Chain_SetRestitution.
Sub SetRestitution(restitution As Double)
Me.Validate()
For i As Integer = 0 To Me.MaterialCount - 1
Me.Materials[i].Restitution = restitution
Next i
For j As Integer = 0 To Me.SegmentCount - 1
Me.Owner.Shapes[Me.ShapeIndices.Items[j]].Restitution = restitution
Next j
End Sub

## The user material identifier of the first material, matching upstream
## b2Chain_GetMaterial which reads material zero.
Function GetMaterial() As Integer
Me.Validate()
Return Me.Materials[0].UserMaterialId
End Function

## Sets the user material identifier on every material and segment shape,
## ported from b2Chain_SetMaterial.
Sub SetMaterial(material As Integer)
Me.Validate()
For i As Integer = 0 To Me.MaterialCount - 1
Me.Materials[i].UserMaterialId = material
Next i
For j As Integer = 0 To Me.SegmentCount - 1
Me.Owner.Shapes[Me.ShapeIndices.Items[j]].UserMaterialId = material
Next j
End Sub

## Destroys the chain and every segment shape, ported from b2DestroyChain.
## Idempotent on already-destroyed façades.
Sub Destroy()
If Not Me.IsValid() Then
Return
End If
Me.Owner.DestroyChain(Me)
End Sub
End Class

# Chain definition passed to World.CreateChain, ported from upstream
# b2ChainDef in types.h. Upstream takes the body separately; Physics2D puts
# it on the definition so chains are created through the world like upstream.
Class ChainDefinition
## The body that owns the chain.
Property Body As Body
## Chain points in the body frame. At least four points are required,
## matching the upstream assertion.
Property Points As Array(Of Vector2)
## Whether the chain wraps back to the first point.
Property IsLoop As Boolean
## Surface materials. Either one material for the whole chain or exactly one
## material per point.
Property Materials As Array(Of SurfaceMaterial)
## Collision filter shared by every chain segment.
Property Filter As Filter
## User data copied by reference onto every chain segment shape. Never read by the solver.
Property UserData As Object
## Whether chain segments report sensor events.
Property EnableSensorEvents As Boolean

## Creates the default chain definition, matching upstream b2DefaultChainDef:
## one friction-0.6 material.
Constructor()
Me.Body = Nothing
Me.Points = New Array(Of Vector2)
Me.IsLoop = False
Me.Materials = New Array(Of SurfaceMaterial)
Me.Materials.Append(New SurfaceMaterial())
Me.Filter = New Filter()
Me.UserData = Nothing
Me.EnableSensorEvents = False
End Constructor
End Class

# Smoothness verdict for a contact normal against chain segment ghost
# geometry, ported from upstream b2NormalType in manifold.c.
Enum ChainNormalType
NormalSkip
NormalAdmit
NormalSnap
End Enum

# Engine-internal smoothing parameters for chain segment collisions, ported
# from upstream b2ChainSegmentParams in manifold.c. Owned by a
# CollideScratch and refilled per query.
Class ChainParams
## Unit vector along the chain segment.
Property Edge1 As Vector2
## Right perpendicular of the edge from ghost1 to point1.
Property Normal0 As Vector2
## Right perpendicular of the edge from point2 to ghost2.
Property Normal2 As Vector2
## Is the ghost1 vertex convex?
Property Convex1 As Boolean
## Is the ghost2 vertex convex?
Property Convex2 As Boolean
## True when the polygon centroid lies behind the core segment.
Property Behind1 As Boolean

## Creates zeroed parameters.
Constructor()
Me.Edge1 = New Vector2(0.0, 0.0)
Me.Normal0 = New Vector2(0.0, 0.0)
Me.Normal2 = New Vector2(0.0, 0.0)
Me.Convex1 = False
Me.Convex2 = False
Me.Behind1 = False
End Constructor
End Class

# One segment of a chain shape, ported from upstream b2ChainSegment in
# collision.h. The ghost points carry the neighbouring chain segments so
# collisions can smooth across convex and concave vertices.
Class ChainSegment
## The core segment.
Property Segment As Segment
## Ghost point preceding point1, normally the previous chain vertex.
Property Ghost1 As Vector2
## Ghost point following point2, normally the next chain vertex.
Property Ghost2 As Vector2
## Identifies the owning chain for shape identity. Upstream stores an
## int32; Physics2D uses an Integer. Negative means no chain identity.
Property ChainId As Integer

## Creates a chain segment with no ghosts and no chain identity.
Constructor()
Me.Segment = New Segment(New Vector2(0.0, 0.0), New Vector2(0.0, 0.0))
Me.Ghost1 = New Vector2(0.0, 0.0)
Me.Ghost2 = New Vector2(0.0, 0.0)
Me.ChainId = -1
End Constructor

## Creates a chain segment from its segment and ghost points.
Constructor(segment As Segment, ghost1 As Vector2, ghost2 As Vector2, chainId As Integer)
Me.Segment = New Segment(segment.Point1.X, segment.Point1.Y, segment.Point2.X, segment.Point2.Y)
Me.Ghost1 = New Vector2(ghost1.X, ghost1.Y)
Me.Ghost2 = New Vector2(ghost2.X, ghost2.Y)
Me.ChainId = chainId
End Constructor

## Copies another chain segment.
Constructor(other As ChainSegment)
Me.Segment = New Segment(other.Segment.Point1.X, other.Segment.Point1.Y, other.Segment.Point2.X, other.Segment.Point2.Y)
Me.Ghost1 = New Vector2(other.Ghost1.X, other.Ghost1.Y)
Me.Ghost2 = New Vector2(other.Ghost2.X, other.Ghost2.Y)
Me.ChainId = other.ChainId
End Constructor
End Class

# A solid circle, ported from upstream b2Circle in collision.h.
#
# Constructors validate their input and copy vector arguments, so later edits
# to the caller's vectors never mutate the circle. All members are
# module-internal for now; the public surface is finalised at the API freeze.
Class Circle
## The local centre.
Property Center As Vector2
## The radius.
Property Radius As Double

## Creates a circle from a centre and a radius. The centre is copied.
## Throws InvalidArgumentException when the centre or radius is not finite
## or the radius is negative.
Constructor(center As Vector2, radius As Double)
If Not center.X.IsFinite() Or Not center.Y.IsFinite() Then
Throw New InvalidArgumentException("Circle centre must be finite")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Circle radius must be finite and non-negative")
End If
Me.Center = New Vector2(center.X, center.Y)
Me.Radius = radius
End Constructor

## Copies another circle.
Constructor(other As Circle)
Me.Center = New Vector2(other.Center.X, other.Center.Y)
Me.Radius = other.Radius
End Constructor
## Computes the mass data of the circle, ported from upstream
## b2ComputeCircleMass. Inertia is about the local origin.
Function ComputeMass(density As Double) As MassData
Var data As New MassData
Return Me.ComputeMassTo(density, data)
End Function

## Caller-owned output form of ComputeMass for warm paths.
Function ComputeMassTo(density As Double, out As MassData) As MassData
Var rr As Double = Me.Radius * Me.Radius
out.Mass = density * PhysicsConstants.PI * rr
out.Center.Set(Me.Center.X, Me.Center.Y)
out.RotationalInertia = out.Mass * (0.5 * rr + (Me.Center.X * Me.Center.X + Me.Center.Y * Me.Center.Y))
Return out
End Function

## Computes the world-space AABB of the transformed circle, ported from
## upstream b2ComputeCircleAABB.
Function ComputeAABB(transform As Transform) As AABB
Return Me.ComputeAABBTo(transform, New AABB)
End Function

## Caller-owned output form of ComputeAABB for warm paths.
Function ComputeAABBTo(transform As Transform, out As AABB) As AABB
Var px As Double = transform.Q.C * Me.Center.X - transform.Q.S * Me.Center.Y + transform.P.X
Var py As Double = transform.Q.S * Me.Center.X + transform.Q.C * Me.Center.Y + transform.P.Y
out.LowerBound.Set(px - Me.Radius, py - Me.Radius)
out.UpperBound.Set(px + Me.Radius, py + Me.Radius)
Return out
End Function

## Determines whether the point lies within the circle, ported from upstream
## b2PointInCircle.
Function ContainsPoint(point As Vector2) As Boolean
Var dx As Double = point.X - Me.Center.X
Var dy As Double = point.Y - Me.Center.Y
Return dx * dx + dy * dy <= Me.Radius * Me.Radius
End Function
End Class

# Narrow-phase collision manifolds, ported from upstream manifold.c.
#
# Every pairing has a cold form returning a new Manifold and a warm To-form
# filling the caller-owned manifold in place. The To-forms keep all
# arithmetic scalar over Doubles and reuse the workspace attached to the
# manifold, so steady-state narrow-phase queries allocate nothing.
#
# Pairings that upstream implements by building a temporary shape delegate
# to shared scalar cores instead: segment shapes pass zero radii or
# two-vertex point clouds without allocating. Contact point ids follow
# upstream B2_MAKE_ID(A, B) = A * 256 + B.
Class Collide
## Computes the manifold between two circles into a new manifold, ported
## from upstream b2CollideCircles.
Shared Function CollideCircles(circleA As Circle, transformA As Transform, circleB As Circle, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideCirclesTo(circleA, transformA, circleB, transformB, out)
Return out
End Function

## Computes the manifold between two circles into the caller-owned out
## manifold and returns out.
Shared Function CollideCirclesTo(circleA As Circle, transformA As Transform, circleB As Circle, transformB As Transform, out As Manifold) As Manifold
out.Reset()

Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - transformA.P.X
Var dy As Double = transformB.P.Y - transformA.P.Y
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

# Circle B position in the frame of circle A.
Var pointAX As Double = circleA.Center.X
Var pointAY As Double = circleA.Center.Y
Var pointBX As Double = c * circleB.Center.X - s * circleB.Center.Y + px
Var pointBY As Double = s * circleB.Center.X + c * circleB.Center.Y + py

Var diffX As Double = pointBX - pointAX
Var diffY As Double = pointBY - pointAY
Var distance As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If distance > PhysicsConstants.FLT_EPSILON Then
Var invDistance As Double = 1.0 / distance
nx = invDistance * diffX
ny = invDistance * diffY
End If

Var radiusA As Double = circleA.Radius
Var radiusB As Double = circleB.Radius
Var separation As Double = distance - radiusA - radiusB
If separation > PhysicsConstants.SPECULATIVE_DISTANCE Then
Return out
End If

Var cAX As Double = pointAX + radiusA * nx
Var cAY As Double = pointAY + radiusA * ny
Var cBX As Double = pointBX - radiusB * nx
Var cBY As Double = pointBY - radiusB * ny
Var contactX As Double = 0.5 * (cAX + cBX)
Var contactY As Double = 0.5 * (cAY + cBY)

Var qcx As Double = transformA.Q.C
Var qsy As Double = transformA.Q.S
out.Normal.Set(qcx * nx - qsy * ny, qsy * nx + qcx * ny)

Var anchorX As Double = qcx * contactX - qsy * contactY
Var anchorY As Double = qsy * contactX + qcx * contactY
Var mp As ManifoldPoint = out.Point1
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(anchorX + transformA.P.X, anchorY + transformA.P.Y)
mp.Separation = separation
mp.Id = 0
out.PointCount = 1
Return out
End Function

## Computes the manifold between a capsule and a circle into a new
## manifold, ported from upstream b2CollideCapsuleAndCircle.
Shared Function CollideCapsuleAndCircle(capsuleA As Capsule, transformA As Transform, circleB As Circle, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideCapsuleAndCircleCoreTo(capsuleA.Center1.X, capsuleA.Center1.Y, capsuleA.Center2.X, capsuleA.Center2.Y, capsuleA.Radius, circleB, transformA, transformB, out)
Return out
End Function

## Computes the manifold between a capsule and a circle into the
## caller-owned out manifold and returns out.
Shared Function CollideCapsuleAndCircleTo(capsuleA As Capsule, transformA As Transform, circleB As Circle, transformB As Transform, out As Manifold) As Manifold
Return Collide.CollideCapsuleAndCircleCoreTo(capsuleA.Center1.X, capsuleA.Center1.Y, capsuleA.Center2.X, capsuleA.Center2.Y, capsuleA.Radius, circleB, transformA, transformB, out)
End Function

## Computes the manifold between a line segment and a circle into a new
## manifold, ported from upstream b2CollideSegmentAndCircle. A segment is a
## capsule with zero radius.
Shared Function CollideSegmentAndCircle(segmentA As Segment, transformA As Transform, circleB As Circle, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideCapsuleAndCircleCoreTo(segmentA.Point1.X, segmentA.Point1.Y, segmentA.Point2.X, segmentA.Point2.Y, 0.0, circleB, transformA, transformB, out)
Return out
End Function

## Computes the manifold between a line segment and a circle into the
## caller-owned out manifold and returns out.
Shared Function CollideSegmentAndCircleTo(segmentA As Segment, transformA As Transform, circleB As Circle, transformB As Transform, out As Manifold) As Manifold
Return Collide.CollideCapsuleAndCircleCoreTo(segmentA.Point1.X, segmentA.Point1.Y, segmentA.Point2.X, segmentA.Point2.Y, 0.0, circleB, transformA, transformB, out)
End Function

## Scalar core of the capsule-versus-circle manifold so segments can pass a
## zero radius without building a temporary capsule.
Shared Function CollideCapsuleAndCircleCoreTo(p1x As Double, p1y As Double, p2x As Double, p2y As Double, radiusA As Double, circleB As Circle, transformA As Transform, transformB As Transform, out As Manifold) As Manifold
out.Reset()

Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - transformA.P.X
Var dy As Double = transformB.P.Y - transformA.P.Y
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

# Circle position in the frame of the capsule.
Var pBX As Double = c * circleB.Center.X - s * circleB.Center.Y + px
Var pBY As Double = s * circleB.Center.X + c * circleB.Center.Y + py

Var ex As Double = p2x - p1x
Var ey As Double = p2y - p1y

Var s1 As Double = (pBX - p1x) * ex + (pBY - p1y) * ey
Var s2 As Double = (p2x - pBX) * ex + (p2y - pBY) * ey
Var pAX As Double = 0.0
Var pAY As Double = 0.0
If s1 < 0.0 Then
# p1 region.
pAX = p1x
pAY = p1y
ElseIf s2 < 0.0 Then
# p2 region.
pAX = p2x
pAY = p2y
Else
# Circle colliding with the segment interior.
Var ee As Double = ex * ex + ey * ey
Var segT As Double = s1 / ee
pAX = p1x + segT * ex
pAY = p1y + segT * ey
End If

Var diffX As Double = pBX - pAX
Var diffY As Double = pBY - pAY
Var distance As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If distance > PhysicsConstants.FLT_EPSILON Then
Var invDistance As Double = 1.0 / distance
nx = invDistance * diffX
ny = invDistance * diffY
End If

Var radiusB As Double = circleB.Radius
Var separation As Double = distance - radiusA - radiusB
If separation > PhysicsConstants.SPECULATIVE_DISTANCE Then
Return out
End If

Var cAX As Double = pAX + radiusA * nx
Var cAY As Double = pAY + radiusA * ny
Var cBX As Double = pBX - radiusB * nx
Var cBY As Double = pBY - radiusB * ny
Var contactX As Double = 0.5 * (cAX + cBX)
Var contactY As Double = 0.5 * (cAY + cBY)

Var qc As Double = transformA.Q.C
Var qs As Double = transformA.Q.S
out.Normal.Set(qc * nx - qs * ny, qs * nx + qc * ny)

Var anchorX As Double = qc * contactX - qs * contactY
Var anchorY As Double = qs * contactX + qc * contactY
Var mp As ManifoldPoint = out.Point1
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + anchorX, transformA.P.Y + anchorY)
mp.Separation = separation
mp.Id = 0
out.PointCount = 1
Return out
End Function

## Computes the manifold between a convex polygon and a circle into a new
## manifold, ported from upstream b2CollidePolygonAndCircle.
Shared Function CollidePolygonAndCircle(polygonA As Polygon, transformA As Transform, circleB As Circle, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollidePolygonAndCircleTo(polygonA, transformA, circleB, transformB, out)
Return out
End Function

## Computes the manifold between a convex polygon and a circle into the
## caller-owned out manifold and returns out.
Shared Function CollidePolygonAndCircleTo(polygonA As Polygon, transformA As Transform, circleB As Circle, transformB As Transform, out As Manifold) As Manifold
out.Reset()
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE

Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - transformA.P.X
Var dy As Double = transformB.P.Y - transformA.P.Y
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

# Circle position in the frame of the polygon.
Var centerX As Double = c * circleB.Center.X - s * circleB.Center.Y + px
Var centerY As Double = s * circleB.Center.X + c * circleB.Center.Y + py
Var radiusA As Double = polygonA.Radius
Var radiusB As Double = circleB.Radius
Var radius As Double = radiusA + radiusB

# Find the minimum separating edge.
Var normalIndex As Integer = 0
Var separation As Double = -1.7976931348623157e308
Var vertexCount As Integer = polygonA.Count
For i As Integer = 0 To vertexCount - 1
Var nX As Double = polygonA.Normals[i].X
Var nY As Double = polygonA.Normals[i].Y
Var edgeS As Double = nX * (centerX - polygonA.Vertices[i].X) + nY * (centerY - polygonA.Vertices[i].Y)
If edgeS > separation Then
separation = edgeS
normalIndex = i
End If
Next i

If separation > radius + speculativeDistance Then
Return out
End If

# Vertices of the reference edge.
Var vertIndex1 As Integer = normalIndex
Var vertIndex2 As Integer = normalIndex + 1
If vertIndex2 >= vertexCount Then
vertIndex2 = 0
End If
Var v1X As Double = polygonA.Vertices[vertIndex1].X
Var v1Y As Double = polygonA.Vertices[vertIndex1].Y
Var v2X As Double = polygonA.Vertices[vertIndex2].X
Var v2Y As Double = polygonA.Vertices[vertIndex2].Y

# Barycentric coordinates.
Var e1x As Double = v2X - v1X
Var e1y As Double = v2Y - v1Y
Var u1 As Double = (centerX - v1X) * e1x + (centerY - v1Y) * e1y
Var u2 As Double = (centerX - v2X) * -e1x + (centerY - v2Y) * -e1y

Var mp As ManifoldPoint = out.Point1
Var qc As Double = transformA.Q.C
Var qs As Double = transformA.Q.S

If u1 < 0.0 And separation > PhysicsConstants.FLT_EPSILON Then
# Circle centre is closest to v1 and safely outside the polygon.
Var diffX As Double = centerX - v1X
Var diffY As Double = centerY - v1Y
Var length As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
nx = invLength * diffX
ny = invLength * diffY
End If
Var vertexSeparation As Double = diffX * nx + diffY * ny
If vertexSeparation > radius + speculativeDistance Then
Return out
End If

Var cAX As Double = v1X + radiusA * nx
Var cAY As Double = v1Y + radiusA * ny
Var cBX As Double = centerX - radiusB * nx
Var cBY As Double = centerY - radiusB * ny
Var contactX As Double = 0.5 * (cAX + cBX)
Var contactY As Double = 0.5 * (cAY + cBY)

out.Normal.Set(qc * nx - qs * ny, qs * nx + qc * ny)
Var anchorX As Double = qc * contactX - qs * contactY
Var anchorY As Double = qs * contactX + qc * contactY
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + anchorX, transformA.P.Y + anchorY)
mp.Separation = (cBX - cAX) * nx + (cBY - cAY) * ny
mp.Id = 0
out.PointCount = 1
ElseIf u2 < 0.0 And separation > PhysicsConstants.FLT_EPSILON Then
# Circle centre is closest to v2 and safely outside the polygon.
Var diffX As Double = centerX - v2X
Var diffY As Double = centerY - v2Y
Var length As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
nx = invLength * diffX
ny = invLength * diffY
End If
Var vertexSeparation As Double = diffX * nx + diffY * ny
If vertexSeparation > radius + speculativeDistance Then
Return out
End If

Var cAX As Double = v2X + radiusA * nx
Var cAY As Double = v2Y + radiusA * ny
Var cBX As Double = centerX - radiusB * nx
Var cBY As Double = centerY - radiusB * ny
Var contactX As Double = 0.5 * (cAX + cBX)
Var contactY As Double = 0.5 * (cAY + cBY)

out.Normal.Set(qc * nx - qs * ny, qs * nx + qc * ny)
Var anchorX As Double = qc * contactX - qs * contactY
Var anchorY As Double = qs * contactX + qc * contactY
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + anchorX, transformA.P.Y + anchorY)
mp.Separation = (cBX - cAX) * nx + (cBY - cAY) * ny
mp.Id = 0
out.PointCount = 1
Else
# Circle centre is between v1 and v2. The centre may be inside the
# polygon.
Var nX As Double = polygonA.Normals[normalIndex].X
Var nY As Double = polygonA.Normals[normalIndex].Y
out.Normal.Set(qc * nX - qs * nY, qs * nX + qc * nY)

# cA is the projection of the circle centre onto the reference edge.
Var edgeOffset As Double = (centerX - v1X) * nX + (centerY - v1Y) * nY
Var cAX As Double = centerX + (radiusA - edgeOffset) * nX
Var cAY As Double = centerY + (radiusA - edgeOffset) * nY

# cB is the deepest point on the circle with respect to the reference
# edge.
Var cBX As Double = centerX - radiusB * nX
Var cBY As Double = centerY - radiusB * nY

Var contactX As Double = 0.5 * (cAX + cBX)
Var contactY As Double = 0.5 * (cAY + cBY)

Var anchorX As Double = qc * contactX - qs * contactY
Var anchorY As Double = qs * contactX + qc * contactY
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + anchorX, transformA.P.Y + anchorY)
mp.Separation = separation - radius
mp.Id = 0
out.PointCount = 1
End If

Return out
End Function

## Computes the manifold between two capsules into a new manifold, ported
## from upstream b2CollideCapsules.
Shared Function CollideCapsules(capsuleA As Capsule, transformA As Transform, capsuleB As Capsule, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideCapsulesCoreTo(capsuleA.Center1.X, capsuleA.Center1.Y, capsuleA.Center2.X, capsuleA.Center2.Y, capsuleA.Radius,
capsuleB.Center1.X, capsuleB.Center1.Y, capsuleB.Center2.X, capsuleB.Center2.Y, capsuleB.Radius, transformA, transformB, out.Scratch(), out)
Return out
End Function

## Computes the manifold between two capsules into the caller-owned out
## manifold and returns out.
Shared Function CollideCapsulesTo(capsuleA As Capsule, transformA As Transform, capsuleB As Capsule, transformB As Transform, out As Manifold) As Manifold
Return Collide.CollideCapsulesCoreTo(capsuleA.Center1.X, capsuleA.Center1.Y, capsuleA.Center2.X, capsuleA.Center2.Y, capsuleA.Radius,
capsuleB.Center1.X, capsuleB.Center1.Y, capsuleB.Center2.X, capsuleB.Center2.Y, capsuleB.Radius, transformA, transformB, out.Scratch(), out)
End Function

## Computes the manifold between a line segment and a capsule into a new
## manifold, ported from upstream b2CollideSegmentAndCapsule. A segment is
## a capsule with zero radius.
Shared Function CollideSegmentAndCapsule(segmentA As Segment, transformA As Transform, capsuleB As Capsule, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideCapsulesCoreTo(segmentA.Point1.X, segmentA.Point1.Y, segmentA.Point2.X, segmentA.Point2.Y, 0.0,
capsuleB.Center1.X, capsuleB.Center1.Y, capsuleB.Center2.X, capsuleB.Center2.Y, capsuleB.Radius, transformA, transformB, out.Scratch(), out)
Return out
End Function

## Computes the manifold between a line segment and a capsule into the
## caller-owned out manifold and returns out.
Shared Function CollideSegmentAndCapsuleTo(segmentA As Segment, transformA As Transform, capsuleB As Capsule, transformB As Transform, out As Manifold) As Manifold
Return Collide.CollideCapsulesCoreTo(segmentA.Point1.X, segmentA.Point1.Y, segmentA.Point2.X, segmentA.Point2.Y, 0.0,
capsuleB.Center1.X, capsuleB.Center1.Y, capsuleB.Center2.X, capsuleB.Center2.Y, capsuleB.Radius, transformA, transformB, out.Scratch(), out)
End Function

## Computes the manifold between a convex polygon and a capsule into a
## new manifold, ported from upstream b2CollidePolygonAndCapsule. The
## capsule becomes a two-vertex polygon.
Shared Function CollidePolygonAndCapsule(polygonA As Polygon, transformA As Transform, capsuleB As Capsule, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollidePolygonAndCapsuleTo(polygonA, transformA, capsuleB, transformB, out)
Return out
End Function

## Computes the manifold between a convex polygon and a capsule into the
## caller-owned out manifold and returns out.
Shared Function CollidePolygonAndCapsuleTo(polygonA As Polygon, transformA As Transform, capsuleB As Capsule, transformB As Transform, out As Manifold) As Manifold
Var scratch As CollideScratch = out.Scratch()
Var polyVerts As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyVertices, 2)
Var polyNormals As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyNormals, 2)

Var ex As Double = capsuleB.Center2.X - capsuleB.Center1.X
Var ey As Double = capsuleB.Center2.Y - capsuleB.Center1.Y
Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
nx = ey / length
ny = -ex / length
End If

polyVerts[0].Set(capsuleB.Center1.X, capsuleB.Center1.Y)
polyVerts[1].Set(capsuleB.Center2.X, capsuleB.Center2.Y)
polyNormals[0].Set(nx, ny)
polyNormals[1].Set(-nx, -ny)

Return Collide.CollidePolygonsCoreTo(polygonA.Vertices, polygonA.Normals, polygonA.Count, polygonA.Radius,
polyVerts, polyNormals, 2, capsuleB.Radius, transformA, transformB, scratch, out)
End Function

## Scalar core of the capsule-versus-capsule manifold following Ericson
## 5.1.9 with clipping so two contact points are possible.
Shared Function CollideCapsulesCoreTo(p1x As Double, p1y As Double, p2x As Double, p2y As Double, radiusA As Double, q1x As Double, q1y As Double, q2x As Double, q2y As Double, radiusB As Double, transformA As Transform, transformB As Transform, scratch As CollideScratch, out As Manifold) As Manifold
out.Reset()

# Shift capsule A to the origin: pw = q * pbs + (p + q * origin).
Var originX As Double = p1x
Var originY As Double = p1y
Var sfPX As Double = transformA.P.X + transformA.Q.C * originX - transformA.Q.S * originY
Var sfPY As Double = transformA.P.Y + transformA.Q.S * originX + transformA.Q.C * originY
Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - sfPX
Var dy As Double = transformB.P.Y - sfPY
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

Var sp1x As Double = 0.0
Var sp1y As Double = 0.0
Var sq1x As Double = p2x - originX
Var sq1y As Double = p2y - originY
Var sp2x As Double = c * q1x - s * q1y + px
Var sp2y As Double = s * q1x + c * q1y + py
Var sq2x As Double = c * q2x - s * q2y + px
Var sq2y As Double = s * q2x + c * q2y + py

Var d1x As Double = sq1x - sp1x
Var d1y As Double = sq1y - sp1y
Var d2x As Double = sq2x - sp2x
Var d2y As Double = sq2y - sp2y

Var dd1 As Double = d1x * d1x + d1y * d1y
Var dd2 As Double = d2x * d2x + d2y * d2y

Var epsSqr As Double = PhysicsConstants.FLT_EPSILON * PhysicsConstants.FLT_EPSILON

Var rx As Double = sp1x - sp2x
Var ry As Double = sp1y - sp2y
Var rd1 As Double = rx * d1x + ry * d1y
Var rd2 As Double = rx * d2x + ry * d2y

Var d12 As Double = d1x * d2x + d1y * d2y

Var denom As Double = dd1 * dd2 - d12 * d12

# Fraction on segment 1.
Var f1 As Double = 0.0
If denom <> 0.0 Then
# Not parallel.
f1 = Collide.Clamp01((d12 * rd2 - rd1 * dd2) / denom)
End If

# Point on segment 2 closest to p1 + f1 * d1.
Var f2 As Double = (d12 * f1 + rd2) / dd2

# Clamping of segment 2 requires a do-over on segment 1.
If f2 < 0.0 Then
f2 = 0.0
f1 = Collide.Clamp01(-rd1 / dd1)
ElseIf f2 > 1.0 Then
f2 = 1.0
f1 = Collide.Clamp01((d12 - rd1) / dd1)
End If

Var closest1x As Double = sp1x + f1 * d1x
Var closest1y As Double = sp1y + f1 * d1y
Var closest2x As Double = sp2x + f2 * d2x
Var closest2y As Double = sp2y + f2 * d2y
Var distX As Double = closest1x - closest2x
Var distY As Double = closest1y - closest2y
Var distanceSquared As Double = distX * distX + distY * distY

Var radius As Double = radiusA + radiusB
Var maxDistance As Double = radius + PhysicsConstants.SPECULATIVE_DISTANCE

If distanceSquared > maxDistance * maxDistance Then
Return out
End If

Var distance As Double = Maths.Sqrt(distanceSquared)

Var length1 As Double = Maths.Sqrt(d1x * d1x + d1y * d1y)
Var u1x As Double = 0.0
Var u1y As Double = 0.0
If length1 > PhysicsConstants.FLT_EPSILON Then
u1x = d1x / length1
u1y = d1y / length1
End If
Var length2 As Double = Maths.Sqrt(d2x * d2x + d2y * d2y)
Var u2x As Double = 0.0
Var u2y As Double = 0.0
If length2 > PhysicsConstants.FLT_EPSILON Then
u2x = d2x / length2
u2y = d2y / length2
End If

# Does segment B project outside segment A?
Var fp2 As Double = (sp2x - sp1x) * u1x + (sp2y - sp1y) * u1y
Var fq2 As Double = (sq2x - sp1x) * u1x + (sq2y - sp1y) * u1y
Var outsideA As Boolean = (fp2 <= 0.0 And fq2 <= 0.0) Or (fp2 >= length1 And fq2 >= length1)

# Does segment A project outside segment B?
Var fp1 As Double = (sp1x - sp2x) * u2x + (sp1y - sp2y) * u2y
Var fq1 As Double = (sq1x - sp2x) * u2x + (sq1y - sp2y) * u2y
Var outsideB As Boolean = (fp1 <= 0.0 And fq1 <= 0.0) Or (fp1 >= length2 And fq1 >= length2)

If Not outsideA And Not outsideB Then
# Attempt to clip. This may yield contact points with excessive
# separation; in that case fall back to single point collision below.

# Find the reference edge using the SAT, biased to avoid feature
# flip-flop.
Var separationA As Double = Collide.CapsuleEdgeSeparation(u1x, u1y, sp1x, sp1y, sp2x, sp2y, sq2x, sq2y, scratch.ClipNormalA)
Var normalAX As Double = scratch.ClipNormalA.X
Var normalAY As Double = scratch.ClipNormalA.Y

Var separationB As Double = Collide.CapsuleEdgeSeparation(u2x, u2y, sp2x, sp2y, sp1x, sp1y, sq1x, sq1y, scratch.ClipNormalB)
Var normalBX As Double = scratch.ClipNormalB.X
Var normalBY As Double = scratch.ClipNormalB.Y

If separationA + 0.1 * PhysicsConstants.LINEAR_SLOP >= separationB Then
# Reference edge on A. The normal points from A to B.
out.Normal.Set(normalAX, normalAY)
Var cp As Vector2 = scratch.ClipCp
Var cq As Vector2 = scratch.ClipCq
cp.Set(sp2x, sp2y)
cq.Set(sq2x, sq2y)
Collide.ClipEndpoints(fp2, fq2, 0.0, sp2x, sp2y, sq2x, sq2y, cp, cq)
Collide.ClipEndpoints(fp2, fq2, length1, sp2x, sp2y, sq2x, sq2y, cp, cq)
Var sp As Double = (cp.X - sp1x) * normalAX + (cp.Y - sp1y) * normalAY
Var sq As Double = (cq.X - sp1x) * normalAX + (cq.Y - sp1y) * normalAY

If sp <= distance + PhysicsConstants.LINEAR_SLOP Or sq <= distance + PhysicsConstants.LINEAR_SLOP Then
Var mp1 As ManifoldPoint = out.Point1
mp1.AnchorA.Set(cp.X + 0.5 * (radiusA - radiusB - sp) * normalAX, cp.Y + 0.5 * (radiusA - radiusB - sp) * normalAY)
mp1.Separation = sp - radius
mp1.Id = 0

Var mp2 As ManifoldPoint = out.Point2
mp2.AnchorA.Set(cq.X + 0.5 * (radiusA - radiusB - sq) * normalAX, cq.Y + 0.5 * (radiusA - radiusB - sq) * normalAY)
mp2.Separation = sq - radius
mp2.Id = 1
out.PointCount = 2
End If
Else
# Reference edge on B. The normal always points from A to B.
out.Normal.Set(-normalBX, -normalBY)
Var cp As Vector2 = scratch.ClipCp
Var cq As Vector2 = scratch.ClipCq
cp.Set(sp1x, sp1y)
cq.Set(sq1x, sq1y)
Collide.ClipEndpoints(fp1, fq1, 0.0, sp1x, sp1y, sq1x, sq1y, cp, cq)
Collide.ClipEndpoints(fp1, fq1, length2, sp1x, sp1y, sq1x, sq1y, cp, cq)
Var sp As Double = (cp.X - sp2x) * normalBX + (cp.Y - sp2y) * normalBY
Var sq As Double = (cq.X - sp2x) * normalBX + (cq.Y - sp2y) * normalBY

If sp <= distance + PhysicsConstants.LINEAR_SLOP Or sq <= distance + PhysicsConstants.LINEAR_SLOP Then
Var mp1 As ManifoldPoint = out.Point1
mp1.AnchorA.Set(cp.X + 0.5 * (radiusB - radiusA - sp) * normalBX, cp.Y + 0.5 * (radiusB - radiusA - sp) * normalBY)
mp1.Separation = sp - radius
mp1.Id = 0

Var mp2 As ManifoldPoint = out.Point2
mp2.AnchorA.Set(cq.X + 0.5 * (radiusB - radiusA - sq) * normalBX, cq.Y + 0.5 * (radiusB - radiusA - sq) * normalBY)
mp2.Separation = sq - radius
mp2.Id = 256
out.PointCount = 2
End If
End If
End If

If out.PointCount = 0 Then
# Single point collision.
Var nx As Double = closest2x - closest1x
Var ny As Double = closest2y - closest1y
If nx * nx + ny * ny > epsSqr Then
Var nLen As Double = Maths.Sqrt(nx * nx + ny * ny)
nx = nx / nLen
ny = ny / nLen
Else
# Left perpendicular of u1.
nx = u1y
ny = -u1x
End If

Var c1x As Double = closest1x + radiusA * nx
Var c1y As Double = closest1y + radiusA * ny
Var c2x As Double = closest2x - radiusB * nx
Var c2y As Double = closest2y - radiusB * ny

Var i1 As Integer = 0
If f1 <> 0.0 Then
i1 = 1
End If
Var i2 As Integer = 0
If f2 <> 0.0 Then
i2 = 1
End If

out.Normal.Set(nx, ny)
out.Point1.AnchorA.Set(0.5 * (c1x + c2x), 0.5 * (c1y + c2y))
out.Point1.Separation = distance - radius
out.Point1.Id = i1 * 256 + i2
out.PointCount = 1
End If

# Convert the manifold to world space.
out.Normal.Set(transformA.Q.C * out.Normal.X - transformA.Q.S * out.Normal.Y, transformA.Q.S * out.Normal.X + transformA.Q.C * out.Normal.Y)
For i As Integer = 0 To out.PointCount - 1
Var mp As ManifoldPoint = out.Point1
If i = 1 Then
mp = out.Point2
End If

# Anchor points relative to the shape origin in world space.
Var localX As Double = mp.AnchorA.X + originX
Var localY As Double = mp.AnchorA.Y + originY
mp.AnchorA.Set(transformA.Q.C * localX - transformA.Q.S * localY, transformA.Q.S * localX + transformA.Q.C * localY)
mp.AnchorB.Set(mp.AnchorA.X + transformA.P.X - transformB.P.X, mp.AnchorA.Y + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + mp.AnchorA.X, transformA.P.Y + mp.AnchorA.Y)
Next i

Return out
End Function

## Computes the manifold between two convex polygons into a new manifold,
## ported from upstream b2CollidePolygons.
Shared Function CollidePolygons(polygonA As Polygon, transformA As Transform, polygonB As Polygon, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollidePolygonsTo(polygonA, transformA, polygonB, transformB, out)
Return out
End Function

## Computes the manifold between two convex polygons into the caller-owned
## out manifold and returns out.
Shared Function CollidePolygonsTo(polygonA As Polygon, transformA As Transform, polygonB As Polygon, transformB As Transform, out As Manifold) As Manifold
Var scratch As CollideScratch = out.Scratch()
Return Collide.CollidePolygonsCoreTo(polygonA.Vertices, polygonA.Normals, polygonA.Count, polygonA.Radius,
polygonB.Vertices, polygonB.Normals, polygonB.Count, polygonB.Radius, transformA, transformB, scratch, out)
End Function

## Computes the manifold between a line segment and a convex polygon into
## a new manifold, ported from upstream b2CollideSegmentAndPolygon. The
## segment becomes a two-vertex polygon with zero radius.
Shared Function CollideSegmentAndPolygon(segmentA As Segment, transformA As Transform, polygonB As Polygon, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideSegmentAndPolygonTo(segmentA, transformA, polygonB, transformB, out)
Return out
End Function

## Computes the manifold between a line segment and a convex polygon into
## the caller-owned out manifold and returns out.
Shared Function CollideSegmentAndPolygonTo(segmentA As Segment, transformA As Transform, polygonB As Polygon, transformB As Transform, out As Manifold) As Manifold
Var scratch As CollideScratch = out.Scratch()
Var polyVerts As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyVertices, 2)
Var polyNormals As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyNormals, 2)

Var ex As Double = segmentA.Point2.X - segmentA.Point1.X
Var ey As Double = segmentA.Point2.Y - segmentA.Point1.Y
Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
nx = ey / length
ny = -ex / length
End If

polyVerts[0].Set(segmentA.Point1.X, segmentA.Point1.Y)
polyVerts[1].Set(segmentA.Point2.X, segmentA.Point2.Y)
polyNormals[0].Set(nx, ny)
polyNormals[1].Set(-nx, -ny)

Return Collide.CollidePolygonsCoreTo(polyVerts, polyNormals, 2, 0.0,
polygonB.Vertices, polygonB.Normals, polygonB.Count, polygonB.Radius, transformA, transformB, scratch, out)
End Function

## Scalar core of the polygon-versus-polygon manifold. Ports the upstream
## SAT, closest-edge, and clipping logic.
Shared Function CollidePolygonsCoreTo(vertsA() As Vector2, normalsA() As Vector2, countA As Integer, radiusA As Double, vertsB() As Vector2, normalsB() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, scratch As CollideScratch, out As Manifold) As Manifold
out.Reset()
Var linearSlop As Double = PhysicsConstants.LINEAR_SLOP
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE

# Shift polygon A to the origin: pw = q * pbs + (p + q * origin).
Var originX As Double = vertsA[0].X
Var originY As Double = vertsA[0].Y
scratch.ShiftedTransformA.P.Set(transformA.P.X + transformA.Q.C * originX - transformA.Q.S * originY, transformA.P.Y + transformA.Q.S * originX + transformA.Q.C * originY)
scratch.ShiftedTransformA.Q.SetComponents(transformA.Q.C, transformA.Q.S)
Var sfA As Transform = scratch.ShiftedTransformA

Var c As Double = sfA.Q.C * transformB.Q.C + sfA.Q.S * transformB.Q.S
Var s As Double = -sfA.Q.S * transformB.Q.C + sfA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - sfA.P.X
Var dy As Double = transformB.P.Y - sfA.P.Y
Var px As Double = sfA.Q.C * dx + sfA.Q.S * dy
Var py As Double = -sfA.Q.S * dx + sfA.Q.C * dy
scratch.RelativeTransform.P.Set(px, py)
scratch.RelativeTransform.Q.SetComponents(c, s)
Var xf As Transform = scratch.RelativeTransform

# Local polygon A: shifted vertices, original normals.
Var localA As Array(Of Vector2) = scratch.GrowPoints(scratch.PolyAVertices, countA)
Var localANormals As Array(Of Vector2) = scratch.GrowPoints(scratch.PolyANormals, countA)
localA[0].Set(0.0, 0.0)
localANormals[0].Set(normalsA[0].X, normalsA[0].Y)
For i As Integer = 1 To countA - 1
localA[i].Set(vertsA[i].X - originX, vertsA[i].Y - originY)
localANormals[i].Set(normalsA[i].X, normalsA[i].Y)
Next i

# Put polygon B in polygon A's frame to reduce round-off error.
Var localB As Array(Of Vector2) = scratch.GrowPoints(scratch.PolyBVertices, countB)
Var localBNormals As Array(Of Vector2) = scratch.GrowPoints(scratch.PolyBNormals, countB)
For i As Integer = 0 To countB - 1
localB[i].Set(xf.Q.C * vertsB[i].X - xf.Q.S * vertsB[i].Y + xf.P.X, xf.Q.S * vertsB[i].X + xf.Q.C * vertsB[i].Y + xf.P.Y)
localBNormals[i].Set(xf.Q.C * normalsB[i].X - xf.Q.S * normalsB[i].Y, xf.Q.S * normalsB[i].X + xf.Q.C * normalsB[i].Y)
Next i

FindMaxSeparation(localANormals, localA, countA, localB, countB, True, scratch)
Var edgeA As Integer = scratch.EdgeIndexA
Var separationA As Double = scratch.EdgeSeparation
FindMaxSeparation(localBNormals, localB, countB, localA, countA, False, scratch)
Var edgeB As Integer = scratch.EdgeIndexB
Var separationB As Double = scratch.EdgeSeparation

Var radius As Double = radiusA + radiusB

If separationA > speculativeDistance + radius Or separationB > speculativeDistance + radius Then
Return out
End If

# Find the incident edge.
Var flip As Boolean = False
If separationA >= separationB Then
flip = False
edgeB = Collide.FindIncidentEdge(localANormals[edgeA].X, localANormals[edgeA].Y, localBNormals, countB)
Else
flip = True
edgeA = Collide.FindIncidentEdge(localBNormals[edgeB].X, localBNormals[edgeB].Y, localANormals, countA)
End If

# Using slop here so vertex-vertex normal vectors can be safely
# normalised; edge clipping must handle slightly non-overlapping edges.
If separationA > 0.1 * linearSlop Or separationB > 0.1 * linearSlop Then
# Edges are disjoint: find closest points between the reference edge
# and the incident edge.
Collide.CollidePolygonsDisjointTo(localA, localANormals, countA, radiusA, localB, localBNormals, countB, radiusB, edgeA, edgeB, flip, radius, speculativeDistance, linearSlop, scratch, out)
Else
# Polygons overlap.
Collide.ClipPolygons(localA, localANormals, countA, radiusA, localB, localBNormals, countB, radiusB, edgeA, edgeB, flip, out)
End If

# Convert the manifold to world space.
If out.PointCount > 0 Then
out.Normal.Set(transformA.Q.C * out.Normal.X - transformA.Q.S * out.Normal.Y, transformA.Q.S * out.Normal.X + transformA.Q.C * out.Normal.Y)
For i As Integer = 0 To out.PointCount - 1
Var mp As ManifoldPoint = out.Point1
If i = 1 Then
mp = out.Point2
End If

# Anchor points relative to the shape origin in world space.
Var localX As Double = mp.AnchorA.X + originX
Var localY As Double = mp.AnchorA.Y + originY
mp.AnchorA.Set(transformA.Q.C * localX - transformA.Q.S * localY, transformA.Q.S * localX + transformA.Q.C * localY)
mp.AnchorB.Set(mp.AnchorA.X + transformA.P.X - transformB.P.X, mp.AnchorA.Y + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + mp.AnchorA.X, transformA.P.Y + mp.AnchorA.Y)
Next i
End If

Return out
End Function

## Finds the closest points between disjoint reference and incident edges
## and writes either clipped edge points or a single vertex-vertex point,
## ported from the disjoint-edge branch of upstream b2CollidePolygons.
Shared Sub CollidePolygonsDisjointTo(localA() As Vector2, localANormals() As Vector2, countA As Integer, radiusA As Double, localB() As Vector2, localBNormals() As Vector2, countB As Integer, radiusB As Double, edgeA As Integer, edgeB As Integer, flip As Boolean, radius As Double, speculativeDistance As Double, linearSlop As Double, scratch As CollideScratch, out As Manifold)
Var i11 As Integer = edgeA
Var i12 As Integer = edgeA + 1
If i12 >= countA Then
i12 = 0
End If
Var i21 As Integer = edgeB
Var i22 As Integer = edgeB + 1
If i22 >= countB Then
i22 = 0
End If

Var result As SegmentDistanceResult = scratch.SegmentResult
Distance.SegmentDistanceTo(localA[i11], localA[i12], localB[i21], localB[i22], result)
Var distance As Double = Maths.Sqrt(result.DistanceSquared)
Var separation As Double = distance - radius

If distance - radius > speculativeDistance Then
# This can happen in the vertex-vertex case.
Return
End If

# Attempt to clip the edges.
Collide.ClipPolygons(localA, localANormals, countA, radiusA, localB, localBNormals, countB, radiusB, edgeA, edgeB, flip, out)

Var minSeparation As Double = 1.7976931348623157e308
For i As Integer = 0 To out.PointCount - 1
Var mp As ManifoldPoint = out.Point1
If i = 1 Then
mp = out.Point2
End If
If mp.Separation < minSeparation Then
minSeparation = mp.Separation
End If
Next i

# Does vertex-vertex have substantially larger separation?
If separation + 0.1 * linearSlop < minSeparation Then
If result.Fraction1 = 0.0 And result.Fraction2 = 0.0 Then
# v11 - v21
Collide.WriteVertexVertexPoint(localA[i11].X, localA[i11].Y, localB[i21].X, localB[i21].Y, i11, i21, radiusA, radiusB, radius, distance, out)
ElseIf result.Fraction1 = 0.0 And result.Fraction2 = 1.0 Then
# v11 - v22
Collide.WriteVertexVertexPoint(localA[i11].X, localA[i11].Y, localB[i22].X, localB[i22].Y, i11, i22, radiusA, radiusB, radius, distance, out)
ElseIf result.Fraction1 = 1.0 And result.Fraction2 = 0.0 Then
# v12 - v21
Collide.WriteVertexVertexPoint(localA[i12].X, localA[i12].Y, localB[i21].X, localB[i21].Y, i12, i21, radiusA, radiusB, radius, distance, out)
ElseIf result.Fraction1 = 1.0 And result.Fraction2 = 1.0 Then
# v12 - v22
Collide.WriteVertexVertexPoint(localA[i12].X, localA[i12].Y, localB[i22].X, localB[i22].Y, i12, i22, radiusA, radiusB, radius, distance, out)
End If
End If
End Sub

## Finds the max separation between two polygons using edge normals from
## polygon 1, ported from upstream b2FindMaxSeparation. Stores the best
## edge index and separation in the scratch under the requested slot.
Shared Function FindMaxSeparation(normals1() As Vector2, verts1() As Vector2, count1 As Integer, verts2() As Vector2, count2 As Integer, forA As Boolean, scratch As CollideScratch) As Double
Var bestIndex As Integer = 0
Var maxSeparation As Double = -1.7976931348623157e308
For i As Integer = 0 To count1 - 1
Var nX As Double = normals1[i].X
Var nY As Double = normals1[i].Y
Var v1X As Double = verts1[i].X
Var v1Y As Double = verts1[i].Y

# Find the deepest point for normal i.
Var si As Double = 1.7976931348623157e308
For j As Integer = 0 To count2 - 1
Var sij As Double = nX * (verts2[j].X - v1X) + nY * (verts2[j].Y - v1Y)
If sij < si Then
si = sij
End If
Next j

If si > maxSeparation Then
maxSeparation = si
bestIndex = i
End If
Next i

If forA Then
scratch.EdgeIndexA = bestIndex
Else
scratch.EdgeIndexB = bestIndex
End If
scratch.EdgeSeparation = maxSeparation
Return maxSeparation
End Function

## Finds the incident edge on polygon 2 whose normal is most anti-parallel
## to the search direction.
Shared Function FindIncidentEdge(searchX As Double, searchY As Double, normals2() As Vector2, count2 As Integer) As Integer
Var bestIndex As Integer = 0
Var minDot As Double = 1.7976931348623157e308
For i As Integer = 0 To count2 - 1
Var dot As Double = searchX * normals2[i].X + searchY * normals2[i].Y
If dot < minDot Then
minDot = dot
bestIndex = i
End If
Next i
Return bestIndex
End Function

## Polygon clipper used to compute contact points when there are
## potentially two contact points, ported from upstream b2ClipPolygons.
## polygon 1 is the reference; flip swaps the roles.
Shared Sub ClipPolygons(vertsA() As Vector2, normalsA() As Vector2, countA As Integer, radiusA As Double, vertsB() As Vector2, normalsB() As Vector2, countB As Integer, radiusB As Double, edgeA As Integer, edgeB As Integer, flip As Boolean, out As Manifold)
out.Reset()

Var i11 As Integer = 0
Var i12 As Integer = 0
Var i21 As Integer = 0
Var i22 As Integer = 0
Var v11X As Double = 0.0
Var v11Y As Double = 0.0
Var v12X As Double = 0.0
Var v12Y As Double = 0.0
Var v21X As Double = 0.0
Var v21Y As Double = 0.0
Var v22X As Double = 0.0
Var v22Y As Double = 0.0

Var normalX As Double = 0.0
Var normalY As Double = 0.0
Var r1 As Double = radiusA
Var r2 As Double = radiusB
If flip Then
# Reference polygon is B; incident polygon is A.
i11 = edgeB
i12 = edgeB + 1
If i12 >= countB Then
i12 = 0
End If
i21 = edgeA
i22 = edgeA + 1
If i22 >= countA Then
i22 = 0
End If
v11X = vertsB[i11].X
v11Y = vertsB[i11].Y
v12X = vertsB[i12].X
v12Y = vertsB[i12].Y
v21X = vertsA[i21].X
v21Y = vertsA[i21].Y
v22X = vertsA[i22].X
v22Y = vertsA[i22].Y
normalX = normalsB[edgeB].X
normalY = normalsB[edgeB].Y
r1 = radiusB
r2 = radiusA
Else
i11 = edgeA
i12 = edgeA + 1
If i12 >= countA Then
i12 = 0
End If
i21 = edgeB
i22 = edgeB + 1
If i22 >= countB Then
i22 = 0
End If
v11X = vertsA[i11].X
v11Y = vertsA[i11].Y
v12X = vertsA[i12].X
v12Y = vertsA[i12].Y
v21X = vertsB[i21].X
v21Y = vertsB[i21].Y
v22X = vertsB[i22].X
v22Y = vertsB[i22].Y
normalX = normalsA[edgeA].X
normalY = normalsA[edgeA].Y
End If

# Tangent is crossSV(1, normal) = (-normal.y, normal.x).
Var tangentX As Double = -normalY
Var tangentY As Double = normalX

Var lower1 As Double = 0.0
Var upper1 As Double = (v12X - v11X) * tangentX + (v12Y - v11Y) * tangentY

# Incident edge points opposite of tangent due to CCW winding.
Var upper2 As Double = (v21X - v11X) * tangentX + (v21Y - v11Y) * tangentY
Var lower2 As Double = (v22X - v11X) * tangentX + (v22Y - v11Y) * tangentY

# Are the segments disjoint?
If upper2 < lower1 Or upper1 < lower2 Then
Return
End If

Var vLowerX As Double = v22X
Var vLowerY As Double = v22Y
If lower2 < lower1 And upper2 - lower2 > PhysicsConstants.FLT_EPSILON Then
Var tLower As Double = (lower1 - lower2) / (upper2 - lower2)
vLowerX = v22X + tLower * (v21X - v22X)
vLowerY = v22Y + tLower * (v21Y - v22Y)
End If

Var vUpperX As Double = v21X
Var vUpperY As Double = v21Y
If upper2 > upper1 And upper2 - lower2 > PhysicsConstants.FLT_EPSILON Then
Var tUpper As Double = (upper1 - lower2) / (upper2 - lower2)
vUpperX = v22X + tUpper * (v21X - v22X)
vUpperY = v22Y + tUpper * (v21Y - v22Y)
End If

Var separationLower As Double = (vLowerX - v11X) * normalX + (vLowerY - v11Y) * normalY
Var separationUpper As Double = (vUpperX - v11X) * normalX + (vUpperY - v11Y) * normalY

# Put contact points at the midpoint, accounting for radii.
vLowerX = vLowerX + 0.5 * (r1 - r2 - separationLower) * normalX
vLowerY = vLowerY + 0.5 * (r1 - r2 - separationLower) * normalY
vUpperX = vUpperX + 0.5 * (r1 - r2 - separationUpper) * normalX
vUpperY = vUpperY + 0.5 * (r1 - r2 - separationUpper) * normalY

Var radius As Double = r1 + r2

Var cp As ManifoldPoint = out.Point1
If flip = False Then
out.Normal.Set(normalX, normalY)

cp.AnchorA.Set(vLowerX, vLowerY)
cp.Separation = separationLower - radius
cp.Id = i11 * 256 + i22
out.PointCount = out.PointCount + 1

cp = out.Point2
cp.AnchorA.Set(vUpperX, vUpperY)
cp.Separation = separationUpper - radius
cp.Id = i12 * 256 + i21
out.PointCount = out.PointCount + 1
Else
out.Normal.Set(-normalX, -normalY)

cp.AnchorA.Set(vUpperX, vUpperY)
cp.Separation = separationUpper - radius
cp.Id = i21 * 256 + i12
out.PointCount = out.PointCount + 1

cp = out.Point2
cp.AnchorA.Set(vLowerX, vLowerY)
cp.Separation = separationLower - radius
cp.Id = i22 * 256 + i11
out.PointCount = out.PointCount + 1
End If
End Sub

## Writes the single vertex-vertex contact point chosen by the disjoint
## edge path of the polygon pairing.
Shared Sub WriteVertexVertexPoint(v1x As Double, v1y As Double, v2x As Double, v2y As Double, id1 As Integer, id2 As Integer, radiusA As Double, radiusB As Double, radius As Double, distance As Double, out As Manifold)
Var nx As Double = v2x - v1x
Var ny As Double = v2y - v1y
Var invDistance As Double = 1.0 / distance
nx = nx * invDistance
ny = ny * invDistance

Var c1x As Double = v1x + radiusA * nx
Var c1y As Double = v1y + radiusA * ny
Var c2x As Double = v2x - radiusB * nx
Var c2y As Double = v2y - radiusB * ny

out.Normal.Set(nx, ny)
out.Point1.AnchorA.Set(0.5 * (c1x + c2x), 0.5 * (c1y + c2y))
out.Point1.Separation = distance - radius
out.Point1.Id = id1 * 256 + id2
out.PointCount = 1
End Sub

## Computes the SAT separation of one capsule edge against the other
## capsule's endpoints and writes the chosen normal into the out vector.
## Mirrors the two reference-edge blocks of upstream b2CollideCapsules.
Shared Function CapsuleEdgeSeparation(ux As Double, uy As Double, px As Double, py As Double, a1x As Double, a1y As Double, a2x As Double, a2y As Double, out As Vector2) As Double
# Left perpendicular of u.
Var nx As Double = -uy
Var ny As Double = ux
Var ss1 As Double = (a1x - px) * nx + (a1y - py) * ny
Var ss2 As Double = (a2x - px) * nx + (a2y - py) * ny
Var s1p As Double = ss1
If ss2 < s1p Then
s1p = ss2
End If
Var s1n As Double = -ss1
If -ss2 < s1n Then
s1n = -ss2
End If

If s1p > s1n Then
out.Set(nx, ny)
Return s1p
End If
out.Set(-nx, -ny)
Return s1n
End Function

## Clips the endpoints cp/cq of the moving segment against the bounds zero
## and bound, mirroring the clip blocks of upstream b2CollideCapsules.
Shared Sub ClipEndpoints(fp As Double, fq As Double, bound As Double, px As Double, py As Double, qx As Double, qy As Double, cp As Vector2, cq As Vector2)
If bound = 0.0 Then
# Clip to the segment start.
If fp < 0.0 And fq > 0.0 Then
Var t As Double = (0.0 - fp) / (fq - fp)
cp.Set(px + t * (qx - px), py + t * (qy - py))
ElseIf fq < 0.0 And fp > 0.0 Then
Var t As Double = (0.0 - fq) / (fp - fq)
cq.Set(qx + t * (px - qx), qy + t * (py - qy))
End If
Else
# Clip to the segment end.
If fp > bound And fq < bound Then
Var t As Double = (fp - bound) / (fp - fq)
cp.Set(px + t * (qx - px), py + t * (qy - py))
ElseIf fq > bound And fp < bound Then
Var t As Double = (fq - bound) / (fq - fp)
cq.Set(qx + t * (px - qx), qy + t * (py - qy))
End If
End If
End Sub

## Clamps the value to the zero-to-one range.
Shared Function Clamp01(value As Double) As Double
If value < 0.0 Then
Return 0.0
End If
If value > 1.0 Then
Return 1.0
End If
Return value
End Function
## Computes the manifold between a chain segment and a circle into a new
## manifold, ported from upstream b2CollideChainSegmentAndCircle.
Shared Function CollideChainSegmentAndCircle(segmentA As ChainSegment, transformA As Transform, circleB As Circle, transformB As Transform) As Manifold
Var out As New Manifold
Collide.CollideChainSegmentAndCircleTo(segmentA, transformA, circleB, transformB, out)
Return out
End Function

## Computes the manifold between a chain segment and a circle into the
## caller-owned out manifold and returns out.
Shared Function CollideChainSegmentAndCircleTo(segmentA As ChainSegment, transformA As Transform, circleB As Circle, transformB As Transform, out As Manifold) As Manifold
out.Reset()

Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - transformA.P.X
Var dy As Double = transformB.P.Y - transformA.P.Y
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

# Circle in the frame of the segment.
Var pBX As Double = c * circleB.Center.X - s * circleB.Center.Y + px
Var pBY As Double = s * circleB.Center.X + c * circleB.Center.Y + py

Var p1x As Double = segmentA.Segment.Point1.X
Var p1y As Double = segmentA.Segment.Point1.Y
Var p2x As Double = segmentA.Segment.Point2.X
Var p2y As Double = segmentA.Segment.Point2.Y
Var ex As Double = p2x - p1x
Var ey As Double = p2y - p1y

# Normal points to the right: dot(rightPerp(e), pB - p1).
Var offset As Double = ey * (pBX - p1x) - ex * (pBY - p1y)
If offset < 0.0 Then
# Collision is one-sided.
Return out
End If

# Barycentric coordinates.
Var u As Double = ex * (p2x - pBX) + ey * (p2y - pBY)
Var v As Double = ex * (pBX - p1x) + ey * (pBY - p1y)

Var pAX As Double = 0.0
Var pAY As Double = 0.0

If v <= 0.0 Then
# Behind point1: is pB in the Voronoi region of the previous edge?
Var prevEx As Double = p1x - segmentA.Ghost1.X
Var prevEy As Double = p1y - segmentA.Ghost1.Y
Var uPrev As Double = prevEx * (pBX - p1x) + prevEy * (pBY - p1y)
If uPrev <= 0.0 Then
Return out
End If
pAX = p1x
pAY = p1y
ElseIf u <= 0.0 Then
# Ahead of point2: is pB in the Voronoi region of the next edge?
Var nextEx As Double = segmentA.Ghost2.X - p2x
Var nextEy As Double = segmentA.Ghost2.Y - p2y
Var vNext As Double = nextEx * (pBX - p2x) + nextEy * (pBY - p2y)
If vNext > 0.0 Then
Return out
End If
pAX = p2x
pAY = p2y
Else
Var ee As Double = ex * ex + ey * ey
If ee > 0.0 Then
pAX = (u * p1x + v * p2x) / ee
pAY = (u * p1y + v * p2y) / ee
Else
pAX = p1x
pAY = p1y
End If
End If

Var diffX As Double = pBX - pAX
Var diffY As Double = pBY - pAY
Var distance As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If distance > PhysicsConstants.FLT_EPSILON Then
Var invDistance As Double = 1.0 / distance
nx = invDistance * diffX
ny = invDistance * diffY
End If

Var radius As Double = circleB.Radius
Var separation As Double = distance - radius
If separation > PhysicsConstants.SPECULATIVE_DISTANCE Then
Return out
End If

Var cBX As Double = pBX - radius * nx
Var cBY As Double = pBY - radius * ny
Var contactX As Double = 0.5 * (pAX + cBX)
Var contactY As Double = 0.5 * (pAY + cBY)

Var qc As Double = transformA.Q.C
Var qs As Double = transformA.Q.S
out.Normal.Set(qc * nx - qs * ny, qs * nx + qc * ny)

Var anchorX As Double = qc * contactX - qs * contactY
Var anchorY As Double = qs * contactX + qc * contactY
Var mp As ManifoldPoint = out.Point1
mp.AnchorA.Set(anchorX, anchorY)
mp.AnchorB.Set(anchorX + transformA.P.X - transformB.P.X, anchorY + transformA.P.Y - transformB.P.Y)
mp.Point.Set(transformA.P.X + anchorX, transformA.P.Y + anchorY)
mp.Separation = separation
mp.Id = 0
out.PointCount = 1
Return out
End Function

## Computes the manifold between a chain segment and a capsule into a new
## manifold, ported from upstream b2CollideChainSegmentAndCapsule. The
## cache is input and output: set its count to zero on the first call.
Shared Function CollideChainSegmentAndCapsule(segmentA As ChainSegment, transformA As Transform, capsuleB As Capsule, transformB As Transform, cache As SimplexCache) As Manifold
Var out As New Manifold
Collide.CollideChainSegmentAndCapsuleTo(segmentA, transformA, capsuleB, transformB, cache, out)
Return out
End Function

## Computes the manifold between a chain segment and a capsule into the
## caller-owned out manifold and returns out.
Shared Function CollideChainSegmentAndCapsuleTo(segmentA As ChainSegment, transformA As Transform, capsuleB As Capsule, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var scratch As CollideScratch = out.Scratch()
Var polyVerts As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyVertices, 2)
Var polyNormals As Array(Of Vector2) = scratch.GrowPoints(scratch.CapsulePolyNormals, 2)

Var ex As Double = capsuleB.Center2.X - capsuleB.Center1.X
Var ey As Double = capsuleB.Center2.Y - capsuleB.Center1.Y
Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
nx = ey / length
ny = -ex / length
End If

polyVerts[0].Set(capsuleB.Center1.X, capsuleB.Center1.Y)
polyVerts[1].Set(capsuleB.Center2.X, capsuleB.Center2.Y)
polyNormals[0].Set(nx, ny)
polyNormals[1].Set(-nx, -ny)

Var centroidX As Double = 0.5 * (capsuleB.Center1.X + capsuleB.Center2.X)
Var centroidY As Double = 0.5 * (capsuleB.Center1.Y + capsuleB.Center2.Y)

Return Collide.CollideChainSegmentAndPolygonCoreTo(segmentA, transformA, polyVerts, polyNormals, 2, centroidX, centroidY, capsuleB.Radius, transformB, cache, scratch, out)
End Function

## Computes the manifold between a chain segment and a convex polygon into
## a new manifold, ported from upstream b2CollideChainSegmentAndPolygon.
## The cache is input and output: set its count to zero on the first call.
Shared Function CollideChainSegmentAndPolygon(segmentA As ChainSegment, transformA As Transform, polygonB As Polygon, transformB As Transform, cache As SimplexCache) As Manifold
Var out As New Manifold
Collide.CollideChainSegmentAndPolygonTo(segmentA, transformA, polygonB, transformB, cache, out)
Return out
End Function

## Computes the manifold between a chain segment and a convex polygon into
## the caller-owned out manifold and returns out.
Shared Function CollideChainSegmentAndPolygonTo(segmentA As ChainSegment, transformA As Transform, polygonB As Polygon, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var scratch As CollideScratch = out.Scratch()
Return Collide.CollideChainSegmentAndPolygonCoreTo(segmentA, transformA, polygonB.Vertices, polygonB.Normals, polygonB.Count, polygonB.Centroid.X, polygonB.Centroid.Y, polygonB.Radius, transformB, cache, scratch, out)
End Function

## Scalar core of the chain-segment-versus-polygon manifold with ghost
## smoothing, ported from upstream b2CollideChainSegmentAndPolygon.
Shared Function CollideChainSegmentAndPolygonCoreTo(segmentA As ChainSegment, transformA As Transform, vertsB() As Vector2, normalsB() As Vector2, countB As Integer, centroidBX As Double, centroidBY As Double, radiusB As Double, transformB As Transform, cache As SimplexCache, scratch As CollideScratch, out As Manifold) As Manifold
out.Reset()

Var c As Double = transformA.Q.C * transformB.Q.C + transformA.Q.S * transformB.Q.S
Var s As Double = -transformA.Q.S * transformB.Q.C + transformA.Q.C * transformB.Q.S
Var dx As Double = transformB.P.X - transformA.P.X
Var dy As Double = transformB.P.Y - transformA.P.Y
Var px As Double = transformA.Q.C * dx + transformA.Q.S * dy
Var py As Double = -transformA.Q.S * dx + transformA.Q.C * dy

Var centroidX As Double = c * centroidBX - s * centroidBY + px
Var centroidY As Double = s * centroidBX + c * centroidBY + py

Var p1x As Double = segmentA.Segment.Point1.X
Var p1y As Double = segmentA.Segment.Point1.Y
Var p2x As Double = segmentA.Segment.Point2.X
Var p2y As Double = segmentA.Segment.Point2.Y

Var edge1x As Double = p2x - p1x
Var edge1y As Double = p2y - p1y
Var edge1Length As Double = Maths.Sqrt(edge1x * edge1x + edge1y * edge1y)
Var e1x As Double = 0.0
Var e1y As Double = 0.0
If edge1Length > PhysicsConstants.FLT_EPSILON Then
e1x = edge1x / edge1Length
e1y = edge1y / edge1Length
End If

Var params As ChainParams = scratch.ChainParams
params.Edge1.Set(e1x, e1y)

Var convexTol As Double = 0.01
Var edge0x As Double = p1x - segmentA.Ghost1.X
Var edge0y As Double = p1y - segmentA.Ghost1.Y
Var edge0Length As Double = Maths.Sqrt(edge0x * edge0x + edge0y * edge0y)
Var u0x As Double = 0.0
Var u0y As Double = 0.0
If edge0Length > PhysicsConstants.FLT_EPSILON Then
u0x = edge0x / edge0Length
u0y = edge0y / edge0Length
End If
# Right perpendicular: (y, -x).
params.Normal0.Set(u0y, -u0x)
Var cross01 As Double = u0x * e1y - u0y * e1x
params.Convex1 = cross01 >= convexTol

Var edge2x As Double = segmentA.Ghost2.X - p2x
Var edge2y As Double = segmentA.Ghost2.Y - p2y
Var edge2Length As Double = Maths.Sqrt(edge2x * edge2x + edge2y * edge2y)
Var u2x As Double = 0.0
Var u2y As Double = 0.0
If edge2Length > PhysicsConstants.FLT_EPSILON Then
u2x = edge2x / edge2Length
u2y = edge2y / edge2Length
End If
params.Normal2.Set(u2y, -u2x)
Var cross12 As Double = e1x * u2y - e1y * u2x
params.Convex2 = cross12 >= convexTol

# Normal points to the right.
Var normal1x As Double = e1y
Var normal1y As Double = -e1x
Var behind1 As Boolean = normal1x * (centroidX - p1x) + normal1y * (centroidY - p1y) < 0.0
Var behind0 As Boolean = True
Var behind2 As Boolean = True
If params.Convex1 Then
behind0 = params.Normal0.X * (centroidX - p1x) + params.Normal0.Y * (centroidY - p1y) < 0.0
End If
If params.Convex2 Then
behind2 = params.Normal2.X * (centroidX - p2x) + params.Normal2.Y * (centroidY - p2y) < 0.0
End If

If behind1 And behind0 And behind2 Then
# One-sided collision.
Return out
End If
params.Behind1 = behind1

# Get the polygon in frame A.
Var vertices As Array(Of Vector2) = scratch.GrowPoints(scratch.ChainVertices, countB)
Var normals As Array(Of Vector2) = scratch.GrowPoints(scratch.ChainNormals, countB)
For i As Integer = 0 To countB - 1
vertices[i].Set(c * vertsB[i].X - s * vertsB[i].Y + px, s * vertsB[i].X + c * vertsB[i].Y + py)
normals[i].Set(c * normalsB[i].X - s * normalsB[i].Y, s * normalsB[i].X + c * normalsB[i].Y)
Next i

# Distance does not work correctly with partial polygons: use the core
# segment as a two-point proxy.
Var proxyA As ShapeProxy = scratch.ChainProxyA
proxyA.Count = 2
proxyA.Radius = 0.0
Var proxyAPoints As Array(Of Vector2) = scratch.GrowPoints(scratch.ChainProxyPoints, 2)
proxyA.Points = proxyAPoints
proxyAPoints[0].Set(p1x, p1y)
proxyAPoints[1].Set(p2x, p2y)

Var input As DistanceInput = scratch.ChainDistanceInput
input.ProxyA = proxyA
input.ProxyB = scratch.ChainProxyB
input.UseRadii = False
Var proxyB As ShapeProxy = scratch.ChainProxyB
proxyB.Count = countB
proxyB.Radius = 0.0
Var proxyBPoints As Array(Of Vector2) = scratch.GrowPoints(scratch.ChainProxyBPoints, countB)
proxyB.Points = proxyBPoints
For i As Integer = 0 To countB - 1
proxyBPoints[i].Set(vertices[i].X, vertices[i].Y)
Next i
input.TransformA = Transform.Identity()
input.TransformB = Transform.Identity()

Var output As DistanceOutput = scratch.ChainDistanceOutput
Distance.ShapeDistanceTo(input, cache, output)

If output.Distance > radiusB + PhysicsConstants.SPECULATIVE_DISTANCE Then
Return out
End If

Return Collide.ChainFinish(transformA, transformB, p1x, p1y, p2x, p2y, normal1x, normal1y, vertices, normals, countB, radiusB, output, cache, scratch, out)
End Function

## Resolves the chain manifold after the distance query, ported from the
## second half of upstream b2CollideChainSegmentAndPolygon.
Shared Function ChainFinish(transformA As Transform, transformB As Transform, p1x As Double, p1y As Double, p2x As Double, p2y As Double, normal1x As Double, normal1y As Double, vertices() As Vector2, normals() As Vector2, countB As Integer, radiusB As Double, output As DistanceOutput, cache As SimplexCache, scratch As CollideScratch, out As Manifold) As Manifold
Var params As ChainParams = scratch.ChainParams

# Index of the incident vertex or normal on the polygon.
scratch.ChainIncidentIndex = -1
scratch.ChainIncidentNormal = -1

If Not params.Behind1 And output.Distance > 0.1 * PhysicsConstants.LINEAR_SLOP Then
# The closest features may be two vertices or an edge and a vertex
# even when there should be face contact. The response returns 0 to
# skip contact, 1 when the manifold has been written, or 2 to snap to
# the segment normal.
Var status As Integer = 0
If cache.Count = 1 Then
status = Collide.ChainVertexVertex(params, output, cache, transformA, transformB, radiusB, scratch, out)
Else
status = Collide.ChainVertexEdge(params, output, cache, p1x, p1y, p2x, p2y, normal1x, normal1y, vertices, normals, countB, radiusB, transformA, transformB, scratch, out)
End If

If status = 2 Then
Return Collide.ChainFinalClip(p1x, p1y, p2x, p2y, normal1x, normal1y, scratch.ChainIncidentNormal, scratch.ChainIncidentIndex, vertices, normals, countB, radiusB, transformA, transformB, out)
End If
Return out
End If

# SAT edge normal.
Return Collide.ChainSatSelection(p1x, p1y, p2x, p2y, normal1x, normal1y, vertices, normals, countB, radiusB, transformA, transformB, scratch, out)
End Function

## Handles the vertex-vertex chain response. Returns 0 to skip contact, 1
## when the manifold has been written, or 2 to snap to the segment normal
## with the incident vertex recorded in the scratch workspace.
Shared Function ChainVertexVertex(params As ChainParams, output As DistanceOutput, cache As SimplexCache, transformA As Transform, transformB As Transform, radiusB As Double, scratch As CollideScratch, out As Manifold) As Integer
Var pAX As Double = output.PointA.X
Var pAY As Double = output.PointA.Y
Var pBX As Double = output.PointB.X
Var pBY As Double = output.PointB.Y

Var diffX As Double = pBX - pAX
Var diffY As Double = pBY - pAY
Var length As Double = Maths.Sqrt(diffX * diffX + diffY * diffY)
Var nx As Double = 0.0
Var ny As Double = 0.0
If length > PhysicsConstants.FLT_EPSILON Then
nx = diffX / length
ny = diffY / length
End If

Var normalType As ChainNormalType = Collide.ClassifyNormal(params, nx, ny)
If normalType = ChainNormalType.NormalSkip Then
Return 0
End If

If normalType = ChainNormalType.NormalAdmit Then
Var qc As Double = transformA.Q.C
Var qs As Double = transformA.Q.S
out.Normal.Set(qc * nx - qs * ny, qs * nx + qc * ny)
Var cp As ManifoldPoint = out.Point1
cp.AnchorA.Set(qc * pAX - qs * pAY, qs * pAX + qc * pAY)
cp.AnchorB.Set(cp.AnchorA.X + transformA.P.X - transformB.P.X, cp.AnchorA.Y + transformA.P.Y - transformB.P.Y)
cp.Point.Set(transformA.P.X + cp.AnchorA.X, transformA.P.Y + cp.AnchorA.Y)
cp.Separation = output.Distance - radiusB
cp.Id = cache.IndexA[0] * 256 + cache.IndexB[0]
out.PointCount = 1
Return 1
End If

# Fall through NormalSnap.
scratch.ChainIncidentIndex = cache.IndexB[0]
Return 2
End Function

## Handles the vertex-edge chain response. Returns 0 to skip contact, 1
## when the manifold has been written, or 2 to snap to the segment normal
## with the incident feature recorded in the scratch workspace.
Shared Function ChainVertexEdge(params As ChainParams, output As DistanceOutput, cache As SimplexCache, p1x As Double, p1y As Double, p2x As Double, p2y As Double, normal1x As Double, normal1y As Double, vertices() As Vector2, normals() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, scratch As CollideScratch, out As Manifold) As Integer
Var ia1 As Integer = cache.IndexA[0]
Var ia2 As Integer = cache.IndexA[1]
Var ib1 As Integer = cache.IndexB[0]
Var ib2 As Integer = cache.IndexB[1]

If ia1 <> ia2 Then
# Get the index of the incident polygon vertex.
Var vd1 As Double = normal1x * (vertices[ib1].X - p1x) + normal1y * (vertices[ib1].Y - p1y)
Var vd2 As Double = normal1x * (vertices[ib2].X - p2x) + normal1y * (vertices[ib2].Y - p2y)
scratch.ChainIncidentIndex = ib2
If vd1 < vd2 Then
scratch.ChainIncidentIndex = ib1
End If
Return 2
End If

# One point on A, expect two points on B: find the polygon normal most
# aligned with the vector between closest points; this effectively sorts
# ib1 and ib2.
Var dirX As Double = output.PointA.X - output.PointB.X
Var dirY As Double = output.PointA.Y - output.PointB.Y
Var fd1 As Double = dirX * normals[ib1].X + dirY * normals[ib1].Y
Var fd2 As Double = dirX * normals[ib2].X + dirY * normals[ib2].Y
Var ib As Integer = ib2
If fd1 > fd2 Then
ib = ib1
End If

# Use the accurate normal.
Var normalBx As Double = normals[ib].X
Var normalBy As Double = normals[ib].Y

Var normalType As ChainNormalType = Collide.ClassifyNormal(params, -normalBx, -normalBy)
If normalType = ChainNormalType.NormalSkip Then
Return 0
End If

If normalType = ChainNormalType.NormalSnap Then
# Fall through NormalSnap.
scratch.ChainIncidentNormal = ib
Return 2
End If

# Get the polygon edge associated with the normal.
Var eb1 As Integer = ib
Var eb2 As Integer = ib + 1
If eb2 > countB - 1 Then
eb2 = 0
End If

# Find the incident segment vertex.
Var sd1 As Double = normalBx * (p1x - vertices[eb1].X) + normalBy * (p1y - vertices[eb1].Y)
Var sd2 As Double = normalBx * (p2x - vertices[eb1].X) + normalBy * (p2y - vertices[eb1].Y)
If Collide.ChainNeighbourIncident(params, normal1x, normal1y, normalBx, normalBy, sd1, sd2) Then
# The neighbour is incident.
Return 0
End If

Collide.ChainPolygonEdgeClip(vertices[eb1].X, vertices[eb1].Y, vertices[eb2].X, vertices[eb2].Y, p1x, p1y, p2x, p2y, normalBx, normalBy, radiusB, eb1 * 256 + 1, eb2 * 256 + 0, transformA, transformB, out)
Return 1
End Function

## SAT selection path of the chain-segment-versus-polygon manifold, ported
## from the edge-normal branch of upstream b2CollideChainSegmentAndPolygon.
Shared Function ChainSatSelection(p1x As Double, p1y As Double, p2x As Double, p2y As Double, normal1x As Double, normal1y As Double, vertices() As Vector2, normals() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, scratch As CollideScratch, out As Manifold) As Manifold
Var params As ChainParams = scratch.ChainParams

Var edgeSeparation As Double = Collide.ChainEdgeScan(vertices, countB, normal1x, normal1y, p1x, p1y, scratch)
Var incidentIndex As Integer = scratch.ChainIncidentIndex

# Check the convex neighbour for edge separation.
If params.Convex1 Then
Var s0 As Double = Collide.ChainEdgeScan(vertices, countB, params.Normal0.X, params.Normal0.Y, p1x, p1y, scratch)
If s0 > edgeSeparation Then
edgeSeparation = s0
# The neighbour owns the edge separation.
incidentIndex = -1
End If
End If

If params.Convex2 Then
Var s2 As Double = Collide.ChainEdgeScan(vertices, countB, params.Normal2.X, params.Normal2.Y, p2x, p2y, scratch)
If s2 > edgeSeparation Then
edgeSeparation = s2
# The neighbour owns the edge separation.
incidentIndex = -1
End If
End If

# SAT polygon normals.
Var polygonSeparation As Double = -1.7976931348623157e308
Var referenceIndex As Integer = -1

For i As Integer = 0 To countB - 1
Var nx As Double = normals[i].X
Var ny As Double = normals[i].Y

Var normalType As ChainNormalType = Collide.ClassifyNormal(params, -nx, -ny)
If normalType <> ChainNormalType.NormalAdmit Then
Continue
End If

Var px As Double = vertices[i].X
Var py As Double = vertices[i].Y
Var sep1 As Double = nx * (p2x - px) + ny * (p2y - py)
Var sep2 As Double = nx * (p1x - px) + ny * (p1y - py)
Var s As Double = sep1
If sep2 < s Then
s = sep2
End If

If s > polygonSeparation Then
polygonSeparation = s
referenceIndex = i
End If
Next i

If polygonSeparation > edgeSeparation Then
Var ia1 As Integer = referenceIndex
Var ia2 As Integer = ia1 + 1
If ia2 > countB - 1 Then
ia2 = 0
End If
Var a1x As Double = vertices[ia1].X
Var a1y As Double = vertices[ia1].Y
Var a2x As Double = vertices[ia2].X
Var a2y As Double = vertices[ia2].Y

Var nx As Double = normals[ia1].X
Var ny As Double = normals[ia1].Y

Var dot1 As Double = nx * (p1x - a1x) + ny * (p1y - a1y)
Var dot2 As Double = nx * (p2x - a1x) + ny * (p2y - a1y)

If Collide.ChainNeighbourIncident(params, normal1x, normal1y, nx, ny, dot1, dot2) Then
# The neighbour is incident.
Return out
End If

Collide.ChainPolygonEdgeClip(a1x, a1y, a2x, a2y, p1x, p1y, p2x, p2y, nx, ny, radiusB, ia1 * 256 + 1, ia2 * 256 + 0, transformA, transformB, out)
Return out
End If

If incidentIndex = -1 Then
# The neighbouring segment is the separating axis.
Return out
End If

# Fall through to the segment normal axis.
Return Collide.ChainFinalClip(p1x, p1y, p2x, p2y, normal1x, normal1y, -1, incidentIndex, vertices, normals, countB, radiusB, transformA, transformB, out)
End Function

## Finds the minimum separation of the polygon vertices along a direction
## relative to a point and records the argmin index in the scratch
## workspace.
Shared Function ChainEdgeScan(vertices() As Vector2, countB As Integer, dirX As Double, dirY As Double, px As Double, py As Double, scratch As CollideScratch) As Double
Var best As Double = 1.7976931348623157e308
Var bestIndex As Integer = -1
For i As Integer = 0 To countB - 1
Var sep As Double = dirX * (vertices[i].X - px) + dirY * (vertices[i].Y - py)
If sep < best Then
best = sep
bestIndex = i
End If
Next i
scratch.ChainIncidentIndex = bestIndex
Return best
End Function

## Returns True when the neighbouring ghost segment, not the core edge,
## owns the contact and the manifold must be skipped. The ghost normals
## are snapped to the core segment normal at concave vertices.
Shared Function ChainNeighbourIncident(params As ChainParams, normal1x As Double, normal1y As Double, nx As Double, ny As Double, dot1 As Double, dot2 As Double) As Boolean
Var n0x As Double = params.Normal0.X
Var n0y As Double = params.Normal0.Y
If Not params.Convex1 Then
n0x = normal1x
n0y = normal1y
End If

If dot1 < dot2 Then
Return n0x * nx + n0y * ny < normal1x * nx + normal1y * ny
End If

Var n2x As Double = params.Normal2.X
Var n2y As Double = params.Normal2.Y
If Not params.Convex2 Then
n2x = normal1x
n2y = normal1y
End If
Return n2x * nx + n2y * ny < normal1x * nx + normal1y * ny
End Function

## Clips a polygon edge against the segment and converts the resulting
## manifold to world space with the negated polygon normal. Ported from
## the polygon face paths of upstream b2CollideChainSegmentAndPolygon.
Shared Sub ChainPolygonEdgeClip(a1x As Double, a1y As Double, a2x As Double, a2y As Double, p1x As Double, p1y As Double, p2x As Double, p2y As Double, nx As Double, ny As Double, radiusB As Double, id1 As Integer, id2 As Integer, transformA As Transform, transformB As Transform, out As Manifold)
Collide.ClipSegments(a1x, a1y, a2x, a2y, p1x, p1y, p2x, p2y, nx, ny, radiusB, 0.0, id1, id2, out)

If out.PointCount = 2 Then
Collide.ConvertChainManifoldToWorld(transformA, transformB, -nx, -ny, out)
End If
End Sub

## Final segment-normal clip of the chain-segment-versus-polygon manifold.
## The incident feature comes from either a snapped polygon normal or a
## snapped polygon vertex.
Shared Function ChainFinalClip(p1x As Double, p1y As Double, p2x As Double, p2y As Double, normal1x As Double, normal1y As Double, incidentNormal As Integer, incidentIndex As Integer, vertices() As Vector2, normals() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, out As Manifold) As Manifold
Var ib1 As Integer = 0
Var ib2 As Integer = 0
Var b1x As Double = 0.0
Var b1y As Double = 0.0
Var b2x As Double = 0.0
Var b2y As Double = 0.0

If incidentNormal <> -1 Then
ib1 = incidentNormal
ib2 = ib1 + 1
If ib2 > countB - 1 Then
ib2 = 0
End If
Else
Var i2 As Integer = incidentIndex
Var i1 As Integer = i2 - 1
If i1 < 0 Then
i1 = countB - 1
End If
Var d1 As Double = normal1x * normals[i1].X + normal1y * normals[i1].Y
Var d2 As Double = normal1x * normals[i2].X + normal1y * normals[i2].Y
If d1 < d2 Then
ib1 = i1
ib2 = i2
Else
ib1 = i2
ib2 = i2 + 1
If ib2 > countB - 1 Then
ib2 = 0
End If
End If
End If
b1x = vertices[ib1].X
b1y = vertices[ib1].Y
b2x = vertices[ib2].X
b2y = vertices[ib2].Y

Collide.ClipSegments(p1x, p1y, p2x, p2y, b1x, b1y, b2x, b2y, normal1x, normal1y, 0.0, radiusB, 0 * 256 + ib2, 1 * 256 + ib1, out)

If out.PointCount = 2 Then
Collide.ConvertChainManifoldToWorld(transformA, transformB, normal1x, normal1y, out)
End If

Return out
End Function

## Final segment-normal clip of the chain-segment-versus-polygon manifold.
Shared Function ChainFinalClip(p1x As Double, p1y As Double, p2x As Double, p2y As Double, normal1x As Double, normal1y As Double, incidentIndex As Integer, vertices() As Vector2, normals() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, out As Manifold) As Manifold
Var ib1 As Integer = 0
Var ib2 As Integer = 0
Var b1x As Double = 0.0
Var b1y As Double = 0.0
Var b2x As Double = 0.0
Var b2y As Double = 0.0

Var i2 As Integer = incidentIndex
Var i1 As Integer = i2 - 1
If i1 < 0 Then
i1 = countB - 1
End If
Var d1 As Double = normal1x * normals[i1].X + normal1y * normals[i1].Y
Var d2 As Double = normal1x * normals[i2].X + normal1y * normals[i2].Y
If d1 < d2 Then
ib1 = i1
ib2 = i2
Else
ib1 = i2
ib2 = i2 + 1
If ib2 > countB - 1 Then
ib2 = 0
End If
End If
b1x = vertices[ib1].X
b1y = vertices[ib1].Y
b2x = vertices[ib2].X
b2y = vertices[ib2].Y

Collide.ClipSegments(p1x, p1y, p2x, p2y, b1x, b1y, b2x, b2y, normal1x, normal1y, 0.0, radiusB, 0 * 256 + ib2, 1 * 256 + ib1, out)

If out.PointCount = 2 Then
Collide.ConvertChainManifoldToWorld(transformA, transformB, normal1x, normal1y, out)
End If

Return out
End Function

## Converts a chain manifold from frame A to world space.
Shared Sub ConvertChainManifoldToWorld(transformA As Transform, transformB As Transform, normalX As Double, normalY As Double, out As Manifold)
Var qc As Double = transformA.Q.C
Var qs As Double = transformA.Q.S
out.Normal.Set(qc * normalX - qs * normalY, qs * normalX + qc * normalY)
out.Point1.AnchorA.Set(qc * out.Point1.AnchorA.X - qs * out.Point1.AnchorA.Y, qs * out.Point1.AnchorA.X + qc * out.Point1.AnchorA.Y)
out.Point2.AnchorA.Set(qc * out.Point2.AnchorA.X - qs * out.Point2.AnchorA.Y, qs * out.Point2.AnchorA.X + qc * out.Point2.AnchorA.Y)
Var pABx As Double = transformA.P.X - transformB.P.X
Var pABy As Double = transformA.P.Y - transformB.P.Y
out.Point1.AnchorB.Set(out.Point1.AnchorA.X + pABx, out.Point1.AnchorA.Y + pABy)
out.Point2.AnchorB.Set(out.Point2.AnchorA.X + pABx, out.Point2.AnchorA.Y + pABy)
out.Point1.Point.Set(transformA.P.X + out.Point1.AnchorA.X, transformA.P.Y + out.Point1.AnchorA.Y)
out.Point2.Point.Set(transformA.P.X + out.Point2.AnchorA.X, transformA.P.Y + out.Point2.AnchorA.Y)
End Sub

## Clips two segments against each other and writes a two-point manifold in
## the local frame, ported from upstream b2ClipSegments.
Shared Sub ClipSegments(a1x As Double, a1y As Double, a2x As Double, a2y As Double, b1x As Double, b1y As Double, b2x As Double, b2y As Double, nx As Double, ny As Double, ra As Double, rb As Double, id1 As Integer, id2 As Integer, out As Manifold)
out.Reset()

# Left perpendicular of the normal.
Var tangentX As Double = -ny
Var tangentY As Double = nx

# Barycentric coordinates of each point relative to a1 along the
# tangent.
Var lower1 As Double = 0.0
Var upper1 As Double = (a2x - a1x) * tangentX + (a2y - a1y) * tangentY

# Incident edge points opposite of tangent due to CCW winding.
Var upper2 As Double = (b1x - a1x) * tangentX + (b1y - a1y) * tangentY
Var lower2 As Double = (b2x - a1x) * tangentX + (b2y - a1y) * tangentY

# Do the segments overlap?
If upper2 < lower1 Or upper1 < lower2 Then
Return
End If

Var vLowerX As Double = b2x
Var vLowerY As Double = b2y
If lower2 < lower1 And upper2 - lower2 > PhysicsConstants.FLT_EPSILON Then
Var tLower As Double = (lower1 - lower2) / (upper2 - lower2)
vLowerX = b2x + tLower * (b1x - b2x)
vLowerY = b2y + tLower * (b1y - b2y)
End If

Var vUpperX As Double = b1x
Var vUpperY As Double = b1y
If upper2 > upper1 And upper2 - lower2 > PhysicsConstants.FLT_EPSILON Then
Var tUpper As Double = (upper1 - lower2) / (upper2 - lower2)
vUpperX = b2x + tUpper * (b1x - b2x)
vUpperY = b2y + tUpper * (b1y - b2y)
End If

Var separationLower As Double = (vLowerX - a1x) * nx + (vLowerY - a1y) * ny
Var separationUpper As Double = (vUpperX - a1x) * nx + (vUpperY - a1y) * ny

# Put contact points at the midpoint, accounting for radii.
vLowerX = vLowerX + 0.5 * (ra - rb - separationLower) * nx
vLowerY = vLowerY + 0.5 * (ra - rb - separationLower) * ny
vUpperX = vUpperX + 0.5 * (ra - rb - separationUpper) * nx
vUpperY = vUpperY + 0.5 * (ra - rb - separationUpper) * ny

Var radius As Double = ra + rb

out.Normal.Set(nx, ny)
out.Point1.AnchorA.Set(vLowerX, vLowerY)
out.Point1.Separation = separationLower - radius
out.Point1.Id = id1

out.Point2.AnchorA.Set(vUpperX, vUpperY)
out.Point2.Separation = separationUpper - radius
out.Point2.Id = id2

out.PointCount = 2
End Sub

## Evaluates the Gauss map of a contact normal against the chain ghost
## geometry, ported from upstream b2ClassifyNormal. Returns a
## ChainNormalType value.
Shared Function ClassifyNormal(params As ChainParams, nx As Double, ny As Double) As ChainNormalType
Var sinTol As Double = 0.01

If nx * params.Edge1.X + ny * params.Edge1.Y <= 0.0 Then
# The normal points towards the segment tail.
If params.Convex1 Then
If nx * params.Normal0.Y - ny * params.Normal0.X > sinTol Then
Return ChainNormalType.NormalSkip
End If
Return ChainNormalType.NormalAdmit
End If
Return ChainNormalType.NormalSnap
End If

# The normal points towards the segment head.
If params.Convex2 Then
If params.Normal2.X * ny - params.Normal2.Y * nx > sinTol Then
Return ChainNormalType.NormalSkip
End If
Return ChainNormalType.NormalAdmit
End If
Return ChainNormalType.NormalSnap
End Function
End Class

# Engine-internal reusable workspace for the warm collision path. Owned by
# a Manifold and created lazily so repeated narrow-phase queries allocate
# nothing. Not part of the public engine surface.
Class CollideScratch
## Local polygon A vertices after shifting to the origin.
Property PolyAVertices() As Vector2
## Local polygon A normals.
Property PolyANormals() As Vector2
## Local polygon B vertices in frame A.
Property PolyBVertices() As Vector2
## Local polygon B normals in frame A.
Property PolyBNormals() As Vector2
## Vertices of the incident polygon used by chain collisions.
Property ChainVertices() As Vector2
## Normals of the incident polygon used by chain collisions.
Property ChainNormals() As Vector2
## Two-point proxy for chain segment distance.
Property ChainProxyA As ShapeProxy
## Polygon proxy for chain segment distance.
Property ChainProxyB As ShapeProxy
## Segment proxy points for chain segment distance.
Property ChainProxyPoints() As Vector2
## Polygon proxy points for chain segment distance.
Property ChainProxyBPoints() As Vector2
## Distance input reused by chain polygon collisions.
Property ChainDistanceInput As DistanceInput
## Distance output reused by chain polygon collisions.
Property ChainDistanceOutput As DistanceOutput
## Segment distance result reused by capsule and polygon pairings.
Property SegmentResult As SegmentDistanceResult
## The transform mapping frame B into shifted frame A.
Property RelativeTransform As Transform
## Shape A shifted so its first vertex sits at the origin.
Property ShiftedTransformA As Transform
## Chain smoothing parameters.
Property ChainParams As ChainParams
## Incident vertex or normal index carried between chain helpers.
Property ChainIncidentIndex As Integer
## Incident normal index carried between chain helpers.
Property ChainIncidentNormal As Integer
## Edge index chosen by the polygon SAT on shape A.
Property EdgeIndexA As Integer
## Edge index chosen by the polygon SAT on shape B.
Property EdgeIndexB As Integer
## Separation found by the most recent SAT query.
Property EdgeSeparation As Double
## Two-vertex stand-in polygon for segment-as-polygon pairings.
Property CapsulePolyVertices() As Vector2
## Two normals of the stand-in polygon.
Property CapsulePolyNormals() As Vector2
## Right-perpendicular holder for the capsule A SAT normal.
Property ClipNormalA As Vector2
## Right-perpendicular holder for the capsule B SAT normal.
Property ClipNormalB As Vector2
## First clip endpoint holder for the capsule pairing.
Property ClipCp As Vector2
## Second clip endpoint holder for the capsule pairing.
Property ClipCq As Vector2

## Creates the workspace with empty storage.
Constructor()
Me.PolyAVertices = New Array(Of Vector2)
Me.PolyANormals = New Array(Of Vector2)
Me.PolyBVertices = New Array(Of Vector2)
Me.PolyBNormals = New Array(Of Vector2)
Me.ChainVertices = New Array(Of Vector2)
Me.ChainNormals = New Array(Of Vector2)
Me.ChainProxyA = New ShapeProxy
Me.ChainProxyB = New ShapeProxy
Me.ChainProxyPoints = New Array(Of Vector2)
Me.ChainProxyBPoints = New Array(Of Vector2)
Me.ChainDistanceInput = New DistanceInput
Me.ChainDistanceOutput = New DistanceOutput
Me.SegmentResult = New SegmentDistanceResult
Me.RelativeTransform = New Transform
Me.ShiftedTransformA = New Transform
Me.ChainParams = New ChainParams
Me.ChainIncidentIndex = -1
Me.ChainIncidentNormal = -1
Me.EdgeIndexA = 0
Me.EdgeIndexB = 0
Me.EdgeSeparation = 0.0
Me.ClipNormalA = New Vector2(0.0, 0.0)
Me.ClipNormalB = New Vector2(0.0, 0.0)
Me.ClipCp = New Vector2(0.0, 0.0)
Me.ClipCq = New Vector2(0.0, 0.0)
End Constructor

## Returns an array of reusable vectors whose length is at least the given
## count, growing by allocation only when needed. Engine code only.
Function GrowPoints(arrayRef() As Vector2, count As Integer) As Array(Of Vector2)
While arrayRef.Count < count
arrayRef.Append(New Vector2(0.0, 0.0))
Wend
Return arrayRef
End Function
End Class

# A collision plane fed to the plane solver, ported from upstream
# b2CollisionPlane in collision.h. Users normally assemble these from
# PlaneResult values.
Class CollisionPlane
## The collision plane between the mover and some shape.
Property Plane As Plane

## The maximum accumulated push along the plane. Use positive infinity for
## a fully rigid plane; lower values soften the collision. In metres.
Property PushLimit As Double

## The push along the plane determined by Mover.SolvePlanes. In metres.
Property Push As Double

## True when Mover.ClipVector should clip velocity against this plane.
## Keep false for soft collision.
Property ClipVelocity As Boolean

## Creates a plane with unlimited push and velocity clipping enabled.
Constructor()
Me.Plane = New Plane
Me.PushLimit = 1.7976931348623157e308
Me.Push = 0.0
Me.ClipVelocity = True
End Constructor

## Creates a plane from a plane, push limit, and clip velocity flag.
Constructor(plane As Plane, pushLimit As Double, clipVelocity As Boolean)
Me.Plane = plane
Me.PushLimit = pushLimit
Me.Push = 0.0
Me.ClipVelocity = clipVelocity
End Constructor
End Class

# The constraint graph, ported from upstream b2ConstraintGraph in
# constraint_graph.h. Touching contacts live in one of twelve colours; the
# solver processes each colour independently because no body appears in two
# non-overflow colours. Joints join the colours in Stage 9.
Class ConstraintGraph
## The graph colours. Index 11 is the overflow colour.
Property Colors As Array(Of GraphColor)

## Creates all twelve colours. Non-overflow colours start with a body set
## sized for at least eight bodies, matching upstream b2CreateGraph.
Constructor(bodyCapacity As Integer)
Var capacity As Integer = bodyCapacity
If capacity < 8 Then
capacity = 8
End If
Me.Colors = New Array(Of GraphColor)
For i As Integer = 0 To PhysicsConstants.GRAPH_COLOUR_COUNT - 1
If i < PhysicsConstants.GRAPH_OVERFLOW_INDEX Then
Me.Colors.Append(New GraphColor(True, capacity))
Else
Me.Colors.Append(New GraphColor(False, 0))
End If
Next i
End Constructor

## Creates a placeholder for sparse array capacity.
Constructor()
Me.Colors = New Array(Of GraphColor)
End Constructor
End Class

# Cold contact record, ported from upstream b2Contact in contact.h. The
# record is the persistent identity used for pair lookup, body-edge
# bookkeeping, island connectivity, and solver-set membership. The heavy
# per-step data (manifold, mixing values, inverse masses) lives in the
# ContactSims store of whichever solver set owns the contact.
#
# A contact is destroyed when broad-phase proxies stop overlapping, a body
# or shape is destroyed, a body is disabled or changes type, or contact
# filtering is modified.
Class Contact
## Slot index of the owning solver set. NULL_INDEX when free.
Property SetIndex As Integer
## Constraint-graph colour index. NULL_INDEX for non-touching or sleeping
## contacts and for free slots.
Property ColorIndex As Integer
## Contact index within the owning set or graph colour. NULL_INDEX when
## free.
Property LocalIndex As Integer
## Body slot of edge zero.
Property Edge0BodyId As Integer
## Doubly linked list key of the previous contact on edge zero's body.
Property Edge0PrevKey As Integer
## Doubly linked list key of the next contact on edge zero's body.
Property Edge0NextKey As Integer
## Body slot of edge one.
Property Edge1BodyId As Integer
## Doubly linked list key of the previous contact on edge one's body.
Property Edge1PrevKey As Integer
## Doubly linked list key of the next contact on edge one's body.
Property Edge1NextKey As Integer
## Shape slot of the first shape.
Property ShapeIdA As Integer
## Shape slot of the second shape.
Property ShapeIdB As Integer
## Island linked list: previous contact in the island. NULL_INDEX when the
## contact is not touching or not linked.
Property IslandPrev As Integer
## Island linked list: next contact in the island.
Property IslandNext As Integer
## Island slot this contact belongs to when touching. NULL_INDEX otherwise.
Property IslandId As Integer
## This contact's own slot index, kept alongside the record like upstream.
Property ContactId As Integer
## Cold b2ContactFlags bits.
Property Flags As Integer
## Scratch mark used by island traversal.
Property IsMarked As Boolean

## Creates a free-record placeholder. Only the world may construct live
## contacts; the zero-argument form exists for sparse array capacity.
Constructor()
Me.SetIndex = PhysicsConstants.NULL_INDEX
Me.ColorIndex = PhysicsConstants.NULL_INDEX
Me.LocalIndex = PhysicsConstants.NULL_INDEX
Me.Edge0BodyId = PhysicsConstants.NULL_INDEX
Me.Edge0PrevKey = PhysicsConstants.NULL_INDEX
Me.Edge0NextKey = PhysicsConstants.NULL_INDEX
Me.Edge1BodyId = PhysicsConstants.NULL_INDEX
Me.Edge1PrevKey = PhysicsConstants.NULL_INDEX
Me.Edge1NextKey = PhysicsConstants.NULL_INDEX
Me.ShapeIdA = PhysicsConstants.NULL_INDEX
Me.ShapeIdB = PhysicsConstants.NULL_INDEX
Me.IslandPrev = PhysicsConstants.NULL_INDEX
Me.IslandNext = PhysicsConstants.NULL_INDEX
Me.IslandId = PhysicsConstants.NULL_INDEX
Me.ContactId = PhysicsConstants.NULL_INDEX
Me.Flags = 0
Me.IsMarked = False
End Constructor

## Returns True when this record still addresses a live contact.
Function IsValid() As Boolean
Return Me.ContactId <> PhysicsConstants.NULL_INDEX
End Function
End Class

# Scalar solver scratch state for one contact, ported from the per-lane
# fields of upstream b2ContactConstraintSIMD in contact_solver.c. The SIMD
# struct collapses to a single lane in this port; anchors are fixed at
# prepare time while separation uses the moving rotated anchors.
Class ContactConstraint
## Awake-set body state index for body A. NULL_INDEX for static bodies.
Property IndexA As Integer
## Awake-set body state index for body B. NULL_INDEX for static bodies.
Property IndexB As Integer
## Inverse mass copied from the sim row for body A.
Property InvMassA As Double
## Inverse rotational inertia copied from the sim row for body A.
Property InvIA As Double
## Inverse mass copied from the sim row for body B.
Property InvMassB As Double
## Inverse rotational inertia copied from the sim row for body B.
Property InvIB As Double
## Inverse of the summed angular inertia, for rolling resistance.
Property RollingMass As Double
## Contact normal X component, fixed at prepare time.
Property NormalX As Double
## Contact normal Y component, fixed at prepare time.
Property NormalY As Double
## Mixed friction coefficient copied from the sim row.
Property Friction As Double
## Conveyor-belt tangent speed copied from the sim row.
Property TangentSpeed As Double
## Mixed restitution copied from the sim row.
Property Restitution As Double
## Rolling resistance copied from the sim row.
Property RollingResistance As Double
## Accumulated rolling impulse, warm started from the manifold.
Property RollingImpulse As Double
## Softness bias rate chosen at prepare time.
Property BiasRate As Double
## Softness mass scale chosen at prepare time.
Property MassScale As Double
## Softness impulse scale chosen at prepare time.

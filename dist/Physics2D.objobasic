target.WheelMaxMotorTorque.Items[targetIndex] = Me.WheelMaxMotorTorque.Items[sourceIndex]
target.WheelMotorSpeed.Items[targetIndex] = Me.WheelMotorSpeed.Items[sourceIndex]
target.WheelLowerTranslation.Items[targetIndex] = Me.WheelLowerTranslation.Items[sourceIndex]
target.WheelUpperTranslation.Items[targetIndex] = Me.WheelUpperTranslation.Items[sourceIndex]
target.WheelHertz.Items[targetIndex] = Me.WheelHertz.Items[sourceIndex]
target.WheelDampingRatio.Items[targetIndex] = Me.WheelDampingRatio.Items[sourceIndex]
target.WheelPerpMass.Items[targetIndex] = Me.WheelPerpMass.Items[sourceIndex]
target.WheelAxialMass.Items[targetIndex] = Me.WheelAxialMass.Items[sourceIndex]
target.WheelMotorMass.Items[targetIndex] = Me.WheelMotorMass.Items[sourceIndex]
target.WheelSpringSoftnessBiasRate.Items[targetIndex] = Me.WheelSpringSoftnessBiasRate.Items[sourceIndex]
target.WheelSpringSoftnessMassScale.Items[targetIndex] = Me.WheelSpringSoftnessMassScale.Items[sourceIndex]
target.WheelSpringSoftnessImpulseScale.Items[targetIndex] = Me.WheelSpringSoftnessImpulseScale.Items[sourceIndex]
End Sub

## Empties the store while retaining all capacity.
Sub ClearAll()
Me.JointId.Clear()
Me.BodyIdA.Clear()
Me.BodyIdB.Clear()
Me.Type.Clear()
Me.LocalOriginAnchorAX.Clear()
Me.LocalOriginAnchorAY.Clear()

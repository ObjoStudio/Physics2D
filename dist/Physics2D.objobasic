## Point one anchor on body B, X.
Property AnchorB1X As Double
## Point one anchor on body B, Y.
Property AnchorB1Y As Double
## Point one separation relative to the fixed anchors.
Property BaseSeparation1 As Double
## Point one accumulated normal impulse.
Property NormalImpulse1 As Double
## Point one accumulated tangent impulse.
Property TangentImpulse1 As Double
## Point one total normal impulse over the step.
Property TotalNormalImpulse1 As Double
## Point one inverse effective normal mass.
Property NormalMass1 As Double
## Point one inverse effective tangent mass.
Property TangentMass1 As Double
## Point one pre-solve normal velocity for restitution.
Property RelativeVelocity1 As Double
## Point two anchor on body A, X.
Property AnchorA2X As Double
## Point two anchor on body A, Y.
Property AnchorA2Y As Double
## Point two anchor on body B, X.
Property AnchorB2X As Double
## Point two anchor on body B, Y.
Property AnchorB2Y As Double
## Point two separation relative to the fixed anchors.
Property BaseSeparation2 As Double
## Point two accumulated normal impulse.
Property NormalImpulse2 As Double
## Point two accumulated tangent impulse.
Property TangentImpulse2 As Double
## Point two total normal impulse over the step.
Property TotalNormalImpulse2 As Double
## Point two inverse effective normal mass.
Property NormalMass2 As Double
## Point two inverse effective tangent mass.
Property TangentMass2 As Double
## Point two pre-solve normal velocity for restitution.
Property RelativeVelocity2 As Double

## Creates a zeroed constraint with no bodies attached.
Constructor()
Me.IndexA = PhysicsConstants.NULL_INDEX
Me.IndexB = PhysicsConstants.NULL_INDEX
Me.InvMassA = 0.0
Me.InvIA = 0.0
Me.InvMassB = 0.0
Me.InvIB = 0.0
Me.RollingMass = 0.0
Me.NormalX = 0.0
Me.NormalY = 0.0
Me.Friction = 0.0
Me.TangentSpeed = 0.0
Me.Restitution = 0.0
Me.RollingResistance = 0.0
Me.RollingImpulse = 0.0
Me.BiasRate = 0.0
Me.MassScale = 0.0
Me.ImpulseScale = 0.0
Me.AnchorA1X = 0.0
Me.AnchorA1Y = 0.0
Me.AnchorB1X = 0.0
Me.AnchorB1Y = 0.0
Me.BaseSeparation1 = 0.0
Me.NormalImpulse1 = 0.0
Me.TangentImpulse1 = 0.0
Me.TotalNormalImpulse1 = 0.0
Me.NormalMass1 = 0.0
Me.TangentMass1 = 0.0
Me.RelativeVelocity1 = 0.0
Me.AnchorA2X = 0.0
Me.AnchorA2Y = 0.0
Me.AnchorB2X = 0.0
Me.AnchorB2Y = 0.0
Me.BaseSeparation2 = 0.0
Me.NormalImpulse2 = 0.0
Me.TangentImpulse2 = 0.0
Me.TotalNormalImpulse2 = 0.0
Me.NormalMass2 = 0.0
Me.TangentMass2 = 0.0
Me.RelativeVelocity2 = 0.0
End Constructor
End Class

# Contact flags, ported from upstream b2ContactFlags and b2ContactSimFlags
# in contact.h. The sim flags are shifted above the cold flags so a contact
# can carry both sets in one integer without confusion.
#
# Cold flags live on the Contact record and survive solver-set transfers;
# sim flags live on the per-set contact sim and are recomputed by the narrow
# phase every step. The numeric values match upstream bit positions.
Enum ContactFlags
TouchingFlag = 1
HitEventFlag = 2
EnableContactEvents = 4
SimTouchingFlag = 65536
SimDisjoint = 131072
SimStartedTouching = 262144
SimStoppedTouching = 524288
SimEnableHitEvent = 1048576
SimEnablePreSolveEvents = 2097152
End Enum

# Contact lifecycle, ported from upstream contact.c. This module owns the
# manifold dispatch table (as a Select Case over the shape-type pair), the
# contact creation and destruction rules, contact-edge linking, and the
# narrow-phase manifold update with warm-start impulse matching.
#
# Upstream stores the dispatch as a function-pointer table registered at
# startup; the port uses one deterministic Select Case so no runtime
# registration order can change results. The transposed-pair rule matches
# upstream b2AddType: the pair whose first argument matches the registered
# primary order is used verbatim, the transposed pair flips its arguments.
Class ContactMethods
## Computes the contact manifold for a shape pair, choosing the registered
## primary argument order. The cache is only used by chain-segment pairs.
Shared Function ComputeManifoldTo(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var typeA As ShapeType = shapeA.Type
# Upstream primary orders: circle-circle, capsule-circle, capsule-capsule,
# polygon-circle, polygon-capsule, polygon-polygon, segment-circle,
# segment-capsule, segment-polygon, chainSegment-circle,
# chainSegment-capsule, chainSegment-polygon. Segment-segment and
# chain-segment pairs have no registered manifold.
If typeA = ShapeType.CircleShape Then
Return ManifoldCircleA(shapeA, transformA, shapeB, transformB, cache, out)
ElseIf typeA = ShapeType.CapsuleShape Then
Return ManifoldCapsuleA(shapeA, transformA, shapeB, transformB, cache, out)
ElseIf typeA = ShapeType.SegmentShape Then
Return ManifoldSegmentA(shapeA, transformA, shapeB, transformB, out)
ElseIf typeA = ShapeType.PolygonShape Then
Return ManifoldPolygonA(shapeA, transformA, shapeB, transformB, cache, out)
ElseIf typeA = ShapeType.ChainSegmentShape Then
Return ManifoldChainSegmentA(shapeA, transformA, shapeB, transformB, cache, out)
End If
out.Reset()
Return out
End Function

## Manifold dispatch when shape A is a circle.
Private Shared Function ManifoldCircleA(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Pragma Unused cache
Var typeB As ShapeType = shapeB.Type
If typeB = ShapeType.CircleShape Then
Return Collide.CollideCirclesTo(shapeA.Circle, transformA, shapeB.Circle, transformB, out)
ElseIf typeB = ShapeType.CapsuleShape Then
Return Collide.CollideCapsuleAndCircleTo(shapeB.Capsule, transformB, shapeA.Circle, transformA, out)
ElseIf typeB = ShapeType.SegmentShape Then
Return Collide.CollideSegmentAndCircleTo(shapeB.Segment, transformB, shapeA.Circle, transformA, out)
ElseIf typeB = ShapeType.PolygonShape Then
Return Collide.CollidePolygonAndCircleTo(shapeB.Polygon, transformB, shapeA.Circle, transformA, out)
ElseIf typeB = ShapeType.ChainSegmentShape Then
Return Collide.CollideChainSegmentAndCircleTo(shapeB.ChainSegment, transformB, shapeA.Circle, transformA, out)
End If
out.Reset()
Return out
End Function

## Manifold dispatch when shape A is a capsule.
Private Shared Function ManifoldCapsuleA(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var typeB As ShapeType = shapeB.Type
If typeB = ShapeType.CircleShape Then
Return Collide.CollideCapsuleAndCircleTo(shapeA.Capsule, transformA, shapeB.Circle, transformB, out)
ElseIf typeB = ShapeType.CapsuleShape Then
Return Collide.CollideCapsulesTo(shapeA.Capsule, transformA, shapeB.Capsule, transformB, out)
ElseIf typeB = ShapeType.SegmentShape Then
Return Collide.CollideSegmentAndCapsuleTo(shapeB.Segment, transformB, shapeA.Capsule, transformA, out)
ElseIf typeB = ShapeType.PolygonShape Then
Return Collide.CollidePolygonAndCapsuleTo(shapeB.Polygon, transformB, shapeA.Capsule, transformA, out)
ElseIf typeB = ShapeType.ChainSegmentShape Then
Return Collide.CollideChainSegmentAndCapsuleTo(shapeB.ChainSegment, transformB, shapeA.Capsule, transformA, cache, out)
End If
out.Reset()
Return out
End Function

## Manifold dispatch when shape A is a segment.
Private Shared Function ManifoldSegmentA(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, out As Manifold) As Manifold
Var typeB As ShapeType = shapeB.Type
If typeB = ShapeType.CircleShape Then
Return Collide.CollideSegmentAndCircleTo(shapeA.Segment, transformA, shapeB.Circle, transformB, out)
ElseIf typeB = ShapeType.CapsuleShape Then
Return Collide.CollideSegmentAndCapsuleTo(shapeA.Segment, transformA, shapeB.Capsule, transformB, out)
ElseIf typeB = ShapeType.PolygonShape Then
Return Collide.CollideSegmentAndPolygonTo(shapeA.Segment, transformA, shapeB.Polygon, transformB, out)
End If
out.Reset()
Return out
End Function

## Manifold dispatch when shape A is a polygon.
Private Shared Function ManifoldPolygonA(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var typeB As ShapeType = shapeB.Type
If typeB = ShapeType.CircleShape Then
Return Collide.CollidePolygonAndCircleTo(shapeA.Polygon, transformA, shapeB.Circle, transformB, out)
ElseIf typeB = ShapeType.CapsuleShape Then
Return Collide.CollidePolygonAndCapsuleTo(shapeA.Polygon, transformA, shapeB.Capsule, transformB, out)
ElseIf typeB = ShapeType.SegmentShape Then
Return Collide.CollideSegmentAndPolygonTo(shapeB.Segment, transformB, shapeA.Polygon, transformA, out)
ElseIf typeB = ShapeType.PolygonShape Then
Return Collide.CollidePolygonsTo(shapeA.Polygon, transformA, shapeB.Polygon, transformB, out)
ElseIf typeB = ShapeType.ChainSegmentShape Then
Return Collide.CollideChainSegmentAndPolygonTo(shapeB.ChainSegment, transformB, shapeA.Polygon, transformA, cache, out)
End If
out.Reset()
Return out
End Function

## Manifold dispatch when shape A is a chain segment.
Private Shared Function ManifoldChainSegmentA(shapeA As Shape, transformA As Transform, shapeB As Shape, transformB As Transform, cache As SimplexCache, out As Manifold) As Manifold
Var typeB As ShapeType = shapeB.Type
If typeB = ShapeType.CircleShape Then
Return Collide.CollideChainSegmentAndCircleTo(shapeA.ChainSegment, transformA, shapeB.Circle, transformB, out)
ElseIf typeB = ShapeType.CapsuleShape Then
Return Collide.CollideChainSegmentAndCapsuleTo(shapeA.ChainSegment, transformA, shapeB.Capsule, transformB, cache, out)
ElseIf typeB = ShapeType.PolygonShape Then
Return Collide.CollideChainSegmentAndPolygonTo(shapeA.ChainSegment, transformA, shapeB.Polygon, transformB, cache, out)
End If
out.Reset()
Return out
End Function

## Returns True when the registered manifold pair exists. Segment-segment,
## segment-chain-segment, and chain-segment pairs never collide.
Private Shared Function HasManifold(typeA As ShapeType, typeB As ShapeType) As Boolean
If typeA = ShapeType.SegmentShape And typeB = ShapeType.SegmentShape Then
Return False
End If
If typeA = ShapeType.ChainSegmentShape And typeB = ShapeType.SegmentShape Then
Return False
End If
If typeA = ShapeType.SegmentShape And typeB = ShapeType.ChainSegmentShape Then
Return False
End If
If typeA = ShapeType.ChainSegmentShape And typeB = ShapeType.ChainSegmentShape Then
Return False
End If
Return True
End Function

## Returns True when the two shape filters may collide, ported from
## b2ShouldShapesCollide in shape.h.
Shared Function ShouldShapesCollide(filterA As Filter, filterB As Filter) As Boolean
If filterA.GroupIndex = filterB.GroupIndex And filterA.GroupIndex <> 0 Then
Return filterA.GroupIndex > 0
End If
Return (filterA.MaskBits.BitAnd(filterB.CategoryBits) <> 0) And (filterA.CategoryBits.BitAnd(filterB.MaskBits) <> 0)
End Function

## Body-level collision rule, ported from b2ShouldBodiesCollide in body.c.
## Two bodies collide only when at least one is dynamic; the connected-joint
## walk arrives with Stage 9.
Shared Function ShouldBodiesCollide(world As World, bodyA As Body, bodyB As Body) As Boolean
If bodyA.Type <> BodyType.DynamicBody And bodyB.Type <> BodyType.DynamicBody Then
Return False
End If

# A joint between the two bodies with collideConnected disabled suppresses
# every contact between them, ported from b2ShouldBodiesCollide in body.c.
Var jointKey As Integer
Var otherBodyId As Integer
If bodyA.JointCount < bodyB.JointCount Then
jointKey = bodyA.HeadJointKey
otherBodyId = bodyB.Id
Else
jointKey = bodyB.HeadJointKey
otherBodyId = bodyA.Id
End If

While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = world.Joints[jointId]
Var jointOtherBodyId As Integer = joint.Edge1BodyId
If edgeIndex = 1 Then
jointOtherBodyId = joint.Edge0BodyId
End If
If joint.CollideConnected = False And jointOtherBodyId = otherBodyId Then
Return False
End If
If edgeIndex = 0 Then
jointKey = joint.Edge0NextKey
Else
jointKey = joint.Edge1NextKey
End If
Wend
Return True
End Function

## Creates a contact for two overlapping broad-phase proxies, ported from
## b2CreateContact. The caller has already applied shape and body filtering.
## When either body is awake the contact lives in the awake set; otherwise
## it lives in the disabled set until an island links it.
Shared Function CreateContact(world As World, shapeA As Shape, shapeB As Shape) As Contact
Var typeA As ShapeType = shapeA.Type
Var typeB As ShapeType = shapeB.Type
If Not HasManifold(typeA, typeB) Then
Return Nothing
End If
If Not IsPrimaryPair(typeA, typeB) Then
Return ContactMethods.CreateContact(world, shapeB, shapeA)
End If

Var bodyA As Body = world.Bodies[shapeA.BodyId]
Var bodyB As Body = world.Bodies[shapeB.BodyId]
If bodyA.SetIndex = PhysicsConstants.DISABLED_SET Or bodyB.SetIndex = PhysicsConstants.DISABLED_SET Then
Return Nothing
End If
If bodyA.SetIndex = PhysicsConstants.STATIC_SET And bodyB.SetIndex = PhysicsConstants.STATIC_SET Then
Return Nothing
End If

Var setIndex As Integer = PhysicsConstants.DISABLED_SET
If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Or bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
setIndex = PhysicsConstants.AWAKE_SET
End If
Var contactSet As SolverSet = world.SolverSets[setIndex]

Var contactId As Integer = world.ContactIdPool.AllocId()
If contactId = world.Contacts.Count Then
# Freed contact records are pooled so steady-state pair churn in
# moving scenes allocates nothing after capacity warm-up. Growing the
# array happens only when the world holds more simultaneous contacts
# than ever before.
If world.ContactPool.Count > 0 Then
world.Contacts.Append(world.ContactPool[world.ContactPool.Count - 1])
world.ContactPool.RemoveAt(world.ContactPool.Count - 1)
Else
world.Contacts.Append(New Contact)
End If
Else
If world.ContactPool.Count > 0 Then
world.Contacts[contactId] = world.ContactPool[world.ContactPool.Count - 1]
world.ContactPool.RemoveAt(world.ContactPool.Count - 1)
Else
world.Contacts[contactId] = New Contact
End If
End If
Var contact As Contact = world.Contacts[contactId]

contact.ContactId = contactId
contact.SetIndex = setIndex
contact.ColorIndex = PhysicsConstants.NULL_INDEX
contact.IslandId = PhysicsConstants.NULL_INDEX
contact.IslandPrev = PhysicsConstants.NULL_INDEX
contact.IslandNext = PhysicsConstants.NULL_INDEX
contact.ShapeIdA = shapeA.Id
contact.ShapeIdB = shapeB.Id
contact.IsMarked = False
contact.Flags = 0

If shapeA.EnableContactEvents Or shapeB.EnableContactEvents Then
contact.Flags = contact.Flags.BitOr(Integer(ContactFlags.EnableContactEvents))
End If

LinkContactEdge(world, contact, 0, shapeA.BodyId)
LinkContactEdge(world, contact, 1, shapeB.BodyId)

Var pairKey As Integer = PairKeySet.PairKey(shapeA.Id, shapeB.Id)
world.BroadPhase.PairSet.Add(pairKey)

Var simIndex As Integer = contactSet.ContactSims.Add()
contact.LocalIndex = simIndex
Var sims As ContactSims = contactSet.ContactSims
sims.ContactId.Items[simIndex] = contactId
sims.ShapeIdA.Items[simIndex] = shapeA.Id
sims.ShapeIdB.Items[simIndex] = shapeB.Id
sims.BodySimIndexA.Items[simIndex] = PhysicsConstants.NULL_INDEX
sims.BodySimIndexB.Items[simIndex] = PhysicsConstants.NULL_INDEX
sims.InvMassA.Items[simIndex] = 0.0
sims.InvIA.Items[simIndex] = 0.0
sims.InvMassB.Items[simIndex] = 0.0
sims.InvIB.Items[simIndex] = 0.0
sims.Friction.Items[simIndex] = world.MixFrictionWithMaterials(shapeA.Friction, shapeA.UserMaterialId, shapeB.Friction, shapeB.UserMaterialId)
sims.Restitution.Items[simIndex] = world.MixRestitutionWithMaterials(shapeA.Restitution, shapeA.UserMaterialId, shapeB.Restitution, shapeB.UserMaterialId)
sims.RollingResistance.Items[simIndex] = 0.0
sims.TangentSpeed.Items[simIndex] = 0.0
sims.SimFlags.Items[simIndex] = 0

If shapeA.EnablePreSolveEvents Or shapeB.EnablePreSolveEvents Then
sims.SimFlags.Items[simIndex] = sims.SimFlags.Items[simIndex].BitOr(Integer(ContactFlags.SimEnablePreSolveEvents))
End If

world.ContactCount = world.ContactCount + 1
Return contact
End Function

## Returns True when the type pair is the registered primary order, ported
## from the b2AddType registrations in contact.c.
Private Shared Function IsPrimaryPair(typeA As ShapeType, typeB As ShapeType) As Boolean
If typeA = typeB Then
Return True
End If
If typeA = ShapeType.CapsuleShape And typeB = ShapeType.CircleShape Then
Return True
End If
If typeA = ShapeType.PolygonShape And (typeB = ShapeType.CircleShape Or typeB = ShapeType.CapsuleShape) Then
Return True
End If
If typeA = ShapeType.SegmentShape And (typeB = ShapeType.CircleShape Or typeB = ShapeType.CapsuleShape Or typeB = ShapeType.PolygonShape) Then
Return True
End If
If typeA = ShapeType.ChainSegmentShape And (typeB = ShapeType.CircleShape Or typeB = ShapeType.CapsuleShape Or typeB = ShapeType.PolygonShape) Then
Return True
End If
Return False
End Function

## Links one contact edge into its body's doubly linked contact list,
## ported from the edge connection block of b2CreateContact.
Private Shared Sub LinkContactEdge(world As World, contact As Contact, edgeIndex As Integer, bodyId As Integer)
Var body As Body = world.Bodies[bodyId]
If edgeIndex = 0 Then
contact.Edge0BodyId = bodyId
contact.Edge0PrevKey = PhysicsConstants.NULL_INDEX
contact.Edge0NextKey = body.HeadContactKey
Else
contact.Edge1BodyId = bodyId
contact.Edge1PrevKey = PhysicsConstants.NULL_INDEX
contact.Edge1NextKey = body.HeadContactKey
End If

Var edgeKey As Integer = (contact.ContactId * 2) + edgeIndex
If body.HeadContactKey <> PhysicsConstants.NULL_INDEX Then
Var headContact As Contact = world.Contacts[body.HeadContactKey.ShiftRight(1)]
If body.HeadContactKey Mod 2 = 0 Then
headContact.Edge0PrevKey = edgeKey
Else
headContact.Edge1PrevKey = edgeKey
End If
End If
body.HeadContactKey = edgeKey
body.ContactCount = body.ContactCount + 1
End Sub

## Destroys a contact, ported from b2DestroyContact. The island-unlink and
## constraint-graph removal branches arrive with their owning slices; both
## are unreachable until islands and the step exist.
Shared Sub DestroyContact(world As World, contact As Contact, wakeBodies As Boolean)
Var contactId As Integer = contact.ContactId
Var pairKey As Integer = PairKeySet.PairKey(contact.ShapeIdA, contact.ShapeIdB)
world.BroadPhase.PairSet.Remove(pairKey)

Var touching As Boolean = contact.Flags.BitAnd(Integer(ContactFlags.TouchingFlag)) <> 0
Var bodyIdA As Integer = contact.Edge0BodyId
Var bodyIdB As Integer = contact.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]

# End touch event, ported from the destruction branch of b2DestroyContact.
If touching And contact.Flags.BitAnd(Integer(ContactFlags.EnableContactEvents)) <> 0 Then
world.ContactEndShapeAIds[world.EndEventWriteIndex].Append(contact.ShapeIdA)
world.ContactEndShapeAGens[world.EndEventWriteIndex].Append(world.ShapeGenerations.Items[contact.ShapeIdA])
world.ContactEndShapeBIds[world.EndEventWriteIndex].Append(contact.ShapeIdB)
world.ContactEndShapeBGens[world.EndEventWriteIndex].Append(world.ShapeGenerations.Items[contact.ShapeIdB])
End If

UnlinkContactEdge(world, contact, 0)
UnlinkContactEdge(world, contact, 1)

# Remove the contact from its island when it was linked.
If contact.IslandId <> PhysicsConstants.NULL_INDEX Then
IslandMethods.UnlinkContact(world, contact)
End If

# Remove the sim record from the graph colour when the contact is an
# active constraint, otherwise from the set that owns it.
If contact.ColorIndex <> PhysicsConstants.NULL_INDEX Then
GraphMethods.RemoveContactFromGraph(world, contact.ColorIndex, contact.LocalIndex)
Else
Var contactSet As SolverSet = world.SolverSets[contact.SetIndex]
Var movedIndex As Integer = contactSet.ContactSims.RemoveSwap(contact.LocalIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = contactSet.ContactSims.ContactId.Items[contact.LocalIndex]
world.Contacts[movedContactId].LocalIndex = contact.LocalIndex
End If
End If

contact.ContactId = PhysicsConstants.NULL_INDEX
contact.SetIndex = PhysicsConstants.NULL_INDEX
contact.ColorIndex = PhysicsConstants.NULL_INDEX
contact.LocalIndex = PhysicsConstants.NULL_INDEX
contact.IslandId = PhysicsConstants.NULL_INDEX
contact.IslandPrev = PhysicsConstants.NULL_INDEX
contact.IslandNext = PhysicsConstants.NULL_INDEX
contact.ShapeIdA = PhysicsConstants.NULL_INDEX
contact.ShapeIdB = PhysicsConstants.NULL_INDEX
contact.IsMarked = False
contact.Flags = 0
world.ContactPool.Append(contact)

world.ContactIdPool.FreeId(contactId)
world.ContactCount = world.ContactCount - 1

If wakeBodies And touching Then
world.WakeBody(bodyA)
world.WakeBody(bodyB)
End If
End Sub

## Removes one contact edge from its body's doubly linked contact list,
## ported from the edge removal block of b2DestroyContact.
Private Shared Sub UnlinkContactEdge(world As World, contact As Contact, edgeIndex As Integer)
Var prevKey As Integer = PhysicsConstants.NULL_INDEX
Var nextKey As Integer = PhysicsConstants.NULL_INDEX
If edgeIndex = 0 Then
prevKey = contact.Edge0PrevKey
nextKey = contact.Edge0NextKey
Else
prevKey = contact.Edge1PrevKey
nextKey = contact.Edge1NextKey
End If

If prevKey <> PhysicsConstants.NULL_INDEX Then
Var prevContact As Contact = world.Contacts[prevKey.ShiftRight(1)]
If prevKey Mod 2 = 0 Then
prevContact.Edge0NextKey = nextKey
Else
prevContact.Edge1NextKey = nextKey
End If
End If

If nextKey <> PhysicsConstants.NULL_INDEX Then
Var nextContact As Contact = world.Contacts[nextKey.ShiftRight(1)]
If nextKey Mod 2 = 0 Then
nextContact.Edge0PrevKey = prevKey
Else
nextContact.Edge1PrevKey = prevKey
End If
End If

Var edgeKey As Integer = (contact.ContactId * 2) + edgeIndex
Var body As Body = world.Bodies[contact.Edge0BodyId]
If edgeIndex = 1 Then
body = world.Bodies[contact.Edge1BodyId]
End If
If body.HeadContactKey = edgeKey Then
body.HeadContactKey = nextKey
End If
body.ContactCount = body.ContactCount - 1
End Sub

## Destroys every contact attached to a body, ported from
## b2DestroyBodyContacts in body.c.
Shared Sub DestroyBodyContacts(world As World, body As Body, wakeBodies As Boolean)
Var edgeKey As Integer = body.HeadContactKey
While edgeKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = edgeKey.ShiftRight(1)
Var edgeIndex As Integer = edgeKey.BitAnd(1)
Var contact As Contact = world.Contacts[contactId]
If edgeIndex = 0 Then
edgeKey = contact.Edge0NextKey
Else
edgeKey = contact.Edge1NextKey
End If
ContactMethods.DestroyContact(world, contact, wakeBodies)
Wend
End Sub

## Destroys every contact that references the given shape, ported from the
## contact sweep of b2DestroyShapeInternal in shape.c.
Shared Sub DestroyShapeContacts(world As World, body As Body, shapeId As Integer, wakeBodies As Boolean)
Var edgeKey As Integer = body.HeadContactKey
While edgeKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = edgeKey.ShiftRight(1)
Var edgeIndex As Integer = edgeKey.BitAnd(1)
Var contact As Contact = world.Contacts[contactId]
If edgeIndex = 0 Then
edgeKey = contact.Edge0NextKey
Else
edgeKey = contact.Edge1NextKey
End If
If contact.ShapeIdA = shapeId Or contact.ShapeIdB = shapeId Then
ContactMethods.DestroyContact(world, contact, wakeBodies)
End If
Wend
End Sub

## Returns the shape's collision radius, ported from b2GetShapeRadius in
## shape.h. Segments and chain segments have zero radius.
Private Shared Function GetShapeRadius(shape As Shape) As Double
If shape.Type = ShapeType.CapsuleShape Then
Return shape.Capsule.Radius
ElseIf shape.Type = ShapeType.CircleShape Then
Return shape.Circle.Radius
ElseIf shape.Type = ShapeType.PolygonShape Then
Return shape.Polygon.Radius
End If
Return 0.0
End Function

## Updates the contact manifold and touching status, ported from
## b2UpdateContact. The manifold is written in place into the set's reusable
## manifold object; anchors shift to centre-of-mass-relative form and
## persisted points inherit the old impulses for warm starting. Returns the
## new touching state.
Shared Function UpdateContact(world As World, contact As Contact, shapeA As Shape, transformA As Transform, centerOffsetAX As Double, centerOffsetAY As Double, shapeB As Shape, transformB As Transform, centerOffsetBX As Double, centerOffsetBY As Double) As Boolean
Var sims As ContactSims
If contact.ColorIndex <> PhysicsConstants.NULL_INDEX Then
sims = world.ConstraintGraph.Colors[contact.ColorIndex].ContactSims
Else
sims = world.SolverSets[contact.SetIndex].ContactSims
End If
Var simIndex As Integer = contact.LocalIndex
Var manifold As Manifold = sims.GetManifold(simIndex)
Var cache As SimplexCache = sims.GetCache(simIndex)

# Keep the old manifold for impulse matching, then recompute in place.
Var oldPointCount As Integer = manifold.PointCount
Var oldId1 As Integer = manifold.Point1.Id
Var oldNormalImpulse1 As Double = manifold.Point1.NormalImpulse
Var oldTangentImpulse1 As Double = manifold.Point1.TangentImpulse
Var oldId2 As Integer = 0
Var oldNormalImpulse2 As Double = 0.0
Var oldTangentImpulse2 As Double = 0.0
If oldPointCount = 2 Then
oldId2 = manifold.Point2.Id
oldNormalImpulse2 = manifold.Point2.NormalImpulse
oldTangentImpulse2 = manifold.Point2.TangentImpulse
End If

ContactMethods.ComputeManifoldTo(shapeA, transformA, shapeB, transformB, cache, manifold)

# Keep the mixing values current in case the shapes were modified.
sims.Friction.Items[simIndex] = world.MixFrictionWithMaterials(shapeA.Friction, shapeA.UserMaterialId, shapeB.Friction, shapeB.UserMaterialId)
sims.Restitution.Items[simIndex] = world.MixRestitutionWithMaterials(shapeA.Restitution, shapeA.UserMaterialId, shapeB.Restitution, shapeB.UserMaterialId)
If shapeA.RollingResistance > 0.0 Or shapeB.RollingResistance > 0.0 Then
Var radiusA As Double = GetShapeRadius(shapeA)
Var radiusB As Double = GetShapeRadius(shapeB)
Var maxRadius As Double = radiusA
If radiusB > maxRadius Then
maxRadius = radiusB
End If
sims.RollingResistance.Items[simIndex] = Maths.Max(shapeA.RollingResistance, shapeB.RollingResistance) * maxRadius
Else
sims.RollingResistance.Items[simIndex] = 0.0
End If
sims.TangentSpeed.Items[simIndex] = shapeA.TangentSpeed + shapeB.TangentSpeed

Var pointCount As Integer = manifold.PointCount
Var touching As Boolean = pointCount > 0

# Opt-in pre-solve editing runs while the world is locked; returning False
# disables the contact for this step, ported from b2UpdateContact.
If touching Then
touching = ApplyPreSolve(world, shapeA, shapeB, manifold, sims.SimFlags.Items[simIndex])
If touching = False Then
manifold.PointCount = 0
pointCount = 0
End If
End If

# Speculative margins are a Stage 8 concern; without them a two-point
# manifold with a too-positive separation collapses to its deeper point,
# ported from the enableSpeculative guard.
If world.SpeculativeEnabled = False And pointCount = 2 Then
If manifold.Point1.Separation > 1.5 * PhysicsConstants.LINEAR_SLOP Then
CopyManifoldPoint(manifold.Point2, manifold.Point1)
manifold.PointCount = 1
ElseIf manifold.Point2.Separation > 1.5 * PhysicsConstants.LINEAR_SLOP Then
manifold.PointCount = 1
End If
pointCount = manifold.PointCount
End If

UpdateHitEventFlag(shapeA, shapeB, sims, simIndex)

If pointCount > 0 Then
manifold.RollingImpulse = 0.0
End If

# Match old contact ids to new contact ids and copy the stored impulses to
# warm start the solver, ported from the persistence loop.
If pointCount > 0 Then
ShiftAnchor(manifold.Point1, centerOffsetAX, centerOffsetAY, centerOffsetBX, centerOffsetBY)
manifold.Point1.NormalImpulse = 0.0
manifold.Point1.TangentImpulse = 0.0
manifold.Point1.TotalNormalImpulse = 0.0
manifold.Point1.NormalVelocity = 0.0
manifold.Point1.Persisted = False
If oldPointCount > 0 And manifold.Point1.Id = oldId1 Then
manifold.Point1.NormalImpulse = oldNormalImpulse1
manifold.Point1.TangentImpulse = oldTangentImpulse1
manifold.Point1.Persisted = True
End If
End If
If pointCount = 2 Then
ShiftAnchor(manifold.Point2, centerOffsetAX, centerOffsetAY, centerOffsetBX, centerOffsetBY)
manifold.Point2.NormalImpulse = 0.0
manifold.Point2.TangentImpulse = 0.0
manifold.Point2.TotalNormalImpulse = 0.0
manifold.Point2.NormalVelocity = 0.0
manifold.Point2.Persisted = False
If oldPointCount = 2 And manifold.Point2.Id = oldId2 Then
manifold.Point2.NormalImpulse = oldNormalImpulse2
manifold.Point2.TangentImpulse = oldTangentImpulse2
manifold.Point2.Persisted = True
End If
End If

If touching Then
sims.SimFlags.Items[simIndex] = sims.SimFlags.Items[simIndex].BitOr(Integer(ContactFlags.SimTouchingFlag))
Else
sims.SimFlags.Items[simIndex] = sims.SimFlags.Items[simIndex].BitAnd(Integer(ContactFlags.SimTouchingFlag).BitNot())
End If

Return touching
End Function

## Keeps the sim hit-event flag current against the shape opt-ins, ported
## from the enableHitEvents block of b2UpdateContact.
Private Shared Sub UpdateHitEventFlag(shapeA As Shape, shapeB As Shape, sims As ContactSims, simIndex As Integer)
If shapeA.EnableHitEvents Or shapeB.EnableHitEvents Then
sims.SimFlags.Items[simIndex] = sims.SimFlags.Items[simIndex].BitOr(Integer(ContactFlags.SimEnableHitEvent))
Else
sims.SimFlags.Items[simIndex] = sims.SimFlags.Items[simIndex].BitAnd(Integer(ContactFlags.SimEnableHitEvent).BitNot())
End If
End Sub

## Applies the opt-in pre-solve hook to a touching contact, returning the
## possibly-revoked touching state. Ported from the pre-solve guard in
## b2UpdateContact.
Private Shared Function ApplyPreSolve(world As World, shapeA As Shape, shapeB As Shape, manifold As Manifold, simFlags As Integer) As Boolean
If world.PreSolve = Nothing Then
Return True
End If
If simFlags.BitAnd(Integer(ContactFlags.SimEnablePreSolveEvents)) = 0 Then
Return True
End If
Return world.PreSolve.PreSolve(shapeA, shapeB, manifold)
End Function

## Shifts one manifold point's anchors from body-origin-relative to
## centre-of-mass-relative form, ported from the anchor adjustment in
## b2UpdateContact.
Private Shared Sub ShiftAnchor(point As ManifoldPoint, offsetAX As Double, offsetAY As Double, offsetBX As Double, offsetBY As Double)
point.AnchorA.X = point.AnchorA.X - offsetAX
point.AnchorA.Y = point.AnchorA.Y - offsetAY
point.AnchorB.X = point.AnchorB.X - offsetBX
point.AnchorB.Y = point.AnchorB.Y - offsetBY
End Sub

## Copies the solver-relevant fields from one manifold point to another in
## place, ported from the point-collapse branch of b2UpdateContact.
Private Shared Sub CopyManifoldPoint(source As ManifoldPoint, target As ManifoldPoint)
target.AnchorA.Set(source.AnchorA.X, source.AnchorA.Y)
target.AnchorB.Set(source.AnchorB.X, source.AnchorB.Y)
target.Point.Set(source.Point.X, source.Point.Y)
target.Separation = source.Separation
target.Id = source.Id
End Sub
End Class

# Dense per-contact simulation state for one solver set, ported from the
# b2ContactSim usage inside b2SolverSet in solver_set.h. Decision 0004
# selects parallel scalar arrays, so every scalar field is one list indexed
# by the contact's local index within the set.
#
# The manifold and simplex cache are heap objects drawn from append-only
# pools through an LIFO free list. Pool objects survive RemoveSwap and
# Clear, so the warm create/destroy path allocates nothing and the narrow
# phase writes manifolds in place through the Collide To-forms. Which pool
# object a row reuses never affects solver results because pools are pure
# scratch slots.
Class ContactSims
## Cold contact slot of each sim.
Property ContactId As IntegerList
## Shape slot of the first shape.
Property ShapeIdA As IntegerList
## Shape slot of the second shape.
Property ShapeIdB As IntegerList
## Dense-record index of body A inside its solver set. NULL_INDEX until the
## narrow phase assigns it.
Property BodySimIndexA As IntegerList
## Dense-record index of body B inside its solver set.
Property BodySimIndexB As IntegerList
## Inverse mass of body A.
Property InvMassA As DoubleList
## Inverse rotational inertia of body A.
Property InvIA As DoubleList
## Inverse mass of body B.
Property InvMassB As DoubleList
## Inverse rotational inertia of body B.
Property InvIB As DoubleList
## Mixed friction coefficient.
Property Friction As DoubleList
## Mixed restitution coefficient.
Property Restitution As DoubleList
## Rolling resistance scaled by the larger shape radius.
Property RollingResistance As DoubleList
## Conveyor-belt tangent speed along the manifold normal's tangent.
Property TangentSpeed As DoubleList
## b2ContactSimFlags bits.
Property SimFlags As IntegerList
## Pool slot of each row's reusable manifold.
Property ManifoldSlots As IntegerList
## Pool slot of each row's reusable simplex cache.
Property CacheSlots As IntegerList
## Append-only pool of reusable manifold objects.
Property ManifoldPool As Array(Of Manifold)
## Append-only pool of reusable simplex cache objects.
Property CachePool As Array(Of SimplexCache)
## LIFO free list of manifold pool slots.
Property FreeManifolds As IntegerList
## LIFO free list of cache pool slots.
Property FreeCaches As IntegerList

## Creates an empty store.
Constructor()
Me.ContactId = New IntegerList
Me.ShapeIdA = New IntegerList
Me.ShapeIdB = New IntegerList
Me.BodySimIndexA = New IntegerList
Me.BodySimIndexB = New IntegerList
Me.InvMassA = New DoubleList
Me.InvIA = New DoubleList
Me.InvMassB = New DoubleList
Me.InvIB = New DoubleList
Me.Friction = New DoubleList
Me.Restitution = New DoubleList
Me.RollingResistance = New DoubleList
Me.TangentSpeed = New DoubleList
Me.SimFlags = New IntegerList
Me.ManifoldSlots = New IntegerList
Me.CacheSlots = New IntegerList
Me.ManifoldPool = New Array(Of Manifold)
Me.CachePool = New Array(Of SimplexCache)
Me.FreeManifolds = New IntegerList
Me.FreeCaches = New IntegerList
End Constructor

## Number of live contact sims in this store.
Function Count() As Integer
Return Me.ContactId.Count
End Function

## Returns the manifold object owned by the given local row. The narrow
## phase writes into it in place; no caller may keep the reference across
## steps because the slot is recycled.
Function GetManifold(index As Integer) As Manifold
Return Me.ManifoldPool[Me.ManifoldSlots.Items[index]]
End Function

## Returns the simplex cache object owned by the given local row.
Function GetCache(index As Integer) As SimplexCache
Return Me.CachePool[Me.CacheSlots.Items[index]]
End Function

## Appends one empty sim row, reusing pooled objects when available. Returns
## the new local index.
Function Add() As Integer
Me.ContactId.Append(PhysicsConstants.NULL_INDEX)
Me.ShapeIdA.Append(PhysicsConstants.NULL_INDEX)
Me.ShapeIdB.Append(PhysicsConstants.NULL_INDEX)
Me.BodySimIndexA.Append(PhysicsConstants.NULL_INDEX)
Me.BodySimIndexB.Append(PhysicsConstants.NULL_INDEX)
Me.InvMassA.Append(0.0)
Me.InvIA.Append(0.0)
Me.InvMassB.Append(0.0)
Me.InvIB.Append(0.0)
Me.Friction.Append(0.0)
Me.Restitution.Append(0.0)
Me.RollingResistance.Append(0.0)
Me.TangentSpeed.Append(0.0)
Me.SimFlags.Append(0)
If Me.FreeManifolds.Count > 0 Then
Me.ManifoldSlots.Append(Me.FreeManifolds.Pop())
Else
Me.ManifoldSlots.Append(Me.ManifoldPool.Count)
Me.ManifoldPool.Append(New Manifold)
End If
If Me.FreeCaches.Count > 0 Then
Me.CacheSlots.Append(Me.FreeCaches.Pop())
Else
Me.CacheSlots.Append(Me.CachePool.Count)
Me.CachePool.Append(New SimplexCache)
End If
Return Me.ContactId.Count - 1
End Function

## Removes one row by swapping in the last row. Returns the previous local
## index of the row that was moved, or NULL_INDEX when the removed row was
## the last one. After the call the moved row lives at `index`; read its
## ContactId there.
Function RemoveSwap(index As Integer) As Integer
If Me.ManifoldSlots.Items[index] <> PhysicsConstants.NULL_INDEX Then
# A recycled manifold must be blank: persisted impulses travel only with
# row transfers, and a stale impulse on a reused row could spuriously
# persist across an unrelated contact with matching feature ids.
Me.ManifoldPool[Me.ManifoldSlots.Items[index]].Reset()
Me.FreeManifolds.Append(Me.ManifoldSlots.Items[index])
End If
If Me.CacheSlots.Items[index] <> PhysicsConstants.NULL_INDEX Then
Me.CachePool[Me.CacheSlots.Items[index]].Clear()
Me.FreeCaches.Append(Me.CacheSlots.Items[index])
End If
Var movedIndex As Integer = Me.ContactId.RemoveSwap(index)
Me.ShapeIdA.RemoveSwap(index)
Me.ShapeIdB.RemoveSwap(index)
Me.BodySimIndexA.RemoveSwap(index)
Me.BodySimIndexB.RemoveSwap(index)
Me.InvMassA.RemoveSwap(index)
Me.InvIA.RemoveSwap(index)
Me.InvMassB.RemoveSwap(index)
Me.InvIB.RemoveSwap(index)
Me.Friction.RemoveSwap(index)
Me.Restitution.RemoveSwap(index)
Me.RollingResistance.RemoveSwap(index)
Me.TangentSpeed.RemoveSwap(index)
Me.SimFlags.RemoveSwap(index)
Me.ManifoldSlots.RemoveSwap(index)
Me.CacheSlots.RemoveSwap(index)
Return movedIndex
End Function

## Copies one row's scalars into another store's row and adopts the
## source's pooled manifold and cache objects, so persisted solver state
## travels with the row. The target row's blank placeholder objects swap
## back into the source pool and the vacated source slots return to this
## store's free lists, keeping pool sizes fixed across transfers. The
## vacated slots are marked NULL so the following RemoveSwap does not
## recycle them twice.
Sub MoveRowTo(target As ContactSims, targetIndex As Integer, sourceIndex As Integer)
target.ContactId.Items[targetIndex] = Me.ContactId.Items[sourceIndex]
target.ShapeIdA.Items[targetIndex] = Me.ShapeIdA.Items[sourceIndex]
target.ShapeIdB.Items[targetIndex] = Me.ShapeIdB.Items[sourceIndex]
target.BodySimIndexA.Items[targetIndex] = Me.BodySimIndexA.Items[sourceIndex]
target.BodySimIndexB.Items[targetIndex] = Me.BodySimIndexB.Items[sourceIndex]
target.InvMassA.Items[targetIndex] = Me.InvMassA.Items[sourceIndex]
target.InvIA.Items[targetIndex] = Me.InvIA.Items[sourceIndex]
target.InvMassB.Items[targetIndex] = Me.InvMassB.Items[sourceIndex]
target.InvIB.Items[targetIndex] = Me.InvIB.Items[sourceIndex]
target.Friction.Items[targetIndex] = Me.Friction.Items[sourceIndex]
target.Restitution.Items[targetIndex] = Me.Restitution.Items[sourceIndex]
target.RollingResistance.Items[targetIndex] = Me.RollingResistance.Items[sourceIndex]
target.TangentSpeed.Items[targetIndex] = Me.TangentSpeed.Items[sourceIndex]
target.SimFlags.Items[targetIndex] = Me.SimFlags.Items[sourceIndex]
# Adopt the source's pooled objects into the target row and swap the
# target row's blank placeholder objects back into the source pool at the
# vacated slots. The healed source slot then returns to this store's free
# list, so pools stay fixed-size across sleep and wake cycles and a warmed
# transfer allocates nothing.
Var placeholderManifold As Manifold = target.ManifoldPool[target.ManifoldSlots.Items[targetIndex]]
Var placeholderCache As SimplexCache = target.CachePool[target.CacheSlots.Items[targetIndex]]
target.ManifoldPool[target.ManifoldSlots.Items[targetIndex]] = Me.ManifoldPool[Me.ManifoldSlots.Items[sourceIndex]]
target.CachePool[target.CacheSlots.Items[targetIndex]] = Me.CachePool[Me.CacheSlots.Items[sourceIndex]]
Me.ManifoldPool[Me.ManifoldSlots.Items[sourceIndex]] = placeholderManifold
Me.CachePool[Me.CacheSlots.Items[sourceIndex]] = placeholderCache
Me.FreeManifolds.Append(Me.ManifoldSlots.Items[sourceIndex])
Me.FreeCaches.Append(Me.CacheSlots.Items[sourceIndex])
Me.ManifoldSlots.Items[sourceIndex] = PhysicsConstants.NULL_INDEX
Me.CacheSlots.Items[sourceIndex] = PhysicsConstants.NULL_INDEX
End Sub

## Empties the store while retaining all capacity, including the pooled
## manifold and cache objects.
Sub ClearAll()
Me.ContactId.Clear()
Me.ShapeIdA.Clear()
Me.ShapeIdB.Clear()
Me.BodySimIndexA.Clear()
Me.BodySimIndexB.Clear()
Me.InvMassA.Clear()
Me.InvIA.Clear()
Me.InvMassB.Clear()
Me.InvIB.Clear()
Me.Friction.Clear()
Me.Restitution.Clear()
Me.RollingResistance.Clear()
Me.TangentSpeed.Clear()
Me.SimFlags.Clear()
Me.ManifoldSlots.Clear()
Me.CacheSlots.Clear()
Me.FreeManifolds.Clear()
Me.FreeCaches.Clear()
# Return every pooled object that still lives in this store to its free
# list so a recycled store (for example a reused sleeping solver set) fills
# new rows without allocating. Slots whose objects were adopted by another
# store hold Nothing and stay dead holes.
Var manifoldSlot As Integer = 0
While manifoldSlot < Me.ManifoldPool.Count
If Me.ManifoldPool[manifoldSlot] <> Nothing Then
Me.ManifoldPool[manifoldSlot].Reset()
Me.FreeManifolds.Append(manifoldSlot)
End If
manifoldSlot = manifoldSlot + 1
Wend
Var cacheSlot As Integer = 0
While cacheSlot < Me.CachePool.Count
If Me.CachePool[cacheSlot] <> Nothing Then
Me.CachePool[cacheSlot].Clear()
Me.FreeCaches.Append(cacheSlot)
End If
cacheSlot = cacheSlot + 1
Wend
End Sub
End Class

# Contact solver kernels, ported from contact_solver.c. The SIMD lanes
# collapse to a single scalar lane: each kernel processes one constraint
# against the awake set's dense body states, preserving Box2D 3.1.1's Soft
# Step algorithmic order exactly.
Class ContactSolver
## Prepares one contact constraint from its sim row, ported from the body
## of b2PrepareContactsTask. Warm-start impulses scale with
## warmStartScale, which is 1.0 or 0.0 depending on the warm-start flag.
Shared Sub PrepareContact(cc As ContactConstraint, states As BodyStates, sims As ContactSims, simIndex As Integer, contactSoftness As Softness, staticSoftness As Softness, warmStartScale As Double)
Var manifold As Manifold = sims.GetManifold(simIndex)

cc.IndexA = sims.BodySimIndexA.Items[simIndex]
cc.IndexB = sims.BodySimIndexB.Items[simIndex]
cc.InvMassA = sims.InvMassA.Items[simIndex]
cc.InvIA = sims.InvIA.Items[simIndex]
cc.InvMassB = sims.InvMassB.Items[simIndex]
cc.InvIB = sims.InvIB.Items[simIndex]
Var rollingK As Double = cc.InvIA + cc.InvIB
If rollingK > 0.0 Then
cc.RollingMass = 1.0 / rollingK
Else
cc.RollingMass = 0.0
End If

# Stiffer for static contacts to avoid bodies getting pushed through the
# ground.
If cc.IndexA = PhysicsConstants.NULL_INDEX Or cc.IndexB = PhysicsConstants.NULL_INDEX Then
cc.BiasRate = staticSoftness.BiasRate
cc.MassScale = staticSoftness.MassScale
cc.ImpulseScale = staticSoftness.ImpulseScale
Else
cc.BiasRate = contactSoftness.BiasRate
cc.MassScale = contactSoftness.MassScale
cc.ImpulseScale = contactSoftness.ImpulseScale
End If

cc.NormalX = manifold.Normal.X
cc.NormalY = manifold.Normal.Y
cc.Friction = sims.Friction.Items[simIndex]
cc.TangentSpeed = sims.TangentSpeed.Items[simIndex]
cc.Restitution = sims.Restitution.Items[simIndex]
cc.RollingResistance = sims.RollingResistance.Items[simIndex]
cc.RollingImpulse = warmStartScale * manifold.RollingImpulse

# Relative velocities come from the awake set's states; static lanes read
# zero.
Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[cc.IndexA]
vAY = states.LVY.Items[cc.IndexA]
wA = states.AngularVelocity.Items[cc.IndexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[cc.IndexB]
vBY = states.LVY.Items[cc.IndexB]
wB = states.AngularVelocity.Items[cc.IndexB]
End If

Var tangentX As Double = cc.NormalY
Var tangentY As Double = -cc.NormalX

Var mp1 As ManifoldPoint = manifold.Point1
cc.AnchorA1X = mp1.AnchorA.X
cc.AnchorA1Y = mp1.AnchorA.Y
cc.AnchorB1X = mp1.AnchorB.X
cc.AnchorB1Y = mp1.AnchorB.Y
cc.BaseSeparation1 = mp1.Separation - (cc.AnchorB1X - cc.AnchorA1X) * cc.NormalX - (cc.AnchorB1Y - cc.AnchorA1Y) * cc.NormalY
cc.NormalImpulse1 = warmStartScale * mp1.NormalImpulse
cc.TangentImpulse1 = warmStartScale * mp1.TangentImpulse
cc.TotalNormalImpulse1 = 0.0
Var rnA As Double = cc.AnchorA1X * cc.NormalY - cc.AnchorA1Y * cc.NormalX
Var rnB As Double = cc.AnchorB1X * cc.NormalY - cc.AnchorB1Y * cc.NormalX
Var kNormal As Double = cc.InvMassA + cc.InvMassB + cc.InvIA * rnA * rnA + cc.InvIB * rnB * rnB
If kNormal > 0.0 Then
cc.NormalMass1 = 1.0 / kNormal
Else
cc.NormalMass1 = 0.0
End If
Var rtA As Double = cc.AnchorA1X * tangentY - cc.AnchorA1Y * tangentX
Var rtB As Double = cc.AnchorB1X * tangentY - cc.AnchorB1Y * tangentX
Var kTangent As Double = cc.InvMassA + cc.InvMassB + cc.InvIA * rtA * rtA + cc.InvIB * rtB * rtB
If kTangent > 0.0 Then
cc.TangentMass1 = 1.0 / kTangent
Else
cc.TangentMass1 = 0.0
End If
# relative velocity for restitution
Var vrAX As Double = vAX - wA * cc.AnchorA1Y
Var vrAY As Double = vAY + wA * cc.AnchorA1X
Var vrBX As Double = vBX - wB * cc.AnchorB1Y
Var vrBY As Double = vBY + wB * cc.AnchorB1X
cc.RelativeVelocity1 = (vrBX - vrAX) * cc.NormalX + (vrBY - vrAY) * cc.NormalY

Var pointCount As Integer = manifold.PointCount
If pointCount = 2 Then
Var mp2 As ManifoldPoint = manifold.Point2
cc.AnchorA2X = mp2.AnchorA.X
cc.AnchorA2Y = mp2.AnchorA.Y
cc.AnchorB2X = mp2.AnchorB.X
cc.AnchorB2Y = mp2.AnchorB.Y
cc.BaseSeparation2 = mp2.Separation - (cc.AnchorB2X - cc.AnchorA2X) * cc.NormalX - (cc.AnchorB2Y - cc.AnchorA2Y) * cc.NormalY
cc.NormalImpulse2 = warmStartScale * mp2.NormalImpulse
cc.TangentImpulse2 = warmStartScale * mp2.TangentImpulse
cc.TotalNormalImpulse2 = 0.0
Var rnA2 As Double = cc.AnchorA2X * cc.NormalY - cc.AnchorA2Y * cc.NormalX
Var rnB2 As Double = cc.AnchorB2X * cc.NormalY - cc.AnchorB2Y * cc.NormalX
Var kNormal2 As Double = cc.InvMassA + cc.InvMassB + cc.InvIA * rnA2 * rnA2 + cc.InvIB * rnB2 * rnB2
If kNormal2 > 0.0 Then
cc.NormalMass2 = 1.0 / kNormal2
Else
cc.NormalMass2 = 0.0
End If
Var rtA2 As Double = cc.AnchorA2X * tangentY - cc.AnchorA2Y * tangentX
Var rtB2 As Double = cc.AnchorB2X * tangentY - cc.AnchorB2Y * tangentX
Var kTangent2 As Double = cc.InvMassA + cc.InvMassB + cc.InvIA * rtA2 * rtA2 + cc.InvIB * rtB2 * rtB2
If kTangent2 > 0.0 Then
cc.TangentMass2 = 1.0 / kTangent2
Else
cc.TangentMass2 = 0.0
End If
Var vrA2X As Double = vAX - wA * cc.AnchorA2Y
Var vrA2Y As Double = vAY + wA * cc.AnchorA2X
Var vrB2X As Double = vBX - wB * cc.AnchorB2Y
Var vrB2Y As Double = vBY + wB * cc.AnchorB2X
cc.RelativeVelocity2 = (vrB2X - vrA2X) * cc.NormalX + (vrB2Y - vrA2Y) * cc.NormalY
Else
# dummy data that has no effect
cc.BaseSeparation2 = 0.0
cc.NormalImpulse2 = 0.0
cc.TangentImpulse2 = 0.0
cc.TotalNormalImpulse2 = 0.0
cc.AnchorA2X = 0.0
cc.AnchorA2Y = 0.0
cc.AnchorB2X = 0.0
cc.AnchorB2Y = 0.0
cc.NormalMass2 = 0.0
cc.TangentMass2 = 0.0
cc.RelativeVelocity2 = 0.0
End If
End Sub

## Applies the stored impulses to the body states before iterating,
## ported from b2WarmStartContactsTask.
Shared Sub WarmStartContact(states As BodyStates, cc As ContactConstraint)
Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[cc.IndexA]
vAY = states.LVY.Items[cc.IndexA]
wA = states.AngularVelocity.Items[cc.IndexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[cc.IndexB]
vBY = states.LVY.Items[cc.IndexB]
wB = states.AngularVelocity.Items[cc.IndexB]
End If

Var tangentX As Double = cc.NormalY
Var tangentY As Double = -cc.NormalX

Var p1X As Double = cc.NormalImpulse1 * cc.NormalX + cc.TangentImpulse1 * tangentX
Var p1Y As Double = cc.NormalImpulse1 * cc.NormalY + cc.TangentImpulse1 * tangentY
vAX = vAX - cc.InvMassA * p1X
vAY = vAY - cc.InvMassA * p1Y
wA = wA - cc.InvIA * (cc.AnchorA1X * p1Y - cc.AnchorA1Y * p1X)
vBX = vBX + cc.InvMassB * p1X
vBY = vBY + cc.InvMassB * p1Y
wB = wB + cc.InvIB * (cc.AnchorB1X * p1Y - cc.AnchorB1Y * p1X)

Var p2X As Double = cc.NormalImpulse2 * cc.NormalX + cc.TangentImpulse2 * tangentX
Var p2Y As Double = cc.NormalImpulse2 * cc.NormalY + cc.TangentImpulse2 * tangentY
vAX = vAX - cc.InvMassA * p2X
vAY = vAY - cc.InvMassA * p2Y
wA = wA - cc.InvIA * (cc.AnchorA2X * p2Y - cc.AnchorA2Y * p2X)
vBX = vBX + cc.InvMassB * p2X
vBY = vBY + cc.InvMassB * p2Y
wB = wB + cc.InvIB * (cc.AnchorB2X * p2Y - cc.AnchorB2Y * p2X)

wA = wA - cc.InvIA * cc.RollingImpulse
wB = wB + cc.InvIB * cc.RollingImpulse

If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexA] = vAX
states.LVY.Items[cc.IndexA] = vAY
states.AngularVelocity.Items[cc.IndexA] = wA
End If
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexB] = vBX
states.LVY.Items[cc.IndexB] = vBY
states.AngularVelocity.Items[cc.IndexB] = wB
End If
End Sub

## Runs one velocity iteration with optional soft-step bias over both
## manifold points, friction, and rolling resistance, ported from
## b2SolveContactsTask. minBiasVelocity limits bias stiffness and is
## normally negative.
Shared Sub SolveContact(states As BodyStates, cc As ContactConstraint, invH As Double, minBiasVelocity As Double, useBias As Boolean)
Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[cc.IndexA]
vAY = states.LVY.Items[cc.IndexA]
wA = states.AngularVelocity.Items[cc.IndexA]
dpAX = states.DPX.Items[cc.IndexA]
dpAY = states.DPY.Items[cc.IndexA]
dqAC = states.DRC.Items[cc.IndexA]
dqAS = states.DRS.Items[cc.IndexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[cc.IndexB]
vBY = states.LVY.Items[cc.IndexB]
wB = states.AngularVelocity.Items[cc.IndexB]
dpBX = states.DPX.Items[cc.IndexB]
dpBY = states.DPY.Items[cc.IndexB]
dqBC = states.DRC.Items[cc.IndexB]
dqBS = states.DRS.Items[cc.IndexB]
End If

Var biasRate As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
biasRate = cc.BiasRate
massScale = cc.MassScale
impulseScale = cc.ImpulseScale
End If

Var dpX As Double = dpBX - dpAX
Var dpY As Double = dpBY - dpAY

# Point one non-penetration constraint.
Var rsA1X As Double = dqAC * cc.AnchorA1X - dqAS * cc.AnchorA1Y
Var rsA1Y As Double = dqAS * cc.AnchorA1X + dqAC * cc.AnchorA1Y
Var rsB1X As Double = dqBC * cc.AnchorB1X - dqBS * cc.AnchorB1Y
Var rsB1Y As Double = dqBS * cc.AnchorB1X + dqBC * cc.AnchorB1Y
Var ds1X As Double = dpX + rsB1X - rsA1X
Var ds1Y As Double = dpY + rsB1Y - rsA1Y
Var s1 As Double = (cc.NormalX * ds1X + cc.NormalY * ds1Y) + cc.BaseSeparation1

Var bias1 As Double = Maths.Max(biasRate * s1, minBiasVelocity)
Var pointMassScale1 As Double = massScale
Var pointImpulseScale1 As Double = impulseScale
If s1 > 0.0 Then
# Speculative bias for separated points; the min bias velocity limits
# stiffness rather than increasing it.
bias1 = s1 * invH
pointMassScale1 = 1.0
pointImpulseScale1 = 0.0
End If

Var dv1X As Double = vBX - wB * cc.AnchorB1Y - (vAX - wA * cc.AnchorA1Y)
Var dv1Y As Double = vBY + wB * cc.AnchorB1X - (vAY + wA * cc.AnchorA1X)
Var vn1 As Double = dv1X * cc.NormalX + dv1Y * cc.NormalY

Var negImpulse1 As Double = cc.NormalMass1 * (pointMassScale1 * (vn1 + bias1)) + pointImpulseScale1 * cc.NormalImpulse1
Var newImpulse1 As Double = cc.NormalImpulse1 - negImpulse1
If newImpulse1 < 0.0 Then
newImpulse1 = 0.0
End If
Var impulse1 As Double = newImpulse1 - cc.NormalImpulse1
cc.NormalImpulse1 = newImpulse1
cc.TotalNormalImpulse1 = cc.TotalNormalImpulse1 + newImpulse1

Var p1X As Double = impulse1 * cc.NormalX
Var p1Y As Double = impulse1 * cc.NormalY
vAX = vAX - cc.InvMassA * p1X
vAY = vAY - cc.InvMassA * p1Y
wA = wA - cc.InvIA * (cc.AnchorA1X * p1Y - cc.AnchorA1Y * p1X)
vBX = vBX + cc.InvMassB * p1X
vBY = vBY + cc.InvMassB * p1Y
wB = wB + cc.InvIB * (cc.AnchorB1X * p1Y - cc.AnchorB1Y * p1X)

# Point two non-penetration constraint.
Var rsA2X As Double = dqAC * cc.AnchorA2X - dqAS * cc.AnchorA2Y
Var rsA2Y As Double = dqAS * cc.AnchorA2X + dqAC * cc.AnchorA2Y
Var rsB2X As Double = dqBC * cc.AnchorB2X - dqBS * cc.AnchorB2Y
Var rsB2Y As Double = dqBS * cc.AnchorB2X + dqBC * cc.AnchorB2Y
Var ds2X As Double = dpX + rsB2X - rsA2X
Var ds2Y As Double = dpY + rsB2Y - rsA2Y
Var s2 As Double = (cc.NormalX * ds2X + cc.NormalY * ds2Y) + cc.BaseSeparation2

Var bias2 As Double = Maths.Max(biasRate * s2, minBiasVelocity)
Var pointMassScale2 As Double = massScale
Var pointImpulseScale2 As Double = impulseScale
If s2 > 0.0 Then
bias2 = s2 * invH
pointMassScale2 = 1.0
pointImpulseScale2 = 0.0
End If

Var rA2X As Double = cc.AnchorA2X
Var rA2Y As Double = cc.AnchorA2Y
Var rB2X As Double = cc.AnchorB2X
Var rB2Y As Double = cc.AnchorB2Y

Var dv2X As Double = vBX - wB * rB2Y - (vAX - wA * rA2Y)
Var dv2Y As Double = vBY + wB * rB2X - (vAY + wA * rA2X)
Var vn2 As Double = dv2X * cc.NormalX + dv2Y * cc.NormalY

Var negImpulse2 As Double = cc.NormalMass2 * (pointMassScale2 * (vn2 + bias2)) + pointImpulseScale2 * cc.NormalImpulse2
Var newImpulse2 As Double = cc.NormalImpulse2 - negImpulse2
If newImpulse2 < 0.0 Then
newImpulse2 = 0.0
End If
Var impulse2 As Double = newImpulse2 - cc.NormalImpulse2
cc.NormalImpulse2 = newImpulse2
cc.TotalNormalImpulse2 = cc.TotalNormalImpulse2 + newImpulse2

Var p2X As Double = impulse2 * cc.NormalX
Var p2Y As Double = impulse2 * cc.NormalY
vAX = vAX - cc.InvMassA * p2X
vAY = vAY - cc.InvMassA * p2Y
wA = wA - cc.InvIA * (rA2X * p2Y - rA2Y * p2X)
vBX = vBX + cc.InvMassB * p2X
vBY = vBY + cc.InvMassB * p2Y
wB = wB + cc.InvIB * (rB2X * p2Y - rB2Y * p2X)

# Friction constraints with conveyor-belt tangent speed.
Var tangentX As Double = cc.NormalY
Var tangentY As Double = -cc.NormalX

Var dvF1X As Double = vBX - wB * cc.AnchorB1Y - (vAX - wA * cc.AnchorA1Y)
Var dvF1Y As Double = vBY + wB * cc.AnchorB1X - (vAY + wA * cc.AnchorA1X)
Var vt1 As Double = dvF1X * tangentX + dvF1Y * tangentY - cc.TangentSpeed
Var negTangent1 As Double = cc.TangentMass1 * vt1
Var maxFriction1 As Double = cc.Friction * cc.NormalImpulse1
Var newTangent1 As Double = cc.TangentImpulse1 - negTangent1
If newTangent1 < -maxFriction1 Then
newTangent1 = -maxFriction1
End If
If newTangent1 > maxFriction1 Then
newTangent1 = maxFriction1
End If
Var tangentDelta1 As Double = newTangent1 - cc.TangentImpulse1
cc.TangentImpulse1 = newTangent1

Var f1X As Double = tangentDelta1 * tangentX
Var f1Y As Double = tangentDelta1 * tangentY
vAX = vAX - cc.InvMassA * f1X
vAY = vAY - cc.InvMassA * f1Y
wA = wA - cc.InvIA * (cc.AnchorA1X * f1Y - cc.AnchorA1Y * f1X)
vBX = vBX + cc.InvMassB * f1X
vBY = vBY + cc.InvMassB * f1Y
wB = wB + cc.InvIB * (cc.AnchorB1X * f1Y - cc.AnchorB1Y * f1X)

Var dvF2X As Double = vBX - wB * cc.AnchorB2Y - (vAX - wA * cc.AnchorA2Y)
Var dvF2Y As Double = vBY + wB * cc.AnchorB2X - (vAY + wA * cc.AnchorA2X)
Var vt2 As Double = dvF2X * tangentX + dvF2Y * tangentY - cc.TangentSpeed
Var negTangent2 As Double = cc.TangentMass2 * vt2
Var maxFriction2 As Double = cc.Friction * cc.NormalImpulse2
Var newTangent2 As Double = cc.TangentImpulse2 - negTangent2
If newTangent2 < -maxFriction2 Then
newTangent2 = -maxFriction2
End If
If newTangent2 > maxFriction2 Then
newTangent2 = maxFriction2
End If
Var tangentDelta2 As Double = newTangent2 - cc.TangentImpulse2
cc.TangentImpulse2 = newTangent2

Var f2X As Double = tangentDelta2 * tangentX
Var f2Y As Double = tangentDelta2 * tangentY
vAX = vAX - cc.InvMassA * f2X
vAY = vAY - cc.InvMassA * f2Y
wA = wA - cc.InvIA * (cc.AnchorA2X * f2Y - cc.AnchorA2Y * f2X)
vBX = vBX + cc.InvMassB * f2X
vBY = vBY + cc.InvMassB * f2Y
wB = wB + cc.InvIB * (cc.AnchorB2X * f2Y - cc.AnchorB2Y * f2X)

# Rolling resistance.
Var totalNormalImpulse As Double = cc.TotalNormalImpulse1 + cc.TotalNormalImpulse2
Var deltaLambda As Double = cc.RollingMass * (wA - wB)
Var maxLambda As Double = cc.RollingResistance * totalNormalImpulse
Var lambda As Double = cc.RollingImpulse + deltaLambda
If lambda < -maxLambda Then
lambda = -maxLambda
End If
If lambda > maxLambda Then
lambda = maxLambda
End If
Var rollingDelta As Double = lambda - cc.RollingImpulse
cc.RollingImpulse = lambda
wA = wA - cc.InvIA * rollingDelta
wB = wB + cc.InvIB * rollingDelta

If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexA] = vAX
states.LVY.Items[cc.IndexA] = vAY
states.AngularVelocity.Items[cc.IndexA] = wA
End If
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexB] = vBX
states.LVY.Items[cc.IndexB] = vBY
states.AngularVelocity.Items[cc.IndexB] = wB
End If
End Sub

## Applies restitution once after the velocity iterations, ported from
## b2ApplyRestitutionTask.
Shared Sub ApplyContactRestitution(states As BodyStates, cc As ContactConstraint, restitutionThreshold As Double)
If cc.Restitution = 0.0 Then
Return
End If
Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[cc.IndexA]
vAY = states.LVY.Items[cc.IndexA]
wA = states.AngularVelocity.Items[cc.IndexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[cc.IndexB]
vBY = states.LVY.Items[cc.IndexB]
wB = states.AngularVelocity.Items[cc.IndexB]
End If

# Point one.
Var mass1 As Double = cc.NormalMass1
If cc.RelativeVelocity1 + restitutionThreshold > 0.0 Or cc.TotalNormalImpulse1 = 0.0 Then
mass1 = 0.0
End If
Var dv1X As Double = vBX - wB * cc.AnchorB1Y - (vAX - wA * cc.AnchorA1Y)
Var dv1Y As Double = vBY + wB * cc.AnchorB1X - (vAY + wA * cc.AnchorA1X)
Var vn1 As Double = dv1X * cc.NormalX + dv1Y * cc.NormalY
Var negImpulse1 As Double = mass1 * (vn1 + cc.Restitution * cc.RelativeVelocity1)
Var newImpulse1 As Double = cc.NormalImpulse1 - negImpulse1
If newImpulse1 < 0.0 Then
newImpulse1 = 0.0
End If
Var impulse1 As Double = newImpulse1 - cc.NormalImpulse1
cc.NormalImpulse1 = newImpulse1
Var p1X As Double = impulse1 * cc.NormalX
Var p1Y As Double = impulse1 * cc.NormalY
vAX = vAX - cc.InvMassA * p1X
vAY = vAY - cc.InvMassA * p1Y
wA = wA - cc.InvIA * (cc.AnchorA1X * p1Y - cc.AnchorA1Y * p1X)
vBX = vBX + cc.InvMassB * p1X
vBY = vBY + cc.InvMassB * p1Y
wB = wB + cc.InvIB * (cc.AnchorB1X * p1Y - cc.AnchorB1Y * p1X)

# Point two.
Var mass2 As Double = cc.NormalMass2
If cc.RelativeVelocity2 + restitutionThreshold > 0.0 Or cc.TotalNormalImpulse2 = 0.0 Then
mass2 = 0.0
End If
Var dv2X As Double = vBX - wB * cc.AnchorB2Y - (vAX - wA * cc.AnchorA2Y)
Var dv2Y As Double = vBY + wB * cc.AnchorB2X - (vAY + wA * cc.AnchorA2X)
Var vn2 As Double = dv2X * cc.NormalX + dv2Y * cc.NormalY
Var negImpulse2 As Double = mass2 * (vn2 + cc.Restitution * cc.RelativeVelocity2)
Var newImpulse2 As Double = cc.NormalImpulse2 - negImpulse2
If newImpulse2 < 0.0 Then
newImpulse2 = 0.0
End If
Var impulse2 As Double = newImpulse2 - cc.NormalImpulse2
cc.NormalImpulse2 = newImpulse2
Var p2X As Double = impulse2 * cc.NormalX
Var p2Y As Double = impulse2 * cc.NormalY
vAX = vAX - cc.InvMassA * p2X
vAY = vAY - cc.InvMassA * p2Y
wA = wA - cc.InvIA * (cc.AnchorA2X * p2Y - cc.AnchorA2Y * p2X)
vBX = vBX + cc.InvMassB * p2X
vBY = vBY + cc.InvMassB * p2Y
wB = wB + cc.InvIB * (cc.AnchorB2X * p2Y - cc.AnchorB2Y * p2X)

If cc.IndexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexA] = vAX
states.LVY.Items[cc.IndexA] = vAY
states.AngularVelocity.Items[cc.IndexA] = wA
End If
If cc.IndexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[cc.IndexB] = vBX
states.LVY.Items[cc.IndexB] = vBY
states.AngularVelocity.Items[cc.IndexB] = wB
End If
End Sub

## Copies the accumulated impulses back into the manifold for warm
## starting the next step, ported from b2StoreImpulsesTask.
Shared Sub StoreImpulses(cc As ContactConstraint, manifold As Manifold)
manifold.RollingImpulse = cc.RollingImpulse
manifold.Point1.NormalImpulse = cc.NormalImpulse1
manifold.Point1.TangentImpulse = cc.TangentImpulse1
manifold.Point1.TotalNormalImpulse = cc.TotalNormalImpulse1
manifold.Point1.NormalVelocity = cc.RelativeVelocity1
manifold.Point2.NormalImpulse = cc.NormalImpulse2
manifold.Point2.TangentImpulse = cc.TangentImpulse2
manifold.Point2.TotalNormalImpulse = cc.TotalNormalImpulse2
manifold.Point2.NormalVelocity = cc.RelativeVelocity2
End Sub
End Class

# Scratch state for one fast body's continuous sweep, ported from struct
# b2ContinuousContext in solver.c. The world owns one instance reused per
# solve.
Class ContinuousContext
## The fast body's sweep from its pre-solve transform to its current one.
Property Sweep As Sweep
## Fast shape under test.
Property FastShape As Shape
## Fast body slot.
Property FastBodyId As Integer
## Fast body's awake sim index.
Property FastBodySimIndex As Integer
## Fast shape centroid at sweep start.
Property Centroid1 As Vector2
## Fast shape centroid at sweep end.
Property Centroid2 As Vector2
## Earliest hit fraction found so far, starting at one.
Property Fraction As Double

## Creates the context with reusable sweep objects.
Constructor()
Me.Sweep = New Sweep
Me.Centroid1 = New Vector2
Me.Centroid2 = New Vector2
Me.Fraction = 1.0
End Constructor
End Class

# Tree query callback for continuous collision, ported from
# b2ContinuousQueryCallback in solver.c. The world owns one instance reused
# per sweep; QueryTo mutates the shared context fraction on a hit.
Class ContinuousQueryCallback Inherits TreeQueryCallback
## Owning world.
Property World As World
## Shared sweep context.
Property Context As ContinuousContext

## Tests one candidate shape against the fast body's sweep.
Override Function VisitLeaf(proxyId As Integer, userData As Integer) As Boolean
Pragma Unused proxyId
Return Me.World.ContinuousHitTest(userData, Me.Context)
End Function
End Class

# Deterministic cosine/sine pair used to build rotations.
#
# Mirrors the upstream b2CosSin struct from include/box2d/math_functions.h.
# Instances are small and reusable: warm code passes a caller-owned object
# to PhysicsMaths.ComputeCosSin(radians, out) instead of allocating.
Class CosSin
## Sine of the angle.
Property Sin As Double
## Cosine of the angle.
Property Cos As Double

## Creates a pair with both components zero.
Constructor()
Me.Sin = 0.0
Me.Cos = 0.0
End Constructor

## Creates a pair from components.
Constructor(sinValue As Double, cosValue As Double)
Me.Sin = sinValue
Me.Cos = cosValue
End Constructor

## Resets both components.
Sub SetPair(sinValue As Double, cosValue As Double)
Me.Sin = sinValue
Me.Cos = cosValue
End Sub
End Class

# Opt-in custom contact filter, ported from upstream b2CustomFilterFcn in
# types.h. The world applies the built-in shape and body rules first and
# consults this hook last, so leaving CustomFilter as Nothing costs nothing.
#
# Return True to let the pair collide, False to suppress the contact. The
# hook runs during broad-phase pair discovery and must not mutate the world.
Class CustomContactFilter
## Returns True when the two shapes may collide.
Function ShouldCollide(shapeA As Shape, shapeB As Shape) As Boolean
Pragma Unused shapeA
Pragma Unused shapeB
Return True
End Function
End Class

# Opt-in friction and restitution mixing, ported from the upstream friction
# and restitution callbacks on the world definition. When the world's
# MaterialMixer is Nothing the built-in square-root friction and maximum
# restitution rules apply at no extra cost.
#
# The hook runs while the world is locked and must not mutate world objects.
Class CustomMaterialMixer
## Returns the mixed friction for a new contact pair.
Function MixFriction(frictionA As Double, userMaterialIdA As Integer, frictionB As Double, userMaterialIdB As Integer) As Double
Pragma Unused userMaterialIdA
Pragma Unused userMaterialIdB
Return Maths.Sqrt(frictionA * frictionB)
End Function

## Returns the mixed restitution for a new contact pair.
Function MixRestitution(restitutionA As Double, userMaterialIdA As Integer, restitutionB As Double, userMaterialIdB As Integer) As Double
Pragma Unused userMaterialIdA
Pragma Unused userMaterialIdB
If restitutionA > restitutionB Then
Return restitutionA
End If
Return restitutionB
End Function
End Class

# Opt-in pre-solve manifold editing, ported from upstream b2PreSolveFcn in
# types.h. The world consults this hook during the narrow phase for a
# touching contact when either shape opted in with EnablePreSolveEvents;
# leaving PreSolve as Nothing costs nothing.
#
# The hook runs while the world is locked and must not create, destroy, or
# modify world objects. It may edit the live manifold, and returning False
# disables the contact for this step by zeroing its point count.
Class CustomPreSolve
## Returns True to keep the contact, False to disable it for this step.
Function PreSolve(shapeA As Shape, shapeB As Shape, manifold As Manifold) As Boolean
Pragma Unused shapeA
Pragma Unused shapeB
Pragma Unused manifold
Return True
End Function
End Class

# Distance computations, ported from upstream distance.c.
#
# ShapeDistance runs the GJK algorithm between two point-cloud proxies. The
# warm To-form reuses the simplex stored in the caller's SimplexCache and the
# scratch storage owned by the caller's DistanceOutput, so repeated queries
# allocate nothing. SegmentDistance follows Ericson 5.1.9.
#
# All arithmetic is scalar over Doubles and writes into owned vectors,
# mirroring the upstream float arithmetic component by component. Upstream's
# optional debug simplex capture is not ported; DistanceOutput.SimplexCount
# stays zero.
Class Distance
## Computes the distance between two line segments into a new result,
## ported from upstream b2SegmentDistance. Clamps at the endpoints when
## needed.
Shared Function SegmentDistance(p1 As Vector2, q1 As Vector2, p2 As Vector2, q2 As Vector2) As SegmentDistanceResult
Var result As New SegmentDistanceResult
Distance.SegmentDistanceTo(p1, q1, p2, q2, result)
Return result
End Function

## Computes the distance between two line segments into the caller-owned
## out result and returns out. The reused-output form for warm loops.
Shared Function SegmentDistanceTo(p1 As Vector2, q1 As Vector2, p2 As Vector2, q2 As Vector2, out As SegmentDistanceResult) As SegmentDistanceResult
Var d1x As Double = q1.X - p1.X
Var d1y As Double = q1.Y - p1.Y
Var d2x As Double = q2.X - p2.X
Var d2y As Double = q2.Y - p2.Y
Var rx As Double = p1.X - p2.X
Var ry As Double = p1.Y - p2.Y
Var dd1 As Double = d1x * d1x + d1y * d1y
Var dd2 As Double = d2x * d2x + d2y * d2y
Var rd1 As Double = rx * d1x + ry * d1y
Var rd2 As Double = rx * d2x + ry * d2y

Var epsSqr As Double = 0.0000001192092896 * 0.0000001192092896

Var f1 As Double = 0.0
Var f2 As Double = 0.0

If dd1 < epsSqr Or dd2 < epsSqr Then
# Handle all degeneracies.
If dd1 >= epsSqr Then
# Segment 2 is degenerate.
f1 = Distance.Clamp01(-rd1 / dd1)
f2 = 0.0
ElseIf dd2 >= epsSqr Then
# Segment 1 is degenerate.
f1 = 0.0
f2 = Distance.Clamp01(rd2 / dd2)
Else
f1 = 0.0
f2 = 0.0
End If
Else
# Non-degenerate segments.
Var d12 As Double = d1x * d2x + d1y * d2y

Var denominator As Double = dd1 * dd2 - d12 * d12

# Fraction on segment 1.
If denominator <> 0.0 Then
# Not parallel.
f1 = Distance.Clamp01((d12 * rd2 - rd1 * dd2) / denominator)
End If

# Compute point on segment 2 closest to p1 + f1 * d1.
f2 = (d12 * f1 + rd2) / dd2

# Clamping of segment 2 requires a do-over on segment 1.
If f2 < 0.0 Then
f2 = 0.0
f1 = Distance.Clamp01(-rd1 / dd1)
ElseIf f2 > 1.0 Then
f2 = 1.0
f1 = Distance.Clamp01((d12 - rd1) / dd1)
End If
End If

out.Fraction1 = f1
out.Fraction2 = f2
out.Closest1.Set(p1.X + f1 * d1x, p1.Y + f1 * d1y)
out.Closest2.Set(p2.X + f2 * d2x, p2.Y + f2 * d2y)
Var ex As Double = out.Closest1.X - out.Closest2.X
Var ey As Double = out.Closest1.Y - out.Closest2.Y
out.DistanceSquared = ex * ex + ey * ey
Return out
End Function

## Computes the closest points between two shapes represented as point
## clouds into a new output, ported from upstream b2ShapeDistance. The
## cache is input and output: set its count to zero on the first call.
Shared Function ShapeDistance(input As DistanceInput, cache As SimplexCache) As DistanceOutput
Var out As New DistanceOutput
Distance.ShapeDistanceTo(input, cache, out)
Return out
End Function

## Computes the closest points between two shapes into the caller-owned
## out output and returns out. The reused-output form for warm loops: the
## simplex lives in the cache and scratch storage in the output, so steady
## state allocates nothing.
Shared Function ShapeDistanceTo(input As DistanceInput, cache As SimplexCache, out As DistanceOutput) As DistanceOutput
If input.ProxyA.Count <= 0 Or input.ProxyB.Count <= 0 Then
Throw New InvalidArgumentException("ShapeDistance proxies must hold at least one point")
End If
If input.ProxyA.Radius < 0.0 Or input.ProxyB.Radius < 0.0 Then
Throw New InvalidArgumentException("ShapeDistance proxy radii must be non-negative")
End If

Var proxyA As ShapeProxy = input.ProxyA
Var scratch As DistanceScratch = out.Scratch()
Var localProxyB As ShapeProxy = scratch.LocalProxyB

# Get proxy B in frame A to avoid further transforms in the main loop.
Var qa As Double = input.TransformA.Q.C
Var sa As Double = input.TransformA.Q.S
Var qb As Double = input.TransformB.Q.C
Var sb As Double = input.TransformB.Q.S
Var c As Double = qa * qb + sa * sb
Var s As Double = -sa * qb + qa * sb
Var bx0 As Double = input.TransformB.P.X - input.TransformA.P.X
Var by0 As Double = input.TransformB.P.Y - input.TransformA.P.Y
Var px As Double = qa * bx0 + sa * by0
Var py As Double = -sa * bx0 + qa * by0

Var bCount As Integer = input.ProxyB.Count
localProxyB.Count = bCount
localProxyB.Radius = input.ProxyB.Radius
While localProxyB.Points.Count < bCount
localProxyB.Points.Append(New Vector2(0.0, 0.0))
Wend
For i As Integer = 0 To bCount - 1
Var bx As Double = input.ProxyB.Points[i].X
Var by As Double = input.ProxyB.Points[i].Y
localProxyB.Points[i].Set(c * bx - s * by + px, s * bx + c * by + py)
Next i

# Initialize the simplex from the cache.
Var simplex As Simplex = cache.Workspace()
Distance.MakeSimplexFromCache(cache, proxyA, localProxyB, simplex)

Var nonUnitNormalX As Double = 0.0
Var nonUnitNormalY As Double = 0.0

# These store the vertices of the last simplex so duplicates can be
# detected and cycling prevented.
Var saveA0 As Integer = 0
Var saveA1 As Integer = 0
Var saveA2 As Integer = 0
Var saveB0 As Integer = 0
Var saveB1 As Integer = 0
Var saveB2 As Integer = 0

# Main iteration loop. All computations are done in frame A.
Var maxIterations As Integer = 20
Var iteration As Integer = 0
While iteration < maxIterations
# Copy the simplex so duplicates can be identified.
Var saveCount As Integer = simplex.Count
saveA0 = simplex.V1.IndexA
saveB0 = simplex.V1.IndexB
If saveCount > 1 Then
saveA1 = simplex.V2.IndexA
saveB1 = simplex.V2.IndexB
End If
If saveCount > 2 Then
saveA2 = simplex.V3.IndexA
saveB2 = simplex.V3.IndexB
End If

If simplex.Count = 1 Then
scratch.Direction.Set(-simplex.V1.W.X, -simplex.V1.W.Y)
ElseIf simplex.Count = 2 Then
Distance.SolveSimplex2(simplex, scratch.Direction)
Else
Distance.SolveSimplex3(simplex, scratch.Direction)
End If

# If there are three points the origin is inside the triangle: overlap.
If simplex.Count = 3 Then
Distance.WriteOverlapOutput(input, out, simplex)
Return out
End If

# Ensure the search direction is numerically fit.
Var dX As Double = scratch.Direction.X
Var dY As Double = scratch.Direction.Y
If dX * dX + dY * dY < 0.0000001192092896 * 0.0000001192092896 Then
# The origin is probably contained by a line segment or triangle, so
# the shapes overlap. Return overlap due to the invalid normal.
Distance.WriteOverlapOutput(input, out, simplex)
Return out
End If

# Save the normal.
nonUnitNormalX = dX
nonUnitNormalY = dY

# Compute a tentative new simplex vertex using support points.
# support = support(a, d) - support(b, -d)
Var vertex As SimplexVertex = simplex.VertexAt(simplex.Count)
vertex.IndexA = Distance.FindSupport(proxyA, dX, dY)
vertex.WA.Set(proxyA.Points[vertex.IndexA].X, proxyA.Points[vertex.IndexA].Y)
vertex.IndexB = Distance.FindSupport(localProxyB, -dX, -dY)
vertex.WB.Set(localProxyB.Points[vertex.IndexB].X, localProxyB.Points[vertex.IndexB].Y)
vertex.W.Set(vertex.WA.X - vertex.WB.X, vertex.WA.Y - vertex.WB.Y)

# The iteration count equals the number of support point calls.
iteration = iteration + 1

# Check for duplicate support points: the main termination criterion. A
# duplicate means we must exit to avoid cycling. The tentative vertex is
# not committed, matching upstream, so the cached simplex never holds
# three points outside the overlap case.
If Distance.IsDuplicateSupport(saveCount, vertex.IndexA, vertex.IndexB, saveA0, saveA1, saveA2, saveB0, saveB1, saveB2) Then
Exit While
End If

# The new vertex is valid and needed.
simplex.Count = simplex.Count + 1
Wend

# Prepare output, cache the simplex, and apply radii if requested.
Distance.WriteDistanceOutput(input, out, cache, simplex, qa, sa, nonUnitNormalX, nonUnitNormalY, iteration)
Return out
End Function

## Fills the workspace simplex from the cache, ported from upstream
## b2MakeSimplexFromCache.
Shared Sub MakeSimplexFromCache(cache As SimplexCache, proxyA As ShapeProxy, localProxyB As ShapeProxy, simplex As Simplex)
If cache.Count > 3 Then
Throw New RuntimeException("SimplexCache count must not exceed three")
End If

simplex.Count = cache.Count
For i As Integer = 0 To simplex.Count - 1
Var v As SimplexVertex = simplex.VertexAt(i)
v.IndexA = cache.IndexA[i]
v.IndexB = cache.IndexB[i]
v.WA.Set(proxyA.Points[v.IndexA].X, proxyA.Points[v.IndexA].Y)
v.WB.Set(localProxyB.Points[v.IndexB].X, localProxyB.Points[v.IndexB].Y)
v.W.Set(v.WA.X - v.WB.X, v.WA.Y - v.WB.Y)

# Invalid until solved.
v.A = -1.0
Next i

# If the cache is empty or invalid, seed with the first support pair.
If simplex.Count = 0 Then
Var v As SimplexVertex = simplex.V1
v.IndexA = 0
v.IndexB = 0
v.WA.Set(proxyA.Points[0].X, proxyA.Points[0].Y)
v.WB.Set(localProxyB.Points[0].X, localProxyB.Points[0].Y)
v.W.Set(v.WA.X - v.WB.X, v.WA.Y - v.WB.Y)
v.A = 1.0
simplex.Count = 1
End If
End Sub

## Writes the simplex back into the cache, ported from upstream
## b2MakeSimplexCache.
Shared Sub MakeSimplexCache(cache As SimplexCache, simplex As Simplex)
cache.Count = simplex.Count
For i As Integer = 0 To simplex.Count - 1
Var v As SimplexVertex = simplex.VertexAt(i)
cache.IndexA[i] = v.IndexA
cache.IndexB[i] = v.IndexB
Next i
End Sub

## Writes the two witness points of the simplex into the caller-owned
## vectors, ported from upstream b2ComputeSimplexWitnessPoints.
Shared Sub ComputeWitnessPoints(simplex As Simplex, a As Vector2, b As Vector2)
If simplex.Count = 1 Then
a.Set(simplex.V1.WA.X, simplex.V1.WA.Y)
b.Set(simplex.V1.WB.X, simplex.V1.WB.Y)
ElseIf simplex.Count = 2 Then
Var a1 As Double = simplex.V1.A
Var a2 As Double = simplex.V2.A
a.Set(a1 * simplex.V1.WA.X + a2 * simplex.V2.WA.X, a1 * simplex.V1.WA.Y + a2 * simplex.V2.WA.Y)
b.Set(a1 * simplex.V1.WB.X + a2 * simplex.V2.WB.X, a1 * simplex.V1.WB.Y + a2 * simplex.V2.WB.Y)
ElseIf simplex.Count = 3 Then
Var a1 As Double = simplex.V1.A
Var a2 As Double = simplex.V2.A
Var a3 As Double = simplex.V3.A
Var ax As Double = a1 * simplex.V1.WA.X + a2 * simplex.V2.WA.X + a3 * simplex.V3.WA.X
Var ay As Double = a1 * simplex.V1.WA.Y + a2 * simplex.V2.WA.Y + a3 * simplex.V3.WA.Y
a.Set(ax, ay)
b.Set(ax, ay)
Else
a.Set(0.0, 0.0)
b.Set(0.0, 0.0)
Throw New RuntimeException("Simplex count must be between one and three")
End If
End Sub

## Solves a two-vertex simplex with barycentric coordinates and writes the
## search direction that points towards the origin, ported from upstream
## b2SolveSimplex2.
Shared Sub SolveSimplex2(simplex As Simplex, direction As Vector2)
Var w1x As Double = simplex.V1.W.X
Var w1y As Double = simplex.V1.W.Y
Var w2x As Double = simplex.V2.W.X
Var w2y As Double = simplex.V2.W.Y
Var e12x As Double = w2x - w1x
Var e12y As Double = w2y - w1y

# w1 region
Var d12_2 As Double = -(w1x * e12x + w1y * e12y)
If d12_2 <= 0.0 Then
# a2 <= 0, so clamp it to zero.
simplex.V1.A = 1.0
simplex.Count = 1
direction.Set(-w1x, -w1y)
Return
End If

# w2 region
Var d12_1 As Double = w2x * e12x + w2y * e12y
If d12_1 <= 0.0 Then
# a1 <= 0, so clamp it to zero.
simplex.V2.A = 1.0
simplex.Count = 1
simplex.V1.SetFrom(simplex.V2)
direction.Set(-w2x, -w2y)
Return
End If

# Must be in the e12 region.
Var invD12 As Double = 1.0 / (d12_1 + d12_2)
simplex.V1.A = d12_1 * invD12
simplex.V2.A = d12_2 * invD12
simplex.Count = 2

# Direction is crossSV(cross(w1 + w2, e12), e12).
Var wx As Double = w1x + w2x
Var wy As Double = w1y + w2y
Var c As Double = wx * e12y - wy * e12x
direction.Set(-c * e12y, c * e12x)
End Sub

## Solves a three-vertex simplex, reducing it to the feature containing the
## origin and writing the search direction, ported from upstream
## b2SolveSimplex3.
Shared Sub SolveSimplex3(simplex As Simplex, direction As Vector2)
Var w1x As Double = simplex.V1.W.X
Var w1y As Double = simplex.V1.W.Y
Var w2x As Double = simplex.V2.W.X
Var w2y As Double = simplex.V2.W.Y
Var w3x As Double = simplex.V3.W.X
Var w3y As Double = simplex.V3.W.Y

# Edge12
Var e12x As Double = w2x - w1x
Var e12y As Double = w2y - w1y
Var w1e12 As Double = w1x * e12x + w1y * e12y
Var w2e12 As Double = w2x * e12x + w2y * e12y
Var d12_1 As Double = w2e12
Var d12_2 As Double = -w1e12

# Edge13
Var e13x As Double = w3x - w1x
Var e13y As Double = w3y - w1y
Var w1e13 As Double = w1x * e13x + w1y * e13y
Var w3e13 As Double = w3x * e13x + w3y * e13y
Var d13_1 As Double = w3e13
Var d13_2 As Double = -w1e13

# Edge23
Var e23x As Double = w3x - w2x
Var e23y As Double = w3y - w2y
Var w2e23 As Double = w2x * e23x + w2y * e23y
Var w3e23 As Double = w3x * e23x + w3y * e23y
Var d23_1 As Double = w3e23
Var d23_2 As Double = -w2e23

# Triangle123
Var n123 As Double = e12x * e13y - e12y * e13x

Var d123_1 As Double = n123 * (w2x * w3y - w2y * w3x)
Var d123_2 As Double = n123 * (w3x * w1y - w3y * w1x)
Var d123_3 As Double = n123 * (w1x * w2y - w1y * w2x)

# w1 region
If d12_2 <= 0.0 And d13_2 <= 0.0 Then
simplex.V1.A = 1.0
simplex.Count = 1
direction.Set(-w1x, -w1y)
Return
End If

# e12 region
If d12_1 > 0.0 And d12_2 > 0.0 And d123_3 <= 0.0 Then
Var invD12 As Double = 1.0 / (d12_1 + d12_2)
simplex.V1.A = d12_1 * invD12
simplex.V2.A = d12_2 * invD12
simplex.Count = 2
Var wx As Double = w1x + w2x
Var wy As Double = w1y + w2y
Var c As Double = wx * e12y - wy * e12x
direction.Set(-c * e12y, c * e12x)
Return
End If

# e13 region
If d13_1 > 0.0 And d13_2 > 0.0 And d123_2 <= 0.0 Then
Var invD13 As Double = 1.0 / (d13_1 + d13_2)
simplex.V1.A = d13_1 * invD13
simplex.V3.A = d13_2 * invD13
simplex.Count = 2
simplex.V2.SetFrom(simplex.V3)
Var wx As Double = w1x + w3x
Var wy As Double = w1y + w3y
Var c As Double = wx * e13y - wy * e13x
direction.Set(-c * e13y, c * e13x)
Return
End If

# w2 region
If d12_1 <= 0.0 And d23_2 <= 0.0 Then
simplex.V2.A = 1.0
simplex.Count = 1
simplex.V1.SetFrom(simplex.V2)
direction.Set(-w2x, -w2y)
Return
End If

# w3 region
If d13_1 <= 0.0 And d23_1 <= 0.0 Then
simplex.V3.A = 1.0
simplex.Count = 1
simplex.V1.SetFrom(simplex.V3)
direction.Set(-w3x, -w3y)
Return
End If

# e23 region
If d23_1 > 0.0 And d23_2 > 0.0 And d123_1 <= 0.0 Then
Var invD23 As Double = 1.0 / (d23_1 + d23_2)
simplex.V2.A = d23_1 * invD23
simplex.V3.A = d23_2 * invD23
simplex.Count = 2
simplex.V1.SetFrom(simplex.V3)
Var wx As Double = w2x + w3x
Var wy As Double = w2y + w3y
Var c As Double = wx * e23y - wy * e23x
direction.Set(-c * e23y, c * e23x)
Return
End If

# Must be inside triangle123.
Var invD123 As Double = 1.0 / (d123_1 + d123_2 + d123_3)
simplex.V1.A = d123_1 * invD123
simplex.V2.A = d123_2 * invD123
simplex.V3.A = d123_3 * invD123
simplex.Count = 3

# No search direction: the origin is contained.
direction.Set(0.0, 0.0)
End Sub

## Finds the index of the support point furthest along the direction,
## ported from upstream b2FindSupport.
Shared Function FindSupport(proxy As ShapeProxy, dirX As Double, dirY As Double) As Integer
Var bestIndex As Integer = 0
Var bestValue As Double = proxy.Points[0].X * dirX + proxy.Points[0].Y * dirY
For i As Integer = 1 To proxy.Count - 1
Var value As Double = proxy.Points[i].X * dirX + proxy.Points[i].Y * dirY
If value > bestValue Then
bestIndex = i
bestValue = value
End If
Next i
Return bestIndex
End Function


## Writes the overlap output when the origin is contained by the simplex.
Shared Sub WriteOverlapOutput(input As DistanceInput, out As DistanceOutput, simplex As Simplex)
Var scratch As DistanceScratch = out.Scratch()
Distance.ComputeWitnessPoints(simplex, scratch.WitnessA, scratch.WitnessB)
Distance.TransformInto(out.PointA, input.TransformA, scratch.WitnessA)
Distance.TransformInto(out.PointB, input.TransformA, scratch.WitnessB)
# Upstream zero-initialises b2DistanceOutput, so the overlap paths
# effectively report zero distance and a zero normal. Match that for
# reused outputs.
out.Distance = 0.0
out.Normal.Set(0.0, 0.0)
End Sub

## Determines whether the tentative support point repeats an earlier simplex
## vertex, which signals convergence.
Shared Function IsDuplicateSupport(saveCount As Integer, indexA As Integer, indexB As Integer, saveA0 As Integer, saveA1 As Integer, saveA2 As Integer, saveB0 As Integer, saveB1 As Integer, saveB2 As Integer) As Boolean
If saveCount > 0 And indexA = saveA0 And indexB = saveB0 Then
Return True
End If
If saveCount > 1 And indexA = saveA1 And indexB = saveB1 Then
Return True
End If
If saveCount > 2 And indexA = saveA2 And indexB = saveB2 Then
Return True
End If
Return False
End Function

## Writes the miss-path distance output, caches the simplex, and applies
## proxy radii when requested.
Shared Sub WriteDistanceOutput(input As DistanceInput, out As DistanceOutput, cache As SimplexCache, simplex As Simplex, qa As Double, sa As Double, nonUnitNormalX As Double, nonUnitNormalY As Double, iteration As Integer)
Var scratch As DistanceScratch = out.Scratch()
Var invLen As Double = 0.0
Var nLen As Double = Maths.Sqrt(nonUnitNormalX * nonUnitNormalX + nonUnitNormalY * nonUnitNormalY)
If nLen > 0.0 Then
invLen = 1.0 / nLen
End If
Var nx As Double = nonUnitNormalX * invLen
Var ny As Double = nonUnitNormalY * invLen
out.Normal.Set(qa * nx - sa * ny, sa * nx + qa * ny)

Distance.ComputeWitnessPoints(simplex, scratch.WitnessA, scratch.WitnessB)
Var laX As Double = scratch.WitnessA.X
Var laY As Double = scratch.WitnessA.Y
Var lbX As Double = scratch.WitnessB.X
Var lbY As Double = scratch.WitnessB.Y
Var ddx As Double = lbX - laX
Var ddy As Double = lbY - laY
out.Distance = Maths.Sqrt(ddx * ddx + ddy * ddy)
out.PointA.Set(qa * laX - sa * laY + input.TransformA.P.X, sa * laX + qa * laY + input.TransformA.P.Y)
out.PointB.Set(qa * lbX - sa * lbY + input.TransformA.P.X, sa * lbX + qa * lbY + input.TransformA.P.Y)
out.Iterations = iteration
out.SimplexCount = 0

# Cache the simplex.
Distance.MakeSimplexCache(cache, simplex)

# Apply radii if requested.
If input.UseRadii And out.Distance > 0.1 * PhysicsConstants.LINEAR_SLOP Then
Var radiusA As Double = input.ProxyA.Radius
Var radiusB As Double = input.ProxyB.Radius
Var reduced As Double = out.Distance - radiusA - radiusB
If reduced < 0.0 Then
reduced = 0.0
End If
out.Distance = reduced

# Keep closest points on the perimeter even if overlapped so the points
# move smoothly.
out.PointA.Set(out.PointA.X + radiusA * nx, out.PointA.Y + radiusA * ny)
out.PointB.Set(out.PointB.X - radiusB * nx, out.PointB.Y - radiusB * ny)
End If
End Sub

## Normalises the direction given as components into the caller-owned out
## vector and returns its length. A zero direction leaves out unchanged and
## returns zero.
Shared Function NormalizeTo(x As Double, y As Double, out As Vector2) As Double
Var length As Double = Maths.Sqrt(x * x + y * y)
If length > 0.0 Then
out.Set(x / length, y / length)
Return length
End If
out.Set(0.0, 0.0)
Return 0.0
End Function

## Transforms a local point into the caller-owned out vector using the
## transform's rotation components and translation.
Shared Sub TransformInto(out As Vector2, t As Transform, local As Vector2)
out.Set(t.Q.C * local.X - t.Q.S * local.Y + t.P.X, t.Q.S * local.X + t.Q.C * local.Y + t.P.Y)
End Sub

## Clamps the value to the zero-to-one range, mirroring upstream
## b2ClampFloat in SegmentDistance.
Shared Function Clamp01(value As Double) As Double
If value < 0.0 Then
Return 0.0
End If
If value > 1.0 Then
Return 1.0
End If
Return value
End Function
End Class

# Input for shape distance, ported from upstream b2DistanceInput in
# collision.h. Both proxies and transforms are owned copies.
Class DistanceInput
## The proxy for shape A.
Property ProxyA As ShapeProxy
## The proxy for shape B.
Property ProxyB As ShapeProxy
## The world transform for shape A.
Property TransformA As Transform
## The world transform for shape B.
Property TransformB As Transform
## Should the proxy radius be considered?
Property UseRadii As Boolean

## Creates distance input with empty proxies, identity transforms, and
## radii disabled.
Constructor()
Me.ProxyA = New ShapeProxy
Me.ProxyB = New ShapeProxy
Me.TransformA = New Transform
Me.TransformB = New Transform
Me.UseRadii = False
End Constructor
End Class

# Public distance joint façade, ported from the b2DistanceJoint_* surface in
# distance_joint.c. Tuning changes deliberately do not wake the bodies,
# matching upstream; the solver picks up new values on the next step. The
# façade reads and writes its row in the owning JointSims store.
Class DistanceJoint Inherits Joint
## Rest length, ported from b2DistanceJoint_GetLength.
Function GetLength() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).Length.Items[Me.LocalIndex]
End Function

## Changes the rest length and clears the spring and limit impulses, ported
## from b2DistanceJoint_SetLength.
Sub SetLength(length As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not length.IsFinite() Then
Throw New InvalidArgumentException("Distance joint length must be finite")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
If length < PhysicsConstants.LINEAR_SLOP Then
length = PhysicsConstants.LINEAR_SLOP
End If
If length > PhysicsConstants.POSITION_LIMIT Then
length = PhysicsConstants.POSITION_LIMIT
End If
store.Length.Items[Me.LocalIndex] = length
store.Impulse.Items[Me.LocalIndex] = 0.0
store.LowerImpulse.Items[Me.LocalIndex] = 0.0
store.UpperImpulse.Items[Me.LocalIndex] = 0.0
End Sub

## Enables the length limits, ported from b2DistanceJoint_EnableLimit.
Sub EnableLimit(enableLimit As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var limitBit As Integer = 0
If enableLimit Then
limitBit = 1
End If
Me.Owner.GetJointSims(Me).EnableLimit.Items[Me.LocalIndex] = limitBit
End Sub

## True when the length limits are enabled, ported from
## b2DistanceJoint_IsLimitEnabled.
Function IsLimitEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableLimit.Items[Me.LocalIndex] = 1
End Function

## Sets the length range and clears the spring and limit impulses, ported
## from b2DistanceJoint_SetLengthRange.
Sub SetLengthRange(minLength As Double, maxLength As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not minLength.IsFinite() Or Not maxLength.IsFinite() Then
Throw New InvalidArgumentException("Distance joint length range must be finite")
End If
If minLength < PhysicsConstants.LINEAR_SLOP Then
minLength = PhysicsConstants.LINEAR_SLOP
End If
If maxLength < PhysicsConstants.LINEAR_SLOP Then
maxLength = PhysicsConstants.LINEAR_SLOP
End If
If minLength > PhysicsConstants.POSITION_LIMIT Then
minLength = PhysicsConstants.POSITION_LIMIT
End If
If maxLength > PhysicsConstants.POSITION_LIMIT Then
maxLength = PhysicsConstants.POSITION_LIMIT
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
If minLength < maxLength Then
store.MinLength.Items[Me.LocalIndex] = minLength
store.MaxLength.Items[Me.LocalIndex] = maxLength
Else
store.MinLength.Items[Me.LocalIndex] = maxLength
store.MaxLength.Items[Me.LocalIndex] = minLength
End If
store.Impulse.Items[Me.LocalIndex] = 0.0
store.LowerImpulse.Items[Me.LocalIndex] = 0.0
store.UpperImpulse.Items[Me.LocalIndex] = 0.0
End Sub

## Lower clamp of the length range, ported from b2DistanceJoint_GetMinLength.
Function GetMinLength() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MinLength.Items[Me.LocalIndex]
End Function

## Upper clamp of the length range, ported from b2DistanceJoint_GetMaxLength.
Function GetMaxLength() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MaxLength.Items[Me.LocalIndex]
End Function

## Current distance between the two anchors, ported from
## b2DistanceJoint_GetCurrentLength.
Function GetCurrentLength() As Double
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var transformA As Transform = Me.Owner.GetBodyTransformById(Me.Edge0BodyId)
Var transformB As Transform = Me.Owner.GetBodyTransformById(Me.Edge1BodyId)
Var pA As Vector2 = Transform.TransformPoint(transformA, New Vector2(store.LocalOriginAnchorAX.Items[Me.LocalIndex], store.LocalOriginAnchorAY.Items[Me.LocalIndex]))
Var pB As Vector2 = Transform.TransformPoint(transformB, New Vector2(store.LocalOriginAnchorBX.Items[Me.LocalIndex], store.LocalOriginAnchorBY.Items[Me.LocalIndex]))
Var d As Vector2 = pB - pA
Return d.Length()
End Function

## Enables the spring, ported from b2DistanceJoint_EnableSpring.
Sub EnableSpring(enableSpring As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var springBit As Integer = 0
If enableSpring Then
springBit = 1
End If
Me.Owner.GetJointSims(Me).EnableSpring.Items[Me.LocalIndex] = springBit
End Sub

## True when the spring is enabled, ported from
## b2DistanceJoint_IsSpringEnabled.
Function IsSpringEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableSpring.Items[Me.LocalIndex] = 1
End Function

## Spring stiffness in hertz, ported from b2DistanceJoint_SetSpringHertz.
Sub SetSpringHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).Hertz.Items[Me.LocalIndex] = hertz
End Sub

## Spring stiffness in hertz, ported from b2DistanceJoint_GetSpringHertz.
Function GetSpringHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).Hertz.Items[Me.LocalIndex]
End Function

## Spring damping ratio, ported from b2DistanceJoint_SetSpringDampingRatio.
Sub SetSpringDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).DampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Spring damping ratio, ported from b2DistanceJoint_GetSpringDampingRatio.
Function GetSpringDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).DampingRatio.Items[Me.LocalIndex]
End Function

## Enables the motor and clears the motor impulse, ported from
## b2DistanceJoint_EnableMotor.
Sub EnableMotor(enableMotor As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var motorBit As Integer = 0
If enableMotor Then
motorBit = 1
End If
If motorBit <> store.EnableMotor.Items[Me.LocalIndex] Then
store.EnableMotor.Items[Me.LocalIndex] = motorBit
store.MotorImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the motor is enabled, ported from b2DistanceJoint_IsMotorEnabled.
Function IsMotorEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableMotor.Items[Me.LocalIndex] = 1
End Function

## Target relative speed along the rope axis, ported from
## b2DistanceJoint_SetMotorSpeed.
Sub SetMotorSpeed(motorSpeed As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).MotorSpeed.Items[Me.LocalIndex] = motorSpeed
End Sub

## Target relative speed along the rope axis, ported from
## b2DistanceJoint_GetMotorSpeed.
Function GetMotorSpeed() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MotorSpeed.Items[Me.LocalIndex]
End Function

## Motor force applied during the last step, ported from
## b2DistanceJoint_GetMotorForce.
Function GetMotorForce() As Double
Me.CheckValid()
Return Me.Owner.InvH * Me.Owner.GetJointSims(Me).MotorImpulse.Items[Me.LocalIndex]
End Function

## Maximum motor force magnitude, ported from
## b2DistanceJoint_SetMaxMotorForce.
Sub SetMaxMotorForce(force As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).MaxMotorForce.Items[Me.LocalIndex] = force
End Sub

## Maximum motor force magnitude, ported from
## b2DistanceJoint_GetMaxMotorForce.
Function GetMaxMotorForce() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).MaxMotorForce.Items[Me.LocalIndex]
End Function
End Class

# Distance joint definition, ported from upstream b2DistanceJointDef and
# b2DefaultDistanceJointDef in types.h and joint.c. Defaults match upstream:
# rest length of one metre, unlimited maximum length, no spring, limits, or
# motor.
Class DistanceJointDefinition
## First attached body.
Property BodyA As Body
## Second attached body.
Property BodyB As Body
## Anchor on body A in body A's local frame.
Property LocalAnchorA As Vector2
## Anchor on body B in body B's local frame.
Property LocalAnchorB As Vector2
## Rest length in metres.
Property Length As Double
## Minimum length when limits are enabled.
Property MinLength As Double
## Maximum length when limits are enabled.
Property MaxLength As Double
## Spring stiffness in hertz. Zero gives a rigid rope.
Property Hertz As Double
## Spring damping ratio.
Property DampingRatio As Double
## Maximum motor force magnitude.
Property MaxMotorForce As Double
## Target relative speed along the rope axis.
Property MotorSpeed As Double
## Enables the soft spring behaviour.
Property EnableSpring As Boolean
## Enables the length limits.
Property EnableLimit As Boolean
## Enables the motor.
Property EnableMotor As Boolean
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LocalAnchorA = New Vector2(0.0, 0.0)
Me.LocalAnchorB = New Vector2(0.0, 0.0)
Me.Length = 1.0
Me.MinLength = 0.0
Me.MaxLength = PhysicsConstants.POSITION_LIMIT
Me.Hertz = 0.0
Me.DampingRatio = 0.0
Me.MaxMotorForce = 0.0
Me.MotorSpeed = 0.0
Me.EnableSpring = False
Me.EnableLimit = False
Me.EnableMotor = False
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Mutable solver state for one distance joint during prepare/warm-start/
# solve, kept as a scratch record so the per-block solver helpers stay
# within method complexity limits. Mirrors the local variables of upstream
# b2SolveDistanceJoint.
Class DistanceJointScratch
## Linear velocity of body A.
Property VAX As Double
## Y component of body A's linear velocity.
Property VAY As Double
## Angular velocity of body A.
Property WA As Double
## X component of body B's linear velocity.
Property VBX As Double
## Y component of body B's linear velocity.
Property VBY As Double
## Angular velocity of body B.
Property WB As Double
## X component of the rotated anchor on body A.
Property RAX As Double
## Y component of the rotated anchor on body A.
Property RAY As Double
## X component of the rotated anchor on body B.
Property RBX As Double
## Y component of the rotated anchor on body B.
Property RBY As Double
## X component of the unit separation axis.
Property AxisX As Double
## Y component of the unit separation axis.
Property AxisY As Double
## Current anchor separation length.
Property Length As Double

## Creates a zeroed scratch record.
Constructor()
Me.VAX = 0.0
Me.VAY = 0.0
Me.WA = 0.0
Me.VBX = 0.0
Me.VBY = 0.0
Me.WB = 0.0
Me.RAX = 0.0
Me.RAY = 0.0
Me.RBX = 0.0
Me.RBY = 0.0
Me.AxisX = 0.0
Me.AxisY = 0.0
Me.Length = 0.0
End Constructor
End Class

# Output for shape distance, ported from upstream b2DistanceOutput in
# collision.h.
#
# Distance functions write into existing outputs (the To-forms) so warm loops
# can reuse one output object. Every field is overwritten on each call.
Class DistanceOutput
## Closest point on shape A, in world space.
Property PointA As Vector2
## Closest point on shape B, in world space.
Property PointB As Vector2
## Normal vector that points from A to B. Invalid when the distance is zero.
Property Normal As Vector2
## The final distance. Zero when the shapes overlap.
Property Distance As Double
## Number of GJK iterations used.
Property Iterations As Integer
## Number of simplexes stored in the debug simplex array.
Property SimplexCount As Integer

## Internal reusable workspace for the warm distance path.
Private Property mScratch As DistanceScratch

## Creates a zero output.
Constructor()
Me.PointA = New Vector2(0.0, 0.0)
Me.PointB = New Vector2(0.0, 0.0)
Me.Normal = New Vector2(0.0, 0.0)
Me.Distance = 0.0
Me.Iterations = 0
Me.SimplexCount = 0
Me.mScratch = Nothing
End Constructor

## Returns the internal workspace, creating it on first use. Engine code
## only; creating the workspace once per output keeps warm distance queries
## allocation-free.
Function Scratch() As DistanceScratch
If Me.mScratch = Nothing Then
Me.mScratch = New DistanceScratch
End If
Return Me.mScratch
End Function

## Copies another output's fields in place and returns this output.
Function SetFrom(other As DistanceOutput) As DistanceOutput
Me.PointA.Set(other.PointA.X, other.PointA.Y)
Me.PointB.Set(other.PointB.X, other.PointB.Y)
Me.Normal.Set(other.Normal.X, other.Normal.Y)
Me.Distance = other.Distance
Me.Iterations = other.Iterations
Me.SimplexCount = other.SimplexCount
Return Me
End Function
End Class

# Engine-internal reusable workspace for the GJK distance computation. Owned
# by a DistanceOutput and created lazily so warm distance queries allocate
# nothing. Not part of the public engine surface.
Class DistanceScratch
## Proxy B transformed into frame A, reused across iterations.
Property LocalProxyB As ShapeProxy
## Current GJK search direction.
Property Direction As Vector2
## Witness point on shape A in frame A.
Property WitnessA As Vector2
## Witness point on shape B in frame A.
Property WitnessB As Vector2

## Creates the workspace with empty storage.
Constructor()
Me.LocalProxyB = New ShapeProxy
Me.Direction = New Vector2(0.0, 0.0)
Me.WitnessA = New Vector2(0.0, 0.0)
Me.WitnessB = New Vector2(0.0, 0.0)
End Constructor
End Class

# Dense double scratch and storage list with reserve, grow, swap-remove, and clear.
#
# The Double twin of IntegerList; see that class for the representation and
# capacity contract. Used by engine code for growable floating-point
# sequences such as warm-start impulse queues and scalar scratch blocks.
Class DoubleList
## Backing array. Its Count is the capacity; index it directly only within [0, Count).
Property Items() As Double
## Number of valid elements in [0, Count).
Property Count As Integer

## Creates an empty list.
Constructor()
Me.Items = New Array(Of Double)
Me.Count = 0
End Constructor

## Creates an empty list with room for the given element count.
Constructor(capacityHint As Integer)
Me.Items = New Array(Of Double)
Me.Count = 0
Me.Reserve(capacityHint)
End Constructor

## Ensures room for at least capacity elements. Extends the backing array
## with zeros when needed; never shrinks and never changes Count.
Sub Reserve(capacity As Integer)
While Me.Items.Count < capacity
Me.Items.Append(0.0)
Wend
End Sub

## Appends a value, growing capacity by the upstream factor (half again,
## minimum two) when the backing array is full.
Sub Append(value As Double)
If Me.Count = Me.Items.Count Then
Me.Reserve(Me.GrowCapacity())
End If
Me.Items[Me.Count] = value
Me.Count = Me.Count + 1
End Sub

## Removes and returns the last element.
Function Pop() As Double
If Me.Count = 0 Then
Throw New RuntimeException("DoubleList.Pop on empty list")
End If
Me.Count = Me.Count - 1
Return Me.Items[Me.Count]
End Function

## Returns the index of the last element, or -1 when empty.
Function LastIndex() As Integer
Return Me.Count - 1
End Function

## Reads the element at index. Cold-path convenience; hot code indexes Items directly.
Function At(index As Integer) As Double
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("DoubleList.At index out of range")
End If
Return Me.Items[index]
End Function

## Writes the element at index. Cold-path convenience; hot code indexes Items directly.
Sub SetAt(index As Integer, value As Double)
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("DoubleList.SetAt index out of range")
End If
Me.Items[index] = value
End Sub

## Removes the element at index by moving the last element into its place.
## Returns the index the removed element's replacement came from, or -1
## when the last element itself was removed. Order is not preserved; this
## matches the upstream b2 RemoveSwap contract.
Function RemoveSwap(index As Integer) As Integer
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("DoubleList.RemoveSwap index out of range")
End If
Var movedIndex As Integer = PhysicsConstants.NULL_INDEX
If index <> Me.Count - 1 Then
movedIndex = Me.Count - 1
Me.Items[index] = Me.Items[movedIndex]
End If
Me.Count = Me.Count - 1
Return movedIndex
End Function

## Resets the logical count to zero. Capacity is retained so a warmed list
## keeps operating without allocation.
Sub Clear()
Me.Count = 0
End Sub

## Current capacity, equal to Items.Count.
Function Capacity() As Integer
Return Me.Items.Count
End Function

## Validates internal invariants.
Sub Validate()
If Me.Count < 0 Or Me.Count > Me.Items.Count Then
Throw New RuntimeException("DoubleList count outside capacity")
End If
End Sub

## Upstream growth policy: double from empty, otherwise add half again.
Private Function GrowCapacity() As Integer
If Me.Items.Count < 2 Then
Return 2
End If
Return Me.Items.Count + (Me.Items.Count \ 2)
End Function
End Class

# Dynamic bounding volume tree, ported from Box2D 3.1.1 src/dynamic_tree.c.
# This is the AABB hierarchy behind the broad phase. It is protected engine
# infrastructure: world queries (Stage 6) wrap it so users never touch the
# tree.
#
# Node objects live in a pooled array indexed by node id; free nodes chain
# through their Parent slot, exactly like upstream. Insertion uses the
# greedy surface-area-heuristic sibling search with branch-and-bound descent
# and optional rotation; removal splices the sibling upward and repairs
# ancestors. Rebuild gathers every leaf and every unenlarged internal node,
# frees the enlarged internal nodes, and rebuilds a balanced tree with the
# median-split partition, matching the upstream build (which compiles with
# B2_TREE_HEURISTIC 0, so the binned SAH partition is not ported).
#
# Traversals are iterative over a reusable stack owned by TreeScratch, so
# tree queries are not reentrant: a callback must not query the same tree.
# Warm forms (QueryTo, RayCastTo, ShapeCastTo, GetAABBTo, GetRootBoundsTo)
# fill caller-owned outputs so steady-state traversals allocate nothing.
Class DynamicTree
## Index of the root node, or the null sentinel when the tree is empty.
Property Root As Integer
## Capacity of the node pool; the backing node array length.
Property NodeCapacity As Integer
## Number of allocated nodes, including internal nodes.
Property NodeCount As Integer
## Number of leaf proxies in the tree.
Property ProxyCount As Integer
## Index of the first free node, or the null sentinel when the pool is full.
Property FreeList As Integer

## Engine-internal traversal workspace, created on first use.
Private Property mScratch As TreeScratch

## The node pool. Index with node ids only inside the module.
Property Nodes() As TreeNode

## Creates an empty tree with the upstream initial pool capacity of 16.
Constructor()
Me.Root = PhysicsConstants.NULL_INDEX
Me.NodeCapacity = 16
Me.NodeCount = 0
Me.ProxyCount = 0
Me.FreeList = 0
Me.Nodes = New Array(Of TreeNode)
For i As Integer = 0 To Me.NodeCapacity - 1
Me.Nodes.Append(New TreeNode)
Next i
# Build the linked free list through the Parent slots.
For i As Integer = 0 To Me.NodeCapacity - 2
Me.Nodes[i].Parent = i + 1
Next i
Me.Nodes[Me.NodeCapacity - 1].Parent = PhysicsConstants.NULL_INDEX
End Constructor

## Engine-internal reusable workspace, created on first use.
Function Scratch() As TreeScratch
If Me.mScratch = Nothing Then
Me.mScratch = New TreeScratch
End If
Return Me.mScratch
End Function

## Returns the tree to a freshly created state: every node returns to the
## free list and the proxy count drops to zero.
Sub Destroy()
Me.Root = PhysicsConstants.NULL_INDEX
Me.NodeCount = 0
Me.ProxyCount = 0
Me.FreeList = 0
For i As Integer = 0 To Me.NodeCapacity - 2
Me.Nodes[i].Reset()
Me.Nodes[i].Parent = i + 1
Next i
Me.Nodes[Me.NodeCapacity - 1].Reset()
Me.Nodes[Me.NodeCapacity - 1].Parent = PhysicsConstants.NULL_INDEX
End Sub

## Writes the union of boxes x and y into the target box in place.
Private Sub UnionInto(target As AABB, x As AABB, y As AABB)
AABB.UnionTo(x, y, target)
End Sub

## Pops a node off the free list, growing the pool by half again when the
## free list is empty, and restores the upstream default node layout.
Private Function AllocateNode() As Integer
If Me.FreeList = PhysicsConstants.NULL_INDEX Then
# The free list is empty; extend the pool by half again.
Var newCapacity As Integer = Me.NodeCapacity + (Me.NodeCapacity \ 2)
For i As Integer = Me.NodeCapacity To newCapacity - 1
Me.Nodes.Append(New TreeNode)
Next i
Me.NodeCapacity = newCapacity
# Chain the new tail through Parent as the free list.
For i As Integer = Me.NodeCount To Me.NodeCapacity - 2
Me.Nodes[i].Parent = i + 1
Next i
Me.Nodes[Me.NodeCapacity - 1].Parent = PhysicsConstants.NULL_INDEX
Me.FreeList = Me.NodeCount
End If

Var nodeIndex As Integer = Me.FreeList
Var node As TreeNode = Me.Nodes[nodeIndex]
Me.FreeList = node.Parent
node.Reset()
Me.NodeCount = Me.NodeCount + 1
Return nodeIndex
End Function

## Pushes a node back onto the free list.
Private Sub FreeNode(nodeId As Integer)
If nodeId < 0 Or nodeId >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree free node index out of range")
End If
If Me.NodeCount <= 0 Then
Throw New RuntimeException("DynamicTree freed more nodes than allocated")
End If
Var node As TreeNode = Me.Nodes[nodeId]
node.Parent = Me.FreeList
node.Flags = 0
Me.FreeList = nodeId
Me.NodeCount = Me.NodeCount - 1
End Sub

## Greedy branch-and-bound sibling search using the surface area heuristic,
## ported from upstream b2FindBestSibling. All costs are computed from
## scalars so warm insertion allocates nothing. Descends a single greedy
## path, breaking ties on centroid distance when neither lower bound rules
## out a descent.
## Evaluates one child during the greedy sibling search, ported from the
## per-child cost halves of upstream b2FindBestSibling. When the child is a
## leaf, updates the best sibling held in TreeScratch and returns the
## maximum Double so the child is never descended into. When the child is
## internal, returns the lower bound cost of descending into it.
Private Function EvaluateChildCost(childIndex As Integer, lowerDX As Double, lowerDY As Double, upperDX As Double, upperDY As Double, inheritedCost As Double, areaD As Double) As Double
Var scratch As TreeScratch = Me.Scratch()
Var box As AABB = Me.Nodes[childIndex].Bounds
Var width As Double = box.UpperBound.X - box.LowerBound.X
Var height As Double = box.UpperBound.Y - box.LowerBound.Y
Var area As Double = 2.0 * (width + height)
Var directCost As Double = 2.0 * ((Maths.Max(box.UpperBound.X, upperDX) - Maths.Min(box.LowerBound.X, lowerDX)) + (Maths.Max(box.UpperBound.Y, upperDY) - Maths.Min(box.LowerBound.Y, lowerDY)))

If Me.Nodes[childIndex].Height = 0 Then
# The child is a leaf: cost of a new node plus the inflated parent.
Var cost As Double = directCost + inheritedCost
If cost < scratch.SiblingBestCost Then
scratch.SiblingBest = childIndex
scratch.SiblingBestCost = cost
End If
Return 1.7976931348623157e308
End If

# The child is internal: lower bound over taking the child as the sibling
# or descending into it.
Var grow As Double = areaD - area
If grow > 0.0 Then
grow = 0.0
End If
Return inheritedCost + directCost + grow
End Function

## Resolves the two child descent costs for the tie-break rule of the
## greedy sibling search: when the lower bounds tie and child 1 is internal,
## both children may fully contain the leaf and the costs fall back to
## centroid distance. Writes the resolved costs into TreeScratch.
Private Sub ResolveLowerCosts(child1 As Integer, child2 As Integer, leaf1 As Boolean, lowerCost1 As Double, lowerCost2 As Double, centerDX As Double, centerDY As Double)
Var scratch As TreeScratch = Me.Scratch()
If lowerCost1 = lowerCost2 And leaf1 = False Then
Var box1 As AABB = Me.Nodes[child1].Bounds
Var box2 As AABB = Me.Nodes[child2].Bounds
Var d1x As Double = 0.5 * (box1.LowerBound.X + box1.UpperBound.X) - centerDX
Var d1y As Double = 0.5 * (box1.LowerBound.Y + box1.UpperBound.Y) - centerDY
Var d2x As Double = 0.5 * (box2.LowerBound.X + box2.UpperBound.X) - centerDX
Var d2y As Double = 0.5 * (box2.LowerBound.Y + box2.UpperBound.Y) - centerDY
scratch.SiblingLowerCost1 = d1x * d1x + d1y * d1y
scratch.SiblingLowerCost2 = d2x * d2x + d2y * d2y
Else
scratch.SiblingLowerCost1 = lowerCost1
scratch.SiblingLowerCost2 = lowerCost2
End If
End Sub

## Returns True when the greedy sibling search must stop at the current
## node: both children are leaves, or no descendant can beat the best cost
## already found. Applies the centroid tie-break before comparing.
Private Function DoneDescending(child1 As Integer, child2 As Integer, leaf1 As Boolean, leaf2 As Boolean, lowerCost1 As Double, lowerCost2 As Double, centerDX As Double, centerDY As Double) As Boolean
If leaf1 And leaf2 Then
Return True
End If

Me.ResolveLowerCosts(child1, child2, leaf1, lowerCost1, lowerCost2, centerDX, centerDY)
Var scratch As TreeScratch = Me.Scratch()
Return scratch.SiblingBestCost <= scratch.SiblingLowerCost1 And scratch.SiblingBestCost <= scratch.SiblingLowerCost2
End Function

## Descends along the cheaper child after tie-breaking, ported from the
## descent tail of upstream b2FindBestSibling. Updates the running area and
## inflation costs held in TreeScratch and returns the child node index.
Private Function NextDescendIndex(child1 As Integer, child2 As Integer, leaf1 As Boolean, lowerDX As Double, lowerDY As Double, upperDX As Double, upperDY As Double) As Integer
Var scratch As TreeScratch = Me.Scratch()
Var index As Integer = child2
If scratch.SiblingLowerCost1 < scratch.SiblingLowerCost2 And leaf1 = False Then
index = child1
End If

Var chosen As TreeNode = Me.Nodes[index]
scratch.SiblingAreaBase = 2.0 * ((chosen.Bounds.UpperBound.X - chosen.Bounds.LowerBound.X) + (chosen.Bounds.UpperBound.Y - chosen.Bounds.LowerBound.Y))
scratch.SiblingDirectCost = 2.0 * ((Maths.Max(chosen.Bounds.UpperBound.X, upperDX) - Maths.Min(chosen.Bounds.LowerBound.X, lowerDX)) + (Maths.Max(chosen.Bounds.UpperBound.Y, upperDY) - Maths.Min(chosen.Bounds.LowerBound.Y, lowerDY)))
Return index
End Function

## Greedy branch-and-bound sibling search using the surface area heuristic,
## ported from upstream b2FindBestSibling. All costs are computed from
## scalars so warm insertion allocates nothing. Descends a single greedy
## path, breaking ties on centroid distance when neither lower bound rules
## out a descent.
Private Function FindBestSibling(lowerDX As Double, lowerDY As Double, upperDX As Double, upperDY As Double) As Integer
Var centerDX As Double = 0.5 * (lowerDX + upperDX)
Var centerDY As Double = 0.5 * (lowerDY + upperDY)
Var widthD As Double = upperDX - lowerDX
Var heightD As Double = upperDY - lowerDY
Var areaD As Double = 2.0 * (widthD + heightD)

Var nodes As Array(Of TreeNode) = Me.Nodes
Var rootIndex As Integer = Me.Root
Var rootBox As AABB = nodes[rootIndex].Bounds
Var scratch As TreeScratch = Me.Scratch()

# Area of the current node.
scratch.SiblingAreaBase = AABB.Perimeter(rootBox)

# Area of the root inflated to hold the leaf, and the running inherited
# cost seen by descendants.
scratch.SiblingDirectCost = 2.0 * ((Maths.Max(rootBox.UpperBound.X, upperDX) - Maths.Min(rootBox.LowerBound.X, lowerDX)) + (Maths.Max(rootBox.UpperBound.Y, upperDY) - Maths.Min(rootBox.LowerBound.Y, lowerDY)))
Var inheritedCost As Double = 0.0

scratch.SiblingBest = rootIndex
scratch.SiblingBestCost = scratch.SiblingDirectCost

Var index As Integer = rootIndex
While nodes[index].Height > 0
Var child1 As Integer = nodes[index].Child1
Var child2 As Integer = nodes[index].Child2

# Cost of creating a new parent for this node and the new leaf.
Var cost As Double = scratch.SiblingDirectCost + inheritedCost
If cost < scratch.SiblingBestCost Then
scratch.SiblingBest = index
scratch.SiblingBestCost = cost
End If

inheritedCost = inheritedCost + scratch.SiblingDirectCost - scratch.SiblingAreaBase

Var leaf1 As Boolean = nodes[child1].Height = 0
Var leaf2 As Boolean = nodes[child2].Height = 0

Var lowerCost1 As Double = Me.EvaluateChildCost(child1, lowerDX, lowerDY, upperDX, upperDY, inheritedCost, areaD)
Var lowerCost2 As Double = Me.EvaluateChildCost(child2, lowerDX, lowerDY, upperDX, upperDY, inheritedCost, areaD)

If Me.DoneDescending(child1, child2, leaf1, leaf2, lowerCost1, lowerCost2, centerDX, centerDY) Then
Break
End If

# Descend along the cheaper child.
index = Me.NextDescendIndex(child1, child2, leaf1, lowerDX, lowerDY, upperDX, upperDY)
Wend

Return scratch.SiblingBest
End Function

## Performs a left or right rotation when node iA is imbalanced, ported from
## upstream b2RotateNodes. Rotations only happen when they reduce the total
## perimeter cost. Node heights use integers; leaf height is 0.
Private Sub RotateNodes(iA As Integer)
Var nodes As Array(Of TreeNode) = Me.Nodes
Var nodeA As TreeNode = nodes[iA]
If nodeA.Height < 2 Then
Return
End If

Var iB As Integer = nodeA.Child1
Var iC As Integer = nodeA.Child2
Var nodeB As TreeNode = nodes[iB]
Var nodeC As TreeNode = nodes[iC]

If nodeB.Height = 0 Then
# B is a leaf and C is internal.
Var iNodeF As Integer = nodeC.Child1
Var iNodeG As Integer = nodeC.Child2
Var nodeF As TreeNode = nodes[iNodeF]
Var nodeG As TreeNode = nodes[iNodeG]

# Base cost.
Var costBase As Double = AABB.Perimeter(nodeC.Bounds)

# Cost of swapping B and F.
Var costBF As Double = AABB.UnionPerimeter(nodeB.Bounds, nodeG.Bounds)

# Cost of swapping B and G.
Var costBG As Double = AABB.UnionPerimeter(nodeB.Bounds, nodeF.Bounds)

If costBase < costBF And costBase < costBG Then
# Rotation does not improve cost.
Return
End If

If costBF < costBG Then
# Swap B and F.
nodeA.Child1 = iNodeF
nodeC.Child1 = iB

nodeB.Parent = iC
nodeF.Parent = iA

UnionInto(nodeC.Bounds, nodeB.Bounds, nodeG.Bounds)

nodeC.Height = 1 + Maths.Max(nodeB.Height, nodeG.Height)
nodeA.Height = 1 + Maths.Max(nodeC.Height, nodeF.Height)
nodeC.CategoryBits = nodeB.CategoryBits.BitOr(nodeG.CategoryBits)
nodeA.CategoryBits = nodeC.CategoryBits.BitOr(nodeF.CategoryBits)
nodeC.Flags = nodeC.Flags.BitOr(nodeB.Flags.BitOr(nodeG.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeC.Flags.BitOr(nodeF.Flags).BitAnd(TreeNode.EnlargedFlag))
Else
# Swap B and G.
nodeA.Child1 = iNodeG
nodeC.Child2 = iB

nodeB.Parent = iC
nodeG.Parent = iA

UnionInto(nodeC.Bounds, nodeB.Bounds, nodeF.Bounds)

nodeC.Height = 1 + Maths.Max(nodeB.Height, nodeF.Height)
nodeA.Height = 1 + Maths.Max(nodeC.Height, nodeG.Height)
nodeC.CategoryBits = nodeB.CategoryBits.BitOr(nodeF.CategoryBits)
nodeA.CategoryBits = nodeC.CategoryBits.BitOr(nodeG.CategoryBits)
nodeC.Flags = nodeC.Flags.BitOr(nodeB.Flags.BitOr(nodeF.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeC.Flags.BitOr(nodeG.Flags).BitAnd(TreeNode.EnlargedFlag))
End If
ElseIf nodeC.Height = 0 Then
# C is a leaf and B is internal.
Var iNodeD As Integer = nodeB.Child1
Var iNodeE As Integer = nodeB.Child2
Var nodeD As TreeNode = nodes[iNodeD]
Var nodeE As TreeNode = nodes[iNodeE]

# Base cost.
Var costBase As Double = AABB.Perimeter(nodeB.Bounds)

# Cost of swapping C and D.
Var costCD As Double = AABB.UnionPerimeter(nodeC.Bounds, nodeE.Bounds)

# Cost of swapping C and E.
Var costCE As Double = AABB.UnionPerimeter(nodeC.Bounds, nodeD.Bounds)

If costBase < costCD And costBase < costCE Then
Return
End If

If costCD < costCE Then
# Swap C and D.
nodeA.Child2 = iNodeD
nodeB.Child1 = iC

nodeC.Parent = iB
nodeD.Parent = iA

UnionInto(nodeB.Bounds, nodeC.Bounds, nodeE.Bounds)

nodeB.Height = 1 + Maths.Max(nodeC.Height, nodeE.Height)
nodeA.Height = 1 + Maths.Max(nodeB.Height, nodeD.Height)
nodeB.CategoryBits = nodeC.CategoryBits.BitOr(nodeE.CategoryBits)
nodeA.CategoryBits = nodeB.CategoryBits.BitOr(nodeD.CategoryBits)
nodeB.Flags = nodeB.Flags.BitOr(nodeC.Flags.BitOr(nodeE.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeB.Flags.BitOr(nodeD.Flags).BitAnd(TreeNode.EnlargedFlag))
Else
# Swap C and E.
nodeA.Child2 = iNodeE
nodeB.Child2 = iC

nodeC.Parent = iB
nodeE.Parent = iA

UnionInto(nodeB.Bounds, nodeC.Bounds, nodeD.Bounds)

nodeB.Height = 1 + Maths.Max(nodeC.Height, nodeD.Height)
nodeA.Height = 1 + Maths.Max(nodeB.Height, nodeE.Height)
nodeB.CategoryBits = nodeC.CategoryBits.BitOr(nodeD.CategoryBits)
nodeA.CategoryBits = nodeB.CategoryBits.BitOr(nodeE.CategoryBits)
nodeB.Flags = nodeB.Flags.BitOr(nodeC.Flags.BitOr(nodeD.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeB.Flags.BitOr(nodeE.Flags).BitAnd(TreeNode.EnlargedFlag))
End If
Else
# Both children are internal.
Var iNodeD As Integer = nodeB.Child1
Var iNodeE As Integer = nodeB.Child2
Var iNodeF As Integer = nodeC.Child1
Var iNodeG As Integer = nodeC.Child2
Var nodeD As TreeNode = nodes[iNodeD]
Var nodeE As TreeNode = nodes[iNodeE]
Var nodeF As TreeNode = nodes[iNodeF]
Var nodeG As TreeNode = nodes[iNodeG]

Var areaB As Double = AABB.Perimeter(nodeB.Bounds)
Var areaC As Double = AABB.Perimeter(nodeC.Bounds)
Var costBase As Double = areaB + areaC
Var bestRotation As Integer = 0
Var bestCost As Double = costBase

# Cost of swapping B and F.
Var costBF As Double = areaB + AABB.UnionPerimeter(nodeB.Bounds, nodeG.Bounds)
If costBF < bestCost Then
bestRotation = 1
bestCost = costBF
End If

# Cost of swapping B and G.
Var costBG As Double = areaB + AABB.UnionPerimeter(nodeB.Bounds, nodeF.Bounds)
If costBG < bestCost Then
bestRotation = 2
bestCost = costBG
End If

# Cost of swapping C and D.
Var costCD As Double = areaC + AABB.UnionPerimeter(nodeC.Bounds, nodeE.Bounds)
If costCD < bestCost Then
bestRotation = 3
bestCost = costCD
End If

# Cost of swapping C and E.
Var costCE As Double = areaC + AABB.UnionPerimeter(nodeC.Bounds, nodeD.Bounds)
If costCE < bestCost Then
bestRotation = 4
End If

If bestRotation = 1 Then
nodeA.Child1 = iNodeF
nodeC.Child1 = iB

nodeB.Parent = iC
nodeF.Parent = iA

UnionInto(nodeC.Bounds, nodeB.Bounds, nodeG.Bounds)

nodeC.Height = 1 + Maths.Max(nodeB.Height, nodeG.Height)
nodeA.Height = 1 + Maths.Max(nodeC.Height, nodeF.Height)
nodeC.CategoryBits = nodeB.CategoryBits.BitOr(nodeG.CategoryBits)
nodeA.CategoryBits = nodeC.CategoryBits.BitOr(nodeF.CategoryBits)
nodeC.Flags = nodeC.Flags.BitOr(nodeB.Flags.BitOr(nodeG.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeC.Flags.BitOr(nodeF.Flags).BitAnd(TreeNode.EnlargedFlag))
ElseIf bestRotation = 2 Then
nodeA.Child1 = iNodeG
nodeC.Child2 = iB

nodeB.Parent = iC
nodeG.Parent = iA

UnionInto(nodeC.Bounds, nodeB.Bounds, nodeF.Bounds)

nodeC.Height = 1 + Maths.Max(nodeB.Height, nodeF.Height)
nodeA.Height = 1 + Maths.Max(nodeC.Height, nodeG.Height)
nodeC.CategoryBits = nodeB.CategoryBits.BitOr(nodeF.CategoryBits)
nodeA.CategoryBits = nodeC.CategoryBits.BitOr(nodeG.CategoryBits)
nodeC.Flags = nodeC.Flags.BitOr(nodeB.Flags.BitOr(nodeF.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeC.Flags.BitOr(nodeG.Flags).BitAnd(TreeNode.EnlargedFlag))
ElseIf bestRotation = 3 Then
nodeA.Child2 = iNodeD
nodeB.Child1 = iC

nodeC.Parent = iB
nodeD.Parent = iA

UnionInto(nodeB.Bounds, nodeC.Bounds, nodeE.Bounds)

nodeB.Height = 1 + Maths.Max(nodeC.Height, nodeE.Height)
nodeA.Height = 1 + Maths.Max(nodeB.Height, nodeD.Height)
nodeB.CategoryBits = nodeC.CategoryBits.BitOr(nodeE.CategoryBits)
nodeA.CategoryBits = nodeB.CategoryBits.BitOr(nodeD.CategoryBits)
nodeB.Flags = nodeB.Flags.BitOr(nodeC.Flags.BitOr(nodeE.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeB.Flags.BitOr(nodeD.Flags).BitAnd(TreeNode.EnlargedFlag))
ElseIf bestRotation = 4 Then
nodeA.Child2 = iNodeE
nodeB.Child2 = iC

nodeC.Parent = iB
nodeE.Parent = iA

UnionInto(nodeB.Bounds, nodeC.Bounds, nodeD.Bounds)

nodeB.Height = 1 + Maths.Max(nodeC.Height, nodeD.Height)
nodeA.Height = 1 + Maths.Max(nodeB.Height, nodeE.Height)
nodeB.CategoryBits = nodeC.CategoryBits.BitOr(nodeD.CategoryBits)
nodeA.CategoryBits = nodeB.CategoryBits.BitOr(nodeE.CategoryBits)
nodeB.Flags = nodeB.Flags.BitOr(nodeC.Flags.BitOr(nodeD.Flags).BitAnd(TreeNode.EnlargedFlag))
nodeA.Flags = nodeA.Flags.BitOr(nodeB.Flags.BitOr(nodeE.Flags).BitAnd(TreeNode.EnlargedFlag))
End If
End If
End Sub

## Inserts a leaf node into the tree: finds the best sibling, creates a new
## parent for the leaf and sibling, then walks back to the root repairing
## bounds, category bits, heights, and enlarged flags, rotating when
## requested. Ported from upstream b2InsertLeaf.
Private Sub InsertLeaf(leaf As Integer, shouldRotate As Boolean)
If Me.Root = PhysicsConstants.NULL_INDEX Then
Me.Root = leaf
Me.Nodes[Me.Root].Parent = PhysicsConstants.NULL_INDEX
Return
End If

# Stage 1: find the best sibling for the new leaf.
Var leafNode As TreeNode = Me.Nodes[leaf]
Var sibling As Integer = Me.FindBestSibling(leafNode.Bounds.LowerBound.X, leafNode.Bounds.LowerBound.Y, leafNode.Bounds.UpperBound.X, leafNode.Bounds.UpperBound.Y)

# Stage 2: create a new parent for the leaf and sibling.
Var siblingNode As TreeNode = Me.Nodes[sibling]
Var oldParent As Integer = siblingNode.Parent
Var newParent As Integer = Me.AllocateNode()
Var parentNode As TreeNode = Me.Nodes[newParent]

parentNode.Parent = oldParent
parentNode.UserData = -1
AABB.UnionTo(leafNode.Bounds, siblingNode.Bounds, parentNode.Bounds)
parentNode.CategoryBits = leafNode.CategoryBits.BitOr(siblingNode.CategoryBits)
parentNode.Height = siblingNode.Height + 1
parentNode.Child1 = sibling
parentNode.Child2 = leaf
parentNode.Flags = TreeNode.AllocatedFlag

If oldParent <> PhysicsConstants.NULL_INDEX Then
# The sibling was not the root.
Var grandNode As TreeNode = Me.Nodes[oldParent]
If grandNode.Child1 = sibling Then
grandNode.Child1 = newParent
Else
grandNode.Child2 = newParent
End If
Else
# The sibling was the root.
Me.Root = newParent
End If

siblingNode.Parent = newParent
leafNode.Parent = newParent

# Stage 3: walk back up the tree fixing heights, bounds, and flags.
Var index As Integer = leafNode.Parent
While index <> PhysicsConstants.NULL_INDEX
Var node As TreeNode = Me.Nodes[index]
Var child1 As TreeNode = Me.Nodes[node.Child1]
Var child2 As TreeNode = Me.Nodes[node.Child2]

AABB.UnionTo(child1.Bounds, child2.Bounds, node.Bounds)
node.CategoryBits = child1.CategoryBits.BitOr(child2.CategoryBits)
node.Height = 1 + Maths.Max(child1.Height, child2.Height)
node.Flags = node.Flags.BitOr(child1.Flags.BitOr(child2.Flags).BitAnd(TreeNode.EnlargedFlag))

If shouldRotate Then
Me.RotateNodes(index)
End If

index = node.Parent
Wend
End Sub

## Removes a leaf node, splicing its sibling into the grandparent and
## repairing ancestors, ported from upstream b2RemoveLeaf.
Private Sub RemoveLeaf(leaf As Integer)
If leaf = Me.Root Then
Me.Root = PhysicsConstants.NULL_INDEX
Return
End If

Var nodes As Array(Of TreeNode) = Me.Nodes
Var leafNode As TreeNode = nodes[leaf]
Var parent As Integer = leafNode.Parent
Var parentNode As TreeNode = nodes[parent]
Var grandParent As Integer = parentNode.Parent
Var sibling As Integer = parentNode.Child1
If parentNode.Child1 = leaf Then
sibling = parentNode.Child2
End If

If grandParent <> PhysicsConstants.NULL_INDEX Then
# Destroy the parent and connect the sibling to the grandparent.
Var grandNode As TreeNode = nodes[grandParent]
If grandNode.Child1 = parent Then
grandNode.Child1 = sibling
Else
grandNode.Child2 = sibling
End If
nodes[sibling].Parent = grandParent
Me.FreeNode(parent)

# Adjust ancestor bounds.
Var index As Integer = grandParent
While index <> PhysicsConstants.NULL_INDEX
Var node As TreeNode = nodes[index]
Var child1 As TreeNode = nodes[node.Child1]
Var child2 As TreeNode = nodes[node.Child2]

AABB.UnionTo(child1.Bounds, child2.Bounds, node.Bounds)
node.CategoryBits = child1.CategoryBits.BitOr(child2.CategoryBits)
node.Height = 1 + Maths.Max(child1.Height, child2.Height)

index = node.Parent
Wend
Else
Me.Root = sibling
nodes[sibling].Parent = PhysicsConstants.NULL_INDEX
Me.FreeNode(parent)
End If
End Sub

## Creates a leaf proxy holding the given bounds, category bits, and client
## data, and returns its node index. Bounds must be valid and inside the
## position limit.
Function CreateProxy(box As AABB, categoryBits As Integer, userData As Integer) As Integer
If Not AABB.IsValid(box) Then
Throw New InvalidArgumentException("DynamicTree.CreateProxy invalid bounds")
End If
If box.LowerBound.X <= -PhysicsConstants.POSITION_LIMIT Or box.LowerBound.X >= PhysicsConstants.POSITION_LIMIT Or box.LowerBound.Y <= -PhysicsConstants.POSITION_LIMIT Or box.LowerBound.Y >= PhysicsConstants.POSITION_LIMIT Or box.UpperBound.X <= -PhysicsConstants.POSITION_LIMIT Or box.UpperBound.X >= PhysicsConstants.POSITION_LIMIT Or box.UpperBound.Y <= -PhysicsConstants.POSITION_LIMIT Or box.UpperBound.Y >= PhysicsConstants.POSITION_LIMIT Then
Throw New InvalidArgumentException("DynamicTree.CreateProxy bounds outside position limit")
End If

Var proxyId As Integer = Me.AllocateNode()
Var node As TreeNode = Me.Nodes[proxyId]

AABB.UnionTo(box, box, node.Bounds)
node.UserData = userData
node.CategoryBits = categoryBits
node.Height = 0
node.Flags = TreeNode.AllocatedFlag.BitOr(TreeNode.LeafFlag)

Me.InsertLeaf(proxyId, True)

Me.ProxyCount = Me.ProxyCount + 1

Return proxyId
End Function

## Removes and frees a leaf proxy.
Sub DestroyProxy(proxyId As Integer)
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.DestroyProxy index out of range")
End If
If Not Me.Nodes[proxyId].IsLeaf() Then
Throw New RuntimeException("DynamicTree.DestroyProxy index is not a leaf")
End If

Me.RemoveLeaf(proxyId)
Me.FreeNode(proxyId)

Me.ProxyCount = Me.ProxyCount - 1
End Sub

## Moves a leaf proxy to new bounds: removes and reinserts it without
## rotation. The bounds must be valid and inside the position limit.
Sub MoveProxy(proxyId As Integer, box As AABB)
If Not AABB.IsValid(box) Then
Throw New InvalidArgumentException("DynamicTree.MoveProxy invalid bounds")
End If
If box.UpperBound.X - box.LowerBound.X >= PhysicsConstants.POSITION_LIMIT Or box.UpperBound.Y - box.LowerBound.Y >= PhysicsConstants.POSITION_LIMIT Then
Throw New InvalidArgumentException("DynamicTree.MoveProxy bounds exceed position limit")
End If
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.MoveProxy index out of range")
End If
If Not Me.Nodes[proxyId].IsLeaf() Then
Throw New RuntimeException("DynamicTree.MoveProxy index is not a leaf")
End If

Me.RemoveLeaf(proxyId)

Var node As TreeNode = Me.Nodes[proxyId]
node.Bounds.LowerBound.Set(box.LowerBound.X, box.LowerBound.Y)
node.Bounds.UpperBound.Set(box.UpperBound.X, box.UpperBound.Y)

Me.InsertLeaf(proxyId, False)
End Sub

## Enlarges a leaf proxy to bounds that strictly contain the current leaf
## bounds, repairing ancestors in place without reinsertion. Ancestors are
## marked enlarged so the next rebuild restructures them. Ported from
## upstream b2DynamicTree_EnlargeProxy.
Sub EnlargeProxy(proxyId As Integer, box As AABB)
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.EnlargeProxy index out of range")
End If
Var nodes As Array(Of TreeNode) = Me.Nodes
Var node As TreeNode = nodes[proxyId]
If Not node.IsLeaf() Then
Throw New RuntimeException("DynamicTree.EnlargeProxy index is not a leaf")
End If
# The caller must ensure the new bounds are not already contained.
If AABB.Contains(node.Bounds, box) Then
Throw New RuntimeException("DynamicTree.EnlargeProxy bounds do not enlarge the leaf")
End If

node.Bounds.LowerBound.Set(box.LowerBound.X, box.LowerBound.Y)
node.Bounds.UpperBound.Set(box.UpperBound.X, box.UpperBound.Y)

Var parentIndex As Integer = node.Parent
While parentIndex <> PhysicsConstants.NULL_INDEX
Var parentNode As TreeNode = nodes[parentIndex]
Var changed As Boolean = AABB.Enlarge(parentNode.Bounds, box)
parentNode.Flags = parentNode.Flags.BitOr(TreeNode.EnlargedFlag)
parentIndex = parentNode.Parent

If changed = False Then
Break
End If
Wend

While parentIndex <> PhysicsConstants.NULL_INDEX
Var parentNode As TreeNode = nodes[parentIndex]
If parentNode.IsEnlarged() Then
# Early out because this ancestor was previously ascended and marked
# as enlarged.
Break
End If

parentNode.Flags = parentNode.Flags.BitOr(TreeNode.EnlargedFlag)
parentIndex = parentNode.Parent
Wend
End Sub

## Replaces the category bits of a leaf proxy and repairs ancestor bits.
Sub SetCategoryBits(proxyId As Integer, categoryBits As Integer)
Var nodes As Array(Of TreeNode) = Me.Nodes
Var node As TreeNode = nodes[proxyId]
If Not node.IsLeaf() Then
Throw New RuntimeException("DynamicTree.SetCategoryBits index is not a leaf")
End If

node.CategoryBits = categoryBits

# Fix up category bits in ancestor internal nodes.
Var nodeIndex As Integer = node.Parent
While nodeIndex <> PhysicsConstants.NULL_INDEX
Var parentNode As TreeNode = nodes[nodeIndex]
parentNode.CategoryBits = nodes[parentNode.Child1].CategoryBits.BitOr(nodes[parentNode.Child2].CategoryBits)

nodeIndex = parentNode.Parent
Wend
End Sub

## Returns the category bits of a node.
Function GetCategoryBits(proxyId As Integer) As Integer
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.GetCategoryBits index out of range")
End If
Return Me.Nodes[proxyId].CategoryBits
End Function

## Returns the height of the tree, or 0 for an empty tree.
Function GetHeight() As Integer
If Me.Root = PhysicsConstants.NULL_INDEX Then
Return 0
End If

Return Me.Nodes[Me.Root].Height
End Function

## Returns the ratio of the summed internal node perimeter to the root
## perimeter; 0 for an empty tree.
Function GetAreaRatio() As Double
If Me.Root = PhysicsConstants.NULL_INDEX Then
Return 0.0
End If

Var rootNode As TreeNode = Me.Nodes[Me.Root]
Var rootArea As Double = AABB.Perimeter(rootNode.Bounds)

Var totalArea As Double = 0.0
For i As Integer = 0 To Me.NodeCapacity - 1
Var node As TreeNode = Me.Nodes[i]
If node.IsAllocated() = False Or node.IsLeaf() Or i = Me.Root Then
Continue
End If

totalArea = totalArea + AABB.Perimeter(node.Bounds)
Next i

Return totalArea / rootArea
End Function

## Returns the root bounds, or a zero-area box at the origin for an empty
## tree.
Function GetRootBounds() As AABB
Var result As New AABB
Me.GetRootBoundsTo(result)
Return result
End Function

## Writes the root bounds into the caller-owned out box and returns out.
## A zero-area box at the origin is written for an empty tree. The reuse
## form of GetRootBounds for warm code.
Private Function GetRootBoundsTo(out As AABB) As AABB
If Me.Root <> PhysicsConstants.NULL_INDEX Then
Var rootNode As TreeNode = Me.Nodes[Me.Root]
out.LowerBound.Set(rootNode.Bounds.LowerBound.X, rootNode.Bounds.LowerBound.Y)
out.UpperBound.Set(rootNode.Bounds.UpperBound.X, rootNode.Bounds.UpperBound.Y)
Else
out.LowerBound.Set(0.0, 0.0)
out.UpperBound.Set(0.0, 0.0)
End If
Return out
End Function

## Returns the client data of a node.
Function GetUserData(proxyId As Integer) As Integer
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.GetUserData index out of range")
End If
Return Me.Nodes[proxyId].UserData
End Function

## Returns a copy of the bounds of a node.
Function GetAABB(proxyId As Integer) As AABB
Var result As New AABB
Me.GetAABBTo(proxyId, result)
Return result
End Function

## Writes the bounds of a node into the caller-owned out box and returns
## out. The reuse form of GetAABB for warm code.
Function GetAABBTo(proxyId As Integer, out As AABB) As AABB
If proxyId < 0 Or proxyId >= Me.NodeCapacity Then
Throw New InvalidArgumentException("DynamicTree.GetAABB index out of range")
End If
Var node As TreeNode = Me.Nodes[proxyId]
out.LowerBound.Set(node.Bounds.LowerBound.X, node.Bounds.LowerBound.Y)
out.UpperBound.Set(node.Bounds.UpperBound.X, node.Bounds.UpperBound.Y)
Return out
End Function

## Queries the tree for leaves whose bounds overlap the given box and whose
## category bits intersect maskBits, returning fresh stats. Overlapping
## leaves are reported through the callback; returning False from the
## callback stops the traversal early.
Function Query(box As AABB, maskBits As Integer, callback As TreeQueryCallback) As TreeStats
Var stats As New TreeStats
Me.QueryTo(box, maskBits, callback, stats)
Return stats
End Function

## The reuse form of Query: fills the caller-owned stats object and returns
## it.
Function QueryTo(box As AABB, maskBits As Integer, callback As TreeQueryCallback, stats As TreeStats) As TreeStats
stats.Reset()

If Me.NodeCount = 0 Then
Return stats
End If

Var nodes As Array(Of TreeNode) = Me.Nodes
Var stack As IntegerList = Me.Scratch().Stack
stack.Clear()
stack.Append(Me.Root)

While stack.Count > 0
Var nodeId As Integer = stack.Pop()
Var node As TreeNode = nodes[nodeId]
stats.NodeVisits = stats.NodeVisits + 1

If AABB.Overlaps(node.Bounds, box) And node.CategoryBits.BitAnd(maskBits) <> 0 Then
If node.IsLeaf() Then
# Report the leaf to user code.
Var proceed As Boolean = callback.VisitLeaf(nodeId, node.UserData)
stats.LeafVisits = stats.LeafVisits + 1

If proceed = False Then
Return stats
End If
Else
stack.Append(node.Child1)
stack.Append(node.Child2)
End If
End If
Wend

Return stats
End Function

## Writes the axis-aligned bounds of the segment from (p1x, p1y) to
## (p2x, p2y) into the target box without allocating.
Private Sub WriteSegmentBounds(p1x As Double, p1y As Double, p2x As Double, p2y As Double, target As AABB)
If p1x < p2x Then
target.LowerBound.Set(p1x, Maths.Min(p1y, p2y))
target.UpperBound.Set(p2x, Maths.Max(p1y, p2y))
Else
target.LowerBound.Set(p2x, Maths.Min(p1y, p2y))
target.UpperBound.Set(p1x, Maths.Max(p1y, p2y))
End If
End Sub

## Returns True when the segment through (p1x, p1y) with perpendicular
## direction components (vx, vy) and absolute components (avx, avy) is
## separated from the node bounds inflated by the given extents. Ported from
## the Gino p80 separating-axis test used by the tree ray and shape casts.
Private Function AxisSeparates(nodeBounds As AABB, p1x As Double, p1y As Double, vx As Double, vy As Double, avx As Double, avy As Double, exX As Double, exY As Double) As Boolean
Var cx As Double = 0.5 * (nodeBounds.LowerBound.X + nodeBounds.UpperBound.X)
Var cy As Double = 0.5 * (nodeBounds.LowerBound.Y + nodeBounds.UpperBound.Y)
Var hx As Double = 0.5 * (nodeBounds.UpperBound.X - nodeBounds.LowerBound.X) + exX
Var hy As Double = 0.5 * (nodeBounds.UpperBound.Y - nodeBounds.LowerBound.Y) + exY
Var term1 As Double = (vx * (p1x - cx) + vy * (p1y - cy)).Abs()
Var term2 As Double = avx * hx + avy * hy
Return term2 < term1
End Function

## Pushes both children of an internal node onto the traversal stack so the
## child whose centre is closer to (p1x, p1y) is popped first, matching the
## upstream traversal order.
Private Sub PushChildrenByDistance(nodes As Array(Of TreeNode), node As TreeNode, p1x As Double, p1y As Double, stack As IntegerList)
Var child1 As Integer = node.Child1
Var child2 As Integer = node.Child2
Var child1Node As TreeNode = nodes[child1]
Var child2Node As TreeNode = nodes[child2]
Var c1x As Double = 0.5 * (child1Node.Bounds.LowerBound.X + child1Node.Bounds.UpperBound.X)
Var c1y As Double = 0.5 * (child1Node.Bounds.LowerBound.Y + child1Node.Bounds.UpperBound.Y)
Var c2x As Double = 0.5 * (child2Node.Bounds.LowerBound.X + child2Node.Bounds.UpperBound.X)
Var c2y As Double = 0.5 * (child2Node.Bounds.LowerBound.Y + child2Node.Bounds.UpperBound.Y)
Var d1x As Double = c1x - p1x
Var d1y As Double = c1y - p1y
Var d2x As Double = c2x - p1x
Var d2y As Double = c2y - p1y
If d1x * d1x + d1y * d1y < d2x * d2x + d2y * d2y Then
stack.Append(child2)
stack.Append(child1)
Else
stack.Append(child1)
stack.Append(child2)
End If
End Sub

## Writes the swept bounds of the origin box translated by (tx, ty) into the
## target box without allocating, matching the upstream min/max construction.
Private Sub WriteSweptBounds(originAABB As AABB, tx As Double, ty As Double, totalAABB As AABB)
Var lowerX As Double = originAABB.LowerBound.X
Var lowerY As Double = originAABB.LowerBound.Y
Var upperX As Double = originAABB.UpperBound.X
Var upperY As Double = originAABB.UpperBound.Y
If tx < 0.0 Then
lowerX = lowerX + tx
End If
If ty < 0.0 Then
lowerY = lowerY + ty
End If
If tx > 0.0 Then
upperX = upperX + tx
End If
If ty > 0.0 Then
upperY = upperY + ty
End If
totalAABB.LowerBound.Set(lowerX, lowerY)
totalAABB.UpperBound.Set(upperX, upperY)
End Sub

## Casts a ray against the tree, reporting candidate leaves through the
## callback, and returns fresh stats. The callback returns 0 to terminate
## the cast, -1 to skip a leaf, or a fraction in (0, maxFraction] to narrow
## the cast. Ported from upstream b2DynamicTree_RayCast.
Function RayCast(input As RayCastInput, maskBits As Integer, callback As TreeRayCastCallback) As TreeStats
Var stats As New TreeStats
Me.RayCastTo(input, maskBits, callback, stats)
Return stats
End Function

## The reuse form of RayCast: fills the caller-owned stats object and
## returns it.
Function RayCastTo(input As RayCastInput, maskBits As Integer, callback As TreeRayCastCallback, stats As TreeStats) As TreeStats
stats.Reset()

If Me.NodeCount = 0 Then
Return stats
End If

Var scratch As TreeScratch = Me.Scratch()
Var nodes As Array(Of TreeNode) = Me.Nodes
Var stack As IntegerList = scratch.Stack

Var p1x As Double = input.Origin.X
Var p1y As Double = input.Origin.Y
Var dx As Double = input.Translation.X
Var dy As Double = input.Translation.Y

# Unit direction of the ray; upstream b2Normalize returns the zero vector
# below the float epsilon.
Var length As Double = Maths.Sqrt(dx * dx + dy * dy)
Var rx As Double = 0.0
Var ry As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
rx = dx / length
ry = dy / length
End If

# v is the left perpendicular of r.
Var vx As Double = -ry
Var vy As Double = rx
Var avx As Double = vx.Abs()
Var avy As Double = vy.Abs()

# Separating axis for segments (Gino, p80):
# |dot(v, p1 - c)| > dot(|v|, h)

Var maxFraction As Double = input.MaxFraction

Var p2x As Double = p1x + maxFraction * dx
Var p2y As Double = p1y + maxFraction * dy

# Build a bounding box for the segment.
Var segmentAABB As AABB = scratch.SegmentBounds
Me.WriteSegmentBounds(p1x, p1y, p2x, p2y, segmentAABB)

# The input copy handed to callbacks between leaves.
Var subInput As RayCastInput = scratch.RayInput
subInput.Origin.Set(p1x, p1y)
subInput.Translation.Set(dx, dy)

stack.Clear()
stack.Append(Me.Root)

While stack.Count > 0
Var nodeId As Integer = stack.Pop()
Var node As TreeNode = nodes[nodeId]
stats.NodeVisits = stats.NodeVisits + 1

If node.CategoryBits.BitAnd(maskBits) = 0 Or AABB.Overlaps(node.Bounds, segmentAABB) = False Then
Continue
End If

# Separating axis for segments (Gino, p80). Radius extension is already
# included in the node bounds.
If Me.AxisSeparates(node.Bounds, p1x, p1y, vx, vy, avx, avy, 0.0, 0.0) Then
Continue
End If

If node.IsLeaf() Then
subInput.MaxFraction = maxFraction

Var value As Double = callback.VisitLeaf(subInput, nodeId, node.UserData)
stats.LeafVisits = stats.LeafVisits + 1

If value = 0.0 Then
# The client has terminated the ray cast.
Return stats
End If

If value > 0.0 And value <= maxFraction Then
# Update the segment bounding box.
maxFraction = value
p2x = p1x + maxFraction * dx
p2y = p1y + maxFraction * dy
Me.WriteSegmentBounds(p1x, p1y, p2x, p2y, segmentAABB)
End If
Else
# Order children by distance to the ray start so the closer subtree is
# traversed first.
Me.PushChildrenByDistance(nodes, node, p1x, p1y, stack)
End If
Wend

Return stats
End Function

## Casts a shape through the tree, reporting candidate leaves through the
## callback, and returns fresh stats. The callback returns 0 to terminate
## the cast, -1 to skip a leaf, or a fraction in (0, maxFraction) to narrow
## the cast. Ported from upstream b2DynamicTree_ShapeCast.
Function ShapeCast(input As ShapeCastInput, maskBits As Integer, callback As TreeShapeCastCallback) As TreeStats
Var stats As New TreeStats
Me.ShapeCastTo(input, maskBits, callback, stats)
Return stats
End Function

## The reuse form of ShapeCast: fills the caller-owned stats object and
## returns it.
Function ShapeCastTo(input As ShapeCastInput, maskBits As Integer, callback As TreeShapeCastCallback, stats As TreeStats) As TreeStats
stats.Reset()

If Me.NodeCount = 0 Or input.Proxy.Count = 0 Then
Return stats
End If

Var scratch As TreeScratch = Me.Scratch()
Var nodes As Array(Of TreeNode) = Me.Nodes
Var stack As IntegerList = scratch.Stack

# Build the start bounds of the cast shape, inflated by its radius.
Var originAABB As AABB = scratch.OriginBounds
originAABB.LowerBound.Set(input.Proxy.Points[0].X, input.Proxy.Points[0].Y)
originAABB.UpperBound.Set(input.Proxy.Points[0].X, input.Proxy.Points[0].Y)
For i As Integer = 1 To input.Proxy.Count - 1
Var px As Double = input.Proxy.Points[i].X
Var py As Double = input.Proxy.Points[i].Y
If px < originAABB.LowerBound.X Then
originAABB.LowerBound.Set(px, originAABB.LowerBound.Y)
End If
If py < originAABB.LowerBound.Y Then
originAABB.LowerBound.Set(originAABB.LowerBound.X, py)
End If
If originAABB.UpperBound.X < px Then
originAABB.UpperBound.Set(px, originAABB.UpperBound.Y)
End If
If originAABB.UpperBound.Y < py Then
originAABB.UpperBound.Set(originAABB.UpperBound.X, py)
End If
Next i

Var radius As Double = input.Proxy.Radius
originAABB.LowerBound.Set(originAABB.LowerBound.X - radius, originAABB.LowerBound.Y - radius)
originAABB.UpperBound.Set(originAABB.UpperBound.X + radius, originAABB.UpperBound.Y + radius)

Var p1x As Double = 0.5 * (originAABB.LowerBound.X + originAABB.UpperBound.X)
Var p1y As Double = 0.5 * (originAABB.LowerBound.Y + originAABB.UpperBound.Y)
Var exX As Double = 0.5 * (originAABB.UpperBound.X - originAABB.LowerBound.X)
Var exY As Double = 0.5 * (originAABB.UpperBound.Y - originAABB.LowerBound.Y)

# v is the left perpendicular of the translation.
Var rx As Double = input.Translation.X
Var ry As Double = input.Translation.Y
Var vx As Double = -ry
Var vy As Double = rx
Var avx As Double = vx.Abs()
Var avy As Double = vy.Abs()

# Separating axis for segments (Gino, p80):
# |dot(v, p1 - c)| > dot(|v|, h)

Var maxFraction As Double = input.MaxFraction

# Build the total swept box for the cast.
Var tx As Double = maxFraction * rx
Var ty As Double = maxFraction * ry
Var totalAABB As AABB = scratch.TotalBounds
Me.WriteSweptBounds(originAABB, tx, ty, totalAABB)

# The input copy handed to callbacks between leaves.
Var subInput As ShapeCastInput = scratch.CastInput
subInput.Proxy = input.Proxy
subInput.Translation.Set(rx, ry)
subInput.CanEncroach = input.CanEncroach

stack.Clear()
stack.Append(Me.Root)

While stack.Count > 0
Var nodeId As Integer = stack.Pop()
Var node As TreeNode = nodes[nodeId]
stats.NodeVisits = stats.NodeVisits + 1

If node.CategoryBits.BitAnd(maskBits) = 0 Or AABB.Overlaps(node.Bounds, totalAABB) = False Then
Continue
End If

# Separating axis for segments (Gino, p80). Radius extension is already
# included in the node bounds; the cast shape extent is added here.
If Me.AxisSeparates(node.Bounds, p1x, p1y, vx, vy, avx, avy, exX, exY) Then
Continue
End If

If node.IsLeaf() Then
subInput.MaxFraction = maxFraction

Var value As Double = callback.VisitLeaf(subInput, nodeId, node.UserData)
stats.LeafVisits = stats.LeafVisits + 1

If value = 0.0 Then
# The client has terminated the shape cast.
Return stats
End If

If value > 0.0 And value < maxFraction Then
# Update the total swept box.
maxFraction = value
tx = maxFraction * rx
ty = maxFraction * ry
Me.WriteSweptBounds(originAABB, tx, ty, totalAABB)
End If
Else
# Order children by distance to the cast centre so the closer subtree
# is traversed first.
Me.PushChildrenByDistance(nodes, node, p1x, p1y, stack)
End If
Wend

Return stats
End Function

## Computes the exact height of the subtree rooted at nodeId. Debug helper
## backing Validate.
Private Function ComputeHeight(nodeId As Integer) As Integer
If nodeId < 0 Or nodeId >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree.ComputeHeight index out of range")
End If
Var node As TreeNode = Me.Nodes[nodeId]

If node.IsLeaf() Then
Return 0
End If

Var height1 As Integer = Me.ComputeHeight(node.Child1)
Var height2 As Integer = Me.ComputeHeight(node.Child2)
Return 1 + Maths.Max(height1, height2)
End Function

## Recursively checks parent and child links. Debug helper backing Validate.
Private Sub ValidateStructure(index As Integer)
If index = PhysicsConstants.NULL_INDEX Then
Return
End If

If index < 0 Or index >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree.ValidateStructure index out of range")
End If

Var node As TreeNode = Me.Nodes[index]

If node.Flags <> 0 And node.IsAllocated() = False Then
Throw New RuntimeException("DynamicTree free node still carries flags")
End If

If node.IsLeaf() Then
If node.Height <> 0 Then
Throw New RuntimeException("DynamicTree leaf has nonzero height")
End If
Return
End If

Var child1 As Integer = node.Child1
Var child2 As Integer = node.Child2

If child1 < 0 Or child1 >= Me.NodeCapacity Or child2 < 0 Or child2 >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree child index out of range")
End If

If Me.Nodes[child1].Parent <> index Or Me.Nodes[child2].Parent <> index Then
Throw New RuntimeException("DynamicTree child parent link mismatch")
End If

Me.ValidateStructure(child1)
Me.ValidateStructure(child2)
End Sub

## Recursively checks stored heights, containment, and category bits.
## Debug helper backing Validate.
Private Sub ValidateMetrics(index As Integer)
If index = PhysicsConstants.NULL_INDEX Then
Return
End If

Var node As TreeNode = Me.Nodes[index]

If node.IsLeaf() Then
If node.Height <> 0 Then
Throw New RuntimeException("DynamicTree leaf has nonzero height")
End If
Return
End If

Var child1 As Integer = node.Child1
Var child2 As Integer = node.Child2

If child1 < 0 Or child1 >= Me.NodeCapacity Or child2 < 0 Or child2 >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree child index out of range")
End If

Var height1 As Integer = Me.Nodes[child1].Height
Var height2 As Integer = Me.Nodes[child2].Height
Var height As Integer = 1 + Maths.Max(height1, height2)
If node.Height <> height Then
Throw New RuntimeException("DynamicTree stored height mismatch")
End If

If AABB.Contains(node.Bounds, Me.Nodes[child1].Bounds) = False Then
Throw New RuntimeException("DynamicTree node does not contain child 1 bounds")
End If
If AABB.Contains(node.Bounds, Me.Nodes[child2].Bounds) = False Then
Throw New RuntimeException("DynamicTree node does not contain child 2 bounds")
End If

Var categoryBits As Integer = Me.Nodes[child1].CategoryBits.BitOr(Me.Nodes[child2].CategoryBits)
If node.CategoryBits <> categoryBits Then
Throw New RuntimeException("DynamicTree node category bits mismatch")
End If

Me.ValidateMetrics(child1)
Me.ValidateMetrics(child2)
End Sub

## Validates the whole tree: structure, metrics, free-list integrity,
## height agreement, and the node accounting identity. Called after
## mutations by the seeded stress tests and by world validation.
Sub Validate()
If Me.Root = PhysicsConstants.NULL_INDEX Then
Return
End If

Me.ValidateStructure(Me.Root)
Me.ValidateMetrics(Me.Root)

Var freeCount As Integer = 0
Var freeIndex As Integer = Me.FreeList
While freeIndex <> PhysicsConstants.NULL_INDEX
If freeIndex < 0 Or freeIndex >= Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree free-list index out of range")
End If
freeIndex = Me.Nodes[freeIndex].Parent
freeCount = freeCount + 1
Wend

Var height As Integer = Me.GetHeight()
Var computedHeight As Integer = Me.ComputeHeight(Me.Root)
If height <> computedHeight Then
Throw New RuntimeException("DynamicTree stored height differs from computed height")
End If

If Me.NodeCount + freeCount <> Me.NodeCapacity Then
Throw New RuntimeException("DynamicTree node accounting mismatch")
End If
End Sub

## Checks that no allocated node carries the enlarged flag, matching
## upstream b2DynamicTree_ValidateNoEnlarged. Only meaningful right after a
## rebuild that clears all enlargement.
Sub ValidateNoEnlarged()
For i As Integer = 0 To Me.NodeCapacity - 1
Var node As TreeNode = Me.Nodes[i]
If node.IsAllocated() Then
If node.IsEnlarged() Then
Throw New RuntimeException("DynamicTree node is enlarged after rebuild")
End If
End If
Next i
End Sub

## Rebuilds the tree optimally, gathering every leaf and every unenlarged
## internal node as rebuild leaves and freeing enlarged internal nodes.
## With fullBuild True every internal node is rebuilt. Returns the number
## of rebuild leaves. Not safe to query the tree during this operation.
Function Rebuild(fullBuild As Boolean) As Integer
Var proxyCount As Integer = Me.ProxyCount
If proxyCount = 0 Then
Return 0
End If

Var scratch As TreeScratch = Me.Scratch()
Var leafIndices As IntegerList = scratch.LeafIndices
Var centersX As DoubleList = scratch.LeafCentersX
Var centersY As DoubleList = scratch.LeafCentersY
Var walkStack As IntegerList = scratch.Stack
leafIndices.Clear()
centersX.Clear()
centersY.Clear()
walkStack.Clear()

Var nodes As Array(Of TreeNode) = Me.Nodes

# Gather all proxy nodes that have grown and all internal nodes that have
# not grown; both become leaves of the rebuilt tree. Free internal nodes
# that have grown.
Var nodeIndex As Integer = Me.Root
Var gathering As Boolean = True
While gathering
Var node As TreeNode = nodes[nodeIndex]

If node.Height = 0 Or (node.IsEnlarged() = False And fullBuild = False) Then
leafIndices.Append(nodeIndex)
centersX.Append(0.5 * (node.Bounds.LowerBound.X + node.Bounds.UpperBound.X))
centersY.Append(0.5 * (node.Bounds.LowerBound.Y + node.Bounds.UpperBound.Y))

# Detach.
node.Parent = PhysicsConstants.NULL_INDEX
Else
Var doomedNodeIndex As Integer = nodeIndex

# Handle children.
nodeIndex = node.Child1
walkStack.Append(node.Child2)

# Remove the doomed node.
Me.FreeNode(doomedNodeIndex)

Continue
End If

If walkStack.Count = 0 Then
gathering = False
Else
nodeIndex = walkStack.Pop()
End If
Wend

If leafIndices.Count > proxyCount Then
Throw New RuntimeException("DynamicTree rebuild gathered more leaves than proxies")
End If

Me.Root = Me.BuildTree(leafIndices.Count)

Me.Validate()

Return leafIndices.Count
End Function

## Partitions the leaf index range [startIndex, startIndex + count) around
## the median of the longest centroid axis using the Hoare partition
## scheme, ported from upstream b2PartitionMid. Returns the split offset
## relative to startIndex.
Private Function PartitionMid(startIndex As Integer, count As Integer) As Integer
# Handle the trivial case.
If count <= 2 Then
Return count \ 2
End If

Var centersX As DoubleList = Me.Scratch().LeafCentersX
Var centersY As DoubleList = Me.Scratch().LeafCentersY

Var lowerX As Double = centersX.Items[startIndex]
Var lowerY As Double = centersY.Items[startIndex]
Var upperX As Double = lowerX
Var upperY As Double = lowerY
For i As Integer = 1 To count - 1
If centersX.Items[startIndex + i] < lowerX Then
lowerX = centersX.Items[startIndex + i]
End If
If centersY.Items[startIndex + i] < lowerY Then
lowerY = centersY.Items[startIndex + i]
End If
If upperX < centersX.Items[startIndex + i] Then
upperX = centersX.Items[startIndex + i]
End If
If upperY < centersY.Items[startIndex + i] Then
upperY = centersY.Items[startIndex + i]
End If
Next i

Var dx As Double = upperX - lowerX
Var dy As Double = upperY - lowerY
Var centerX As Double = 0.5 * (lowerX + upperX)
Var centerY As Double = 0.5 * (lowerY + upperY)

# Partition the longest axis.
Var i1 As Integer = 0
If dx > dy Then
i1 = Me.PartitionAxis(startIndex, count, True, centerX)
Else
i1 = Me.PartitionAxis(startIndex, count, False, centerY)
End If

If i1 > 0 And i1 < count Then
Return i1
End If

Return count \ 2
End Function

## Runs the Hoare partition scan for one centroid axis over the leaf range
## [startIndex, startIndex + count) and returns the split offset relative to
## startIndex, ported from the per-axis halves of upstream b2PartitionMid.
Private Function PartitionAxis(startIndex As Integer, count As Integer, axisIsX As Boolean, pivot As Double) As Integer
Var indices As IntegerList = Me.Scratch().LeafIndices
Var centersX As DoubleList = Me.Scratch().LeafCentersX
Var centersY As DoubleList = Me.Scratch().LeafCentersY

Var i1 As Integer = 0
Var i2 As Integer = count
While i1 < i2
If axisIsX Then
While i1 < i2 And centersX.Items[startIndex + i1] < pivot
i1 = i1 + 1
Wend

While i1 < i2 And centersX.Items[startIndex + i2 - 1] >= pivot
i2 = i2 - 1
Wend
Else
While i1 < i2 And centersY.Items[startIndex + i1] < pivot
i1 = i1 + 1
Wend

While i1 < i2 And centersY.Items[startIndex + i2 - 1] >= pivot
i2 = i2 - 1
Wend
End If

If i1 < i2 Then
# Swap indices and centres.
Var tempIndex As Integer = indices.Items[startIndex + i1]
indices.Items[startIndex + i1] = indices.Items[startIndex + i2 - 1]
indices.Items[startIndex + i2 - 1] = tempIndex

Var tempX As Double = centersX.Items[startIndex + i1]
centersX.Items[startIndex + i1] = centersX.Items[startIndex + i2 - 1]
centersX.Items[startIndex + i2 - 1] = tempX

Var tempY As Double = centersY.Items[startIndex + i1]
centersY.Items[startIndex + i1] = centersY.Items[startIndex + i2 - 1]
centersY.Items[startIndex + i2 - 1] = tempY

i1 = i1 + 1
i2 = i2 - 1
End If
Wend

Return i1
End Function

## Writes one rebuild work item at the given stack depth, appending when the
## depth is new and overwriting a popped slot otherwise.
Private Sub SetRebuildItem(depth As Integer, nodeIndex As Integer, childCount As Integer, startIndex As Integer, splitIndex As Integer, endIndex As Integer)
Var scratch As TreeScratch = Me.Scratch()
If depth < scratch.RebuildNodeIndex.Count Then
scratch.RebuildNodeIndex.SetAt(depth, nodeIndex)
scratch.RebuildChildCount.SetAt(depth, childCount)
scratch.RebuildStartIndex.SetAt(depth, startIndex)
scratch.RebuildSplitIndex.SetAt(depth, splitIndex)
scratch.RebuildEndIndex.SetAt(depth, endIndex)
Else
scratch.RebuildNodeIndex.Append(nodeIndex)
scratch.RebuildChildCount.Append(childCount)
scratch.RebuildStartIndex.Append(startIndex)
scratch.RebuildSplitIndex.Append(splitIndex)
scratch.RebuildEndIndex.Append(endIndex)
End If
End Sub

## Builds a balanced tree over the gathered leaf indices with the
## median-split heuristic, ported from upstream b2BuildTree. Returns the
## root node index.
Private Function BuildTree(leafCount As Integer) As Integer
Var nodes As Array(Of TreeNode) = Me.Nodes
Var leafIndices As IntegerList = Me.Scratch().LeafIndices

If leafCount = 1 Then
nodes[leafIndices.Items[0]].Parent = PhysicsConstants.NULL_INDEX
Return leafIndices.Items[0]
End If

Var scratch As TreeScratch = Me.Scratch()
scratch.RebuildNodeIndex.Clear()
scratch.RebuildChildCount.Clear()
scratch.RebuildStartIndex.Clear()
scratch.RebuildSplitIndex.Clear()
scratch.RebuildEndIndex.Clear()

Var rootSplit As Integer = Me.PartitionMid(0, leafCount)
Me.SetRebuildItem(0, Me.AllocateNode(), -1, 0, rootSplit, leafCount)
Var top As Integer = 0
Var building As Boolean = True

While building
Var childCount As Integer = scratch.RebuildChildCount.Items[top] + 1
scratch.RebuildChildCount.SetAt(top, childCount)

If childCount = 2 Then
# This internal node has both children established.
If top = 0 Then
# All done.
building = False
End If

If building Then
Var parentItemIndex As Integer = top - 1
Var parentNode As TreeNode = nodes[scratch.RebuildNodeIndex.Items[parentItemIndex]]

If scratch.RebuildChildCount.Items[parentItemIndex] = 0 Then
parentNode.Child1 = scratch.RebuildNodeIndex.Items[top]
Else
parentNode.Child2 = scratch.RebuildNodeIndex.Items[top]
End If

Var node As TreeNode = nodes[scratch.RebuildNodeIndex.Items[top]]
node.Parent = scratch.RebuildNodeIndex.Items[parentItemIndex]

Var child1 As TreeNode = nodes[node.Child1]
Var child2 As TreeNode = nodes[node.Child2]

AABB.UnionTo(child1.Bounds, child2.Bounds, node.Bounds)
node.Height = 1 + Maths.Max(child1.Height, child2.Height)
node.CategoryBits = child1.CategoryBits.BitOr(child2.CategoryBits)

# Pop the stack.
top = top - 1
End If
Else
Var startIndex As Integer = 0
Var endIndex As Integer = 0
If childCount = 0 Then
startIndex = scratch.RebuildStartIndex.Items[top]
endIndex = scratch.RebuildSplitIndex.Items[top]
Else
startIndex = scratch.RebuildSplitIndex.Items[top]
endIndex = scratch.RebuildEndIndex.Items[top]
End If

Var count As Integer = endIndex - startIndex

If count = 1 Then
Var childIndex As Integer = leafIndices.Items[startIndex]
Var node As TreeNode = nodes[scratch.RebuildNodeIndex.Items[top]]

If childCount = 0 Then
node.Child1 = childIndex
Else
node.Child2 = childIndex
End If

nodes[childIndex].Parent = scratch.RebuildNodeIndex.Items[top]
Else
top = top + 1
Var split As Integer = Me.PartitionMid(startIndex, count) + startIndex
Me.SetRebuildItem(top, Me.AllocateNode(), -1, startIndex, split, endIndex)
End If
End If
Wend

Var rootNode As TreeNode = nodes[scratch.RebuildNodeIndex.Items[0]]
Var rootChild1 As TreeNode = nodes[rootNode.Child1]
Var rootChild2 As TreeNode = nodes[rootNode.Child2]

AABB.UnionTo(rootChild1.Bounds, rootChild2.Bounds, rootNode.Bounds)
rootNode.Height = 1 + Maths.Max(rootChild1.Height, rootChild2.Height)
rootNode.CategoryBits = rootChild1.CategoryBits.BitOr(rootChild2.CategoryBits)

Return scratch.RebuildNodeIndex.Items[0]
End Function
End Class

# Engine-internal tree query adapter for world explosions, ported from
# upstream ExplosionContext and ExplosionCallback in world.c. One instance
# is owned by the World and reused across explosions. Per dynamic shape in
# range it wakes the body and applies the facing-perimeter impulse at the
# closest point.
Class ExplosionContext Inherits TreeQueryCallback
## The world driving the explosion.
Property Owner As World
## The explosion centre in world space.
Property Position As Vector2
## The full-strength radius.
Property Radius As Double
## The falloff distance beyond the radius.
Property Falloff As Double
## Impulse per unit length of facing perimeter.
Property ImpulsePerLength As Double

## Creates an unbound context; the world fills the fields per explosion.
Constructor()
Me.Owner = Nothing
Me.Position = New Vector2(0.0, 0.0)
Me.Radius = 0.0
Me.Falloff = 0.0
Me.ImpulsePerLength = 0.0
End Constructor

## Tree leaf visit: distance gate, wake, then the facing-perimeter
## impulse at the closest point. Returns True to continue traversal.
Override Function VisitLeaf(proxyId As Integer, userData As Integer) As Boolean
Pragma Unused proxyId
Var shape As Shape = Me.Owner.Shapes[userData]
If Not shape.Live Then
Return True
End If
Var body As Body = Me.Owner.Bodies[shape.BodyId]

# Distance from the explosion centre to the shape, radii included,
# matching the upstream useRadii = true query.
Var input As New DistanceInput
input.ProxyA = shape.DistanceProxy
Var centrePoints() As Vector2 = [Me.Position]
input.ProxyB = ShapeProxy.Make(centrePoints, 1, 0.0)
input.TransformA = Me.Owner.GetShapeTransform(shape)
input.TransformB = New Transform(New Vector2(0.0, 0.0), New Rot(1.0, 0.0))
input.UseRadii = True
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)

If output.Distance > Me.Radius + Me.Falloff Then
Return True
End If

# Wake the body; the impulse application below re-wakes through the
# public path when the wake succeeded.
body.SetAwake(True)
If body.IsAwake() = False Then
Return True
End If

Var closestX As Double = output.PointA.X
Var closestY As Double = output.PointA.Y
If output.Distance = 0.0 Then
# Deep overlap: use the shape centroid in world space.
Var centroidLocal As Vector2 = ShapeCentroid(shape)
Var transform As Transform = Me.Owner.GetShapeTransform(shape)
closestX = transform.P.X + transform.Q.C * centroidLocal.X - transform.Q.S * centroidLocal.Y
closestY = transform.P.Y + transform.Q.S * centroidLocal.X + transform.Q.C * centroidLocal.Y
End If

Var directionX As Double = closestX - Me.Position.X
Var directionY As Double = closestY - Me.Position.Y
Var lengthSquared As Double = directionX * directionX + directionY * directionY
If lengthSquared > 100.0 * PhysicsConstants.FLT_EPSILON * PhysicsConstants.FLT_EPSILON Then
Var length As Double = Maths.Sqrt(lengthSquared)
directionX = directionX / length
directionY = directionY / length
Else
directionX = 1.0
directionY = 0.0
End If

# The perimeter facing the explosion, computed on the local geometry
# against the local line, ported from b2GetShapeProjectedPerimeter.
Var invC As Double = Me.Owner.GetShapeTransform(shape).Q.C
Var invS As Double = -Me.Owner.GetShapeTransform(shape).Q.S
Var localLineX As Double = invC * directionX - invS * directionY
Var localLineY As Double = invS * directionX + invC * directionY
Var perimeter As Double = ShapeProjectedPerimeter(shape, localLineX, localLineY)

Var scale As Double = 1.0
If output.Distance > Me.Radius And Me.Falloff > 0.0 Then
Var falloffScale As Double = (Me.Radius + Me.Falloff - output.Distance) / Me.Falloff
If falloffScale < 0.0 Then
falloffScale = 0.0
ElseIf falloffScale > 1.0 Then
falloffScale = 1.0
End If
scale = falloffScale
End If

Var magnitude As Double = Me.ImpulsePerLength * perimeter * scale
Var impulse As New Vector2(magnitude * directionX, magnitude * directionY)
Var closest As New Vector2(closestX, closestY)
body.ApplyLinearImpulse(impulse, closest, False)
Return True
End Function

## Returns the shape's local centroid, ported from b2GetShapeCentroid.
Private Shared Function ShapeCentroid(shape As Shape) As Vector2
If shape.Type = ShapeType.CircleShape Then
Return New Vector2(shape.Circle.Center.X, shape.Circle.Center.Y)
ElseIf shape.Type = ShapeType.CapsuleShape Then
Var midX As Double = 0.5 * (shape.Capsule.Center1.X + shape.Capsule.Center2.X)
Var midY As Double = 0.5 * (shape.Capsule.Center1.Y + shape.Capsule.Center2.Y)
Return New Vector2(midX, midY)
ElseIf shape.Type = ShapeType.PolygonShape Then
Return New Vector2(shape.Polygon.Centroid.X, shape.Polygon.Centroid.Y)
ElseIf shape.Type = ShapeType.SegmentShape Then
Var midX As Double = 0.5 * (shape.Segment.Point1.X + shape.Segment.Point2.X)
Var midY As Double = 0.5 * (shape.Segment.Point1.Y + shape.Segment.Point2.Y)
Return New Vector2(midX, midY)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
Var midX As Double = 0.5 * (shape.ChainSegment.Segment.Point1.X + shape.ChainSegment.Segment.Point2.X)
Var midY As Double = 0.5 * (shape.ChainSegment.Segment.Point1.Y + shape.ChainSegment.Segment.Point2.Y)
Return New Vector2(midX, midY)
End If
Return New Vector2(0.0, 0.0)
End Function

## Returns the shape's local perimeter projected onto the line, ported
## from b2GetShapeProjectedPerimeter.
Private Shared Function ShapeProjectedPerimeter(shape As Shape, lineX As Double, lineY As Double) As Double
If shape.Type = ShapeType.CapsuleShape Then
Var axisX As Double = shape.Capsule.Center2.X - shape.Capsule.Center1.X
Var axisY As Double = shape.Capsule.Center2.Y - shape.Capsule.Center1.Y
Var projected As Double = Maths.Abs(axisX * lineX + axisY * lineY)
Return projected + 2.0 * shape.Capsule.Radius
ElseIf shape.Type = ShapeType.CircleShape Then
Return 2.0 * shape.Circle.Radius
ElseIf shape.Type = ShapeType.PolygonShape Then
Var vertices() As Vector2 = shape.Polygon.Vertices
Var count As Integer = shape.Polygon.Count
Var value As Double = vertices[0].X * lineX + vertices[0].Y * lineY
Var lower As Double = value
Var upper As Double = value
Var i As Integer = 1
While i < count
value = vertices[i].X * lineX + vertices[i].Y * lineY
If value < lower Then
lower = value
End If
If value > upper Then
upper = value
End If
i = i + 1
Wend
Return (upper - lower) + 2.0 * shape.Polygon.Radius
ElseIf shape.Type = ShapeType.SegmentShape Then
Var value1 As Double = shape.Segment.Point1.X * lineX + shape.Segment.Point1.Y * lineY
Var value2 As Double = shape.Segment.Point2.X * lineX + shape.Segment.Point2.Y * lineY
Return Maths.Abs(value2 - value1)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
Var value1 As Double = shape.ChainSegment.Segment.Point1.X * lineX + shape.ChainSegment.Segment.Point1.Y * lineY
Var value2 As Double = shape.ChainSegment.Segment.Point2.X * lineX + shape.ChainSegment.Segment.Point2.Y * lineY
Return Maths.Abs(value2 - value1)
End If
Return 0.0
End Function
End Class

# Explosion definition, ported from upstream b2ExplosionDef and
# b2DefaultExplosionDef in types.h. All fields default to zero: the
# explosion applies impulses to dynamic shapes within the radius plus
# falloff distance, scaled by the shape perimeter facing the explosion.
Class ExplosionDefinition
## Mask bits filtering the shapes the explosion reaches. Defaults to all
## bits set.
Property MaskBits As Integer
## The centre of the explosion in world space, in metres.
Property Position As Vector2
## The radius of the full-strength explosion in metres.
Property Radius As Double
## The falloff distance beyond the radius in metres. The impulse reduces
## linearly to zero at this distance.
Property Falloff As Double
## Impulse per unit length of facing perimeter, typically in
## kilogram-metres per second per metre. May be negative for implosions.
Property ImpulsePerLength As Double

## Creates a definition with upstream defaults.
Constructor()
Me.MaskBits = PhysicsConstants.DEFAULT_MASK_BITS
Me.Position = New Vector2(0.0, 0.0)
Me.Radius = 0.0
Me.Falloff = 0.0
Me.ImpulsePerLength = 0.0
End Constructor
End Class

# Collision filtering for shapes, ported from upstream b2Filter in types.h.
# Category and mask bits are wide masks: the default mask has all bits set,
# expressed as the two's-complement Integer -1.
Class Filter
## The collision category bits this shape belongs to.
Property CategoryBits As Integer
## The collision category bits this shape accepts.
Property MaskBits As Integer
## Collision groups above zero collide only within the same group; groups
## below zero never collide within the same group; zero falls back to the
## category and mask rules.
Property GroupIndex As Integer

## Creates the default filter, matching upstream b2DefaultFilter.
Constructor()
Me.CategoryBits = PhysicsConstants.DEFAULT_CATEGORY_BITS
Me.MaskBits = PhysicsConstants.DEFAULT_MASK_BITS
Me.GroupIndex = 0
End Constructor

## Copies another filter.
Constructor(other As Filter)
Me.CategoryBits = other.CategoryBits
Me.MaskBits = other.MaskBits
Me.GroupIndex = other.GroupIndex
End Constructor
End Class

# Public filter joint façade, ported from the b2CreateFilterJoint surface
# in joint.c. The filter joint has no anchors, no solver behaviour, and no
# tuning: every inherited query returns its base default and the constraint
# force and torque are always zero. Its only effect is the connected-joint
# collision rule: while the joint lives, the two attached bodies never form
# new contacts with each other. Contacts that already existed when the
# joint was created persist until they end naturally, exactly like
# upstream.
Class FilterJoint Inherits Joint
End Class

# Filter joint definition, ported from upstream b2FilterJointDef and
# b2DefaultFilterJointDef in types.h and joint.c. A filter joint has no
# anchors, no solver behaviour, and no tuning: it exists purely to disable
# collision between two specific bodies through the connected-joint
# collision rule while both bodies live.
Class FilterJointDefinition
## First attached body, ported from b2FilterJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, ported from b2FilterJointDef.bodyIdB.
Property BodyB As Body
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.UserData = Nothing
End Constructor
End Class

# Generational slot allocation: slots that stay safe to reference across reuse.
#
# Physics2D identifies bodies, shapes, joints, and similar records by a slot
# index plus a generation counter, mirroring the Box2D 3.1.1 id scheme
# (include/box2d/id.h and the per-record generation fields in src/body.c and
# src/world.c). The rules are:
#
# - A slot's generation starts at INVALID_GENERATION (0) and is incremented
#   each time the slot becomes live, so issued generations are 1, 2, 3, ...
# - FreeSlot keeps the generation; the next AllocSlot on that slot bumps it.
#   A handle created before the free therefore stops validating after the
#   slot is reused.
# - Clear returns the pool to empty and zeroes every generation, so handles
#   from a previous lifetime never validate. This backs World.Clear reuse.
# - Free slots stop validating immediately (the live flag clears), closing
#   the window where a stale handle would otherwise match the not-yet-bumped
#   generation.
#
# Generations and live flags are parallel IntegerList stores addressed by
# slot, following the Stage 2 parallel-scalar-array decision. After a
# capacity warm-up, AllocSlot and FreeSlot allocate nothing.
Class GenerationalPool
## Slot allocator supplying recycled and fresh slot indices.
Private Property mIds As IdPool
## Generation counter per slot; zero until the slot first becomes live.
Private Property mGenerations As IntegerList
## Live flag per slot: 1 live, 0 free.
Private Property mLive As IntegerList

## Creates a pool with room for the given slot count before any growth.
Constructor(capacityHint As Integer)
Me.mIds = New IdPool()
Me.mGenerations = New IntegerList()
Me.mLive = New IntegerList()
Me.mGenerations.Reserve(capacityHint)
Me.mLive.Reserve(capacityHint)
End Constructor

## Allocates one slot and returns it. The slot's generation increments and
## becomes live; pair the returned slot with GenerationOf to build handles.
Function AllocSlot() As Integer
Var slot As Integer = Me.mIds.AllocId()
While Me.mGenerations.Count <= slot
Me.mGenerations.Append(0)
Me.mLive.Append(0)
Wend
Me.mGenerations.SetAt(slot, Me.mGenerations.At(slot) + 1)
Me.mLive.SetAt(slot, 1)
Return slot
End Function

## Returns one live slot to the pool. The generation is preserved until the
## slot's next allocation.
Sub FreeSlot(slot As Integer)
If Not Me.IsLive(slot) Then
Throw New InvalidArgumentException("GenerationalPool.FreeSlot slot is not live")
End If
Me.mLive.SetAt(slot, 0)
Me.mIds.FreeId(slot)
End Sub

## True when the slot is live and its generation matches the given one.
## This is the runtime handle check.
Function IsValid(slot As Integer, generation As Integer) As Boolean
If slot < 0 Or slot >= Me.mGenerations.Count Then
Return False
End If
Return Me.mLive.Items[slot] = 1 And Me.mGenerations.Items[slot] = generation
End Function

## True when the slot is currently live.
Function IsLive(slot As Integer) As Boolean
If slot < 0 Or slot >= Me.mLive.Count Then
Return False
End If
Return Me.mLive.Items[slot] = 1
End Function

## Current generation of one slot, or INVALID_GENERATION when the slot has
## never been live or is out of range.
Function GenerationOf(slot As Integer) As Integer
If slot < 0 Or slot >= Me.mGenerations.Count Then
Return PhysicsConstants.INVALID_GENERATION
End If
Return Me.mGenerations.Items[slot]
End Function

## Number of live slots.
Function SlotCount() As Integer
Return Me.mIds.IdCount()
End Function

## High-water mark of slots ever allocated.
Function SlotCapacity() As Integer
Return Me.mIds.IdCapacity()
End Function

## Validates internal invariants, including that live flags agree with the
## underlying slot pool.
Sub Validate()
Me.mIds.Validate()
If Me.mGenerations.Count <> Me.mLive.Count Then
Throw New RuntimeException("GenerationalPool generation and live lengths differ")
End If
Var liveTally As Integer = 0
For i As Integer = 0 To Me.mLive.Count - 1
Var flag As Integer = Me.mLive.Items[i]
If flag <> 0 And flag <> 1 Then
Throw New RuntimeException("GenerationalPool live flag is not a flag")
End If
If flag = 1 Then
liveTally = liveTally + 1
If Me.mGenerations.Items[i] <= PhysicsConstants.INVALID_GENERATION Then
Throw New RuntimeException("GenerationalPool live slot has invalid generation")
End If
End If
Next i
If liveTally <> Me.mIds.IdCount() Then
Throw New RuntimeException("GenerationalPool live tally disagrees with slot pool")
End If
End Sub

## Returns the pool to its initial empty state and zeroes every generation,
## invalidating all outstanding handles.
Sub Clear()
Me.mIds.Clear()
Var capacity As Integer = Me.mGenerations.Capacity()
For i As Integer = 0 To capacity - 1
Me.mGenerations.Items[i] = 0
Me.mLive.Items[i] = 0
Next i
Me.mGenerations.Clear()
Me.mLive.Clear()
End Sub
End Class

# One colour of the constraint graph, ported from upstream b2GraphColor in
# constraint_graph.h. Colours 0..10 track which body slots they hold so the
# solver can batch independent constraints; colour 11 is the overflow colour
# and deliberately has no body set. Each colour owns dense contact and joint
# sims for its awake touching contacts and awake joints.
Class GraphColor
## Body slots held by this colour. Nothing for the overflow colour.
Property BodySet As BitSet
## Touching contact sims assigned to this colour.
Property ContactSims As ContactSims
## Joint sims assigned to this colour.
Property JointSims As JointSims
## Solver scratch constraints matching the sim rows one to one.
Property Constraints As Array(Of ContactConstraint)
## Number of live constraints in the scratch array this step.
Property ConstraintCount As Integer

## Creates a colour with or without a body set, sized for the given body
## capacity. The bit set grows on demand afterwards.
Constructor(hasBodySet As Boolean, bodyCapacity As Integer)
If hasBodySet Then
Me.BodySet = New BitSet(bodyCapacity)
Else
Me.BodySet = Nothing
End If
Me.ContactSims = New ContactSims()
Me.JointSims = New JointSims()
Me.Constraints = New Array(Of ContactConstraint)
Me.ConstraintCount = 0
End Constructor

## Creates a free-record placeholder for sparse array capacity.
Constructor()
Me.BodySet = Nothing
Me.ContactSims = New ContactSims()
Me.JointSims = New JointSims()
Me.Constraints = New Array(Of ContactConstraint)
Me.ConstraintCount = 0
End Constructor
End Class

# Constraint-graph colour assignment and sim migration, ported from
# constraint_graph.c. Contact sims clone into a colour when they start
# touching and move back to the awake set's store when they stop. Joint sims
# live in a colour whenever their joint is awake.
Class GraphMethods
## Claims the first colour whose body set has room for both joint bodies,
## ported from b2AssignJointColor. Static bodies never occupy a colour, so
## a joint anchored to a static body claims a colour for the moving body
## only, and the search starts at colour 1 for that body exactly as for
## contacts.
Private Shared Function ChooseJointColor(graph As ConstraintGraph, bodyIdA As Integer, bodyIdB As Integer, staticA As Boolean, staticB As Boolean) As Integer
If staticA And staticB Then
Throw New RuntimeException("Static bodies cannot share a joint")
End If
Var colorIndex As Integer = PhysicsConstants.GRAPH_OVERFLOW_INDEX
If staticA = False And staticB = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False And colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdA)
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
ElseIf staticA = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False Then
colorSet.SetBitGrow(bodyIdA)
colorIndex = i
End If
i = i + 1
Wend
Else
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
End If
Return colorIndex
End Function

## Assigns an awake joint to a colour and appends its sim row there, ported
## from b2CreateJointInGraph. The row carries the joint's identity columns;
## the caller fills family columns. Returns the row's local index.
Shared Function CreateJointInGraph(world As World, joint As Joint) As Integer
Var graph As ConstraintGraph = world.ConstraintGraph
Var bodyIdA As Integer = joint.Edge0BodyId
Var bodyIdB As Integer = joint.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]
Var staticA As Boolean = bodyA.SetIndex = PhysicsConstants.STATIC_SET
Var staticB As Boolean = bodyB.SetIndex = PhysicsConstants.STATIC_SET

Var colorIndex As Integer = ChooseJointColor(graph, bodyIdA, bodyIdB, staticA, staticB)
Var color As GraphColor = graph.Colors[colorIndex]
joint.ColorIndex = colorIndex
joint.LocalIndex = color.JointSims.Add(joint.Id, bodyIdA, bodyIdB, joint.Type)
Return joint.LocalIndex
End Function

## Moves a joint row from a solver set into the awake graph, ported from
## b2AddJointToGraph. Used when a sleeping joint wakes and joins the graph.
## Removes the source row and fixes the moved row's local index.
Shared Sub AddJointToGraph(world As World, joint As Joint, sourceSet As SolverSet, sourceIndex As Integer)
# Resolve the source store before CreateJointInGraph overwrites the
# joint's colour index.
Var sourceSims As JointSims = sourceSet.JointSims
If sourceSet.SetIndex = PhysicsConstants.AWAKE_SET Then
sourceSims = world.ConstraintGraph.Colors[joint.ColorIndex].JointSims
End If
Var targetIndex As Integer = GraphMethods.CreateJointInGraph(world, joint)
sourceSims.MoveRowTo(world.ConstraintGraph.Colors[joint.ColorIndex].JointSims, targetIndex, sourceIndex)
Var movedJointId As Integer = sourceSims.RemoveSwap(sourceIndex)
If movedJointId <> PhysicsConstants.NULL_INDEX Then
world.Joints[movedJointId].LocalIndex = sourceIndex
End If
End Sub

## Removes a joint's sim row from its colour, ported from
## b2RemoveJointFromGraph.
Shared Sub RemoveJointFromGraph(world As World, bodyIdA As Integer, bodyIdB As Integer, colorIndex As Integer, localIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
If colorIndex <> PhysicsConstants.GRAPH_OVERFLOW_INDEX Then
# May clear a bit for a static body, but this has no effect.
color.BodySet.ClearBit(bodyIdA)
color.BodySet.ClearBit(bodyIdB)
End If
Var movedJointId As Integer = color.JointSims.RemoveSwap(localIndex)
If movedJointId <> PhysicsConstants.NULL_INDEX Then
world.Joints[movedJointId].LocalIndex = localIndex
End If
End Sub
## Claims the first colour whose body set has room for the pair, ported
## from the colour search of b2AddContactToGraph. Static bodies never
## occupy colour 0. Marks the claimed body slots.
Private Shared Function ChooseContactColor(graph As ConstraintGraph, bodyIdA As Integer, bodyIdB As Integer, staticA As Boolean, staticB As Boolean) As Integer
If staticA And staticB Then
Throw New RuntimeException("Static bodies cannot share a contact")
End If
Var colorIndex As Integer = PhysicsConstants.GRAPH_OVERFLOW_INDEX
If staticA = False And staticB = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False And colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdA)
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
Else
# Exactly one body is static; only the moving body claims a bit and the
# search starts at colour 1.
Var bodyId As Integer = bodyIdB
If staticA = False Then
bodyId = bodyIdA
End If
Var j As Integer = 1
While j < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[j].BodySet
If colorSet.GetBit(bodyId) = False Then
colorSet.SetBitGrow(bodyId)
colorIndex = j
End If
j = j + 1
Wend
End If
Return colorIndex
End Function

## Assigns a touching contact to a colour and moves its sim row out of the
## awake set's store, ported from b2AddContactToGraph.
Shared Sub AddContactToGraph(world As World, contact As Contact)
Var graph As ConstraintGraph = world.ConstraintGraph
Var bodyIdA As Integer = contact.Edge0BodyId
Var bodyIdB As Integer = contact.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]
Var staticA As Boolean = bodyA.SetIndex = PhysicsConstants.STATIC_SET
Var staticB As Boolean = bodyB.SetIndex = PhysicsConstants.STATIC_SET

Var colorIndex As Integer = ChooseContactColor(graph, bodyIdA, bodyIdB, staticA, staticB)
Var color As GraphColor = graph.Colors[colorIndex]

# Move the sim row from the source store into the colour. Graph contacts
# always live in the awake set, which also covers waking contacts that
# arrive from a sleeping set.
Var sourceSet As SolverSet = world.SolverSets[contact.SetIndex]
Var sourceIndex As Integer = contact.LocalIndex
contact.ColorIndex = colorIndex
contact.SetIndex = PhysicsConstants.AWAKE_SET
contact.LocalIndex = color.ContactSims.Count()
color.ContactSims.Add()
sourceSet.ContactSims.MoveRowTo(color.ContactSims, contact.LocalIndex, sourceIndex)
Var movedIndex As Integer = sourceSet.ContactSims.RemoveSwap(sourceIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = sourceSet.ContactSims.ContactId.Items[sourceIndex]
world.Contacts[movedContactId].LocalIndex = sourceIndex
End If

# Refresh mass terms against the owning body sims, ported from the tail of
# b2AddContactToGraph.
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
If staticA Then
color.ContactSims.BodySimIndexA.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
color.ContactSims.InvMassA.Items[contact.LocalIndex] = 0.0
color.ContactSims.InvIA.Items[contact.LocalIndex] = 0.0
Else
color.ContactSims.BodySimIndexA.Items[contact.LocalIndex] = bodyA.LocalIndex
color.ContactSims.InvMassA.Items[contact.LocalIndex] = awakeSet.Sims.InvMass.Items[bodyA.LocalIndex]
color.ContactSims.InvIA.Items[contact.LocalIndex] = awakeSet.Sims.InvInertia.Items[bodyA.LocalIndex]
End If
If staticB Then
color.ContactSims.BodySimIndexB.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
color.ContactSims.InvMassB.Items[contact.LocalIndex] = 0.0
color.ContactSims.InvIB.Items[contact.LocalIndex] = 0.0
Else
color.ContactSims.BodySimIndexB.Items[contact.LocalIndex] = bodyB.LocalIndex
color.ContactSims.InvMassB.Items[contact.LocalIndex] = awakeSet.Sims.InvMass.Items[bodyB.LocalIndex]
color.ContactSims.InvIB.Items[contact.LocalIndex] = awakeSet.Sims.InvInertia.Items[bodyB.LocalIndex]
End If
End Sub

## Removes a touching contact's sim from its colour, ported from
## b2RemoveContactFromGraph. Called when the contact stops touching.
Shared Sub RemoveContactFromGraph(world As World, colorIndex As Integer, localIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var movedIndex As Integer = color.ContactSims.RemoveSwap(localIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = color.ContactSims.ContactId.Items[localIndex]
world.Contacts[movedContactId].LocalIndex = localIndex
End If
End Sub

## Moves a touching contact's sim from its colour back into the awake set's
## store, ported from b2AddNonTouchingContact.
Shared Sub MoveContactOutOfGraph(world As World, contact As Contact)
If contact.SetIndex <> PhysicsConstants.AWAKE_SET Then
Throw New RuntimeException("Graph contacts live in the awake set")
End If
Var color As GraphColor = world.ConstraintGraph.Colors[contact.ColorIndex]
Var sourceIndex As Integer = contact.LocalIndex
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
contact.ColorIndex = PhysicsConstants.NULL_INDEX
contact.LocalIndex = awakeSet.ContactSims.Count()
awakeSet.ContactSims.Add()
color.ContactSims.MoveRowTo(awakeSet.ContactSims, contact.LocalIndex, sourceIndex)
Var movedIndex As Integer = color.ContactSims.RemoveSwap(sourceIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = color.ContactSims.ContactId.Items[sourceIndex]
world.Contacts[movedContactId].LocalIndex = sourceIndex
End If
End Sub

End Class

# Convex hull of up to MAX_POLYGON_VERTICES points in counter-clockwise
# winding, ported from upstream b2Hull and hull.c.
#
# ComputeHull welds close points, removes collinear points, and returns an
# empty hull when it fails (fewer than three points, all points nearly
# collinear, or too many points). ValidateHull checks convexity and
# collinearity and is meant for tests and shape construction, not per-step
# code.
#
# Upstream uses fixed-size arrays; this port sizes the point array to the
# hull count, so a computed hull never carries unused vertices.
Class Hull
## The final points of the hull in counter-clockwise order.
Property Points() As Vector2
## The number of points. Zero marks an empty (failed) hull.
Property Count As Integer

## Creates an empty hull.
Constructor()
Me.Points = New Array(Of Vector2)
Me.Count = 0
End Constructor

## Copies another hull, including its point array.
Constructor(other As Hull)
Me.Count = other.Count
Me.Points = New Array(Of Vector2)
For i As Integer = 0 To other.Count - 1
Me.Points.Append(New Vector2(other.Points[i].X, other.Points[i].Y))
Next i
End Constructor

## Computes the convex hull of a point set, ported from upstream
## b2ComputeHull. Returns an empty hull on failure. Input beyond
## MAX_POLYGON_VERTICES points fails; weld tolerance follows the upstream
## linear slop rules.
Shared Function Compute(points() As Vector2, count As Integer) As Hull
Var hull As New Hull

If count < 3 Or count > PhysicsConstants.MAX_POLYGON_VERTICES Then
Return hull
End If

Var lowerX As Double = points[0].X
Var lowerY As Double = points[0].Y
Var upperX As Double = points[0].X
Var upperY As Double = points[0].Y

# Aggressive point welding. The first point always remains. Also compute
# the bounding box for later.
Var ps() As Vector2 = New Array(Of Vector2)
Var linearSlop As Double = PhysicsConstants.LINEAR_SLOP
Var tolSqr As Double = 16.0 * linearSlop * linearSlop
For i As Integer = 0 To count - 1
lowerX = Maths.Min(lowerX, points[i].X)
lowerY = Maths.Min(lowerY, points[i].Y)
upperX = Maths.Max(upperX, points[i].X)
upperY = Maths.Max(upperY, points[i].Y)

WeldPoint(points, i, ps, tolSqr)
Next i

Var n As Integer = ps.Count
If n < 3 Then
# All points very close together.
Return hull
End If

# Find an extreme point as the first hull point.
Var cx As Double = 0.5 * (lowerX + upperX)
Var cy As Double = 0.5 * (lowerY + upperY)
Var f1 As Integer = 0
Var dsq1 As Double = DistanceSquared(cx, cy, ps[f1])
For i As Integer = 1 To n - 1
Var dsq As Double = DistanceSquared(cx, cy, ps[i])
If dsq > dsq1 Then
f1 = i
dsq1 = dsq
End If
Next i

# Remove p1 from the working set. Copy so the hull owns its vectors.
Var p1 As Vector2 = New Vector2(ps[f1].X, ps[f1].Y)
ps[f1] = ps[n - 1]
n = n - 1

Var f2 As Integer = 0
Var dsq2 As Double = DistanceSquared(p1.X, p1.Y, ps[f2])
For i As Integer = 1 To n - 1
Var dsq As Double = DistanceSquared(p1.X, p1.Y, ps[i])
If dsq > dsq2 Then
f2 = i
dsq2 = dsq
End If
Next i

# Remove p2 from the working set. Copy so the hull owns its vectors.
Var p2 As Vector2 = New Vector2(ps[f2].X, ps[f2].Y)
ps[f2] = ps[n - 1]
n = n - 1

# Split the points into those left and right of the line p1-p2.
Var rightPoints() As Vector2 = New Array(Of Vector2)
Var leftPoints() As Vector2 = New Array(Of Vector2)
Var ex As Double = p2.X - p1.X
Var ey As Double = p2.Y - p1.Y
Var invLen As Double = 0.0
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
If len > 0.0 Then
invLen = 1.0 / len
End If
ex = ex * invLen
ey = ey * invLen

For i As Integer = 0 To n - 1
Var d As Double = (ps[i].X - p1.X) * ey - (ps[i].Y - p1.Y) * ex

# The slop skips points very close to the line p1-p2.
If d >= 2.0 * linearSlop Then
rightPoints.Append(New Vector2(ps[i].X, ps[i].Y))
ElseIf d <= -2.0 * linearSlop Then
leftPoints.Append(New Vector2(ps[i].X, ps[i].Y))
End If
Next i

# Compute hulls on the right and left.
Var hull1 As Hull = Recurse(p1, p2, rightPoints)
Var hull2 As Hull = Recurse(p2, p1, leftPoints)

If hull1.Count = 0 And hull2.Count = 0 Then
# All points collinear.
Return hull
End If

# Stitch the hulls together, preserving counter-clockwise winding.
hull.Points.Append(p1)
For i As Integer = 0 To hull1.Count - 1
hull.Points.Append(hull1.Points[i])
Next i
hull.Points.Append(p2)
For i As Integer = 0 To hull2.Count - 1
hull.Points.Append(hull2.Points[i])
Next i
hull.Count = hull.Points.Count

MergeCollinear(hull, linearSlop)

If hull.Count < 3 Then
# All points collinear; not normally reached because the split above
# already rejected collinear sets.
hull.Count = 0
hull.Points = New Array(Of Vector2)
End If

Return hull
End Function

## Welds one candidate point into the working set when it is farther than
## the weld tolerance from every earlier point. The appended vector is a
## copy so the hull never aliases caller-owned vectors.
Shared Sub WeldPoint(points() As Vector2, index As Integer, ps() As Vector2, tolSqr As Double)
Var vi As Vector2 = points[index]
For j As Integer = 0 To index - 1
Var vj As Vector2 = points[j]
Var dx As Double = vi.X - vj.X
Var dy As Double = vi.Y - vj.Y
If dx * dx + dy * dy < tolSqr Then
Return
End If
Next j
ps.Append(New Vector2(vi.X, vi.Y))
End Sub

## Removes collinear points from a stitched hull, ported from the merge
## phase of upstream b2ComputeHull.
Shared Sub MergeCollinear(hull As Hull, linearSlop As Double)
Var searching As Boolean = True
While searching And hull.Count > 2
searching = False

For i As Integer = 0 To hull.Count - 1
Var i1 As Integer = i
Var i2 As Integer = (i + 1) Mod hull.Count
Var i3 As Integer = (i + 2) Mod hull.Count

Var s1 As Vector2 = hull.Points[i1]
Var s2 As Vector2 = hull.Points[i2]
Var s3 As Vector2 = hull.Points[i3]

# Unit edge vector for s1-s3.
Var rx As Double = s3.X - s1.X
Var ry As Double = s3.Y - s1.Y
Var rlen As Double = Maths.Sqrt(rx * rx + ry * ry)
Var invR As Double = 0.0
If rlen > 0.0 Then
invR = 1.0 / rlen
End If
rx = rx * invR
ry = ry * invR

Var distance As Double = (s2.X - s1.X) * ry - (s2.Y - s1.Y) * rx
If distance <= 2.0 * linearSlop Then
# Remove the midpoint from the hull.
hull.Points.RemoveAt(i2)
hull.Count = hull.Count - 1

# Continue searching for collinear points.
searching = True
Exit For
End If
Next i
Wend
End Sub

## Determines whether a hull is valid: convex and free of collinear points,
## ported from upstream b2ValidateHull. Expensive; use outside step loops.
Shared Function Validate(hull As Hull) As Boolean
If hull.Count < 3 Or PhysicsConstants.MAX_POLYGON_VERTICES < hull.Count Then
Return False
End If

# Test that every point is behind every edge.
For i As Integer = 0 To hull.Count - 1
Var i1 As Integer = i
Var i2 As Integer = i
If i1 < hull.Count - 1 Then
i2 = i1 + 1
Else
i2 = 0
End If
Var p As Vector2 = hull.Points[i1]
Var ex As Double = hull.Points[i2].X - p.X
Var ey As Double = hull.Points[i2].Y - p.Y
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
ex = ex * invLen
ey = ey * invLen

For j As Integer = 0 To hull.Count - 1
# Skip points that subtend the current edge.
If j = i1 Or j = i2 Then
Continue
End If

Var distance As Double = (hull.Points[j].X - p.X) * ey - (hull.Points[j].Y - p.Y) * ex
If distance >= 0.0 Then
Return False
End If
Next j
Next i

# Test for collinear points.
Var linearSlop As Double = PhysicsConstants.LINEAR_SLOP
For i As Integer = 0 To hull.Count - 1
Var i1 As Integer = i
Var i2 As Integer = (i + 1) Mod hull.Count
Var i3 As Integer = (i + 2) Mod hull.Count

Var p1 As Vector2 = hull.Points[i1]
Var p2 As Vector2 = hull.Points[i2]
Var p3 As Vector2 = hull.Points[i3]

Var ex As Double = p3.X - p1.X
Var ey As Double = p3.Y - p1.Y
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
ex = ex * invLen
ey = ey * invLen

Var distance As Double = (p2.X - p1.X) * ey - (p2.Y - p1.Y) * ex
If distance <= linearSlop Then
# p1-p2-p3 are collinear.
Return False
End If
Next i

Return True
End Function

## Quickhull recursion, ported from upstream b2RecurseHull. Collects the
## hull points strictly right of the directed edge p1-p2, in winding order.
Shared Function Recurse(p1 As Vector2, p2 As Vector2, ps() As Vector2) As Hull
Var hull As New Hull

Var count As Integer = ps.Count
If count = 0 Then
Return hull
End If

# Edge vector pointing from p1 to p2.
Var ex As Double = p2.X - p1.X
Var ey As Double = p2.Y - p1.Y
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
ex = ex * invLen
ey = ey * invLen

# Discard points left of the edge and find the point furthest right.
Var rightPoints() As Vector2 = New Array(Of Vector2)
Var bestIndex As Integer = 0
Var bestDistance As Double = (ps[0].X - p1.X) * ey - (ps[0].Y - p1.Y) * ex
If bestDistance > 0.0 Then
rightPoints.Append(New Vector2(ps[0].X, ps[0].Y))
End If

For i As Integer = 1 To count - 1
Var distance As Double = (ps[i].X - p1.X) * ey - (ps[i].Y - p1.Y) * ex
If distance > bestDistance Then
bestIndex = i
bestDistance = distance
End If

If distance > 0.0 Then
rightPoints.Append(New Vector2(ps[i].X, ps[i].Y))
End If
Next i

If bestDistance < 2.0 * PhysicsConstants.LINEAR_SLOP Then
Return hull
End If

Var bestPoint As Vector2 = New Vector2(ps[bestIndex].X, ps[bestIndex].Y)

# Compute the hull to the right of p1-bestPoint.
Var hull1 As Hull = Recurse(p1, bestPoint, rightPoints)

# Compute the hull to the right of bestPoint-p2.
Var hull2 As Hull = Recurse(bestPoint, p2, rightPoints)

# Stitch the hulls together.
For i As Integer = 0 To hull1.Count - 1
hull.Points.Append(hull1.Points[i])
Next i
hull.Points.Append(bestPoint)
For i As Integer = 0 To hull2.Count - 1
hull.Points.Append(hull2.Points[i])
Next i
hull.Count = hull.Points.Count

Return hull
End Function

## Squared distance from a point given as components to a vertex.
Shared Function DistanceSquared(ax As Double, ay As Double, v As Vector2) As Double
Var dx As Double = v.X - ax
Var dy As Double = v.Y - ay
Return dx * dx + dy * dy
End Function
End Class

# Slot allocator with free-list recycling, ported from Box2D 3.1.1 id_pool.c.
#
# AllocId hands out recycled slots first (most recently freed first) and then
# fresh slots. nextIndex is the high-water mark, so the number of live slots
# is nextIndex minus the free-list depth. Records keyed by these slots carry
# their own generation counters; see GenerationalPool for the combination.
#
# A warmed pool allocates nothing: the free list is an IntegerList reserved
# up front and FreeId only pushes onto it.
Class IdPool
## Free slot stack, most recently freed slot on top.
Private Property mFreeIds As IntegerList
## High-water mark of slots ever allocated.
Private Property mNextIndex As Integer

## Creates a pool with an initial free-list reserve.
Constructor()
Me.mFreeIds = New IntegerList(32)
Me.mNextIndex = 0
End Constructor

## Allocates one slot: a recycled slot when available, otherwise a fresh one.
Function AllocId() As Integer
If Me.mFreeIds.Count > 0 Then
Return Me.mFreeIds.Pop()
End If
Var id As Integer = Me.mNextIndex
Me.mNextIndex = Me.mNextIndex + 1
Return id
End Function

## Returns one slot to the pool.
Sub FreeId(id As Integer)
If Me.mNextIndex <= 0 Or id < 0 Or id >= Me.mNextIndex Then
Throw New InvalidArgumentException("IdPool.FreeId slot out of range")
End If
Me.mFreeIds.Append(id)
End Sub

## Number of live (allocated and not freed) slots.
Function IdCount() As Integer
Return Me.mNextIndex - Me.mFreeIds.Count
End Function

## Number of slots ever allocated, the high-water mark.
Function IdCapacity() As Integer
Return Me.mNextIndex
End Function

## Throws when the slot is not currently in the free list.
Sub ValidateFreeId(id As Integer)
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
If Me.mFreeIds.Items[i] = id Then
Return
End If
Next i
Throw New RuntimeException("IdPool expected slot in free list")
End Sub

## Throws when the slot is currently in the free list.
Sub ValidateUsedId(id As Integer)
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
If Me.mFreeIds.Items[i] = id Then
Throw New RuntimeException("IdPool slot unexpectedly free")
End If
Next i
End Sub

## Validates internal invariants: free-list bounds and uniqueness.
Sub Validate()
If Me.mFreeIds.Count > Me.mNextIndex Then
Throw New RuntimeException("IdPool free list exceeds slot range")
End If
If Me.IdCount() < 0 Then
Throw New RuntimeException("IdPool live count is negative")
End If
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
Var id As Integer = Me.mFreeIds.Items[i]
If id < 0 Or id >= Me.mNextIndex Then
Throw New RuntimeException("IdPool free slot out of range")
End If
For j As Integer = 0 To i - 1
If Me.mFreeIds.Items[j] = id Then
Throw New RuntimeException("IdPool duplicate free slot")
End If
Next j
Next i
End Sub

## Returns the pool to its initial empty state. All previously allocated
## slots are invalidated; callers pairing slots with generations must clear
## those generations in the same breath (GenerationalPool.Clear does).
Sub Clear()
Me.mFreeIds.Clear()
Me.mNextIndex = 0
End Sub
End Class

# Dense integer scratch and storage list with reserve, grow, swap-remove, and clear.
#
# Objo arrays cannot reserve capacity without changing Count, and they offer
# no swap-remove, so engine code uses this list wherever a growable integer
# sequence is needed (free lists, pair buffers, traversal stacks, event
# queues). The representation follows the Stage 2 bake-off decision: one
# backing array plus a logical count.
#
# Capacity and count are deliberately separate:
# - Items.Count is the capacity. The backing array only grows via Reserve.
# - Count is the number of valid elements. Only indices below Count are
#   valid data; hot engine code may index Items directly inside [0, Count).
#
# After the capacity has been warmed by Reserve, every operation here
# allocates nothing: Append writes into existing capacity, Clear only resets
# the logical count, and RemoveSwap moves the last element into the removed
# slot. This is the foundation of the zero-allocation step path.
Class IntegerList
## Backing array. Its Count is the capacity; index it directly only within [0, Count).
Property Items() As Integer
## Number of valid elements in [0, Count).
Property Count As Integer

## Creates an empty list.
Constructor()
Me.Items = New Array(Of Integer)
Me.Count = 0
End Constructor

## Creates an empty list with room for the given element count.
Constructor(capacityHint As Integer)
Me.Items = New Array(Of Integer)
Me.Count = 0
Me.Reserve(capacityHint)
End Constructor

## Ensures room for at least capacity elements. Extends the backing array
## with zeros when needed; never shrinks and never changes Count.
Sub Reserve(capacity As Integer)
While Me.Items.Count < capacity
Me.Items.Append(0)
Wend
End Sub

## Appends a value, growing capacity by the upstream factor (half again,
## minimum two) when the backing array is full.
Sub Append(value As Integer)
If Me.Count = Me.Items.Count Then
Me.Reserve(Me.GrowCapacity())
End If
Me.Items[Me.Count] = value
Me.Count = Me.Count + 1
End Sub

## Removes and returns the last element.
Function Pop() As Integer
If Me.Count = 0 Then
Throw New RuntimeException("IntegerList.Pop on empty list")
End If
Me.Count = Me.Count - 1
Return Me.Items[Me.Count]
End Function

## Returns the index of the last element, or -1 when empty.
Function LastIndex() As Integer
Return Me.Count - 1
End Function

## Reads the element at index. Cold-path convenience; hot code indexes Items directly.
Function At(index As Integer) As Integer
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.At index out of range")
End If
Return Me.Items[index]
End Function

## Writes the element at index. Cold-path convenience; hot code indexes Items directly.
Sub SetAt(index As Integer, value As Integer)
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.SetAt index out of range")
End If
Me.Items[index] = value
End Sub

## Removes the element at index by moving the last element into its place.
## Returns the index the removed element's replacement came from, or -1
## when the last element itself was removed. Order is not preserved; this
## matches the upstream b2 RemoveSwap contract.
Function RemoveSwap(index As Integer) As Integer
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.RemoveSwap index out of range")
End If
Var movedIndex As Integer = PhysicsConstants.NULL_INDEX
If index <> Me.Count - 1 Then
movedIndex = Me.Count - 1
Me.Items[index] = Me.Items[movedIndex]
End If
Me.Count = Me.Count - 1
Return movedIndex
End Function

## Resets the logical count to zero. Capacity is retained so a warmed list
## keeps operating without allocation.
Sub Clear()
Me.Count = 0
End Sub

## Current capacity, equal to Items.Count.
Function Capacity() As Integer
Return Me.Items.Count
End Function

## Validates internal invariants.
Sub Validate()
If Me.Count < 0 Or Me.Count > Me.Items.Count Then
Throw New RuntimeException("IntegerList count outside capacity")
End If
End Sub

## Upstream growth policy: double from empty, otherwise add half again.
Private Function GrowCapacity() As Integer
If Me.Items.Count < 2 Then
Return 2
End If
Return Me.Items.Count + (Me.Items.Count \ 2)
End Function
End Class

# Persistent island record, ported from upstream b2Island in island.h. An
# island is a connected component of awake or sleeping bodies joined by
# touching contacts and joints. Islands use union-find parent links while
# awake, and each solver set stores the island ids that live inside it.
#
# Joint lists exist from the start so Stage 9 slots in without reshaping the
# record; they stay empty until joints land.
Class Island
## Index of the solver set that owns this island. NULL_INDEX when free.
Property SetIndex As Integer
## Island index within its solver set. NULL_INDEX when free.
Property LocalIndex As Integer
## This island's own slot index.
Property IslandId As Integer
## Head of the doubly linked body list.
Property HeadBody As Integer
## Tail of the doubly linked body list.
Property TailBody As Integer
## Number of bodies in the island.
Property BodyCount As Integer
## Head of the doubly linked touching-contact list.
Property HeadContact As Integer
## Tail of the doubly linked touching-contact list.
Property TailContact As Integer
## Number of contacts in the island.
Property ContactCount As Integer
## Head of the doubly linked joint list. Empty until Stage 9.
Property HeadJoint As Integer
## Tail of the doubly linked joint list. Empty until Stage 9.
Property TailJoint As Integer
## Number of joints in the island. Zero until Stage 9.
Property JointCount As Integer
## Union-find parent island id. NULL_INDEX for roots.
Property ParentIsland As Integer
## Number of contacts or joints removed from this island since the last
## split; a nonzero value marks the island as a split candidate.
Property ConstraintRemoveCount As Integer

## Creates a free-record placeholder. Only the world may construct live
## islands; the zero-argument form exists for sparse array capacity.
Constructor()
Me.SetIndex = PhysicsConstants.NULL_INDEX
Me.LocalIndex = PhysicsConstants.NULL_INDEX
Me.IslandId = PhysicsConstants.NULL_INDEX
Me.HeadBody = PhysicsConstants.NULL_INDEX
Me.TailBody = PhysicsConstants.NULL_INDEX
Me.BodyCount = 0
Me.HeadContact = PhysicsConstants.NULL_INDEX
Me.TailContact = PhysicsConstants.NULL_INDEX
Me.ContactCount = 0
Me.HeadJoint = PhysicsConstants.NULL_INDEX
Me.TailJoint = PhysicsConstants.NULL_INDEX
Me.JointCount = 0
Me.ParentIsland = PhysicsConstants.NULL_INDEX
Me.ConstraintRemoveCount = 0
End Constructor
End Class

# Island graph maintenance, ported from upstream island.c. Islands link
# touching contacts and joints into connected components using union-find
# with path compression; awake islands merge eagerly, sleeping islands merge
# when their solver set wakes. Island splitting by depth-first search runs
# after constraint removal.
Class IslandMethods
## Creates an island in the given solver set, ported from b2CreateIsland.
Private Shared Function CreateIsland(world As World, setIndex As Integer) As Island
If setIndex <> PhysicsConstants.AWAKE_SET And setIndex < PhysicsConstants.FIRST_SLEEPING_SET Then
Throw New InvalidArgumentException("Islands require the awake or a sleeping set")
End If
Var islandId As Integer = world.IslandIdPool.AllocId()
If islandId = world.Islands.Count Then
# Growing the island array is the only allocation path: freed island
# ids are reused in place first, so this runs only when the world
# holds more simultaneous islands than ever before.
world.Islands.Append(New Island)
End If
Var contactSet As SolverSet = world.SolverSets[setIndex]
Var island As Island = world.Islands[islandId]
island.SetIndex = setIndex
island.LocalIndex = contactSet.IslandIds.Count
island.IslandId = islandId
island.HeadBody = PhysicsConstants.NULL_INDEX
island.TailBody = PhysicsConstants.NULL_INDEX
island.BodyCount = 0
island.HeadContact = PhysicsConstants.NULL_INDEX
island.TailContact = PhysicsConstants.NULL_INDEX
island.ContactCount = 0
island.HeadJoint = PhysicsConstants.NULL_INDEX
island.TailJoint = PhysicsConstants.NULL_INDEX
island.JointCount = 0
island.ParentIsland = PhysicsConstants.NULL_INDEX
island.ConstraintRemoveCount = 0
contactSet.IslandIds.Append(islandId)
Return island
End Function

## Destroys an empty island, ported from b2DestroyIsland. The island must
## already be empty.
Private Shared Sub DestroyIsland(world As World, islandId As Integer)
If world.SplitIslandId = islandId Then
world.SplitIslandId = PhysicsConstants.NULL_INDEX
End If
Var island As Island = world.Islands[islandId]
Var contactSet As SolverSet = world.SolverSets[island.SetIndex]
Var movedIndex As Integer = contactSet.IslandIds.RemoveSwap(island.LocalIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedIslandId As Integer = contactSet.IslandIds.Items[island.LocalIndex]
world.Islands[movedIslandId].LocalIndex = island.LocalIndex
End If
island.IslandId = PhysicsConstants.NULL_INDEX
island.SetIndex = PhysicsConstants.NULL_INDEX
island.LocalIndex = PhysicsConstants.NULL_INDEX
island.HeadBody = PhysicsConstants.NULL_INDEX
island.TailBody = PhysicsConstants.NULL_INDEX
island.BodyCount = 0
island.HeadContact = PhysicsConstants.NULL_INDEX
island.TailContact = PhysicsConstants.NULL_INDEX
island.ContactCount = 0
island.HeadJoint = PhysicsConstants.NULL_INDEX
island.TailJoint = PhysicsConstants.NULL_INDEX
island.JointCount = 0
island.ParentIsland = PhysicsConstants.NULL_INDEX
island.ConstraintRemoveCount = 0
world.IslandIdPool.FreeId(islandId)
End Sub

## Creates a single-body island, ported from b2CreateIslandForBody in
## body.c. The body must not already belong to an island.
Shared Sub CreateIslandForBody(world As World, setIndex As Integer, body As Body)
If body.IslandId <> PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Body already belongs to an island")
End If
If setIndex = PhysicsConstants.DISABLED_SET Or setIndex = PhysicsConstants.STATIC_SET Then
Throw New InvalidArgumentException("Islands require the awake or a sleeping set")
End If
Var island As Island = CreateIsland(world, setIndex)
body.IslandId = island.IslandId
island.HeadBody = body.Id
island.TailBody = body.Id
island.BodyCount = 1
End Sub

## Removes a body from its island, destroying the island when it becomes
## empty, ported from b2RemoveBodyFromIsland in body.c.
Shared Sub RemoveBodyFromIsland(world As World, body As Body)
If body.IslandId = PhysicsConstants.NULL_INDEX Then
Return
End If
Var islandId As Integer = body.IslandId
Var island As Island = world.Islands[islandId]
If body.IslandPrev <> PhysicsConstants.NULL_INDEX Then
world.Bodies[body.IslandPrev].IslandNext = body.IslandNext
End If
If body.IslandNext <> PhysicsConstants.NULL_INDEX Then
world.Bodies[body.IslandNext].IslandPrev = body.IslandPrev
End If
island.BodyCount = island.BodyCount - 1
If island.HeadBody = body.Id Then
island.HeadBody = body.IslandNext
If island.HeadBody = PhysicsConstants.NULL_INDEX Then
If island.TailBody <> body.Id Or island.BodyCount <> 0 Or island.ContactCount <> 0 Or island.JointCount <> 0 Then
Throw New RuntimeException("Island bookkeeping disagrees while removing a body")
End If
DestroyIsland(world, island.IslandId)
End If
ElseIf island.TailBody = body.Id Then
island.TailBody = body.IslandPrev
End If
body.IslandId = PhysicsConstants.NULL_INDEX
body.IslandPrev = PhysicsConstants.NULL_INDEX
body.IslandNext = PhysicsConstants.NULL_INDEX
End Sub

## Appends a touching contact to an island's contact list, ported from
## b2AddContactToIsland.
Private Shared Sub AddContactToIsland(world As World, islandId As Integer, contact As Contact)
If contact.IslandId <> PhysicsConstants.NULL_INDEX Or contact.IslandPrev <> PhysicsConstants.NULL_INDEX Or contact.IslandNext <> PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Contact already belongs to an island")
End If
Var island As Island = world.Islands[islandId]
If island.HeadContact <> PhysicsConstants.NULL_INDEX Then
contact.IslandNext = island.HeadContact
world.Contacts[island.HeadContact].IslandPrev = contact.ContactId
End If
island.HeadContact = contact.ContactId
If island.TailContact = PhysicsConstants.NULL_INDEX Then
island.TailContact = island.HeadContact
End If
island.ContactCount = island.ContactCount + 1
contact.IslandId = islandId
End Sub

## Appends a joint to an island's joint list, ported from b2AddJointToIsland.
Private Shared Sub AddJointToIsland(world As World, islandId As Integer, joint As Joint)
If joint.IslandId <> PhysicsConstants.NULL_INDEX Or joint.IslandPrev <> PhysicsConstants.NULL_INDEX Or joint.IslandNext <> PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Joint already belongs to an island")
End If
Var island As Island = world.Islands[islandId]
If island.HeadJoint <> PhysicsConstants.NULL_INDEX Then
joint.IslandNext = island.HeadJoint
world.Joints[island.HeadJoint].IslandPrev = joint.Id
End If
island.HeadJoint = joint.Id
If island.TailJoint = PhysicsConstants.NULL_INDEX Then
island.TailJoint = island.HeadJoint
End If
island.JointCount = island.JointCount + 1
joint.IslandId = islandId
End Sub

## Links a joint into the island graph, ported from b2LinkJoint. Wakes a
## sleeping body whose counterpart is awake, unions the two bodies' islands
## with path compression, and merges awake islands when mergeIslands is set.
Shared Sub LinkJoint(world As World, joint As Joint, mergeIslands As Boolean)
Var bodyA As Body = world.Bodies[joint.Edge0BodyId]
Var bodyB As Body = world.Bodies[joint.Edge1BodyId]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET And bodyB.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
world.WakeSolverSet(bodyB.SetIndex)
ElseIf bodyB.SetIndex = PhysicsConstants.AWAKE_SET And bodyA.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
world.WakeSolverSet(bodyA.SetIndex)
End If

Var islandIdA As Integer = bodyA.IslandId
Var islandIdB As Integer = bodyB.IslandId
If islandIdA = PhysicsConstants.NULL_INDEX And islandIdB = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("LinkJoint requires a body with an island")
End If

If islandIdA = islandIdB Then
# Joint in same island.
AddJointToIsland(world, islandIdA, joint)
Return
End If

Var rootIdA As Integer = FindRootIsland(world, islandIdA)
Var rootIdB As Integer = FindRootIsland(world, islandIdB)

If rootIdA <> rootIdB And rootIdA <> PhysicsConstants.NULL_INDEX And rootIdB <> PhysicsConstants.NULL_INDEX Then
world.Islands[rootIdB].ParentIsland = rootIdA
End If

If rootIdA <> PhysicsConstants.NULL_INDEX Then
AddJointToIsland(world, rootIdA, joint)
Else
AddJointToIsland(world, rootIdB, joint)
End If

# Joints need to have islands merged immediately when they are created to
# keep the island graph valid. A body type change can defer the merge until
# all joints are linked.
If mergeIslands Then
MergeAwakeIslands(world)
End If
End Sub

## Unlinks a joint from its island when it is destroyed or disabled, ported
## from b2UnlinkJoint.
Shared Sub UnlinkJoint(world As World, joint As Joint)
If joint.IslandId = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("UnlinkJoint requires a linked joint")
End If
Var islandId As Integer = joint.IslandId
Var island As Island = world.Islands[islandId]
If joint.IslandPrev <> PhysicsConstants.NULL_INDEX Then
world.Joints[joint.IslandPrev].IslandNext = joint.IslandNext
End If
If joint.IslandNext <> PhysicsConstants.NULL_INDEX Then
world.Joints[joint.IslandNext].IslandPrev = joint.IslandPrev
End If
If island.HeadJoint = joint.Id Then
island.HeadJoint = joint.IslandNext
End If
If island.TailJoint = joint.Id Then
island.TailJoint = joint.IslandPrev
End If
island.JointCount = island.JointCount - 1
island.ConstraintRemoveCount = island.ConstraintRemoveCount + 1
joint.IslandId = PhysicsConstants.NULL_INDEX
joint.IslandPrev = PhysicsConstants.NULL_INDEX
joint.IslandNext = PhysicsConstants.NULL_INDEX
End Sub

## Links a touching contact into the island graph, ported from b2LinkContact.
## Wakes a sleeping body whose counterpart is awake, then unions the two
## bodies' islands with path compression.
Shared Sub LinkContact(world As World, contact As Contact)
If contact.Flags.BitAnd(Integer(ContactFlags.TouchingFlag)) = 0 Then
Throw New RuntimeException("LinkContact requires a touching contact")
End If
Var bodyIdA As Integer = contact.Edge0BodyId
Var bodyIdB As Integer = contact.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]

If bodyA.SetIndex = PhysicsConstants.DISABLED_SET Or bodyB.SetIndex = PhysicsConstants.DISABLED_SET Then
Throw New RuntimeException("Disabled bodies cannot join an island")
End If
If bodyA.SetIndex = PhysicsConstants.STATIC_SET And bodyB.SetIndex = PhysicsConstants.STATIC_SET Then
Throw New RuntimeException("Static bodies cannot join an island")
End If

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET And bodyB.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
world.WakeSolverSet(bodyB.SetIndex)
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET And bodyA.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
world.WakeSolverSet(bodyA.SetIndex)
End If

Var islandIdA As Integer = bodyA.IslandId
Var islandIdB As Integer = bodyB.IslandId
If islandIdA = PhysicsConstants.NULL_INDEX And islandIdB = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("LinkContact requires a body with an island")
End If

If islandIdA = islandIdB Then
AddContactToIsland(world, islandIdA, contact)
Return
End If

Var rootIdA As Integer = FindRootIsland(world, islandIdA)
Var rootIdB As Integer = FindRootIsland(world, islandIdB)

If rootIdA <> rootIdB And rootIdA <> PhysicsConstants.NULL_INDEX And rootIdB <> PhysicsConstants.NULL_INDEX Then
world.Islands[rootIdB].ParentIsland = rootIdA
End If

If rootIdA <> PhysicsConstants.NULL_INDEX Then
AddContactToIsland(world, rootIdA, contact)
Else
AddContactToIsland(world, rootIdB, contact)
End If
End Sub

## Returns the union-find root island id with path compression, or
## NULL_INDEX when the island id is NULL.
Private Shared Function FindRootIsland(world As World, islandId As Integer) As Integer
If islandId = PhysicsConstants.NULL_INDEX Then
Return PhysicsConstants.NULL_INDEX
End If
Var island As Island = world.Islands[islandId]
While island.ParentIsland <> PhysicsConstants.NULL_INDEX
Var parent As Island = world.Islands[island.ParentIsland]
If parent.ParentIsland <> PhysicsConstants.NULL_INDEX Then
island.ParentIsland = parent.ParentIsland
End If
island = parent
Wend
Return island.IslandId
End Function

## Unlinks a contact from its island when it stops touching or is
## destroyed, ported from b2UnlinkContact.
Shared Sub UnlinkContact(world As World, contact As Contact)
If contact.IslandId = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("UnlinkContact requires a linked contact")
End If
Var islandId As Integer = contact.IslandId
Var island As Island = world.Islands[islandId]
If contact.IslandPrev <> PhysicsConstants.NULL_INDEX Then
world.Contacts[contact.IslandPrev].IslandNext = contact.IslandNext
End If
If contact.IslandNext <> PhysicsConstants.NULL_INDEX Then
world.Contacts[contact.IslandNext].IslandPrev = contact.IslandPrev
End If
If island.HeadContact = contact.ContactId Then
island.HeadContact = contact.IslandNext
End If
If island.TailContact = contact.ContactId Then
island.TailContact = contact.IslandPrev
End If
island.ContactCount = island.ContactCount - 1
island.ConstraintRemoveCount = island.ConstraintRemoveCount + 1
contact.IslandId = PhysicsConstants.NULL_INDEX
contact.IslandPrev = PhysicsConstants.NULL_INDEX
contact.IslandNext = PhysicsConstants.NULL_INDEX
End Sub

## Merges one child island into its union-find root, ported from
## b2MergeIsland. The child must be awake.
Private Shared Sub MergeIsland(world As World, islandId As Integer)
Var island As Island = world.Islands[islandId]
If island.ParentIsland = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("MergeIsland requires a child island")
End If
Var rootId As Integer = island.ParentIsland
Var rootIsland As Island = world.Islands[rootId]

Var bodyId As Integer = island.HeadBody
While bodyId <> PhysicsConstants.NULL_INDEX
Var body As Body = world.Bodies[bodyId]
body.IslandId = rootId
bodyId = body.IslandNext
Wend

Var contactId As Integer = island.HeadContact
While contactId <> PhysicsConstants.NULL_INDEX
Var contact As Contact = world.Contacts[contactId]
contact.IslandId = rootId
contactId = contact.IslandNext
Wend

Var jointId As Integer = island.HeadJoint
While jointId <> PhysicsConstants.NULL_INDEX
Var joint As Joint = world.Joints[jointId]
joint.IslandId = rootId
jointId = joint.IslandNext
Wend

world.Bodies[rootIsland.TailBody].IslandNext = island.HeadBody
world.Bodies[island.HeadBody].IslandPrev = rootIsland.TailBody
rootIsland.TailBody = island.TailBody
rootIsland.BodyCount = rootIsland.BodyCount + island.BodyCount

If rootIsland.HeadContact = PhysicsConstants.NULL_INDEX Then
rootIsland.HeadContact = island.HeadContact
rootIsland.TailContact = island.TailContact
rootIsland.ContactCount = island.ContactCount
ElseIf island.HeadContact <> PhysicsConstants.NULL_INDEX Then
world.Contacts[rootIsland.TailContact].IslandNext = island.HeadContact
world.Contacts[island.HeadContact].IslandPrev = rootIsland.TailContact
rootIsland.TailContact = island.TailContact
rootIsland.ContactCount = rootIsland.ContactCount + island.ContactCount
End If

If rootIsland.HeadJoint = PhysicsConstants.NULL_INDEX Then
rootIsland.HeadJoint = island.HeadJoint
rootIsland.TailJoint = island.TailJoint
rootIsland.JointCount = island.JointCount
ElseIf island.HeadJoint <> PhysicsConstants.NULL_INDEX Then
world.Joints[rootIsland.TailJoint].IslandNext = island.HeadJoint
world.Joints[island.HeadJoint].IslandPrev = rootIsland.TailJoint
rootIsland.TailJoint = island.TailJoint
rootIsland.JointCount = rootIsland.JointCount + island.JointCount
End If

rootIsland.ConstraintRemoveCount = rootIsland.ConstraintRemoveCount + island.ConstraintRemoveCount
End Sub

## Merges every awake island that has a parent into its root, ported from
## b2MergeAwakeIslands. Runs whenever joint creation merges islands and at
## the start of each step.
Shared Sub MergeAwakeIslands(world As World)
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
Var awakeIslandCount As Integer = awakeSet.IslandIds.Count

Var i As Integer = 0
While i < awakeIslandCount
Var islandId As Integer = awakeSet.IslandIds.Items[i]
Var island As Island = world.Islands[islandId]
Var rootId As Integer = FindRootIsland(world, islandId)
If rootId <> islandId Then
island.ParentIsland = rootId
End If
i = i + 1
Wend

i = awakeIslandCount - 1
While i >= 0
Var islandId As Integer = awakeSet.IslandIds.Items[i]
Var island As Island = world.Islands[islandId]
If island.ParentIsland <> PhysicsConstants.NULL_INDEX Then
MergeIsland(world, islandId)
DestroyIsland(world, islandId)
End If
i = i - 1
Wend
End Sub

## Splits an awake island whose contacts or joints were removed, ported
## from b2SplitIsland. Each depth-first component becomes a fresh island.
Shared Sub SplitIsland(world As World, baseId As Integer)
Var baseIsland As Island = world.Islands[baseId]
If baseIsland.SetIndex <> PhysicsConstants.AWAKE_SET Then
Return
End If
If baseIsland.ConstraintRemoveCount = 0 Then
Return
End If

Var bodyCount As Integer = baseIsland.BodyCount
Var bodyIds As New Array(Of Integer)
Var nextBody As Integer = baseIsland.HeadBody
While nextBody <> PhysicsConstants.NULL_INDEX
bodyIds.Append(nextBody)
world.Bodies[nextBody].IsMarked = False
nextBody = world.Bodies[nextBody].IslandNext
Wend
If bodyIds.Count <> bodyCount Then
Throw New RuntimeException("Island body count disagrees with its list")
End If

Var nextContactId As Integer = baseIsland.HeadContact
While nextContactId <> PhysicsConstants.NULL_INDEX
Var contact As Contact = world.Contacts[nextContactId]
contact.IsMarked = False
nextContactId = contact.IslandNext
Wend

# Clear joint island flags.
Var nextJointId As Integer = baseIsland.HeadJoint
While nextJointId <> PhysicsConstants.NULL_INDEX
Var markedJoint As Joint = world.Joints[nextJointId]
markedJoint.IsMarked = False
nextJointId = markedJoint.IslandNext
Wend

DestroyIsland(world, baseId)

Var i As Integer = 0
While i < bodyCount
Var seedIndex As Integer = bodyIds[i]
Var seed As Body = world.Bodies[seedIndex]
If seed.IsMarked = False Then
Var island As Island = CreateIsland(world, PhysicsConstants.AWAKE_SET)
Var islandId As Integer = island.IslandId
Var stack As New Array(Of Integer)
stack.Append(seedIndex)
seed.IsMarked = True

While stack.Count > 0
Var bodyId As Integer = stack.Pop()
DfsVisitBody(world, island, islandId, bodyId, stack)
Wend
End If
i = i + 1
Wend
End Sub

## Adds one body to a freshly split island and pushes its touching
## neighbours, ported from the depth-first search body of b2SplitIsland.
Private Shared Sub DfsVisitBody(world As World, island As Island, islandId As Integer, bodyId As Integer, stack As Array(Of Integer))
Var body As Body = world.Bodies[bodyId]
body.IslandId = islandId
If island.TailBody <> PhysicsConstants.NULL_INDEX Then
world.Bodies[island.TailBody].IslandNext = bodyId
End If
body.IslandPrev = island.TailBody
body.IslandNext = PhysicsConstants.NULL_INDEX
island.TailBody = bodyId
If island.HeadBody = PhysicsConstants.NULL_INDEX Then
island.HeadBody = bodyId
End If
island.BodyCount = island.BodyCount + 1

Var contactKey As Integer = body.HeadContactKey
While contactKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = contactKey.ShiftRight(1)
Var edgeIndex As Integer = contactKey.BitAnd(1)
Var contact As Contact = world.Contacts[contactId]
If edgeIndex = 0 Then
contactKey = contact.Edge0NextKey
Else
contactKey = contact.Edge1NextKey
End If
If contact.IsMarked Then
Continue While
End If
If contact.Flags.BitAnd(Integer(ContactFlags.TouchingFlag)) = 0 Then
Continue While
End If
contact.IsMarked = True
Var otherBodyId As Integer = contact.Edge1BodyId
If edgeIndex = 1 Then
otherBodyId = contact.Edge0BodyId
End If
Var otherBody As Body = world.Bodies[otherBodyId]
If otherBody.IsMarked = False And otherBody.SetIndex <> PhysicsConstants.STATIC_SET Then
stack.Append(otherBodyId)
otherBody.IsMarked = True
End If

contact.IslandId = islandId
If island.TailContact <> PhysicsConstants.NULL_INDEX Then
world.Contacts[island.TailContact].IslandNext = contactId
End If
contact.IslandPrev = island.TailContact
contact.IslandNext = PhysicsConstants.NULL_INDEX
island.TailContact = contactId
If island.HeadContact = PhysicsConstants.NULL_INDEX Then
island.HeadContact = contactId
End If
island.ContactCount = island.ContactCount + 1
Wend

# Search all joints connected to this body, ported from the joint walk of
# b2SplitIsland.
DfsVisitJoints(world, island, islandId, bodyId, stack)
End Sub

## Walks the joints attached to one body during island split DFS, marking
## unmarked joints, pushing awake unmarked neighbours, and appending the
## joint to the new island's list.
Private Shared Sub DfsVisitJoints(world As World, island As Island, islandId As Integer, bodyId As Integer, stack As Array(Of Integer))
Var body As Body = world.Bodies[bodyId]
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var visitedJointId As Integer = jointKey.ShiftRight(1)
Var jointEdgeIndex As Integer = jointKey.BitAnd(1)
Var visitedJoint As Joint = world.Joints[visitedJointId]
jointKey = visitedJoint.Edge0NextKey
If jointEdgeIndex = 1 Then
jointKey = visitedJoint.Edge1NextKey
End If
If visitedJoint.IsMarked Then
Continue While
End If
visitedJoint.IsMarked = True

Var jointOtherEdge As Integer = 0
If jointEdgeIndex = 0 Then
jointOtherEdge = 1
End If
Var jointOtherBodyId As Integer = visitedJoint.Edge0BodyId
If jointOtherEdge = 1 Then
jointOtherBodyId = visitedJoint.Edge1BodyId
End If
Var jointOtherBody As Body = world.Bodies[jointOtherBodyId]

# Don't simulate joints connected to disabled bodies.
If jointOtherBody.SetIndex = PhysicsConstants.DISABLED_SET Then
Continue While
End If

If jointOtherBody.IsMarked = False And jointOtherBody.SetIndex = PhysicsConstants.AWAKE_SET Then
stack.Append(jointOtherBodyId)
jointOtherBody.IsMarked = True
End If

# Add joint to island.
visitedJoint.IslandId = islandId
If island.TailJoint <> PhysicsConstants.NULL_INDEX Then
world.Joints[island.TailJoint].IslandNext = visitedJointId
End If
visitedJoint.IslandPrev = island.TailJoint
visitedJoint.IslandNext = PhysicsConstants.NULL_INDEX
island.TailJoint = visitedJointId
If island.HeadJoint = PhysicsConstants.NULL_INDEX Then
island.HeadJoint = visitedJointId
End If
island.JointCount = island.JointCount + 1
Wend
End Sub

## Validates one island's linked lists and cross-references, ported from
## b2ValidateIsland.
Shared Sub ValidateIsland(world As World, islandId As Integer)
Var island As Island = world.Islands[islandId]
If island.IslandId <> islandId Then
Throw New RuntimeException("Island slot does not match island id")
End If
If island.SetIndex = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Live island has no solver set")
End If
If island.HeadBody = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Island must hold at least one body")
End If
If island.BodyCount <= 0 Then
Throw New RuntimeException("Island body count must be positive")
End If
Var count As Integer = 0
Var bodyId As Integer = island.HeadBody
While bodyId <> PhysicsConstants.NULL_INDEX
Var body As Body = world.Bodies[bodyId]
If body.IslandId <> islandId Then
Throw New RuntimeException("Body island back reference disagrees")
End If
If body.SetIndex <> island.SetIndex Then
Throw New RuntimeException("Body solver set disagrees with island")
End If
count = count + 1
If count = island.BodyCount And bodyId <> island.TailBody Then
Throw New RuntimeException("Island tail body disagrees with traversal")
End If
bodyId = body.IslandNext
Wend
If count <> island.BodyCount Then
Throw New RuntimeException("Island body count disagrees with traversal")
End If

ValidateIslandContacts(world, island, islandId)
ValidateIslandJoints(world, island, islandId)
End Sub

## Validates the contact linked list of one island, ported from the contact
## walk of b2ValidateIsland.
Private Shared Sub ValidateIslandContacts(world As World, island As Island, islandId As Integer)
Var count As Integer = 0
Var contactId As Integer = island.HeadContact
While contactId <> PhysicsConstants.NULL_INDEX
Var contact As Contact = world.Contacts[contactId]
If contact.SetIndex <> island.SetIndex Then
Throw New RuntimeException("Contact solver set disagrees with island")
End If
If contact.IslandId <> islandId Then
Throw New RuntimeException("Contact island back reference disagrees")
End If
count = count + 1
If count = island.ContactCount And contactId <> island.TailContact Then
Throw New RuntimeException("Island tail contact disagrees with traversal")
End If
contactId = contact.IslandNext
Wend
If count <> island.ContactCount Then
Throw New RuntimeException("Island contact count disagrees with traversal")
End If
If count = 0 And (island.TailContact <> PhysicsConstants.NULL_INDEX Or island.ContactCount <> 0) Then
Throw New RuntimeException("Empty island must hold no contacts")
End If
End Sub

## Validates the joint linked list of one island, ported from the joint walk
## of b2ValidateIsland.
Private Shared Sub ValidateIslandJoints(world As World, island As Island, islandId As Integer)
Var count As Integer = 0
Var jointListId As Integer = island.HeadJoint
While jointListId <> PhysicsConstants.NULL_INDEX
Var listedJoint As Joint = world.Joints[jointListId]
If listedJoint.SetIndex <> island.SetIndex Then
Throw New RuntimeException("Joint solver set disagrees with island")
End If
If listedJoint.IslandId <> islandId Then
Throw New RuntimeException("Joint island back reference disagrees")
End If
count = count + 1
If count = island.JointCount And jointListId <> island.TailJoint Then
Throw New RuntimeException("Island tail joint disagrees with traversal")
End If
jointListId = listedJoint.IslandNext
Wend
If count <> island.JointCount Then
Throw New RuntimeException("Island joint count disagrees with traversal")
End If
If count = 0 And (island.TailJoint <> PhysicsConstants.NULL_INDEX Or island.JointCount <> 0) Then
Throw New RuntimeException("Empty island must hold no joints")
End If
End Sub
End Class

# Persistent joint record and public façade, ported from upstream b2Joint in
# joint.h plus the b2Joint_* surface in joint.c. The record carries solver-set
# membership, body-edge lists, and island links; the hot per-family state
# lives in the JointSims columns of whichever solver set or graph colour the
# joint currently occupies. Family façades such as DistanceJoint extend this
# class with their typed tuning surface.
Class Joint
## Owning world. Nothing for free slots.
Property Owner As World
## Joint slot index.
Property Id As Integer
## True while the slot addresses a live joint.
Property Live As Boolean
## Index of the solver set that owns the hot row. NULL_INDEX when free.
Property SetIndex As Integer
## Constraint-graph colour index. NULL_INDEX outside the awake set.
Property ColorIndex As Integer
## Joint row index within the owning set or graph colour. NULL_INDEX when
## free.
Property LocalIndex As Integer
## Body slot of edge zero.
Property Edge0BodyId As Integer
## Doubly linked list key of the previous joint on edge zero's body.
Property Edge0PrevKey As Integer
## Doubly linked list key of the next joint on edge zero's body.
Property Edge0NextKey As Integer
## Body slot of edge one.
Property Edge1BodyId As Integer
## Doubly linked list key of the previous joint on edge one's body.
Property Edge1PrevKey As Integer
## Doubly linked list key of the next joint on edge one's body.
Property Edge1NextKey As Integer
## Island linked list: previous joint. NULL_INDEX when unlinked.
Property IslandPrev As Integer
## Island linked list: next joint.
Property IslandNext As Integer
## Island slot this joint belongs to. NULL_INDEX when unlinked or outside
## the simulated sets.
Property IslandId As Integer
## Family discriminator.
Property Type As JointType
## Generation used to invalidate stale façades, ported from
## b2Joint.generation.
Property Generation As Integer
## Scratch mark used by island traversal.
Property IsMarked As Boolean
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application. Never read by the solver.
Property UserData As Object
## Debug draw size in metres.
Property DrawSize As Double

## Creates an empty, unbound joint. Only the world may construct live
## joints; the zero-argument form also serves sparse array capacity and
## subclass inheritance.
Constructor()
Me.Owner = Nothing
Me.Id = PhysicsConstants.NULL_INDEX
Me.Live = False
Me.SetIndex = PhysicsConstants.NULL_INDEX
Me.ColorIndex = PhysicsConstants.NULL_INDEX
Me.LocalIndex = PhysicsConstants.NULL_INDEX
Me.Edge0BodyId = PhysicsConstants.NULL_INDEX
Me.Edge0PrevKey = PhysicsConstants.NULL_INDEX
Me.Edge0NextKey = PhysicsConstants.NULL_INDEX
Me.Edge1BodyId = PhysicsConstants.NULL_INDEX
Me.Edge1PrevKey = PhysicsConstants.NULL_INDEX
Me.Edge1NextKey = PhysicsConstants.NULL_INDEX
Me.IslandPrev = PhysicsConstants.NULL_INDEX
Me.IslandNext = PhysicsConstants.NULL_INDEX
Me.IslandId = PhysicsConstants.NULL_INDEX
Me.Generation = PhysicsConstants.INVALID_GENERATION
Me.IsMarked = False
Me.CollideConnected = False
Me.UserData = Nothing
Me.DrawSize = 1.0
End Constructor

## Returns True when this façade still addresses a live joint.
Function IsValid() As Boolean
Return Me.Owner <> Nothing And Me.Live And Me.Id <> PhysicsConstants.NULL_INDEX
End Function

## Throws when this façade no longer addresses a live joint.
Sub CheckValid()
If Me.Owner = Nothing Then
Throw New RuntimeException("Joint has no owner")
End If
If Not Me.Live Or Me.Id = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Joint is destroyed")
End If
End Sub

## Destroys this joint and wakes both attached bodies, ported from
## b2DestroyJoint.
Sub Destroy()
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.DestroyJointInternal(Me, True)
End Sub

## Family discriminator, ported from b2Joint_GetType.
Function GetJointType() As JointType
Me.CheckValid()
Return Me.Type
End Function

## First attached body, ported from b2Joint_GetBodyA.
Function GetBodyA() As Body
Me.CheckValid()
Return Me.Owner.Bodies[Me.Edge0BodyId]
End Function

## Second attached body, ported from b2Joint_GetBodyB.
Function GetBodyB() As Body
Me.CheckValid()
Return Me.Owner.Bodies[Me.Edge1BodyId]
End Function

## Owning world, ported from b2Joint_GetWorld.
Function GetWorld() As World
Me.CheckValid()
Return Me.Owner
End Function

## Moves the first local anchor, ported from b2Joint_SetLocalAnchorA.
Sub SetLocalAnchorA(localAnchor As Vector2)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
store.LocalOriginAnchorAX.Items[Me.LocalIndex] = localAnchor.X
store.LocalOriginAnchorAY.Items[Me.LocalIndex] = localAnchor.Y
End Sub

## First local anchor, ported from b2Joint_GetLocalAnchorA.
Function GetLocalAnchorA() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.LocalOriginAnchorAX.Items[Me.LocalIndex], store.LocalOriginAnchorAY.Items[Me.LocalIndex])
End Function

## Moves the second local anchor, ported from b2Joint_SetLocalAnchorB.
Sub SetLocalAnchorB(localAnchor As Vector2)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
store.LocalOriginAnchorBX.Items[Me.LocalIndex] = localAnchor.X
store.LocalOriginAnchorBY.Items[Me.LocalIndex] = localAnchor.Y
End Sub

## Second local anchor, ported from b2Joint_GetLocalAnchorB.
Function GetLocalAnchorB() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.LocalOriginAnchorBX.Items[Me.LocalIndex], store.LocalOriginAnchorBY.Items[Me.LocalIndex])
End Function

## Sets the reference angle for the families that have one, ported from
## b2Joint_SetReferenceAngle. The prismatic, revolute, and weld cases join
## with those families.
Sub SetReferenceAngle(angleInRadians As Double)
Pragma Unused angleInRadians
Me.CheckValid()
Me.Owner.CheckNotLocked()
End Sub

## Reference angle for the families that have one, ported from
## b2Joint_GetReferenceAngle.
Function GetReferenceAngle() As Double
Me.CheckValid()
Return 0.0
End Function

## Sets the local axis for the families that have one, ported from
## b2Joint_SetLocalAxisA. The prismatic and wheel cases join with those
## families.
Sub SetLocalAxisA(localAxis As Vector2)
Pragma Unused localAxis
Me.CheckValid()
Me.Owner.CheckNotLocked()
End Sub

## Local axis for the families that have one, ported from
## b2Joint_GetLocalAxisA.
Function GetLocalAxisA() As Vector2
Me.CheckValid()
Return New Vector2(0.0, 0.0)
End Function

## Sets whether the connected bodies may collide, ported from
## b2Joint_SetCollideConnected.
Sub SetCollideConnected(shouldCollide As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Me.CollideConnected = shouldCollide Then
Return
End If
Me.CollideConnected = shouldCollide
Var bodyA As Body = Me.Owner.Bodies[Me.Edge0BodyId]
Var bodyB As Body = Me.Owner.Bodies[Me.Edge1BodyId]
If shouldCollide Then
# Nudge the broad phase to look for new pairs; pick the body with the
# fewest shapes.
Var shapeId As Integer = bodyB.HeadShapeId
If bodyA.ShapeCount < bodyB.ShapeCount Then
shapeId = bodyA.HeadShapeId
End If
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Owner.Shapes[shapeId]
If shape.ProxyKey <> PhysicsConstants.NULL_INDEX Then
Me.Owner.BroadPhase.BufferMove(shape.ProxyKey)
End If
shapeId = shape.NextShapeId
Wend
Else
Me.Owner.DestroyContactsBetweenBodies(bodyA, bodyB)
End If
End Sub

## True when the connected bodies may collide, ported from
## b2Joint_GetCollideConnected.
Function GetCollideConnected() As Boolean
Me.CheckValid()
Return Me.CollideConnected
End Function

## Attaches user data, ported from b2Joint_SetUserData.
Sub SetUserData(userData As Object)
Me.CheckValid()
Me.UserData = userData
End Sub

## User data, ported from b2Joint_GetUserData.
Function GetUserData() As Object
Me.CheckValid()
Return Me.UserData
End Function

## Wakes both attached bodies, ported from b2Joint_WakeBodies.
Sub WakeBodies()
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var bodyA As Body = Me.Owner.Bodies[Me.Edge0BodyId]
Var bodyB As Body = Me.Owner.Bodies[Me.Edge1BodyId]
Me.Owner.WakeBody(bodyA)
Me.Owner.WakeBody(bodyB)
End Sub

## Solver hertz for this joint, ported from the hertz out-param of
## b2Joint_GetConstraintTuning.
Function GetConstraintHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).ConstraintHertz.Items[Me.LocalIndex]
End Function

## Sets the solver hertz for this joint, ported from b2Joint_SetConstraintTuning.
Sub SetConstraintHertz(hertz As Double)
Me.CheckValid()
If Not hertz.IsFinite() Or hertz < 0.0 Then
Throw New InvalidArgumentException("Joint hertz must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).ConstraintHertz.Items[Me.LocalIndex] = hertz
End Sub

## Solver damping ratio for this joint, ported from the damping ratio
## out-param of b2Joint_GetConstraintTuning.
Function GetConstraintDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).ConstraintDampingRatio.Items[Me.LocalIndex]
End Function

## Sets the solver damping ratio for this joint, ported from
## b2Joint_SetConstraintTuning.
Sub SetConstraintDampingRatio(dampingRatio As Double)
Me.CheckValid()
If Not dampingRatio.IsFinite() Or dampingRatio < 0.0 Then
Throw New InvalidArgumentException("Joint damping ratio must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).ConstraintDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Changes the solver tuning for this joint, ported from
## b2Joint_SetConstraintTuning.
Sub SetConstraintTuning(hertz As Double, dampingRatio As Double)
Me.SetConstraintHertz(hertz)
Me.SetConstraintDampingRatio(dampingRatio)
End Sub

## Total constraint force applied this step, ported from
## b2Joint_GetConstraintForce.
Function GetConstraintForce() As Vector2
Me.CheckValid()
If Me.Type = JointType.DistanceJoint Then
Return JointSolver.GetDistanceJointForce(Me.Owner, Me.Owner.GetJointSims(Me), Me.LocalIndex)
End If
If Me.Type = JointType.MouseJoint Then
Return JointSolver.GetMouseJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.MotorJoint Then
Return JointSolver.GetMotorJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.RevoluteJoint Then
Return JointSolver.GetRevoluteJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.PrismaticJoint Then
Return JointSolver.GetPrismaticJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.WeldJoint Then
Return JointSolver.GetWeldJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.WheelJoint Then
Return JointSolver.GetWheelJointForce(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
Return New Vector2(0.0, 0.0)
End Function

## Total constraint torque applied this step, ported from
## b2Joint_GetConstraintTorque.
Function GetConstraintTorque() As Double
Me.CheckValid()
If Me.Type = JointType.MouseJoint Then
Return JointSolver.GetMouseJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.MotorJoint Then
Return JointSolver.GetMotorJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.RevoluteJoint Then
Return JointSolver.GetRevoluteJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.PrismaticJoint Then
Return JointSolver.GetPrismaticJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.WeldJoint Then
Return JointSolver.GetWeldJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
If Me.Type = JointType.WheelJoint Then
Return JointSolver.GetWheelJointTorque(Me.Owner.GetJointSims(Me), Me.LocalIndex, Me.Owner.InvH)
End If
Return 0.0
End Function

## Signed distance that still violates the joint's constraints, ported from
## b2Joint_GetLinearSeparation.
Function GetLinearSeparation() As Double
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var transformA As Transform = Me.Owner.GetBodyTransformById(Me.Edge0BodyId)
Var transformB As Transform = Me.Owner.GetBodyTransformById(Me.Edge1BodyId)
Var pA As Vector2 = Transform.TransformPoint(transformA, New Vector2(store.LocalOriginAnchorAX.Items[Me.LocalIndex], store.LocalOriginAnchorAY.Items[Me.LocalIndex]))
Var pB As Vector2 = Transform.TransformPoint(transformB, New Vector2(store.LocalOriginAnchorBX.Items[Me.LocalIndex], store.LocalOriginAnchorBY.Items[Me.LocalIndex]))
Var dp As Vector2 = pB - pA
If Me.Type = JointType.DistanceJoint Then
Var length As Double = dp.Length()
If store.EnableSpring.Items[Me.LocalIndex] = 1 Then
If store.EnableLimit.Items[Me.LocalIndex] = 1 Then
If length < store.MinLength.Items[Me.LocalIndex] Then
Return store.MinLength.Items[Me.LocalIndex] - length
ElseIf length > store.MaxLength.Items[Me.LocalIndex] Then
Return length - store.MaxLength.Items[Me.LocalIndex]
End If
End If
Return 0.0
End If
Return Maths.Abs(length - store.Length.Items[Me.LocalIndex])
End If
Return 0.0
End Function

## Signed angle that still violates the joint's constraints, ported from
## b2Joint_GetAngularSeparation.
Function GetAngularSeparation() As Double
Me.CheckValid()
Return 0.0
End Function
End Class

# Dense joint simulation state for one solver set or graph colour, ported
# from the b2JointSim rows of upstream b2SolverSet in solver_set.h. Decision
# 0004 selects parallel scalar arrays, so every field is one list indexed by
# the joint's local index within the set.
#
# Column ownership: the base columns are shared by every family. The family
# columns below the base block belong to one family each and hold meaningful
# values only while that row's Type matches the family; a row never reads
# another family's columns. Unused families leave their columns empty, so no
# family pays storage for the others. There is deliberately no per-row
# object: transfers between sets and graph colours move scalars only, so a
# warmed step allocates nothing.
Class JointSims
## Cold joint slot of each row.
Property JointId As IntegerList
## Body slot of the first edge.
Property BodyIdA As IntegerList
## Body slot of the second edge.
Property BodyIdB As IntegerList
## Family discriminator stored as Integer(JointType).
Property Type As IntegerList
## X component of the first anchor relative to body A's origin.
Property LocalOriginAnchorAX As DoubleList
## Y component of the first anchor relative to body A's origin.
Property LocalOriginAnchorAY As DoubleList
## X component of the second anchor relative to body B's origin.
Property LocalOriginAnchorBX As DoubleList
## Y component of the second anchor relative to body B's origin.
Property LocalOriginAnchorBY As DoubleList
## Inverse mass of body A.
Property InvMassA As DoubleList
## Inverse rotational inertia of body A.
Property InvIA As DoubleList
## Inverse mass of body B.
Property InvMassB As DoubleList
## Inverse rotational inertia of body B.
Property InvIB As DoubleList
## Solver hertz clamp for the joint, ported from constraintHertz.
Property ConstraintHertz As DoubleList
## Solver damping ratio clamp for the joint, ported from
## constraintDampingRatio.
Property ConstraintDampingRatio As DoubleList
## Soft-step softness of the base constraint, ported from
## constraintSoftness: bias rate, mass scale, impulse scale.
Property SoftnessBiasRate As DoubleList
## Soft-step mass scale of the base constraint.
Property SoftnessMassScale As DoubleList
## Soft-step impulse scale of the base constraint.
Property SoftnessImpulseScale As DoubleList

# Distance joint family columns, ported from upstream b2DistanceJoint in
# joint.h. Valid only while Type = Integer(JointType.DistanceJoint).
## Rest length of the rope constraint.
Property Length As DoubleList
## Spring stiffness in hertz. Zero means a rigid rope.
Property Hertz As DoubleList
## Spring damping ratio.
Property DampingRatio As DoubleList
## Lower clamp of the length range.
Property MinLength As DoubleList
## Upper clamp of the length range.
Property MaxLength As DoubleList
## Maximum motor force magnitude.
Property MaxMotorForce As DoubleList
## Target relative speed along the rope axis.
Property MotorSpeed As DoubleList
## Spring impulse accumulator.
Property Impulse As DoubleList
## Lower limit impulse accumulator.
Property LowerImpulse As DoubleList
## Upper limit impulse accumulator.
Property UpperImpulse As DoubleList
## Motor impulse accumulator.
Property MotorImpulse As DoubleList
## Awake-set state index of body A. NULL_INDEX for static bodies.
Property IndexA As IntegerList
## Awake-set state index of body B. NULL_INDEX for static bodies.
Property IndexB As IntegerList
## X component of the world-space anchor on body A at prepare time.
Property AnchorAX As DoubleList
## Y component of the world-space anchor on body A at prepare time.
Property AnchorAY As DoubleList
## X component of the world-space anchor on body B at prepare time.
Property AnchorBX As DoubleList
## Y component of the world-space anchor on body B at prepare time.
Property AnchorBY As DoubleList
## X component of the body-centre difference at prepare time.
Property DeltaCenterX As DoubleList
## Y component of the body-centre difference at prepare time.
Property DeltaCenterY As DoubleList
## Softness of the spring constraint: bias rate, mass scale, impulse scale.
Property DistanceSoftnessBiasRate As DoubleList
## Mass scale of the spring constraint softness.
Property DistanceSoftnessMassScale As DoubleList
## Impulse scale of the spring constraint softness.
Property DistanceSoftnessImpulseScale As DoubleList
## Effective mass along the rope axis.
Property AxialMass As DoubleList
## Enables the soft spring behaviour: 1 true, 0 false.
Property EnableSpring As IntegerList
## Enables the length limits: 1 true, 0 false.
Property EnableLimit As IntegerList
## Enables the motor: 1 true, 0 false.
Property EnableMotor As IntegerList

# Mouse joint family columns, ported from upstream b2MouseJoint in joint.h.
# Valid only while Type = Integer(JointType.MouseJoint). The mouse joint
# reuses the base IndexB, AnchorB, DeltaCenter, InvMassB, and InvIB columns
# for its single moving body; only the mouse-specific state is stored here.
## X component of the world-space drag target.
Property MouseTargetX As DoubleList
## Y component of the world-space drag target.
Property MouseTargetY As DoubleList
## Spring stiffness in hertz.
Property MouseHertz As DoubleList
## Spring damping ratio.
Property MouseDampingRatio As DoubleList
## Maximum force magnitude applied to body B.
Property MouseMaxForce As DoubleList
## X component of the accumulated linear impulse on body B.
Property MouseLinearImpulseX As DoubleList
## Y component of the accumulated linear impulse on body B.
Property MouseLinearImpulseY As DoubleList
## Accumulated angular impulse damping body B's spin.
Property MouseAngularImpulse As DoubleList
## Linear spring softness: bias rate, mass scale, impulse scale.
Property MouseLinearSoftnessBiasRate As DoubleList
## Linear spring softness mass scale.
Property MouseLinearSoftnessMassScale As DoubleList
## Linear spring softness impulse scale.
Property MouseLinearSoftnessImpulseScale As DoubleList
## Fixed angular softness bias rate, ported from the upstream constants
## (0.5 Hz, 0.1 damping ratio) that damp the dragged body's spin.
Property MouseAngularSoftnessBiasRate As DoubleList
## Fixed angular softness mass scale.
Property MouseAngularSoftnessMassScale As DoubleList
## Fixed angular softness impulse scale.
Property MouseAngularSoftnessImpulseScale As DoubleList
## Upper-left entry of the symmetric 2x2 linear effective mass. The matrix
## is symmetric by construction, so only three entries are stored.
Property MouseLinearMassXX As DoubleList
## Off-diagonal entry of the symmetric linear effective mass.
Property MouseLinearMassXY As DoubleList
## Lower-right entry of the symmetric linear effective mass.
Property MouseLinearMassYY As DoubleList

# Motor joint family columns, ported from upstream b2MotorJoint in joint.h.
# Valid only while Type = Integer(JointType.MotorJoint). The motor joint
# reuses the base IndexA/IndexB, AnchorA/AnchorB, DeltaCenter, and inverse
# mass columns for its two bodies; the constraint ignores the base softness
# (upstream's solve body never reads it) and uses correction-factor bias.
## X component of the target position of body B minus body A in body A's
## frame.
Property MotorLinearOffsetX As DoubleList
## Y component of the linear offset target.
Property MotorLinearOffsetY As DoubleList
## Target body B angle minus body A angle in radians.
Property MotorAngularOffset As DoubleList
## Maximum linear force magnitude.
Property MotorMaxForce As DoubleList
## Maximum torque magnitude.
Property MotorMaxTorque As DoubleList
## Position correction factor in [0, 1].
Property MotorCorrectionFactor As DoubleList
## X component of the accumulated linear impulse.
Property MotorLinearImpulseX As DoubleList
## Y component of the accumulated linear impulse.
Property MotorLinearImpulseY As DoubleList
## Accumulated angular impulse.
Property MotorAngularImpulse As DoubleList
## Upper-left entry of the symmetric 2x2 linear effective mass.
Property MotorLinearMassXX As DoubleList
## Off-diagonal entry of the symmetric linear effective mass.
Property MotorLinearMassXY As DoubleList
## Lower-right entry of the symmetric linear effective mass.
Property MotorLinearMassYY As DoubleList
## Inverse of the sum of both rotational inertias, zero when both are zero.
Property MotorAngularMass As DoubleList
## Angle of body B relative to body A at prepare time minus the angular
## offset, ported from joint->deltaAngle.
Property MotorDeltaAngle As DoubleList

# Revolute joint family columns, ported from upstream b2RevoluteJoint in
# joint.h. Valid only while Type = Integer(JointType.RevoluteJoint). The
# hinge reuses the base two-body columns (IndexA/IndexB, AnchorA/AnchorB,
# DeltaCenter, inverse masses, LocalOriginAnchorA/B) and the base
# EnableSpring/EnableLimit/EnableMotor flag columns, which are per-row and
# therefore unambiguous across joint types.
## X component of the accumulated point-to-point impulse.
Property RevoluteLinearImpulseX As DoubleList
## Y component of the accumulated point-to-point impulse.
Property RevoluteLinearImpulseY As DoubleList
## Accumulated spring impulse.
Property RevoluteSpringImpulse As DoubleList
## Accumulated motor impulse.
Property RevoluteMotorImpulse As DoubleList
## Accumulated lower-limit impulse, always non-negative.
Property RevoluteLowerImpulse As DoubleList
## Accumulated upper-limit impulse, always non-negative.
Property RevoluteUpperImpulse As DoubleList
## Rotational spring stiffness in hertz.
Property RevoluteHertz As DoubleList
## Rotational spring damping ratio.
Property RevoluteDampingRatio As DoubleList
## Spring target angle in radians.
Property RevoluteTargetAngle As DoubleList
## Maximum motor torque.
Property RevoluteMaxMotorTorque As DoubleList
## Desired motor speed in radians per second.
Property RevoluteMotorSpeed As DoubleList
## Reference angle in radians: body B angle minus body A angle in the
## reference state.
Property RevoluteReferenceAngle As DoubleList
## Lower angle limit in radians.
Property RevoluteLowerAngle As DoubleList
## Upper angle limit in radians.
Property RevoluteUpperAngle As DoubleList
## Inverse of the sum of both rotational inertias, zero when both are zero.
Property RevoluteAxialMass As DoubleList
## Angle of body B relative to body A at prepare time, ported from
## joint->deltaAngle; the spring, limits, and angle queries offset this by
## the target or reference angle.
Property RevoluteDeltaAngle As DoubleList
## Spring softness bias rate prepared from hertz and damping ratio.
Property RevoluteSpringSoftnessBiasRate As DoubleList

# Prismatic joint family columns, ported from upstream b2PrismaticJoint in
# joint.h. Valid only while Type = Integer(JointType.PrismaticJoint). The
# slider reuses the base two-body columns (IndexA/IndexB, AnchorA/AnchorB,
# DeltaCenter, inverse masses, LocalOriginAnchorA/B) and the base
# EnableSpring/EnableLimit/EnableMotor flag columns.
## X component of the normalized local translation axis in body A's frame.
Property PrismaticLocalAxisX As DoubleList
## Y component of the normalized local translation axis.
Property PrismaticLocalAxisY As DoubleList
## X component of the translation axis rotated into body A's world frame
## at prepare time, ported from joint->axisA.
Property PrismaticAxisX As DoubleList
## Y component of the prepared world-frame translation axis.
Property PrismaticAxisY As DoubleList
## X component of the accumulated constraint impulse; x is the
## perpendicular force and y the angular impulse.
Property PrismaticImpulseX As DoubleList
## Y component of the accumulated constraint impulse.
Property PrismaticImpulseY As DoubleList
## Accumulated spring impulse.
Property PrismaticSpringImpulse As DoubleList
## Accumulated motor impulse.
Property PrismaticMotorImpulse As DoubleList
## Accumulated lower-limit impulse, always non-negative.
Property PrismaticLowerImpulse As DoubleList
## Accumulated upper-limit impulse, always non-negative.
Property PrismaticUpperImpulse As DoubleList
## Spring stiffness in hertz.
Property PrismaticHertz As DoubleList
## Spring damping ratio.
Property PrismaticDampingRatio As DoubleList
## Spring target translation in metres.
Property PrismaticTargetTranslation As DoubleList
## Maximum motor force.
Property PrismaticMaxMotorForce As DoubleList
## Desired motor speed in metres per second.
Property PrismaticMotorSpeed As DoubleList
## Reference angle in radians.
Property PrismaticReferenceAngle As DoubleList
## Lower translation limit in metres.
Property PrismaticLowerTranslation As DoubleList
## Upper translation limit in metres.
Property PrismaticUpperTranslation As DoubleList
## Inverse of the axial effective mass, zero when singular.
Property PrismaticAxialMass As DoubleList
## Angle of body B relative to body A at prepare time minus the reference
## angle, unwound, ported from joint->deltaAngle.
Property PrismaticDeltaAngle As DoubleList
## Spring softness bias rate prepared from hertz and damping ratio.
Property PrismaticSpringSoftnessBiasRate As DoubleList
## Spring softness mass scale.
Property PrismaticSpringSoftnessMassScale As DoubleList
## Spring softness impulse scale.
Property PrismaticSpringSoftnessImpulseScale As DoubleList

# Weld joint family columns, ported from upstream b2WeldJoint in joint.h.
# Valid only while Type = Integer(JointType.WeldJoint). The weld reuses the
# base two-body columns (IndexA/IndexB, AnchorA/AnchorB, DeltaCenter,
# inverse masses, LocalOriginAnchorA/B). A zero hertz copies the base
# constraint softness into the weld softness columns at prepare time.
## Reference angle in radians: body B angle minus body A angle in the
## reference state.
Property WeldReferenceAngle As DoubleList
## Linear stiffness in hertz; zero means maximum stiffness.
Property WeldLinearHertz As DoubleList
## Linear damping ratio.
Property WeldLinearDampingRatio As DoubleList
## Angular stiffness in hertz; zero means maximum stiffness.
Property WeldAngularHertz As DoubleList
## Angular damping ratio.
Property WeldAngularDampingRatio As DoubleList
## X component of the accumulated linear impulse.
Property WeldLinearImpulseX As DoubleList
## Y component of the accumulated linear impulse.
Property WeldLinearImpulseY As DoubleList
## Accumulated angular impulse.
Property WeldAngularImpulse As DoubleList
## Inverse of the sum of both rotational inertias, zero when both are zero.
Property WeldAxialMass As DoubleList
## Angle of body B relative to body A at prepare time minus the reference
## angle, unwound, ported from joint->deltaAngle.
Property WeldDeltaAngle As DoubleList
## Linear softness bias rate.
Property WeldLinearSoftnessBiasRate As DoubleList
## Linear softness mass scale.
Property WeldLinearSoftnessMassScale As DoubleList
## Linear softness impulse scale.
Property WeldLinearSoftnessImpulseScale As DoubleList
## Angular softness bias rate.
Property WeldAngularSoftnessBiasRate As DoubleList
## Angular softness mass scale.
Property WeldAngularSoftnessMassScale As DoubleList
## Angular softness impulse scale.
Property WeldAngularSoftnessImpulseScale As DoubleList

# Wheel joint family columns, ported from upstream b2WheelJoint in
# joint.h. Valid only while Type = Integer(JointType.WheelJoint). The
# wheel reuses the base two-body columns (IndexA/IndexB, AnchorA/AnchorB,
# DeltaCenter, inverse masses, LocalOriginAnchorA/B) and the base
# EnableSpring/EnableLimit/EnableMotor flag columns. The wheel constrains
# no angle: body B spins freely about the anchor.
## X component of the normalized local translation axis in body A's frame.
Property WheelLocalAxisX As DoubleList
## Y component of the normalized local translation axis.
Property WheelLocalAxisY As DoubleList
## X component of the translation axis rotated into body A's world frame
## at prepare time, ported from joint->axisA.
Property WheelAxisX As DoubleList
## Y component of the prepared world-frame translation axis.
Property WheelAxisY As DoubleList
## Accumulated perpendicular impulse keeping the wheel on the axis line.
Property WheelPerpImpulse As DoubleList
## Accumulated motor impulse.
Property WheelMotorImpulse As DoubleList
## Accumulated spring impulse.
Property WheelSpringImpulse As DoubleList
## Accumulated lower-limit impulse, always non-negative.
Property WheelLowerImpulse As DoubleList
## Accumulated upper-limit impulse, always non-negative.
Property WheelUpperImpulse As DoubleList
## Maximum motor torque.
Property WheelMaxMotorTorque As DoubleList
## Desired motor speed in radians per second.
Property WheelMotorSpeed As DoubleList
## Lower translation limit in metres.
Property WheelLowerTranslation As DoubleList
## Upper translation limit in metres.
Property WheelUpperTranslation As DoubleList
## Suspension spring stiffness in hertz.
Property WheelHertz As DoubleList
## Suspension spring damping ratio.
Property WheelDampingRatio As DoubleList
## Inverse perpendicular effective mass, zero when singular.
Property WheelPerpMass As DoubleList
## Inverse axial effective mass, zero when singular.
Property WheelAxialMass As DoubleList
## Inverse motor effective mass, zero when both inertias vanish.
Property WheelMotorMass As DoubleList
## Spring softness bias rate prepared from hertz and damping ratio.
Property WheelSpringSoftnessBiasRate As DoubleList
## Spring softness mass scale.
Property WheelSpringSoftnessMassScale As DoubleList
## Spring softness impulse scale.
Property WheelSpringSoftnessImpulseScale As DoubleList
## Spring softness mass scale.
Property RevoluteSpringSoftnessMassScale As DoubleList
## Spring softness impulse scale.
Property RevoluteSpringSoftnessImpulseScale As DoubleList


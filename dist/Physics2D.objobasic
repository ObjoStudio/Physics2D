# Generational slot allocation: slots that stay safe to reference across reuse.
#
# Physics2D identifies bodies, shapes, joints, and similar records by a slot
# index plus a generation counter, mirroring the Box2D 3.1.1 id scheme
# (include/box2d/id.h and the per-record generation fields in src/body.c and
# src/world.c). The rules are:
#
# - A slot's generation starts at INVALID_GENERATION (0) and is incremented
#   each time the slot becomes live, so issued generations are 1, 2, 3, ...
# - FreeSlot keeps the generation; the next AllocSlot on that slot bumps it.
#   A handle created before the free therefore stops validating after the
#   slot is reused.
# - Clear returns the pool to empty and zeroes every generation, so handles
#   from a previous lifetime never validate. This backs World.Clear reuse.
# - Free slots stop validating immediately (the live flag clears), closing
#   the window where a stale handle would otherwise match the not-yet-bumped
#   generation.
#
# Generations and live flags are parallel IntegerList stores addressed by
# slot, following the Stage 2 parallel-scalar-array decision. After a
# capacity warm-up, AllocSlot and FreeSlot allocate nothing.
Class GenerationalPool
## Slot allocator supplying recycled and fresh slot indices.
Private Property mIds As IdPool
## Generation counter per slot; zero until the slot first becomes live.
Private Property mGenerations As IntegerList
## Live flag per slot: 1 live, 0 free.
Private Property mLive As IntegerList

## Creates a pool with room for the given slot count before any growth.
Constructor(capacityHint As Integer)
Me.mIds = New IdPool()
Me.mGenerations = New IntegerList()
Me.mLive = New IntegerList()
Me.mGenerations.Reserve(capacityHint)
Me.mLive.Reserve(capacityHint)
End Constructor

## Allocates one slot and returns it. The slot's generation increments and
## becomes live; pair the returned slot with GenerationOf to build handles.
Function AllocSlot() As Integer
Var slot As Integer = Me.mIds.AllocId()
While Me.mGenerations.Count <= slot
Me.mGenerations.Append(0)
Me.mLive.Append(0)
Wend
Me.mGenerations.SetAt(slot, Me.mGenerations.At(slot) + 1)
Me.mLive.SetAt(slot, 1)
Return slot
End Function

## Returns one live slot to the pool. The generation is preserved until the
## slot's next allocation.
Sub FreeSlot(slot As Integer)
If Not Me.IsLive(slot) Then
Throw New InvalidArgumentException("GenerationalPool.FreeSlot slot is not live")
End If
Me.mLive.SetAt(slot, 0)
Me.mIds.FreeId(slot)
End Sub

## True when the slot is live and its generation matches the given one.
## This is the runtime handle check.
Function IsValid(slot As Integer, generation As Integer) As Boolean
If slot < 0 Or slot >= Me.mGenerations.Count Then
Return False
End If
Return Me.mLive.Items[slot] = 1 And Me.mGenerations.Items[slot] = generation
End Function

## True when the slot is currently live.
Function IsLive(slot As Integer) As Boolean
If slot < 0 Or slot >= Me.mLive.Count Then
Return False
End If
Return Me.mLive.Items[slot] = 1
End Function

## Current generation of one slot, or INVALID_GENERATION when the slot has
## never been live or is out of range.
Function GenerationOf(slot As Integer) As Integer
If slot < 0 Or slot >= Me.mGenerations.Count Then
Return PhysicsConstants.INVALID_GENERATION
End If
Return Me.mGenerations.Items[slot]
End Function

## Number of live slots.
Function SlotCount() As Integer
Return Me.mIds.IdCount()
End Function

## High-water mark of slots ever allocated.
Function SlotCapacity() As Integer
Return Me.mIds.IdCapacity()
End Function

## Validates internal invariants, including that live flags agree with the
## underlying slot pool.
Sub Validate()
Me.mIds.Validate()
If Me.mGenerations.Count <> Me.mLive.Count Then
Throw New RuntimeException("GenerationalPool generation and live lengths differ")
End If
Var liveTally As Integer = 0
For i As Integer = 0 To Me.mLive.Count - 1
Var flag As Integer = Me.mLive.Items[i]
If flag <> 0 And flag <> 1 Then
Throw New RuntimeException("GenerationalPool live flag is not a flag")
End If
If flag = 1 Then
liveTally = liveTally + 1
If Me.mGenerations.Items[i] <= PhysicsConstants.INVALID_GENERATION Then
Throw New RuntimeException("GenerationalPool live slot has invalid generation")
End If
End If
Next i
If liveTally <> Me.mIds.IdCount() Then
Throw New RuntimeException("GenerationalPool live tally disagrees with slot pool")
End If
End Sub

## Returns the pool to its initial empty state and zeroes every generation,
## invalidating all outstanding handles.
Sub Clear()
Me.mIds.Clear()
Var capacity As Integer = Me.mGenerations.Capacity()
For i As Integer = 0 To capacity - 1
Me.mGenerations.Items[i] = 0
Me.mLive.Items[i] = 0
Next i
Me.mGenerations.Clear()
Me.mLive.Clear()
End Sub
End Class

# Slot allocator with free-list recycling, ported from Box2D 3.1.1 id_pool.c.
#
# AllocId hands out recycled slots first (most recently freed first) and then
# fresh slots. nextIndex is the high-water mark, so the number of live slots
# is nextIndex minus the free-list depth. Records keyed by these slots carry
# their own generation counters; see GenerationalPool for the combination.
#
# A warmed pool allocates nothing: the free list is an IntegerList reserved
# up front and FreeId only pushes onto it.
Class IdPool
## Free slot stack, most recently freed slot on top.
Private Property mFreeIds As IntegerList
## High-water mark of slots ever allocated.
Private Property mNextIndex As Integer

## Creates a pool with an initial free-list reserve.
Constructor()
Me.mFreeIds = New IntegerList(32)
Me.mNextIndex = 0
End Constructor

## Allocates one slot: a recycled slot when available, otherwise a fresh one.
Function AllocId() As Integer
If Me.mFreeIds.Count > 0 Then
Return Me.mFreeIds.Pop()
End If
Var id As Integer = Me.mNextIndex
Me.mNextIndex = Me.mNextIndex + 1
Return id
End Function

## Returns one slot to the pool.
Sub FreeId(id As Integer)
If Me.mNextIndex <= 0 Or id < 0 Or id >= Me.mNextIndex Then
Throw New InvalidArgumentException("IdPool.FreeId slot out of range")
End If
Me.mFreeIds.Append(id)
End Sub

## Number of live (allocated and not freed) slots.
Function IdCount() As Integer
Return Me.mNextIndex - Me.mFreeIds.Count
End Function

## Number of slots ever allocated, the high-water mark.
Function IdCapacity() As Integer
Return Me.mNextIndex
End Function

## Throws when the slot is not currently in the free list.
Sub ValidateFreeId(id As Integer)
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
If Me.mFreeIds.Items[i] = id Then
Return
End If
Next i
Throw New RuntimeException("IdPool expected slot in free list")
End Sub

## Throws when the slot is currently in the free list.
Sub ValidateUsedId(id As Integer)
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
If Me.mFreeIds.Items[i] = id Then
Throw New RuntimeException("IdPool slot unexpectedly free")
End If
Next i
End Sub

## Validates internal invariants: free-list bounds and uniqueness.
Sub Validate()
If Me.mFreeIds.Count > Me.mNextIndex Then
Throw New RuntimeException("IdPool free list exceeds slot range")
End If
If Me.IdCount() < 0 Then
Throw New RuntimeException("IdPool live count is negative")
End If
Var freeCount As Integer = Me.mFreeIds.Count
For i As Integer = 0 To freeCount - 1
Var id As Integer = Me.mFreeIds.Items[i]
If id < 0 Or id >= Me.mNextIndex Then
Throw New RuntimeException("IdPool free slot out of range")
End If
For j As Integer = 0 To i - 1
If Me.mFreeIds.Items[j] = id Then
Throw New RuntimeException("IdPool duplicate free slot")
End If
Next j
Next i
End Sub

## Returns the pool to its initial empty state. All previously allocated
## slots are invalidated; callers pairing slots with generations must clear
## those generations in the same breath (GenerationalPool.Clear does).
Sub Clear()
Me.mFreeIds.Clear()
Me.mNextIndex = 0
End Sub
End Class

# Dense integer scratch and storage list with reserve, grow, swap-remove, and clear.
#
# Objo arrays cannot reserve capacity without changing Count, and they offer
# no swap-remove, so engine code uses this list wherever a growable integer
# sequence is needed (free lists, pair buffers, traversal stacks, event
# queues). The representation follows the Stage 2 bake-off decision: one
# backing array plus a logical count.
#
# Capacity and count are deliberately separate:
# - Items.Count is the capacity. The backing array only grows via Reserve.
# - Count is the number of valid elements. Only indices below Count are
#   valid data; hot engine code may index Items directly inside [0, Count).
#
# After the capacity has been warmed by Reserve, every operation here
# allocates nothing: Append writes into existing capacity, Clear only resets
# the logical count, and RemoveSwap moves the last element into the removed
# slot. This is the foundation of the zero-allocation step path.
Class IntegerList
## Backing array. Its Count is the capacity; index it directly only within [0, Count).
Property Items() As Integer
## Number of valid elements in [0, Count).
Property Count As Integer

## Creates an empty list.
Constructor()
Me.Items = New Array(Of Integer)
Me.Count = 0
End Constructor

## Creates an empty list with room for the given element count.
Constructor(capacityHint As Integer)
Me.Items = New Array(Of Integer)
Me.Count = 0
Me.Reserve(capacityHint)
End Constructor

## Ensures room for at least capacity elements. Extends the backing array
## with zeros when needed; never shrinks and never changes Count.
Sub Reserve(capacity As Integer)
While Me.Items.Count < capacity
Me.Items.Append(0)
Wend
End Sub

## Appends a value, growing capacity by the upstream factor (half again,
## minimum two) when the backing array is full.
Sub Append(value As Integer)
If Me.Count = Me.Items.Count Then
Me.Reserve(Me.GrowCapacity())
End If
Me.Items[Me.Count] = value
Me.Count = Me.Count + 1
End Sub

## Removes and returns the last element.
Function Pop() As Integer
If Me.Count = 0 Then
Throw New RuntimeException("IntegerList.Pop on empty list")
End If
Me.Count = Me.Count - 1
Return Me.Items[Me.Count]
End Function

## Returns the index of the last element, or -1 when empty.
Function LastIndex() As Integer
Return Me.Count - 1
End Function

## Reads the element at index. Cold-path convenience; hot code indexes Items directly.
Function At(index As Integer) As Integer
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.At index out of range")
End If
Return Me.Items[index]
End Function

## Writes the element at index. Cold-path convenience; hot code indexes Items directly.
Sub SetAt(index As Integer, value As Integer)
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.SetAt index out of range")
End If
Me.Items[index] = value
End Sub

## Removes the element at index by moving the last element into its place.
## Returns the index the removed element's replacement came from, or -1
## when the last element itself was removed. Order is not preserved; this
## matches the upstream b2 RemoveSwap contract.
Function RemoveSwap(index As Integer) As Integer
If index < 0 Or index >= Me.Count Then
Throw New InvalidArgumentException("IntegerList.RemoveSwap index out of range")
End If
Var movedIndex As Integer = PhysicsConstants.NULL_INDEX
If index <> Me.Count - 1 Then
movedIndex = Me.Count - 1
Me.Items[index] = Me.Items[movedIndex]
End If
Me.Count = Me.Count - 1
Return movedIndex
End Function

## Resets the logical count to zero. Capacity is retained so a warmed list
## keeps operating without allocation.
Sub Clear()
Me.Count = 0
End Sub

## Current capacity, equal to Items.Count.
Function Capacity() As Integer
Return Me.Items.Count
End Function

## Validates internal invariants.
Sub Validate()
If Me.Count < 0 Or Me.Count > Me.Items.Count Then
Throw New RuntimeException("IntegerList count outside capacity")
End If
End Sub

## Upstream growth policy: double from empty, otherwise add half again.
Private Function GrowCapacity() As Integer
If Me.Items.Count < 2 Then
Return 2
End If
Return Me.Items.Count + (Me.Items.Count \ 2)
End Function

Sub SetRestitution(restitution As Double)
Me.Validate()
Me.Restitution = restitution
End Sub

## Returns the surface material as a record, ported from
## b2Shape_GetSurfaceMaterial.
Function GetSurfaceMaterial() As SurfaceMaterial
Me.Validate()
Var material As New SurfaceMaterial
material.Friction = Me.Friction
material.Restitution = Me.Restitution
material.RollingResistance = Me.RollingResistance
material.TangentSpeed = Me.TangentSpeed
material.UserMaterialId = Me.UserMaterialId
material.CustomColor = Me.CustomColor
Return material
End Function

## Sets every surface property from the given material, ported from
## b2Shape_SetSurfaceMaterial.
Sub SetSurfaceMaterial(material As SurfaceMaterial)
Me.Validate()
Me.Friction = material.Friction
Me.Restitution = material.Restitution
Me.RollingResistance = material.RollingResistance
Me.TangentSpeed = material.TangentSpeed
Me.UserMaterialId = material.UserMaterialId
Me.CustomColor = material.CustomColor
End Sub

## The user material identifier used by mixers.
Function GetMaterial() As Integer
Me.Validate()
Return Me.UserMaterialId
End Function

## Sets the user material identifier used by mixers.
Sub SetMaterial(material As Integer)
Me.Validate()
Me.UserMaterialId = material
End Sub

## Returns a copy of the shape filter.
Function GetFilter() As Filter
Me.Validate()
Return New Filter(Me.Filter)
End Function

## Replaces the shape filter and refreshes the broad-phase proxy, ported
## from b2Shape_SetFilter.
Sub SetFilter(filter As Filter)
Me.Validate()
Me.Owner.SetShapeFilter(Me, filter)
End Sub

## Returns the mass data of the geometry at this shape's density, ported
## from b2Shape_GetMassData. Segments and chain segments report zero mass.
Function GetMassData() As MassData
Me.Validate()
Return Me.Owner.ComputeShapeMass(Me)
End Function

## Returns the owning chain slot for chain segment shapes, or the null
## sentinel, ported from b2Shape_GetParentChain.
Function GetParentChain() As Integer
Me.Validate()
If Me.Type <> ShapeType.ChainSegmentShape Then
Return PhysicsConstants.NULL_INDEX
End If
Return Me.ChainSegment.ChainId
End Function

## Tests whether a world point is inside the shape, ported from
## b2Shape_TestPoint. Segments and chain segments report False.
Function TestPoint(point As Vector2) As Boolean
Me.Validate()
Return Me.Owner.ShapeTestPoint(Me, point)
End Function

## Casts a ray against the shape in world space, ported from b2Shape_RayCast.
Function RayCast(input As RayCastInput) As CastOutput
Me.Validate()
Return Me.Owner.ShapeRayCast(Me, input)
End Function

## Casts a ray against the shape into the caller-owned output, ported from
## b2Shape_RayCast. The reused-output form for warm loops.
Function RayCastTo(input As RayCastInput, out As CastOutput) As CastOutput
Me.Validate()
Return Me.Owner.ShapeRayCastTo(Me, input, out)
End Function

## Returns the world point on the shape closest to the target, ported from
## b2Shape_GetClosestPoint.
Function GetClosestPoint(target As Vector2) As Vector2
Me.Validate()
Return Me.Owner.ShapeClosestPoint(Me, target)
End Function

## Destroys this shape and updates the body mass, ported from b2DestroyShape
## with updateBodyMass true. Idempotent on already-destroyed façades.
Sub Destroy()
If Not Me.IsValid() Then
Return
End If
Me.Owner.DestroyShape(Me, True)
End Sub

## Recomputes the local distance proxy from the current geometry. Called by
## the world after creation and geometry changes.
Sub RebuildDistanceProxy()
Var proxy As ShapeProxy = Me.DistanceProxy
proxy.Points.Clear()
proxy.Count = 0
proxy.Radius = 0.0
If Me.Type = ShapeType.CapsuleShape Then
proxy.Points.Append(New Vector2(Me.Capsule.Center1.X, Me.Capsule.Center1.Y))
proxy.Points.Append(New Vector2(Me.Capsule.Center2.X, Me.Capsule.Center2.Y))
proxy.Count = 2
proxy.Radius = Me.Capsule.Radius
ElseIf Me.Type = ShapeType.CircleShape Then
proxy.Points.Append(New Vector2(Me.Circle.Center.X, Me.Circle.Center.Y))
proxy.Count = 1
proxy.Radius = Me.Circle.Radius
ElseIf Me.Type = ShapeType.PolygonShape Then
For i As Integer = 0 To Me.Polygon.Count - 1
proxy.Points.Append(New Vector2(Me.Polygon.Vertices[i].X, Me.Polygon.Vertices[i].Y))
Next i
proxy.Count = Me.Polygon.Count
proxy.Radius = Me.Polygon.Radius
ElseIf Me.Type = ShapeType.SegmentShape Then
proxy.Points.Append(New Vector2(Me.Segment.Point1.X, Me.Segment.Point1.Y))
proxy.Points.Append(New Vector2(Me.Segment.Point2.X, Me.Segment.Point2.Y))
proxy.Count = 2
proxy.Radius = 0.0
ElseIf Me.Type = ShapeType.ChainSegmentShape Then
proxy.Points.Append(New Vector2(Me.ChainSegment.Segment.Point1.X, Me.ChainSegment.Segment.Point1.Y))
proxy.Points.Append(New Vector2(Me.ChainSegment.Segment.Point2.X, Me.ChainSegment.Segment.Point2.Y))
proxy.Count = 2
proxy.Radius = 0.0
End If
End Sub

## Computes the minimum and maximum extents of this shape relative to the
## given centroid, ported from b2ComputeShapeExtent in shape.c. The minimum
## extent bounds how far the shape can move before fast-body detection fires
## and the maximum extent bounds sweep enlargement.
Sub ComputeExtentTo(centroid As Vector2, out As ShapeExtent)
out.MinExtent = 0.0
out.MaxExtent = 0.0
If Me.Type = ShapeType.CapsuleShape Then
out.MinExtent = Me.Capsule.Radius
Var c1x As Double = Me.Capsule.Center1.X - centroid.X
Var c1y As Double = Me.Capsule.Center1.Y - centroid.Y
Var c2x As Double = Me.Capsule.Center2.X - centroid.X
Var c2y As Double = Me.Capsule.Center2.Y - centroid.Y
out.MaxExtent = Maths.Sqrt(Maths.Max(c1x * c1x + c1y * c1y, c2x * c2x + c2y * c2y)) + Me.Capsule.Radius
ElseIf Me.Type = ShapeType.CircleShape Then
out.MinExtent = Me.Circle.Radius
Var dx As Double = Me.Circle.Center.X - centroid.X
Var dy As Double = Me.Circle.Center.Y - centroid.Y
out.MaxExtent = Maths.Sqrt(dx * dx + dy * dy) + Me.Circle.Radius
ElseIf Me.Type = ShapeType.PolygonShape Then
Var minExtent As Double = 1.7976931348623157e308
Var maxExtentSqr As Double = 0.0
Var poly As Polygon = Me.Polygon
Var centroidX As Double = poly.Centroid.X
Var centroidY As Double = poly.Centroid.Y
Var localX As Double = centroid.X
Var localY As Double = centroid.Y
For i As Integer = 0 To poly.Count - 1
Var vx As Double = poly.Vertices[i].X
Var vy As Double = poly.Vertices[i].Y
Var normal As Vector2 = poly.Normals[i]
Var planeOffset As Double = normal.X * (vx - centroidX) + normal.Y * (vy - centroidY)
minExtent = Maths.Min(minExtent, planeOffset)
Var ddx As Double = vx - localX
Var ddy As Double = vy - localY
Var distanceSqr As Double = ddx * ddx + ddy * ddy
maxExtentSqr = Maths.Max(maxExtentSqr, distanceSqr)
Next i
out.MinExtent = minExtent + poly.Radius
out.MaxExtent = Maths.Sqrt(maxExtentSqr) + poly.Radius
Else
Var p1x As Double
Var p1y As Double
Var p2x As Double
Var p2y As Double
If Me.Type = ShapeType.SegmentShape Then
p1x = Me.Segment.Point1.X
p1y = Me.Segment.Point1.Y
p2x = Me.Segment.Point2.X
p2y = Me.Segment.Point2.Y
ElseIf Me.Type = ShapeType.ChainSegmentShape Then
p1x = Me.ChainSegment.Segment.Point1.X
p1y = Me.ChainSegment.Segment.Point1.Y
p2x = Me.ChainSegment.Segment.Point2.X
p2y = Me.ChainSegment.Segment.Point2.Y
Else
Return
End If
out.MinExtent = 0.0
Var c1x As Double = p1x - centroid.X
Var c1y As Double = p1y - centroid.Y
Var c2x As Double = p2x - centroid.X
Var c2y As Double = p2y - centroid.Y
out.MaxExtent = Maths.Sqrt(Maths.Max(c1x * c1x + c1y * c1y, c2x * c2x + c2y * c2y))
End If
End Sub

## Collides a capsule mover against this shape, ported from b2CollideMover
## in shape.c. The mover is transformed into the shape's local frame, the
## type-dispatched collide runs there, and the hit plane normal rotates
## back into world space. Returns a result with Hit False when the mover
## does not reach the shape. Allocates the returned result and the local
## capsule; a cold-path query convenience.
Function CollideMover(transform As Transform, moverCapsule As Capsule) As PlaneResult
Me.Validate()
# Transform the mover into the shape's local frame.
Var invC As Double = transform.Q.C
Var invS As Double = -transform.Q.S
Var dx As Double = moverCapsule.Center1.X - transform.P.X
Var dy As Double = moverCapsule.Center1.Y - transform.P.Y
Var local1 As New Vector2(invC * dx - invS * dy, invS * dx + invC * dy)
dx = moverCapsule.Center2.X - transform.P.X
dy = moverCapsule.Center2.Y - transform.P.Y
Var local2 As New Vector2(invC * dx - invS * dy, invS * dx + invC * dy)
Var localMover As New Capsule(local1, local2, moverCapsule.Radius)
Var result As PlaneResult
If Me.Type = ShapeType.CircleShape Then
result = Mover.CollideCircle(Me.Circle, localMover)
ElseIf Me.Type = ShapeType.CapsuleShape Then
result = Mover.CollideCapsule(Me.Capsule, localMover)
ElseIf Me.Type = ShapeType.PolygonShape Then
result = Mover.CollidePolygon(Me.Polygon, localMover)
ElseIf Me.Type = ShapeType.SegmentShape Then
result = Mover.CollideSegment(Me.Segment, localMover)
ElseIf Me.Type = ShapeType.ChainSegmentShape Then
result = Mover.CollideSegment(Me.ChainSegment.Segment, localMover)
Else
Return New PlaneResult
End If
If result.Hit = False Then
Return result
End If
# Rotate the plane normal back into world space.
Var normal As Vector2 = result.Plane.Normal
Var worldNX As Double = transform.Q.C * normal.X - transform.Q.S * normal.Y
Var worldNY As Double = transform.Q.S * normal.X + transform.Q.C * normal.Y
result.Plane.Normal = New Vector2(worldNX, worldNY)
Return result
End Function
End Class

# Input for casting a shape along a translation, ported from upstream
# b2ShapeCastInput in collision.h. The proxy is owned: Make and MakeOffset
# deep-copy their inputs.
Class ShapeCastInput
## The shape being cast.
Property Proxy As ShapeProxy
## The translation of the shape cast.
Property Translation As Vector2
## The maximum fraction of the translation to consider, typically 1.
Property MaxFraction As Double
## Allow the shape cast to encroach when initially touching. This only
## works if the radius is greater than zero.
Property CanEncroach As Boolean

## Creates an empty input with identity translation and full fraction.
Constructor()
Me.Proxy = New ShapeProxy
Me.Translation = New Vector2(0.0, 0.0)
Me.MaxFraction = 1.0
Me.CanEncroach = False
End Constructor

## Builds the input from a point cloud, ported from upstream
## b2MakeShapeCastInput. This is a deep copy.
Shared Function Make(points() As Vector2, count As Integer, radius As Double, translation As Vector2, maxFraction As Double) As ShapeCastInput
Var input As New ShapeCastInput
input.Proxy = ShapeProxy.Make(points, count, radius)
input.Translation.Set(translation.X, translation.Y)
input.MaxFraction = maxFraction
Return input
End Function
End Class

# Input for casting shape B against shape A along a translation, ported
# from upstream b2ShapeCastPairInput in collision.h. Proxies and transforms
# are owned copies made by Make.
Class ShapeCastPairInput
## The proxy for shape A.
Property ProxyA As ShapeProxy
## The proxy for shape B.
Property ProxyB As ShapeProxy
## The world transform for shape A.
Property TransformA As Transform
## The world transform for shape B.
Property TransformB As Transform
## The translation of shape B.
Property TranslationB As Vector2
## The fraction of the translation to consider, typically 1.
Property MaxFraction As Double
## Allows shapes with a radius to move slightly closer if already touching.
Property CanEncroach As Boolean

## Creates an empty input with identity transforms and full fraction.
Constructor()
Me.ProxyA = New ShapeProxy
Me.ProxyB = New ShapeProxy
Me.TransformA = New Transform
Me.TransformB = New Transform
Me.TranslationB = New Vector2(0.0, 0.0)
Me.MaxFraction = 1.0
Me.CanEncroach = False
End Constructor

## Builds the pair input from two point clouds, ported from upstream
## b2MakeShapeCastPairInput. This is a deep copy.
Shared Function Make(pointsA() As Vector2, countA As Integer, radiusA As Double, pointsB() As Vector2, countB As Integer, radiusB As Double, transformA As Transform, transformB As Transform, translationB As Vector2, maxFraction As Double) As ShapeCastPairInput
Var input As New ShapeCastPairInput
input.ProxyA = ShapeProxy.Make(pointsA, countA, radiusA)
input.ProxyB = ShapeProxy.Make(pointsB, countB, radiusB)
input.TransformA.P.Set(transformA.P.X, transformA.P.Y)
input.TransformA.Q.SetComponents(transformA.Q.C, transformA.Q.S)
input.TransformB.P.Set(transformB.P.X, transformB.P.Y)
input.TransformB.Q.SetComponents(transformB.Q.C, transformB.Q.S)
input.TranslationB.Set(translationB.X, translationB.Y)
input.MaxFraction = maxFraction
Return input
End Function
End Class

# Shape definition passed to Body.CreateCircle and friends, ported from
# upstream b2ShapeDef in types.h. The constructor sets the same defaults as
# b2DefaultShapeDef.
Class ShapeDefinition
## Surface properties of the shape.
Property Material As SurfaceMaterial
## Shape density (kilograms per square metre). Zero produces no mass.
Property Density As Double
## Collision filter for this shape.
Property Filter As Filter
## User data owned by the application, copied to the created shape. Never read by the solver.
Property UserData As Object
## Whether this shape reports sensor events.
Property IsSensor As Boolean
## Whether this shape reports contact events.
Property EnableContactEvents As Boolean
## Whether this shape reports contact hit events.
Property EnableHitEvents As Boolean
## Whether this shape reports pre-solve events.
Property EnablePreSolveEvents As Boolean
## Whether this shape reports sensor events.
Property EnableSensorEvents As Boolean
## Whether pair creation is forced even when the other body is static.
## Sensors and chains force this implicitly.
Property InvokeContactCreation As Boolean
## Whether body mass data is recomputed after the shape is added.
Property UpdateBodyMass As Boolean

## Creates the default shape definition, matching upstream b2DefaultShapeDef.
Constructor()
Me.Material = New SurfaceMaterial()
Me.Density = 1.0
Me.Filter = New Filter()
Me.UserData = Nothing
Me.IsSensor = False
Me.EnableContactEvents = False
Me.EnableHitEvents = False
Me.EnablePreSolveEvents = False
Me.EnableSensorEvents = False
Me.InvokeContactCreation = True
Me.UpdateBodyMass = True
End Constructor
End Class

# Minimum and maximum shape extent relative to a local centre, ported from
# upstream b2ShapeExtent in shape.h. A plain record passed into and out of
# extent queries.
Class ShapeExtent
## Distance from the local centre to the closest shape surface, plus the
## shape radius for rounded shapes.
Property MinExtent As Double
## Distance from the local centre to the furthest shape point, plus the
## shape radius for rounded shapes.
Property MaxExtent As Double

## Creates a zeroed extent record.
Constructor()
Me.MinExtent = 0.0
Me.MaxExtent = 0.0
End Constructor
End Class

# One query hit record for the Into forms of the world queries. Point and
# normal are owned vectors set in place, so a warmed ShapeHitList reuses
# every record across queries without allocation.
Class ShapeHit
## The hit shape façade. Nothing when unused.
Property Shape As Shape
## World hit point.
Property Point As Vector2
## World surface normal.
Property Normal As Vector2
## Hit fraction along the cast translation.
Property Fraction As Double

## Creates an empty hit record.
Constructor()
Me.Shape = Nothing
Me.Point = New Vector2(0.0, 0.0)
Me.Normal = New Vector2(0.0, 0.0)
Me.Fraction = 0.0
End Constructor
End Class

# Growable, caller-owned hit list for the Into forms of the world queries.
# Clear resets the count but keeps every ShapeHit record, so a warmed list
# refilled by repeated queries allocates nothing.
Class ShapeHitList
## Number of valid hits in Items.
Property Count As Integer
## Hit storage. Only the first Count records are valid.
Property Hits As Array(Of ShapeHit)

## Creates an empty hit list.
Constructor()
Me.Count = 0
Me.Hits = New Array(Of ShapeHit)
End Constructor

## Resets the count to zero, retaining records and capacity for reuse.
Sub Clear()
Me.Count = 0
End Sub

## Pre-allocates storage for at least capacity records.
Sub Reserve(capacity As Integer)
While Me.Hits.Count < capacity
Me.Hits.Append(New ShapeHit)
Wend
End Sub

## Returns the record at index, growing storage when the list is being
## filled beyond its previous high-water mark.
Function Item(index As Integer) As ShapeHit
While index >= Me.Hits.Count
Me.Hits.Append(New ShapeHit)
Wend
Return Me.Hits[index]
End Function

## Appends a hit for the given shape and returns the reused record with its
## point, normal, and fraction cleared.
Function AddHit(shape As Shape) As ShapeHit
Var hit As ShapeHit = Me.Item(Me.Count)
hit.Shape = shape
hit.Point.Set(0.0, 0.0)
hit.Normal.Set(0.0, 0.0)
hit.Fraction = 0.0
Me.Count = Me.Count + 1
Return hit
End Function
End Class

# Distance proxy for the GJK algorithm, ported from upstream b2ShapeProxy in
# collision.h. A proxy is a point cloud of one to MAX_POLYGON_VERTICES points
# with an external radius.
#
# Make and MakeOffset deep-copy their inputs, following the upstream
# documentation.
Class ShapeProxy
## The point cloud. The array holds exactly Count vectors.
Property Points() As Vector2
## The number of points. Must be greater than zero after construction.
Property Count As Integer
## The external radius of the point cloud. May be zero.
Property Radius As Double

## Creates an empty proxy with zero radius. Use Make instead.
Constructor()
Me.Points = New Array(Of Vector2)
Me.Count = 0
Me.Radius = 0.0
End Constructor

## Builds a proxy from a point cloud, ported from upstream b2MakeProxy.
## This is a deep copy. Input beyond MAX_POLYGON_VERTICES points is clipped
## to the first MAX_POLYGON_VERTICES, matching upstream. Throws
## InvalidArgumentException when count is not positive.
Shared Function Make(points() As Vector2, count As Integer, radius As Double) As ShapeProxy
Return ShapeProxy.MakeImpl(points, count, radius, 0.0, 0.0, 1.0, 0.0)
End Function

## Builds a proxy from a point cloud with a position and rotation transform,
## ported from upstream b2MakeOffsetProxy. This is a deep copy.
Shared Function MakeOffset(points() As Vector2, count As Integer, radius As Double, position As Vector2, rotation As Rot) As ShapeProxy
Return ShapeProxy.MakeImpl(points, count, radius, position.X, position.Y, rotation.C, rotation.S)
End Function

## Refills an existing one-point proxy in place, for warm paths that
## would otherwise rebuild a tiny proxy every call. The point object held
## by the proxy is reused, so callers must not retain the point between
## calls.
Shared Sub MakeOnePointTo(out As ShapeProxy, x As Double, y As Double, radius As Double)
If out.Points.Count = 0 Then
out.Points.Append(New Vector2(x, y))
Else
out.Points[0].Set(x, y)
End If
out.Count = 1
out.Radius = radius
End Sub

## Shared implementation for Make and MakeOffset. For Make the offset is
## the identity, which reproduces the input exactly.
Shared Function MakeImpl(points() As Vector2, count As Integer, radius As Double, px As Double, py As Double, qc As Double, qs As Double) As ShapeProxy
If count <= 0 Then
Throw New InvalidArgumentException("ShapeProxy needs at least one point")
End If
If count > PhysicsConstants.MAX_POLYGON_VERTICES Then
count = PhysicsConstants.MAX_POLYGON_VERTICES
End If

Var proxy As New ShapeProxy
For i As Integer = 0 To count - 1
Var x As Double = qc * points[i].X - qs * points[i].Y + px
Var y As Double = qs * points[i].X + qc * points[i].Y + py
proxy.Points.Append(New Vector2(x, y))
Next i
proxy.Count = count
proxy.Radius = radius
Return proxy
End Function
End Class

# Kind of geometry stored in a shape, ported from upstream b2ShapeType in
# types.h. The numeric values match upstream so diagnostics and test fixtures
# can be compared directly.
Enum ShapeType
CapsuleShape
CircleShape
PolygonShape
SegmentShape
ChainSegmentShape
End Enum

# Simplex from the GJK algorithm, ported from upstream b2Simplex in
# collision.h. Holds up to three vertices. The solve and witness point logic
# lives in the Distance class to keep this a plain data holder.
Class Simplex
## First simplex vertex.
Property V1 As SimplexVertex
## Second simplex vertex.
Property V2 As SimplexVertex
## Third simplex vertex.
Property V3 As SimplexVertex
## Number of valid vertices, from zero to three.
Property Count As Integer

## Creates a simplex with three reusable vertices and zero count.
Constructor()
Me.V1 = New SimplexVertex
Me.V2 = New SimplexVertex
Me.V3 = New SimplexVertex
Me.Count = 0
End Constructor

## Returns the vertex at the zero-based index. Only indices below Count are
## valid during a solve.
Function VertexAt(index As Integer) As SimplexVertex
If index = 0 Then
Return Me.V1
ElseIf index = 1 Then
Return Me.V2
Else
Return Me.V3
End If
End Function
End Class

# Warm start cache for the GJK simplex, ported from upstream b2SimplexCache
# in collision.h. Repeated distance queries with nearby transforms can pass
# the previous cache to reduce iterations; otherwise leave it zeroed.
#
# The cache owns a lazily created internal simplex workspace so the hot
# distance path allocates nothing after the first call. The workspace is
# engine-internal state; callers treat the cache as count and indices only.
Class SimplexCache
## The number of stored simplex points, from zero to three.
Property Count As Integer
## The cached simplex indices on shape A.
Property IndexA() As Integer
## The cached simplex indices on shape B.
Property IndexB() As Integer

## Internal reusable simplex storage for the warm distance path.
Private Property mWorkspace As Simplex

## Creates an empty cache.
Constructor()
Me.Count = 0
Me.IndexA = New Array(Of Integer)
Me.IndexB = New Array(Of Integer)
For i As Integer = 0 To 2
Me.IndexA.Append(0)
Me.IndexB.Append(0)
Next i
Me.mWorkspace = Nothing
End Constructor

## Returns the internal simplex workspace, creating it on first use. Engine
## code only; allocating once per cache keeps warm distance queries
## allocation-free.
Function Workspace() As Simplex
If Me.mWorkspace = Nothing Then
Me.mWorkspace = New Simplex
End If
Return Me.mWorkspace
End Function

## Clears the cached indices so the next distance call starts cold.
Sub Clear()
Me.Count = 0
For i As Integer = 0 To 2
Me.IndexA[i] = 0
Me.IndexB[i] = 0
Next i
End Sub
End Class

# One GJK simplex vertex, ported from upstream b2SimplexVertex in
# collision.h. The w vectors are owned objects reused across iterations.
Class SimplexVertex
## Support point in proxy A.
Property WA As Vector2
## Support point in proxy B.
Property WB As Vector2
## The Minkowski difference WB - WA.
Property W As Vector2
## Barycentric coordinate for the closest point.
Property A As Double
## Index of the support point in proxy A.
Property IndexA As Integer
## Index of the support point in proxy B.
Property IndexB As Integer

## Creates a vertex with zero vectors and invalid barycentric weight.
Constructor()
Me.WA = New Vector2(0.0, 0.0)
Me.WB = New Vector2(0.0, 0.0)
Me.W = New Vector2(0.0, 0.0)
Me.A = -1.0
Me.IndexA = 0
Me.IndexB = 0
End Constructor

## Copies another vertex's fields in place and returns this vertex. Used by
## the simplex reduction paths.
Function SetFrom(other As SimplexVertex) As SimplexVertex
Me.WA.Set(other.WA.X, other.WA.Y)
Me.WB.Set(other.WB.X, other.WB.Y)
Me.W.Set(other.W.X, other.W.Y)
Me.A = other.A
Me.IndexA = other.IndexA
Me.IndexB = other.IndexB
Return Me
End Function
End Class

# Solver softness parameters, ported from upstream b2Softness in solver.h.
# The step computes these once per solver phase; the constraint kernels read
# them per constraint.
Class Softness
## Fraction of the separation error removed per substep.
Property BiasRate As Double
## Scales the effective mass used for the bias impulse.
Property MassScale As Double
## Fraction of the warm-start impulse re-applied each substep.
Property ImpulseScale As Double

## Creates a zeroed softness record.
Constructor()
Me.BiasRate = 0.0
Me.MassScale = 0.0
Me.ImpulseScale = 0.0
End Constructor

## Creates softness from explicit values.
Constructor(biasRate As Double, massScale As Double, impulseScale As Double)
Me.BiasRate = biasRate
Me.MassScale = massScale
Me.ImpulseScale = impulseScale
End Constructor

## Builds softness from spring frequency and damping ratio over substep h,
## ported from b2MakeSoft. Mass scale and impulse scale always sum to one.
Shared Function Make(hertz As Double, zeta As Double, h As Double) As Softness
Return Softness.MakeTo(hertz, zeta, h, New Softness)
End Function

## Writes softness from spring frequency and damping ratio over substep h
## into a caller-owned record, for allocation-free step setup.
Shared Function MakeTo(hertz As Double, zeta As Double, h As Double, out As Softness) As Softness
If hertz = 0.0 Then
out.BiasRate = 0.0
out.MassScale = 0.0
out.ImpulseScale = 0.0
Return out
End If
Var omega As Double = 6.283185307179586 * hertz
Var a1 As Double = 2.0 * zeta + h * omega
Var a2 As Double = h * omega * a1
Var a3 As Double = 1.0 / (1.0 + a2)
out.BiasRate = omega / a1
out.MassScale = a2 * a3
out.ImpulseScale = a3
Return out
End Function
End Class

# Constraint-solve pipeline loops, ported from the stage bodies of
# solver.c. The task/block/SIMD machinery collapses to sequential loops
# over the graph colours; the overflow colour runs first to match
# upstream's serial overflow work.
Class SolverMethods
## Prepares one colour's joint constraints, ported from b2PrepareJointsTask
## and b2PrepareOverflowJoints. Prepares every row; the family dispatch
## happens inside the kernel.
Shared Sub PrepareColourJoints(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
JointSolver.PrepareJoint(sims, i, context)
Next i
End Sub

## Warm starts one colour's joint constraints, ported from
## b2WarmStartJointsTask and b2WarmStartOverflowJoints.
Shared Sub WarmStartColourJoints(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
If sims.Type.Items[i] = Integer(JointType.DistanceJoint) Then
JointSolver.WarmStartDistanceJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MouseJoint) Then
JointSolver.WarmStartMouseJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MotorJoint) Then
JointSolver.WarmStartMotorJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.RevoluteJoint) Then
JointSolver.WarmStartRevoluteJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.PrismaticJoint) Then
JointSolver.WarmStartPrismaticJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.WeldJoint) Then
JointSolver.WarmStartWeldJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.WheelJoint) Then
JointSolver.WarmStartWheelJoint(sims, i, context)
End If
Next i
End Sub

## Runs one velocity iteration over one colour's joint constraints, ported
## from b2SolveJointsTask and b2SolveOverflowJoints. useBias enables the
## soft-step bias term.
Shared Sub SolveColourJoints(world As World, context As StepContext, colorIndex As Integer, useBias As Boolean)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
If sims.Type.Items[i] = Integer(JointType.DistanceJoint) Then
JointSolver.SolveDistanceJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.MouseJoint) Then
JointSolver.SolveMouseJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MotorJoint) Then
JointSolver.SolveMotorJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.RevoluteJoint) Then
JointSolver.SolveRevoluteJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.PrismaticJoint) Then
JointSolver.SolvePrismaticJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.WeldJoint) Then
JointSolver.SolveWeldJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.WheelJoint) Then
JointSolver.SolveWheelJoint(sims, i, context, useBias)
End If
Next i
End Sub

## Prepares one colour's contact constraints, growing the colour's scratch
## constraint array to cover its sims, ported from b2PrepareContactsTask.
Shared Sub PrepareColorContacts(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var count As Integer = color.ContactSims.Count()
Var constraints As Array(Of ContactConstraint) = color.Constraints
While constraints.Count < count
constraints.Append(New ContactConstraint)
Wend
color.ConstraintCount = count
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To count - 1
ContactSolver.PrepareContact(constraints[i], states, color.ContactSims, i, context.ContactSoftness, context.StaticSoftness, context.WarmStartScale)
Next i
End Sub

## Applies stored impulses to the body states for one colour, ported from
## b2WarmStartContactsTask.
Shared Sub WarmStartColorContacts(world As World, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.WarmStartContact(states, constraints[i])
Next i
End Sub

## Runs one velocity iteration over one colour, ported from
## b2SolveContactsTask. useBias enables the soft-step bias term.
Shared Sub SolveColorContacts(world As World, context As StepContext, colorIndex As Integer, useBias As Boolean)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.SolveContact(states, constraints[i], context.InvH, -context.ContactSpeed, useBias)
Next i
End Sub

## Applies restitution over one colour, ported from b2ApplyRestitutionTask.
Shared Sub ApplyColorRestitution(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.ApplyContactRestitution(states, constraints[i], context.RestitutionThreshold)
Next i
End Sub

## Copies accumulated impulses back into each colour's manifolds, ported
## from b2StoreImpulsesTask.
Shared Sub StoreColorImpulses(world As World, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.StoreImpulses(constraints[i], color.ContactSims.GetManifold(i))
Next i
End Sub

## Integrates gravity, forces, and damping into the awake body states,
## ported from b2IntegrateVelocitiesTask.
Shared Sub IntegrateVelocities(world As World, context As StepContext)
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
Var sims As BodySims = awakeSet.Sims
Var states As BodyStates = awakeSet.States
Var count As Integer = sims.Count()
Var h As Double = context.H
Var gravityX As Double = world.Gravity.X
Var gravityY As Double = world.Gravity.Y
Var maxLinearSpeed As Double = context.MaximumLinearVelocity
Var maxAngularSpeed As Double = PhysicsConstants.MAX_ROTATION * context.InvDt
Var maxLinearSpeedSquared As Double = maxLinearSpeed * maxLinearSpeed
Var maxAngularSpeedSquared As Double = maxAngularSpeed * maxAngularSpeed

For i As Integer = 0 To count - 1
Var vX As Double = states.LVX.Items[i]
Var vY As Double = states.LVY.Items[i]
Var w As Double = states.AngularVelocity.Items[i]

# Damping uses the Padé approximation of exponential decay.
Var linearDamping As Double = 1.0 / (1.0 + h * sims.LinearDamping.Items[i])
Var angularDamping As Double = 1.0 / (1.0 + h * sims.AngularDamping.Items[i])

# Gravity scale is zero for kinematic bodies via invMass.
Var gravityScale As Double = 0.0
If sims.InvMass.Items[i] > 0.0 Then
gravityScale = sims.GravityScale.Items[i]
End If

Var linearDeltaX As Double = h * sims.InvMass.Items[i] * sims.ForceX.Items[i] + h * gravityScale * gravityX
Var linearDeltaY As Double = h * sims.InvMass.Items[i] * sims.ForceY.Items[i] + h * gravityScale * gravityY
Var angularDelta As Double = h * sims.InvInertia.Items[i] * sims.Torque.Items[i]

vX = linearDeltaX + linearDamping * vX
vY = linearDeltaY + linearDamping * vY
w = angularDelta + angularDamping * w

If vX * vX + vY * vY > maxLinearSpeedSquared Then
Var ratio As Double = maxLinearSpeed / Maths.Sqrt(vX * vX + vY * vY)
vX = ratio * vX
vY = ratio * vY
sims.IsSpeedCapped.Items[i] = 1
End If

If w * w > maxAngularSpeedSquared And sims.AllowFastRotation.Items[i] = 0 Then
Var angularRatio As Double = maxAngularSpeed / Maths.Abs(w)
w = angularRatio * w
sims.IsSpeedCapped.Items[i] = 1
End If

states.LVX.Items[i] = vX
states.LVY.Items[i] = vY
states.AngularVelocity.Items[i] = w
Next i
End Sub

## Integrates the body states forward one substep, ported from
## b2IntegratePositionsTask. Delta position and rotation accumulate until
## body finalization.
Shared Sub IntegratePositions(world As World, context As StepContext)
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
Var count As Integer = states.LVX.Count
Var h As Double = context.H
For i As Integer = 0 To count - 1
Var deltaAngle As Double = h * states.AngularVelocity.Items[i]
Var c As Double = states.DRC.Items[i]
Var s As Double = states.DRS.Items[i]
Var nc As Double = c - deltaAngle * s
Var ns As Double = s + deltaAngle * c
Var mag As Double = Maths.Sqrt(ns * ns + nc * nc)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
states.DRC.Items[i] = nc * invMag
states.DRS.Items[i] = ns * invMag
states.DPX.Items[i] = states.DPX.Items[i] + h * states.LVX.Items[i]
states.DPY.Items[i] = states.DPY.Items[i] + h * states.LVY.Items[i]
Next i
End Sub
End Class

# Solver set, ported from upstream b2SolverSet in solver_set.h. Sets 0, 1,
# and 2 are the static, disabled, and awake sets; indices of 3 and above are
# per-island sleeping sets. The contact sim array holds all contacts of
# sleeping sets and the non-touching contacts of the awake set; touching
# awake contacts move into constraint-graph colours during the step.
# Joint sims follow the same split: awake joints live in graph colours.
Class SolverSet
## Index of this set in the world's solver set array.
Property SetIndex As Integer
## Dense body simulation state owned by this set.
Property Sims As BodySims
## Dense body velocity state owned by this set. Nothing for sets that never
## store states; that is every set except the awake set.
Property States As BodyStates
## Dense contact state owned by this set.
Property ContactSims As ContactSims
## Dense joint state owned by this set. Awake joints live in graph colours
## instead, so this store holds sleeping, static, and disabled joints.
Property JointSims As JointSims
## Ids of the islands that live in this set.
Property IslandIds As IntegerList

## Creates a solver set. hasStates selects whether velocity state is stored.
Constructor(setIndex As Integer, hasStates As Boolean)
Me.SetIndex = setIndex
Me.Sims = New BodySims()
If hasStates Then
Me.States = New BodyStates()
Else
Me.States = Nothing
End If
Me.ContactSims = New ContactSims()
Me.JointSims = New JointSims()
Me.IslandIds = New IntegerList()
End Constructor

## Returns the storage to its initial empty state. Capacity is retained so a
## warmed world rebuilds without allocation.
Sub ClearAll()
Me.Sims.ClearAll()
If Me.States <> Nothing Then
Me.States.ClearAll()
End If
Me.ContactSims.ClearAll()
Me.JointSims.ClearAll()
Me.IslandIds.Clear()
End Sub
End Class

# Per-step solver values, ported from upstream b2StepContext in solver.h.
# The world owns one scratch instance reused across steps so a warm step
# allocates nothing; the SIMD lane bookkeeping collapses in this port.
Class StepContext
## Full time step in seconds.
Property Dt As Double
## 1 / Dt.
Property InvDt As Double
## Substep length in seconds, Dt / SubStepCount.
Property H As Double
## 1 / H.
Property InvH As Double
## Number of substeps, at least one.
Property SubStepCount As Integer
## Softness for dynamic-dynamic contacts.
Property ContactSoftness As Softness
## Stiffer softness for contacts with a static body.
Property StaticSoftness As Softness
## Bias velocity limit derived from MaxContactPushSpeed.
Property ContactSpeed As Double
## Restitution velocities below this threshold are zeroed.
Property RestitutionThreshold As Double
## Clamp for integrated linear velocity.
Property MaximumLinearVelocity As Double
## 1.0 when warm starting is enabled, otherwise 0.0.
Property WarmStartScale As Double
## Fast bullet body sim indices collected during finalization.
Property BulletBodies As IntegerList
## Owning world, ported from context->world.
Property World As World
## Awake set body states, ported from context->states.
Property States As BodyStates
## Reusable distance joint solver scratch, one row per joint solve.
Property JointScratch As DistanceJointScratch
## Reusable softness target for joint prepare stages, ported from the
## stack-local b2MakeSoft results of b2PrepareJoint.
Property SoftnessScratch As Softness

## Creates a scratch context with reusable softness records.
Constructor()
Me.ContactSoftness = New Softness
Me.StaticSoftness = New Softness
Me.BulletBodies = New IntegerList
Me.World = Nothing
Me.States = Nothing
Me.JointScratch = New DistanceJointScratch
Me.SoftnessScratch = New Softness
End Constructor
End Class

# Surface properties of a shape or chain segment, ported from upstream
# b2SurfaceMaterial in types.h.
Class SurfaceMaterial
## Coefficient of friction.
Property Friction As Double
## Coefficient of restitution, clipped to the range zero to one by the solver.
Property Restitution As Double
## Rolling resistance for circles, spheres, capsules, and rounded polygons.
Property RollingResistance As Double
## Surface velocity applied along the contact tangent (metres per second).
Property TangentSpeed As Double
## User material identifier used by friction and restitution mixers.
Property UserMaterialId As Integer
## Debug-draw colour override. Zero means no override.
Property CustomColor As Integer

## Creates the default material, matching upstream b2DefaultSurfaceMaterial.
Constructor()
Me.Friction = 0.6
Me.Restitution = 0.0
Me.RollingResistance = 0.0
Me.TangentSpeed = 0.0
Me.UserMaterialId = 0
Me.CustomColor = 0
End Constructor

## Copies another material.
Constructor(other As SurfaceMaterial)
Me.Friction = other.Friction
Me.Restitution = other.Restitution
Me.RollingResistance = other.RollingResistance
Me.TangentSpeed = other.TangentSpeed
Me.UserMaterialId = other.UserMaterialId
Me.CustomColor = other.CustomColor
End Constructor

## Copies every field from other into this material and returns Me.
Function CopyFrom(other As SurfaceMaterial) As SurfaceMaterial
Me.Friction = other.Friction
Me.Restitution = other.Restitution
Me.RollingResistance = other.RollingResistance
Me.TangentSpeed = other.TangentSpeed
Me.UserMaterialId = other.UserMaterialId
Me.CustomColor = other.CustomColor
Return Me
End Function
End Class

# Motion of a body between two poses, used by time of impact, ported from
# upstream b2Sweep in collision.h.
#
# Shapes are defined relative to the body origin, which may not coincide with
# the centre of mass. The sweep stores the local centre of mass so interpolated
# transforms can shift the origin to the interpolated centre of mass position.
#
# Vector fields hold owned vectors; copy constructors deep-copy so sweeps can
# be assigned without aliasing.
Class Sweep
## Local centre of mass position.
Property LocalCenter As Vector2
## Starting centre of mass world position.
Property C1 As Vector2
## Ending centre of mass world position.
Property C2 As Vector2
## Starting world rotation.
Property Q1 As Rot
## Ending world rotation.
Property Q2 As Rot

## Creates a zero sweep with identity rotations.
Constructor()
Me.LocalCenter = New Vector2(0.0, 0.0)
Me.C1 = New Vector2(0.0, 0.0)
Me.C2 = New Vector2(0.0, 0.0)
Me.Q1 = New Rot(1.0, 0.0)
Me.Q2 = New Rot(1.0, 0.0)
End Constructor

## Copies another sweep.
Constructor(other As Sweep)
Me.LocalCenter = New Vector2(other.LocalCenter.X, other.LocalCenter.Y)
Me.C1 = New Vector2(other.C1.X, other.C1.Y)
Me.C2 = New Vector2(other.C2.X, other.C2.Y)
Me.Q1 = New Rot(other.Q1.C, other.Q1.S)
Me.Q2 = New Rot(other.Q2.C, other.Q2.S)
End Constructor

## Evaluates the transform sweep at a specific time in [0, 1] into a new
## transform, ported from upstream b2GetSweepTransform.
Shared Function GetTransform(motion As Sweep, time As Double) As Transform
Var result As New Transform
Sweep.GetTransformTo(motion, time, result)
Return result
End Function

## Evaluates the transform sweep at a specific time into the caller-owned
## out transform and returns out. The reused-output form for warm loops.
## The time is expected in [0, 1]; values outside interpolate linearly the
## same way upstream does.
Shared Function GetTransformTo(motion As Sweep, time As Double, out As Transform) As Transform
Var omt As Double = 1.0 - time
out.P.Set(omt * motion.C1.X + time * motion.C2.X, omt * motion.C1.Y + time * motion.C2.Y)
out.Q.C = omt * motion.Q1.C + time * motion.Q2.C
out.Q.S = omt * motion.Q1.S + time * motion.Q2.S
Rot.NormalizeTo(out.Q, out.Q)

# Shift to origin.
Var rx As Double = out.Q.C * motion.LocalCenter.X - out.Q.S * motion.LocalCenter.Y
Var ry As Double = out.Q.S * motion.LocalCenter.X + out.Q.C * motion.LocalCenter.Y
out.P.Set(out.P.X - rx, out.P.Y - ry)
Return out
End Function
End Class

# Input parameters for a time-of-impact computation, ported from upstream
# b2TOIInput in collision.h.
#
# Make deep-copies the proxies; the sweeps are copied on construction.
Class TOIInput
## The proxy for shape A.
Property ProxyA As ShapeProxy
## The proxy for shape B.
Property ProxyB As ShapeProxy
## The movement of shape A.
Property SweepA As Sweep
## The movement of shape B.
Property SweepB As Sweep
## Defines the sweep interval [0, MaxFraction].
Property MaxFraction As Double

## Creates an empty input with identity sweeps and full fraction.
Constructor()
Me.ProxyA = New ShapeProxy
Me.ProxyB = New ShapeProxy
Me.SweepA = New Sweep
Me.SweepB = New Sweep
Me.MaxFraction = 1.0
End Constructor

## Builds the input from two point clouds and sweeps, ported from upstream
## b2MakeTOIInput? No such upstream factory; this helper mirrors the other
## Make helpers for convenience and deep-copies its inputs.
Shared Function Make(pointsA() As Vector2, countA As Integer, radiusA As Double, sweepA As Sweep, pointsB() As Vector2, countB As Integer, radiusB As Double, sweepB As Sweep, maxFraction As Double) As TOIInput
Var input As New TOIInput
input.ProxyA = ShapeProxy.Make(pointsA, countA, radiusA)
input.ProxyB = ShapeProxy.Make(pointsB, countB, radiusB)
input.SweepA = New Sweep
input.SweepA.LocalCenter.Set(sweepA.LocalCenter.X, sweepA.LocalCenter.Y)
input.SweepA.C1.Set(sweepA.C1.X, sweepA.C1.Y)
input.SweepA.C2.Set(sweepA.C2.X, sweepA.C2.Y)
input.SweepA.Q1.SetComponents(sweepA.Q1.C, sweepA.Q1.S)
input.SweepA.Q2.SetComponents(sweepA.Q2.C, sweepA.Q2.S)
input.SweepB = New Sweep
input.SweepB.LocalCenter.Set(sweepB.LocalCenter.X, sweepB.LocalCenter.Y)
input.SweepB.C1.Set(sweepB.C1.X, sweepB.C1.Y)
input.SweepB.C2.Set(sweepB.C2.X, sweepB.C2.Y)
input.SweepB.Q1.SetComponents(sweepB.Q1.C, sweepB.Q1.S)
input.SweepB.Q2.SetComponents(sweepB.Q2.C, sweepB.Q2.S)
input.MaxFraction = maxFraction
Return input
End Function
End Class

# Output parameters for a time-of-impact computation, ported from upstream
# b2TOIOutput in collision.h.
#
# The To-form of TimeOfImpact reuses the scratch workspace attached here, so
# repeated TOI queries allocate nothing.
Class TOIOutput
## The type of result.
Property State As TOIState
## The sweep time of the collision.
Property Fraction As Double

## Internal reusable workspace for the warm TOI path.
Private Property mScratch As TOIScratch

## Creates an unknown output with full fraction.
Constructor()
Me.State = TOIState.Unknown
Me.Fraction = 1.0
Me.mScratch = Nothing
End Constructor

## Returns the internal workspace, creating it on first use. Engine code
## only; creating the workspace once per output keeps warm TOI queries
## allocation-free.
Function Scratch() As TOIScratch
If Me.mScratch = Nothing Then
Me.mScratch = New TOIScratch
End If
Return Me.mScratch
End Function
End Class

# Engine-internal reusable workspace for the warm time-of-impact path.
# Owned by a TOIOutput and created lazily. Not part of the public engine
# surface.
Class TOIScratch
## Distance input reused across outer iterations. Its proxies alias the TOI
## input's proxies and its transforms alias the scratch transforms.
Property DistanceInput As DistanceInput
## Distance output reused across outer iterations.
Property DistanceOutput As DistanceOutput
## Warm start cache reused across outer iterations and calls. Cleared at
## the start of every computation.
Property Cache As SimplexCache
## Transform A evaluated at the current sweep time.
Property TransformA As Transform
## Transform B evaluated at the current sweep time.
Property TransformB As Transform
## The separating axis function rebuilt per outer iteration.
Property Separation As SeparationFunction

## Creates the workspace with empty storage.
Constructor()
Me.DistanceInput = New DistanceInput
Me.DistanceOutput = New DistanceOutput
Me.Cache = New SimplexCache
Me.TransformA = New Transform
Me.TransformB = New Transform
Me.Separation = New SeparationFunction
End Constructor
End Class

# Result states for a time-of-impact computation, ported from upstream
# b2TOIState in collision.h.
Enum TOIState
Unknown
Failed
Overlapped
Hit
Separated
End Enum

# Continuous collision via the local separating axis method, ported from
# upstream b2TimeOfImpact in distance.c. This seeks progression by computing
# the largest time at which separation is maintained.
#
# The warm To-form reuses the distance and separation workspaces attached to
# the caller's TOIOutput, so steady-state queries allocate nothing.
Class TimeOfImpact
## Computes the upper bound on time before two shapes penetrate into a new
## output. Time is a fraction in [0, MaxFraction]. This uses a swept
## separating axis and may miss some intermediate, non-tunnelling
## collisions. If the time interval changes, call again.
Shared Function Compute(input As TOIInput) As TOIOutput
Var out As New TOIOutput
TimeOfImpact.ComputeTo(input, out)
Return out
End Function

## Computes the upper bound on time before two shapes penetrate into the
## caller-owned out output and returns out. The reused-output form for warm
## loops.
Shared Function ComputeTo(input As TOIInput, out As TOIOutput) As TOIOutput
out.State = TOIState.Unknown
out.Fraction = input.MaxFraction

Var proxyA As ShapeProxy = input.ProxyA
Var proxyB As ShapeProxy = input.ProxyB

Var tMax As Double = input.MaxFraction

Var totalRadius As Double = proxyA.Radius + proxyB.Radius
Var target As Double = PhysicsConstants.LINEAR_SLOP
If totalRadius - PhysicsConstants.LINEAR_SLOP > target Then
target = totalRadius - PhysicsConstants.LINEAR_SLOP
End If
Var tolerance As Double = 0.25 * PhysicsConstants.LINEAR_SLOP

Var t1 As Double = 0.0
Var maxIterations As Integer = 20
Var distanceIterations As Integer = 0

# Prepare the reusable distance query.
Var scratch As TOIScratch = out.Scratch()
Var distanceInput As DistanceInput = scratch.DistanceInput
distanceInput.ProxyA = proxyA
distanceInput.ProxyB = proxyB
distanceInput.UseRadii = False
Var cache As SimplexCache = scratch.Cache
cache.Clear()

# The outer loop progressively attempts to compute new separating axes.
# This loop terminates when an axis is repeated, making no progress.
Var done As Boolean = False
While Not done
Sweep.GetTransformTo(input.SweepA, t1, scratch.TransformA)
Sweep.GetTransformTo(input.SweepB, t1, scratch.TransformB)
distanceInput.TransformA = scratch.TransformA
distanceInput.TransformB = scratch.TransformB
Var distanceOutput As DistanceOutput = scratch.DistanceOutput
Distance.ShapeDistanceTo(distanceInput, cache, distanceOutput)

distanceIterations = distanceIterations + 1

# If the shapes are overlapped, give up on continuous collision.
If distanceOutput.Distance <= 0.0 Then
# Failure.
out.State = TOIState.Overlapped
out.Fraction = 0.0
done = True
End If

If Not done And distanceOutput.Distance <= target + tolerance Then
# Victory.
out.State = TOIState.Hit
out.Fraction = t1
done = True
End If

If Not done Then
# Initialise the separating axis and resolve the TOI on it.
Var fcn As SeparationFunction = out.Scratch().Separation
fcn.Setup(cache, proxyA, input.SweepA, proxyB, input.SweepB, t1)
t1 = TimeOfImpact.PushBack(fcn, tMax, t1, target, tolerance, out)
done = out.State <> TOIState.Unknown
End If

If Not done And distanceIterations = maxIterations Then
# The root finder got stuck. Semi-victory.
out.State = TOIState.Failed
out.Fraction = t1
done = True
End If
Wend

Return out
End Function

## Advances the swept separating axis by successively resolving the deepest
## point, ported from the inner loop of upstream b2TimeOfImpact. Returns
## the new sweep time. A still-unknown output state means the caller should
## loop again; otherwise the output holds the verdict.
Shared Function PushBack(fcn As SeparationFunction, tMax As Double, t1 As Double, target As Double, tolerance As Double, out As TOIOutput) As Double
Var t2 As Double = tMax
Var pushBackIterations As Integer = 0
While pushBackIterations < PhysicsConstants.MAX_POLYGON_VERTICES
# Find the deepest point at t2 and store the witness point indices.
Var minResult As SeparationResult = fcn.FindMinSeparation(t2)
Var s2 As Double = minResult.Separation

# Is the final configuration separated?
If s2 > target + tolerance Then
# Victory.
out.State = TOIState.Separated
out.Fraction = tMax
Return t1
End If

# Has the separation reached tolerance?
If s2 > target - tolerance Then
# Advance the sweeps.
Return t2
End If

# Compute the initial separation of the witness points.
Var s1 As Double = fcn.EvaluateSeparation(minResult.IndexA, minResult.IndexB, t1)

# Check for initial overlap. This might happen if the root finder runs
# out of iterations.
If s1 < target - tolerance Then
out.State = TOIState.Failed
out.Fraction = t1
Return t1
End If

# Check for touching.
If s1 <= target + tolerance Then
# Victory. t1 holds the TOI, possibly zero.
out.State = TOIState.Hit
out.Fraction = t1
Return t1
End If

# Compute the one-dimensional root of f(x) - target = 0 with a mix of
# the secant rule and bisection.
Var rootIterationCount As Integer = 0
Var a1 As Double = t1
Var a2 As Double = t2
While rootIterationCount < 50
Var t As Double = 0.0
If rootIterationCount Mod 2 = 1 Then
# Secant rule to improve convergence.
t = a1 + (target - s1) * (a2 - a1) / (s2 - s1)
Else
# Bisection to guarantee progress.
t = 0.5 * (a1 + a2)
End If

rootIterationCount = rootIterationCount + 1

Var s As Double = fcn.EvaluateSeparation(minResult.IndexA, minResult.IndexB, t)

If Maths.Abs(s - target) < tolerance Then
# t2 holds a tentative value for t1.
t2 = t
Exit While
End If

# Keep bracketing the root.
If s > target Then
a1 = t
s1 = s
Else
a2 = t
s2 = s
End If
Wend

pushBackIterations = pushBackIterations + 1
Wend

Return t1
End Function
End Class

# Rigid transform: rotation plus translation, ported from upstream b2Transform
# in math_functions.h. Transforms convert points between local and world
# frames.
#
# The P and Q properties are reference objects owned by the transform. Helpers
# that fill a caller-owned vector (the To-forms) never alias caller state;
# helpers that return a vector allocate a new one.
Class Transform
## The translation part of the transform.
Property P As Vector2
## The rotation part of the transform.
Property Q As Rot

## Creates the identity transform.
Constructor()
Me.P = New Vector2(0.0, 0.0)
Me.Q = New Rot(1.0, 0.0)
End Constructor

## Creates a transform from a position and rotation. Both are copied, so
## later edits to the arguments do not change the transform.
Constructor(p As Vector2, q As Rot)
Me.P = New Vector2(p.X, p.Y)
Me.Q = New Rot(q.C, q.S)
End Constructor

## Copies another transform.
Constructor(t As Transform)
Me.P = New Vector2(t.P.X, t.P.Y)
Me.Q = New Rot(t.Q.C, t.Q.S)
End Constructor

## Returns a new identity transform.
Shared Function Identity() As Transform
Return New Transform
End Function

## Multiplies two transforms, ported from upstream b2MulTransforms. Applying
## the result to a point local to frame B converts it to frame A's frame and
## then to the world frame.
Shared Function Mul(a As Transform, b As Transform) As Transform
Var result As New Transform
result.Q = Rot.Mul(a.Q, b.Q)
Rot.RotateVectorTo(a.Q, b.P, result.P)
result.P.Add(a.P)
Return result
End Function

## Creates the transform that converts a local point in frame B to a local
## point in frame A, ported from upstream b2InvMulTransforms.
Shared Function InvMul(a As Transform, b As Transform) As Transform
Var result As New Transform
result.Q = Rot.InvMul(a.Q, b.Q)
Var dx As Double = b.P.X - a.P.X
Var dy As Double = b.P.Y - a.P.Y
result.P.Set(a.Q.C * dx + a.Q.S * dy, -a.Q.S * dx + a.Q.C * dy)
Return result
End Function

## Transforms a point into a new vector, ported from upstream
## b2TransformPoint.
Shared Function TransformPoint(t As Transform, p As Vector2) As Vector2
Return New Vector2(t.Q.C * p.X - t.Q.S * p.Y + t.P.X, t.Q.S * p.X + t.Q.C * p.Y + t.P.Y)
End Function

## Transforms a point into the caller-owned out vector and returns out. The
## reused-output form for warm loops.
Shared Function TransformPointTo(t As Transform, p As Vector2, out As Vector2) As Vector2
Return out.Set(t.Q.C * p.X - t.Q.S * p.Y + t.P.X, t.Q.S * p.X + t.Q.C * p.Y + t.P.Y)
End Function

## Inverse-transforms a point into a new vector, ported from upstream
## b2InvTransformPoint.
Shared Function InvTransformPoint(t As Transform, p As Vector2) As Vector2
Var vx As Double = p.X - t.P.X
Var vy As Double = p.Y - t.P.Y
Return New Vector2(t.Q.C * vx + t.Q.S * vy, -t.Q.S * vx + t.Q.C * vy)
End Function

## Inverse-transforms a point into the caller-owned out vector and returns
## out. The reused-output form for warm loops.
Shared Function InvTransformPointTo(t As Transform, p As Vector2, out As Vector2) As Vector2
Var vx As Double = p.X - t.P.X
Var vy As Double = p.Y - t.P.Y
Return out.Set(t.Q.C * vx + t.Q.S * vy, -t.Q.S * vx + t.Q.C * vy)
End Function
End Class

# A node in the dynamic bounding volume tree, ported from upstream
# b2TreeNode in dynamic_tree.c. Node objects are pooled: allocated nodes
# form the tree and free nodes chain through Parent acting as the free-list
# next index, exactly like upstream.
#
# An internal node uses Child1 and Child2; a leaf node uses UserData and
# keeps Child1/Child2 at the null sentinel. Bounds is owned by the node and
# mutated in place so warm tree code never allocates.
#
# Flag constants mirror the upstream node flag enum: AllocatedFlag = 1,
# EnlargedFlag = 2, LeafFlag = 4.
Class TreeNode
## The node bounding box, owned and mutated in place.
Property Bounds As AABB
## Union of the category bits of all leaves below the node.
Property CategoryBits As Integer
## First child index for an internal node, or the null sentinel for a leaf.
Property Child1 As Integer
## Second child index for an internal node, or the null sentinel for a leaf.
Property Child2 As Integer
## Client data carried by a leaf node, typically a shape index.
Property UserData As Integer
## Parent index for an allocated node, or the free-list next index for a
## free node.
Property Parent As Integer
## Height of the subtree rooted here; leaves have height 0.
Property Height As Integer
## Combination of the AllocatedFlag, EnlargedFlag, and LeafFlag bits.
Property Flags As Integer

## Flag bit marking a node that belongs to the node pool.
Shared Const AllocatedFlag As Integer = 1

## Flag bit marking a node whose bounds were enlarged without a rebuild.
Shared Const EnlargedFlag As Integer = 2

## Flag bit marking a leaf node.
Shared Const LeafFlag As Integer = 4

## Creates a node with the upstream default node layout: allocated, internal,
## unlinked, with default category bits.
Constructor()
Me.Bounds = New AABB
Me.Reset()
End Constructor

## Restores the upstream default node layout in place, mirroring the
## b2_defaultTreeNode copy in b2AllocateNode. Child links and the parent
## pointer become the null sentinel, height becomes 0, and only the
## allocated flag is set.
Sub Reset()
Me.Bounds.LowerBound.Set(0.0, 0.0)
Me.Bounds.UpperBound.Set(0.0, 0.0)
Me.CategoryBits = PhysicsConstants.DEFAULT_CATEGORY_BITS
Me.Child1 = PhysicsConstants.NULL_INDEX
Me.Child2 = PhysicsConstants.NULL_INDEX
Me.UserData = 0
Me.Parent = PhysicsConstants.NULL_INDEX
Me.Height = 0
Me.Flags = TreeNode.AllocatedFlag
End Sub

## Returns True when this node is a leaf.
Function IsLeaf() As Boolean
Return (Me.Flags.BitAnd(TreeNode.LeafFlag)) <> 0
End Function

## Returns True when this node belongs to the node pool.
Function IsAllocated() As Boolean
Return (Me.Flags.BitAnd(TreeNode.AllocatedFlag)) <> 0
End Function

## Returns True when an ancestor recomputation has enlarged this node's
## bounds since the last rebuild.
Function IsEnlarged() As Boolean
Return (Me.Flags.BitAnd(TreeNode.EnlargedFlag)) <> 0
End Function
End Class

# Client callback receiving the leaves of a dynamic tree box query, ported
# from upstream b2TreeQueryCallbackFcn. Return True to continue traversal or
# False to stop it early.
Abstract Class TreeQueryCallback
## Called for every overlapping leaf. Returning True continues the query;
## False terminates it with the stats gathered so far.
Abstract Function VisitLeaf(proxyId As Integer, userData As Integer) As Boolean
End Class

# Client callback receiving the leaves of a dynamic tree ray cast, ported
# from upstream b2TreeRayCastCallbackFcn.
#
# The input passed to VisitLeaf is a tree-owned scratch object whose
# MaxFraction changes between leaves; callbacks must read it during the call
# and must not retain it.
#
# Return values follow upstream: 0 terminates the cast, -1 skips the leaf,
# and any value in (0, current max fraction] becomes the new max fraction.
Abstract Class TreeRayCastCallback
## Called for every candidate leaf. Returns 0 to terminate the cast, -1 to
## skip the leaf, or a fraction in (0, maxFraction] to narrow the cast.
Abstract Function VisitLeaf(input As RayCastInput, proxyId As Integer, userData As Integer) As Double
End Class

# Engine-internal reusable workspace for dynamic tree traversals and
# rebuilds. Owned by a DynamicTree and created lazily. Not part of the
# public engine surface.
#
# The traversal stack is reused across queries, so tree queries are not
# reentrant: a callback must not query the same tree.
Class TreeScratch
## Traversal stack shared by query, ray cast, and shape cast.
Property Stack As IntegerList
## Ray cast input copy handed to ray cast callbacks between leaves.
Property RayInput As RayCastInput
## Shape cast input copy handed to shape cast callbacks between leaves.
Property CastInput As ShapeCastInput
## Segment bounds reused by the ray cast traversal.
Property SegmentBounds As AABB
## Cast shape start bounds reused by the shape cast traversal.
Property OriginBounds As AABB
## Total swept bounds reused by the shape cast traversal.
Property TotalBounds As AABB
## Node bounds reused while reading tree AABBs during traversals.
Property NodeBounds As AABB
## Rebuild work item node indices, parallel to the other rebuild stacks.
Property RebuildNodeIndex As IntegerList
## Rebuild work item child counters, parallel to the other rebuild stacks.
Property RebuildChildCount As IntegerList
## Rebuild work item range starts, parallel to the other rebuild stacks.
Property RebuildStartIndex As IntegerList
## Rebuild work item range splits, parallel to the other rebuild stacks.
Property RebuildSplitIndex As IntegerList
## Rebuild work item range ends, parallel to the other rebuild stacks.
Property RebuildEndIndex As IntegerList
## Leaf indices gathered by Rebuild and partitioned by BuildTree.
Property LeafIndices As IntegerList
## Leaf centre x coordinates, parallel to LeafIndices.
Property LeafCentersX As DoubleList
## Leaf centre y coordinates, parallel to LeafIndices.
Property LeafCentersY As DoubleList
## Best sibling found so far by the greedy sibling search.
Property SiblingBest As Integer
## Cost of the best sibling found so far.
Property SiblingBestCost As Double
## Perimeter of the subtree root being descended during the sibling search.
Property SiblingAreaBase As Double
## Inflation cost of the subtree root being descended.
Property SiblingDirectCost As Double
## Resolved descent cost of child 1 after tie-breaking.
Property SiblingLowerCost1 As Double
## Resolved descent cost of child 2 after tie-breaking.
Property SiblingLowerCost2 As Double

## Creates the workspace with empty storage sized for the default traversal.
Constructor()
Me.Stack = New IntegerList(256)
Me.RayInput = New RayCastInput
Me.CastInput = New ShapeCastInput
Me.SegmentBounds = New AABB
Me.OriginBounds = New AABB
Me.TotalBounds = New AABB
Me.NodeBounds = New AABB
Me.RebuildNodeIndex = New IntegerList(64)
Me.RebuildChildCount = New IntegerList(64)
Me.RebuildStartIndex = New IntegerList(64)
Me.RebuildSplitIndex = New IntegerList(64)
Me.RebuildEndIndex = New IntegerList(64)
Me.LeafIndices = New IntegerList(64)
Me.LeafCentersX = New DoubleList(64)
Me.LeafCentersY = New DoubleList(64)
Me.SiblingBest = 0
Me.SiblingBestCost = 0.0
Me.SiblingAreaBase = 0.0
Me.SiblingDirectCost = 0.0
Me.SiblingLowerCost1 = 0.0
Me.SiblingLowerCost2 = 0.0
End Constructor
End Class

# Client callback receiving the leaves of a dynamic tree shape cast, ported
# from upstream b2TreeShapeCastCallbackFcn.
#
# The input passed to VisitLeaf is a tree-owned scratch object whose
# MaxFraction changes between leaves; callbacks must read it during the call
# and must not retain it.
#
# Return values follow upstream: 0 terminates the cast, -1 skips the leaf,
# and any value in (0, current max fraction) becomes the new max fraction.
Abstract Class TreeShapeCastCallback
## Called for every candidate leaf. Returns 0 to terminate the cast, -1 to
## skip the leaf, or a fraction in (0, maxFraction) to narrow the cast.
Abstract Function VisitLeaf(input As ShapeCastInput, proxyId As Integer, userData As Integer) As Double
End Class

# Traversal counters for a dynamic tree query, ray cast, or shape cast,
# ported from upstream b2TreeStats in collision.h. Node visits count every
# node popped from the traversal stack; leaf visits count leaf callbacks.
# Query results also fold these counters into the tree quality baselines
# recorded by the benchmarks.
Class TreeStats
## Number of tree nodes examined by the traversal.
Property NodeVisits As Integer
## Number of leaves passed to the client callback.
Property LeafVisits As Integer

## Creates zeroed counters.
Constructor()
Me.Reset()
End Constructor

## Resets both counters to zero without allocating.
Sub Reset()
Me.NodeVisits = 0
Me.LeafVisits = 0
End Sub

## Copies the counters from another stats object without allocating.
Sub SetFrom(other As TreeStats)
Me.NodeVisits = other.NodeVisits
Me.LeafVisits = other.LeafVisits
End Sub
End Class

# Public weld joint façade, ported from the b2WeldJoint_* surface in
# weld_joint.c. The weld rigidly connects two bodies at one point and
# angle; nonzero hertz values soften the weld so it can flex under load.
# Tuning setters throw where upstream asserts (finite and non-negative)
# and changes deliberately do not wake the bodies, matching upstream; the
# solver picks up new values on the next step. The façade reads and writes
# its row in the owning JointSims store.
Class WeldJoint Inherits Joint
## Linear stiffness in hertz, ported from b2WeldJoint_SetLinearHertz.
## Negative or non-finite values throw where upstream asserts. Zero means
## maximum stiffness. Changes apply from the next step and do not wake the
## bodies.
Sub SetLinearHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not hertz.IsFinite() Or hertz < 0.0 Then
Throw New InvalidArgumentException("Weld joint linear hertz must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).WeldLinearHertz.Items[Me.LocalIndex] = hertz
End Sub

## Linear stiffness in hertz, ported from b2WeldJoint_GetLinearHertz.
Function GetLinearHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldLinearHertz.Items[Me.LocalIndex]
End Function

## Linear damping ratio, ported from b2WeldJoint_SetLinearDampingRatio.
## Negative or non-finite values throw where upstream asserts.
Sub SetLinearDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not dampingRatio.IsFinite() Or dampingRatio < 0.0 Then
Throw New InvalidArgumentException("Weld joint linear damping ratio must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).WeldLinearDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Linear damping ratio, ported from b2WeldJoint_GetLinearDampingRatio.
Function GetLinearDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldLinearDampingRatio.Items[Me.LocalIndex]
End Function

## Angular stiffness in hertz, ported from b2WeldJoint_SetAngularHertz.
## Negative or non-finite values throw where upstream asserts. Zero means
## maximum stiffness. Changes apply from the next step and do not wake the
## bodies.
Sub SetAngularHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not hertz.IsFinite() Or hertz < 0.0 Then
Throw New InvalidArgumentException("Weld joint angular hertz must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).WeldAngularHertz.Items[Me.LocalIndex] = hertz
End Sub

## Angular stiffness in hertz, ported from b2WeldJoint_GetAngularHertz.
Function GetAngularHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldAngularHertz.Items[Me.LocalIndex]
End Function

## Angular damping ratio, ported from b2WeldJoint_SetAngularDampingRatio.
## Negative or non-finite values throw where upstream asserts.
Sub SetAngularDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not dampingRatio.IsFinite() Or dampingRatio < 0.0 Then
Throw New InvalidArgumentException("Weld joint angular damping ratio must be finite and non-negative")
End If
Me.Owner.GetJointSims(Me).WeldAngularDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Angular damping ratio, ported from b2WeldJoint_GetAngularDampingRatio.
Function GetAngularDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldAngularDampingRatio.Items[Me.LocalIndex]
End Function

## The constrained reference angle in radians, ported from
## b2Joint_GetReferenceAngle for the weld family.
Override Function GetReferenceAngle() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldReferenceAngle.Items[Me.LocalIndex]
End Function
End Class

# Weld joint definition, ported from upstream b2WeldJointDef and
# b2DefaultWeldJointDef in types.h and joint.c. Defaults match upstream:
# coincident anchors, zero reference angle, zero hertz for maximum
# stiffness, and zero damping ratios. A weld joint rigidly connects two
# bodies at one point and angle; nonzero hertz values soften the weld.
Class WeldJointDefinition
## First attached body, ported from b2WeldJointDef.bodyIdA.
Property BodyA As Body
## Second attached body, ported from b2WeldJointDef.bodyIdB.
Property BodyB As Body
## Local anchor point relative to body A's origin, in metres.
Property LocalAnchorA As Vector2
## Local anchor point relative to body B's origin, in metres.
Property LocalAnchorB As Vector2
## Body B angle minus body A angle in the reference state, in radians.
Property ReferenceAngle As Double
## Linear stiffness in hertz. Zero means maximum stiffness: the solver
## falls back to the base constraint softness.
Property LinearHertz As Double
## Angular stiffness in hertz. Zero means maximum stiffness: the solver
## falls back to the base constraint softness.
Property AngularHertz As Double
## Linear damping ratio, non-dimensional. Use 1 for critical damping.
Property LinearDampingRatio As Double
## Angular damping ratio, non-dimensional. Use 1 for critical damping.
Property AngularDampingRatio As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LocalAnchorA = New Vector2(0.0, 0.0)
Me.LocalAnchorB = New Vector2(0.0, 0.0)
Me.ReferenceAngle = 0.0
Me.LinearHertz = 0.0
Me.AngularHertz = 0.0
Me.LinearDampingRatio = 0.0
Me.AngularDampingRatio = 0.0
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# Public wheel joint façade, ported from the b2WheelJoint_* surface in
# wheel_joint.c. The joint lets a wheel rotate freely about its anchor
# while a suspension spring, translation limits, and a drive motor act on
# the slide along one axis. Tuning changes deliberately do not wake the
# bodies, matching upstream; the solver picks up new values on the next
# step. Enabling or disabling the spring, limits, or motor clears the
# corresponding accumulated impulses exactly like the upstream toggles.
# Setters store plain values where upstream stores plain values and throw
# where upstream asserts. The façade reads and writes its row in the
# owning JointSims store.
Class WheelJoint Inherits Joint
## Enables the suspension spring, ported from b2WheelJoint_EnableSpring.
## Toggling clears the accumulated spring impulse.
Sub EnableSpring(enableSpring As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableSpring Then
flag = 1
End If
If flag <> store.EnableSpring.Items[Me.LocalIndex] Then
store.EnableSpring.Items[Me.LocalIndex] = flag
store.WheelSpringImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the suspension spring is active, ported from
## b2WheelJoint_IsSpringEnabled.
Function IsSpringEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableSpring.Items[Me.LocalIndex] <> 0
End Function

## Suspension spring stiffness in hertz, ported from
## b2WheelJoint_SetSpringHertz. Changes apply from the next step.
Sub SetSpringHertz(hertz As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).WheelHertz.Items[Me.LocalIndex] = hertz
End Sub

## Suspension spring stiffness in hertz, ported from
## b2WheelJoint_GetSpringHertz.
Function GetSpringHertz() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelHertz.Items[Me.LocalIndex]
End Function

## Suspension spring damping ratio, ported from
## b2WheelJoint_SetSpringDampingRatio. Changes apply from the next step.
Sub SetSpringDampingRatio(dampingRatio As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).WheelDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Suspension spring damping ratio, ported from
## b2WheelJoint_GetSpringDampingRatio.
Function GetSpringDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelDampingRatio.Items[Me.LocalIndex]
End Function

## Current suspension translation in metres along the axis, ported from
## b2WheelJoint_GetTranslation. Allocates the returned query vectors.
Function GetTranslation() As Double
Me.CheckValid()
Var bodyA As Body = Me.GetBodyA()
Var bodyB As Body = Me.GetBodyB()
Var transformA As Transform = Me.Owner.GetBodyTransform(bodyA)
Var transformB As Transform = Me.Owner.GetBodyTransform(bodyB)
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var axisX As Double = transformA.Q.C * store.WheelLocalAxisX.Items[Me.LocalIndex] - transformA.Q.S * store.WheelLocalAxisY.Items[Me.LocalIndex]
Var axisY As Double = transformA.Q.S * store.WheelLocalAxisX.Items[Me.LocalIndex] + transformA.Q.C * store.WheelLocalAxisY.Items[Me.LocalIndex]
Var localA As Vector2 = Me.GetLocalAnchorA()
Var localB As Vector2 = Me.GetLocalAnchorB()
Var pAX As Double = transformA.P.X + transformA.Q.C * localA.X - transformA.Q.S * localA.Y
Var pAY As Double = transformA.P.Y + transformA.Q.S * localA.X + transformA.Q.C * localA.Y
Var pBX As Double = transformB.P.X + transformB.Q.C * localB.X - transformB.Q.S * localB.Y
Var pBY As Double = transformB.P.Y + transformB.Q.S * localB.X + transformB.Q.C * localB.Y
Return (pBX - pAX) * axisX + (pBY - pAY) * axisY
End Function

## Current suspension speed in metres per second, ported from
## b2WheelJoint_GetSpeed. Allocates the returned query vectors.
Function GetSpeed() As Double
Me.CheckValid()
Var bodyA As Body = Me.GetBodyA()
Var bodyB As Body = Me.GetBodyB()
Var transformA As Transform = Me.Owner.GetBodyTransform(bodyA)
Var transformB As Transform = Me.Owner.GetBodyTransform(bodyB)
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var axisX As Double = transformA.Q.C * store.WheelLocalAxisX.Items[Me.LocalIndex] - transformA.Q.S * store.WheelLocalAxisY.Items[Me.LocalIndex]
Var axisY As Double = transformA.Q.S * store.WheelLocalAxisX.Items[Me.LocalIndex] + transformA.Q.C * store.WheelLocalAxisY.Items[Me.LocalIndex]
Var localA As Vector2 = Me.GetLocalAnchorA()
Var localB As Vector2 = Me.GetLocalAnchorB()
Var centerLocalA As Vector2 = bodyA.GetLocalCenterOfMass()
Var centerLocalB As Vector2 = bodyB.GetLocalCenterOfMass()
Var rAX As Double = transformA.Q.C * (localA.X - centerLocalA.X) - transformA.Q.S * (localA.Y - centerLocalA.Y)
Var rAY As Double = transformA.Q.S * (localA.X - centerLocalA.X) + transformA.Q.C * (localA.Y - centerLocalA.Y)
Var rBX As Double = transformB.Q.C * (localB.X - centerLocalB.X) - transformB.Q.S * (localB.Y - centerLocalB.Y)
Var rBY As Double = transformB.Q.S * (localB.X - centerLocalB.X) + transformB.Q.C * (localB.Y - centerLocalB.Y)
Var centerA As Vector2 = Me.Owner.GetBodyWorldCenterOfMass(bodyA)
Var centerB As Vector2 = Me.Owner.GetBodyWorldCenterOfMass(bodyB)
Var dX As Double = centerB.X - centerA.X + rBX - rAX
Var dY As Double = centerB.Y - centerA.Y + rBY - rAY
Var vA As Vector2 = Me.Owner.GetBodyLinearVelocity(bodyA)
Var vB As Vector2 = Me.Owner.GetBodyLinearVelocity(bodyB)
Var wA As Double = Me.Owner.GetBodyAngularVelocity(bodyA)
Var wB As Double = Me.Owner.GetBodyAngularVelocity(bodyB)
Var vRelX As Double = vB.X - wB * rBY - (vA.X - wA * rAY)
Var vRelY As Double = vB.Y + wB * rBX - (vA.Y + wA * rAX)
Return dX * (wA * axisY) - dY * (wA * axisX) + axisX * vRelX + axisY * vRelY
End Function

## Enables the translation limits, ported from b2WheelJoint_EnableLimit.
## Toggling clears both accumulated limit impulses.
Sub EnableLimit(enableLimit As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableLimit Then
flag = 1
End If
If flag <> store.EnableLimit.Items[Me.LocalIndex] Then
store.EnableLimit.Items[Me.LocalIndex] = flag
store.WheelLowerImpulse.Items[Me.LocalIndex] = 0.0
store.WheelUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the translation limits are active, ported from
## b2WheelJoint_IsLimitEnabled.
Function IsLimitEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableLimit.Items[Me.LocalIndex] <> 0
End Function

## Lower translation limit in metres, ported from
## b2WheelJoint_GetLowerLimit.
Function GetLowerLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelLowerTranslation.Items[Me.LocalIndex]
End Function

## Upper translation limit in metres, ported from
## b2WheelJoint_GetUpperLimit.
Function GetUpperLimit() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelUpperTranslation.Items[Me.LocalIndex]
End Function

## Sets both translation limits in metres, ported from
## b2WheelJoint_SetLimits. The lower limit must not exceed the upper
## limit, matching the upstream assertion; changing the values clears both
## accumulated limit impulses.
Sub SetLimits(lower As Double, upper As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
If Not lower.IsFinite() Or Not upper.IsFinite() Then
Throw New InvalidArgumentException("Wheel joint limits must be finite")
End If
If lower > upper Then
Throw New InvalidArgumentException("Wheel joint lower limit must not exceed the upper limit")
End If
Var store As JointSims = Me.Owner.GetJointSims(Me)
If lower <> store.WheelLowerTranslation.Items[Me.LocalIndex] Or upper <> store.WheelUpperTranslation.Items[Me.LocalIndex] Then
store.WheelLowerTranslation.Items[Me.LocalIndex] = lower
store.WheelUpperTranslation.Items[Me.LocalIndex] = upper
store.WheelLowerImpulse.Items[Me.LocalIndex] = 0.0
store.WheelUpperImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## Enables the wheel motor, ported from b2WheelJoint_EnableMotor.
## Toggling clears the accumulated motor impulse.
Sub EnableMotor(enableMotor As Boolean)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Var flag As Integer = 0
If enableMotor Then
flag = 1
End If
If flag <> store.EnableMotor.Items[Me.LocalIndex] Then
store.EnableMotor.Items[Me.LocalIndex] = flag
store.WheelMotorImpulse.Items[Me.LocalIndex] = 0.0
End If
End Sub

## True when the wheel motor is active, ported from
## b2WheelJoint_IsMotorEnabled.
Function IsMotorEnabled() As Boolean
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).EnableMotor.Items[Me.LocalIndex] <> 0
End Function

## Desired motor speed in radians per second, ported from
## b2WheelJoint_SetMotorSpeed. Changes apply from the next step.
Sub SetMotorSpeed(motorSpeed As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).WheelMotorSpeed.Items[Me.LocalIndex] = motorSpeed
End Sub

## Desired motor speed in radians per second, ported from
## b2WheelJoint_GetMotorSpeed.
Function GetMotorSpeed() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelMotorSpeed.Items[Me.LocalIndex]
End Function

## Maximum motor torque in newton-metres, ported from
## b2WheelJoint_SetMaxMotorTorque. Changes apply from the next step.
Sub SetMaxMotorTorque(torque As Double)
Me.CheckValid()
Me.Owner.CheckNotLocked()
Me.Owner.GetJointSims(Me).WheelMaxMotorTorque.Items[Me.LocalIndex] = torque
End Sub

## Maximum motor torque in newton-metres, ported from
## b2WheelJoint_GetMaxMotorTorque.
Function GetMaxMotorTorque() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WheelMaxMotorTorque.Items[Me.LocalIndex]
End Function

## Torque the motor applied this step in newton-metres, ported from
## b2WheelJoint_GetMotorTorque.
Function GetMotorTorque() As Double
Me.CheckValid()
Return Me.Owner.InvH * Me.Owner.GetJointSims(Me).WheelMotorImpulse.Items[Me.LocalIndex]
End Function

## The local axis in body A's frame, ported from b2Joint_GetLocalAxisA for
## the wheel family. Returns a new Vector2 copy; safe to retain.
Override Function GetLocalAxisA() As Vector2
Me.CheckValid()
Var store As JointSims = Me.Owner.GetJointSims(Me)
Return New Vector2(store.WheelLocalAxisX.Items[Me.LocalIndex], store.WheelLocalAxisY.Items[Me.LocalIndex])
End Function
End Class

# Wheel joint definition, ported from upstream b2WheelJointDef and
# b2DefaultWheelJointDef in types.h and joint.c. Defaults match upstream:
# coincident anchors, world Y axis, spring/limits/motor disabled. A wheel
# joint lets a wheel rotate freely about its anchor while the suspension
# slides along one axis; an optional spring, translation limits, and motor
# act on that slide and spin.
Class WheelJointDefinition
## First attached body, ported from b2WheelJointDef.bodyIdA. Typically the
## vehicle chassis holding the suspension axis.
Property BodyA As Body
## Second attached body, ported from b2WheelJointDef.bodyIdB. Typically
## the wheel, which spins freely about the anchor.
Property BodyB As Body
## Local anchor point relative to body A's origin, in metres.
Property LocalAnchorA As Vector2
## Local anchor point relative to body B's origin, in metres.
Property LocalAnchorB As Vector2
## Local translation unit axis in body A's frame. Defaults to the world Y
## axis like upstream; normalized at creation.
Property LocalAxisA As Vector2
## True when the suspension spring along the axis is active.
Property EnableSpring As Boolean
## Suspension spring stiffness in hertz.
Property Hertz As Double
## Suspension spring damping ratio, non-dimensional.
Property DampingRatio As Double
## True when the translation limits are active.
Property EnableLimit As Boolean
## Lower translation limit in metres.
Property LowerTranslation As Double
## Upper translation limit in metres.
Property UpperTranslation As Double
## True when the wheel motor is active.
Property EnableMotor As Boolean
## Maximum motor torque, typically in newton-metres.
Property MaxMotorTorque As Double
## Desired motor speed in radians per second.
Property MotorSpeed As Double
## True when the two connected bodies may collide.
Property CollideConnected As Boolean
## User data owned by the application, copied to the created joint. Never
## read by the solver.
Property UserData As Object

## Creates a definition with upstream defaults.
Constructor()
Me.BodyA = Nothing
Me.BodyB = Nothing
Me.LocalAnchorA = New Vector2(0.0, 0.0)
Me.LocalAnchorB = New Vector2(0.0, 0.0)
Me.LocalAxisA = New Vector2(0.0, 1.0)
Me.EnableSpring = False
Me.Hertz = 0.0
Me.DampingRatio = 0.0
Me.EnableLimit = False
Me.LowerTranslation = 0.0
Me.UpperTranslation = 0.0
Me.EnableMotor = False
Me.MaxMotorTorque = 0.0
Me.MotorSpeed = 0.0
Me.CollideConnected = False
Me.UserData = Nothing
End Constructor
End Class

# World façade, ported from upstream b2World in world.h plus the world and
# lifecycle API family in box2d.h. This is the first usable, non-solving
# public world API: bodies, shapes, chains, mass maintenance, proxy
# synchronisation, transforms, and overlap/ray/shape-cast queries.
#
# Storage follows upstream: bodies live in solver sets (static, disabled,
# awake, and per-body sleeping sets in Stage 6), with dense BodySim and
# BodyState records in parallel scalar arrays per decision 0004. Body,
# Shape, and Chain are sparse façade arrays; destruction frees the slot and
# bumps the generation, so stale façades fail IsValid and raise on use.
#
# Contact, joint, island, and stepping machinery arrives from Stage 7; the
# world reports itself as unlocked until then and World.Step throws.
Class World Inherits BroadPhasePairSink
## Gravity vector (metres per second squared).
Property Gravity As Vector2
## Restitution velocities below this threshold are zeroed (metres per second).
Property RestitutionThreshold As Double
## Relative velocity above which hit events are emitted (metres per second).
Property HitEventThreshold As Double
## Maximum contact push-out velocity (metres per second).
Property MaxContactPushSpeed As Double
## Contact stiffness in hertz.
Property ContactHertz As Double
## Contact damping ratio.
Property ContactDampingRatio As Double
## Maximum linear velocity of any body (metres per second).
Property MaximumLinearSpeed As Double
## Whether bodies may sleep.
Property EnableSleeping As Boolean
## Whether continuous collision detection is enabled.
Property ContinuousEnabled As Boolean
## Whether warm starting is enabled. Solver-relevant from Stage 7.
Property WarmStartingEnabled As Boolean
## Whether speculative contact margins are enabled. Solver-relevant from
## Stage 7.
Property SpeculativeEnabled As Boolean
## Whether the world refuses mutation, set during Step from Stage 7.
Property Locked As Boolean
## User data owned by the application.
Property UserData As Integer
## The broad phase owning the three proxy trees.
Property BroadPhase As BroadPhase
## Sparse body façade store indexed by body slot.
Property Bodies As Array(Of Body)
## Sparse shape façade store indexed by shape slot.
Property Shapes As Array(Of Shape)
## Sparse chain façade store indexed by chain slot.
Property Chains As Array(Of Chain)
## Per-slot generation counters, bumped when a slot is freed so that reused
## slots never reuse a generation.
Property BodyGenerations As IntegerList
## Per-slot generation counters for shape slots.
Property ShapeGenerations As IntegerList
## Per-slot generation counters for chain slots.
Property ChainGenerations As IntegerList
## Contact slot pool.
Property ContactIdPool As IdPool
## Sparse contact record store indexed by contact slot.
Property Contacts As Array(Of Contact)

## Recycled contact records. Destroyed contacts keep their record here so
## steady-state pair churn in moving scenes allocates nothing after
## capacity warm-up. Internal solver bookkeeping; applications do not
## touch this list.
Property ContactPool As Array(Of Contact)
## Number of live contacts.
Property ContactCount As Integer
## Optional custom contact filter. When Nothing (the default) the broad
## phase applies only the built-in shape and body rules and the hook adds
## no overhead.
Property CustomFilter As CustomContactFilter
## Island slot pool.
Property IslandIdPool As IdPool
## Sparse island record store indexed by island slot.
Property Islands As Array(Of Island)
## Island selected for splitting during the step. NULL_INDEX when none.
Property SplitIslandId As Integer
## Constraint graph holding the touching contacts in twelve colours.
Property ConstraintGraph As ConstraintGraph
## Solver sets. Index 0 static, 1 disabled, 2 awake, 3+ sleeping.
Property SolverSets As Array(Of SolverSet)
## Body slot pool.
Property BodyIdPool As IdPool
## Shape slot pool.
Property ShapeIdPool As IdPool
## Chain slot pool.
Property ChainIdPool As IdPool
## Solver-set slot pool for sleeping sets.
Property SolverSetIdPool As IdPool
## Joint slot pool.
Property JointIdPool As IdPool
## Number of live joints, ported from b2World_GetJointCount.
Property JointCount As Integer
## Persistent joint records, indexed by joint slot.
Property Joints As Array(Of Joint)
## Generation per joint slot, surviving record replacement.
Property JointGenerations As IntegerList
## Cached inverse substep length from the last step, used by the joint
## force accessors. Zero before the first step.
Property InvH As Double

## Reused overlap query adapter.
Private Property mOverlapContext As WorldOverlapContext
## Reused ray cast query adapter.
Private Property mRayCastContext As WorldRayCastContext
## Reused shape cast query adapter.
Private Property mShapeCastContext As WorldShapeCastContext

## Reusable mover cast context; engine-internal.
Property mMoverCastContext As WorldMoverCastContext

## Reusable mover collide context; engine-internal.
Property mMoverCollideContext As WorldMoverCollideContext

## Reusable explosion context; engine-internal.
Property mExplosionContext As ExplosionContext

## Reusable counters record; engine-internal.
Property mCounters As WorldCounters

## Reusable profile record; engine-internal.
Property mProfile As WorldProfile
## Reused local ray cast input for shape casts.
Private Property mLocalRayInput As RayCastInput
## Reused local shape cast input for shape casts.
Private Property mLocalCastInput As ShapeCastInput
## Reused local proxy for shape casts.
Private Property mLocalProxy As ShapeProxy
## Reused scratch point for local space conversions.
Private Property mLocalPoint As Vector2

# Warm-path scratch records owned by the world. Reused across body and
# shape creation so a warm rebuild after World.Clear allocates only the
# recreated Body and Shape facade objects and their owned state.
## Scratch mass record reused by warm-path mass updates.
Private Property mMassScratch As MassData
## Scratch extent record reused by warm-path extent updates.
Private Property mExtentScratch As ShapeExtent
## Scratch transform reused by warm-path transform reads.
Private Property mTransformScratch As Transform

## Second scratch transform so the narrow phase reads two bodies without
## allocating.
Private Property mTransformScratchB As Transform

## Scratch bounds for the continuous-collision sweep union, reused across

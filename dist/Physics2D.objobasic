# Deterministic integer pair-key hash set, ported from Box2D 3.1.1 table.c.
#
# The broad phase stores shape pair keys here so the same pair is not turned
# into a contact twice (upstream b2HashSet used as the broad-phase pairSet).
# It is an open-addressing table over power-of-two capacity with linear
# probing and backshift removal, so there are no tombstones and no per-entry
# objects. Storage is two parallel Integer arrays (keys and hashes) following
# the Stage 2 parallel-scalar-array decision.
#
# Sentinel rules, matching upstream:
# - Key 0 is reserved and rejected; pair keys of distinct nonzero ids are
#   always nonzero.
# - Stored hash 0 marks an empty slot. Upstream asserts the computed hash is
#   never zero; this port deterministically maps a zero hash to 1 instead.
# - Hashes are full 32-bit values reduced from the 64-bit Murmur finaliser.
#
# After capacity warm-up, Add, Remove, and Contains allocate nothing. Clear
# is linear in capacity, matching the upstream memset.
Class PairKeySet
## Backing keys. Empty slots hold 0. Index directly only in hot engine code.
Property Keys() As Integer
## Backing hashes; 0 marks an empty slot.
Property Hashes() As Integer
## Number of stored keys.
Property Count As Integer
## Table capacity in slots; always a power of two.
Private Property mCapacity As Integer

## Creates a set. Capacity rounds up to a power of two, minimum 16.
Constructor(capacityHint As Integer)
Var capacity As Integer = 16
If capacityHint > 16 Then
capacity = PhysicsMaths.RoundUpPowerOfTwo(capacityHint)
End If
Me.Keys = New Array(Of Integer)
Me.Hashes = New Array(Of Integer)
Me.Count = 0
Me.mCapacity = capacity
Me.ReserveArrays(Me.mCapacity)
End Constructor

## Builds the canonical pair key for one unordered pair. Values are packed
## as 32-bit halves, matching upstream; engine ids are always non-negative.
## Keys of distinct nonzero values are nonzero; the result is reserved as a
## set key.
Shared Function PairKey(a As Integer, b As Integer) As Integer
Var small As Integer = a
Var large As Integer = b
If a > b Then
small = b
large = a
End If
Var key As Integer = small.ShiftLeft(32).BitOr(large.BitAnd(4294967295))
If key = 0 Then
Throw New InvalidArgumentException("PairKey(0, 0) is the reserved empty key")
End If
Return key
End Function

## Adds one key. Returns True when the key was already present.
Function Add(key As Integer) As Boolean
If key = 0 Then
Throw New InvalidArgumentException("PairKeySet key 0 is reserved")
End If
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var index As Integer = Me.FindSlot(key, hash)
If Me.Hashes[index] <> 0 Then
Return True
End If
If 2 * Me.Count >= Me.mCapacity Then
Me.Grow()
index = Me.FindSlot(key, hash)
End If
Me.Keys[index] = key
Me.Hashes[index] = hash
Me.Count = Me.Count + 1
Return False
End Function

## Removes one key. Returns True when the key was found. Removal backshifts
## later probe-chain entries so every stored key stays reachable.
Function Remove(key As Integer) As Boolean
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var i As Integer = Me.FindSlot(key, hash)
If Me.Hashes[i] = 0 Then
Return False
End If

Me.Keys[i] = 0
Me.Hashes[i] = 0
Me.Count = Me.Count - 1

# Backshift: close the gap so probe chains from every hash still reach
# their slot. The cyclic-interval test decides which neighbours to move.
Var j As Integer = i
Var scanning As Boolean = True
While scanning
j = (j + 1).BitAnd(Me.mCapacity - 1)
If Me.Hashes[j] = 0 Then
scanning = False
Else
Var k As Integer = Me.Hashes[j].BitAnd(Me.mCapacity - 1)
Var skipMove As Boolean = False
If i <= j Then
If i < k And k <= j Then
skipMove = True
End If
Else
If i < k Or k <= j Then
skipMove = True
End If
End If
If Not skipMove Then
Me.Keys[i] = Me.Keys[j]
Me.Hashes[i] = Me.Hashes[j]
Me.Keys[j] = 0
Me.Hashes[j] = 0
i = j
End If
End If
Wend
Return True
End Function

## Returns True when the key is present. Zero is rejected because it is the
## reserved empty marker, matching the upstream assertion.
Function Contains(key As Integer) As Boolean
If key = 0 Then
Throw New InvalidArgumentException("PairKeySet key 0 is reserved")
End If
Var hash As Integer = PhysicsMaths.HashKey(key)
If hash = 0 Then
hash = 1
End If
Var index As Integer = Me.FindSlot(key, hash)
Return Me.Keys[index] = key
End Function

## Empties the set. Capacity is retained; zeroing matches the upstream memset.
Sub Clear()
For i As Integer = 0 To Me.mCapacity - 1
Me.Keys[i] = 0
Me.Hashes[i] = 0
Next i
Me.Count = 0
End Sub

## Current table capacity in slots; always a power of two.
Function Capacity() As Integer
Return Me.mCapacity
End Function

## Validates internal invariants: capacity is a power of two, every stored
## key is nonzero with a matching stored hash, counts agree, and every key
## still probes to its own slot.
Sub Validate()
If Not PhysicsMaths.IsPowerOfTwo(Me.mCapacity) Then
Throw New RuntimeException("PairKeySet capacity is not a power of two")
End If
If Me.Count < 0 Or Me.Count > Me.mCapacity Then
Throw New RuntimeException("PairKeySet count outside capacity")
End If
Var tally As Integer = 0
For i As Integer = 0 To Me.mCapacity - 1
If Me.Hashes[i] <> 0 Then
tally = tally + 1
If Me.Keys[i] = 0 Then
Throw New RuntimeException("PairKeySet empty key in occupied slot")
End If
Var expectedHash As Integer = PhysicsMaths.HashKey(Me.Keys[i])
If expectedHash = 0 Then
expectedHash = 1
End If
If Me.Hashes[i] <> expectedHash Then
Throw New RuntimeException("PairKeySet stored hash mismatch")
End If
If Me.FindSlot(Me.Keys[i], Me.Hashes[i]) <> i Then
Throw New RuntimeException("PairKeySet key does not probe to its slot")
End If
End If
Next i
If tally <> Me.Count Then
Throw New RuntimeException("PairKeySet tally disagrees with count")
End If
End Sub

## Walks the probe chain until the key or an empty slot is found.
Private Function FindSlot(key As Integer, hash As Integer) As Integer
Var index As Integer = hash.BitAnd(Me.mCapacity - 1)
While Me.Hashes[index] <> 0 And Me.Keys[index] <> key
index = (index + 1).BitAnd(Me.mCapacity - 1)
Wend
Return index
End Function

## Doubles the capacity and reinserts every stored key.
Private Sub Grow()
Var oldKeys() As Integer = Me.Keys
Var oldHashes() As Integer = Me.Hashes
Var oldCapacity As Integer = Me.mCapacity
Me.mCapacity = oldCapacity * 2
Me.Keys = New Array(Of Integer)
Me.Hashes = New Array(Of Integer)
Me.ReserveArrays(Me.mCapacity)
Me.Count = 0
For i As Integer = 0 To oldCapacity - 1
If oldHashes[i] <> 0 Then
Me.InsertHaveCapacity(oldKeys[i], oldHashes[i])
End If
Next i
End Sub

## Inserts a key known to fit, used only by Grow.
Private Sub InsertHaveCapacity(key As Integer, hash As Integer)
Var index As Integer = Me.FindSlot(key, hash)
Me.Keys[index] = key
Me.Hashes[index] = hash
Me.Count = Me.Count + 1
End Sub

## Ensures both backing arrays have room for capacity zeroed slots.
Private Sub ReserveArrays(capacity As Integer)
While Me.Keys.Count < capacity
Me.Keys.Append(0)
Me.Hashes.Append(0)
Wend
End Sub
End Class

# Physics tuning constants and identity sentinels.
#
# Ported from Box2D 3.1.1 src/constants.h, plus the null-index sentinel from
# src/core.h. Units are metres, kilograms, seconds, and radians. Upstream
# scales several lengths by a user-settable b2_lengthUnitsPerMeter; Physics2D
# fixes one metre per length unit, so every length here is a plain metre
# value. B2_MAX_WORKERS and B2_MAX_WORLDS are excluded because Physics2D has
# no task system and worlds are ordinary Objo objects.
#
# These values are internal infrastructure: they shape solver behaviour and
# must not change without re-baselining the golden fixtures.
Class PhysicsConstants
## Sentinel slot index meaning "no slot". Never confuse it with slot 0.
Public Const NULL_INDEX As Integer = -1

## Sentinel generation that can never validate. Issued generations start at 1.
Public Const INVALID_GENERATION As Integer = 0

## Position magnitude treated as a runaway simulation (metres). Upstream B2_HUGE.
Public Const POSITION_LIMIT As Double = 100000.0

## Small length used as a collision and constraint tolerance (metres). 0.5 cm.
## Changing this materially affects stability.
Public Const LINEAR_SLOP As Double = 0.005

## Maximum rotation of a body per time step (radians). Prevents numerical
## problems; values of half pi or more would break continuous collision.
Public Const MAX_ROTATION As Double = 0.7853981633974483

## Limited speculative collision distance (metres). Reduces jitter. 2 cm.
## Changing this materially affects performance and stability.
Public Const SPECULATIVE_DISTANCE As Double = 0.02

## Extra margin added to dynamic tree bounds (metres). Lets proxies move a
## small amount without triggering a tree adjustment. 5 cm.
Public Const AABB_MARGIN As Double = 0.05

## Time a body must stay slow before it may sleep (seconds).
Public Const TIME_TO_SLEEP As Double = 0.5

## Default joint stiffness in hertz.
Public Const JOINT_CONSTRAINT_HERTZ As Double = 60.0

## Default joint damping ratio.
Public Const JOINT_CONSTRAINT_DAMPING_RATIO As Double = 2.0

## Constraint graph colour count. Constraints that cannot find a colour join
## the overflow set, which is solved single-threaded.
Public Const GRAPH_COLOUR_COUNT As Integer = 12

## Dynamic tree node flag: the node slot is allocated.
Public Const NODE_ALLOCATED_FLAG As Integer = 1

## Dynamic tree node flag: the node bounds were enlarged past their margin.
Public Const NODE_ENLARGED_FLAG As Integer = 2

## Dynamic tree node flag: the node is a leaf holding a proxy.
Public Const NODE_LEAF_FLAG As Integer = 4
End Class

# Deterministic maths helpers required by the Box2D 3.1.1 algorithms.
#
# Ported from upstream src/math_functions.c. Box2D deliberately avoids
# platform trigonometric library calls so simulations behave identically on
# every machine; Physics2D preserves that intent by porting the same
# approximations over Double arithmetic. These functions are internal
# infrastructure used by rotation, joint, and solver code.
#
# Error notes (measured against the platform library on the reference
# machine, double arithmetic):
# - Atan2 differs from the platform atan2 by at most about 2.8e-5 radians.
# - ComputeCosSin differs from the platform sin/cos by at most about 1.7e-3,
#   the intrinsic error of upstream's Bhaskara-style approximation; after
#   normalisation the pair stays on the unit circle to rounding precision.
Class PhysicsMaths
## Two pi as a Double.
Public Const TWO_PI As Double = 6.283185307179586

## Wraps any angle into [-pi, pi] the way upstream b2UnwindAngle does.
## Upstream calls remainder(radians, 2 pi), which rounds the quotient
## half-to-even; the same policy is applied here.
Shared Function UnwindAngle(radians As Double) As Double
Var quotient As Double = radians / TWO_PI
Var rounded As Double = Maths.Round(quotient, RoundingMode.ToEven)
Return radians - rounded * TWO_PI
End Function

## Deterministic arctangent ported from upstream b2Atan2. The minimax
## polynomial was tuned for 32-bit floats; Physics2D keeps the same formula
## and constants so angle results follow upstream behaviour.
Shared Function Atan2(y As Double, x As Double) As Double
# Added check for (0,0) to match atan2 and avoid NaN.
If x = 0.0 And y = 0.0 Then
Return 0.0
End If

Var ax As Double = Maths.Abs(x)
Var ay As Double = Maths.Abs(y)
Var mx As Double = Maths.Max(ay, ax)
Var mn As Double = Maths.Min(ay, ax)
Var a As Double = mn / mx

# Minimax polynomial approximation to atan(a) on [0, 1].
Var s As Double = a * a
Var c As Double = s * a
Var q As Double = s * s
Var r As Double = 0.024840285 * q + 0.18681418
Var t As Double = -0.094097948 * q - 0.33213072
r = r * s + t
r = r * c + a

# Map to the full circle.
If ay > ax Then
r = 1.57079637 - r
End If

If x < 0.0 Then
r = 3.14159274 - r
End If

If y < 0.0 Then
r = -r
End If

Return r
End Function

## Computes the deterministic cosine and sine pair from upstream
## b2ComputeCosSin into a caller-owned result object and returns it. The
## result is normalised to the unit circle. Use this form in warm code to
## avoid allocation; the single-argument overload is the allocating form.
Shared Function ComputeCosSin(radians As Double, out As CosSin) As CosSin
Var x As Double = UnwindAngle(radians)
Var pi2 As Double = Maths.PI * Maths.PI

# Cosine needs the angle in [-pi/2, pi/2].
Var c As Double = 0.0
If x < -1.5707963267948966 Then
Var y As Double = x + Maths.PI
Var y2 As Double = y * y
c = -(pi2 - 4.0 * y2) / (pi2 + y2)
ElseIf x > 1.5707963267948966 Then
Var y As Double = x - Maths.PI
Var y2 As Double = y * y
c = -(pi2 - 4.0 * y2) / (pi2 + y2)
Else
Var y2 As Double = x * x
c = (pi2 - 4.0 * y2) / (pi2 + y2)
End If

# Sine needs the angle in [0, pi].
Var s As Double = 0.0
If x < 0.0 Then
Var y As Double = x + Maths.PI
s = -16.0 * y * (Maths.PI - y) / (5.0 * pi2 - 4.0 * y * (Maths.PI - y))
Else
s = 16.0 * x * (Maths.PI - x) / (5.0 * pi2 - 4.0 * x * (Maths.PI - x))
End If

Var mag As Double = Maths.Sqrt(s * s + c * c)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If

out.Cos = c * invMag
out.Sin = s * invMag
Return out
End Function

## Allocating convenience overload of ComputeCosSin. Suitable for cold paths
## such as construction and examples; step-loop code should use the
## caller-owned output overload.
Shared Function ComputeCosSin(radians As Double) As CosSin
Return ComputeCosSin(radians, New CosSin)
End Function

## Counts trailing zero bits of a nonzero Integer. Returns 64 for zero,
## a defined value the caller must not treat as a bit index. Objo has no
## intrinsic for this, so a comparison ladder keeps it allocation-free.
Shared Function TrailingZeros(value As Integer) As Integer
If value = 0 Then
Return 64
End If

Var count As Integer = 0
Var v As Integer = value
If v.BitAnd(4294967295) = 0 Then
count = count + 32
v = v.ShiftRight(32)
End If
If v.BitAnd(65535) = 0 Then
count = count + 16
v = v.ShiftRight(16)
End If
If v.BitAnd(255) = 0 Then
count = count + 8
v = v.ShiftRight(8)
End If
If v.BitAnd(15) = 0 Then
count = count + 4
v = v.ShiftRight(4)
End If
If v.BitAnd(3) = 0 Then
count = count + 2
v = v.ShiftRight(2)
End If
If v.BitAnd(1) = 0 Then
count = count + 1
End If
Return count
End Function

## Returns True when the value is a positive power of two. Unlike upstream
## b2IsPowerOf2, zero is rejected here because capacity callers never pass
## zero and a positive-only contract avoids surprising results.
Shared Function IsPowerOfTwo(value As Integer) As Boolean
Return value > 0 And value.BitAnd(value - 1) = 0
End Function

## Number of bits needed to hold any value up to value - 1, ported from
## upstream b2BoundingPowerOf2: the minimum is one and the result is
## ceiling(log2(value)) for values above two.
Shared Function BoundingPowerOfTwo(value As Integer) As Integer
If value <= 1 Then
Return 1
End If
Var v As Integer = value - 1
Var bits As Integer = 1
While v > 1
v = v.ShiftRight(1)
bits = bits + 1
Wend
Return bits
End Function

## Rounds the value up to the nearest power of two, ported from upstream
## b2RoundUpPowerOf2. Values of one or less round to one.
Shared Function RoundUpPowerOfTwo(value As Integer) As Integer
If value <= 1 Then
Return 1
End If

Var v As Integer = value - 1
v = v.BitOr(v.ShiftRight(1))
v = v.BitOr(v.ShiftRight(2))
v = v.BitOr(v.ShiftRight(4))
v = v.BitOr(v.ShiftRight(8))
v = v.BitOr(v.ShiftRight(16))
v = v.BitOr(v.ShiftRight(32))
Return v + 1
End Function

## Murmur3 64-bit finaliser over the key, reduced to 32 bits, ported from
## upstream b2KeyHash. Pair keys built from ordered integer pairs mix well
## with this hash. Deterministic on every platform because it uses only
## integer arithmetic; shifts are logical, matching the unsigned upstream
## form.
Shared Function HashKey(key As Integer) As Integer
Var h As Integer = key
h = h.BitXor(LogicalShiftRight(h, 33))
h = h * -49064778989728563
h = h.BitXor(LogicalShiftRight(h, 33))
h = h * -4265267296055464877
h = h.BitXor(LogicalShiftRight(h, 33))
Return h.BitAnd(4294967295)
End Function

## Logical (unsigned) right shift. Objo's ShiftRight is arithmetic, so the
## sign bits are masked off afterwards to match the unsigned C form.
Private Shared Function LogicalShiftRight(value As Integer, count As Integer) As Integer
Return value.ShiftRight(count).BitAnd((1.ShiftLeft(64 - count)) - 1)
End Function
End Class
End Module

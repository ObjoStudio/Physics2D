# Dense per-contact simulation state for one solver set, ported from the
# b2ContactSim usage inside b2SolverSet in solver_set.h. Decision 0004
# selects parallel scalar arrays, so every scalar field is one list indexed
# by the contact's local index within the set.
#
# The manifold and simplex cache are heap objects drawn from append-only
# pools through an LIFO free list. Pool objects survive RemoveSwap and
# Clear, so the warm create/destroy path allocates nothing and the narrow
# phase writes manifolds in place through the Collide To-forms. Which pool
# object a row reuses never affects solver results because pools are pure
# scratch slots.
Class ContactSims
## Cold contact slot of each sim.
Property ContactId As IntegerList
## Shape slot of the first shape.
Property ShapeIdA As IntegerList
## Shape slot of the second shape.
Property ShapeIdB As IntegerList
## Dense-record index of body A inside its solver set. NULL_INDEX until the
## narrow phase assigns it.
Property BodySimIndexA As IntegerList
## Dense-record index of body B inside its solver set.
Property BodySimIndexB As IntegerList
## Inverse mass of body A.
Property InvMassA As DoubleList
## Inverse rotational inertia of body A.
Property InvIA As DoubleList
## Inverse mass of body B.
Property InvMassB As DoubleList
## Inverse rotational inertia of body B.
Property InvIB As DoubleList
## Mixed friction coefficient.
Property Friction As DoubleList
## Mixed restitution coefficient.
Property Restitution As DoubleList
## Rolling resistance scaled by the larger shape radius.
Property RollingResistance As DoubleList
## Conveyor-belt tangent speed along the manifold normal's tangent.
Property TangentSpeed As DoubleList
## b2ContactSimFlags bits.
Property SimFlags As IntegerList
## Pool slot of each row's reusable manifold.
Property ManifoldSlots As IntegerList
## Pool slot of each row's reusable simplex cache.
Property CacheSlots As IntegerList
## Append-only pool of reusable manifold objects.
Property ManifoldPool As Array(Of Manifold)
## Append-only pool of reusable simplex cache objects.
Property CachePool As Array(Of SimplexCache)
## LIFO free list of manifold pool slots.
Property FreeManifolds As IntegerList
## LIFO free list of cache pool slots.
Property FreeCaches As IntegerList

## Creates an empty store.
Constructor()
Me.ContactId = New IntegerList
Me.ShapeIdA = New IntegerList
Me.ShapeIdB = New IntegerList
Me.BodySimIndexA = New IntegerList
Me.BodySimIndexB = New IntegerList
Me.InvMassA = New DoubleList
Me.InvIA = New DoubleList
Me.InvMassB = New DoubleList
Me.InvIB = New DoubleList
Me.Friction = New DoubleList
Me.Restitution = New DoubleList
Me.RollingResistance = New DoubleList
Me.TangentSpeed = New DoubleList
Me.SimFlags = New IntegerList
Me.ManifoldSlots = New IntegerList
Me.CacheSlots = New IntegerList
Me.ManifoldPool = New Array(Of Manifold)
Me.CachePool = New Array(Of SimplexCache)
Me.FreeManifolds = New IntegerList
Me.FreeCaches = New IntegerList
End Constructor

## Number of live contact sims in this store.
Function Count() As Integer
Return Me.ContactId.Count
End Function

## Returns the manifold object owned by the given local row. The narrow
## phase writes into it in place; no caller may keep the reference across
## steps because the slot is recycled.
Function GetManifold(index As Integer) As Manifold
Return Me.ManifoldPool[Me.ManifoldSlots.Items[index]]
End Function

## Returns the simplex cache object owned by the given local row.
Function GetCache(index As Integer) As SimplexCache
Return Me.CachePool[Me.CacheSlots.Items[index]]
End Function

## Appends one empty sim row, reusing pooled objects when available. Returns
## the new local index.
Function Add() As Integer
Me.ContactId.Append(PhysicsConstants.NULL_INDEX)
Me.ShapeIdA.Append(PhysicsConstants.NULL_INDEX)
Me.ShapeIdB.Append(PhysicsConstants.NULL_INDEX)
Me.BodySimIndexA.Append(PhysicsConstants.NULL_INDEX)
Me.BodySimIndexB.Append(PhysicsConstants.NULL_INDEX)
Me.InvMassA.Append(0.0)
Me.InvIA.Append(0.0)
Me.InvMassB.Append(0.0)
Me.InvIB.Append(0.0)
Me.Friction.Append(0.0)
Me.Restitution.Append(0.0)
Me.RollingResistance.Append(0.0)
Me.TangentSpeed.Append(0.0)
Me.SimFlags.Append(0)
If Me.FreeManifolds.Count > 0 Then
Me.ManifoldSlots.Append(Me.FreeManifolds.Pop())
Else
Me.ManifoldSlots.Append(Me.ManifoldPool.Count)
Me.ManifoldPool.Append(New Manifold)
End If
If Me.FreeCaches.Count > 0 Then
Me.CacheSlots.Append(Me.FreeCaches.Pop())
Else
Me.CacheSlots.Append(Me.CachePool.Count)
Me.CachePool.Append(New SimplexCache)
End If
Return Me.ContactId.Count - 1
End Function

## Removes one row by swapping in the last row. Returns the previous local
## index of the row that was moved, or NULL_INDEX when the removed row was
## the last one. After the call the moved row lives at `index`; read its
## ContactId there.
Function RemoveSwap(index As Integer) As Integer
If Me.ManifoldSlots.Items[index] <> PhysicsConstants.NULL_INDEX Then
Me.FreeManifolds.Append(Me.ManifoldSlots.Items[index])
End If
If Me.CacheSlots.Items[index] <> PhysicsConstants.NULL_INDEX Then
Me.FreeCaches.Append(Me.CacheSlots.Items[index])
End If
Var movedIndex As Integer = Me.ContactId.RemoveSwap(index)
Me.ShapeIdA.RemoveSwap(index)
Me.ShapeIdB.RemoveSwap(index)
Me.BodySimIndexA.RemoveSwap(index)
Me.BodySimIndexB.RemoveSwap(index)
Me.InvMassA.RemoveSwap(index)
Me.InvIA.RemoveSwap(index)
Me.InvMassB.RemoveSwap(index)
Me.InvIB.RemoveSwap(index)
Me.Friction.RemoveSwap(index)
Me.Restitution.RemoveSwap(index)
Me.RollingResistance.RemoveSwap(index)
Me.TangentSpeed.RemoveSwap(index)
Me.SimFlags.RemoveSwap(index)
Me.ManifoldSlots.RemoveSwap(index)
Me.CacheSlots.RemoveSwap(index)
Return movedIndex
End Function

## Copies one row's scalars into another store's row and adopts the
## source's pooled manifold and cache objects. The vacated source slots are
## marked NULL so the following RemoveSwap does not recycle an object that
## now belongs to the target store; the slot stays as a dead pool hole.
Sub MoveRowTo(target As ContactSims, targetIndex As Integer, sourceIndex As Integer)
target.ContactId.Items[targetIndex] = Me.ContactId.Items[sourceIndex]
target.ShapeIdA.Items[targetIndex] = Me.ShapeIdA.Items[sourceIndex]
target.ShapeIdB.Items[targetIndex] = Me.ShapeIdB.Items[sourceIndex]
target.BodySimIndexA.Items[targetIndex] = Me.BodySimIndexA.Items[sourceIndex]
target.BodySimIndexB.Items[targetIndex] = Me.BodySimIndexB.Items[sourceIndex]
target.InvMassA.Items[targetIndex] = Me.InvMassA.Items[sourceIndex]
target.InvIA.Items[targetIndex] = Me.InvIA.Items[sourceIndex]
target.InvMassB.Items[targetIndex] = Me.InvMassB.Items[sourceIndex]
target.InvIB.Items[targetIndex] = Me.InvIB.Items[sourceIndex]
target.Friction.Items[targetIndex] = Me.Friction.Items[sourceIndex]
target.Restitution.Items[targetIndex] = Me.Restitution.Items[sourceIndex]
target.RollingResistance.Items[targetIndex] = Me.RollingResistance.Items[sourceIndex]
target.TangentSpeed.Items[targetIndex] = Me.TangentSpeed.Items[sourceIndex]
target.SimFlags.Items[targetIndex] = Me.SimFlags.Items[sourceIndex]
target.ManifoldPool[target.ManifoldSlots.Items[targetIndex]] = Me.ManifoldPool[Me.ManifoldSlots.Items[sourceIndex]]
target.CachePool[target.CacheSlots.Items[targetIndex]] = Me.CachePool[Me.CacheSlots.Items[sourceIndex]]
Me.ManifoldSlots.Items[sourceIndex] = PhysicsConstants.NULL_INDEX
Me.CacheSlots.Items[sourceIndex] = PhysicsConstants.NULL_INDEX
End Sub

## Empties the store while retaining all capacity, including the pooled
## manifold and cache objects.
Sub ClearAll()
Me.ContactId.Clear()
Me.ShapeIdA.Clear()
Me.ShapeIdB.Clear()
Me.BodySimIndexA.Clear()
Me.BodySimIndexB.Clear()
Me.InvMassA.Clear()
Me.InvIA.Clear()
Me.InvMassB.Clear()
Me.InvIB.Clear()
Me.Friction.Clear()
Me.Restitution.Clear()
Me.RollingResistance.Clear()
Me.TangentSpeed.Clear()
Me.SimFlags.Clear()
Me.ManifoldSlots.Clear()
Me.CacheSlots.Clear()
Me.FreeManifolds.Clear()
Me.FreeCaches.Clear()
End Sub
End Class

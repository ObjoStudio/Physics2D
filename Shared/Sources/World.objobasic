End Sub

## Throws when the world refuses mutation.
Sub CheckNotLocked()
If Me.Locked Then
Throw New RuntimeException("World is locked during Step")
End If
End Sub

## Broad-phase sink hook, ported from the record-time filtering of upstream
## b2PairQueryCallback. Returns True when the two shapes may collide. Same
## body pairs pass, sensor pairs are rejected because sensors are handled
## by their own stage, the body pair rule plus the joint collideConnected
## walk suppress disabled pairs, and the built-in shape filter plus the
## opt-in custom filter decide the rest.
Override Function ShouldCollide(shapeIndexA As Integer, shapeIndexB As Integer) As Boolean
If shapeIndexA = shapeIndexB Then
Return True
End If
Var shapeA As Shape = Me.Shapes[shapeIndexA]
Var shapeB As Shape = Me.Shapes[shapeIndexB]
# Sensors are handled by the sensor stage.
If shapeA.SensorIndex <> PhysicsConstants.NULL_INDEX Or shapeB.SensorIndex <> PhysicsConstants.NULL_INDEX Then
Return False
End If
Var bodyA As Body = Me.Bodies[shapeA.BodyId]
Var bodyB As Body = Me.Bodies[shapeB.BodyId]
If ContactMethods.ShouldBodiesCollide(Me, bodyA, bodyB) = False Then
Return False
End If
If Not ContactMethods.ShouldShapesCollide(shapeA.Filter, shapeB.Filter) Then
Return False
End If
If Me.CustomFilter <> Nothing Then
Return Me.CustomFilter.ShouldCollide(shapeA, shapeB)
End If
Return True
End Function

## Broad-phase sink hook, ported from the deterministic contact-creation
## loop of upstream b2UpdateBroadPhasePairs. Duplicate suppression and
## ordering are the broad phase's responsibility.
Override Sub AcceptPair(shapeIndexA As Integer, shapeIndexB As Integer)
ContactMethods.CreateContact(Me, Me.Shapes[shapeIndexA], Me.Shapes[shapeIndexB])
End Sub

## Discovers broad-phase pairs and creates contacts for every moved proxy,
## ported from b2UpdateBroadPhasePairs. The step calls this first; it is
## exposed so tests and future non-step callers can run pair discovery
## directly.
Sub UpdateBroadPhasePairs()
Me.BroadPhase.UpdatePairs(Me)
End Sub

## Mixed friction for a new contact, ported from the default friction
## callback. The mixer hook replaces this from the step stage.
Function MixFriction(frictionA As Double, frictionB As Double) As Double
Return Me.MixFrictionWithMaterials(frictionA, 0, frictionB, 0)
End Function

## Routes friction mixing through the opt-in mixer, ported from the
## friction callback on the upstream world definition.
Function MixFrictionWithMaterials(frictionA As Double, userMaterialIdA As Integer, frictionB As Double, userMaterialIdB As Integer) As Double
If Me.MaterialMixer <> Nothing Then
Return Me.MaterialMixer.MixFriction(frictionA, userMaterialIdA, frictionB, userMaterialIdB)
End If
Return Maths.Sqrt(frictionA * frictionB)
End Function

## Mixed restitution for a new contact, ported from the default restitution
## callback.
Function MixRestitution(restitutionA As Double, restitutionB As Double) As Double
Return Me.MixRestitutionWithMaterials(restitutionA, 0, restitutionB, 0)
End Function

## Routes restitution mixing through the opt-in mixer, ported from the
## restitution callback on the upstream world definition.
Function MixRestitutionWithMaterials(restitutionA As Double, userMaterialIdA As Integer, restitutionB As Double, userMaterialIdB As Integer) As Double
If Me.MaterialMixer <> Nothing Then
Return Me.MaterialMixer.MixRestitution(restitutionA, userMaterialIdA, restitutionB, userMaterialIdB)
End If
If restitutionA > restitutionB Then
Return restitutionA
End If
Return restitutionB
End Function

## Throws when a definition argument is missing.
Private Sub CheckDefinition(def As Object, name As String)
If def = Nothing Then
Throw New InvalidArgumentException(name + " must not be Nothing")
End If
End Sub

## Advances the simulation by one time step using the default four substeps,
## ported from b2World_Step with the upstream default sub-step count. Runs
## pair discovery, the narrow phase, island maintenance, and the Soft Step
## constraint solver, then finalises bodies and applies sleep. The world
## stays locked for the duration.
Sub StepWorld(timeStep As Double)
Me.StepWorld(timeStep, 4)
End Sub

## Advances the simulation with explicit substepping, ported from
## b2World_Step. The substep count must be positive; smaller values are
## rejected rather than clamped.
Sub StepWorld(timeStep As Double, subStepCount As Integer)
Me.CheckNotLocked()
If timeStep.IsFinite() = False Or timeStep < 0.0 Then
Throw New InvalidArgumentException("StepWorld requires a finite non-negative time step")
End If
If subStepCount < 1 Then
Throw New InvalidArgumentException("StepWorld requires a positive substep count")
End If

# Capture events: stale data must be unreadable after any early return,
# ported from the event capture block of b2World_Step.
Me.ClearStepEventBuffers()

If timeStep = 0.0 Then
# Swap end event array buffers even when paused.
Me.SwapEndEventBuffers()
Return
End If

Me.Locked = True

# Discover new contacts from moved proxies.
Me.UpdateBroadPhasePairs()

Var context As StepContext = Me.mStepScratch
context.Dt = timeStep
context.SubStepCount = subStepCount
context.InvDt = 1.0 / timeStep
context.H = timeStep / context.SubStepCount
context.InvH = context.SubStepCount * context.InvDt

# Hertz values get reduced for large time steps.
Var contactHertz As Double = Me.ContactHertz
If contactHertz > 0.125 * context.InvH Then
contactHertz = 0.125 * context.InvH
End If
Softness.MakeTo(contactHertz, Me.ContactDampingRatio, context.H, context.ContactSoftness)
Softness.MakeTo(2.0 * contactHertz, Me.ContactDampingRatio, context.H, context.StaticSoftness)
context.ContactSpeed = Me.MaxContactPushSpeed / context.StaticSoftness.MassScale
context.RestitutionThreshold = Me.RestitutionThreshold
context.MaximumLinearVelocity = Me.MaximumLinearSpeed
If Me.WarmStartingEnabled Then
context.WarmStartScale = 1.0
Else
context.WarmStartScale = 0.0
End If
context.World = Me
Var awakeSetForContext As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
context.States = awakeSetForContext.States
Me.InvH = context.InvH

Me.CollideStep(context)
Me.SolveStep(context)

# Sensor overlaps run after the solve so sensors read post-solve
# transforms, ported from b2OverlapSensors' call site in b2World_Step.
Me.OverlapSensors()

# Swap end event array buffers so this step's end events stay readable
# until the end of the next step.
Me.SwapEndEventBuffers()

Me.Locked = False
End Sub

## Clears the begin, hit, and move event buffers, ported from the event
## capture block of b2World_Step.
Private Sub ClearStepEventBuffers()
Me.MoveEventBodyIds.Clear()
Me.MoveEventBodyGens.Clear()
Me.MoveEventPXs.Clear()
Me.MoveEventPYs.Clear()
Me.MoveEventQCs.Clear()
Me.MoveEventQSs.Clear()
Me.MoveEventFellAsleep.Clear()
Me.SensorBeginSensorIds.Clear()
Me.SensorBeginSensorGens.Clear()
Me.SensorBeginVisitorIds.Clear()
Me.SensorBeginVisitorGens.Clear()
Me.ContactBeginShapeAIds.Clear()
Me.ContactBeginShapeAGens.Clear()
Me.ContactBeginShapeBIds.Clear()
Me.ContactBeginShapeBGens.Clear()
Me.ContactBeginManifolds.Clear()
Me.ContactHitShapeAIds.Clear()
Me.ContactHitShapeAGens.Clear()
Me.ContactHitShapeBIds.Clear()
Me.ContactHitShapeBGens.Clear()
Me.ContactHitSpeeds.Clear()
Me.ContactHitPointXs.Clear()
Me.ContactHitPointYs.Clear()
End Sub

## Swaps and clears the end event buffers, ported from the end of
## b2World_Step.
Private Sub SwapEndEventBuffers()
Me.EndEventWriteIndex = 1 - Me.EndEventWriteIndex
Me.ReadableEndIndex = 1 - Me.ReadableEndIndex
Me.SensorEndSensorIds[Me.EndEventWriteIndex].Clear()
Me.SensorEndSensorGens[Me.EndEventWriteIndex].Clear()
Me.SensorEndVisitorIds[Me.EndEventWriteIndex].Clear()
Me.SensorEndVisitorGens[Me.EndEventWriteIndex].Clear()
Me.ContactEndShapeAIds[Me.EndEventWriteIndex].Clear()
Me.ContactEndShapeAGens[Me.EndEventWriteIndex].Clear()
Me.ContactEndShapeBIds[Me.EndEventWriteIndex].Clear()
Me.ContactEndShapeBGens[Me.EndEventWriteIndex].Clear()
End Sub

## Resolves a shape reference from an event, returning Nothing for stale
## or destroyed shapes.
Function EventShape(shapeId As Integer, generation As Integer) As Shape
If shapeId < 0 Or shapeId >= Me.Shapes.Count Then
Return Nothing
End If
Var shape As Shape = Me.Shapes[shapeId]
If shape = Nothing Or shape.Live = False Then
Return Nothing
End If
If shape.Generation <> generation Then
Return Nothing
End If
Return shape
End Function

## Resolves a body reference from an event, returning Nothing for stale or
## destroyed bodies.
Function EventBody(bodyId As Integer, generation As Integer) As Body
If bodyId < 0 Or bodyId >= Me.Bodies.Count Then
Return Nothing
End If
Var body As Body = Me.Bodies[bodyId]
If body = Nothing Or body.Live = False Then
Return Nothing
End If
If body.Generation <> generation Then
Return Nothing
End If
Return body
End Function

## Swaps, re-queries, and publishes sensor begin and end events, ported
## from b2OverlapSensors. Runs after the solve so sensor queries observe
## post-solve transforms.
Private Sub OverlapSensors()
Var sensorCount As Integer = Me.Sensors.Count
If sensorCount = 0 Then
Return
End If

Me.mSensorEventBits.SetCountAndClear(sensorCount + 8)
Var sensorIndex As Integer = 0
While sensorIndex < sensorCount
Var sensor As Sensor = Me.Sensors[sensorIndex]
Var sensorShape As Shape = Me.Shapes[sensor.ShapeId]

# Swap the overlap buffers and clear the incoming one.
Var tempIds As IntegerList = sensor.Overlap1Ids
sensor.Overlap1Ids = sensor.Overlap2Ids
sensor.Overlap2Ids = tempIds
Var tempGens As IntegerList = sensor.Overlap1Gens
sensor.Overlap1Gens = sensor.Overlap2Gens
sensor.Overlap2Gens = tempGens
sensor.Overlap2Ids.Clear()
sensor.Overlap2Gens.Clear()

Var body As Body = Me.Bodies[sensorShape.BodyId]
If body.SetIndex = PhysicsConstants.DISABLED_SET Or sensorShape.EnableSensorEvents = False Then
If sensor.Overlap1Ids.Count > 0 Then
Me.mSensorEventBits.SetBit(sensorIndex)
End If
Else
Me.GetBodyTransformTo(body, Me.mTransformScratch)
Me.mSensorQueryCallback.Sensor = sensor
Me.mSensorQueryCallback.SensorShape = sensorShape
Me.mSensorQueryCallback.Transform = Me.mTransformScratch
Var treeIndex As Integer = 0
While treeIndex <= 2
Me.mQueryStats.Reset()
Me.BroadPhase.Trees[treeIndex].QueryTo(sensorShape.AABB, sensorShape.Filter.MaskBits, Me.mSensorQueryCallback, Me.mQueryStats)
treeIndex = treeIndex + 1
Wend
Me.SortSensorOverlaps(sensor)

# Detect change against the previous overlaps.
Var count1 As Integer = sensor.Overlap1Ids.Count
Var count2 As Integer = sensor.Overlap2Ids.Count
If count1 <> count2 Then
Me.mSensorEventBits.SetBit(sensorIndex)
Else
Var i As Integer = 0
While i < count1
If sensor.Overlap1Ids.Items[i] <> sensor.Overlap2Ids.Items[i] Or sensor.Overlap1Gens.Items[i] <> sensor.Overlap2Gens.Items[i] Then
Me.mSensorEventBits.SetBit(sensorIndex)
Exit While
End If
i = i + 1
Wend
End If
End If
sensorIndex = sensorIndex + 1
Wend

Me.PublishSensorEvents()
End Sub

## Sorts a sensor's current overlaps by shape slot then generation,
## ported from b2CompareShapeRefs. Overlap lists are tiny, so an insertion
## sort keeps the warm loop allocation free.
Private Sub SortSensorOverlaps(sensor As Sensor)
Var ids As IntegerList = sensor.Overlap2Ids
Var gens As IntegerList = sensor.Overlap2Gens
Var count As Integer = ids.Count
Var i As Integer = 1
While i < count
Var id As Integer = ids.Items[i]
Var gen As Integer = gens.Items[i]
Var j As Integer = i - 1
While j >= 0
Var otherId As Integer = ids.Items[j]
Var otherGen As Integer = gens.Items[j]
If otherId < id Or (otherId = id And otherGen <= gen) Then
Exit While
End If
ids.Items[j + 1] = otherId
gens.Items[j + 1] = otherGen
j = j - 1
Wend
ids.Items[j + 1] = id
gens.Items[j + 1] = gen
i = i + 1
Wend
End Sub

## Publishes sensor begin and end events by diffing the double-buffered
## overlap lists, ported from the event stage of b2OverlapSensors.
Private Sub PublishSensorEvents()
Var bitCount As Integer = Me.mSensorEventBits.WordCount * 64
Var sensorIndex As Integer = 0
While sensorIndex < bitCount
If Me.mSensorEventBits.GetBit(sensorIndex) Then
Var sensor As Sensor = Me.Sensors[sensorIndex]
Var sensorGen As Integer = Me.ShapeGenerations.Items[sensor.ShapeId]
Var count1 As Integer = sensor.Overlap1Ids.Count
Var count2 As Integer = sensor.Overlap2Ids.Count
Var index1 As Integer = 0
Var index2 As Integer = 0
While index1 < count1 And index2 < count2
Var id1 As Integer = sensor.Overlap1Ids.Items[index1]
Var id2 As Integer = sensor.Overlap2Ids.Items[index2]
If id1 = id2 Then
If sensor.Overlap1Gens.Items[index1] < sensor.Overlap2Gens.Items[index2] Then
Me.PushSensorEndEvent(sensor.ShapeId, sensorGen, id1, sensor.Overlap1Gens.Items[index1])
index1 = index1 + 1
ElseIf sensor.Overlap1Gens.Items[index1] > sensor.Overlap2Gens.Items[index2] Then
Me.PushSensorBeginEvent(sensor.ShapeId, sensorGen, id2, sensor.Overlap2Gens.Items[index2])
index2 = index2 + 1
Else
index1 = index1 + 1
index2 = index2 + 1
End If
ElseIf id1 < id2 Then
Me.PushSensorEndEvent(sensor.ShapeId, sensorGen, id1, sensor.Overlap1Gens.Items[index1])
index1 = index1 + 1
Else
Me.PushSensorBeginEvent(sensor.ShapeId, sensorGen, id2, sensor.Overlap2Gens.Items[index2])
index2 = index2 + 1
End If
Wend
While index1 < count1
Me.PushSensorEndEvent(sensor.ShapeId, sensorGen, sensor.Overlap1Ids.Items[index1], sensor.Overlap1Gens.Items[index1])
index1 = index1 + 1
Wend
While index2 < count2
Me.PushSensorBeginEvent(sensor.ShapeId, sensorGen, sensor.Overlap2Ids.Items[index2], sensor.Overlap2Gens.Items[index2])
index2 = index2 + 1
Wend
End If
sensorIndex = sensorIndex + 1
Wend
End Sub

## Appends one sensor begin event.
Private Sub PushSensorBeginEvent(sensorId As Integer, sensorGen As Integer, visitorId As Integer, visitorGen As Integer)
Me.SensorBeginSensorIds.Append(sensorId)
Me.SensorBeginSensorGens.Append(sensorGen)
Me.SensorBeginVisitorIds.Append(visitorId)
Me.SensorBeginVisitorGens.Append(visitorGen)
End Sub

## Appends one sensor end event to the current write buffer.
Private Sub PushSensorEndEvent(sensorId As Integer, sensorGen As Integer, visitorId As Integer, visitorGen As Integer)
Me.SensorEndSensorIds[Me.EndEventWriteIndex].Append(sensorId)
Me.SensorEndSensorGens[Me.EndEventWriteIndex].Append(sensorGen)
Me.SensorEndVisitorIds[Me.EndEventWriteIndex].Append(visitorId)
Me.SensorEndVisitorGens[Me.EndEventWriteIndex].Append(visitorGen)
End Sub

## Ends every current overlap of a sensor and removes its record, ported
## from b2DestroySensor.
Private Sub DestroySensor(shape As Shape)
Var sensorIndex As Integer = shape.SensorIndex
Var sensor As Sensor = Me.Sensors[sensorIndex]
Var sensorGen As Integer = Me.ShapeGenerations.Items[shape.Id]
Var visitorCount As Integer = sensor.Overlap2Ids.Count
Var i As Integer = 0
While i < visitorCount
Me.PushSensorEndEvent(shape.Id, sensorGen, sensor.Overlap2Ids.Items[i], sensor.Overlap2Gens.Items[i])
i = i + 1
Wend

# Swap-remove the record and fix up the moved sensor's shape.
Var lastIndex As Integer = Me.Sensors.Count - 1
If sensorIndex <> lastIndex Then
Var movedSensor As Sensor = Me.Sensors[lastIndex]
Me.Sensors[sensorIndex] = movedSensor
Me.Shapes[movedSensor.ShapeId].SensorIndex = sensorIndex
End If
Me.Sensors.RemoveAt(lastIndex)
shape.SensorIndex = PhysicsConstants.NULL_INDEX
End Sub

## Sensor tree-query hit test, ported from b2SensorQueryCallback. Returns
## True to continue traversal; appends the visitor to the sensor's current
## overlap buffer on a hit.
Function SensorOverlapTest(shapeId As Integer, sensor As Sensor, sensorShape As Shape, transform As Transform) As Boolean
If shapeId = sensorShape.Id Then
Return True
End If
Var otherShape As Shape = Me.Shapes[shapeId]
If otherShape = Nothing Then
Return True
End If
If otherShape.EnableSensorEvents = False Then
Return True
End If
If otherShape.BodyId = sensorShape.BodyId Then
Return True
End If
If ContactMethods.ShouldShapesCollide(sensorShape.Filter, otherShape.Filter) = False Then
Return True
End If

Me.GetBodyTransformTo(Me.Bodies[otherShape.BodyId], Me.mSensorOtherTransform)
Me.mSensorDistanceInput.ProxyA = sensorShape.DistanceProxy
Me.mSensorDistanceInput.ProxyB = otherShape.DistanceProxy
Me.mSensorDistanceInput.TransformA = transform
Me.mSensorDistanceInput.TransformB = Me.mSensorOtherTransform
Me.mSensorDistanceInput.UseRadii = True
Me.mSensorCache.Count = 0
Distance.ShapeDistanceTo(Me.mSensorDistanceInput, Me.mSensorCache, Me.mSensorOutput)
If Me.mSensorOutput.Distance >= 10.0 * PhysicsConstants.FLT_EPSILON Then
Return True
End If

# Record the overlap.
sensor.Overlap2Ids.Append(shapeId)
sensor.Overlap2Gens.Append(otherShape.Generation)
Return True
End Function

## Collects contact hit events from every graph colour, ported from the
## hit event stage of b2Solve.
Private Sub CollectHitEvents()
Var threshold As Double = Me.HitEventThreshold
Var graph As ConstraintGraph = Me.ConstraintGraph
Var colorIndex As Integer = 0
While colorIndex < PhysicsConstants.GRAPH_COLOUR_COUNT
Var color As GraphColor = graph.Colors[colorIndex]
Var sims As ContactSims = color.ContactSims
Var count As Integer = sims.Count()
Var j As Integer = 0
While j < count
If sims.SimFlags.Items[j].BitAnd(Integer(ContactFlags.SimEnableHitEvent)) <> 0 Then
Var manifold As Manifold = sims.GetManifold(j)
Var approachSpeed As Double = threshold
Var pointX As Double = 0.0
Var pointY As Double = 0.0
Var hit As Boolean = False
Var pointCount As Integer = manifold.PointCount
Var k As Integer = 0
While k < pointCount
Var point As ManifoldPoint = manifold.Point1
If k = 1 Then
point = manifold.Point2
End If
Var speed As Double = -point.NormalVelocity
If speed > approachSpeed And point.TotalNormalImpulse > 0.0 Then
approachSpeed = speed
pointX = point.Point.X
pointY = point.Point.Y
hit = True
End If
k = k + 1
Wend
If hit Then
Var shapeA As Integer = sims.ShapeIdA.Items[j]
Var shapeB As Integer = sims.ShapeIdB.Items[j]
Me.ContactHitShapeAIds.Append(shapeA)
Me.ContactHitShapeAGens.Append(Me.ShapeGenerations.Items[shapeA])
Me.ContactHitShapeBIds.Append(shapeB)
Me.ContactHitShapeBGens.Append(Me.ShapeGenerations.Items[shapeB])
Me.ContactHitSpeeds.Append(approachSpeed)
Me.ContactHitPointXs.Append(pointX)
Me.ContactHitPointYs.Append(pointY)
End If
End If
j = j + 1
Wend
colorIndex = colorIndex + 1
Wend
End Sub

## Continuous collision sweep hit test against one candidate shape, ported
## from b2ContinuousQueryCallback. Returns True to continue traversal and
## lowers the context fraction on a hit.
Function ContinuousHitTest(shapeId As Integer, context As ContinuousContext) As Boolean
Var fastShape As Shape = context.FastShape
If shapeId = fastShape.Id Then
Return True
End If
Var shape As Shape = Me.Shapes[shapeId]
If shape = Nothing Then
Return True
End If
If shape.BodyId = fastShape.BodyId Then
Return True
End If
If shape.SensorIndex <> PhysicsConstants.NULL_INDEX Then
Return True
End If
If ContactMethods.ShouldShapesCollide(fastShape.Filter, shape.Filter) = False Then
Return True
End If

Var body As Body = Me.Bodies[shape.BodyId]
Var bodySim As BodySims = Me.GetBodySim(body)
If bodySim.IsBullet.Items[body.LocalIndex] <> 0 Then
Return True
End If
Var fastBody As Body = Me.Bodies[fastShape.BodyId]
If ContactMethods.ShouldBodiesCollide(Me, fastBody, body) = False Then
Return True
End If
If Me.CustomFilter <> Nothing Then
If Me.CustomFilter.ShouldCollide(shape, fastShape) = False Then
Return True
End If
End If

# Prevent pausing on chain segment junctions.
If shape.Type = ShapeType.ChainSegmentShape Then
If Me.ContinuousChainClip(context, shape) Then
Return True
End If
End If

Var hitFraction As Double = context.Fraction
Var didHit As Boolean = False

# Build the candidate body's sweep from its pre-solve transform to its
# current one, ported from b2MakeSweep.
Var candidateSim As BodySims = Me.GetBodySim(body)
Var candidateIndex As Integer = body.LocalIndex
Me.mSweepScratch.C1.Set(candidateSim.C0X.Items[candidateIndex], candidateSim.C0Y.Items[candidateIndex])
Me.mSweepScratch.C2.Set(candidateSim.CenterX.Items[candidateIndex], candidateSim.CenterY.Items[candidateIndex])
Me.mSweepScratch.Q1.SetComponents(candidateSim.R0C.Items[candidateIndex], candidateSim.R0S.Items[candidateIndex])
Me.mSweepScratch.Q2.SetComponents(candidateSim.QC.Items[candidateIndex], candidateSim.QS.Items[candidateIndex])
Me.mSweepScratch.LocalCenter.Set(candidateSim.LCX.Items[candidateIndex], candidateSim.LCY.Items[candidateIndex])

Me.mSweepInput.ProxyA = shape.DistanceProxy
Me.mSweepInput.ProxyB = fastShape.DistanceProxy
Me.mSweepInput.SweepA = Me.mSweepScratch
Me.mSweepInput.SweepB = context.Sweep
Me.mSweepInput.MaxFraction = context.Fraction
TimeOfImpact.ComputeTo(Me.mSweepInput, Me.mSweepOutput)
If 0.0 < Me.mSweepOutput.Fraction And Me.mSweepOutput.Fraction < context.Fraction Then
hitFraction = Me.mSweepOutput.Fraction
didHit = True
ElseIf Me.mSweepOutput.Fraction = 0.0 Then
# Fall back to the TOI of a small circle around the fast shape centroid.
Var centroid As Vector2 = fastShape.LocalCentroid
Me.ComputeShapeExtent(fastShape, centroid, Me.mSweepExtent)
# The one-point fallback proxy is rebuilt in place so a fast body
# sweeping along touching geometry allocates nothing.
ShapeProxy.MakeOnePointTo(Me.mSweepFallbackProxy, centroid.X, centroid.Y, 0.25 * Me.mSweepExtent.MinExtent)
Me.mSweepInput.ProxyB = Me.mSweepFallbackProxy
TimeOfImpact.ComputeTo(Me.mSweepInput, Me.mSweepOutput)
If 0.0 < Me.mSweepOutput.Fraction And Me.mSweepOutput.Fraction < context.Fraction Then
hitFraction = Me.mSweepOutput.Fraction
didHit = True
End If
End If

If didHit And (shape.EnablePreSolveEvents Or fastShape.EnablePreSolveEvents) And Me.PreSolve <> Nothing Then
# Pre-solve is expensive because it computes a temporary manifold.
Me.GetSweepTransformTo(Me.mSweepInput.SweepA, hitFraction, Me.mSweepTransform)
Me.GetSweepTransformTo(context.Sweep, hitFraction, Me.mSweepTransformB)
Me.mContinuousCache.Count = 0
ContactMethods.ComputeManifoldTo(shape, Me.mSweepTransform, fastShape, Me.mSweepTransformB, Me.mContinuousCache, Me.mContinuousManifold)
If Me.PreSolve.PreSolve(shape, fastShape, Me.mContinuousManifold) = False Then
didHit = False
End If
End If

If didHit Then
context.Fraction = hitFraction
End If
Return True
End Function

## Chain junction clipping check for continuous collision, ported from the
## chain segment branch of b2ContinuousQueryCallback. Returns True when the
## sweep may be safely clipped past this junction.
Private Function ContinuousChainClip(context As ContinuousContext, shape As Shape) As Boolean
Var segment As ChainSegment = shape.ChainSegment
Var body As Body = Me.Bodies[shape.BodyId]
Me.GetBodyTransformTo(body, Me.mTransformScratch)
Var p1 As Vector2 = Transform.TransformPoint(Me.mTransformScratch, segment.Segment.Point1)
Var p2 As Vector2 = Transform.TransformPoint(Me.mTransformScratch, segment.Segment.Point2)
Var ex As Double = p2.X - p1.X
Var ey As Double = p2.Y - p1.Y
Var length As Double = Maths.Sqrt(ex * ex + ey * ey)
If length <= PhysicsConstants.LINEAR_SLOP Then
Return False
End If
ex = ex / length
ey = ey / length
Var c1 As Vector2 = context.Centroid1
Var offset1 As Double = ex * (c1.Y - p1.Y) - ey * (c1.X - p1.X)
Var c2 As Vector2 = context.Centroid2
Var offset2 As Double = ex * (c2.Y - p1.Y) - ey * (c2.X - p1.X)
Var fastBodySim As BodySims = Me.GetBodySim(Me.Bodies[context.FastBodyId])
Var allowedFraction As Double = 0.25 * fastBodySim.MinExtent.Items[context.FastBodySimIndex]
If offset1 < 0.0 Or offset1 - offset2 < allowedFraction Then
Return True
End If
Return False
End Function

## Solves continuous collision for one fast awake body sim, ported from
## b2SolveContinuous.
Private Sub SolveContinuous(bodySimIndex As Integer)
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var sims As BodySims = awakeSet.Sims
Var fastBodyId As Integer = sims.BodyId.Items[bodySimIndex]
Var fastBody As Body = Me.Bodies[fastBodyId]
Var context As ContinuousContext = Me.mContinuousContext
context.Fraction = 1.0
context.FastBodyId = fastBodyId
context.FastBodySimIndex = bodySimIndex
context.FastShape = Nothing

# Build the sweep from the pre-solve transform to the current transform.
context.Sweep.C1.Set(sims.C0X.Items[bodySimIndex], sims.C0Y.Items[bodySimIndex])
context.Sweep.C2.Set(sims.CenterX.Items[bodySimIndex], sims.CenterY.Items[bodySimIndex])
context.Sweep.Q1.SetComponents(sims.R0C.Items[bodySimIndex], sims.R0S.Items[bodySimIndex])
context.Sweep.Q2.SetComponents(sims.QC.Items[bodySimIndex], sims.QS.Items[bodySimIndex])
context.Sweep.LocalCenter.Set(sims.LCX.Items[bodySimIndex], sims.LCY.Items[bodySimIndex])

Var xf1 As Transform = Me.mSweepTransform
xf1.Q.SetComponents(context.Sweep.Q1.C, context.Sweep.Q1.S)
xf1.P.Set(context.Sweep.C1.X - (xf1.Q.C * context.Sweep.LocalCenter.X - xf1.Q.S * context.Sweep.LocalCenter.Y), context.Sweep.C1.Y - (xf1.Q.S * context.Sweep.LocalCenter.X + xf1.Q.C * context.Sweep.LocalCenter.Y))
Var xf2 As Transform = Me.mSweepTransformB
xf2.Q.SetComponents(context.Sweep.Q2.C, context.Sweep.Q2.S)
xf2.P.Set(context.Sweep.C2.X - (xf2.Q.C * context.Sweep.LocalCenter.X - xf2.Q.S * context.Sweep.LocalCenter.Y), context.Sweep.C2.Y - (xf2.Q.S * context.Sweep.LocalCenter.X + xf2.Q.C * context.Sweep.LocalCenter.Y))

Var isBullet As Boolean = sims.IsBullet.Items[bodySimIndex] <> 0
Var shapeId As Integer = fastBody.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var fastShape As Shape = Me.Shapes[shapeId]
shapeId = fastShape.NextShapeId
context.FastShape = fastShape

Var centroid1X As Double = xf1.Q.C * fastShape.LocalCentroid.X - xf1.Q.S * fastShape.LocalCentroid.Y + xf1.P.X
Var centroid1Y As Double = xf1.Q.S * fastShape.LocalCentroid.X + xf1.Q.C * fastShape.LocalCentroid.Y + xf1.P.Y
Var centroid2X As Double = xf2.Q.C * fastShape.LocalCentroid.X - xf2.Q.S * fastShape.LocalCentroid.Y + xf2.P.X
Var centroid2Y As Double = xf2.Q.S * fastShape.LocalCentroid.X + xf2.Q.C * fastShape.LocalCentroid.Y + xf2.P.Y
context.Centroid1.Set(centroid1X, centroid1Y)
context.Centroid2.Set(centroid2X, centroid2Y)

# Reuse the shape's owned AABB and world scratch boxes: the per-shape
# continuous sweep must not allocate while bodies move every step. The
# start bounds stay readable until the union is taken, then the end
# bounds overwrite the shape's stored AABB.
Var endBox As AABB = Me.mContinuousBoxScratchB
Me.ComputeShapeAABBTo(fastShape, xf2, endBox)
Var box As AABB = Me.mContinuousBoxScratch
AABB.UnionTo(fastShape.AABB, endBox, box)
Var stored As AABB = fastShape.AABB
stored.LowerBound.Set(endBox.LowerBound.X, endBox.LowerBound.Y)
stored.UpperBound.Set(endBox.UpperBound.X, endBox.UpperBound.Y)

# No continuous collision for sensors, but the bounds are updated.
If fastShape.SensorIndex <> PhysicsConstants.NULL_INDEX Then
Continue While
End If

Me.mContinuousCallback.Context = context
Me.mQueryStats.Reset()
Me.BroadPhase.Trees[0].QueryTo(box, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContinuousCallback, Me.mQueryStats)
If isBullet Then
Me.BroadPhase.Trees[1].QueryTo(box, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContinuousCallback, Me.mQueryStats)
Me.BroadPhase.Trees[2].QueryTo(box, PhysicsConstants.DEFAULT_MASK_BITS, Me.mContinuousCallback, Me.mQueryStats)
End If
Wend

If context.FastShape = Nothing Then
Return
End If

If context.Fraction < 1.0 Then
Me.ApplyContinuousHit(bodySimIndex, fastBody, context)
Else
Me.AdvanceContinuousNoHit(fastBody, bodySimIndex)
End If
End Sub

## Applies a continuous time-of-impact hit: advances the body to the hit
## transform and refreshes shape AABBs, ported from the hit branch of
## b2SolveContinuous.
Private Sub ApplyContinuousHit(bodySimIndex As Integer, fastBody As Body, context As ContinuousContext)
Var sims As BodySims = Me.SolverSets[PhysicsConstants.AWAKE_SET].Sims
Var sweep As Sweep = context.Sweep
Var q As Rot = Rot.NLerp(sweep.Q1, sweep.Q2, context.Fraction)
Var lerped As Vector2 = Vector2.Lerp(sweep.C1, sweep.C2, context.Fraction)
Var cx As Double = lerped.X
Var cy As Double = lerped.Y
Var px As Double = cx - (q.C * sweep.LocalCenter.X - q.S * sweep.LocalCenter.Y)
Var py As Double = cy - (q.S * sweep.LocalCenter.X + q.C * sweep.LocalCenter.Y)

# Advance the body.
sims.QC.Items[bodySimIndex] = q.C
sims.QS.Items[bodySimIndex] = q.S
sims.PX.Items[bodySimIndex] = px
sims.PY.Items[bodySimIndex] = py
sims.CenterX.Items[bodySimIndex] = cx
sims.CenterY.Items[bodySimIndex] = cy
sims.R0C.Items[bodySimIndex] = q.C
sims.R0S.Items[bodySimIndex] = q.S
sims.C0X.Items[bodySimIndex] = cx
sims.C0Y.Items[bodySimIndex] = cy

# Update the body move event.
Me.mTransformScratch.P.Set(px, py)
Me.mTransformScratch.Q.SetComponents(q.C, q.S)
Var moveIndex As Integer = fastBody.MoveEventIndex
If moveIndex >= 0 Then
Me.MoveEventPXs.Items[moveIndex] = px
Me.MoveEventPYs.Items[moveIndex] = py
Me.MoveEventQCs.Items[moveIndex] = q.C
Me.MoveEventQSs.Items[moveIndex] = q.S
End If

# Refresh shape AABBs at the interpolated transform.
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE
Var aabbMargin As Double = PhysicsConstants.AABB_MARGIN
Var shapeId As Integer = fastBody.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
# Reuse the shape's owned AABB records to keep continuous collision
# allocation-free.
Var box As AABB = shape.AABB
Me.ComputeShapeAABBTo(shape, Me.mTransformScratch, box)
box.LowerBound.Set(box.LowerBound.X - speculativeDistance, box.LowerBound.Y - speculativeDistance)
box.UpperBound.Set(box.UpperBound.X + speculativeDistance, box.UpperBound.Y + speculativeDistance)
If AABB.Contains(shape.FatAABB, box) = False Then
shape.FatAABB.LowerBound.Set(box.LowerBound.X - aabbMargin, box.LowerBound.Y - aabbMargin)
shape.FatAABB.UpperBound.Set(box.UpperBound.X + aabbMargin, box.UpperBound.Y + aabbMargin)
shape.EnlargedAABB = True
sims.EnlargeAABB.Items[bodySimIndex] = 1
End If
shapeId = shape.NextShapeId
Wend
End Sub

## Advances a fast body with no time-of-impact hit, ported from the
## no-hit branch of b2SolveContinuous.
Private Sub AdvanceContinuousNoHit(fastBody As Body, bodySimIndex As Integer)
Var sims As BodySims = Me.SolverSets[PhysicsConstants.AWAKE_SET].Sims
sims.R0C.Items[bodySimIndex] = sims.QC.Items[bodySimIndex]
sims.R0S.Items[bodySimIndex] = sims.QS.Items[bodySimIndex]
sims.C0X.Items[bodySimIndex] = sims.CenterX.Items[bodySimIndex]
sims.C0Y.Items[bodySimIndex] = sims.CenterY.Items[bodySimIndex]

Var aabbMargin As Double = PhysicsConstants.AABB_MARGIN
Var shapeId As Integer = fastBody.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
If AABB.Contains(shape.FatAABB, shape.AABB) = False Then
shape.FatAABB.LowerBound.Set(shape.AABB.LowerBound.X - aabbMargin, shape.AABB.LowerBound.Y - aabbMargin)
shape.FatAABB.UpperBound.Set(shape.AABB.UpperBound.X + aabbMargin, shape.AABB.UpperBound.Y + aabbMargin)
shape.EnlargedAABB = True
sims.EnlargeAABB.Items[bodySimIndex] = 1
End If
shapeId = shape.NextShapeId
Wend
End Sub

## Interpolates a sweep transform at the given fraction, ported from
## b2GetSweepTransform.
Private Sub GetSweepTransformTo(sweep As Sweep, fraction As Double, out As Transform)
Var q As Rot = Rot.NLerp(sweep.Q1, sweep.Q2, fraction)
out.Q.SetComponents(q.C, q.S)
Var cx As Double = sweep.C1.X + (sweep.C2.X - sweep.C1.X) * fraction
Var cy As Double = sweep.C1.Y + (sweep.C2.Y - sweep.C1.Y) * fraction
out.P.Set(cx - (out.Q.C * sweep.LocalCenter.X - out.Q.S * sweep.LocalCenter.Y), cy - (out.Q.S * sweep.LocalCenter.X + out.Q.C * sweep.LocalCenter.Y))
End Sub

## Runs the narrow phase over every graph and awake contact, ported from
## b2Collide. Refreshes mass terms, recomputes manifolds, and collects the
## touching-state transitions for the serial update loop.
Private Sub CollideStep(context As StepContext)
Pragma Unused context
Var graph As ConstraintGraph = Me.ConstraintGraph

# Gather contact ids: colours first, then the awake set's non-touching
# store, matching upstream's gather order.
Me.mContactStateBits.SetCountAndClear(Me.ContactIdPool.IdCapacity())
Var colorIndex As Integer = 0
While colorIndex < PhysicsConstants.GRAPH_COLOUR_COUNT
Var color As GraphColor = graph.Colors[colorIndex]
Var simCount As Integer = color.ContactSims.Count()
Var i As Integer = 0
While i < simCount
Me.CollideOneContact(color.ContactSims.ContactId.Items[i], color.ContactSims)
i = i + 1
Wend
colorIndex = colorIndex + 1
Wend
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var awakeContactCount As Integer = awakeSet.ContactSims.Count()
Var j As Integer = 0
While j < awakeContactCount
Me.CollideOneContact(awakeSet.ContactSims.ContactId.Items[j], awakeSet.ContactSims)
j = j + 1
Wend

# Serial contact state changes, ported from the contact_state zone. The
# bit set yields contact ids in ascending order for determinism.
Var bitCount As Integer = Me.mContactStateBits.WordCount * 64
Var contactId As Integer = 0
While contactId < bitCount
If Me.mContactStateBits.GetBit(contactId) Then
Me.ApplyContactStateChange(Me.Contacts[contactId])
End If
contactId = contactId + 1
Wend
End Sub

## Updates one contact during the narrow phase, ported from the body of
## b2CollideTask.
Private Sub CollideOneContact(contactId As Integer, sims As ContactSims)
Var contact As Contact = Me.Contacts[contactId]
Var shapeA As Shape = Me.Shapes[contact.ShapeIdA]
Var shapeB As Shape = Me.Shapes[contact.ShapeIdB]

If AABB.Overlaps(shapeA.FatAABB, shapeB.FatAABB) = False Then
sims.SimFlags.Items[contact.LocalIndex] = sims.SimFlags.Items[contact.LocalIndex].BitOr(Integer(ContactFlags.SimDisjoint))
sims.SimFlags.Items[contact.LocalIndex] = sims.SimFlags.Items[contact.LocalIndex].BitAnd(Integer(ContactFlags.SimTouchingFlag).BitNot())
Me.mContactStateBits.SetBit(contactId)
Return
End If

Var bodyA As Body = Me.Bodies[shapeA.BodyId]
Var bodyB As Body = Me.Bodies[shapeB.BodyId]
Var bodySimA As BodySims = Me.GetBodySim(bodyA)
Var bodySimB As BodySims = Me.GetBodySim(bodyB)

# Refresh mass terms so the solver reads current values.
sims.BodySimIndexA.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.BodySimIndexA.Items[contact.LocalIndex] = bodyA.LocalIndex
End If
sims.InvMassA.Items[contact.LocalIndex] = bodySimA.InvMass.Items[bodyA.LocalIndex]
sims.InvIA.Items[contact.LocalIndex] = bodySimA.InvInertia.Items[bodyA.LocalIndex]
sims.BodySimIndexB.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.BodySimIndexB.Items[contact.LocalIndex] = bodyB.LocalIndex
End If
sims.InvMassB.Items[contact.LocalIndex] = bodySimB.InvMass.Items[bodyB.LocalIndex]
sims.InvIB.Items[contact.LocalIndex] = bodySimB.InvInertia.Items[bodyB.LocalIndex]

Var wasTouching As Boolean = sims.SimFlags.Items[contact.LocalIndex].BitAnd(Integer(ContactFlags.SimTouchingFlag)) <> 0
Me.GetBodyTransformTo(bodyA, Me.mTransformScratch)
Me.GetBodyTransformTo(bodyB, Me.mTransformScratchB)
Var transformA As Transform = Me.mTransformScratch
Var transformB As Transform = Me.mTransformScratchB
Var centerOffsetAX As Double = bodySimA.CenterX.Items[bodyA.LocalIndex] - bodySimA.PX.Items[bodyA.LocalIndex]
Var centerOffsetAY As Double = bodySimA.CenterY.Items[bodyA.LocalIndex] - bodySimA.PY.Items[bodyA.LocalIndex]
Var centerOffsetBX As Double = bodySimB.CenterX.Items[bodyB.LocalIndex] - bodySimB.PX.Items[bodyB.LocalIndex]
Var centerOffsetBY As Double = bodySimB.CenterY.Items[bodyB.LocalIndex] - bodySimB.PY.Items[bodyB.LocalIndex]

Var touching As Boolean = ContactMethods.UpdateContact(Me, contact, shapeA, transformA, centerOffsetAX, centerOffsetAY, shapeB, transformB, centerOffsetBX, centerOffsetBY)

If touching And wasTouching = False Then
sims.SimFlags.Items[contact.LocalIndex] = sims.SimFlags.Items[contact.LocalIndex].BitOr(Integer(ContactFlags.SimStartedTouching))
Me.mContactStateBits.SetBit(contactId)
ElseIf touching = False And wasTouching Then
sims.SimFlags.Items[contact.LocalIndex] = sims.SimFlags.Items[contact.LocalIndex].BitOr(Integer(ContactFlags.SimStoppedTouching))
Me.mContactStateBits.SetBit(contactId)
End If
End Sub

## Applies one collected touching-state transition, ported from the
## contact_state serial loop of b2Collide.
Private Sub ApplyContactStateChange(contact As Contact)
Var sims As ContactSims
If contact.ColorIndex <> PhysicsConstants.NULL_INDEX Then
sims = Me.ConstraintGraph.Colors[contact.ColorIndex].ContactSims
Else
sims = Me.SolverSets[contact.SetIndex].ContactSims
End If
Var simFlags As Integer = sims.SimFlags.Items[contact.LocalIndex]
Var shapeIdA As Integer = contact.ShapeIdA
Var shapeIdB As Integer = contact.ShapeIdB
Var genA As Integer = Me.ShapeGenerations.Items[shapeIdA]
Var genB As Integer = Me.ShapeGenerations.Items[shapeIdB]

If simFlags.BitAnd(Integer(ContactFlags.SimDisjoint)) <> 0 Then
sims.SimFlags.Items[contact.LocalIndex] = simFlags.BitAnd(Integer(ContactFlags.SimDisjoint).BitNot())
ContactMethods.DestroyContact(Me, contact, False)
Return
End If

If simFlags.BitAnd(Integer(ContactFlags.SimStartedTouching)) <> 0 Then
sims.SimFlags.Items[contact.LocalIndex] = simFlags.BitAnd(Integer(ContactFlags.SimStartedTouching).BitNot())
contact.Flags = contact.Flags.BitOr(Integer(ContactFlags.TouchingFlag))

# Contact begin event with a manifold snapshot, ported from
# b2World_Step's contact state loop. The solver's manifold object is
# pooled, so the event owns a copy.
If contact.Flags.BitAnd(Integer(ContactFlags.EnableContactEvents)) <> 0 Then
Var eventManifold As Manifold = sims.GetManifold(contact.LocalIndex)
Me.ContactBeginShapeAIds.Append(shapeIdA)
Me.ContactBeginShapeAGens.Append(genA)
Me.ContactBeginShapeBIds.Append(shapeIdB)
Me.ContactBeginShapeBGens.Append(genB)
Var snapshot As New Manifold
snapshot.AssignFrom(eventManifold)
Me.ContactBeginManifolds.Append(snapshot)
End If

IslandMethods.LinkContact(Me, contact)
GraphMethods.AddContactToGraph(Me, contact)
Return
End If

If simFlags.BitAnd(Integer(ContactFlags.SimStoppedTouching)) <> 0 Then
sims.SimFlags.Items[contact.LocalIndex] = simFlags.BitAnd(Integer(ContactFlags.SimStoppedTouching).BitNot())
contact.Flags = contact.Flags.BitAnd(Integer(ContactFlags.TouchingFlag).BitNot())

# Contact end event, ported from b2World_Step's contact state loop.
If contact.Flags.BitAnd(Integer(ContactFlags.EnableContactEvents)) <> 0 Then
Me.ContactEndShapeAIds[Me.EndEventWriteIndex].Append(shapeIdA)
Me.ContactEndShapeAGens[Me.EndEventWriteIndex].Append(genA)
Me.ContactEndShapeBIds[Me.EndEventWriteIndex].Append(shapeIdB)
Me.ContactEndShapeBGens[Me.EndEventWriteIndex].Append(genB)
End If

IslandMethods.UnlinkContact(Me, contact)
GraphMethods.MoveContactOutOfGraph(Me, contact)
Return
End If
End Sub

## Runs the constraint solve, body finalization, broad-phase refit, and
## island sleeping, ported from b2Solve.
Private Sub SolveStep(context As StepContext)
IslandMethods.MergeAwakeIslands(Me)

Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
If awakeSet.Sims.Count() = 0 Then
Return
End If

# Split a pending island. This invalidates island records, so re-read the
# awake set afterwards.
If Me.SplitIslandId <> PhysicsConstants.NULL_INDEX Then
IslandMethods.SplitIsland(Me, Me.SplitIslandId)
Me.SplitIslandId = PhysicsConstants.NULL_INDEX
awakeSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
End If

# Prepare constraints, ported from the stage order of b2Solve: colour
# joints, colour contacts, then the overflow colour for both.
Var colorIndex As Integer = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.PrepareColourJoints(Me, context, colorIndex)
colorIndex = colorIndex + 1
Wend
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.PrepareColorContacts(Me, context, colorIndex)
colorIndex = colorIndex + 1
Wend
SolverMethods.PrepareColourJoints(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX)
SolverMethods.PrepareColorContacts(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX)

Var subStepCount As Integer = context.SubStepCount
Var subStep As Integer = 0
While subStep < subStepCount
SolverMethods.IntegrateVelocities(Me, context)

# Warm start: overflow joints, then overflow contacts, then colours with
# joints first.
SolverMethods.WarmStartColourJoints(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX)
SolverMethods.WarmStartColorContacts(Me, PhysicsConstants.GRAPH_OVERFLOW_INDEX)
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.WarmStartColourJoints(Me, context, colorIndex)
SolverMethods.WarmStartColorContacts(Me, colorIndex)
colorIndex = colorIndex + 1
Wend

# Solve with bias: overflow joints, then overflow contacts, then colours
# with joints first. This matches the serial fallback of b2Solve and fixes
# the overflow colour being skipped.
SolverMethods.SolveColourJoints(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX, True)
SolverMethods.SolveColorContacts(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX, True)
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.SolveColourJoints(Me, context, colorIndex, True)
SolverMethods.SolveColorContacts(Me, context, colorIndex, True)
colorIndex = colorIndex + 1
Wend

SolverMethods.IntegratePositions(Me, context)

# Relax without bias: overflow first, then colours.
SolverMethods.SolveColourJoints(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX, False)
SolverMethods.SolveColorContacts(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX, False)
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.SolveColourJoints(Me, context, colorIndex, False)
SolverMethods.SolveColorContacts(Me, context, colorIndex, False)
colorIndex = colorIndex + 1
Wend

subStep = subStep + 1
Wend

# Restitution: overflow first, then colours.
SolverMethods.ApplyColorRestitution(Me, context, PhysicsConstants.GRAPH_OVERFLOW_INDEX)
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.ApplyColorRestitution(Me, context, colorIndex)
colorIndex = colorIndex + 1
Wend

# Store impulses: overflow first, then colours.
SolverMethods.StoreColorImpulses(Me, PhysicsConstants.GRAPH_OVERFLOW_INDEX)
colorIndex = 0
While colorIndex < PhysicsConstants.GRAPH_OVERFLOW_INDEX
SolverMethods.StoreColorImpulses(Me, colorIndex)
colorIndex = colorIndex + 1
Wend

Me.FinalizeBodies(context)
Me.CollectHitEvents()
Me.RefitBroadPhase()

# Bullet stage: fast bullet bodies resolve continuous collision after the
# refit, then enlarge their broad-phase proxies serially, ported from the
# bullet stage of b2Solve.
Var bulletCount As Integer = context.BulletBodies.Count
Var bulletIndex As Integer = 0
While bulletIndex < bulletCount
Me.SolveContinuous(context.BulletBodies.Items[bulletIndex])
bulletIndex = bulletIndex + 1
Wend
Var awakeSetAfterSolve As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
bulletIndex = 0
While bulletIndex < bulletCount
Var bulletSimIndex As Integer = context.BulletBodies.Items[bulletIndex]
If awakeSetAfterSolve.Sims.EnlargeAABB.Items[bulletSimIndex] <> 0 Then
awakeSetAfterSolve.Sims.EnlargeAABB.Items[bulletSimIndex] = 0
Var bulletBody As Body = Me.Bodies[awakeSetAfterSolve.Sims.BodyId.Items[bulletSimIndex]]
Var shapeId As Integer = bulletBody.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
If shape.EnlargedAABB Then
shape.EnlargedAABB = False
Me.BroadPhase.EnlargeProxy(shape.ProxyKey, shape.FatAABB)
End If
shapeId = shape.NextShapeId
Wend
End If
bulletIndex = bulletIndex + 1
Wend
context.BulletBodies.Clear()

# Island sleeping must run last because sleeping invalidates the enlarged
# body bits.
If Me.EnableSleeping Then
Me.SleepIslands()
End If
End Sub

## Applies solver results to awake bodies: transforms, sleep accounting,
## island wake bits, and shape AABBs, ported from b2FinalizeBodiesTask.
Private Sub FinalizeBodies(context As StepContext)
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var sims As BodySims = awakeSet.Sims
Var states As BodyStates = awakeSet.States
Var count As Integer = sims.Count()

Me.mAwakeIslandBits.SetCountAndClear(awakeSet.IslandIds.Count + 8)
Me.mEnlargedBodyBits.SetCountAndClear(count + 8)
Var splitIslandId As Integer = PhysicsConstants.NULL_INDEX
Var splitSleepTime As Double = 0.0

Var dt As Double = context.Dt
Var invDt As Double = context.InvDt

Var simIndex As Integer = 0
While simIndex < count
Var centerX As Double = sims.CenterX.Items[simIndex] + states.DPX.Items[simIndex]
Var centerY As Double = sims.CenterY.Items[simIndex] + states.DPY.Items[simIndex]

Var qc As Double = sims.QC.Items[simIndex]
Var qs As Double = sims.QS.Items[simIndex]
Var drc As Double = states.DRC.Items[simIndex]
Var drs As Double = states.DRS.Items[simIndex]
Var nqc As Double = drc * qc - drs * qs
Var nqs As Double = drs * qc + drc * qs
Var rotMag As Double = Maths.Sqrt(nqs * nqs + nqc * nqc)
Var invRotMag As Double = 0.0
If rotMag > 0.0 Then
invRotMag = 1.0 / rotMag
End If
qc = nqc * invRotMag
qs = nqs * invRotMag
sims.QC.Items[simIndex] = qc
sims.QS.Items[simIndex] = qs

Var vX As Double = states.LVX.Items[simIndex]
Var vY As Double = states.LVY.Items[simIndex]
Var w As Double = states.AngularVelocity.Items[simIndex]
Var maxExtent As Double = sims.MaxExtent.Items[simIndex]
Var maxVelocity As Double = Maths.Sqrt(vX * vX + vY * vY) + Maths.Abs(w) * maxExtent

Var deltaX As Double = states.DPX.Items[simIndex]
Var deltaY As Double = states.DPY.Items[simIndex]
Var maxDeltaPosition As Double = Maths.Sqrt(deltaX * deltaX + deltaY * deltaY) + Maths.Abs(drs) * maxExtent
Var sleepVelocity As Double = maxVelocity
If 0.5 * invDt * maxDeltaPosition > sleepVelocity Then
sleepVelocity = 0.5 * invDt * maxDeltaPosition
End If

# Reset state deltas.
states.DPX.Items[simIndex] = 0.0
states.DPY.Items[simIndex] = 0.0
states.DRC.Items[simIndex] = 1.0
states.DRS.Items[simIndex] = 0.0

Var lcx As Double = sims.LCX.Items[simIndex]
Var lcy As Double = sims.LCY.Items[simIndex]
Var px As Double = centerX - (qc * lcx - qs * lcy)
Var py As Double = centerY - (qs * lcx + qc * lcy)
sims.CenterX.Items[simIndex] = centerX
sims.CenterY.Items[simIndex] = centerY
sims.PX.Items[simIndex] = px
sims.PY.Items[simIndex] = py

Var body As Body = Me.Bodies[sims.BodyId.Items[simIndex]]

# Moved-body event, ported from the move event block of
# b2FinalizeBodiesTask. The fell-asleep flag is patched by island sleeping.
body.MoveEventIndex = simIndex
Me.MoveEventBodyIds.Append(sims.BodyId.Items[simIndex])
Me.MoveEventBodyGens.Append(body.Generation)
Me.MoveEventPXs.Append(px)
Me.MoveEventPYs.Append(py)
Me.MoveEventQCs.Append(qc)
Me.MoveEventQSs.Append(qs)
Me.MoveEventFellAsleep.Append(0)

body.IsSpeedCapped = sims.IsSpeedCapped.Items[simIndex] <> 0
sims.IsSpeedCapped.Items[simIndex] = 0
sims.IsFast.Items[simIndex] = 0

# Reset applied forces.
sims.ForceX.Items[simIndex] = 0.0
sims.ForceY.Items[simIndex] = 0.0
sims.Torque.Items[simIndex] = 0.0

If Me.EnableSleeping = False Or body.EnableSleep = False Or sleepVelocity > body.SleepThreshold Then
Me.FinalizeBodyAwake(context, sims, body, simIndex, centerX, centerY, qc, qs, maxVelocity, dt)
Else
# Body is safe to advance and is falling asleep.
sims.C0X.Items[simIndex] = centerX
sims.C0Y.Items[simIndex] = centerY
sims.R0C.Items[simIndex] = qc
sims.R0S.Items[simIndex] = qs
body.SleepTime = body.SleepTime + dt
End If

# Any single body in an island can keep it awake.
Var islandId As Integer = body.IslandId
If islandId <> PhysicsConstants.NULL_INDEX Then
Var island As Island = Me.Islands[islandId]
If body.SleepTime < PhysicsConstants.TIME_TO_SLEEP Then
Me.mAwakeIslandBits.SetBit(island.LocalIndex)
ElseIf island.ConstraintRemoveCount > 0 And body.SleepTime > splitSleepTime Then
splitIslandId = islandId
splitSleepTime = body.SleepTime
End If
End If

# Update shape AABBs.
Var isFast As Boolean = sims.IsFast.Items[simIndex] <> 0
If isFast Then
# For fast non-bullet bodies the AABB is already updated by
# SolveContinuous; fast bullet bodies are handled by the bullet stage.
# Mark the body regardless so the refit stage sees it.
Me.mEnlargedBodyBits.SetBit(simIndex)
Else
Me.UpdateAwakeBodyShapeAABBs(body, px, py, qc, qs, simIndex)
End If

simIndex = simIndex + 1
Wend

If splitIslandId <> PhysicsConstants.NULL_INDEX Then
Me.SplitIslandId = splitIslandId
End If
End Sub

## Recomputes speculative shape AABBs for one awake body after the solve
## and flags enlarged shapes, ported from the shape loop of
## b2FinalizeBodiesTask.
Private Sub UpdateAwakeBodyShapeAABBs(body As Body, px As Double, py As Double, qc As Double, qs As Double, simIndex As Integer)
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE
Var aabbMargin As Double = PhysicsConstants.AABB_MARGIN
Me.mTransformScratch.P.Set(px, py)
Me.mTransformScratch.Q.SetComponents(qc, qs)
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
# Reuse the shape's owned AABB records: mutating them in place keeps the
# per-frame finalize free of allocations.
Var box As AABB = shape.AABB
Me.ComputeShapeAABBTo(shape, Me.mTransformScratch, box)
box.LowerBound.Set(box.LowerBound.X - speculativeDistance, box.LowerBound.Y - speculativeDistance)
box.UpperBound.Set(box.UpperBound.X + speculativeDistance, box.UpperBound.Y + speculativeDistance)

If AABB.Contains(shape.FatAABB, box) = False Then
shape.FatAABB.LowerBound.Set(box.LowerBound.X - aabbMargin, box.LowerBound.Y - aabbMargin)
shape.FatAABB.UpperBound.Set(box.UpperBound.X + aabbMargin, box.UpperBound.Y + aabbMargin)
shape.EnlargedAABB = True
Me.mEnlargedBodyBits.SetBit(simIndex)
End If

shapeId = shape.NextShapeId
Wend
End Sub

## Applies sleep accounting and continuous collision handling to one awake
## body that has not crossed its sleep threshold, ported from the awake
## branch of b2FinalizeBodiesTask.
Private Sub FinalizeBodyAwake(context As StepContext, sims As BodySims, body As Body, simIndex As Integer, centerX As Double, centerY As Double, qc As Double, qs As Double, maxVelocity As Double, dt As Double)
body.SleepTime = 0.0
If body.Type = BodyType.DynamicBody And Me.ContinuousEnabled And maxVelocity * dt > 0.5 * sims.MinExtent.Items[simIndex] Then
# Fast body: continuous collision this step for plain bodies, or
# collect bullets for the post-refit bullet stage.
sims.IsFast.Items[simIndex] = 1
If sims.IsBullet.Items[simIndex] <> 0 Then
context.BulletBodies.Append(simIndex)
Else
Me.SolveContinuous(simIndex)
End If
Else
# Body is safe to advance.
sims.C0X.Items[simIndex] = centerX
sims.C0Y.Items[simIndex] = centerY
sims.R0C.Items[simIndex] = qc
sims.R0S.Items[simIndex] = qs
End If
End Sub

## Enlarges broad-phase proxies for shapes whose AABBs outgrew their fat
## bounds, ported from the refit stage of b2Solve.
Private Sub RefitBroadPhase()
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var wordCount As Integer = Me.mEnlargedBodyBits.WordCount * 64
Var simIndex As Integer = 0
While simIndex < wordCount
If Me.mEnlargedBodyBits.GetBit(simIndex) Then
Var body As Body = Me.Bodies[awakeSet.Sims.BodyId.Items[simIndex]]
Var fastBullet As Boolean = awakeSet.Sims.IsBullet.Items[simIndex] <> 0 And awakeSet.Sims.IsFast.Items[simIndex] <> 0
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
If fastBullet Then
# Fast bullet bodies do not have their final AABB yet, so
# every shape goes into the move array for determinism.
Me.BroadPhase.BufferMove(shape.ProxyKey)
ElseIf shape.EnlargedAABB Then
Me.BroadPhase.EnlargeProxy(shape.ProxyKey, shape.FatAABB)
shape.EnlargedAABB = False
End If
shapeId = shape.NextShapeId
Wend
End If
simIndex = simIndex + 1
Wend
End Sub

## Moves islands whose bodies all exceeded the sleep threshold to sleeping
## solver sets, ported from the island-sleep stage of b2Solve.
Private Sub SleepIslands()
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var count As Integer = awakeSet.IslandIds.Count

# Reverse order because sleeping removes islands from this store.
Var islandIndex As Integer = count - 1
While islandIndex >= 0
If Me.mAwakeIslandBits.GetBit(islandIndex) = False Then
Me.TrySleepIsland(awakeSet.IslandIds.Items[islandIndex])
End If
islandIndex = islandIndex - 1
Wend
End Sub

# ------------------------------------------------------------------
# Body lifecycle
# ------------------------------------------------------------------

## Creates a body, ported from b2CreateBody. Throws when the world is
## locked or the definition is missing or invalid.
Function CreateBody(def As BodyDefinition) As Body
Me.CheckDefinition(def, "BodyDefinition")
Me.CheckNotLocked()
If Not def.Position.X.IsFinite() Or Not def.Position.Y.IsFinite() Then
Throw New InvalidArgumentException("BodyDefinition position must be finite")
End If
If Not def.LinearVelocity.X.IsFinite() Or Not def.LinearVelocity.Y.IsFinite() Then
Throw New InvalidArgumentException("BodyDefinition linear velocity must be finite")
End If
If Not def.AngularVelocity.IsFinite() Or Not def.LinearDamping.IsFinite() Or def.LinearDamping < 0.0 Then
Throw New InvalidArgumentException("BodyDefinition angular velocity and damping must be valid")
End If
If Not def.GravityScale.IsFinite() Or Not def.SleepThreshold.IsFinite() Or def.SleepThreshold < 0.0 Then
Throw New InvalidArgumentException("BodyDefinition gravity scale and sleep threshold must be valid")
End If
If Not Rot.IsValid(def.Rotation) Then
Throw New InvalidArgumentException("BodyDefinition rotation must be a valid unit rotation")
End If

Var isAwake As Boolean = (def.IsAwake Or Not def.EnableSleep) And def.IsEnabled

# Determine the solver set.
Var setId As Integer = 0
If Not def.IsEnabled Then
setId = 1
ElseIf def.Type = BodyType.StaticBody Then
setId = 0
ElseIf isAwake Then
setId = 2
Else
setId = Me.AllocSleepingSet()
End If

Var bodyId As Integer = Me.BodyIdPool.AllocId()
If bodyId = Me.Bodies.Count Then
Me.Bodies.Append(New Body)
Else
Me.Bodies[bodyId] = New Body
End If
Var body As Body = Me.Bodies[bodyId]

Var solverSet As SolverSet = Me.SolverSets[setId]
Var localIndex As Integer = solverSet.Sims.Add()
solverSet.Sims.PX.Items[localIndex] = def.Position.X
solverSet.Sims.PY.Items[localIndex] = def.Position.Y
solverSet.Sims.QC.Items[localIndex] = def.Rotation.C
solverSet.Sims.QS.Items[localIndex] = def.Rotation.S
solverSet.Sims.CenterX.Items[localIndex] = def.Position.X
solverSet.Sims.CenterY.Items[localIndex] = def.Position.Y
solverSet.Sims.R0C.Items[localIndex] = def.Rotation.C
solverSet.Sims.R0S.Items[localIndex] = def.Rotation.S
solverSet.Sims.C0X.Items[localIndex] = def.Position.X
solverSet.Sims.C0Y.Items[localIndex] = def.Position.Y
solverSet.Sims.MinExtent.Items[localIndex] = PhysicsConstants.POSITION_LIMIT
solverSet.Sims.MaxExtent.Items[localIndex] = 0.0
solverSet.Sims.LinearDamping.Items[localIndex] = def.LinearDamping
solverSet.Sims.AngularDamping.Items[localIndex] = def.AngularDamping
solverSet.Sims.GravityScale.Items[localIndex] = def.GravityScale
solverSet.Sims.BodyId.Items[localIndex] = bodyId
solverSet.Sims.IsBullet.Items[localIndex] = 0
If def.IsBullet Then
solverSet.Sims.IsBullet.Items[localIndex] = 1
End If
solverSet.Sims.AllowFastRotation.Items[localIndex] = 0
If def.AllowFastRotation Then
solverSet.Sims.AllowFastRotation.Items[localIndex] = 1
End If

If setId = 2 Then
Var stateIndex As Integer = solverSet.States.Add()
solverSet.States.LVX.Items[stateIndex] = def.LinearVelocity.X
solverSet.States.LVY.Items[stateIndex] = def.LinearVelocity.Y
solverSet.States.AngularVelocity.Items[stateIndex] = def.AngularVelocity
End If

body.Owner = Me
body.Id = bodyId
If bodyId = Me.BodyGenerations.Count Then
Me.BodyGenerations.Append(0)
End If
body.Generation = Me.BodyGenerations.Items[bodyId] + 1
Me.BodyGenerations.Items[bodyId] = body.Generation
body.Live = True
body.SetIndex = setId
body.LocalIndex = localIndex
body.HeadShapeId = PhysicsConstants.NULL_INDEX
body.ShapeCount = 0
body.HeadChainId = PhysicsConstants.NULL_INDEX
body.HeadContactKey = PhysicsConstants.NULL_INDEX
body.ContactCount = 0
body.IslandId = PhysicsConstants.NULL_INDEX
body.IslandPrev = PhysicsConstants.NULL_INDEX
body.IslandNext = PhysicsConstants.NULL_INDEX
body.Mass = 0.0
body.Inertia = 0.0
body.SleepThreshold = def.SleepThreshold
body.SleepTime = 0.0
body.Type = def.Type
body.EnableSleep = def.EnableSleep
body.FixedRotation = def.FixedRotation
body.IsSpeedCapped = False
body.IsMarked = False
body.UserData = def.UserData
If setId >= PhysicsConstants.AWAKE_SET Then
IslandMethods.CreateIslandForBody(Me, setId, body)
End If
Me.SetBodyName(body, def.Name)
Return body
End Function

## Installs a body name with the upstream 31-character truncation.
Private Sub SetBodyName(body As Body, name As String)
If name = Nothing Then
body.Name = ""
Return
End If
If name.Length > 31 Then
body.Name = name.Substring(0, 31)
Return
End If
body.Name = name
End Sub

## Allocates a per-island sleeping solver set, ported from the sleeping set
## creation inside b2CreateBody.
Private Function AllocSleepingSet() As Integer
Var setId As Integer = Me.SolverSetIdPool.AllocId()
Var solverSet As SolverSet = Nothing
If Me.mSolverSetPool.Count > 0 Then
solverSet = Me.mSolverSetPool[Me.mSolverSetPool.Count - 1]
Me.mSolverSetPool.RemoveAt(Me.mSolverSetPool.Count - 1)
Else
solverSet = New SolverSet(setId, False)
End If
solverSet.SetIndex = setId
If setId = Me.SolverSets.Count Then
Me.SolverSets.Append(solverSet)
Else
Me.SolverSets[setId] = solverSet
End If
Return setId
End Function

## Destroys a body with its shapes and chains, ported from b2DestroyBody.
## Called by Body.Destroy; throws when the world is locked.
Sub DestroyBody(body As Body)
Me.CheckNotLocked()
Me.ValidateBody(body)

# Wake bodies attached to this body, even if this body is static. Destroy
# the attached joints first, ported from b2DestroyBody.
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
If edgeIndex = 0 Then
jointKey = joint.Edge0NextKey
Else
jointKey = joint.Edge1NextKey
End If

# Careful because this modifies the list being traversed.
Me.DestroyJointInternal(joint, True)
Wend

# Destroy attached contacts first, ported from b2DestroyBodyInternal.
ContactMethods.DestroyBodyContacts(Me, body, True)

# Destroy attached shapes and their proxies.
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
Me.DestroyShapeProxy(shape)
Me.ShapeIdPool.FreeId(shape.Id)
shape.Live = False
Me.ShapeGenerations.Items[shape.Id] = Me.ShapeGenerations.Items[shape.Id] + 1
shape.Generation = Me.ShapeGenerations.Items[shape.Id]
Me.Shapes[shape.Id] = Nothing
shape.Id = PhysicsConstants.NULL_INDEX
shape.BodyId = PhysicsConstants.NULL_INDEX
Wend

# Destroy attached chains. Their segment shapes were destroyed above.
Var chainId As Integer = body.HeadChainId
While chainId <> PhysicsConstants.NULL_INDEX
Var chain As Chain = Me.Chains[chainId]
chainId = chain.NextChainId
Me.ChainIdPool.FreeId(chain.Id)
chain.Live = False
Me.ChainGenerations.Items[chain.Id] = Me.ChainGenerations.Items[chain.Id] + 1
chain.Generation = Me.ChainGenerations.Items[chain.Id]
Me.Chains[chain.Id] = Nothing
chain.Id = PhysicsConstants.NULL_INDEX
chain.BodyId = PhysicsConstants.NULL_INDEX
Wend

# Remove the body from its island, destroying the island when empty.
IslandMethods.RemoveBodyFromIsland(Me, body)

# Remove the sim record from the owning solver set.
Var solverSet As SolverSet = Me.SolverSets[body.SetIndex]
Var localIndex As Integer = body.LocalIndex
Var movedIndex As Integer = solverSet.Sims.RemoveSwap(localIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedId As Integer = solverSet.Sims.BodyId.Items[localIndex]
Me.Bodies[movedId].LocalIndex = localIndex
End If
If body.SetIndex = 2 Then
Var stateMoved As Integer = solverSet.States.RemoveSwap(localIndex)
If stateMoved <> movedIndex Then
Throw New RuntimeException("Body state and sim removal disagree")
End If
ElseIf body.SetIndex >= 3 And solverSet.Sims.Count() = 0 Then
Me.DestroySolverSet(body.SetIndex)
End If

Me.BodyIdPool.FreeId(body.Id)
body.Live = False
Me.BodyGenerations.Items[body.Id] = Me.BodyGenerations.Items[body.Id] + 1
body.Generation = Me.BodyGenerations.Items[body.Id]
Me.Bodies[body.Id] = Nothing
body.SetIndex = PhysicsConstants.NULL_INDEX
body.LocalIndex = PhysicsConstants.NULL_INDEX
body.Id = PhysicsConstants.NULL_INDEX
End Sub

## Frees a sleeping solver set that no longer holds bodies, ported from
## b2DestroySolverSet.
Private Sub DestroySolverSet(setIndex As Integer)
Var solverSet As SolverSet = Me.SolverSets[setIndex]
Me.SolverSetIdPool.FreeId(setIndex)
solverSet.SetIndex = PhysicsConstants.NULL_INDEX
Me.SolverSets[setIndex] = Nothing
solverSet.ClearAll()
Me.mSolverSetPool.Append(solverSet)
End Sub

## Moves a body between solver sets, ported from b2TransferBody. Only used
## within the world.
Private Sub TransferBody(targetSet As SolverSet, sourceSet As SolverSet, body As Body)
If targetSet = sourceSet Then
Throw New RuntimeException("TransferBody target and source must differ")
End If
Var sourceIndex As Integer = body.LocalIndex
Var targetIndex As Integer = targetSet.Sims.Count()
targetSet.Sims.Add()
targetSet.Sims.CopyRecordTo(targetIndex, sourceSet.Sims, sourceIndex)

Var movedIndex As Integer = sourceSet.Sims.RemoveSwap(sourceIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedId As Integer = sourceSet.Sims.BodyId.Items[sourceIndex]
Me.Bodies[movedId].LocalIndex = sourceIndex
End If

If sourceSet.SetIndex = 2 Then
sourceSet.States.RemoveSwap(sourceIndex)
ElseIf targetSet.SetIndex = 2 Then
targetSet.States.Add()
End If

body.SetIndex = targetSet.SetIndex
body.LocalIndex = targetIndex
End Sub

## Wakes a sleeping solver set into the awake set, ported from
## b2WakeSolverSet. Non-touching contacts move from the disabled set into
## the awake set, sleeping contacts and islands migrate wholesale, and the
## emptied sleeping set is destroyed. Joint and constraint-graph work
## arrives with Stages 9 and the step.
## Returns the dense joint store that owns this joint's row, ported from
## b2GetJointSim. Awake joints live in graph colours; every other set stores
## its joints directly. Index the row with joint.LocalIndex.
Function GetJointSims(joint As Joint) As JointSims
If joint.SetIndex = PhysicsConstants.AWAKE_SET Then
Var color As GraphColor = Me.ConstraintGraph.Colors[joint.ColorIndex]
Return color.JointSims
End If
Var ownerSet As SolverSet = Me.SolverSets[joint.SetIndex]
Return ownerSet.JointSims
End Function

## Creates the joint record and links it into both bodies' edge lists, ported
## from the record and edge section of b2CreateJoint. Returns the record for
## the set-placement step. The Joint constructor owns the lifecycle
## sentinels; only creation-specific state is assigned here.
Private Function CreateJointRecord(bodyA As Body, bodyB As Body, jointType As JointType, collideConnected As Boolean, drawSize As Double) As Joint
Var jointId As Integer = Me.JointIdPool.AllocId()
Var record As Joint
If jointType = JointType.DistanceJoint Then
record = New DistanceJoint
ElseIf jointType = JointType.MouseJoint Then
record = New MouseJoint
ElseIf jointType = JointType.MotorJoint Then
record = New MotorJoint
ElseIf jointType = JointType.RevoluteJoint Then
record = New RevoluteJoint
ElseIf jointType = JointType.PrismaticJoint Then
record = New PrismaticJoint
ElseIf jointType = JointType.WeldJoint Then
record = New WeldJoint
Else
record = New Joint
End If
If jointId = Me.Joints.Count Then
Me.Joints.Append(record)
Else
Me.Joints[jointId] = record
End If
If jointId = Me.JointGenerations.Count Then
Me.JointGenerations.Append(0)
End If
record.Owner = Me
record.Id = jointId
record.Live = True
record.Generation = Me.JointGenerations.Items[jointId] + 1
Me.JointGenerations.Items[jointId] = record.Generation
record.Type = jointType
record.CollideConnected = collideConnected
record.DrawSize = drawSize
Me.JointCount = Me.JointCount + 1

# Doubly linked list on body A.
record.Edge0BodyId = bodyA.Id
record.Edge0PrevKey = PhysicsConstants.NULL_INDEX
record.Edge0NextKey = bodyA.HeadJointKey
Var keyA As Integer = jointId.ShiftLeft(1)
If bodyA.HeadJointKey <> PhysicsConstants.NULL_INDEX Then
Var jointA As Joint = Me.Joints[bodyA.HeadJointKey.ShiftRight(1)]
Var edgeAIndex As Integer = bodyA.HeadJointKey.BitAnd(1)
If edgeAIndex = 0 Then
jointA.Edge0PrevKey = keyA
Else
jointA.Edge1PrevKey = keyA
End If
End If
bodyA.HeadJointKey = keyA
bodyA.JointCount = bodyA.JointCount + 1

# Doubly linked list on body B.
record.Edge1BodyId = bodyB.Id
record.Edge1PrevKey = PhysicsConstants.NULL_INDEX
record.Edge1NextKey = bodyB.HeadJointKey
Var keyB As Integer = jointId.ShiftLeft(1) + 1
If bodyB.HeadJointKey <> PhysicsConstants.NULL_INDEX Then
Var jointB As Joint = Me.Joints[bodyB.HeadJointKey.ShiftRight(1)]
Var edgeBIndex As Integer = bodyB.HeadJointKey.BitAnd(1)
If edgeBIndex = 0 Then
jointB.Edge0PrevKey = keyB
Else
jointB.Edge1PrevKey = keyB
End If
End If
bodyB.HeadJointKey = keyB
bodyB.JointCount = bodyB.JointCount + 1
Return record
End Function

## Places a fresh joint sim row in the solver set or graph colour implied by
## its bodies, ported from the placement section of b2CreateJoint. Returns
## the row's local index. The row carries the joint's identity columns;
## family creation paths fill the family columns.
Private Function PlaceJointSim(joint As Joint, bodyA As Body, bodyB As Body) As Integer
If bodyA.SetIndex = PhysicsConstants.DISABLED_SET Or bodyB.SetIndex = PhysicsConstants.DISABLED_SET Then
# If either body is disabled, create in the disabled set.
Var disabledSet As SolverSet = Me.SolverSets[PhysicsConstants.DISABLED_SET]
joint.SetIndex = PhysicsConstants.DISABLED_SET
joint.LocalIndex = disabledSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
ElseIf bodyA.SetIndex = PhysicsConstants.STATIC_SET And bodyB.SetIndex = PhysicsConstants.STATIC_SET Then
# Joint is connecting static bodies.
Var staticSet As SolverSet = Me.SolverSets[PhysicsConstants.STATIC_SET]
joint.SetIndex = PhysicsConstants.STATIC_SET
joint.LocalIndex = staticSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
ElseIf bodyA.SetIndex = PhysicsConstants.AWAKE_SET Or bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
# If either body is sleeping, wake it.
Var maxSetIndex As Integer = bodyA.SetIndex
If bodyB.SetIndex > maxSetIndex Then
maxSetIndex = bodyB.SetIndex
End If
If maxSetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
Me.WakeSolverSet(maxSetIndex)
End If
joint.SetIndex = PhysicsConstants.AWAKE_SET
GraphMethods.CreateJointInGraph(Me, joint)
Else
# Joint connected between sleeping and/or static bodies goes into the
# sleeping set, merging the two sets when both are sleeping.
Var setIndex As Integer = bodyA.SetIndex
If bodyB.SetIndex > setIndex Then
setIndex = bodyB.SetIndex
End If
Var sleepSet As SolverSet = Me.SolverSets[setIndex]
joint.SetIndex = setIndex
joint.LocalIndex = sleepSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
If bodyA.SetIndex <> bodyB.SetIndex And bodyA.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET And bodyB.SetIndex >= PhysicsConstants.FIRST_SLEEPING_SET Then
Me.MergeSolverSets(bodyA.SetIndex, bodyB.SetIndex)
joint.SetIndex = bodyA.SetIndex
End If
End If
Return joint.LocalIndex
End Function

## Creates a distance joint, ported from b2CreateDistanceJoint. Throws on a
## missing definition, missing or foreign bodies, or a non-positive finite
## length. A body must be live and owned by this world: a live body from
## another world can carry an id and generation that would look valid here.
Function CreateDistanceJoint(def As DistanceJointDefinition) As DistanceJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "DistanceJointDefinition")
Me.CheckJointBody(def.BodyA, "DistanceJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "DistanceJointDefinition.BodyB")
If Not def.Length.IsFinite() Or def.Length <= 0.0 Then
Throw New InvalidArgumentException("DistanceJointDefinition length must be finite and positive")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.DistanceJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
store.LocalOriginAnchorAX.Items[localIndex] = def.LocalAnchorA.X
store.LocalOriginAnchorAY.Items[localIndex] = def.LocalAnchorA.Y
store.LocalOriginAnchorBX.Items[localIndex] = def.LocalAnchorB.X
store.LocalOriginAnchorBY.Items[localIndex] = def.LocalAnchorB.Y
Var minLength As Double = def.MinLength
If minLength < PhysicsConstants.LINEAR_SLOP Then
minLength = PhysicsConstants.LINEAR_SLOP
End If
Var maxLength As Double = def.MaxLength
If minLength > maxLength Then
maxLength = minLength
End If
store.Length.Items[localIndex] = def.Length
If store.Length.Items[localIndex] < PhysicsConstants.LINEAR_SLOP Then
store.Length.Items[localIndex] = PhysicsConstants.LINEAR_SLOP
End If
store.Hertz.Items[localIndex] = def.Hertz
store.DampingRatio.Items[localIndex] = def.DampingRatio
store.MinLength.Items[localIndex] = minLength
store.MaxLength.Items[localIndex] = maxLength
store.MaxMotorForce.Items[localIndex] = def.MaxMotorForce
store.MotorSpeed.Items[localIndex] = def.MotorSpeed
If def.EnableSpring Then
store.EnableSpring.Items[localIndex] = 1
End If
If def.EnableLimit Then
store.EnableLimit.Items[localIndex] = 1
End If
If def.EnableMotor Then
store.EnableMotor.Items[localIndex] = 1
End If
store.Impulse.Items[localIndex] = 0.0
store.LowerImpulse.Items[localIndex] = 0.0
store.UpperImpulse.Items[localIndex] = 0.0
store.MotorImpulse.Items[localIndex] = 0.0
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As DistanceJoint = DistanceJoint(joint)
Return facade
End Function

## Creates a mouse joint, ported from b2CreateMouseJoint. Throws on a
## missing definition, missing or foreign bodies, or non-finite or negative
## tuning values. Body A is assumed static, as upstream documents; a moving
## body B drives the constraint, and a non-dynamic body B simply receives
## no impulse (its constraint mass is zero), matching upstream's singular
## inverse-mass handling. The mouse joint anchors both bodies at the target
## point: localOriginAnchorA and localOriginAnchorB are both the target
## transformed into each body's local frame.
Function CreateMouseJoint(def As MouseJointDefinition) As MouseJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "MouseJointDefinition")
Me.CheckJointBody(def.BodyA, "MouseJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "MouseJointDefinition.BodyB")
If Not def.Target.X.IsFinite() Or Not def.Target.Y.IsFinite() Then
Throw New InvalidArgumentException("MouseJointDefinition target must be finite")
End If
If Not def.Hertz.IsFinite() Or def.Hertz < 0.0 Then
Throw New InvalidArgumentException("MouseJointDefinition hertz must be finite and non-negative")
End If
If Not def.DampingRatio.IsFinite() Or def.DampingRatio < 0.0 Then
Throw New InvalidArgumentException("MouseJointDefinition damping ratio must be finite and non-negative")
End If
If Not def.MaxForce.IsFinite() Or def.MaxForce < 0.0 Then
Throw New InvalidArgumentException("MouseJointDefinition max force must be finite and non-negative")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.MouseJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
Var transformA As Transform = Me.GetBodyTransformById(joint.Edge0BodyId)
Var transformB As Transform = Me.GetBodyTransformById(joint.Edge1BodyId)
Var localAnchorA As Vector2 = Transform.InvTransformPoint(transformA, def.Target)
Var localAnchorB As Vector2 = Transform.InvTransformPoint(transformB, def.Target)
store.LocalOriginAnchorAX.Items[localIndex] = localAnchorA.X
store.LocalOriginAnchorAY.Items[localIndex] = localAnchorA.Y
store.LocalOriginAnchorBX.Items[localIndex] = localAnchorB.X
store.LocalOriginAnchorBY.Items[localIndex] = localAnchorB.Y
store.MouseTargetX.Items[localIndex] = def.Target.X
store.MouseTargetY.Items[localIndex] = def.Target.Y
store.MouseHertz.Items[localIndex] = def.Hertz
store.MouseDampingRatio.Items[localIndex] = def.DampingRatio
store.MouseMaxForce.Items[localIndex] = def.MaxForce
store.MouseLinearImpulseX.Items[localIndex] = 0.0
store.MouseLinearImpulseY.Items[localIndex] = 0.0
store.MouseAngularImpulse.Items[localIndex] = 0.0
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As MouseJoint = MouseJoint(joint)
Return facade
End Function

## Creates a motor joint, ported from b2CreateMotorJoint. Throws on a
## missing definition, missing or foreign bodies, or non-finite or negative
## force or torque values. The correction factor clamps into [0, 1] like
## upstream. The joint has no anchors: localOriginAnchorA and
## localOriginAnchorB stay at the body origins, and the constraint drives
## body B toward the offset pose relative to body A.
Function CreateMotorJoint(def As MotorJointDefinition) As MotorJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "MotorJointDefinition")
Me.CheckJointBody(def.BodyA, "MotorJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "MotorJointDefinition.BodyB")
If Not def.LinearOffset.X.IsFinite() Or Not def.LinearOffset.Y.IsFinite() Then
Throw New InvalidArgumentException("MotorJointDefinition linear offset must be finite")
End If
If Not def.AngularOffset.IsFinite() Then
Throw New InvalidArgumentException("MotorJointDefinition angular offset must be finite")
End If
If Not def.MaxForce.IsFinite() Or def.MaxForce < 0.0 Then
Throw New InvalidArgumentException("MotorJointDefinition max force must be finite and non-negative")
End If
If Not def.MaxTorque.IsFinite() Or def.MaxTorque < 0.0 Then
Throw New InvalidArgumentException("MotorJointDefinition max torque must be finite and non-negative")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.MotorJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
store.MotorLinearOffsetX.Items[localIndex] = def.LinearOffset.X
store.MotorLinearOffsetY.Items[localIndex] = def.LinearOffset.Y
store.MotorAngularOffset.Items[localIndex] = def.AngularOffset
store.MotorMaxForce.Items[localIndex] = def.MaxForce
store.MotorMaxTorque.Items[localIndex] = def.MaxTorque
Var correctionFactor As Double = def.CorrectionFactor
If correctionFactor < 0.0 Then
correctionFactor = 0.0
ElseIf correctionFactor > 1.0 Then
correctionFactor = 1.0
End If
store.MotorCorrectionFactor.Items[localIndex] = correctionFactor
store.MotorLinearImpulseX.Items[localIndex] = 0.0
store.MotorLinearImpulseY.Items[localIndex] = 0.0
store.MotorAngularImpulse.Items[localIndex] = 0.0
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As MotorJoint = MotorJoint(joint)
Return facade
End Function

## Creates a revolute joint, ported from b2CreateRevoluteJoint. Throws on a
## missing definition, missing or foreign bodies, non-finite anchors or
## tuning, a lower limit above the upper limit, or limits outside
## [-0.99 pi, 0.99 pi], matching the upstream assertions. The reference and
## target angles clamp into [-pi, pi] like upstream. The hinge pins the two
## local anchors together at one world point.
Function CreateRevoluteJoint(def As RevoluteJointDefinition) As RevoluteJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "RevoluteJointDefinition")
Me.CheckJointBody(def.BodyA, "RevoluteJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "RevoluteJointDefinition.BodyB")
If Not def.LocalAnchorA.X.IsFinite() Or Not def.LocalAnchorA.Y.IsFinite() Then
Throw New InvalidArgumentException("RevoluteJointDefinition local anchor A must be finite")
End If
If Not def.LocalAnchorB.X.IsFinite() Or Not def.LocalAnchorB.Y.IsFinite() Then
Throw New InvalidArgumentException("RevoluteJointDefinition local anchor B must be finite")
End If
If Not def.ReferenceAngle.IsFinite() Or Not def.TargetAngle.IsFinite() Then
Throw New InvalidArgumentException("RevoluteJointDefinition reference and target angles must be finite")
End If
If Not def.Hertz.IsFinite() Or def.Hertz < 0.0 Then
Throw New InvalidArgumentException("RevoluteJointDefinition hertz must be finite and non-negative")
End If
If Not def.DampingRatio.IsFinite() Or def.DampingRatio < 0.0 Then
Throw New InvalidArgumentException("RevoluteJointDefinition damping ratio must be finite and non-negative")
End If
If Not def.MaxMotorTorque.IsFinite() Or def.MaxMotorTorque < 0.0 Then
Throw New InvalidArgumentException("RevoluteJointDefinition max motor torque must be finite and non-negative")
End If
If Not def.MotorSpeed.IsFinite() Then
Throw New InvalidArgumentException("RevoluteJointDefinition motor speed must be finite")
End If
If Not def.LowerAngle.IsFinite() Or Not def.UpperAngle.IsFinite() Then
Throw New InvalidArgumentException("RevoluteJointDefinition limits must be finite")
End If
If def.LowerAngle > def.UpperAngle Then
Throw New InvalidArgumentException("RevoluteJointDefinition lower limit must not exceed the upper limit")
End If
If def.LowerAngle < -0.99 * PhysicsConstants.PI Or def.UpperAngle > 0.99 * PhysicsConstants.PI Then
Throw New InvalidArgumentException("RevoluteJointDefinition limits must lie within [-0.99 pi, 0.99 pi]")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.RevoluteJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
store.LocalOriginAnchorAX.Items[localIndex] = def.LocalAnchorA.X
store.LocalOriginAnchorAY.Items[localIndex] = def.LocalAnchorA.Y
store.LocalOriginAnchorBX.Items[localIndex] = def.LocalAnchorB.X
store.LocalOriginAnchorBY.Items[localIndex] = def.LocalAnchorB.Y
# Upstream clamps the reference and target angles into [-pi, pi].
Var referenceAngle As Double = def.ReferenceAngle
If referenceAngle < -PhysicsConstants.PI Then
referenceAngle = -PhysicsConstants.PI
ElseIf referenceAngle > PhysicsConstants.PI Then
referenceAngle = PhysicsConstants.PI
End If
store.RevoluteReferenceAngle.Items[localIndex] = referenceAngle
Var targetAngle As Double = def.TargetAngle
If targetAngle < -PhysicsConstants.PI Then
targetAngle = -PhysicsConstants.PI
ElseIf targetAngle > PhysicsConstants.PI Then
targetAngle = PhysicsConstants.PI
End If
store.RevoluteTargetAngle.Items[localIndex] = targetAngle
store.RevoluteHertz.Items[localIndex] = def.Hertz
store.RevoluteDampingRatio.Items[localIndex] = def.DampingRatio
store.RevoluteLowerAngle.Items[localIndex] = def.LowerAngle
store.RevoluteUpperAngle.Items[localIndex] = def.UpperAngle
store.RevoluteMaxMotorTorque.Items[localIndex] = def.MaxMotorTorque
store.RevoluteMotorSpeed.Items[localIndex] = def.MotorSpeed
store.EnableSpring.Items[localIndex] = 0
store.EnableLimit.Items[localIndex] = 0
store.EnableMotor.Items[localIndex] = 0
If def.EnableSpring Then
store.EnableSpring.Items[localIndex] = 1
End If
If def.EnableLimit Then
store.EnableLimit.Items[localIndex] = 1
End If
If def.EnableMotor Then
store.EnableMotor.Items[localIndex] = 1
End If
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As RevoluteJoint = RevoluteJoint(joint)
Return facade
End Function

## Creates a prismatic joint, ported from b2CreatePrismaticJoint. Throws on
## a missing definition, missing or foreign bodies, non-finite anchors,
## axis, or tuning, or a lower translation limit above the upper limit,
## matching the upstream assertions. The local axis normalizes at creation
## like upstream b2Normalize, and a zero axis stays zero.
Function CreatePrismaticJoint(def As PrismaticJointDefinition) As PrismaticJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "PrismaticJointDefinition")
Me.CheckJointBody(def.BodyA, "PrismaticJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "PrismaticJointDefinition.BodyB")
If Not def.LocalAnchorA.X.IsFinite() Or Not def.LocalAnchorA.Y.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition local anchor A must be finite")
End If
If Not def.LocalAnchorB.X.IsFinite() Or Not def.LocalAnchorB.Y.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition local anchor B must be finite")
End If
If Not def.LocalAxisA.X.IsFinite() Or Not def.LocalAxisA.Y.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition local axis must be finite")
End If
If Not def.ReferenceAngle.IsFinite() Or Not def.TargetTranslation.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition reference angle and target translation must be finite")
End If
If Not def.Hertz.IsFinite() Or def.Hertz < 0.0 Then
Throw New InvalidArgumentException("PrismaticJointDefinition hertz must be finite and non-negative")
End If
If Not def.DampingRatio.IsFinite() Or def.DampingRatio < 0.0 Then
Throw New InvalidArgumentException("PrismaticJointDefinition damping ratio must be finite and non-negative")
End If
If Not def.MaxMotorForce.IsFinite() Or def.MaxMotorForce < 0.0 Then
Throw New InvalidArgumentException("PrismaticJointDefinition max motor force must be finite and non-negative")
End If
If Not def.MotorSpeed.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition motor speed must be finite")
End If
If Not def.LowerTranslation.IsFinite() Or Not def.UpperTranslation.IsFinite() Then
Throw New InvalidArgumentException("PrismaticJointDefinition limits must be finite")
End If
If def.LowerTranslation > def.UpperTranslation Then
Throw New InvalidArgumentException("PrismaticJointDefinition lower limit must not exceed the upper limit")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.PrismaticJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
store.LocalOriginAnchorAX.Items[localIndex] = def.LocalAnchorA.X
store.LocalOriginAnchorAY.Items[localIndex] = def.LocalAnchorA.Y
store.LocalOriginAnchorBX.Items[localIndex] = def.LocalAnchorB.X
store.LocalOriginAnchorBY.Items[localIndex] = def.LocalAnchorB.Y
# Normalize the local axis like upstream b2Normalize, including the
# degenerate zero branch.
Var axisLength As Double = Maths.Sqrt(def.LocalAxisA.X * def.LocalAxisA.X + def.LocalAxisA.Y * def.LocalAxisA.Y)
If axisLength >= PhysicsConstants.FLT_EPSILON Then
store.PrismaticLocalAxisX.Items[localIndex] = def.LocalAxisA.X / axisLength
store.PrismaticLocalAxisY.Items[localIndex] = def.LocalAxisA.Y / axisLength
End If
store.PrismaticReferenceAngle.Items[localIndex] = def.ReferenceAngle
store.PrismaticTargetTranslation.Items[localIndex] = def.TargetTranslation
store.PrismaticHertz.Items[localIndex] = def.Hertz
store.PrismaticDampingRatio.Items[localIndex] = def.DampingRatio
store.PrismaticLowerTranslation.Items[localIndex] = def.LowerTranslation
store.PrismaticUpperTranslation.Items[localIndex] = def.UpperTranslation
store.PrismaticMaxMotorForce.Items[localIndex] = def.MaxMotorForce
store.PrismaticMotorSpeed.Items[localIndex] = def.MotorSpeed
store.EnableSpring.Items[localIndex] = 0
store.EnableLimit.Items[localIndex] = 0
store.EnableMotor.Items[localIndex] = 0
If def.EnableSpring Then
store.EnableSpring.Items[localIndex] = 1
End If
If def.EnableLimit Then
store.EnableLimit.Items[localIndex] = 1
End If
If def.EnableMotor Then
store.EnableMotor.Items[localIndex] = 1
End If
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As PrismaticJoint = PrismaticJoint(joint)
Return facade
End Function

## Creates a weld joint, ported from b2CreateWeldJoint. Throws on a missing
## definition, missing or foreign bodies, non-finite anchors or tuning, or
## negative hertz or damping ratios, matching the upstream assertions. Zero
## hertz means maximum stiffness: the solver falls back to the base
## constraint softness.
Function CreateWeldJoint(def As WeldJointDefinition) As WeldJoint
Me.CheckNotLocked()
Me.CheckDefinition(def, "WeldJointDefinition")
Me.CheckJointBody(def.BodyA, "WeldJointDefinition.BodyA")
Me.CheckJointBody(def.BodyB, "WeldJointDefinition.BodyB")
If Not def.LocalAnchorA.X.IsFinite() Or Not def.LocalAnchorA.Y.IsFinite() Then
Throw New InvalidArgumentException("WeldJointDefinition local anchor A must be finite")
End If
If Not def.LocalAnchorB.X.IsFinite() Or Not def.LocalAnchorB.Y.IsFinite() Then
Throw New InvalidArgumentException("WeldJointDefinition local anchor B must be finite")
End If
If Not def.ReferenceAngle.IsFinite() Then
Throw New InvalidArgumentException("WeldJointDefinition reference angle must be finite")
End If
If Not def.LinearHertz.IsFinite() Or def.LinearHertz < 0.0 Then
Throw New InvalidArgumentException("WeldJointDefinition linear hertz must be finite and non-negative")
End If
If Not def.LinearDampingRatio.IsFinite() Or def.LinearDampingRatio < 0.0 Then
Throw New InvalidArgumentException("WeldJointDefinition linear damping ratio must be finite and non-negative")
End If
If Not def.AngularHertz.IsFinite() Or def.AngularHertz < 0.0 Then
Throw New InvalidArgumentException("WeldJointDefinition angular hertz must be finite and non-negative")
End If
If Not def.AngularDampingRatio.IsFinite() Or def.AngularDampingRatio < 0.0 Then
Throw New InvalidArgumentException("WeldJointDefinition angular damping ratio must be finite and non-negative")
End If

Var bodyA As Body = def.BodyA
Var bodyB As Body = def.BodyB
Var joint As Joint = Me.CreateJointRecord(bodyA, bodyB, JointType.WeldJoint, def.CollideConnected, 1.0)
Var localIndex As Integer = Me.PlaceJointSim(joint, bodyA, bodyB)
Var store As JointSims = Me.GetJointSims(joint)
store.ConstraintHertz.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_HERTZ
store.ConstraintDampingRatio.Items[localIndex] = PhysicsConstants.JOINT_CONSTRAINT_DAMPING_RATIO
store.LocalOriginAnchorAX.Items[localIndex] = def.LocalAnchorA.X
store.LocalOriginAnchorAY.Items[localIndex] = def.LocalAnchorA.Y
store.LocalOriginAnchorBX.Items[localIndex] = def.LocalAnchorB.X
store.LocalOriginAnchorBY.Items[localIndex] = def.LocalAnchorB.Y
store.WeldReferenceAngle.Items[localIndex] = def.ReferenceAngle
store.WeldLinearHertz.Items[localIndex] = def.LinearHertz
store.WeldLinearDampingRatio.Items[localIndex] = def.LinearDampingRatio
store.WeldAngularHertz.Items[localIndex] = def.AngularHertz
store.WeldAngularDampingRatio.Items[localIndex] = def.AngularDampingRatio
joint.UserData = def.UserData

If joint.SetIndex > PhysicsConstants.DISABLED_SET Then
# Add the joint edge to the island graph.
IslandMethods.LinkJoint(Me, joint, True)
End If

# If the joint prevents collisions, destroy all contacts between the
# attached bodies.
If def.CollideConnected = False Then
Me.DestroyContactsBetweenBodies(bodyA, bodyB)
End If

Var facade As WeldJoint = WeldJoint(joint)
Return facade
End Function

## Validates one joint definition body: it must be present, live, and owned
## by this world. Ownership is checked before any internal id is interpreted,
## because a live body from another world can carry an id and generation that
## look valid in this world.
Private Sub CheckJointBody(body As Body, argumentName As String)
If body = Nothing Then
Throw New InvalidArgumentException(argumentName + " must not be Nothing")
End If
If body.Owner <> Me Then
Throw New InvalidArgumentException(argumentName + " belongs to another world")
End If
If Not body.IsValid() Then
Throw New InvalidArgumentException(argumentName + " is no longer valid")
End If
End Sub

## Destroys every contact touching both bodies, ported from
## b2DestroyContactsBetweenBodies. Wakes neither body.
Sub DestroyContactsBetweenBodies(bodyA As Body, bodyB As Body)
# Use the smaller of the two contact lists.
Var contactKey As Integer
Var otherBodyId As Integer
If bodyA.ContactCount < bodyB.ContactCount Then
contactKey = bodyA.HeadContactKey
otherBodyId = bodyB.Id
Else
contactKey = bodyB.HeadContactKey
otherBodyId = bodyA.Id
End If

While contactKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = contactKey.ShiftRight(1)
Var edgeIndex As Integer = contactKey.BitAnd(1)
Var contact As Contact = Me.Contacts[contactId]
contactKey = contact.Edge0NextKey
If edgeIndex = 1 Then
contactKey = contact.Edge1NextKey
End If

Var otherEdgeIndex As Integer = 1
If edgeIndex = 1 Then
otherEdgeIndex = 0
End If
Var contactOtherBodyId As Integer = contact.Edge1BodyId
If otherEdgeIndex = 0 Then
contactOtherBodyId = contact.Edge0BodyId
End If
If contactOtherBodyId = otherBodyId Then
# Careful: this removes the contact from the list being traversed.
ContactMethods.DestroyContact(Me, contact, False)
End If
Wend
End Sub

## Destroys a joint record, its hot sim, and its island links, ported from
## b2DestroyJointInternal. Wakes the attached bodies when wakeBodies is set.
Sub DestroyJointInternal(joint As Joint, wakeBodies As Boolean)
Var jointId As Integer = joint.Id
Var bodyIdA As Integer = joint.Edge0BodyId
Var bodyIdB As Integer = joint.Edge1BodyId
Var bodyA As Body = Me.Bodies[bodyIdA]
Var bodyB As Body = Me.Bodies[bodyIdB]

# Remove from body A's list.
If joint.Edge0PrevKey <> PhysicsConstants.NULL_INDEX Then
Var prevJointA As Joint = Me.Joints[joint.Edge0PrevKey.ShiftRight(1)]
If joint.Edge0PrevKey.BitAnd(1) = 0 Then
prevJointA.Edge0NextKey = joint.Edge0NextKey
Else
prevJointA.Edge1NextKey = joint.Edge0NextKey
End If
End If
If joint.Edge0NextKey <> PhysicsConstants.NULL_INDEX Then
Var nextJointA As Joint = Me.Joints[joint.Edge0NextKey.ShiftRight(1)]
If joint.Edge0NextKey.BitAnd(1) = 0 Then
nextJointA.Edge0PrevKey = joint.Edge0PrevKey
Else
nextJointA.Edge1PrevKey = joint.Edge0PrevKey
End If
End If
Var edgeKeyA As Integer = jointId.ShiftLeft(1)
If bodyA.HeadJointKey = edgeKeyA Then
bodyA.HeadJointKey = joint.Edge0NextKey
End If
bodyA.JointCount = bodyA.JointCount - 1

# Remove from body B's list.
If joint.Edge1PrevKey <> PhysicsConstants.NULL_INDEX Then
Var prevJointB As Joint = Me.Joints[joint.Edge1PrevKey.ShiftRight(1)]
If joint.Edge1PrevKey.BitAnd(1) = 0 Then
prevJointB.Edge0NextKey = joint.Edge1NextKey
Else
prevJointB.Edge1NextKey = joint.Edge1NextKey
End If
End If
If joint.Edge1NextKey <> PhysicsConstants.NULL_INDEX Then
Var nextJointB As Joint = Me.Joints[joint.Edge1NextKey.ShiftRight(1)]
If joint.Edge1NextKey.BitAnd(1) = 0 Then
nextJointB.Edge0PrevKey = joint.Edge1PrevKey
Else
nextJointB.Edge1PrevKey = joint.Edge1PrevKey
End If
End If
Var edgeKeyB As Integer = jointId.ShiftLeft(1) + 1
If bodyB.HeadJointKey = edgeKeyB Then
bodyB.HeadJointKey = joint.Edge1NextKey
End If
bodyB.JointCount = bodyB.JointCount - 1

If joint.IslandId <> PhysicsConstants.NULL_INDEX Then
IslandMethods.UnlinkJoint(Me, joint)
End If

# Remove the sim row from the graph colour or solver set that owns it.
If joint.SetIndex = PhysicsConstants.AWAKE_SET Then
GraphMethods.RemoveJointFromGraph(Me, joint.Edge0BodyId, joint.Edge1BodyId, joint.ColorIndex, joint.LocalIndex)
Else
Var ownerSet As SolverSet = Me.SolverSets[joint.SetIndex]
Var movedJointId As Integer = ownerSet.JointSims.RemoveSwap(joint.LocalIndex)
If movedJointId <> PhysicsConstants.NULL_INDEX Then
Me.Joints[movedJointId].LocalIndex = joint.LocalIndex
End If
End If

# Free the joint and id, preserving the generation for stale façades.
joint.SetIndex = PhysicsConstants.NULL_INDEX
joint.ColorIndex = PhysicsConstants.NULL_INDEX
joint.LocalIndex = PhysicsConstants.NULL_INDEX
Me.JointIdPool.FreeId(jointId)
joint.Live = False
Me.JointCount = Me.JointCount - 1
Me.JointGenerations.Items[jointId] = Me.JointGenerations.Items[jointId] + 1
joint.Generation = Me.JointGenerations.Items[jointId]
Me.Joints[jointId] = Nothing
joint.Id = PhysicsConstants.NULL_INDEX

If wakeBodies Then
Me.WakeBody(bodyA)
Me.WakeBody(bodyB)
End If
End Sub

## Moves a joint row between solver sets or into a graph colour, ported from
## b2TransferJoint. The source may be any set; a target of the awake set
## routes the row through the graph colouring. Rows move as scalars, so a
## warmed migration allocates nothing.
Private Sub TransferJoint(targetSet As SolverSet, sourceSet As SolverSet, joint As Joint)
If targetSet = sourceSet Then
Throw New RuntimeException("TransferJoint requires different sets")
End If

Var localIndex As Integer = joint.LocalIndex

# Resolve the source store before any index changes.
Var sourceSims As JointSims = sourceSet.JointSims
If sourceSet.SetIndex = PhysicsConstants.AWAKE_SET Then
sourceSims = Me.ConstraintGraph.Colors[joint.ColorIndex].JointSims
End If

# Fill the target row and fix the joint.
If targetSet.SetIndex = PhysicsConstants.AWAKE_SET Then
GraphMethods.AddJointToGraph(Me, joint, sourceSet, localIndex)
joint.SetIndex = PhysicsConstants.AWAKE_SET
Else
joint.SetIndex = targetSet.SetIndex
joint.ColorIndex = PhysicsConstants.NULL_INDEX
joint.LocalIndex = targetSet.JointSims.Count()
targetSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
sourceSims.MoveRowTo(targetSet.JointSims, joint.LocalIndex, localIndex)
Var movedJointId As Integer = sourceSims.RemoveSwap(localIndex)
If movedJointId <> PhysicsConstants.NULL_INDEX Then
Me.Joints[movedJointId].LocalIndex = localIndex
End If
End If
End Sub

## Wakes a sleeping solver set, ported from b2WakeSolverSet.
Sub WakeSolverSet(setIndex As Integer)
If setIndex < 3 Then
Throw New RuntimeException("WakeSolverSet requires a sleeping set")
End If
Var solverSet As SolverSet = Me.SolverSets[setIndex]
Var awakeSet As SolverSet = Me.SolverSets[2]
Var disabledSet As SolverSet = Me.SolverSets[1]
While solverSet.Sims.Count() > 0
Var bodyId As Integer = solverSet.Sims.BodyId.Items[0]
Var body As Body = Me.Bodies[bodyId]
Me.TransferBody(awakeSet, solverSet, body)
body.SleepTime = 0.0

# Move the body's non-touching contacts from the disabled set into the
# awake set, ported from the wake path.
Var contactKey As Integer = body.HeadContactKey
While contactKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = contactKey.ShiftRight(1)
Var edgeIndex As Integer = contactKey.BitAnd(1)
Var contact As Contact = Me.Contacts[contactId]
If edgeIndex = 0 Then
contactKey = contact.Edge0NextKey
Else
contactKey = contact.Edge1NextKey
End If
If contact.SetIndex = PhysicsConstants.DISABLED_SET Then
Var localIndex As Integer = contact.LocalIndex
contact.SetIndex = PhysicsConstants.AWAKE_SET
contact.LocalIndex = awakeSet.ContactSims.Count()
awakeSet.ContactSims.Add()
disabledSet.ContactSims.MoveRowTo(awakeSet.ContactSims, contact.LocalIndex, localIndex)
Var movedLocalIndex As Integer = disabledSet.ContactSims.RemoveSwap(localIndex)
If movedLocalIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = disabledSet.ContactSims.ContactId.Items[localIndex]
Me.Contacts[movedContactId].LocalIndex = localIndex
End If
End If
Wend
Wend

# Migrate the sleeping contacts into the constraint graph, ported from the
# touching-contact transfer of b2WakeSolverSet.
While solverSet.ContactSims.Count() > 0
Var sleepingContactId As Integer = solverSet.ContactSims.ContactId.Items[0]
GraphMethods.AddContactToGraph(Me, Me.Contacts[sleepingContactId])
Wend

# Migrate the sleeping joints into the constraint graph, ported from the
# joint transfer of b2WakeSolverSet. Adding to the graph removes the source
# row, so each iteration drops row zero.
While solverSet.JointSims.Count() > 0
Var sleepingJointId As Integer = solverSet.JointSims.JointId.Items[0]
Var sleepingJoint As Joint = Me.Joints[sleepingJointId]
GraphMethods.AddJointToGraph(Me, sleepingJoint, solverSet, 0)
sleepingJoint.SetIndex = PhysicsConstants.AWAKE_SET
Wend

# Migrate the islands.
Var islandCount As Integer = solverSet.IslandIds.Count
For j As Integer = 0 To islandCount - 1
Var islandId As Integer = solverSet.IslandIds.Items[j]
Var island As Island = Me.Islands[islandId]
island.SetIndex = PhysicsConstants.AWAKE_SET
island.LocalIndex = awakeSet.IslandIds.Count
awakeSet.IslandIds.Append(islandId)
Next j

Me.DestroySolverSet(setIndex)
End Sub

## Puts an awake island to sleep, ported from b2TrySleepIsland. Creates a
## sleeping solver set, moves the island's bodies, contacts, and island
## record into it, and relocates non-touching contacts to the disabled set.
Sub TrySleepIsland(islandId As Integer)
Var island As Island = Me.Islands[islandId]
If island.SetIndex <> PhysicsConstants.AWAKE_SET Then
Throw New RuntimeException("TrySleepIsland requires an awake island")
End If
If island.ConstraintRemoveCount > 0 Then
Return
End If

Var sleepSetId As Integer = Me.AllocSleepingSet()
Var sleepSet As SolverSet = Me.SolverSets[sleepSetId]
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var disabledSet As SolverSet = Me.SolverSets[PhysicsConstants.DISABLED_SET]

# Move the island's bodies and their non-touching contacts.
Var bodyId As Integer = island.HeadBody
While bodyId <> PhysicsConstants.NULL_INDEX
Var body As Body = Me.Bodies[bodyId]

# Patch the body's moved-body event before it leaves the awake set,
# ported from b2TrySleepIsland.
If body.MoveEventIndex >= 0 Then
Me.MoveEventFellAsleep.Items[body.MoveEventIndex] = 1
body.MoveEventIndex = -1
End If

Me.MoveBodyToSleepSet(body, sleepSet, awakeSet, disabledSet)
bodyId = body.IslandNext
Wend

# Move the island's touching contacts out of the graph colours.
Me.MoveIslandContactsToSleepSet(island, sleepSet)

# Move the island's joints out of the graph colours, ported from the joint
# loop of b2TrySleepIsland.
Me.MoveIslandJointsToSleepSet(island, sleepSet)

# Move the island record.
Var islandIndex As Integer = island.LocalIndex
sleepSet.IslandIds.Append(islandId)
Var movedIslandIndex As Integer = awakeSet.IslandIds.RemoveSwap(islandIndex)
If movedIslandIndex <> PhysicsConstants.NULL_INDEX Then
Var movedIslandId As Integer = awakeSet.IslandIds.Items[islandIndex]
Me.Islands[movedIslandId].LocalIndex = islandIndex
End If
island.SetIndex = sleepSetId
island.LocalIndex = 0
End Sub

## Moves one sleeping island body into the sleeping set and relocates its
## non-touching contacts to the disabled set, ported from the body loop of
## b2TrySleepIsland.
Private Sub MoveBodyToSleepSet(body As Body, sleepSet As SolverSet, awakeSet As SolverSet, disabledSet As SolverSet)
Var awakeBodyIndex As Integer = body.LocalIndex
Var sleepBodyIndex As Integer = sleepSet.Sims.Count()
sleepSet.Sims.Add()
sleepSet.Sims.CopyRecordTo(sleepBodyIndex, awakeSet.Sims, awakeBodyIndex)
Var movedIndex As Integer = awakeSet.Sims.RemoveSwap(awakeBodyIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedId As Integer = awakeSet.Sims.BodyId.Items[awakeBodyIndex]
Me.Bodies[movedId].LocalIndex = awakeBodyIndex
End If
awakeSet.States.RemoveSwap(awakeBodyIndex)
Var sleepSetId As Integer = sleepSet.SetIndex
body.SetIndex = sleepSetId
body.LocalIndex = sleepBodyIndex

Var contactKey As Integer = body.HeadContactKey
While contactKey <> PhysicsConstants.NULL_INDEX
Var contactId As Integer = contactKey.ShiftRight(1)
Var edgeIndex As Integer = contactKey.BitAnd(1)
Var contact As Contact = Me.Contacts[contactId]
If edgeIndex = 0 Then
contactKey = contact.Edge0NextKey
Else
contactKey = contact.Edge1NextKey
End If
If contact.SetIndex = PhysicsConstants.DISABLED_SET Then
Continue While
End If
If contact.ColorIndex <> PhysicsConstants.NULL_INDEX Then
# Touching contacts are moved separately with the island's contact list.
Continue While
End If
Var otherBodyId As Integer = contact.Edge1BodyId
If edgeIndex = 1 Then
otherBodyId = contact.Edge0BodyId
End If
If Me.Bodies[otherBodyId].SetIndex = PhysicsConstants.AWAKE_SET Then
Continue While
End If

Var localIndex As Integer = contact.LocalIndex
contact.SetIndex = PhysicsConstants.DISABLED_SET
contact.LocalIndex = disabledSet.ContactSims.Count()
disabledSet.ContactSims.Add()
awakeSet.ContactSims.MoveRowTo(disabledSet.ContactSims, contact.LocalIndex, localIndex)
Var movedLocalIndex As Integer = awakeSet.ContactSims.RemoveSwap(localIndex)
If movedLocalIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = awakeSet.ContactSims.ContactId.Items[localIndex]
Me.Contacts[movedContactId].LocalIndex = localIndex
End If
Wend
End Sub

## Moves an island's touching contacts from the graph colours into the
## sleeping set, ported from the touching-contact loop of b2TrySleepIsland.
Private Sub MoveIslandContactsToSleepSet(island As Island, sleepSet As SolverSet)
Var contactId As Integer = island.HeadContact
While contactId <> PhysicsConstants.NULL_INDEX
Var contact As Contact = Me.Contacts[contactId]
Var color As GraphColor = Me.ConstraintGraph.Colors[contact.ColorIndex]
If contact.ColorIndex <> PhysicsConstants.GRAPH_OVERFLOW_INDEX Then
color.BodySet.ClearBit(contact.Edge0BodyId)
color.BodySet.ClearBit(contact.Edge1BodyId)
End If
Var localIndex As Integer = contact.LocalIndex
Var sleepContactIndex As Integer = sleepSet.ContactSims.Count()
sleepSet.ContactSims.Add()
color.ContactSims.MoveRowTo(sleepSet.ContactSims, sleepContactIndex, localIndex)
Var movedLocalIndex As Integer = color.ContactSims.RemoveSwap(localIndex)
If movedLocalIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = color.ContactSims.ContactId.Items[localIndex]
Me.Contacts[movedContactId].LocalIndex = localIndex
End If
contact.SetIndex = sleepSet.SetIndex
contact.ColorIndex = PhysicsConstants.NULL_INDEX
contact.LocalIndex = sleepContactIndex
contactId = contact.IslandNext
Wend
End Sub

## Moves an island's joints from the graph colours into the sleeping set,
## ported from the joint loop of b2TrySleepIsland.
Private Sub MoveIslandJointsToSleepSet(island As Island, sleepSet As SolverSet)
Var jointId As Integer = island.HeadJoint
While jointId <> PhysicsConstants.NULL_INDEX
Var joint As Joint = Me.Joints[jointId]
Var color As GraphColor = Me.ConstraintGraph.Colors[joint.ColorIndex]
If joint.ColorIndex <> PhysicsConstants.GRAPH_OVERFLOW_INDEX Then
# Might clear a bit for a static body, but this has no effect.
color.BodySet.ClearBit(joint.Edge0BodyId)
color.BodySet.ClearBit(joint.Edge1BodyId)
End If
Var localIndex As Integer = joint.LocalIndex
Var sleepJointIndex As Integer = sleepSet.JointSims.Count()
sleepSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
color.JointSims.MoveRowTo(sleepSet.JointSims, sleepJointIndex, localIndex)
Var movedJointId As Integer = color.JointSims.RemoveSwap(localIndex)
If movedJointId <> PhysicsConstants.NULL_INDEX Then
Me.Joints[movedJointId].LocalIndex = localIndex
End If
joint.SetIndex = sleepSet.SetIndex
joint.ColorIndex = PhysicsConstants.NULL_INDEX
joint.LocalIndex = sleepJointIndex
jointId = joint.IslandNext
Wend
End Sub

## Merges sleeping set two into sleeping set one and destroys set two,
## ported from b2MergeSolverSets. The smaller set migrates.
Private Sub MergeSolverSets(setId1 As Integer, setId2 As Integer)
If setId1 < PhysicsConstants.FIRST_SLEEPING_SET Or setId2 < PhysicsConstants.FIRST_SLEEPING_SET Then
Throw New RuntimeException("MergeSolverSets requires sleeping sets")
End If
If Me.SolverSets[setId1].Sims.Count() < Me.SolverSets[setId2].Sims.Count() Then
Var tempId As Integer = setId1
setId1 = setId2
setId2 = tempId
End If
Var targetSet As SolverSet = Me.SolverSets[setId1]
Var sourceSet As SolverSet = Me.SolverSets[setId2]

Var bodyCount As Integer = sourceSet.Sims.Count()
For i As Integer = 0 To bodyCount - 1
Var bodyId As Integer = sourceSet.Sims.BodyId.Items[i]
Var body As Body = Me.Bodies[bodyId]
body.SetIndex = setId1
body.LocalIndex = targetSet.Sims.Count()
targetSet.Sims.Add()
targetSet.Sims.CopyRecordTo(body.LocalIndex, sourceSet.Sims, i)
Next i

Var contactCount As Integer = sourceSet.ContactSims.Count()
For c As Integer = 0 To contactCount - 1
Var contactId As Integer = sourceSet.ContactSims.ContactId.Items[c]
Var contact As Contact = Me.Contacts[contactId]
contact.SetIndex = setId1
contact.LocalIndex = targetSet.ContactSims.Count()
targetSet.ContactSims.Add()
sourceSet.ContactSims.MoveRowTo(targetSet.ContactSims, contact.LocalIndex, c)
Next c

# Transfer joints, ported from the joint section of b2MergeSolverSets.
Var jointCount As Integer = sourceSet.JointSims.Count()
For j As Integer = 0 To jointCount - 1
Var jointId As Integer = sourceSet.JointSims.JointId.Items[j]
Var joint As Joint = Me.Joints[jointId]
joint.SetIndex = setId1
joint.LocalIndex = targetSet.JointSims.Count()
targetSet.JointSims.Add(joint.Id, joint.Edge0BodyId, joint.Edge1BodyId, joint.Type)
sourceSet.JointSims.MoveRowTo(targetSet.JointSims, joint.LocalIndex, j)
Next j

Var islandCount As Integer = sourceSet.IslandIds.Count
For s As Integer = 0 To islandCount - 1
Var islandId As Integer = sourceSet.IslandIds.Items[s]
Var island As Island = Me.Islands[islandId]
island.SetIndex = setId1
island.LocalIndex = targetSet.IslandIds.Count
targetSet.IslandIds.Append(islandId)
Next s

Me.DestroySolverSet(setId2)
End Sub

## Frees a sleeping solver set that no longer holds bodies, ported from
## b2DestroySolverSet.

## Wakes the body when it sleeps, ported from b2WakeBody. Returns True when
## a set was woken.
Function WakeBody(body As Body) As Boolean
If body.SetIndex >= 3 Then
Me.WakeSolverSet(body.SetIndex)
Return True
End If
Return False
End Function

## Throws when the body façade is stale.
Private Sub ValidateBody(body As Body)
If Not body.IsValid() Then
Throw New RuntimeException("Body façade is no longer valid")
End If
End Sub

# ------------------------------------------------------------------
# Body accessors
# ------------------------------------------------------------------

## Returns the dense sim record of the owning solver set. Index the record
## with body.LocalIndex.
Function GetBodySim(body As Body) As BodySims
Return Me.SolverSets[body.SetIndex].Sims
End Function

## Returns the dense state record of the owning solver set, or Nothing when
## the body is not awake, ported from b2GetBodyState.
Function GetBodyState(body As Body) As BodyStates
Var solverSet As SolverSet = Me.SolverSets[body.SetIndex]
Return solverSet.States
End Function

## Returns a copy of the body transform, ported from
## b2GetBodyTransformQuick.
Function GetBodyTransform(body As Body) As Transform
Return Me.GetBodyTransformTo(body, New Transform)
End Function

## Writes the body transform into a caller-owned transform, for warm paths.
Private Function GetBodyTransformTo(body As Body, out As Transform) As Transform
Var sims As BodySims = Me.GetBodySim(body)
out.P.Set(sims.PX.Items[body.LocalIndex], sims.PY.Items[body.LocalIndex])
out.Q.SetComponents(sims.QC.Items[body.LocalIndex], sims.QS.Items[body.LocalIndex])
Return out
End Function

## Returns a copy of the body transform by body slot, for query adapters.
Function GetBodyTransformById(bodyId As Integer) As Transform
Return Me.GetBodyTransform(Me.Bodies[bodyId])
End Function

## Returns the world transform for a shape's owning body, for query
## adapters.
Private Function GetShapeTransform(shape As Shape) As Transform
Return Me.GetBodyTransform(Me.Bodies[shape.BodyId])
End Function

## The linear velocity of the centre of mass, ported from
## b2Body_GetLinearVelocity.
Function GetBodyLinearVelocity(body As Body) As Vector2
Me.ValidateBody(body)
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return New Vector2(0.0, 0.0)
End If
Return New Vector2(states.LVX.Items[body.LocalIndex], states.LVY.Items[body.LocalIndex])
End Function

## Sets the linear velocity, waking the body for non-zero velocity, ported
## from b2Body_SetLinearVelocity.
Sub SetBodyLinearVelocity(body As Body, linearVelocity As Vector2)
Me.ValidateBody(body)
If body.Type = BodyType.StaticBody Then
Return
End If
If linearVelocity.X * linearVelocity.X + linearVelocity.Y * linearVelocity.Y > 0.0 Then
Me.WakeBody(body)
End If
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.LVX.Items[body.LocalIndex] = linearVelocity.X
states.LVY.Items[body.LocalIndex] = linearVelocity.Y
End Sub

## The angular velocity in radians per second, ported from
## b2Body_GetAngularVelocity.
Function GetBodyAngularVelocity(body As Body) As Double
Me.ValidateBody(body)
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return 0.0
End If
Return states.AngularVelocity.Items[body.LocalIndex]
End Function

## Sets the angular velocity, waking the body for non-zero velocity, ported
## from b2Body_SetAngularVelocity.
Sub SetBodyAngularVelocity(body As Body, angularVelocity As Double)
Me.ValidateBody(body)
If body.Type = BodyType.StaticBody Then
Return
End If
If angularVelocity * angularVelocity > 0.0 Then
Me.WakeBody(body)
End If
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.AngularVelocity.Items[body.LocalIndex] = angularVelocity
End Sub

## Drives the body towards the target transform over the given time step,
## ported from b2Body_SetTargetTransform.
Sub SetBodyTargetTransform(body As Body, target As Transform, timeStep As Double)
Me.ValidateBody(body)
If body.Type = BodyType.StaticBody Or timeStep <= 0.0 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var center1X As Double = sims.CenterX.Items[li]
Var center1Y As Double = sims.CenterY.Items[li]
Var center2 As Vector2 = Transform.TransformPoint(target, New Vector2(sims.LCX.Items[li], sims.LCY.Items[li]))
Var invTimeStep As Double = 1.0 / timeStep
Var linearVelocity As Vector2 = New Vector2(invTimeStep * (center2.X - center1X), invTimeStep * (center2.Y - center1Y))
Var angularVelocity As Double = 0.0
If Not body.FixedRotation Then
Var q1 As Rot = New Rot(sims.QS.Items[li], sims.QC.Items[li])
angularVelocity = invTimeStep * Rot.RelativeAngle(target.Q, q1)
End If
Var speed As Double = Maths.Sqrt(linearVelocity.X * linearVelocity.X + linearVelocity.Y * linearVelocity.Y)
Var maxVelocity As Double = speed + Maths.Abs(angularVelocity) * sims.MaxExtent.Items[li]
If maxVelocity < body.SleepThreshold Then
Return
End If
Me.WakeBody(body)
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.LVX.Items[body.LocalIndex] = linearVelocity.X
states.LVY.Items[body.LocalIndex] = linearVelocity.Y
states.AngularVelocity.Items[body.LocalIndex] = angularVelocity
End Sub

## Velocity of a point in the body frame, ported from
## b2Body_GetLocalPointVelocity.
Function GetBodyLocalPointVelocity(body As Body, localPoint As Vector2) As Vector2
Me.ValidateBody(body)
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return New Vector2(0.0, 0.0)
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var dx As Double = localPoint.X - sims.LCX.Items[li]
Var dy As Double = localPoint.Y - sims.LCY.Items[li]
Var qc As Double = sims.QC.Items[li]
Var qs As Double = sims.QS.Items[li]
Var rx As Double = qc * dx - qs * dy
Var ry As Double = qs * dx + qc * dy
Var angularVelocity As Double = states.AngularVelocity.Items[li]
Return New Vector2(states.LVX.Items[li] - angularVelocity * ry, states.LVY.Items[li] + angularVelocity * rx)
End Function

## Velocity of a world point attached to the body, ported from
## b2Body_GetWorldPointVelocity.
Function GetBodyWorldPointVelocity(body As Body, worldPoint As Vector2) As Vector2
Me.ValidateBody(body)
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return New Vector2(0.0, 0.0)
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var rx As Double = worldPoint.X - sims.CenterX.Items[li]
Var ry As Double = worldPoint.Y - sims.CenterY.Items[li]
Var angularVelocity As Double = states.AngularVelocity.Items[li]
Return New Vector2(states.LVX.Items[li] - angularVelocity * ry, states.LVY.Items[li] + angularVelocity * rx)
End Function

## Applies a force at a world point, ported from b2Body_ApplyForce.
Sub ApplyBodyForce(body As Body, force As Vector2, point As Vector2, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
sims.ForceX.Items[li] = sims.ForceX.Items[li] + force.X
sims.ForceY.Items[li] = sims.ForceY.Items[li] + force.Y
Var rx As Double = point.X - sims.CenterX.Items[li]
Var ry As Double = point.Y - sims.CenterY.Items[li]
sims.Torque.Items[li] = sims.Torque.Items[li] + rx * force.Y - ry * force.X
End Sub

## Applies a force at the centre of mass, ported from
## b2Body_ApplyForceToCenter.
Sub ApplyBodyForceToCenter(body As Body, force As Vector2, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
sims.ForceX.Items[li] = sims.ForceX.Items[li] + force.X
sims.ForceY.Items[li] = sims.ForceY.Items[li] + force.Y
End Sub

## Applies a torque, ported from b2Body_ApplyTorque.
Sub ApplyBodyTorque(body As Body, torque As Double, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
sims.Torque.Items[body.LocalIndex] = sims.Torque.Items[body.LocalIndex] + torque
End Sub

## Applies an impulse at a world point, ported from b2Body_ApplyLinearImpulse.
Sub ApplyBodyLinearImpulse(body As Body, impulse As Vector2, point As Vector2, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var invMass As Double = sims.InvMass.Items[li]
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.LVX.Items[li] = states.LVX.Items[li] + invMass * impulse.X
states.LVY.Items[li] = states.LVY.Items[li] + invMass * impulse.Y
Var rx As Double = point.X - sims.CenterX.Items[li]
Var ry As Double = point.Y - sims.CenterY.Items[li]
Var angularImpulse As Double = rx * impulse.Y - ry * impulse.X
states.AngularVelocity.Items[li] = states.AngularVelocity.Items[li] + sims.InvInertia.Items[li] * angularImpulse
End Sub

## Applies an impulse at the centre of mass, ported from
## b2Body_ApplyLinearImpulseToCenter.
Sub ApplyBodyLinearImpulseToCenter(body As Body, impulse As Vector2, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var invMass As Double = sims.InvMass.Items[li]
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.LVX.Items[li] = states.LVX.Items[li] + invMass * impulse.X
states.LVY.Items[li] = states.LVY.Items[li] + invMass * impulse.Y
End Sub

## Applies an angular impulse, ported from b2Body_ApplyAngularImpulse.
Sub ApplyBodyAngularImpulse(body As Body, impulse As Double, wake As Boolean)
Me.ValidateBody(body)
If wake And body.SetIndex >= 3 Then
Me.WakeBody(body)
End If
If body.SetIndex <> 2 Then
Return
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
Var states As BodyStates = Me.GetBodyState(body)
If states = Nothing Then
Return
End If
states.AngularVelocity.Items[li] = states.AngularVelocity.Items[li] + sims.InvInertia.Items[li] * impulse
End Sub

## The local centre of mass relative to the body origin.
Function GetBodyLocalCenterOfMass(body As Body) As Vector2
Me.ValidateBody(body)
Var sims As BodySims = Me.GetBodySim(body)
Return New Vector2(sims.LCX.Items[body.LocalIndex], sims.LCY.Items[body.LocalIndex])
End Function

## The world centre of mass.
Function GetBodyWorldCenterOfMass(body As Body) As Vector2
Me.ValidateBody(body)
Var sims As BodySims = Me.GetBodySim(body)
Return New Vector2(sims.CenterX.Items[body.LocalIndex], sims.CenterY.Items[body.LocalIndex])
End Function

## The mass data of the body, ported from b2Body_GetMassData.
Function GetBodyMassData(body As Body) As MassData
Me.ValidateBody(body)
Var sims As BodySims = Me.GetBodySim(body)
Var data As New MassData
data.Mass = body.Mass
data.Center = New Vector2(sims.LCX.Items[body.LocalIndex], sims.LCY.Items[body.LocalIndex])
data.RotationalInertia = body.Inertia
Return data
End Function

## Overrides the mass data, ported from b2Body_SetMassData.
Sub SetBodyMassData(body As Body, massData As MassData)
Me.CheckDefinition(massData, "MassData")
Me.CheckNotLocked()
If Not massData.Mass.IsFinite() Or massData.Mass < 0.0 Then
Throw New InvalidArgumentException("MassData mass must be finite and non-negative")
End If
If Not massData.RotationalInertia.IsFinite() Or massData.RotationalInertia < 0.0 Then
Throw New InvalidArgumentException("MassData rotational inertia must be finite and non-negative")
End If
Me.ValidateBody(body)
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
body.Mass = massData.Mass
body.Inertia = massData.RotationalInertia
sims.LCX.Items[li] = massData.Center.X
sims.LCY.Items[li] = massData.Center.Y
Var center As Vector2 = Transform.TransformPoint(Me.GetBodyTransform(body), massData.Center)
sims.CenterX.Items[li] = center.X
sims.CenterY.Items[li] = center.Y
sims.C0X.Items[li] = center.X
sims.C0Y.Items[li] = center.Y
If body.Mass > 0.0 Then
sims.InvMass.Items[li] = 1.0 / body.Mass
Else
sims.InvMass.Items[li] = 0.0
End If
If body.Inertia > 0.0 Then
sims.InvInertia.Items[li] = 1.0 / body.Inertia
Else
sims.InvInertia.Items[li] = 0.0
End If
End Sub

## Linear damping in kilograms per second.
Function GetBodyLinearDamping(body As Body) As Double
Me.ValidateBody(body)
Return Me.GetBodySim(body).LinearDamping.Items[body.LocalIndex]
End Function

## Sets linear damping in kilograms per second.
Sub SetBodyLinearDamping(body As Body, linearDamping As Double)
Me.CheckNotLocked()
Me.ValidateBody(body)
Me.GetBodySim(body).LinearDamping.Items[body.LocalIndex] = linearDamping
End Sub

## Angular damping in kilograms per second.
Function GetBodyAngularDamping(body As Body) As Double
Me.ValidateBody(body)
Return Me.GetBodySim(body).AngularDamping.Items[body.LocalIndex]
End Function

## Sets angular damping in kilograms per second.
Sub SetBodyAngularDamping(body As Body, angularDamping As Double)
Me.CheckNotLocked()
Me.ValidateBody(body)
Me.GetBodySim(body).AngularDamping.Items[body.LocalIndex] = angularDamping
End Sub

## The gravity scale.
Function GetBodyGravityScale(body As Body) As Double
Me.ValidateBody(body)
Return Me.GetBodySim(body).GravityScale.Items[body.LocalIndex]
End Function

## Sets the gravity scale.
Sub SetBodyGravityScale(body As Body, gravityScale As Double)
Me.CheckNotLocked()
Me.ValidateBody(body)
Me.GetBodySim(body).GravityScale.Items[body.LocalIndex] = gravityScale
End Sub

## Wakes or sleeps the body, ported from b2Body_SetAwake. Sleeping applies
## to this body alone in Stage 6; island-wide sleeping arrives in Stage 7.
Sub SetBodyAwake(body As Body, awake As Boolean)
Me.CheckNotLocked()
Me.ValidateBody(body)
If awake And body.SetIndex >= 3 Then
Me.WakeBody(body)
ElseIf Not awake And body.SetIndex = 2 Then
Var setId As Integer = Me.AllocSleepingSet()
Me.TransferBody(Me.SolverSets[setId], Me.SolverSets[2], body)
End If
End Sub

## Enables or disables sleeping for a body, waking it when disabled,
## ported from b2Body_EnableSleep.
Sub SetBodyEnableSleep(body As Body, enableSleep As Boolean)
Me.CheckNotLocked()
Me.ValidateBody(body)
body.EnableSleep = enableSleep
If Not enableSleep Then
Me.WakeBody(body)
End If
End Sub

## Enables a disabled body, ported from b2Body_Enable.
Sub EnableBody(body As Body)
Me.CheckNotLocked()
Me.ValidateBody(body)
If body.SetIndex <> 1 Then
Return
End If
Var setId As Integer = 2
If body.Type = BodyType.StaticBody Then
setId = 0
End If
Me.TransferBody(Me.SolverSets[setId], Me.SolverSets[1], body)
Var xf As Transform = Me.GetBodyTransform(body)
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
Me.CreateShapeProxy(shape, body.Type, xf, True)
Wend
If setId <> 0 Then
IslandMethods.CreateIslandForBody(Me, setId, body)
End If

# Transfer joints out of the disabled set, ported from the joint loop of
# b2Body_Enable. If the other body is disabled, don't transfer.
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
jointKey = joint.Edge0NextKey
If edgeIndex = 1 Then
jointKey = joint.Edge1NextKey
End If

Var jointBodyA As Body = Me.Bodies[joint.Edge0BodyId]
Var jointBodyB As Body = Me.Bodies[joint.Edge1BodyId]
If jointBodyA.SetIndex = PhysicsConstants.DISABLED_SET Or jointBodyB.SetIndex = PhysicsConstants.DISABLED_SET Then
# One body is still disabled.
Continue While
End If

# Pick the joint's set from the enabled bodies.
Var jointSetId As Integer = jointBodyA.SetIndex
If jointBodyA.SetIndex = PhysicsConstants.STATIC_SET And jointBodyB.SetIndex = PhysicsConstants.STATIC_SET Then
jointSetId = PhysicsConstants.STATIC_SET
ElseIf jointBodyA.SetIndex = PhysicsConstants.STATIC_SET Then
jointSetId = jointBodyB.SetIndex
End If

Me.TransferJoint(Me.SolverSets[jointSetId], Me.SolverSets[PhysicsConstants.DISABLED_SET], joint)

# Now that the joint is in the correct set, link it into the island.
If jointSetId <> PhysicsConstants.STATIC_SET Then
IslandMethods.LinkJoint(Me, joint, False)
End If
Wend

IslandMethods.MergeAwakeIslands(Me)
End Sub

## Disables a live body, ported from b2Body_Disable.
Sub DisableBody(body As Body)
Me.CheckNotLocked()
Me.ValidateBody(body)
If body.SetIndex = 1 Then
Return
End If

# Destroy attached contacts and wake their other bodies.
ContactMethods.DestroyBodyContacts(Me, body, True)

# Unlink joints and transfer them to the disabled set, ported from the
# joint loop of b2Body_Disable.
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
jointKey = joint.Edge0NextKey
If edgeIndex = 1 Then
jointKey = joint.Edge1NextKey
End If

# The joint may already be disabled by the other body.
If joint.SetIndex = PhysicsConstants.DISABLED_SET Then
Continue While
End If

If joint.IslandId <> PhysicsConstants.NULL_INDEX Then
IslandMethods.UnlinkJoint(Me, joint)
End If

Me.TransferJoint(Me.SolverSets[PhysicsConstants.DISABLED_SET], Me.SolverSets[joint.SetIndex], joint)
Wend

Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
Me.DestroyShapeProxy(shape)
Wend

# Disabled bodies do not belong to an island.
IslandMethods.RemoveBodyFromIsland(Me, body)

Me.TransferBody(Me.SolverSets[1], Me.SolverSets[body.SetIndex], body)
End Sub

## Locks or unlocks rotation and recomputes mass, ported from
## b2Body_SetFixedRotation.
Sub SetBodyFixedRotation(body As Body, flag As Boolean)
Me.CheckNotLocked()
Me.ValidateBody(body)
If body.FixedRotation = flag Then
Return
End If
body.FixedRotation = flag
Var states As BodyStates = Me.GetBodyState(body)
If states <> Nothing Then
states.AngularVelocity.Items[body.LocalIndex] = 0.0
End If
Me.UpdateBodyMassData(body)
End Sub

## Changes the body type, ported from b2Body_SetType. Joints transfer
## between solver sets, get re-coloured, and relink into islands exactly as
## upstream.
Sub SetBodyType(body As Body, bodyType As BodyType)
Me.CheckNotLocked()
Me.ValidateBody(body)
Var originalType As BodyType = body.Type
If originalType = bodyType Then
Return
End If
If body.SetIndex = 1 Then
# Disabled bodies don't change solver sets or islands when they change
# type.
body.Type = bodyType
Me.UpdateBodyMassData(body)
Return
End If
Me.WakeBody(body)
body.Type = bodyType

# Unlink all joints and wake attached bodies, ported from the unlink loop
# of b2Body_SetType.
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
If joint.IslandId <> PhysicsConstants.NULL_INDEX Then
IslandMethods.UnlinkJoint(Me, joint)
End If

# A body going from static to dynamic or kinematic goes to the awake set
# and other attached bodies must be awake as well; this is done for all
# cases.
Me.WakeBody(Me.Bodies[joint.Edge0BodyId])
Me.WakeBody(Me.Bodies[joint.Edge1BodyId])

If edgeIndex = 0 Then
jointKey = joint.Edge0NextKey
Else
jointKey = joint.Edge1NextKey
End If
Wend

If originalType = BodyType.StaticBody Then
Me.TransferBody(Me.SolverSets[2], Me.SolverSets[0], body)
IslandMethods.CreateIslandForBody(Me, PhysicsConstants.AWAKE_SET, body)
Me.TransferStaticJointsToAwakeSet(body)
Me.RecreateShapeProxies(body, bodyType)
ElseIf bodyType = BodyType.StaticBody Then
Me.TransferBody(Me.SolverSets[0], Me.SolverSets[2], body)
IslandMethods.RemoveBodyFromIsland(Me, body)
Me.GetBodySim(body).IsFast.Items[body.LocalIndex] = 0
Me.TransferJointsToStaticSet(body)
Me.RecreateShapeProxies(body, BodyType.StaticBody)
Else
Me.RecreateShapeProxies(body, bodyType)
End If

# Relink all joints, ported from the relink loop of b2Body_SetType.
jointKey = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var relinkJointId As Integer = jointKey.ShiftRight(1)
Var relinkEdgeIndex As Integer = jointKey.BitAnd(1)
Var relinkJoint As Joint = Me.Joints[relinkJointId]
If relinkEdgeIndex = 0 Then
jointKey = relinkJoint.Edge0NextKey
Else
jointKey = relinkJoint.Edge1NextKey
End If
Var relinkOtherId As Integer = relinkJoint.Edge1BodyId
If relinkEdgeIndex = 1 Then
relinkOtherId = relinkJoint.Edge0BodyId
End If
Var relinkOtherBody As Body = Me.Bodies[relinkOtherId]
If relinkOtherBody.SetIndex = PhysicsConstants.DISABLED_SET Then
Continue While
End If
If body.Type = BodyType.StaticBody And relinkOtherBody.Type = BodyType.StaticBody Then
Continue While
End If
IslandMethods.LinkJoint(Me, relinkJoint, False)
Wend
IslandMethods.MergeAwakeIslands(Me)

Me.UpdateBodyMassData(body)
End Sub

## Moves this body's joints out of the static set and re-colours graph
## joints after the body left the static set, ported from the static-to-
## dynamic joint walk of b2Body_SetType.
Private Sub TransferStaticJointsToAwakeSet(body As Body)
Var staticSet As SolverSet = Me.SolverSets[PhysicsConstants.STATIC_SET]
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
If edgeIndex = 0 Then
jointKey = joint.Edge0NextKey
Else
jointKey = joint.Edge1NextKey
End If

# Transfer the joint if it is in the static set.
If joint.SetIndex = PhysicsConstants.STATIC_SET Then
Me.TransferJoint(awakeSet, staticSet, joint)
ElseIf joint.SetIndex = PhysicsConstants.AWAKE_SET Then
# In this case the joint must be re-inserted into the constraint graph
# to ensure the correct graph colour: first transfer to the static set,
# then transfer it back into the graph.
Me.TransferJoint(staticSet, awakeSet, joint)
Me.TransferJoint(awakeSet, staticSet, joint)
End If
Wend
End Sub

## Moves this body's joints into the static set when both sides are static
## and re-colours graph joints otherwise, ported from the to-static joint
## walk of b2Body_SetType.
Private Sub TransferJointsToStaticSet(body As Body)
Var staticSet As SolverSet = Me.SolverSets[PhysicsConstants.STATIC_SET]
Var awakeSet As SolverSet = Me.SolverSets[PhysicsConstants.AWAKE_SET]
Var jointKey As Integer = body.HeadJointKey
While jointKey <> PhysicsConstants.NULL_INDEX
Var jointId As Integer = jointKey.ShiftRight(1)
Var edgeIndex As Integer = jointKey.BitAnd(1)
Var joint As Joint = Me.Joints[jointId]
jointKey = joint.Edge0NextKey
If edgeIndex = 1 Then
jointKey = joint.Edge1NextKey
End If

# Skip disabled joints; they connect to a disabled body.
If joint.SetIndex = PhysicsConstants.DISABLED_SET Then
Continue While
End If
Var otherEdgeIndex As Integer = 1
If edgeIndex = 1 Then
otherEdgeIndex = 0
End If
Var otherBodyId As Integer = joint.Edge1BodyId
If otherEdgeIndex = 0 Then
otherBodyId = joint.Edge0BodyId
End If
Var otherBody As Body = Me.Bodies[otherBodyId]

# Only transfer the joint to the static set if both bodies are static.
If otherBody.SetIndex = PhysicsConstants.STATIC_SET Then
Me.TransferJoint(staticSet, awakeSet, joint)
Else
# The joint must live in a graph colour and must be re-inserted into
# the constraint graph to ensure the correct graph colour: first
# transfer to the static set, then transfer it back into the graph.
Me.TransferJoint(staticSet, awakeSet, joint)
Me.TransferJoint(awakeSet, staticSet, joint)
End If
Wend
End Sub

## Destroys and recreates every shape proxy with the given proxy type.
Private Sub RecreateShapeProxies(body As Body, proxyType As BodyType)
Var xf As Transform = Me.GetBodyTransform(body)
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
Me.DestroyShapeProxy(shape)
Me.CreateShapeProxy(shape, proxyType, xf, True)
Wend
End Sub

## Teleports the body and refreshes shape proxies, ported from
## b2Body_SetTransform.
Sub SetBodyTransform(body As Body, position As Vector2, rotation As Rot)
Me.ValidateBody(body)
If Not position.X.IsFinite() Or Not position.Y.IsFinite() Then
Throw New InvalidArgumentException("Body position must be finite")
End If
If Not Rot.IsValid(rotation) Then
Throw New InvalidArgumentException("Body rotation must be a valid unit rotation")
End If
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
sims.PX.Items[li] = position.X
sims.PY.Items[li] = position.Y
sims.QC.Items[li] = rotation.C
sims.QS.Items[li] = rotation.S
Var localCX As Double = sims.LCX.Items[li]
Var localCY As Double = sims.LCY.Items[li]
Var centerX As Double = rotation.C * localCX - rotation.S * localCY + position.X
Var centerY As Double = rotation.S * localCX + rotation.C * localCY + position.Y
sims.CenterX.Items[li] = centerX
sims.CenterY.Items[li] = centerY
sims.R0C.Items[li] = rotation.C
sims.R0S.Items[li] = rotation.S
sims.C0X.Items[li] = centerX
sims.C0Y.Items[li] = centerY
Me.SyncShapeProxies(body)
End Sub

## Recomputes shape bounds after a transform change and moves proxies whose
## fat bounds no longer contain them, ported from the proxy update inside
## b2Body_SetTransform.
Private Sub SyncShapeProxies(body As Body)
Me.GetBodyTransformTo(body, Me.mTransformScratch)
Var xf As Transform = Me.mTransformScratch
Var margin As Double = PhysicsConstants.AABB_MARGIN
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
Me.ComputeShapeAABBTo(shape, xf, shape.AABB)
Var lowerX As Double = shape.AABB.LowerBound.X - speculativeDistance
Var lowerY As Double = shape.AABB.LowerBound.Y - speculativeDistance
Var upperX As Double = shape.AABB.UpperBound.X + speculativeDistance
Var upperY As Double = shape.AABB.UpperBound.Y + speculativeDistance
shape.AABB.LowerBound.Set(lowerX, lowerY)
shape.AABB.UpperBound.Set(upperX, upperY)
If shape.FatAABB.LowerBound.X > lowerX Or shape.FatAABB.LowerBound.Y > lowerY Or shape.FatAABB.UpperBound.X < upperX Or shape.FatAABB.UpperBound.Y < upperY Then
shape.FatAABB.LowerBound.Set(lowerX - margin, lowerY - margin)
shape.FatAABB.UpperBound.Set(upperX + margin, upperY + margin)
If shape.ProxyKey <> PhysicsConstants.NULL_INDEX Then
Me.BroadPhase.MoveProxy(shape.ProxyKey, shape.FatAABB)
End If
End If
shapeId = shape.NextShapeId
Wend
End Sub

## Computes the union of attached shape bounds, ported from
## b2Body_ComputeAABB. A body without shapes reports its origin point.
Function ComputeBodyAABB(body As Body) As AABB
Me.ValidateBody(body)
If body.HeadShapeId = PhysicsConstants.NULL_INDEX Then
Var xf As Transform = Me.GetBodyTransform(body)
Var box As New AABB
box.LowerBound.Set(xf.P.X, xf.P.Y)
box.UpperBound.Set(xf.P.X, xf.P.Y)
Return box
End If
Var shape As Shape = Me.Shapes[body.HeadShapeId]
Var result As New AABB(shape.AABB)
While shape.NextShapeId <> PhysicsConstants.NULL_INDEX
shape = Me.Shapes[shape.NextShapeId]
AABB.UnionTo(result, shape.AABB, result)
Wend
Return result
End Function

# ------------------------------------------------------------------
# Shape lifecycle
# ------------------------------------------------------------------

## Shared shape creation, ported from b2CreateShapeInternal. The geometry
## argument must match shapeType. Chain segments are created by CreateChain.
Private Function CreateShapeInternal(body As Body, def As ShapeDefinition, shapeType As ShapeType, circle As Circle, capsule As Capsule, segment As Segment, polygon As Polygon, chainSegment As ChainSegment) As Shape
Me.CheckNotLocked()
Me.CheckDefinition(def, "ShapeDefinition")
If Not def.Density.IsFinite() Or def.Density < 0.0 Then
Throw New InvalidArgumentException("ShapeDefinition density must be finite and non-negative")
End If
If Not def.Material.Friction.IsFinite() Or def.Material.Friction < 0.0 Then
Throw New InvalidArgumentException("ShapeDefinition friction must be finite and non-negative")
End If
If Not def.Material.Restitution.IsFinite() Or def.Material.Restitution < 0.0 Then
Throw New InvalidArgumentException("ShapeDefinition restitution must be finite and non-negative")
End If

Var shapeId As Integer = Me.ShapeIdPool.AllocId()
If shapeId = Me.Shapes.Count Then
Me.Shapes.Append(New Shape)
Else
Me.Shapes[shapeId] = New Shape
End If
Var shape As Shape = Me.Shapes[shapeId]

shape.Owner = Me
shape.Id = shapeId
shape.Live = True
shape.BodyId = body.Id
shape.Type = shapeType
shape.Density = def.Density
shape.Friction = def.Material.Friction
shape.Restitution = def.Material.Restitution
shape.RollingResistance = def.Material.RollingResistance
shape.TangentSpeed = def.Material.TangentSpeed
shape.UserMaterialId = def.Material.UserMaterialId
shape.CustomColor = def.Material.CustomColor
shape.Filter = New Filter(def.Filter)
shape.UserData = def.UserData
shape.EnableSensorEvents = def.EnableSensorEvents
shape.EnableContactEvents = def.EnableContactEvents
shape.EnableHitEvents = def.EnableHitEvents
shape.EnablePreSolveEvents = def.EnablePreSolveEvents
shape.IsSensorFlag = def.IsSensor
shape.ProxyKey = PhysicsConstants.NULL_INDEX
shape.EnlargedAABB = False
shape.Circle = circle
shape.Capsule = capsule
shape.Segment = segment
shape.Polygon = polygon
shape.ChainSegment = chainSegment
Me.GetShapeCentroidTo(shape, shape.LocalCentroid)
shape.RebuildDistanceProxy()
If shapeId = Me.ShapeGenerations.Count Then
Me.ShapeGenerations.Append(0)
End If
shape.Generation = Me.ShapeGenerations.Items[shapeId] + 1
Me.ShapeGenerations.Items[shapeId] = shape.Generation

If body.SetIndex <> 1 Then
Me.GetBodyTransformTo(body, Me.mTransformScratch)
Var xf As Transform = Me.mTransformScratch
Var forcePairCreation As Boolean = def.InvokeContactCreation Or def.IsSensor
Me.CreateShapeProxy(shape, body.Type, xf, forcePairCreation)
End If

# Register sensor shapes in the sensor store, ported from b2CreateShape.
If shape.IsSensorFlag Then
shape.SensorIndex = Me.Sensors.Count
Me.Sensors.Append(New Sensor(shapeId))
End If

# Attach to the body's doubly linked shape list.
If body.HeadShapeId <> PhysicsConstants.NULL_INDEX Then
Me.Shapes[body.HeadShapeId].PrevShapeId = shapeId
End If
shape.PrevShapeId = PhysicsConstants.NULL_INDEX
shape.NextShapeId = body.HeadShapeId
body.HeadShapeId = shapeId
body.ShapeCount = body.ShapeCount + 1
Return shape
End Function

## Creates a circle shape, ported from b2CreateCircleShape.
Function CreateCircleShape(body As Body, def As ShapeDefinition, circle As Circle) As Shape
Me.CheckDefinition(circle, "Circle")
Var shape As Shape = Me.CreateShapeInternal(body, def, ShapeType.CircleShape, New Circle(circle), Nothing, Nothing, Nothing, Nothing)
If def.UpdateBodyMass Then
Me.UpdateBodyMassData(body)
End If
Return shape
End Function

## Creates a capsule shape, collapsing degenerate capsules to circles,
## ported from b2CreateCapsuleShape.
Function CreateCapsuleShape(body As Body, def As ShapeDefinition, capsule As Capsule) As Shape
Me.CheckDefinition(capsule, "Capsule")
Var dx As Double = capsule.Center2.X - capsule.Center1.X
Var dy As Double = capsule.Center2.Y - capsule.Center1.Y
If dx * dx + dy * dy <= PhysicsConstants.LINEAR_SLOP * PhysicsConstants.LINEAR_SLOP Then
Var center As Vector2 = Vector2.Lerp(capsule.Center1, capsule.Center2, 0.5)
Var degenerate As Shape = Me.CreateShapeInternal(body, def, ShapeType.CircleShape, New Circle(center, capsule.Radius), Nothing, Nothing, Nothing, Nothing)
If def.UpdateBodyMass Then
Me.UpdateBodyMassData(body)
End If
Return degenerate
End If
Var full As Shape = Me.CreateShapeInternal(body, def, ShapeType.CapsuleShape, Nothing, New Capsule(capsule), Nothing, Nothing, Nothing)
If def.UpdateBodyMass Then
Me.UpdateBodyMassData(body)
End If
Return full
End Function

## Creates a polygon shape, ported from b2CreatePolygonShape.
Function CreatePolygonShape(body As Body, def As ShapeDefinition, polygon As Polygon) As Shape
Me.CheckDefinition(polygon, "Polygon")
If Not polygon.Radius.IsFinite() Or polygon.Radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If
Var shape As Shape = Me.CreateShapeInternal(body, def, ShapeType.PolygonShape, Nothing, Nothing, Nothing, polygon, Nothing)
If def.UpdateBodyMass Then
Me.UpdateBodyMassData(body)
End If
Return shape
End Function

## Creates a segment shape, rejecting degenerate segments, ported from
## b2CreateSegmentShape.
Function CreateSegmentShape(body As Body, def As ShapeDefinition, segment As Segment) As Shape
Me.CheckDefinition(segment, "Segment")
Var dx As Double = segment.Point2.X - segment.Point1.X
Var dy As Double = segment.Point2.Y - segment.Point1.Y
If dx * dx + dy * dy <= PhysicsConstants.LINEAR_SLOP * PhysicsConstants.LINEAR_SLOP Then
Throw New InvalidArgumentException("Segment length must exceed the linear slop")
End If
Var shape As Shape = Me.CreateShapeInternal(body, def, ShapeType.SegmentShape, Nothing, Nothing, New Segment(segment), Nothing, Nothing)
If def.UpdateBodyMass Then
Me.UpdateBodyMassData(body)
End If
Return shape
End Function

## Replaces a shape's geometry with a circle and rebuilds the proxy, ported
## from b2Shape_SetCircle.
Sub SetShapeGeometryCircle(shape As Shape, circle As Circle)
Me.ValidateShape(shape)
Me.CheckDefinition(circle, "Circle")
shape.Circle = New Circle(circle)
shape.Capsule = Nothing
shape.Segment = Nothing
shape.Polygon = Nothing
shape.ChainSegment = Nothing
shape.Type = ShapeType.CircleShape
shape.LocalCentroid = Me.GetShapeCentroid(shape)
shape.RebuildDistanceProxy()
Me.ResetShapeProxy(shape, True, True)
End Sub

## Replaces a shape's geometry with a capsule and rebuilds the proxy,
## ported from b2Shape_SetCapsule.
Sub SetShapeGeometryCapsule(shape As Shape, capsule As Capsule)
Me.ValidateShape(shape)
Me.CheckDefinition(capsule, "Capsule")
shape.Circle = Nothing
shape.Capsule = New Capsule(capsule)
shape.Segment = Nothing
shape.Polygon = Nothing
shape.ChainSegment = Nothing
shape.Type = ShapeType.CapsuleShape
shape.LocalCentroid = Me.GetShapeCentroid(shape)
shape.RebuildDistanceProxy()
Me.ResetShapeProxy(shape, True, True)
End Sub

## Replaces a shape's geometry with a segment and rebuilds the proxy,
## ported from b2Shape_SetSegment.
Sub SetShapeGeometrySegment(shape As Shape, segment As Segment)
Me.ValidateShape(shape)
Me.CheckDefinition(segment, "Segment")
shape.Circle = Nothing
shape.Capsule = Nothing
shape.Segment = New Segment(segment)
shape.Polygon = Nothing
shape.ChainSegment = Nothing
shape.Type = ShapeType.SegmentShape
shape.LocalCentroid = Me.GetShapeCentroid(shape)
shape.RebuildDistanceProxy()
Me.ResetShapeProxy(shape, True, True)
End Sub

## Replaces a shape's geometry with a polygon and rebuilds the proxy,
## ported from b2Shape_SetPolygon.
Sub SetShapeGeometryPolygon(shape As Shape, polygon As Polygon)
Me.ValidateShape(shape)
Me.CheckDefinition(polygon, "Polygon")
shape.Circle = Nothing
shape.Capsule = Nothing
shape.Segment = Nothing
shape.Polygon = polygon
shape.ChainSegment = Nothing
shape.Type = ShapeType.PolygonShape
shape.LocalCentroid = Me.GetShapeCentroid(shape)
shape.RebuildDistanceProxy()
Me.ResetShapeProxy(shape, True, True)
End Sub

## Sets the shape density and optionally recomputes body mass, ported from
## b2Shape_SetDensity.
Sub SetShapeDensity(shape As Shape, density As Double, updateBodyMass As Boolean)
Me.ValidateShape(shape)
If Not density.IsFinite() Or density < 0.0 Then
Throw New InvalidArgumentException("Shape density must be finite and non-negative")
End If
If density = shape.Density Then
Return
End If
shape.Density = density
If updateBodyMass Then
Me.UpdateBodyMassData(Me.Bodies[shape.BodyId])
End If
End Sub

## Replaces the shape filter and refreshes the broad-phase proxy, ported
## from b2Shape_SetFilter.
Sub SetShapeFilter(shape As Shape, filter As Filter)
Me.ValidateShape(shape)
Me.CheckDefinition(filter, "Filter")
shape.Filter = New Filter(filter)
Me.ResetShapeProxy(shape, True, True)
End Sub

## Recomputes shape bounds and refreshes the broad-phase proxy, ported from
## b2ResetProxy. Contact destruction arrives in Stage 7.
Private Sub ResetShapeProxy(shape As Shape, wakeBodies As Boolean, destroyProxy As Boolean)
Pragma Unused wakeBodies
Var body As Body = Me.Bodies[shape.BodyId]
Me.GetBodyTransformTo(body, Me.mTransformScratch)
Var xf As Transform = Me.mTransformScratch
If shape.ProxyKey <> PhysicsConstants.NULL_INDEX Then
Var proxyType As BodyType = body.Type
Var treeType As Integer = shape.ProxyKey.BitAnd(3)
If treeType = Integer(BodyType.StaticBody) Then
proxyType = BodyType.StaticBody
ElseIf treeType = Integer(BodyType.KinematicBody) Then
proxyType = BodyType.KinematicBody
End If
Me.UpdateShapeAABBs(shape, xf, proxyType)
If destroyProxy Then
Me.BroadPhase.DestroyProxy(shape.ProxyKey)
shape.ProxyKey = Me.BroadPhase.CreateProxy(proxyType, shape.FatAABB, shape.Filter.CategoryBits, shape.Id, True)
Else
Me.BroadPhase.MoveProxy(shape.ProxyKey, shape.FatAABB)
End If
Else
Me.UpdateShapeAABBs(shape, xf, body.Type)
End If
End Sub

## Creates the broad-phase proxy for a shape, ported from
## b2CreateShapeProxy.
Private Sub CreateShapeProxy(shape As Shape, proxyType As BodyType, xf As Transform, forcePairCreation As Boolean)
If shape.ProxyKey <> PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Shape proxy already exists")
End If
Me.UpdateShapeAABBs(shape, xf, proxyType)
shape.ProxyKey = Me.BroadPhase.CreateProxy(proxyType, shape.FatAABB, shape.Filter.CategoryBits, shape.Id, forcePairCreation)
End Sub

## Destroys the broad-phase proxy for a shape, ported from
## b2DestroyShapeProxy.
Private Sub DestroyShapeProxy(shape As Shape)
If shape.ProxyKey <> PhysicsConstants.NULL_INDEX Then
Me.BroadPhase.DestroyProxy(shape.ProxyKey)
shape.ProxyKey = PhysicsConstants.NULL_INDEX
End If
End Sub

## Computes the shape bounds with the speculative margin and stores the fat
## bounds, ported from b2UpdateShapeAABBs.
Private Sub UpdateShapeAABBs(shape As Shape, xf As Transform, proxyType As BodyType)
Var speculativeDistance As Double = PhysicsConstants.SPECULATIVE_DISTANCE
Var aabbMargin As Double = PhysicsConstants.AABB_MARGIN
Me.ComputeShapeAABBTo(shape, xf, shape.AABB)
Var lowerX As Double = shape.AABB.LowerBound.X - speculativeDistance
Var lowerY As Double = shape.AABB.LowerBound.Y - speculativeDistance
Var upperX As Double = shape.AABB.UpperBound.X + speculativeDistance
Var upperY As Double = shape.AABB.UpperBound.Y + speculativeDistance
shape.AABB.LowerBound.Set(lowerX, lowerY)
shape.AABB.UpperBound.Set(upperX, upperY)
Var margin As Double = aabbMargin
If proxyType = BodyType.StaticBody Then
margin = speculativeDistance
End If
shape.FatAABB.LowerBound.Set(lowerX - margin, lowerY - margin)
shape.FatAABB.UpperBound.Set(upperX + margin, upperY + margin)
End Sub

## Computes the world bounds of a shape's geometry, ported from
## b2ComputeShapeAABB.
## Writes the world bounds of a shape's geometry into a caller-owned AABB,
## for warm paths.
Private Function ComputeShapeAABBTo(shape As Shape, transform As Transform, out As AABB) As AABB
If shape.Type = ShapeType.CapsuleShape Then
Return shape.Capsule.ComputeAABBTo(transform, out)
ElseIf shape.Type = ShapeType.CircleShape Then
Return shape.Circle.ComputeAABBTo(transform, out)
ElseIf shape.Type = ShapeType.PolygonShape Then
Return shape.Polygon.ComputeAABBTo(transform, out)
ElseIf shape.Type = ShapeType.SegmentShape Then
Return shape.Segment.ComputeAABBTo(transform, out)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
Return shape.ChainSegment.Segment.ComputeAABBTo(transform, out)
End If
Throw New RuntimeException("Shape has unknown geometry type")
End Function

## Computes the local centroid of a shape's geometry, ported from
## b2GetShapeCentroid.
Private Function GetShapeCentroid(shape As Shape) As Vector2
Return Me.GetShapeCentroidTo(shape, New Vector2(0.0, 0.0))
End Function

## Writes a shape's local centroid into a caller-owned vector, for warm
## paths.
Private Function GetShapeCentroidTo(shape As Shape, out As Vector2) As Vector2
If shape.Type = ShapeType.CapsuleShape Then
out.Set(0.5 * (shape.Capsule.Center1.X + shape.Capsule.Center2.X), 0.5 * (shape.Capsule.Center1.Y + shape.Capsule.Center2.Y))
ElseIf shape.Type = ShapeType.CircleShape Then
out.Set(shape.Circle.Center.X, shape.Circle.Center.Y)
ElseIf shape.Type = ShapeType.PolygonShape Then
out.Set(shape.Polygon.Centroid.X, shape.Polygon.Centroid.Y)
ElseIf shape.Type = ShapeType.SegmentShape Then
out.Set(0.5 * (shape.Segment.Point1.X + shape.Segment.Point2.X), 0.5 * (shape.Segment.Point1.Y + shape.Segment.Point2.Y))
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
out.Set(0.5 * (shape.ChainSegment.Segment.Point1.X + shape.ChainSegment.Segment.Point2.X), 0.5 * (shape.ChainSegment.Segment.Point1.Y + shape.ChainSegment.Segment.Point2.Y))
Else
out.Set(0.0, 0.0)
End If
Return out
End Function

## Computes the mass data of a shape's geometry at its density, ported from
## b2ComputeShapeMass. Segments and chain segments report zero mass.
Function ComputeShapeMass(shape As Shape) As MassData
Return Me.ComputeShapeMassTo(shape, New MassData)
End Function

## Writes a shape's mass data at its density into a caller-owned record,
## for warm paths. Segments and chain segments report zero mass.
Private Function ComputeShapeMassTo(shape As Shape, out As MassData) As MassData
Me.ValidateShape(shape)
If shape.Type = ShapeType.CapsuleShape Then
Return shape.Capsule.ComputeMassTo(shape.Density, out)
ElseIf shape.Type = ShapeType.CircleShape Then
Return shape.Circle.ComputeMassTo(shape.Density, out)
ElseIf shape.Type = ShapeType.PolygonShape Then
Return shape.Polygon.ComputeMassTo(shape.Density, out)
End If
out.Mass = 0.0
out.Center.Set(0.0, 0.0)
out.RotationalInertia = 0.0
Return out
End Function

## Computes the minimum and maximum shape extent relative to a local
## centre, ported from b2ComputeShapeExtent. The result is written into the
## caller-owned extent record.
Private Sub ComputeShapeExtent(shape As Shape, localCenter As Vector2, extent As ShapeExtent)
If shape.Type = ShapeType.CapsuleShape Then
extent.MinExtent = shape.Capsule.Radius
Var c1x As Double = shape.Capsule.Center1.X - localCenter.X
Var c1y As Double = shape.Capsule.Center1.Y - localCenter.Y
Var c2x As Double = shape.Capsule.Center2.X - localCenter.X
Var c2y As Double = shape.Capsule.Center2.Y - localCenter.Y
Var d1 As Double = c1x * c1x + c1y * c1y
Var d2 As Double = c2x * c2x + c2y * c2y
Var maxD As Double = d1
If d2 > maxD Then
maxD = d2
End If
extent.MaxExtent = Maths.Sqrt(maxD) + shape.Capsule.Radius
ElseIf shape.Type = ShapeType.CircleShape Then
extent.MinExtent = shape.Circle.Radius
Var dx As Double = shape.Circle.Center.X - localCenter.X
Var dy As Double = shape.Circle.Center.Y - localCenter.Y
extent.MaxExtent = Maths.Sqrt(dx * dx + dy * dy) + shape.Circle.Radius
ElseIf shape.Type = ShapeType.PolygonShape Then
Var minE As Double = PhysicsConstants.POSITION_LIMIT
Var maxESqr As Double = 0.0
For i As Integer = 0 To shape.Polygon.Count - 1
Var vx As Double = shape.Polygon.Vertices[i].X
Var vy As Double = shape.Polygon.Vertices[i].Y
Var nx As Double = shape.Polygon.Normals[i].X
Var ny As Double = shape.Polygon.Normals[i].Y
Var planeOffset As Double = nx * (vx - shape.Polygon.Centroid.X) + ny * (vy - shape.Polygon.Centroid.Y)
If planeOffset < minE Then
minE = planeOffset
End If
Var ex As Double = vx - localCenter.X
Var ey As Double = vy - localCenter.Y
Var distanceSqr As Double = ex * ex + ey * ey
If distanceSqr > maxESqr Then
maxESqr = distanceSqr
End If
Next i
extent.MinExtent = minE + shape.Polygon.Radius
extent.MaxExtent = Maths.Sqrt(maxESqr) + shape.Polygon.Radius
ElseIf shape.Type = ShapeType.SegmentShape Then
extent.MinExtent = 0.0
Var c1x As Double = shape.Segment.Point1.X - localCenter.X
Var c1y As Double = shape.Segment.Point1.Y - localCenter.Y
Var c2x As Double = shape.Segment.Point2.X - localCenter.X
Var c2y As Double = shape.Segment.Point2.Y - localCenter.Y
Var d1 As Double = c1x * c1x + c1y * c1y
Var d2 As Double = c2x * c2x + c2y * c2y
Var maxD As Double = d1
If d2 > maxD Then
maxD = d2
End If
extent.MaxExtent = Maths.Sqrt(maxD)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
extent.MinExtent = 0.0
Var s1x As Double = shape.ChainSegment.Segment.Point1.X - localCenter.X
Var s1y As Double = shape.ChainSegment.Segment.Point1.Y - localCenter.Y
Var s2x As Double = shape.ChainSegment.Segment.Point2.X - localCenter.X
Var s2y As Double = shape.ChainSegment.Segment.Point2.Y - localCenter.Y
Var d1 As Double = s1x * s1x + s1y * s1y
Var d2 As Double = s2x * s2x + s2y * s2y
Var maxD As Double = d1
If d2 > maxD Then
maxD = d2
End If
extent.MaxExtent = Maths.Sqrt(maxD)
Else
extent.MinExtent = 0.0
extent.MaxExtent = 0.0
End If
End Sub

## Recomputes body mass, centre of mass, inertia, and extents from the
## attached shapes, ported from b2UpdateBodyMassData.
Sub UpdateBodyMassData(body As Body)
Me.ValidateBody(body)
Var sims As BodySims = Me.GetBodySim(body)
Var li As Integer = body.LocalIndex
body.Mass = 0.0
body.Inertia = 0.0
sims.InvMass.Items[li] = 0.0
sims.InvInertia.Items[li] = 0.0
sims.LCX.Items[li] = 0.0
sims.LCY.Items[li] = 0.0
sims.MinExtent.Items[li] = PhysicsConstants.POSITION_LIMIT
sims.MaxExtent.Items[li] = 0.0

# Static and kinematic sims have zero mass.
If body.Type <> BodyType.DynamicBody Then
sims.CenterX.Items[li] = sims.PX.Items[li]
sims.CenterY.Items[li] = sims.PY.Items[li]
If body.Type = BodyType.KinematicBody Then
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var kinShape As Shape = Me.Shapes[shapeId]
shapeId = kinShape.NextShapeId
Me.mVectorScratch.Set(0.0, 0.0)
Me.ComputeShapeExtent(kinShape, Me.mVectorScratch, Me.mExtentScratch)
If Me.mExtentScratch.MinExtent < sims.MinExtent.Items[li] Then
sims.MinExtent.Items[li] = Me.mExtentScratch.MinExtent
End If
If Me.mExtentScratch.MaxExtent > sims.MaxExtent.Items[li] Then
sims.MaxExtent.Items[li] = Me.mExtentScratch.MaxExtent
End If
Wend
End If
Return
End If

# Accumulate mass over all shapes.
Var centerWX As Double = 0.0
Var centerWY As Double = 0.0
Var shapeId As Integer = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
If shape.Density = 0.0 Then
Continue While
End If
Me.ComputeShapeMassTo(shape, Me.mMassScratch)
body.Mass = body.Mass + Me.mMassScratch.Mass
centerWX = centerWX + Me.mMassScratch.Mass * Me.mMassScratch.Center.X
centerWY = centerWY + Me.mMassScratch.Mass * Me.mMassScratch.Center.Y
body.Inertia = body.Inertia + Me.mMassScratch.RotationalInertia
Wend

# Compute centre of mass.
If body.Mass > 0.0 Then
sims.InvMass.Items[li] = 1.0 / body.Mass
centerWX = sims.InvMass.Items[li] * centerWX
centerWY = sims.InvMass.Items[li] * centerWY
sims.LCX.Items[li] = centerWX
sims.LCY.Items[li] = centerWY
End If

If body.Inertia > 0.0 And Not body.FixedRotation Then
# Centre the inertia about the centre of mass.
body.Inertia = body.Inertia - body.Mass * (centerWX * centerWX + centerWY * centerWY)
sims.InvInertia.Items[li] = 1.0 / body.Inertia
Else
body.Inertia = 0.0
sims.InvInertia.Items[li] = 0.0
End If

# Move centre of mass.
Var oldCenterX As Double = sims.CenterX.Items[li]
Var oldCenterY As Double = sims.CenterY.Items[li]
Var qc As Double = sims.QC.Items[li]
Var qs As Double = sims.QS.Items[li]
Var newCenterX As Double = qc * centerWX - qs * centerWY + sims.PX.Items[li]
Var newCenterY As Double = qs * centerWX + qc * centerWY + sims.PY.Items[li]
sims.CenterX.Items[li] = newCenterX
sims.CenterY.Items[li] = newCenterY
sims.C0X.Items[li] = newCenterX
sims.C0Y.Items[li] = newCenterY

# Update centre of mass velocity.
Var states As BodyStates = Me.GetBodyState(body)
If states <> Nothing Then
Var rx As Double = newCenterX - oldCenterX
Var ry As Double = newCenterY - oldCenterY
Var angularVelocity As Double = states.AngularVelocity.Items[li]
states.LVX.Items[li] = states.LVX.Items[li] - angularVelocity * ry
states.LVY.Items[li] = states.LVY.Items[li] + angularVelocity * rx
End If

# Compute body extents relative to the centre of mass.
Me.mVectorScratch.Set(centerWX, centerWY)
shapeId = body.HeadShapeId
While shapeId <> PhysicsConstants.NULL_INDEX
Var shape As Shape = Me.Shapes[shapeId]
shapeId = shape.NextShapeId
Me.ComputeShapeExtent(shape, Me.mVectorScratch, Me.mExtentScratch)
If Me.mExtentScratch.MinExtent < sims.MinExtent.Items[li] Then
sims.MinExtent.Items[li] = Me.mExtentScratch.MinExtent
End If
If Me.mExtentScratch.MaxExtent > sims.MaxExtent.Items[li] Then
sims.MaxExtent.Items[li] = Me.mExtentScratch.MaxExtent
End If
Wend
End Sub

## Throws when the shape façade is stale.
Private Sub ValidateShape(shape As Shape)
If Not shape.IsValid() Then
Throw New RuntimeException("Shape façade is no longer valid")
End If
End Sub

## Throws when the chain façade is stale.
Private Sub ValidateChain(chain As Chain)
If Not chain.IsValid() Then
Throw New RuntimeException("Chain façade is no longer valid")
End If
End Sub

## Destroys a shape, ported from b2DestroyShape. Called by Shape.Destroy and
## the body destruction cascade.
Sub DestroyShape(shape As Shape, updateBodyMass As Boolean)
Me.CheckNotLocked()
Me.ValidateShape(shape)
Var body As Body = Me.Bodies[shape.BodyId]

# Remove the shape from the body's doubly linked list.
If shape.PrevShapeId <> PhysicsConstants.NULL_INDEX Then
Me.Shapes[shape.PrevShapeId].NextShapeId = shape.NextShapeId
End If
If shape.NextShapeId <> PhysicsConstants.NULL_INDEX Then
Me.Shapes[shape.NextShapeId].PrevShapeId = shape.PrevShapeId
End If
If shape.Id = body.HeadShapeId Then
body.HeadShapeId = shape.NextShapeId
End If
body.ShapeCount = body.ShapeCount - 1

Me.DestroyShapeProxy(shape)

# Destroy any contacts associated with the shape, ported from
# b2DestroyShapeInternal.
ContactMethods.DestroyShapeContacts(Me, body, shape.Id, True)

# End sensor overlaps and remove the sensor record, ported from the sensor
# branch of b2DestroyShape.
If shape.SensorIndex <> PhysicsConstants.NULL_INDEX Then
Me.DestroySensor(shape)
End If

Me.ShapeIdPool.FreeId(shape.Id)
shape.Live = False
Me.ShapeGenerations.Items[shape.Id] = Me.ShapeGenerations.Items[shape.Id] + 1
shape.Generation = Me.ShapeGenerations.Items[shape.Id]
Me.Shapes[shape.Id] = Nothing
shape.Id = PhysicsConstants.NULL_INDEX
shape.BodyId = PhysicsConstants.NULL_INDEX

If updateBodyMass Then
Me.UpdateBodyMassData(body)
End If
End Sub

# ------------------------------------------------------------------
# Chain lifecycle
# ------------------------------------------------------------------

## Creates a chain of chain-segment shapes on the definition's body, ported
## from b2CreateChain. Loops use one material per solid segment; open chains
## need at least four points and produce count minus three segments.
Function CreateChain(def As ChainDefinition) As Chain
Me.CheckDefinition(def, "ChainDefinition")
Me.CheckDefinition(def.Body, "ChainDefinition.Body")
Me.CheckNotLocked()
If def.Points.Count < 4 Then
Throw New InvalidArgumentException("ChainDefinition needs at least four points")
End If
If def.Materials.Count <> 1 And def.Materials.Count <> def.Points.Count Then
Throw New InvalidArgumentException("ChainDefinition materials must be one or one per point")
End If
Var body As Body = def.Body
Me.ValidateBody(body)
For i As Integer = 0 To def.Materials.Count - 1
Var material As SurfaceMaterial = def.Materials[i]
If Not material.Friction.IsFinite() Or material.Friction < 0.0 Then
Throw New InvalidArgumentException("ChainDefinition friction must be finite and non-negative")
End If
If Not material.Restitution.IsFinite() Or material.Restitution < 0.0 Then
Throw New InvalidArgumentException("ChainDefinition restitution must be finite and non-negative")
End If
If Not material.RollingResistance.IsFinite() Or material.RollingResistance < 0.0 Then
Throw New InvalidArgumentException("ChainDefinition rolling resistance must be finite and non-negative")
End If
If Not material.TangentSpeed.IsFinite() Then
Throw New InvalidArgumentException("ChainDefinition tangent speed must be finite")
End If
Next i

Var chainId As Integer = Me.ChainIdPool.AllocId()
If chainId = Me.Chains.Count Then
Me.Chains.Append(New Chain)
Else
Me.Chains[chainId] = New Chain
End If
Var chain As Chain = Me.Chains[chainId]

chain.Owner = Me
chain.Id = chainId
chain.Live = True
chain.BodyId = body.Id
chain.NextChainId = body.HeadChainId
If chainId = Me.ChainGenerations.Count Then
Me.ChainGenerations.Append(0)
End If
chain.Generation = Me.ChainGenerations.Items[chainId] + 1
Me.ChainGenerations.Items[chainId] = chain.Generation
chain.MaterialCount = def.Materials.Count
For i As Integer = 0 To chain.MaterialCount - 1
chain.Materials.Append(New SurfaceMaterial(def.Materials[i]))
Next i
chain.Filter = New Filter(def.Filter)
chain.UserData = def.UserData
chain.IsLoop = def.IsLoop
body.HeadChainId = chainId

Var shapeDef As New ShapeDefinition
shapeDef.UserData = def.UserData
shapeDef.Filter = New Filter(def.Filter)
shapeDef.EnableSensorEvents = def.EnableSensorEvents
shapeDef.EnableContactEvents = False
shapeDef.EnableHitEvents = False

Var n As Integer = def.Points.Count
If def.IsLoop Then
Me.AppendLoopChainSegments(body, chain, shapeDef, def.Points, n)
Else
Me.AppendOpenChainSegments(body, chain, shapeDef, def.Points, n)
End If
Return chain
End Function

## Creates the segment shapes of a loop chain, ported from the loop branch
## of b2CreateChain.
Private Sub AppendLoopChainSegments(body As Body, chain As Chain, shapeDef As ShapeDefinition, points As Array(Of Vector2), n As Integer)
chain.SegmentCount = n
Var chainId As Integer = chain.Id
Var prevIndex As Integer = n - 1
For i As Integer = 0 To n - 3
Var chainSegment As New ChainSegment(New Segment(points[i], points[i + 1]), points[prevIndex], points[i + 2], chainId)
prevIndex = i
Var shape As Shape = Me.CreateChainSegmentShape(body, chain, shapeDef, chainSegment, i)
chain.ShapeIndices.Append(shape.Id)
Next i

Var tailSegment As New ChainSegment(New Segment(points[n - 2], points[n - 1]), points[n - 3], points[0], chainId)
Var tailShape As Shape = Me.CreateChainSegmentShape(body, chain, shapeDef, tailSegment, n - 2)
chain.ShapeIndices.Append(tailShape.Id)

Var wrapSegment As New ChainSegment(New Segment(points[n - 1], points[0]), points[n - 2], points[1], chainId)
Var wrapShape As Shape = Me.CreateChainSegmentShape(body, chain, shapeDef, wrapSegment, n - 1)
chain.ShapeIndices.Append(wrapShape.Id)
End Sub

## Creates the segment shapes of an open chain, ported from the open branch
## of b2CreateChain.
Private Sub AppendOpenChainSegments(body As Body, chain As Chain, shapeDef As ShapeDefinition, points As Array(Of Vector2), n As Integer)
chain.SegmentCount = n - 3
For i As Integer = 0 To n - 4
Var chainSegment As New ChainSegment(New Segment(points[i + 1], points[i + 2]), points[i], points[i + 3], chain.Id)
Var shape As Shape = Me.CreateChainSegmentShape(body, chain, shapeDef, chainSegment, i + 1)
chain.ShapeIndices.Append(shape.Id)
Next i
End Sub

## Creates one chain segment shape with the chain's material for the given
## point index, ported from the material selection in b2CreateChain.
Private Function CreateChainSegmentShape(body As Body, chain As Chain, shapeDef As ShapeDefinition, chainSegment As ChainSegment, materialIndex As Integer) As Shape
Var resolvedIndex As Integer = materialIndex
If chain.MaterialCount = 1 Then
resolvedIndex = 0
End If
shapeDef.Material = New SurfaceMaterial(chain.Materials[resolvedIndex])
Return Me.CreateShapeInternal(body, shapeDef, ShapeType.ChainSegmentShape, Nothing, Nothing, Nothing, Nothing, chainSegment)
End Function

## Destroys a chain, ported from b2DestroyChain. The segment shapes were
## already destroyed by the body cascade or are destroyed here.
Sub DestroyChain(chain As Chain)
Me.CheckNotLocked()
Me.ValidateChain(chain)

# Unlink from the body's chain list.
Var body As Body = Me.Bodies[chain.BodyId]
If chain.PrevChainId <> PhysicsConstants.NULL_INDEX Then
Me.Chains[chain.PrevChainId].NextChainId = chain.NextChainId
End If
If chain.NextChainId <> PhysicsConstants.NULL_INDEX Then
Me.Chains[chain.NextChainId].PrevChainId = chain.PrevChainId
End If
If chain.Id = body.HeadChainId Then
body.HeadChainId = chain.NextChainId
End If

# Destroy every segment shape.
For i As Integer = 0 To chain.SegmentCount - 1
Var shapeId As Integer = chain.ShapeIndices.Items[i]
Var shape As Shape = Me.Shapes[shapeId]
If shape <> Nothing And shape.Live Then
Me.DestroyShape(shape, False)
End If
Next i

Me.ChainIdPool.FreeId(chain.Id)
chain.Live = False
Me.ChainGenerations.Items[chain.Id] = Me.ChainGenerations.Items[chain.Id] + 1
chain.Generation = Me.ChainGenerations.Items[chain.Id]
Me.Chains[chain.Id] = Nothing
chain.Id = PhysicsConstants.NULL_INDEX
chain.BodyId = PhysicsConstants.NULL_INDEX
End Sub

# ------------------------------------------------------------------
# Shape cast dispatch
# ------------------------------------------------------------------

## Casts a ray against a shape in world space, ported from b2RayCastShape.
## The output is a fresh record.
Function RayCastShape(input As RayCastInput, shape As Shape) As CastOutput
Var out As New CastOutput
Me.RayCastShapeTo(input, shape, out)
Return out
End Function

## Casts a ray against a shape into the caller-owned output, ported from
## b2RayCastShape. The reused-output form for warm traversals.
Private Function RayCastShapeTo(input As RayCastInput, shape As Shape, out As CastOutput) As CastOutput
out.Reset()
Var xf As Transform = Me.GetShapeTransform(shape)
Me.mLocalRayInput.MaxFraction = input.MaxFraction
Me.mLocalRayInput.Origin.Set(0.0, 0.0)
Transform.InvTransformPointTo(xf, input.Origin, Me.mLocalRayInput.Origin)
Rot.InvRotateVectorTo(xf.Q, input.Translation, Me.mLocalRayInput.Translation)

If shape.Type = ShapeType.CapsuleShape Then
Casts.RayCastCapsuleTo(Me.mLocalRayInput, shape.Capsule, out)
ElseIf shape.Type = ShapeType.CircleShape Then
Casts.RayCastCircleTo(Me.mLocalRayInput, shape.Circle, out)
ElseIf shape.Type = ShapeType.PolygonShape Then
Casts.RayCastPolygonTo(Me.mLocalRayInput, shape.Polygon, out)
ElseIf shape.Type = ShapeType.SegmentShape Then
Casts.RayCastSegmentTo(Me.mLocalRayInput, shape.Segment, False, out)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
Casts.RayCastSegmentTo(Me.mLocalRayInput, shape.ChainSegment.Segment, True, out)
Else
Return out
End If

If out.Hit Then
Var worldPoint As Vector2 = Transform.TransformPoint(xf, out.Point)
Var worldNormal As Vector2 = Rot.RotateVector(xf.Q, out.Normal)
out.Point.Set(worldPoint.X, worldPoint.Y)
out.Normal.Set(worldNormal.X, worldNormal.Y)
End If
Return out
End Function

## Casts a shape against a shape in world space, ported from
## b2ShapeCastShape. The output is a fresh record.
Function ShapeCastShape(input As ShapeCastInput, shape As Shape) As CastOutput
Var out As New CastOutput
Me.ShapeCastShapeTo(input, shape, out)
Return out
End Function

## Casts a shape against a shape into the caller-owned output, ported from
## b2ShapeCastShape. The reused-output form for warm traversals.
Private Function ShapeCastShapeTo(input As ShapeCastInput, shape As Shape, out As CastOutput) As CastOutput
out.Reset()
Var xf As Transform = Me.GetShapeTransform(shape)

# Build the local proxy by inverse-transforming every caller point.
Me.mLocalProxy.Points.Clear()
Me.mLocalProxy.Count = 0
Me.mLocalProxy.Radius = input.Proxy.Radius
For i As Integer = 0 To input.Proxy.Count - 1
Transform.InvTransformPointTo(xf, input.Proxy.Points[i], Me.mLocalPoint)
Me.mLocalProxy.Points.Append(New Vector2(Me.mLocalPoint.X, Me.mLocalPoint.Y))
Next i
Me.mLocalProxy.Count = input.Proxy.Count
Rot.InvRotateVectorTo(xf.Q, input.Translation, Me.mLocalCastInput.Translation)

Me.mLocalCastInput.Proxy = Me.mLocalProxy
Me.mLocalCastInput.MaxFraction = input.MaxFraction
Me.mLocalCastInput.CanEncroach = input.CanEncroach

# The per-shape casts allocate their own outputs; copy into out.
Var temp As CastOutput = Nothing
If shape.Type = ShapeType.CapsuleShape Then
temp = Casts.ShapeCastCapsule(Me.mLocalCastInput, shape.Capsule)
ElseIf shape.Type = ShapeType.CircleShape Then
temp = Casts.ShapeCastCircle(Me.mLocalCastInput, shape.Circle)
ElseIf shape.Type = ShapeType.PolygonShape Then
temp = Casts.ShapeCastPolygon(Me.mLocalCastInput, shape.Polygon)
ElseIf shape.Type = ShapeType.SegmentShape Then
temp = Casts.ShapeCastSegment(Me.mLocalCastInput, shape.Segment)
ElseIf shape.Type = ShapeType.ChainSegmentShape Then
temp = Casts.ShapeCastSegment(Me.mLocalCastInput, shape.ChainSegment.Segment)
End If
If temp = Nothing Then
Return out
End If
out.Hit = temp.Hit
out.Fraction = temp.Fraction
out.Point.Set(temp.Point.X, temp.Point.Y)
out.Normal.Set(temp.Normal.X, temp.Normal.Y)
If out.Hit Then
Var worldPoint As Vector2 = Transform.TransformPoint(xf, out.Point)
Var worldNormal As Vector2 = Rot.RotateVector(xf.Q, out.Normal)
out.Point.Set(worldPoint.X, worldPoint.Y)
out.Normal.Set(worldNormal.X, worldNormal.Y)
End If
Return out
End Function

# ------------------------------------------------------------------
# Shape-level helpers
# ------------------------------------------------------------------

## Tests whether a world point is inside a shape, ported from
## b2Shape_TestPoint. Segments and chain segments report False.
Function ShapeTestPoint(shape As Shape, point As Vector2) As Boolean
Var xf As Transform = Me.GetShapeTransform(shape)
Var localPoint As Vector2 = Transform.InvTransformPoint(xf, point)
If shape.Type = ShapeType.CapsuleShape Then
Return shape.Capsule.ContainsPoint(localPoint)
ElseIf shape.Type = ShapeType.CircleShape Then
Return shape.Circle.ContainsPoint(localPoint)
ElseIf shape.Type = ShapeType.PolygonShape Then
Return shape.Polygon.ContainsPoint(localPoint)
End If
Return False
End Function

## Casts a ray against a shape in world space, ported from b2Shape_RayCast.
Function ShapeRayCast(shape As Shape, input As RayCastInput) As CastOutput
Return Me.RayCastShape(input, shape)
End Function

## Casts a ray against a shape into the caller-owned output, ported from
## b2Shape_RayCast.
Function ShapeRayCastTo(shape As Shape, input As RayCastInput, out As CastOutput) As CastOutput
Return Me.RayCastShapeTo(input, shape, out)
End Function

## Returns the world point on the shape closest to the target, ported from
## b2Shape_GetClosestPoint.
Function ShapeClosestPoint(shape As Shape, target As Vector2) As Vector2
Me.ValidateShape(shape)
Var input As New DistanceInput
input.ProxyA = shape.DistanceProxy
input.ProxyB = New ShapeProxy
input.ProxyB.Points.Append(New Vector2(target.X, target.Y))
input.ProxyB.Count = 1
input.ProxyB.Radius = 0.0
input.TransformA = Me.GetShapeTransform(shape)
input.TransformB = New Transform
input.UseRadii = True
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)
Return New Vector2(output.PointA.X, output.PointA.Y)
End Function

# ------------------------------------------------------------------
# World queries
# ------------------------------------------------------------------

## Queries every tree for shapes whose bounds overlap the given box and
## passes them to the callback, ported from b2World_OverlapAABB. Throws when
## the world is locked or the box is invalid.
Function OverlapBounds(aabb As AABB, filter As QueryFilter, callback As WorldOverlapCallback) As TreeStats
Return Me.OverlapBoundsInto(aabb, filter, Nothing, callback)
End Function

## Queries every tree for shapes whose bounds overlap the given box and
## appends them to the caller-owned hit list, ported from b2World_OverlapAABB
## with a collecting callback.
Function OverlapBoundsInto(aabb As AABB, filter As QueryFilter, hits As ShapeHitList) As TreeStats
Return Me.OverlapBoundsInto(aabb, filter, hits, Nothing)
End Function

## Shared overlap bounds implementation. Exactly one of hits and callback
## is Nothing.
Private Function OverlapBoundsInto(queryBounds As AABB, filter As QueryFilter, hits As ShapeHitList, callback As WorldOverlapCallback) As TreeStats
Me.CheckNotLocked()
If hits <> Nothing Then
hits.Clear()
End If
Me.CheckDefinition(filter, "QueryFilter")
If Not AABB.IsValid(queryBounds) Then
Throw New InvalidArgumentException("Overlap bounds must be valid")
End If
Var stats As New TreeStats
Me.mOverlapContext.Owner = Me
Me.mOverlapContext.Filter = filter
Me.mOverlapContext.UserCallback = callback
Me.mOverlapContext.Hits = hits
Me.mOverlapContext.QueryProxy = Nothing
For i As Integer = 0 To 2
Me.BroadPhase.Trees[i].QueryTo(queryBounds, filter.MaskBits, Me.mOverlapContext, stats)
Next i
Return stats
End Function

## Queries every tree for shapes that overlap the given proxy shape,
## ported from b2World_OverlapShape.
Function OverlapShape(proxy As ShapeProxy, filter As QueryFilter, callback As WorldOverlapCallback) As TreeStats
Return Me.OverlapShapeInto(proxy, filter, Nothing, callback)
End Function

## Queries every tree for shapes that overlap the given proxy shape and
## appends them to the caller-owned hit list, ported from b2World_OverlapShape.
Function OverlapShapeInto(proxy As ShapeProxy, filter As QueryFilter, hits As ShapeHitList) As TreeStats
Return Me.OverlapShapeInto(proxy, filter, hits, Nothing)
End Function

## Shared overlap shape implementation. Exactly one of hits and callback is
## Nothing.
Private Function OverlapShapeInto(proxy As ShapeProxy, filter As QueryFilter, hits As ShapeHitList, callback As WorldOverlapCallback) As TreeStats
Me.CheckNotLocked()
If hits <> Nothing Then
hits.Clear()
End If
Me.CheckDefinition(filter, "QueryFilter")
Me.CheckDefinition(proxy, "ShapeProxy")
If proxy.Count < 1 Then
Throw New InvalidArgumentException("Overlap proxy needs at least one point")
End If
Var stats As New TreeStats
Var aabb As AABB = AABB.Make(proxy.Points, proxy.Count, proxy.Radius)
Me.mOverlapContext.Owner = Me
Me.mOverlapContext.Filter = filter
Me.mOverlapContext.UserCallback = callback
Me.mOverlapContext.Hits = hits
Me.mOverlapContext.QueryProxy = proxy
For i As Integer = 0 To 2
Me.BroadPhase.Trees[i].QueryTo(aabb, filter.MaskBits, Me.mOverlapContext, stats)
Next i
Return stats
End Function

## Casts a ray through every tree and reports hits to the callback, ported
## from b2World_CastRay. Returns the traversal stats.
Function CastRay(origin As Vector2, translation As Vector2, filter As QueryFilter, callback As WorldCastCallback) As TreeStats
Return Me.CastRayInto(origin, translation, filter, Nothing, callback)
End Function

## Casts a ray through every tree and appends every hit to the caller-owned
## hit list, ported from b2World_CastRay with a collecting callback.
Function CastRayInto(origin As Vector2, translation As Vector2, filter As QueryFilter, hits As ShapeHitList) As TreeStats
Return Me.CastRayInto(origin, translation, filter, hits, Nothing)
End Function

## Shared ray cast implementation. Exactly one of hits and callback is
## Nothing. The running fraction clips subsequent tree queries exactly like
## upstream.
Private Function CastRayInto(origin As Vector2, translation As Vector2, filter As QueryFilter, hits As ShapeHitList, callback As WorldCastCallback) As TreeStats
Me.CheckNotLocked()
If hits <> Nothing Then
hits.Clear()
End If
Me.CheckDefinition(filter, "QueryFilter")
If Not origin.X.IsFinite() Or Not origin.Y.IsFinite() Then
Throw New InvalidArgumentException("Ray origin must be finite")
End If
If Not translation.X.IsFinite() Or Not translation.Y.IsFinite() Then
Throw New InvalidArgumentException("Ray translation must be finite")
End If
Var stats As New TreeStats
Me.mRayCastContext.Owner = Me
Me.mRayCastContext.Filter = filter
Me.mRayCastContext.UserCallback = callback
Me.mRayCastContext.Hits = hits
Me.mRayCastContext.ClosestHit = Nothing
Me.mRayCastContext.Fraction = 1.0
Var input As New RayCastInput
input.Origin = New Vector2(origin.X, origin.Y)
input.Translation = New Vector2(translation.X, translation.Y)
input.MaxFraction = 1.0
For i As Integer = 0 To 2
Me.BroadPhase.Trees[i].RayCastTo(input, filter.MaskBits, Me.mRayCastContext, stats)
If Me.mRayCastContext.Fraction = 0.0 Then
Return stats
End If
input.MaxFraction = Me.mRayCastContext.Fraction
Next i
Return stats
End Function

## Casts a ray and returns the first hit, ported from b2World_CastRayClosest.
## The result is a fresh record with Shape Nothing when nothing was hit.
Function CastRayClosest(origin As Vector2, translation As Vector2, filter As QueryFilter) As ShapeHit
Var hit As New ShapeHit
Me.CastRayClosestTo(origin, translation, filter, hit)
Return hit
End Function

## Casts a ray into the caller-owned hit record and returns it, ported from
## b2World_CastRayClosest. The reused-record form for warm loops.
Function CastRayClosestTo(origin As Vector2, translation As Vector2, filter As QueryFilter, hit As ShapeHit) As ShapeHit
Me.CheckNotLocked()
Me.CheckDefinition(filter, "QueryFilter")
If Not origin.X.IsFinite() Or Not origin.Y.IsFinite() Then
Throw New InvalidArgumentException("Ray origin must be finite")
End If
If Not translation.X.IsFinite() Or Not translation.Y.IsFinite() Then
Throw New InvalidArgumentException("Ray translation must be finite")
End If
Me.mRayCastContext.Owner = Me
Me.mRayCastContext.Filter = filter
Me.mRayCastContext.UserCallback = Nothing
Me.mRayCastContext.Hits = Nothing
Me.mRayCastContext.ClosestHit = hit
Me.mRayCastContext.Fraction = 1.0
hit.Shape = Nothing
hit.Point.Set(0.0, 0.0)
hit.Normal.Set(0.0, 0.0)
hit.Fraction = 1.0
Var stats As New TreeStats
Var input As New RayCastInput
input.Origin = New Vector2(origin.X, origin.Y)
input.Translation = New Vector2(translation.X, translation.Y)
input.MaxFraction = 1.0
For i As Integer = 0 To 2
Me.BroadPhase.Trees[i].RayCastTo(input, filter.MaskBits, Me.mRayCastContext, stats)
If Me.mRayCastContext.Fraction = 0.0 Then
Return hit
End If
input.MaxFraction = Me.mRayCastContext.Fraction
Next i
Return hit
End Function

## Casts a shape through every tree and reports hits to the callback,
## ported from b2World_CastShape.
Function CastShape(proxy As ShapeProxy, translation As Vector2, filter As QueryFilter, callback As WorldCastCallback) As TreeStats
Return Me.CastShapeInto(proxy, translation, filter, Nothing, callback)
End Function

## Casts a shape through every tree and appends every hit to the
## caller-owned hit list, ported from b2World_CastShape with a collecting
## callback.
Function CastShapeInto(proxy As ShapeProxy, translation As Vector2, filter As QueryFilter, hits As ShapeHitList) As TreeStats
Return Me.CastShapeInto(proxy, translation, filter, hits, Nothing)
End Function

## Shared shape cast implementation. Exactly one of hits and callback is
## Nothing.
Private Function CastShapeInto(proxy As ShapeProxy, translation As Vector2, filter As QueryFilter, hits As ShapeHitList, callback As WorldCastCallback) As TreeStats
Me.CheckNotLocked()
If hits <> Nothing Then
hits.Clear()
End If
Me.CheckDefinition(filter, "QueryFilter")
Me.CheckDefinition(proxy, "ShapeProxy")
If proxy.Count < 1 Then
Throw New InvalidArgumentException("Cast proxy needs at least one point")
End If
If Not translation.X.IsFinite() Or Not translation.Y.IsFinite() Then
Throw New InvalidArgumentException("Cast translation must be finite")
End If
Var stats As New TreeStats
Me.mShapeCastContext.Owner = Me
Me.mShapeCastContext.Filter = filter
Me.mShapeCastContext.UserCallback = callback
Me.mShapeCastContext.Hits = hits
Me.mShapeCastContext.Fraction = 1.0
Var input As New ShapeCastInput
input.Proxy = proxy
input.Translation = New Vector2(translation.X, translation.Y)
input.MaxFraction = 1.0
For i As Integer = 0 To 2
Me.BroadPhase.Trees[i].ShapeCastTo(input, filter.MaskBits, Me.mShapeCastContext, stats)
If Me.mShapeCastContext.Fraction = 0.0 Then
Return stats
End If
input.MaxFraction = Me.mShapeCastContext.Fraction
Next i
Return stats
End Function

# ------------------------------------------------------------------
# World lifecycle
# ------------------------------------------------------------------

## Number of bodies in the awake solver set, ported from
## b2World_GetAwakeBodyCount.
Function AwakeBodyCount() As Integer
Return Me.SolverSets[2].Sims.Count()
End Function

## Validates internal invariants: pool accounting, sparse store identity,
## and set membership. Called by tests and after destructive operations.
Sub Validate()
Me.BodyIdPool.Validate()
Me.ShapeIdPool.Validate()
Me.ChainIdPool.Validate()
Me.ContactIdPool.Validate()
Me.BroadPhase.Validate()
Var bodyCount As Integer = 0
For i As Integer = 0 To Me.Bodies.Count - 1
Var body As Body = Me.Bodies[i]
If body <> Nothing Then
bodyCount = bodyCount + 1
If Not body.Live Then
Throw New RuntimeException("World body store holds a dead body")
End If
If body.Id <> i Then
Throw New RuntimeException("World body slot does not match body id")
End If
End If
Next i
If bodyCount <> Me.BodyIdPool.IdCount() Then
Throw New RuntimeException("World live body count does not match pool")
End If
Var shapeCount As Integer = 0
For j As Integer = 0 To Me.Shapes.Count - 1
Var shape As Shape = Me.Shapes[j]
If shape <> Nothing Then
shapeCount = shapeCount + 1
If Not shape.Live Or shape.Id <> j Then
Throw New RuntimeException("World shape store holds a stale shape")
End If
End If
Next j
If shapeCount <> Me.ShapeIdPool.IdCount() Then
Throw New RuntimeException("World live shape count does not match pool")
End If
Me.ValidateContacts()
Me.ValidateIslands()
Me.ValidateJoints()
End Sub

## Validates contact bookkeeping, ported from the contact checks of
## b2ValidateSolverSets.
Private Sub ValidateContacts()
If Me.ContactCount <> Me.ContactIdPool.IdCount() Then
Throw New RuntimeException("World live contact count does not match pool")
End If
For c As Integer = 0 To Me.Contacts.Count - 1
Var contact As Contact = Me.Contacts[c]
If contact <> Nothing And contact.ContactId <> PhysicsConstants.NULL_INDEX Then
If contact.ContactId <> c Then
Throw New RuntimeException("World contact slot does not match contact id")
End If
If contact.SetIndex <> PhysicsConstants.NULL_INDEX Then
Me.ValidateContactLocation(contact, c)
End If
End If
Next c
Var contactTotal As Integer = 0
For s As Integer = 0 To Me.SolverSets.Count - 1
Var contactSet As SolverSet = Me.SolverSets[s]
If contactSet <> Nothing Then
contactTotal = contactTotal + contactSet.ContactSims.Count()
End If
Next s
For g As Integer = 0 To PhysicsConstants.GRAPH_COLOUR_COUNT - 1
contactTotal = contactTotal + Me.ConstraintGraph.Colors[g].ContactSims.Count()
Next g
If contactTotal <> Me.ContactCount Then
Throw New RuntimeException("Solver set contact sims do not match contact count")
End If
If Me.BroadPhase.PairSet.Count <> Me.ContactCount Then
Throw New RuntimeException("Pair set keys do not match contact count")
End If
End Sub

## Validates joint bookkeeping across the world, ported from the joint
## checks of b2ValidateSolverSets. Checks live counts, slot identity, sim
## locations, body edge lists, and per-set totals.
Private Sub ValidateJoints()
If Me.JointIdPool.IdCount() <> Me.Joints.Count - CountNothing(Me.Joints) Then
Throw New RuntimeException("World live joint count does not match pool")
End If
For j As Integer = 0 To Me.Joints.Count - 1
Var joint As Joint = Me.Joints[j]
If joint <> Nothing Then
If Not joint.Live Or joint.Id <> j Then
Throw New RuntimeException("World joint store holds a stale joint")
End If
Me.ValidateJointLocation(joint, j)
Me.ValidateJointBodyEdges(joint)
End If
Next j
Var jointTotal As Integer = 0
For s As Integer = 0 To Me.SolverSets.Count - 1
Var jointSetTotal As SolverSet = Me.SolverSets[s]
If jointSetTotal <> Nothing Then
jointTotal = jointTotal + jointSetTotal.JointSims.Count()
End If
Next s
For g As Integer = 0 To PhysicsConstants.GRAPH_COLOUR_COUNT - 1
jointTotal = jointTotal + Me.ConstraintGraph.Colors[g].JointSims.Count()
Next g
If jointTotal <> Me.JointIdPool.IdCount() Then
Throw New RuntimeException("Solver set joint sims do not match joint count")
End If
End Sub

## Walks one joint's two body edge lists and confirms both reference the
## joint symmetrically.
Private Sub ValidateJointBodyEdges(joint As Joint)
Var edgeIndex As Integer = 0
While edgeIndex <= 1
Var bodyId As Integer = joint.Edge0BodyId
If edgeIndex = 1 Then
bodyId = joint.Edge1BodyId
End If
Var edgeBody As Body = Me.Bodies[bodyId]
If edgeBody = Nothing Then
Throw New RuntimeException("Joint edge references a missing body")
End If
Var edgeKey As Integer = joint.Id.ShiftLeft(1) + edgeIndex
Var walkKey As Integer = edgeBody.HeadJointKey
Var found As Boolean = False
While walkKey <> PhysicsConstants.NULL_INDEX
If walkKey = edgeKey Then
found = True
Exit While
End If
Var walkJoint As Joint = Me.Joints[walkKey.ShiftRight(1)]
If walkKey.BitAnd(1) = 0 Then
walkKey = walkJoint.Edge0NextKey
Else
walkKey = walkJoint.Edge1NextKey
End If
Wend
If found = False Then
Throw New RuntimeException("Joint edge missing from body joint list")
End If
edgeIndex = edgeIndex + 1
Wend
End Sub

## Counts the Nothing slots of a sparse record array.
Private Function CountNothing(records As Array(Of Joint)) As Integer
Var emptyCount As Integer = 0
For i As Integer = 0 To records.Count - 1
If records[i] = Nothing Then
emptyCount = emptyCount + 1
End If
Next i
Return emptyCount
End Function

## Checks that one live joint's sim record sits where the joint record
## claims, ported from the joint checks of b2ValidateSolverSets.
Private Sub ValidateJointLocation(joint As Joint, jointId As Integer)
If joint.SetIndex = PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Live joint has no solver set")
End If
If joint.SetIndex = PhysicsConstants.AWAKE_SET Then
If joint.ColorIndex = PhysicsConstants.NULL_INDEX Or joint.ColorIndex >= PhysicsConstants.GRAPH_COLOUR_COUNT Then
Throw New RuntimeException("Awake joint has no graph colour")
End If
Var colorSims As JointSims = Me.ConstraintGraph.Colors[joint.ColorIndex].JointSims
If colorSims.JointId.Items[joint.LocalIndex] <> jointId Then
Throw New RuntimeException("Colour sim and joint record disagree on location")
End If
Else
If joint.ColorIndex <> PhysicsConstants.NULL_INDEX Then
Throw New RuntimeException("Non-awake joint must not hold a graph colour")
End If
Var jointSet As SolverSet = Me.SolverSets[joint.SetIndex]
If jointSet.JointSims.JointId.Items[joint.LocalIndex] <> jointId Then
Throw New RuntimeException("Set sim and joint record disagree on location")
End If
End If
End Sub

## Checks that one live contact's sim record sits where the contact record
## claims, ported from the contact checks of b2ValidateSolverSets.
Private Sub ValidateContactLocation(contact As Contact, contactId As Integer)
If contact.ColorIndex <> PhysicsConstants.NULL_INDEX Then
If contact.SetIndex <> PhysicsConstants.AWAKE_SET Then
Throw New RuntimeException("Graph contacts live in the awake set")
End If
Var colorSims As ContactSims = Me.ConstraintGraph.Colors[contact.ColorIndex].ContactSims
If colorSims.ContactId.Items[contact.LocalIndex] <> contactId Then
Throw New RuntimeException("Colour sim and contact record disagree on location")
End If
Return
End If
Var contactSet As SolverSet = Me.SolverSets[contact.SetIndex]
If contactSet.ContactSims.ContactId.Items[contact.LocalIndex] <> contactId Then
Throw New RuntimeException("Contact sim and contact record disagree on location")
End If
End Sub

## Validates island bookkeeping across the world, ported from the island
## checks of b2ValidateSolverSets.
Private Sub ValidateIslands()
Var liveIslandCount As Integer = 0
For i As Integer = 0 To Me.Islands.Count - 1
Var island As Island = Me.Islands[i]
If island <> Nothing And island.IslandId <> PhysicsConstants.NULL_INDEX Then
liveIslandCount = liveIslandCount + 1
If island.IslandId <> i Then
Throw New RuntimeException("World island slot does not match island id")
End If
IslandMethods.ValidateIsland(Me, i)
End If
Next i
If liveIslandCount <> Me.IslandIdPool.IdCount() Then
Throw New RuntimeException("World live island count does not match pool")
End If
Var listedIslandCount As Integer = 0
For s As Integer = 0 To Me.SolverSets.Count - 1
Var solverSet As SolverSet = Me.SolverSets[s]
If solverSet <> Nothing Then
listedIslandCount = listedIslandCount + solverSet.IslandIds.Count
End If
Next s
If listedIslandCount <> liveIslandCount Then
Throw New RuntimeException("Solver set island lists do not match island count")
End If
End Sub

## Returns the world to a reusable empty state: every body, shape, and chain
## is destroyed, pools reset, and broad-phase storage cleared while
## retaining capacity, ported from the destruction cascade of
## b2DestroyWorld combined with the Physics2D capacity-reuse contract.
Sub Clear()
Me.CheckNotLocked()
For i As Integer = 0 To Me.Bodies.Count - 1
Var body As Body = Me.Bodies[i]
If body <> Nothing Then
Me.DestroyBody(body)
End If
Next i
For j As Integer = 0 To Me.Shapes.Count - 1
Var orphanShape As Shape = Me.Shapes[j]
If orphanShape <> Nothing Then
Throw New RuntimeException("World.Clear found an orphaned shape")
End If
Next j
For k As Integer = 0 To Me.Chains.Count - 1
Var orphanChain As Chain = Me.Chains[k]
If orphanChain <> Nothing Then
Throw New RuntimeException("World.Clear found an orphaned chain")
End If
Next k
For m As Integer = 0 To Me.Joints.Count - 1
Var orphanJoint As Joint = Me.Joints[m]
If orphanJoint <> Nothing Then
Throw New RuntimeException("World.Clear found an orphaned joint")
End If
Next m
Me.BodyIdPool.Clear()
Me.ShapeIdPool.Clear()
Me.ChainIdPool.Clear()
Me.SolverSetIdPool.Clear()
Me.JointIdPool.Clear()
Me.Contacts.Clear()
Me.ContactPool.Clear()
Me.Joints.Clear()
Me.JointGenerations.Clear()
Me.ContactIdPool.Clear()
Me.IslandIdPool.Clear()
Me.SplitIslandId = PhysicsConstants.NULL_INDEX
Me.BodyGenerations.Clear()
Me.ShapeGenerations.Clear()
Me.ChainGenerations.Clear()
Me.Sensors.Clear()
Me.ClearStepEventBuffers()
Me.EndEventWriteIndex = 0
Me.ReadableEndIndex = 1
Var bufferIndex As Integer = 0
While bufferIndex <= 1
Me.SensorEndSensorIds[bufferIndex].Clear()
Me.SensorEndSensorGens[bufferIndex].Clear()
Me.SensorEndVisitorIds[bufferIndex].Clear()
Me.SensorEndVisitorGens[bufferIndex].Clear()
Me.ContactEndShapeAIds[bufferIndex].Clear()
Me.ContactEndShapeAGens[bufferIndex].Clear()
Me.ContactEndShapeBIds[bufferIndex].Clear()
Me.ContactEndShapeBGens[bufferIndex].Clear()
bufferIndex = bufferIndex + 1
Wend
For s As Integer = 0 To 2
Me.SolverSets[s].ClearAll()
Next s
While Me.SolverSets.Count > 3
Me.SolverSets.RemoveAt(Me.SolverSets.Count - 1)
Wend
Me.mSolverSetPool.Clear()
Me.SplitBodyIdsScratch.Clear()
Me.SplitStackScratch.Clear()
Me.BroadPhase.Clear()
End Sub
End Class

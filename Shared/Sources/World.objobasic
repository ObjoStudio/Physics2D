Me.SensorBeginSensorIds = New IntegerList
Me.SensorBeginSensorGens = New IntegerList
Me.SensorBeginVisitorIds = New IntegerList
Me.SensorBeginVisitorGens = New IntegerList
Me.SensorEndSensorIds = New Array(Of IntegerList)
Me.SensorEndSensorGens = New Array(Of IntegerList)
Me.SensorEndVisitorIds = New Array(Of IntegerList)
Me.SensorEndVisitorGens = New Array(Of IntegerList)
Me.SensorEndSensorIds.Append(New IntegerList)
Me.SensorEndSensorGens.Append(New IntegerList)

## Creates a world with default settings, matching b2CreateWorld with
## b2DefaultWorldDef.
Constructor()
Me.InitCommon(New WorldSettings)
End Constructor

## Creates a world from explicit settings, matching b2CreateWorld with a
## definition.
Constructor(settings As WorldSettings)
Me.InitCommon(settings)
End Constructor

## Creates a world with a custom gravity and otherwise default settings.
## A shared factory rather than a second one-argument constructor because
## the virtual machine dispatches same-arity constructors by arity alone.
Shared Function WithGravity(gravityValue As Vector2) As World
Var settings As New WorldSettings
settings.Gravity = New Vector2(gravityValue.X, gravityValue.Y)
Return New World(settings)
End Function

## Shared constructor implementation, ported from b2CreateWorld.
Private Sub InitCommon(settings As WorldSettings)
Me.Gravity = New Vector2(settings.Gravity.X, settings.Gravity.Y)
Me.RestitutionThreshold = settings.RestitutionThreshold
Me.HitEventThreshold = settings.HitEventThreshold
Me.MaxContactPushSpeed = settings.MaxContactPushSpeed
Me.ContactHertz = settings.ContactHertz
Me.ContactDampingRatio = settings.ContactDampingRatio
Me.MaximumLinearSpeed = settings.MaximumLinearSpeed
Me.EnableSleeping = settings.EnableSleep
Me.ContinuousEnabled = settings.EnableContinuous
Me.WarmStartingEnabled = True
Me.SpeculativeEnabled = True
Me.Locked = False
Me.UserData = 0
Me.BroadPhase = New BroadPhase
Me.BodyIdPool = New IdPool
Me.ShapeIdPool = New IdPool
Me.ChainIdPool = New IdPool
Me.SolverSetIdPool = New IdPool
Me.JointIdPool = New IdPool
Me.Joints = New Array(Of Joint)
Me.JointCount = 0
Me.JointGenerations = New IntegerList
Me.InvH = 0.0
Me.BodyGenerations = New IntegerList
Me.ShapeGenerations = New IntegerList
Me.ChainGenerations = New IntegerList
Me.ContactIdPool = New IdPool
Me.Contacts = New Array(Of Contact)
Me.ContactPool = New Array(Of Contact)
Me.ContactCount = 0
Me.CustomFilter = Nothing
Me.PreSolve = Nothing
Me.MaterialMixer = Nothing
Me.IslandIdPool = New IdPool
Me.Islands = New Array(Of Island)
Me.SplitIslandId = PhysicsConstants.NULL_INDEX

Me.SplitStackScratch = New Array(Of Integer)
# Upstream allocates sets zero to two from the solver-set id pool at world
# creation so per-island sleeping sets start at three.
Me.SolverSets.Append(New SolverSet(Me.SolverSetIdPool.AllocId(), False))
Me.SolverSets.Append(New SolverSet(Me.SolverSetIdPool.AllocId(), False))
Me.SolverSets.Append(New SolverSet(Me.SolverSetIdPool.AllocId(), True))
Me.mOverlapContext = New WorldOverlapContext
Me.mRayCastContext = New WorldRayCastContext
Me.mShapeCastContext = New WorldShapeCastContext

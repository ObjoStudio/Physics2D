# Distance joint solver state, ported from upstream b2DistanceJoint in
# joint.h. The scalar working fields (impulses, anchors, effective mass)
# change every substep; the definition fields (length, spring, limits,
# motor) mirror the public tuning surface.
Class DistanceJointSim Inherits JointSim
## Rest length of the rope constraint.
Property Length As Double
## Spring stiffness in hertz. Zero means a rigid rope.
Property Hertz As Double
## Spring damping ratio.
Property DampingRatio As Double
## Lower clamp of the length range.
Property MinLength As Double
## Upper clamp of the length range.
Property MaxLength As Double
## Maximum motor force magnitude.
Property MaxMotorForce As Double
## Target relative speed along the rope axis.
Property MotorSpeed As Double
## Spring impulse accumulator.
Property Impulse As Double
## Lower limit impulse accumulator.
Property LowerImpulse As Double
## Upper limit impulse accumulator.
Property UpperImpulse As Double
## Motor impulse accumulator.
Property MotorImpulse As Double
## Awake-set state index of body A. NULL_INDEX for static bodies.
Property IndexA As Integer
## Awake-set state index of body B. NULL_INDEX for static bodies.
Property IndexB As Integer
## X component of the world-space anchor on body A at prepare time.
Property AnchorAX As Double
## Y component of the world-space anchor on body A at prepare time.
Property AnchorAY As Double
## X component of the world-space anchor on body B at prepare time.
Property AnchorBX As Double
## Y component of the world-space anchor on body B at prepare time.
Property AnchorBY As Double
## X component of the body-centre difference at prepare time.
Property DeltaCenterX As Double
## Y component of the body-centre difference at prepare time.
Property DeltaCenterY As Double
## Softness of the spring constraint.
Property DistanceSoftness As Softness
## Effective mass along the rope axis.
Property AxialMass As Double
## Enables the soft spring behaviour.
Property EnableSpring As Boolean
## Enables the length limits.
Property EnableLimit As Boolean
## Enables the motor.
Property EnableMotor As Boolean
End Class

# Character-mover plane geometry, ported from upstream mover.c. The plane
# solver relaxes a desired translation against collision planes; the
# vector clipper removes velocity into planes that registered push.
# The collide helpers port upstream b2CollideMoverAndCircle/Capsule/
# Polygon/Segment in geometry.c: GJK shape distance between the shape and
# the mover capsule with the shape radius excluded from the proxy, and a
# hit plane when the distance reaches the total radius.
Class Mover
## Collides a circle with a mover capsule in local space, ported from
## b2CollideMoverAndCircle.
Shared Function CollideCircle(shape As Circle, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Center]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 1, 0.0)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a capsule with a mover capsule in local space, ported from
## b2CollideMoverAndCapsule.
Shared Function CollideCapsule(shape As Capsule, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Center1, shape.Center2]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 2, 0.0)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a polygon with a mover capsule in local space, ported from
## b2CollideMoverAndPolygon.
Shared Function CollidePolygon(shape As Polygon, mover As Capsule) As PlaneResult
Var proxyA As ShapeProxy = ShapeProxy.Make(shape.Vertices, shape.Count, shape.Radius)
Return CollideProxy(proxyA, mover.Radius + shape.Radius, mover)
End Function

## Collides a segment with a mover capsule in local space, ported from
## b2CollideMoverAndSegment. The segment radius is excluded from the total
## radius exactly like upstream, keeping chain ghost behaviour.
Shared Function CollideSegment(shape As Segment, mover As Capsule) As PlaneResult
Var points() As Vector2 = [shape.Point1, shape.Point2]
Var proxyA As ShapeProxy = ShapeProxy.Make(points, 2, 0.0)
Return CollideProxy(proxyA, mover.Radius, mover)
End Function

## Shared collide body: shape distance between the shape proxy and the
## mover capsule (radii excluded from the distance query), then a hit
## plane when the distance reaches the total radius.
Private Shared Function CollideProxy(proxyA As ShapeProxy, totalRadius As Double, mover As Capsule) As PlaneResult
Var input As New DistanceInput
input.ProxyA = proxyA
Var moverPoints() As Vector2 = [mover.Center1, mover.Center2]
input.ProxyB = ShapeProxy.Make(moverPoints, 2, mover.Radius)
input.TransformA = New Transform(New Vector2(0.0, 0.0), New Rot(1.0, 0.0))
input.TransformB = New Transform(New Vector2(0.0, 0.0), New Rot(1.0, 0.0))
input.UseRadii = False
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)
If output.Distance <= totalRadius Then
Var result As New PlaneResult
result.Plane = New Plane(output.Normal.X, output.Normal.Y, totalRadius - output.Distance)
result.Point = New Vector2(output.PointA.X, output.PointA.Y)
result.Hit = True
Return result
End If
Return New PlaneResult
End Function

## Solves the position of a mover that satisfies the given collision
## planes into a new result. The planes' Push values are updated in place,
## matching upstream b2SolvePlanes.
Shared Function SolvePlanes(targetDelta As Vector2, planes() As CollisionPlane, count As Integer) As PlaneSolverResult
Var out As New PlaneSolverResult
Mover.SolvePlanesTo(targetDelta, planes, count, out)
Return out
End Function

## Solves the position of a mover that satisfies the given collision
## planes into the caller-owned out result and returns out.
Shared Function SolvePlanesTo(targetDelta As Vector2, planes() As CollisionPlane, count As Integer, out As PlaneSolverResult) As PlaneSolverResult
For i As Integer = 0 To count - 1
planes[i].Push = 0.0
Next i

Var deltaX As Double = targetDelta.X
Var deltaY As Double = targetDelta.Y
Var tolerance As Double = PhysicsConstants.LINEAR_SLOP

Var iteration As Integer = 0
Var converged As Boolean = False
While iteration < 20 And converged = False
Var totalPush As Double = 0.0
For planeIndex As Integer = 0 To count - 1
Var plane As CollisionPlane = planes[planeIndex]

# Add slop to prevent jitter. The separation is evaluated against the
# running delta, matching b2PlaneSeparation(plane, delta).
Var separation As Double = plane.Plane.Normal.X * deltaX + plane.Plane.Normal.Y * deltaY - plane.Plane.Offset + PhysicsConstants.LINEAR_SLOP
Var push As Double = -separation

# Clamp accumulated push.
Var accumulatedPush As Double = plane.Push
Var updated As Double = plane.Push + push
If updated < 0.0 Then
updated = 0.0
ElseIf updated > plane.PushLimit Then
updated = plane.PushLimit
End If
plane.Push = updated
push = updated - accumulatedPush
deltaX = deltaX + push * plane.Plane.Normal.X
deltaY = deltaY + push * plane.Plane.Normal.Y

# Track maximum push for convergence.
Var absPush As Double = push
If absPush < 0.0 Then
absPush = -absPush
End If
totalPush = totalPush + absPush
Next planeIndex

If totalPush < tolerance Then
converged = True
Else
iteration = iteration + 1
End If
Wend

out.Translation.Set(deltaX, deltaY)
out.IterationCount = iteration
Return out
End Function

## Clips the velocity against the given collision planes and returns the
## clipped vector. Planes with zero push or ClipVelocity set to false are
## skipped, ported from upstream b2ClipVector.
Shared Function ClipVector(vector As Vector2, planes() As CollisionPlane, count As Integer) As Vector2
Var vX As Double = vector.X
Var vY As Double = vector.Y

For planeIndex As Integer = 0 To count - 1
Var plane As CollisionPlane = planes[planeIndex]
If plane.Push = 0.0 Or plane.ClipVelocity = False Then
Continue
End If

Var dot As Double = vX * plane.Plane.Normal.X + vY * plane.Plane.Normal.Y
If dot < 0.0 Then
vX = vX - dot * plane.Plane.Normal.X
vY = vY - dot * plane.Plane.Normal.Y
End If
Next planeIndex

Return New Vector2(vX, vY)
End Function
End Class

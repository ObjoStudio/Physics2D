# Constraint-graph colour assignment and sim migration, ported from
# constraint_graph.c. Contact sims clone into a colour when they start
# touching and move back to the awake set's store when they stop. Joint sims
# live in a colour whenever their joint is awake.
Class GraphMethods
## Claims the first colour whose body set has room for both joint bodies,
## ported from b2AssignJointColor. Static bodies never occupy a colour, so
## a joint anchored to a static body claims a colour for the moving body
## only, and the search starts at colour 1 for that body exactly as for
## contacts.
Private Shared Function ChooseJointColor(graph As ConstraintGraph, bodyIdA As Integer, bodyIdB As Integer, staticA As Boolean, staticB As Boolean) As Integer
If staticA And staticB Then
Throw New RuntimeException("Static bodies cannot share a joint")
End If
Var colorIndex As Integer = PhysicsConstants.GRAPH_OVERFLOW_INDEX
If staticA = False And staticB = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False And colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdA)
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
ElseIf staticA = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False Then
colorSet.SetBitGrow(bodyIdA)
colorIndex = i
End If
i = i + 1
Wend
Else
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
End If
Return colorIndex
End Function

## Allocates a fresh joint sim of the given family. Families without their
## own solver state yet share the base record. Module classes cannot call
## Super.Constructor(), so the factory fills the softness records here and
## callers assign every remaining field.
Shared Function NewJointSimOfType(jointType As JointType) As JointSim
If jointType = JointType.DistanceJoint Then
Var distance As DistanceJointSim = New DistanceJointSim
distance.DistanceSoftness = New Softness
distance.ConstraintSoftness = New Softness
Return distance
End If
Var sim As JointSim = New JointSim
sim.ConstraintSoftness = New Softness
Return sim
End Function

## Assigns an awake joint to a colour and creates its sim row there, ported
## from b2CreateJointInGraph. Returns the fresh sim for the caller to fill.
Shared Function CreateJointInGraph(world As World, joint As Joint) As JointSim
Var graph As ConstraintGraph = world.ConstraintGraph
Var bodyIdA As Integer = joint.Edge0BodyId
Var bodyIdB As Integer = joint.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]
Var staticA As Boolean = bodyA.SetIndex = PhysicsConstants.STATIC_SET
Var staticB As Boolean = bodyB.SetIndex = PhysicsConstants.STATIC_SET

Var colorIndex As Integer = ChooseJointColor(graph, bodyIdA, bodyIdB, staticA, staticB)
Var color As GraphColor = graph.Colors[colorIndex]
Var sim As JointSim = GraphMethods.NewJointSimOfType(joint.Type)
joint.ColorIndex = colorIndex
joint.LocalIndex = color.JointSims.Add(sim)
Return sim
End Function

## Moves a joint sim into its colour, ported from b2AddJointToGraph. Used
## when a sleeping joint wakes and joins the graph.
Shared Sub AddJointToGraph(world As World, jointSim As JointSim, joint As Joint)
Var movedSim As JointSim = GraphMethods.CreateJointInGraph(world, joint)
GraphMethods.CopyJointSim(movedSim, jointSim)
End Sub

## Copies every field of one joint sim into another, mirroring the memcpy
## of b2AddJointToGraph and b2TransferJoint. Family state is cloned through
## the downcast so the family subtype is preserved.
Shared Sub CopyJointSim(target As JointSim, source As JointSim)
target.JointId = source.JointId
target.BodyIdA = source.BodyIdA
target.BodyIdB = source.BodyIdB
target.Type = source.Type
target.LocalOriginAnchorAX = source.LocalOriginAnchorAX
target.LocalOriginAnchorAY = source.LocalOriginAnchorAY
target.LocalOriginAnchorBX = source.LocalOriginAnchorBX
target.LocalOriginAnchorBY = source.LocalOriginAnchorBY
target.InvMassA = source.InvMassA
target.InvIA = source.InvIA
target.InvMassB = source.InvMassB
target.InvIB = source.InvIB
target.ConstraintHertz = source.ConstraintHertz
target.ConstraintDampingRatio = source.ConstraintDampingRatio
target.ConstraintSoftness.BiasRate = source.ConstraintSoftness.BiasRate
target.ConstraintSoftness.MassScale = source.ConstraintSoftness.MassScale
target.ConstraintSoftness.ImpulseScale = source.ConstraintSoftness.ImpulseScale
If source.Type = JointType.DistanceJoint Then
Var sourceDistance As DistanceJointSim = DistanceJointSim(source)
Var targetDistance As DistanceJointSim = DistanceJointSim(target)
targetDistance.Length = sourceDistance.Length
targetDistance.Hertz = sourceDistance.Hertz
targetDistance.DampingRatio = sourceDistance.DampingRatio
targetDistance.MinLength = sourceDistance.MinLength
targetDistance.MaxLength = sourceDistance.MaxLength
targetDistance.MaxMotorForce = sourceDistance.MaxMotorForce
targetDistance.MotorSpeed = sourceDistance.MotorSpeed
targetDistance.Impulse = sourceDistance.Impulse
targetDistance.LowerImpulse = sourceDistance.LowerImpulse
targetDistance.UpperImpulse = sourceDistance.UpperImpulse
targetDistance.MotorImpulse = sourceDistance.MotorImpulse
targetDistance.IndexA = sourceDistance.IndexA
targetDistance.IndexB = sourceDistance.IndexB
targetDistance.AnchorAX = sourceDistance.AnchorAX
targetDistance.AnchorAY = sourceDistance.AnchorAY
targetDistance.AnchorBX = sourceDistance.AnchorBX
targetDistance.AnchorBY = sourceDistance.AnchorBY
targetDistance.DeltaCenterX = sourceDistance.DeltaCenterX
targetDistance.DeltaCenterY = sourceDistance.DeltaCenterY
targetDistance.DistanceSoftness.BiasRate = sourceDistance.DistanceSoftness.BiasRate
targetDistance.DistanceSoftness.MassScale = sourceDistance.DistanceSoftness.MassScale
targetDistance.DistanceSoftness.ImpulseScale = sourceDistance.DistanceSoftness.ImpulseScale
targetDistance.AxialMass = sourceDistance.AxialMass
targetDistance.EnableSpring = sourceDistance.EnableSpring
targetDistance.EnableLimit = sourceDistance.EnableLimit
targetDistance.EnableMotor = sourceDistance.EnableMotor
End If
End Sub

## Removes a joint's sim from its colour, ported from
## b2RemoveJointFromGraph.
Shared Sub RemoveJointFromGraph(world As World, bodyIdA As Integer, bodyIdB As Integer, colorIndex As Integer, localIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
If colorIndex <> PhysicsConstants.GRAPH_OVERFLOW_INDEX Then
# May clear a bit for a static body, but this has no effect.
color.BodySet.ClearBit(bodyIdA)
color.BodySet.ClearBit(bodyIdB)
End If
Var movedSim As JointSim = color.JointSims.RemoveSwap(localIndex)
If movedSim <> Nothing Then
world.Joints[movedSim.JointId].LocalIndex = localIndex
End If
End Sub
## Claims the first colour whose body set has room for the pair, ported
## from the colour search of b2AddContactToGraph. Static bodies never
## occupy colour 0. Marks the claimed body slots.
Private Shared Function ChooseContactColor(graph As ConstraintGraph, bodyIdA As Integer, bodyIdB As Integer, staticA As Boolean, staticB As Boolean) As Integer
If staticA And staticB Then
Throw New RuntimeException("Static bodies cannot share a contact")
End If
Var colorIndex As Integer = PhysicsConstants.GRAPH_OVERFLOW_INDEX
If staticA = False And staticB = False Then
Var i As Integer = 0
While i < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[i].BodySet
If colorSet.GetBit(bodyIdA) = False And colorSet.GetBit(bodyIdB) = False Then
colorSet.SetBitGrow(bodyIdA)
colorSet.SetBitGrow(bodyIdB)
colorIndex = i
End If
i = i + 1
Wend
Else
# Exactly one body is static; only the moving body claims a bit and the
# search starts at colour 1.
Var bodyId As Integer = bodyIdB
If staticA = False Then
bodyId = bodyIdA
End If
Var j As Integer = 1
While j < PhysicsConstants.GRAPH_OVERFLOW_INDEX And colorIndex = PhysicsConstants.GRAPH_OVERFLOW_INDEX
Var colorSet As BitSet = graph.Colors[j].BodySet
If colorSet.GetBit(bodyId) = False Then
colorSet.SetBitGrow(bodyId)
colorIndex = j
End If
j = j + 1
Wend
End If
Return colorIndex
End Function

## Assigns a touching contact to a colour and moves its sim row out of the
## awake set's store, ported from b2AddContactToGraph.
Shared Sub AddContactToGraph(world As World, contact As Contact)
Var graph As ConstraintGraph = world.ConstraintGraph
Var bodyIdA As Integer = contact.Edge0BodyId
Var bodyIdB As Integer = contact.Edge1BodyId
Var bodyA As Body = world.Bodies[bodyIdA]
Var bodyB As Body = world.Bodies[bodyIdB]
Var staticA As Boolean = bodyA.SetIndex = PhysicsConstants.STATIC_SET
Var staticB As Boolean = bodyB.SetIndex = PhysicsConstants.STATIC_SET

Var colorIndex As Integer = ChooseContactColor(graph, bodyIdA, bodyIdB, staticA, staticB)
Var color As GraphColor = graph.Colors[colorIndex]

# Move the sim row from the source store into the colour. Graph contacts
# always live in the awake set, which also covers waking contacts that
# arrive from a sleeping set.
Var sourceSet As SolverSet = world.SolverSets[contact.SetIndex]
Var sourceIndex As Integer = contact.LocalIndex
contact.ColorIndex = colorIndex
contact.SetIndex = PhysicsConstants.AWAKE_SET
contact.LocalIndex = color.ContactSims.Count()
color.ContactSims.Add()
sourceSet.ContactSims.MoveRowTo(color.ContactSims, contact.LocalIndex, sourceIndex)
Var movedIndex As Integer = sourceSet.ContactSims.RemoveSwap(sourceIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = sourceSet.ContactSims.ContactId.Items[sourceIndex]
world.Contacts[movedContactId].LocalIndex = sourceIndex
End If

# Refresh mass terms against the owning body sims, ported from the tail of
# b2AddContactToGraph.
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
If staticA Then
color.ContactSims.BodySimIndexA.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
color.ContactSims.InvMassA.Items[contact.LocalIndex] = 0.0
color.ContactSims.InvIA.Items[contact.LocalIndex] = 0.0
Else
color.ContactSims.BodySimIndexA.Items[contact.LocalIndex] = bodyA.LocalIndex
color.ContactSims.InvMassA.Items[contact.LocalIndex] = awakeSet.Sims.InvMass.Items[bodyA.LocalIndex]
color.ContactSims.InvIA.Items[contact.LocalIndex] = awakeSet.Sims.InvInertia.Items[bodyA.LocalIndex]
End If
If staticB Then
color.ContactSims.BodySimIndexB.Items[contact.LocalIndex] = PhysicsConstants.NULL_INDEX
color.ContactSims.InvMassB.Items[contact.LocalIndex] = 0.0
color.ContactSims.InvIB.Items[contact.LocalIndex] = 0.0
Else
color.ContactSims.BodySimIndexB.Items[contact.LocalIndex] = bodyB.LocalIndex
color.ContactSims.InvMassB.Items[contact.LocalIndex] = awakeSet.Sims.InvMass.Items[bodyB.LocalIndex]
color.ContactSims.InvIB.Items[contact.LocalIndex] = awakeSet.Sims.InvInertia.Items[bodyB.LocalIndex]
End If
End Sub

## Removes a touching contact's sim from its colour, ported from
## b2RemoveContactFromGraph. Called when the contact stops touching.
Shared Sub RemoveContactFromGraph(world As World, colorIndex As Integer, localIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var movedIndex As Integer = color.ContactSims.RemoveSwap(localIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = color.ContactSims.ContactId.Items[localIndex]
world.Contacts[movedContactId].LocalIndex = localIndex
End If
End Sub

## Moves a touching contact's sim from its colour back into the awake set's
## store, ported from b2AddNonTouchingContact.
Shared Sub MoveContactOutOfGraph(world As World, contact As Contact)
If contact.SetIndex <> PhysicsConstants.AWAKE_SET Then
Throw New RuntimeException("Graph contacts live in the awake set")
End If
Var color As GraphColor = world.ConstraintGraph.Colors[contact.ColorIndex]
Var sourceIndex As Integer = contact.LocalIndex
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
contact.ColorIndex = PhysicsConstants.NULL_INDEX
contact.LocalIndex = awakeSet.ContactSims.Count()
awakeSet.ContactSims.Add()
color.ContactSims.MoveRowTo(awakeSet.ContactSims, contact.LocalIndex, sourceIndex)
Var movedIndex As Integer = color.ContactSims.RemoveSwap(sourceIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = color.ContactSims.ContactId.Items[sourceIndex]
world.Contacts[movedContactId].LocalIndex = sourceIndex
End If
End Sub

## Removes a non-touching contact sim from its owning set's store, ported
## from b2RemoveNonTouchingContact.
Shared Sub RemoveNonTouchingContact(world As World, contact As Contact)
Var contactSet As SolverSet = world.SolverSets[contact.SetIndex]
Var localIndex As Integer = contact.LocalIndex
Var movedIndex As Integer = contactSet.ContactSims.RemoveSwap(localIndex)
If movedIndex <> PhysicsConstants.NULL_INDEX Then
Var movedContactId As Integer = contactSet.ContactSims.ContactId.Items[localIndex]
world.Contacts[movedContactId].LocalIndex = localIndex
End If
End Sub
End Class

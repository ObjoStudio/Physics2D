Me.Owner.GetJointSims(Me).WeldLinearDampingRatio.Items[Me.LocalIndex] = dampingRatio
End Sub

## Linear damping ratio, ported from b2WeldJoint_GetLinearDampingRatio.
Function GetLinearDampingRatio() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldLinearDampingRatio.Items[Me.LocalIndex]
End Function


## The constrained reference angle in radians, ported from
## b2Joint_GetReferenceAngle for the weld family.
Override Function GetReferenceAngle() As Double
Me.CheckValid()
Return Me.Owner.GetJointSims(Me).WeldReferenceAngle.Items[Me.LocalIndex]
End Function
End Class

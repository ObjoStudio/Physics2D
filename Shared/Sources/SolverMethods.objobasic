# Constraint-solve pipeline loops, ported from the stage bodies of
# solver.c. The task/block/SIMD machinery collapses to sequential loops
# over the graph colours; the overflow colour runs first to match
# upstream's serial overflow work.
Class SolverMethods
## Prepares one colour's joint constraints, ported from b2PrepareJointsTask
## and b2PrepareOverflowJoints. Prepares every row; the family dispatch
## happens inside the kernel.
Shared Sub PrepareColourJoints(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
JointSolver.PrepareJoint(sims, i, context)
Next i
End Sub

## Warm starts one colour's joint constraints, ported from
## b2WarmStartJointsTask and b2WarmStartOverflowJoints.
Shared Sub WarmStartColourJoints(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
If sims.Type.Items[i] = Integer(JointType.DistanceJoint) Then
JointSolver.WarmStartDistanceJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MouseJoint) Then
JointSolver.WarmStartMouseJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MotorJoint) Then
JointSolver.WarmStartMotorJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.RevoluteJoint) Then
JointSolver.WarmStartRevoluteJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.PrismaticJoint) Then
JointSolver.WarmStartPrismaticJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.WeldJoint) Then
JointSolver.WarmStartWeldJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.WheelJoint) Then
JointSolver.WarmStartWheelJoint(sims, i, context)
End If
Next i
End Sub

## Runs one velocity iteration over one colour's joint constraints, ported
## from b2SolveJointsTask and b2SolveOverflowJoints. useBias enables the
## soft-step bias term.
Shared Sub SolveColourJoints(world As World, context As StepContext, colorIndex As Integer, useBias As Boolean)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var sims As JointSims = color.JointSims
Var count As Integer = sims.Count()
For i As Integer = 0 To count - 1
If sims.Type.Items[i] = Integer(JointType.DistanceJoint) Then
JointSolver.SolveDistanceJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.MouseJoint) Then
JointSolver.SolveMouseJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.MotorJoint) Then
JointSolver.SolveMotorJoint(sims, i, context)
ElseIf sims.Type.Items[i] = Integer(JointType.RevoluteJoint) Then
JointSolver.SolveRevoluteJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.PrismaticJoint) Then
JointSolver.SolvePrismaticJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.WeldJoint) Then
JointSolver.SolveWeldJoint(sims, i, context, useBias)
ElseIf sims.Type.Items[i] = Integer(JointType.WheelJoint) Then
JointSolver.SolveWheelJoint(sims, i, context, useBias)
End If
Next i
End Sub

## Prepares one colour's contact constraints, growing the colour's scratch
## constraint array to cover its sims, ported from b2PrepareContactsTask.
Shared Sub PrepareColorContacts(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var count As Integer = color.ContactSims.Count()
Var constraints As Array(Of ContactConstraint) = color.Constraints
# Amortised fill growth: the constraint records form a per-colour pool
# whose fill level is the historical high-water mark of this colour's
# active contacts. Growing the fill by exactly `count` made resting
# contact churn allocate one record every time the wake transient inched
# past the previous mark; doubling the fill on growth keeps sub-doubling
# transients allocation-free.
If constraints.Count < count Then
Var grownFill As Integer = constraints.Count * 2
If grownFill < count Then
grownFill = count
End If
While constraints.Count < grownFill
constraints.Append(New ContactConstraint)
Wend
End If
color.ConstraintCount = count
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To count - 1
ContactSolver.PrepareContact(constraints[i], states, color.ContactSims, i, context.ContactSoftness, context.StaticSoftness, context.WarmStartScale)
Next i
End Sub

## Applies stored impulses to the body states for one colour, ported from
## b2WarmStartContactsTask.
Shared Sub WarmStartColorContacts(world As World, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.WarmStartContact(states, constraints[i])
Next i
End Sub

## Runs one velocity iteration over one colour, ported from
## b2SolveContactsTask. useBias enables the soft-step bias term.
Shared Sub SolveColorContacts(world As World, context As StepContext, colorIndex As Integer, useBias As Boolean)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.SolveContact(states, constraints[i], context.InvH, -context.ContactSpeed, useBias)
Next i
End Sub

## Applies restitution over one colour, ported from b2ApplyRestitutionTask.
Shared Sub ApplyColorRestitution(world As World, context As StepContext, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.ApplyContactRestitution(states, constraints[i], context.RestitutionThreshold)
Next i
End Sub

## Copies accumulated impulses back into each colour's manifolds, ported
## from b2StoreImpulsesTask.
Shared Sub StoreColorImpulses(world As World, colorIndex As Integer)
Var color As GraphColor = world.ConstraintGraph.Colors[colorIndex]
Var constraints As Array(Of ContactConstraint) = color.Constraints
For i As Integer = 0 To color.ConstraintCount - 1
ContactSolver.StoreImpulses(constraints[i], color.ContactSims.GetManifold(i))
Next i
End Sub

## Integrates gravity, forces, and damping into the awake body states,
## ported from b2IntegrateVelocitiesTask.
Shared Sub IntegrateVelocities(world As World, context As StepContext)
Var awakeSet As SolverSet = world.SolverSets[PhysicsConstants.AWAKE_SET]
Var sims As BodySims = awakeSet.Sims
Var states As BodyStates = awakeSet.States
Var count As Integer = sims.Count()
Var h As Double = context.H
Var gravityX As Double = world.Gravity.X
Var gravityY As Double = world.Gravity.Y
Var maxLinearSpeed As Double = context.MaximumLinearVelocity
Var maxAngularSpeed As Double = PhysicsConstants.MAX_ROTATION * context.InvDt
Var maxLinearSpeedSquared As Double = maxLinearSpeed * maxLinearSpeed
Var maxAngularSpeedSquared As Double = maxAngularSpeed * maxAngularSpeed

# Dense-list references are hoisted out of the body loop; each chained
# access through the record costs property gets in the VM.
Var lvx As DoubleList = states.LVX
Var lvy As DoubleList = states.LVY
Var angularVelocity As DoubleList = states.AngularVelocity
Var linearDamping As DoubleList = sims.LinearDamping
Var angularDamping As DoubleList = sims.AngularDamping
Var invMass As DoubleList = sims.InvMass
Var invInertia As DoubleList = sims.InvInertia
Var gravityScale As DoubleList = sims.GravityScale
Var forceX As DoubleList = sims.ForceX
Var forceY As DoubleList = sims.ForceY
Var allowFastRotation As IntegerList = sims.AllowFastRotation
Var isSpeedCapped As IntegerList = sims.IsSpeedCapped

For i As Integer = 0 To count - 1
Var vX As Double = lvx.Items[i]
Var vY As Double = lvy.Items[i]
Var w As Double = angularVelocity.Items[i]

# Damping uses the Padé approximation of exponential decay.
Var linearDampingFactor As Double = 1.0 / (1.0 + h * linearDamping.Items[i])
Var angularDampingFactor As Double = 1.0 / (1.0 + h * angularDamping.Items[i])

# Gravity scale is zero for kinematic bodies via invMass.
Var bodyGravityScale As Double = 0.0
If invMass.Items[i] > 0.0 Then
bodyGravityScale = gravityScale.Items[i]
End If

Var linearDeltaX As Double = h * invMass.Items[i] * forceX.Items[i] + h * bodyGravityScale * gravityX
Var linearDeltaY As Double = h * invMass.Items[i] * forceY.Items[i] + h * bodyGravityScale * gravityY
Var angularDelta As Double = h * invInertia.Items[i] * sims.Torque.Items[i]

vX = linearDeltaX + linearDampingFactor * vX
vY = linearDeltaY + linearDampingFactor * vY
w = angularDelta + angularDampingFactor * w

If vX * vX + vY * vY > maxLinearSpeedSquared Then
Var ratio As Double = maxLinearSpeed / Maths.Sqrt(vX * vX + vY * vY)
vX = ratio * vX
vY = ratio * vY
isSpeedCapped.Items[i] = 1
End If

If w * w > maxAngularSpeedSquared And allowFastRotation.Items[i] = 0 Then
Var angularRatio As Double = maxAngularSpeed / Maths.Abs(w)
w = angularRatio * w
isSpeedCapped.Items[i] = 1
End If

lvx.Items[i] = vX
lvy.Items[i] = vY
angularVelocity.Items[i] = w
Next i
End Sub

## Integrates the body states forward one substep, ported from
## b2IntegratePositionsTask. Delta position and rotation accumulate until
## body finalization.
Shared Sub IntegratePositions(world As World, context As StepContext)
Var states As BodyStates = world.SolverSets[PhysicsConstants.AWAKE_SET].States
Var count As Integer = states.LVX.Count
Var h As Double = context.H
Var dpx As DoubleList = states.DPX
Var dpy As DoubleList = states.DPY
Var drc As DoubleList = states.DRC
Var drs As DoubleList = states.DRS
Var lvx As DoubleList = states.LVX
Var lvy As DoubleList = states.LVY
Var angularVelocity As DoubleList = states.AngularVelocity
For i As Integer = 0 To count - 1
Var deltaAngle As Double = h * angularVelocity.Items[i]
Var c As Double = drc.Items[i]
Var s As Double = drs.Items[i]
Var nc As Double = c - deltaAngle * s
Var ns As Double = s + deltaAngle * c
Var mag As Double = Maths.Sqrt(ns * ns + nc * nc)
Var invMag As Double = 0.0
If mag > 0.0 Then
invMag = 1.0 / mag
End If
drc.Items[i] = nc * invMag
drs.Items[i] = ns * invMag
dpx.Items[i] = dpx.Items[i] + h * lvx.Items[i]
dpy.Items[i] = dpy.Items[i] + h * lvy.Items[i]
Next i
End Sub
End Class

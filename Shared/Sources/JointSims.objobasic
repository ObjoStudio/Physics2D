target.MouseAngularSoftnessImpulseScale.Items[targetIndex] = Me.MouseAngularSoftnessImpulseScale.Items[sourceIndex]
target.MouseLinearMassXX.Items[targetIndex] = Me.MouseLinearMassXX.Items[sourceIndex]
target.MouseLinearMassXY.Items[targetIndex] = Me.MouseLinearMassXY.Items[sourceIndex]
target.MouseLinearMassYY.Items[targetIndex] = Me.MouseLinearMassYY.Items[sourceIndex]
target.MotorLinearOffsetX.Items[targetIndex] = Me.MotorLinearOffsetX.Items[sourceIndex]
target.MotorLinearOffsetY.Items[targetIndex] = Me.MotorLinearOffsetY.Items[sourceIndex]
target.MotorAngularOffset.Items[targetIndex] = Me.MotorAngularOffset.Items[sourceIndex]
target.MotorMaxForce.Items[targetIndex] = Me.MotorMaxForce.Items[sourceIndex]
target.MotorMaxTorque.Items[targetIndex] = Me.MotorMaxTorque.Items[sourceIndex]
target.MotorCorrectionFactor.Items[targetIndex] = Me.MotorCorrectionFactor.Items[sourceIndex]
target.MotorLinearImpulseX.Items[targetIndex] = Me.MotorLinearImpulseX.Items[sourceIndex]
target.MotorLinearImpulseY.Items[targetIndex] = Me.MotorLinearImpulseY.Items[sourceIndex]
target.MotorAngularImpulse.Items[targetIndex] = Me.MotorAngularImpulse.Items[sourceIndex]
target.MotorLinearMassXX.Items[targetIndex] = Me.MotorLinearMassXX.Items[sourceIndex]
target.MotorLinearMassXY.Items[targetIndex] = Me.MotorLinearMassXY.Items[sourceIndex]
target.MotorLinearMassYY.Items[targetIndex] = Me.MotorLinearMassYY.Items[sourceIndex]
target.MotorAngularMass.Items[targetIndex] = Me.MotorAngularMass.Items[sourceIndex]
target.MotorDeltaAngle.Items[targetIndex] = Me.MotorDeltaAngle.Items[sourceIndex]
End Sub

## Empties the store while retaining all capacity.
Sub ClearAll()
Me.JointId.Clear()
Me.BodyIdA.Clear()
Me.BodyIdB.Clear()
Me.Type.Clear()
Me.LocalOriginAnchorAX.Clear()
Me.LocalOriginAnchorAY.Clear()
Me.LocalOriginAnchorBX.Clear()
Me.LocalOriginAnchorBY.Clear()
Me.InvMassA.Clear()
Me.InvIA.Clear()
Me.InvMassB.Clear()
Me.InvIB.Clear()
Me.ConstraintHertz.Clear()
Me.ConstraintDampingRatio.Clear()
Me.SoftnessBiasRate.Clear()
Me.SoftnessMassScale.Clear()
Me.SoftnessImpulseScale.Clear()
Me.Length.Clear()
Me.Hertz.Clear()
Me.DampingRatio.Clear()
Me.MinLength.Clear()
Me.MaxLength.Clear()
Me.MaxMotorForce.Clear()
Me.MotorSpeed.Clear()
Me.Impulse.Clear()
Me.LowerImpulse.Clear()
Me.UpperImpulse.Clear()
Me.MotorImpulse.Clear()
Me.IndexA.Clear()
Me.IndexB.Clear()
Me.AnchorAX.Clear()
Me.AnchorAY.Clear()
Me.AnchorBX.Clear()
Me.AnchorBY.Clear()
Me.DeltaCenterX.Clear()
Me.DeltaCenterY.Clear()
Me.DistanceSoftnessBiasRate.Clear()
Me.DistanceSoftnessMassScale.Clear()
Me.DistanceSoftnessImpulseScale.Clear()
Me.AxialMass.Clear()
Me.EnableSpring.Clear()
Me.EnableLimit.Clear()
Me.EnableMotor.Clear()
Me.MouseTargetX.Clear()
Me.MouseTargetY.Clear()

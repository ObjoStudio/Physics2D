# Joint constraint solver, ported from the prepare/warm-start/solve bodies in
# joint.c and distance_joint.c. The dispatch collapses upstream's function
# tables into type checks on the store's Type column; the per-family maths is
# a direct scalar port in the ContactSolver idiom, reading and writing the
# JointSims columns of one row. The overflow colour runs its own entry points
# so the solve order matches upstream's serial overflow work.
Class JointSolver
## Prepares one joint row for the step, ported from b2PrepareJoint. Clamps
## the solver hertz against the substep rate before refreshing softness.
Shared Sub PrepareJoint(sims As JointSims, index As Integer, context As StepContext)
Var hertz As Double = sims.ConstraintHertz.Items[index]
If hertz > 0.25 * context.InvH Then
hertz = 0.25 * context.InvH
End If
Softness.MakeTo(hertz, sims.ConstraintDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.SoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.SoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.SoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale
If sims.Type.Items[index] = Integer(JointType.DistanceJoint) Then
PrepareDistanceJoint(sims, index, context)
End If
End Sub

## Prepares one distance joint row, ported from b2PrepareDistanceJoint.
Private Shared Sub PrepareDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Initial anchors in world space relative to the body centres.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY
sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]

Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var sepX As Double = sims.DeltaCenterX.Items[index] + rBX - rAX
Var sepY As Double = sims.DeltaCenterY.Items[index] + rBY - rAY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

# Compute effective mass.
Var crA As Double = rAX * axisY - rAY * axisX
Var crB As Double = rBX * axisY - rBY * axisX
Var k As Double = sims.InvMassA.Items[index] + sims.InvMassB.Items[index] + sims.InvIA.Items[index] * crA * crA + sims.InvIB.Items[index] * crB * crB
If k > 0.0 Then
sims.AxialMass.Items[index] = 1.0 / k
Else
sims.AxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.Hertz.Items[index], sims.DampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.DistanceSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.DistanceSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.DistanceSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.Impulse.Items[index] = 0.0
sims.LowerImpulse.Items[index] = 0.0
sims.UpperImpulse.Items[index] = 0.0
sims.MotorImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored impulses to the body states before iterating, ported from
## b2WarmStartDistanceJoint.
Shared Sub WarmStartDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]

Var dsX As Double = dpBX - dpAX + rBX - rAX
Var dsY As Double = dpBY - dpAY + rBY - rAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

Var axialImpulse As Double = sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]
Var pX As Double = axialImpulse * axisX
Var pY As Double = axialImpulse * axisY

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = states.LVX.Items[indexA] - mA * pX
states.LVY.Items[indexA] = states.LVY.Items[indexA] - mA * pY
states.AngularVelocity.Items[indexA] = states.AngularVelocity.Items[indexA] - iA * (rAX * pY - rAY * pX)
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = states.LVX.Items[indexB] + mB * pX
states.LVY.Items[indexB] = states.LVY.Items[indexB] + mB * pY
states.AngularVelocity.Items[indexB] = states.AngularVelocity.Items[indexB] + iB * (rBX * pY - rBY * pX)
End If
End Sub

## Runs one velocity iteration with optional soft-step bias, ported from
## b2SolveDistanceJoint.
Shared Sub SolveDistanceJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Current anchors and separation. The scratch record is reused across
# every joint solve within a step, ported from the C stack locals of
# b2SolveDistanceJoint. The axis is reset first: with coincident anchors
# the separation is degenerate, and a stale axis from a previously solved
# joint would apply impulses along a phantom direction.
Var scratch As DistanceJointScratch = context.JointScratch
scratch.RAX = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
scratch.RAY = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
scratch.RBX = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
scratch.RBY = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dsX As Double = dpBX - dpAX + scratch.RBX - scratch.RAX
Var dsY As Double = dpBY - dpAY + scratch.RBY - scratch.RAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
scratch.AxisX = 0.0
scratch.AxisY = 0.0
scratch.Length = Maths.Sqrt(sepX * sepX + sepY * sepY)
If scratch.Length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / scratch.Length
scratch.AxisX = invLength * sepX
scratch.AxisY = invLength * sepY
End If

Var vrX As Double = vBX - wB * scratch.RBY - (vAX - wA * scratch.RAY)
Var vrY As Double = vBY + wB * scratch.RBX - (vAY + wA * scratch.RAX)
Var vDotAxis As Double = vrX * scratch.AxisX + vrY * scratch.AxisY

If sims.EnableSpring.Items[index] = 1 And (sims.MinLength.Items[index] < sims.MaxLength.Items[index] Or sims.EnableLimit.Items[index] = 0) Then
# Soft constraint with spring, limits, and motor.
If sims.Hertz.Items[index] > 0.0 Then
Var C As Double = scratch.Length - sims.Length.Items[index]
Var bias As Double = sims.DistanceSoftnessBiasRate.Items[index] * C
Var m As Double = sims.DistanceSoftnessMassScale.Items[index] * sims.AxialMass.Items[index]
Var impulse As Double = -m * (vDotAxis + bias) - sims.DistanceSoftnessImpulseScale.Items[index] * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If sims.EnableLimit.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceLowerLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
SolveDistanceUpperLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If

If sims.EnableMotor.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceMotor(scratch, sims, index, context, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If
Else
# Rigid constraint.
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
bias = sims.SoftnessBiasRate.Items[index] * (scratch.Length - sims.Length.Items[index])
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

Var impulse As Double = -massScale * sims.AxialMass.Items[index] * (vDotAxis + bias) - impulseScale * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Solves the lower length limit of a soft distance joint, ported from the
## lower-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceLowerLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var lowerCdot As Double = vrX * scratch.AxisX + vrY * scratch.AxisY
Var lowerC As Double = scratch.Length - sims.MinLength.Items[index]
Var lowerBias As Double = 0.0
Var lowerMassCoeff As Double = 1.0
Var lowerImpulseCoeff As Double = 0.0
If lowerC > 0.0 Then
# Speculative.
lowerBias = lowerC * context.InvH
ElseIf useBias Then
lowerBias = sims.SoftnessBiasRate.Items[index] * lowerC
lowerMassCoeff = sims.SoftnessMassScale.Items[index]
lowerImpulseCoeff = sims.SoftnessImpulseScale.Items[index]
End If
Var lowerImpulse As Double = -lowerMassCoeff * sims.AxialMass.Items[index] * (lowerCdot + lowerBias) - lowerImpulseCoeff * sims.LowerImpulse.Items[index]
Var newLowerImpulse As Double = sims.LowerImpulse.Items[index] + lowerImpulse
If newLowerImpulse < 0.0 Then
newLowerImpulse = 0.0
End If
lowerImpulse = newLowerImpulse - sims.LowerImpulse.Items[index]
sims.LowerImpulse.Items[index] = newLowerImpulse

Var lowerPX As Double = lowerImpulse * scratch.AxisX
Var lowerPY As Double = lowerImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * lowerPX
scratch.VAY = scratch.VAY - mA * lowerPY
scratch.WA = scratch.WA - iA * (scratch.RAX * lowerPY - scratch.RAY * lowerPX)
scratch.VBX = scratch.VBX + mB * lowerPX
scratch.VBY = scratch.VBY + mB * lowerPY
scratch.WB = scratch.WB + iB * (scratch.RBX * lowerPY - scratch.RBY * lowerPX)
End Sub

## Solves the upper length limit of a soft distance joint, ported from the
## upper-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceUpperLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrUX As Double = scratch.VAX - scratch.WA * scratch.RAY - (scratch.VBX - scratch.WB * scratch.RBY)
Var vrUY As Double = scratch.VAY + scratch.WA * scratch.RAX - (scratch.VBY + scratch.WB * scratch.RBX)
Var upperCdot As Double = vrUX * scratch.AxisX + vrUY * scratch.AxisY
Var upperC As Double = sims.MaxLength.Items[index] - scratch.Length
Var upperBias As Double = 0.0
Var upperMassScale As Double = 1.0
Var upperImpulseScale As Double = 0.0
If upperC > 0.0 Then
# Speculative.
upperBias = upperC * context.InvH
ElseIf useBias Then
upperBias = sims.SoftnessBiasRate.Items[index] * upperC
upperMassScale = sims.SoftnessMassScale.Items[index]
upperImpulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var upperImpulse As Double = -upperMassScale * sims.AxialMass.Items[index] * (upperCdot + upperBias) - upperImpulseScale * sims.UpperImpulse.Items[index]
Var newUpperImpulse As Double = sims.UpperImpulse.Items[index] + upperImpulse
If newUpperImpulse < 0.0 Then
newUpperImpulse = 0.0
End If
upperImpulse = newUpperImpulse - sims.UpperImpulse.Items[index]
sims.UpperImpulse.Items[index] = newUpperImpulse

Var upperPX As Double = -upperImpulse * scratch.AxisX
Var upperPY As Double = -upperImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * upperPX
scratch.VAY = scratch.VAY - mA * upperPY
scratch.WA = scratch.WA - iA * (scratch.RAX * upperPY - scratch.RAY * upperPX)
scratch.VBX = scratch.VBX + mB * upperPX
scratch.VBY = scratch.VBY + mB * upperPY
scratch.WB = scratch.WB + iB * (scratch.RBX * upperPY - scratch.RBY * upperPX)
End Sub

## Solves the distance joint motor, ported from the motor block of
## b2SolveDistanceJoint.
Private Shared Sub SolveDistanceMotor(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrMX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrMY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var motorCdot As Double = vrMX * scratch.AxisX + vrMY * scratch.AxisY
Var motorImpulse As Double = sims.AxialMass.Items[index] * (sims.MotorSpeed.Items[index] - motorCdot)
Var oldMotorImpulse As Double = sims.MotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.MaxMotorForce.Items[index]
Var newMotorImpulse As Double = sims.MotorImpulse.Items[index] + motorImpulse
If newMotorImpulse > maxImpulse Then
newMotorImpulse = maxImpulse
ElseIf newMotorImpulse < -maxImpulse Then
newMotorImpulse = -maxImpulse
End If
sims.MotorImpulse.Items[index] = newMotorImpulse
motorImpulse = newMotorImpulse - oldMotorImpulse

Var motorPX As Double = motorImpulse * scratch.AxisX
Var motorPY As Double = motorImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * motorPX
scratch.VAY = scratch.VAY - mA * motorPY
scratch.WA = scratch.WA - iA * (scratch.RAX * motorPY - scratch.RAY * motorPX)
scratch.VBX = scratch.VBX + mB * motorPX
scratch.VBY = scratch.VBY + mB * motorPY
scratch.WB = scratch.WB + iB * (scratch.RBX * motorPY - scratch.RBY * motorPX)
End Sub

## Total force the distance joint row applied this step, ported from
## b2GetDistanceJointForce.
Shared Function GetDistanceJointForce(world As World, sims As JointSims, index As Integer) As Vector2
Var transformA As Transform = world.GetBodyTransformById(sims.BodyIdA.Items[index])
Var transformB As Transform = world.GetBodyTransformById(sims.BodyIdB.Items[index])
Var pA As Vector2 = Transform.TransformPoint(transformA, New Vector2(sims.LocalOriginAnchorAX.Items[index], sims.LocalOriginAnchorAY.Items[index]))
Var pB As Vector2 = Transform.TransformPoint(transformB, New Vector2(sims.LocalOriginAnchorBX.Items[index], sims.LocalOriginAnchorBY.Items[index]))
Var d As Vector2 = pB - pA
Var length As Double = d.Length()
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * d.X
axisY = invLength * d.Y
End If
Var force As Double = (sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]) * world.InvH
Return New Vector2(force * axisX, force * axisY)
End Function
End Class

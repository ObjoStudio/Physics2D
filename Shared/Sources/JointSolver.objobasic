# Joint constraint solver, ported from the prepare/warm-start/solve bodies in
# joint.c and distance_joint.c. The dispatch collapses upstream's function
# tables into type checks on the store's Type column; the per-family maths is
# a direct scalar port in the ContactSolver idiom, reading and writing the
# JointSims columns of one row. The overflow colour runs its own entry points
# so the solve order matches upstream's serial overflow work.
Class JointSolver
## Prepares one joint row for the step, ported from b2PrepareJoint. Clamps
## the solver hertz against the substep rate before refreshing softness.
Shared Sub PrepareJoint(sims As JointSims, index As Integer, context As StepContext)
Var hertz As Double = sims.ConstraintHertz.Items[index]
If hertz > 0.25 * context.InvH Then
hertz = 0.25 * context.InvH
End If
Softness.MakeTo(hertz, sims.ConstraintDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.SoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.SoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.SoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale
If sims.Type.Items[index] = Integer(JointType.DistanceJoint) Then
PrepareDistanceJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.MouseJoint) Then
PrepareMouseJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.MotorJoint) Then
PrepareMotorJoint(sims, index, context)
ElseIf sims.Type.Items[index] = Integer(JointType.RevoluteJoint) Then
PrepareRevoluteJoint(sims, index, context)
End If
End Sub

## Prepares one distance joint row, ported from b2PrepareDistanceJoint.
Private Shared Sub PrepareDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Initial anchors in world space relative to the body centres.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY
sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]

Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var sepX As Double = sims.DeltaCenterX.Items[index] + rBX - rAX
Var sepY As Double = sims.DeltaCenterY.Items[index] + rBY - rAY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

# Compute effective mass.
Var crA As Double = rAX * axisY - rAY * axisX
Var crB As Double = rBX * axisY - rBY * axisX
Var k As Double = sims.InvMassA.Items[index] + sims.InvMassB.Items[index] + sims.InvIA.Items[index] * crA * crA + sims.InvIB.Items[index] * crB * crB
If k > 0.0 Then
sims.AxialMass.Items[index] = 1.0 / k
Else
sims.AxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.Hertz.Items[index], sims.DampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.DistanceSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.DistanceSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.DistanceSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.Impulse.Items[index] = 0.0
sims.LowerImpulse.Items[index] = 0.0
sims.UpperImpulse.Items[index] = 0.0
sims.MotorImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored impulses to the body states before iterating, ported from
## b2WarmStartDistanceJoint.
Shared Sub WarmStartDistanceJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]

Var dsX As Double = dpBX - dpAX + rBX - rAX
Var dsY As Double = dpBY - dpAY + rBY - rAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
Var length As Double = Maths.Sqrt(sepX * sepX + sepY * sepY)
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * sepX
axisY = invLength * sepY
End If

Var axialImpulse As Double = sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]
Var pX As Double = axialImpulse * axisX
Var pY As Double = axialImpulse * axisY

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = states.LVX.Items[indexA] - mA * pX
states.LVY.Items[indexA] = states.LVY.Items[indexA] - mA * pY
states.AngularVelocity.Items[indexA] = states.AngularVelocity.Items[indexA] - iA * (rAX * pY - rAY * pX)
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = states.LVX.Items[indexB] + mB * pX
states.LVY.Items[indexB] = states.LVY.Items[indexB] + mB * pY
states.AngularVelocity.Items[indexB] = states.AngularVelocity.Items[indexB] + iB * (rBX * pY - rBY * pX)
End If
End Sub

## Runs one velocity iteration with optional soft-step bias, ported from
## b2SolveDistanceJoint.
Shared Sub SolveDistanceJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Current anchors and separation. The scratch record is reused across
# every joint solve within a step, ported from the C stack locals of
# b2SolveDistanceJoint. The axis is reset first: with coincident anchors
# the separation is degenerate, and a stale axis from a previously solved
# joint would apply impulses along a phantom direction.
Var scratch As DistanceJointScratch = context.JointScratch
scratch.RAX = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
scratch.RAY = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
scratch.RBX = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
scratch.RBY = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dsX As Double = dpBX - dpAX + scratch.RBX - scratch.RAX
Var dsY As Double = dpBY - dpAY + scratch.RBY - scratch.RAY
Var sepX As Double = sims.DeltaCenterX.Items[index] + dsX
Var sepY As Double = sims.DeltaCenterY.Items[index] + dsY
scratch.AxisX = 0.0
scratch.AxisY = 0.0
scratch.Length = Maths.Sqrt(sepX * sepX + sepY * sepY)
If scratch.Length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / scratch.Length
scratch.AxisX = invLength * sepX
scratch.AxisY = invLength * sepY
End If

Var vrX As Double = vBX - wB * scratch.RBY - (vAX - wA * scratch.RAY)
Var vrY As Double = vBY + wB * scratch.RBX - (vAY + wA * scratch.RAX)
Var vDotAxis As Double = vrX * scratch.AxisX + vrY * scratch.AxisY

If sims.EnableSpring.Items[index] = 1 And (sims.MinLength.Items[index] < sims.MaxLength.Items[index] Or sims.EnableLimit.Items[index] = 0) Then
# Soft constraint with spring, limits, and motor.
If sims.Hertz.Items[index] > 0.0 Then
Var C As Double = scratch.Length - sims.Length.Items[index]
Var bias As Double = sims.DistanceSoftnessBiasRate.Items[index] * C
Var m As Double = sims.DistanceSoftnessMassScale.Items[index] * sims.AxialMass.Items[index]
Var impulse As Double = -m * (vDotAxis + bias) - sims.DistanceSoftnessImpulseScale.Items[index] * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If sims.EnableLimit.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceLowerLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
SolveDistanceUpperLimit(scratch, sims, index, context, useBias, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If

If sims.EnableMotor.Items[index] = 1 Then
scratch.VAX = vAX
scratch.VAY = vAY
scratch.WA = wA
scratch.VBX = vBX
scratch.VBY = vBY
scratch.WB = wB
SolveDistanceMotor(scratch, sims, index, context, mA, mB, iA, iB)
vAX = scratch.VAX
vAY = scratch.VAY
wA = scratch.WA
vBX = scratch.VBX
vBY = scratch.VBY
wB = scratch.WB
End If
Else
# Rigid constraint.
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
bias = sims.SoftnessBiasRate.Items[index] * (scratch.Length - sims.Length.Items[index])
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

Var impulse As Double = -massScale * sims.AxialMass.Items[index] * (vDotAxis + bias) - impulseScale * sims.Impulse.Items[index]
sims.Impulse.Items[index] = sims.Impulse.Items[index] + impulse

Var pX As Double = impulse * scratch.AxisX
Var pY As Double = impulse * scratch.AxisY
vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (scratch.RAX * pY - scratch.RAY * pX)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (scratch.RBX * pY - scratch.RBY * pX)
End If

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Solves the lower length limit of a soft distance joint, ported from the
## lower-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceLowerLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var lowerCdot As Double = vrX * scratch.AxisX + vrY * scratch.AxisY
Var lowerC As Double = scratch.Length - sims.MinLength.Items[index]
Var lowerBias As Double = 0.0
Var lowerMassCoeff As Double = 1.0
Var lowerImpulseCoeff As Double = 0.0
If lowerC > 0.0 Then
# Speculative.
lowerBias = lowerC * context.InvH
ElseIf useBias Then
lowerBias = sims.SoftnessBiasRate.Items[index] * lowerC
lowerMassCoeff = sims.SoftnessMassScale.Items[index]
lowerImpulseCoeff = sims.SoftnessImpulseScale.Items[index]
End If
Var lowerImpulse As Double = -lowerMassCoeff * sims.AxialMass.Items[index] * (lowerCdot + lowerBias) - lowerImpulseCoeff * sims.LowerImpulse.Items[index]
Var newLowerImpulse As Double = sims.LowerImpulse.Items[index] + lowerImpulse
If newLowerImpulse < 0.0 Then
newLowerImpulse = 0.0
End If
lowerImpulse = newLowerImpulse - sims.LowerImpulse.Items[index]
sims.LowerImpulse.Items[index] = newLowerImpulse

Var lowerPX As Double = lowerImpulse * scratch.AxisX
Var lowerPY As Double = lowerImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * lowerPX
scratch.VAY = scratch.VAY - mA * lowerPY
scratch.WA = scratch.WA - iA * (scratch.RAX * lowerPY - scratch.RAY * lowerPX)
scratch.VBX = scratch.VBX + mB * lowerPX
scratch.VBY = scratch.VBY + mB * lowerPY
scratch.WB = scratch.WB + iB * (scratch.RBX * lowerPY - scratch.RBY * lowerPX)
End Sub

## Solves the upper length limit of a soft distance joint, ported from the
## upper-limit block of b2SolveDistanceJoint.
Private Shared Sub SolveDistanceUpperLimit(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, useBias As Boolean, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrUX As Double = scratch.VAX - scratch.WA * scratch.RAY - (scratch.VBX - scratch.WB * scratch.RBY)
Var vrUY As Double = scratch.VAY + scratch.WA * scratch.RAX - (scratch.VBY + scratch.WB * scratch.RBX)
Var upperCdot As Double = vrUX * scratch.AxisX + vrUY * scratch.AxisY
Var upperC As Double = sims.MaxLength.Items[index] - scratch.Length
Var upperBias As Double = 0.0
Var upperMassScale As Double = 1.0
Var upperImpulseScale As Double = 0.0
If upperC > 0.0 Then
# Speculative.
upperBias = upperC * context.InvH
ElseIf useBias Then
upperBias = sims.SoftnessBiasRate.Items[index] * upperC
upperMassScale = sims.SoftnessMassScale.Items[index]
upperImpulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var upperImpulse As Double = -upperMassScale * sims.AxialMass.Items[index] * (upperCdot + upperBias) - upperImpulseScale * sims.UpperImpulse.Items[index]
Var newUpperImpulse As Double = sims.UpperImpulse.Items[index] + upperImpulse
If newUpperImpulse < 0.0 Then
newUpperImpulse = 0.0
End If
upperImpulse = newUpperImpulse - sims.UpperImpulse.Items[index]
sims.UpperImpulse.Items[index] = newUpperImpulse

Var upperPX As Double = -upperImpulse * scratch.AxisX
Var upperPY As Double = -upperImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * upperPX
scratch.VAY = scratch.VAY - mA * upperPY
scratch.WA = scratch.WA - iA * (scratch.RAX * upperPY - scratch.RAY * upperPX)
scratch.VBX = scratch.VBX + mB * upperPX
scratch.VBY = scratch.VBY + mB * upperPY
scratch.WB = scratch.WB + iB * (scratch.RBX * upperPY - scratch.RBY * upperPX)
End Sub

## Solves the distance joint motor, ported from the motor block of
## b2SolveDistanceJoint.
Private Shared Sub SolveDistanceMotor(scratch As DistanceJointScratch, sims As JointSims, index As Integer, context As StepContext, mA As Double, mB As Double, iA As Double, iB As Double)
Var vrMX As Double = scratch.VBX - scratch.WB * scratch.RBY - (scratch.VAX - scratch.WA * scratch.RAY)
Var vrMY As Double = scratch.VBY + scratch.WB * scratch.RBX - (scratch.VAY + scratch.WA * scratch.RAX)
Var motorCdot As Double = vrMX * scratch.AxisX + vrMY * scratch.AxisY
Var motorImpulse As Double = sims.AxialMass.Items[index] * (sims.MotorSpeed.Items[index] - motorCdot)
Var oldMotorImpulse As Double = sims.MotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.MaxMotorForce.Items[index]
Var newMotorImpulse As Double = sims.MotorImpulse.Items[index] + motorImpulse
If newMotorImpulse > maxImpulse Then
newMotorImpulse = maxImpulse
ElseIf newMotorImpulse < -maxImpulse Then
newMotorImpulse = -maxImpulse
End If
sims.MotorImpulse.Items[index] = newMotorImpulse
motorImpulse = newMotorImpulse - oldMotorImpulse

Var motorPX As Double = motorImpulse * scratch.AxisX
Var motorPY As Double = motorImpulse * scratch.AxisY
scratch.VAX = scratch.VAX - mA * motorPX
scratch.VAY = scratch.VAY - mA * motorPY
scratch.WA = scratch.WA - iA * (scratch.RAX * motorPY - scratch.RAY * motorPX)
scratch.VBX = scratch.VBX + mB * motorPX
scratch.VBY = scratch.VBY + mB * motorPY
scratch.WB = scratch.WB + iB * (scratch.RBX * motorPY - scratch.RBY * motorPX)
End Sub

## Prepares one mouse joint row, ported from b2PrepareMouseJoint. Only body
## B matters: body A is assumed static and is never touched by the solver.
## The linear mass is the inverse of the symmetric 2x2 body-B constraint
## matrix, stored as three scalars because the matrix is symmetric by
## construction. Upstream asserts body B is awake; rows outside the graph
## are never prepared in this port, and a non-awake body B yields a
## NULL_INDEX state row that the warm-start and solve kernels skip.
Private Shared Sub PrepareMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

Var localDX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localDY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localDX - qsB * localDY
sims.AnchorBY.Items[index] = qsB * localDX + qcB * localDY

Softness.MakeTo(sims.MouseHertz.Items[index], sims.MouseDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.MouseLinearSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.MouseLinearSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.MouseLinearSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

# Upstream fixes the angular softness at 0.5 Hz with a 0.1 damping ratio
# to reduce the dragged body's spin without fighting user torque.
Softness.MakeTo(0.5, 0.1, context.H, context.SoftnessScratch)
sims.MouseAngularSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.MouseAngularSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.MouseAngularSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var k11 As Double = mB + iB * rBY * rBY
Var k12 As Double = -iB * rBX * rBY
Var k22 As Double = mB + iB * rBX * rBX
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
sims.MouseLinearMassXX.Items[index] = det * k22
sims.MouseLinearMassXY.Items[index] = -det * k12
sims.MouseLinearMassYY.Items[index] = det * k11
sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - sims.MouseTargetX.Items[index]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - sims.MouseTargetY.Items[index]

If context.WarmStartScale = 0.0 Then
sims.MouseLinearImpulseX.Items[index] = 0.0
sims.MouseLinearImpulseY.Items[index] = 0.0
sims.MouseAngularImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored mouse joint impulses to body B before iterating, ported
## from b2WarmStartMouseJoint.
Shared Sub WarmStartMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var indexB As Integer = sims.IndexB.Items[index]
If indexB = PhysicsConstants.NULL_INDEX Then
Return
End If
Var states As BodyStates = context.States
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var dqBC As Double = states.DRC.Items[indexB]
Var dqBS As Double = states.DRS.Items[indexB]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.MouseLinearImpulseX.Items[index]
Var pY As Double = sims.MouseLinearImpulseY.Items[index]
states.LVX.Items[indexB] = states.LVX.Items[indexB] + mB * pX
states.LVY.Items[indexB] = states.LVY.Items[indexB] + mB * pY
states.AngularVelocity.Items[indexB] = states.AngularVelocity.Items[indexB] + iB * (rBX * pY - rBY * pX + sims.MouseAngularImpulse.Items[index])
End Sub

## Runs one velocity iteration for one mouse joint row, ported from
## b2SolveMouseJoint. Upstream ignores the bias flag: the mouse joint is a
## soft constraint whose bias comes from its own spring softness.
Shared Sub SolveMouseJoint(sims As JointSims, index As Integer, context As StepContext)
Var indexB As Integer = sims.IndexB.Items[index]
If indexB = PhysicsConstants.NULL_INDEX Then
Return
End If
Var states As BodyStates = context.States
Var mB As Double = sims.InvMassB.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var vBX As Double = states.LVX.Items[indexB]
Var vBY As Double = states.LVY.Items[indexB]
Var wB As Double = states.AngularVelocity.Items[indexB]

# Soft angular damping with no bias term to reduce rotation speed.
Var angularImpulse As Double = 0.0
If iB > 0.0 Then
angularImpulse = -wB / iB
End If
angularImpulse = sims.MouseAngularSoftnessMassScale.Items[index] * angularImpulse - sims.MouseAngularSoftnessImpulseScale.Items[index] * sims.MouseAngularImpulse.Items[index]
sims.MouseAngularImpulse.Items[index] = sims.MouseAngularImpulse.Items[index] + angularImpulse
wB = wB + iB * angularImpulse

Var maxImpulse As Double = sims.MouseMaxForce.Items[index] * context.H
Var dqBC As Double = states.DRC.Items[indexB]
Var dqBS As Double = states.DRS.Items[indexB]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var cdotX As Double = vBX - wB * rBY
Var cdotY As Double = vBY + wB * rBX
Var sepX As Double = states.DPX.Items[indexB] + rBX + sims.DeltaCenterX.Items[index]
Var sepY As Double = states.DPY.Items[indexB] + rBY + sims.DeltaCenterY.Items[index]
Var biasRate As Double = sims.MouseLinearSoftnessBiasRate.Items[index]
Var rhsX As Double = cdotX + biasRate * sepX
Var rhsY As Double = cdotY + biasRate * sepY
Var bX As Double = sims.MouseLinearMassXX.Items[index] * rhsX + sims.MouseLinearMassXY.Items[index] * rhsY
Var bY As Double = sims.MouseLinearMassXY.Items[index] * rhsX + sims.MouseLinearMassYY.Items[index] * rhsY
Var massScale As Double = sims.MouseLinearSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.MouseLinearSoftnessImpulseScale.Items[index]
Var oldX As Double = sims.MouseLinearImpulseX.Items[index]
Var oldY As Double = sims.MouseLinearImpulseY.Items[index]
Var totalX As Double = oldX - massScale * bX - impulseScale * oldX
Var totalY As Double = oldY - massScale * bY - impulseScale * oldY

# Clamp the accumulated impulse magnitude, porting b2Normalize's
# degenerate branch: below the float epsilon the upstream normalization
# returns zero rather than a unit direction.
Var mag As Double = Maths.Sqrt(totalX * totalX + totalY * totalY)
If mag > maxImpulse Then
If mag >= PhysicsConstants.FLT_EPSILON Then
Var scale As Double = maxImpulse / mag
totalX = scale * totalX
totalY = scale * totalY
Else
totalX = 0.0
totalY = 0.0
End If
End If
sims.MouseLinearImpulseX.Items[index] = totalX
sims.MouseLinearImpulseY.Items[index] = totalY

Var deltaX As Double = totalX - oldX
Var deltaY As Double = totalY - oldY
vBX = vBX + mB * deltaX
vBY = vBY + mB * deltaY
wB = wB + iB * (rBX * deltaY - rBY * deltaX)
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End Sub

## Prepares one motor joint row, ported from b2PrepareMotorJoint. The motor
## constraint drives the relative pose, so both bodies contribute to the
## mass matrix. The linear mass is the inverse of the symmetric 2x2
## combined constraint matrix, stored as three scalars because the matrix
## is symmetric by construction. Upstream asserts at least one body is
## awake; a non-awake body stores a NULL_INDEX state row that the warm-start
## and solve kernels replace with an identity dummy, exactly like the
## upstream dummy b2BodyState for static bodies.
Private Shared Sub PrepareMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Anchors at the body origins offset by the local centres; the motor
# joint creation writes zero local anchors.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA] - sims.MotorLinearOffsetX.Items[index]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA] - sims.MotorLinearOffsetY.Items[index]
# Relative angle with scalar components: constructing intermediate Rot
# values here would allocate twice per prepared row per step.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.MotorDeltaAngle.Items[index] = PhysicsMaths.Atan2(relS, relC) - sims.MotorAngularOffset.Items[index]

Var rAX As Double = sims.AnchorAX.Items[index]
Var rAY As Double = sims.AnchorAY.Items[index]
Var rBX As Double = sims.AnchorBX.Items[index]
Var rBY As Double = sims.AnchorBY.Items[index]
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var k11 As Double = mA + mB + rAY * rAY * iA + rBY * rBY * iB
Var k12 As Double = -(rAY * rAX * iA + rBY * rBX * iB)
Var k22 As Double = mA + mB + rAX * rAX * iA + rBX * rBX * iB
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
sims.MotorLinearMassXX.Items[index] = det * k22
sims.MotorLinearMassXY.Items[index] = -det * k12
sims.MotorLinearMassYY.Items[index] = det * k11
Var ka As Double = iA + iB
If ka > 0.0 Then
sims.MotorAngularMass.Items[index] = 1.0 / ka
Else
sims.MotorAngularMass.Items[index] = 0.0
End If

If context.WarmStartScale = 0.0 Then
sims.MotorLinearImpulseX.Items[index] = 0.0
sims.MotorLinearImpulseY.Items[index] = 0.0
sims.MotorAngularImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored motor joint impulses to both body states before
## iterating, ported from b2WarmStartMotorJoint. Non-awake bodies use an
## identity dummy state, matching the upstream static-body path.
Shared Sub WarmStartMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.MotorLinearImpulseX.Items[index]
Var pY As Double = sims.MotorLinearImpulseY.Items[index]
Var angularImpulse As Double = sims.MotorAngularImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (rAX * pY - rAY * pX + angularImpulse)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (rBX * pY - rBY * pX + angularImpulse)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one motor joint row, ported from
## b2SolveMotorJoint. Upstream ignores the bias flag: the motor bias comes
## from the correction factor, not the solver softness.
Shared Sub SolveMotorJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

# Angular constraint: unwind the relative angle and drive it toward the
# offset with the correction-factor bias. The relative angle uses scalar
# components because two Rot allocations per solve iteration would break
# the zero-allocation step gate.
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var angularSeparation As Double = PhysicsMaths.Atan2(relS, relC) + sims.MotorDeltaAngle.Items[index]
angularSeparation = PhysicsMaths.UnwindAngle(angularSeparation)
Var angularBias As Double = context.InvH * sims.MotorCorrectionFactor.Items[index] * angularSeparation
Var angularCdot As Double = wB - wA
Var angularImpulse As Double = -sims.MotorAngularMass.Items[index] * (angularCdot + angularBias)
Var maxTorqueImpulse As Double = context.H * sims.MotorMaxTorque.Items[index]
Var newAngularImpulse As Double = sims.MotorAngularImpulse.Items[index] + angularImpulse
If newAngularImpulse > maxTorqueImpulse Then
newAngularImpulse = maxTorqueImpulse
ElseIf newAngularImpulse < -maxTorqueImpulse Then
newAngularImpulse = -maxTorqueImpulse
End If
angularImpulse = newAngularImpulse - sims.MotorAngularImpulse.Items[index]
sims.MotorAngularImpulse.Items[index] = newAngularImpulse
wA = wA - iA * angularImpulse
wB = wB + iB * angularImpulse

# Linear constraint.
Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var dsX As Double = dpBX - dpAX + rBX - rAX
Var dsY As Double = dpBY - dpAY + rBY - rAY
Var biasRate As Double = context.InvH * sims.MotorCorrectionFactor.Items[index]
Var rhsX As Double = vBX - wB * rBY - (vAX - wA * rAY) + biasRate * (sims.DeltaCenterX.Items[index] + dsX)
Var rhsY As Double = vBY + wB * rBX - (vAY + wA * rAX) + biasRate * (sims.DeltaCenterY.Items[index] + dsY)
Var bX As Double = sims.MotorLinearMassXX.Items[index] * rhsX + sims.MotorLinearMassXY.Items[index] * rhsY
Var bY As Double = sims.MotorLinearMassXY.Items[index] * rhsX + sims.MotorLinearMassYY.Items[index] * rhsY
Var oldX As Double = sims.MotorLinearImpulseX.Items[index]
Var oldY As Double = sims.MotorLinearImpulseY.Items[index]
Var totalX As Double = oldX - bX
Var totalY As Double = oldY - bY

# Clamp the accumulated impulse magnitude, porting b2Normalize's
# degenerate branch: below the float epsilon the upstream normalization
# returns zero rather than a unit direction.
Var maxForceImpulse As Double = context.H * sims.MotorMaxForce.Items[index]
Var magSquared As Double = totalX * totalX + totalY * totalY
If magSquared > maxForceImpulse * maxForceImpulse Then
Var mag As Double = Maths.Sqrt(magSquared)
If mag >= PhysicsConstants.FLT_EPSILON Then
Var scale As Double = maxForceImpulse / mag
totalX = scale * totalX
totalY = scale * totalY
Else
totalX = 0.0
totalY = 0.0
End If
End If
sims.MotorLinearImpulseX.Items[index] = totalX
sims.MotorLinearImpulseY.Items[index] = totalY

Var deltaX As Double = totalX - oldX
Var deltaY As Double = totalY - oldY
vAX = vAX - mA * deltaX
vAY = vAY - mA * deltaY
wA = wA - iA * (rAX * deltaY - rAY * deltaX)
vBX = vBX + mB * deltaX
vBY = vBY + mB * deltaY
wB = wB + iB * (rBX * deltaY - rBY * deltaX)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the motor joint row applied this step, ported from
## b2GetMotorJointForce.
Shared Function GetMotorJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.MotorLinearImpulseX.Items[index], scale * sims.MotorLinearImpulseY.Items[index])
End Function

## Torque the motor joint row applied this step, ported from
## b2GetMotorJointTorque.
Shared Function GetMotorJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.MotorAngularImpulse.Items[index]
End Function

## Prepares one revolute joint row, ported from b2PrepareRevoluteJoint.
## The hinge pins the two anchor points together and measures the relative
## angle against the reference angle, so both bodies contribute to every
## block. Anchors come from the definition's local anchors. The spring
## softness is prepared from the definition hertz and damping ratio; the
## base constraint softness (used by the limits and the point-to-point
## block) is prepared by the common joint prepare. A non-awake body stores
## a NULL_INDEX state row that the kernels replace with an identity dummy.
Private Shared Sub PrepareRevoluteJoint(sims As JointSims, index As Integer, context As StepContext)
Var world As World = context.World
Var bodyA As Body = world.Bodies[sims.BodyIdA.Items[index]]
Var bodyB As Body = world.Bodies[sims.BodyIdB.Items[index]]
Var simA As BodySims = world.GetBodySim(bodyA)
Var simB As BodySims = world.GetBodySim(bodyB)
Var indexA As Integer = bodyA.LocalIndex
Var indexB As Integer = bodyB.LocalIndex

sims.InvMassA.Items[index] = simA.InvMass.Items[indexA]
sims.InvIA.Items[index] = simA.InvInertia.Items[indexA]
sims.InvMassB.Items[index] = simB.InvMass.Items[indexB]
sims.InvIB.Items[index] = simB.InvInertia.Items[indexB]

If bodyA.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexA.Items[index] = indexA
Else
sims.IndexA.Items[index] = PhysicsConstants.NULL_INDEX
End If
If bodyB.SetIndex = PhysicsConstants.AWAKE_SET Then
sims.IndexB.Items[index] = indexB
Else
sims.IndexB.Items[index] = PhysicsConstants.NULL_INDEX
End If

# Initial anchors in world space from the definition's local anchors.
Var localDX As Double = sims.LocalOriginAnchorAX.Items[index] - simA.LCX.Items[indexA]
Var localDY As Double = sims.LocalOriginAnchorAY.Items[index] - simA.LCY.Items[indexA]
Var qcA As Double = simA.QC.Items[indexA]
Var qsA As Double = simA.QS.Items[indexA]
sims.AnchorAX.Items[index] = qcA * localDX - qsA * localDY
sims.AnchorAY.Items[index] = qsA * localDX + qcA * localDY
Var localEX As Double = sims.LocalOriginAnchorBX.Items[index] - simB.LCX.Items[indexB]
Var localEY As Double = sims.LocalOriginAnchorBY.Items[index] - simB.LCY.Items[indexB]
Var qcB As Double = simB.QC.Items[indexB]
Var qsB As Double = simB.QS.Items[indexB]
sims.AnchorBX.Items[index] = qcB * localEX - qsB * localEY
sims.AnchorBY.Items[index] = qsB * localEX + qcB * localEY

sims.DeltaCenterX.Items[index] = simB.CenterX.Items[indexB] - simA.CenterX.Items[indexA]
sims.DeltaCenterY.Items[index] = simB.CenterY.Items[indexB] - simA.CenterY.Items[indexA]
# Relative angle with scalar components; see the motor prepare note.
Var relS As Double = simB.QS.Items[indexB] * simA.QC.Items[indexA] - simB.QC.Items[indexB] * simA.QS.Items[indexA]
Var relC As Double = simB.QC.Items[indexB] * simA.QC.Items[indexA] + simB.QS.Items[indexB] * simA.QS.Items[indexA]
sims.RevoluteDeltaAngle.Items[index] = PhysicsMaths.Atan2(relS, relC)

Var ka As Double = sims.InvIA.Items[index] + sims.InvIB.Items[index]
If ka > 0.0 Then
sims.RevoluteAxialMass.Items[index] = 1.0 / ka
Else
sims.RevoluteAxialMass.Items[index] = 0.0
End If

Softness.MakeTo(sims.RevoluteHertz.Items[index], sims.RevoluteDampingRatio.Items[index], context.H, context.SoftnessScratch)
sims.RevoluteSpringSoftnessBiasRate.Items[index] = context.SoftnessScratch.BiasRate
sims.RevoluteSpringSoftnessMassScale.Items[index] = context.SoftnessScratch.MassScale
sims.RevoluteSpringSoftnessImpulseScale.Items[index] = context.SoftnessScratch.ImpulseScale

If context.WarmStartScale = 0.0 Then
sims.RevoluteLinearImpulseX.Items[index] = 0.0
sims.RevoluteLinearImpulseY.Items[index] = 0.0
sims.RevoluteSpringImpulse.Items[index] = 0.0
sims.RevoluteMotorImpulse.Items[index] = 0.0
sims.RevoluteLowerImpulse.Items[index] = 0.0
sims.RevoluteUpperImpulse.Items[index] = 0.0
End If
End Sub

## Applies stored revolute joint impulses to both body states before
## iterating, ported from b2WarmStartRevoluteJoint. The axial impulse
## bundles the spring, motor, and limit contributions.
Shared Sub WarmStartRevoluteJoint(sims As JointSims, index As Integer, context As StepContext)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var pX As Double = sims.RevoluteLinearImpulseX.Items[index]
Var pY As Double = sims.RevoluteLinearImpulseY.Items[index]
Var axialImpulse As Double = sims.RevoluteSpringImpulse.Items[index] + sims.RevoluteMotorImpulse.Items[index] + sims.RevoluteLowerImpulse.Items[index] - sims.RevoluteUpperImpulse.Items[index]

vAX = vAX - mA * pX
vAY = vAY - mA * pY
wA = wA - iA * (rAX * pY - rAY * pX + axialImpulse)
vBX = vBX + mB * pX
vBY = vBY + mB * pY
wB = wB + iB * (rBX * pY - rBY * pX + axialImpulse)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Runs one velocity iteration for one revolute joint row, ported from
## b2SolveRevoluteJoint: spring, motor, lower and upper limits, then the
## point-to-point block. The fixed-rotation guard skips the axial blocks
## exactly like upstream; the point-to-point block always runs.
Shared Sub SolveRevoluteJoint(sims As JointSims, index As Integer, context As StepContext, useBias As Boolean)
Var states As BodyStates = context.States
Var mA As Double = sims.InvMassA.Items[index]
Var mB As Double = sims.InvMassB.Items[index]
Var iA As Double = sims.InvIA.Items[index]
Var iB As Double = sims.InvIB.Items[index]
Var indexA As Integer = sims.IndexA.Items[index]
Var indexB As Integer = sims.IndexB.Items[index]

Var vAX As Double = 0.0
Var vAY As Double = 0.0
Var wA As Double = 0.0
Var dpAX As Double = 0.0
Var dpAY As Double = 0.0
Var dqAC As Double = 1.0
Var dqAS As Double = 0.0
If indexA <> PhysicsConstants.NULL_INDEX Then
vAX = states.LVX.Items[indexA]
vAY = states.LVY.Items[indexA]
wA = states.AngularVelocity.Items[indexA]
dpAX = states.DPX.Items[indexA]
dpAY = states.DPY.Items[indexA]
dqAC = states.DRC.Items[indexA]
dqAS = states.DRS.Items[indexA]
End If
Var vBX As Double = 0.0
Var vBY As Double = 0.0
Var wB As Double = 0.0
Var dpBX As Double = 0.0
Var dpBY As Double = 0.0
Var dqBC As Double = 1.0
Var dqBS As Double = 0.0
If indexB <> PhysicsConstants.NULL_INDEX Then
vBX = states.LVX.Items[indexB]
vBY = states.LVY.Items[indexB]
wB = states.AngularVelocity.Items[indexB]
dpBX = states.DPX.Items[indexB]
dpBY = states.DPY.Items[indexB]
dqBC = states.DRC.Items[indexB]
dqBS = states.DRS.Items[indexB]
End If

Var fixedRotation As Boolean = (iA + iB = 0.0)

# Solve spring.
If sims.EnableSpring.Items[index] <> 0 And fixedRotation = False Then
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var jointAngle As Double = PhysicsMaths.Atan2(relS, relC) + sims.RevoluteDeltaAngle.Items[index]
Var C As Double = PhysicsMaths.UnwindAngle(jointAngle - sims.RevoluteTargetAngle.Items[index])
Var bias As Double = sims.RevoluteSpringSoftnessBiasRate.Items[index] * C
Var massScale As Double = sims.RevoluteSpringSoftnessMassScale.Items[index]
Var impulseScale As Double = sims.RevoluteSpringSoftnessImpulseScale.Items[index]
Var Cdot As Double = wB - wA
Var impulse As Double = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * sims.RevoluteSpringImpulse.Items[index]
sims.RevoluteSpringImpulse.Items[index] = sims.RevoluteSpringImpulse.Items[index] + impulse
wA = wA - iA * impulse
wB = wB + iB * impulse
End If

# Solve motor constraint.
If sims.EnableMotor.Items[index] <> 0 And fixedRotation = False Then
Var Cdot As Double = wB - wA - sims.RevoluteMotorSpeed.Items[index]
Var impulse As Double = -sims.RevoluteAxialMass.Items[index] * Cdot
Var oldImpulse As Double = sims.RevoluteMotorImpulse.Items[index]
Var maxImpulse As Double = context.H * sims.RevoluteMaxMotorTorque.Items[index]
Var newImpulse As Double = oldImpulse + impulse
If newImpulse > maxImpulse Then
newImpulse = maxImpulse
ElseIf newImpulse < -maxImpulse Then
newImpulse = -maxImpulse
End If
sims.RevoluteMotorImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
wA = wA - iA * impulse
wB = wB + iB * impulse
End If

If sims.EnableLimit.Items[index] <> 0 And fixedRotation = False Then
Var relS As Double = dqBS * dqAC - dqBC * dqAS
Var relC As Double = dqBC * dqAC + dqBS * dqAS
Var jointAngle As Double = PhysicsMaths.UnwindAngle(PhysicsMaths.Atan2(relS, relC) + sims.RevoluteDeltaAngle.Items[index] - sims.RevoluteReferenceAngle.Items[index])

# Lower limit.
Var C As Double = jointAngle - sims.RevoluteLowerAngle.Items[index]
Var bias As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If C > 0.0 Then
# Speculation.
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var Cdot As Double = wB - wA
Var oldImpulse As Double = sims.RevoluteLowerImpulse.Items[index]
Var impulse As Double = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * oldImpulse
Var newImpulse As Double = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.RevoluteLowerImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse
wA = wA - iA * impulse
wB = wB + iB * impulse

# Upper limit: signs are flipped to keep C positive when the constraint
# is satisfied, which also keeps the impulse positive when active.
C = sims.RevoluteUpperAngle.Items[index] - jointAngle
bias = 0.0
massScale = 1.0
impulseScale = 0.0
If C > 0.0 Then
bias = C * context.InvH
ElseIf useBias Then
bias = sims.SoftnessBiasRate.Items[index] * C
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If

# Sign flipped on Cdot.
Cdot = wA - wB
oldImpulse = sims.RevoluteUpperImpulse.Items[index]
impulse = -massScale * sims.RevoluteAxialMass.Items[index] * (Cdot + bias) - impulseScale * oldImpulse
newImpulse = oldImpulse + impulse
If newImpulse < 0.0 Then
newImpulse = 0.0
End If
sims.RevoluteUpperImpulse.Items[index] = newImpulse
impulse = newImpulse - oldImpulse

# Sign flipped on applied impulse.
wA = wA + iA * impulse
wB = wB - iB * impulse
End If

# Solve point-to-point constraint. The 2x2 combined matrix is symmetric
# by construction and solved inline with the guarded inverse determinant
# of upstream b2Solve22.
Var rAX As Double = dqAC * sims.AnchorAX.Items[index] - dqAS * sims.AnchorAY.Items[index]
Var rAY As Double = dqAS * sims.AnchorAX.Items[index] + dqAC * sims.AnchorAY.Items[index]
Var rBX As Double = dqBC * sims.AnchorBX.Items[index] - dqBS * sims.AnchorBY.Items[index]
Var rBY As Double = dqBS * sims.AnchorBX.Items[index] + dqBC * sims.AnchorBY.Items[index]
Var cdX As Double = vBX - wB * rBY - (vAX - wA * rAY)
Var cdY As Double = vBY + wB * rBX - (vAY + wA * rAX)
Var biasX As Double = 0.0
Var biasY As Double = 0.0
Var massScale As Double = 1.0
Var impulseScale As Double = 0.0
If useBias Then
Var sepX As Double = dpBX - dpAX + rBX - rAX + sims.DeltaCenterX.Items[index]
Var sepY As Double = dpBY - dpAY + rBY - rAY + sims.DeltaCenterY.Items[index]
biasX = sims.SoftnessBiasRate.Items[index] * sepX
biasY = sims.SoftnessBiasRate.Items[index] * sepY
massScale = sims.SoftnessMassScale.Items[index]
impulseScale = sims.SoftnessImpulseScale.Items[index]
End If
Var k11 As Double = mA + mB + rAY * rAY * iA + rBY * rBY * iB
Var k12 As Double = -(rAY * rAX * iA + rBY * rBX * iB)
Var k22 As Double = mA + mB + rAX * rAX * iA + rBX * rBX * iB
Var rhsX As Double = cdX + biasX
Var rhsY As Double = cdY + biasY
Var det As Double = k11 * k22 - k12 * k12
If det <> 0.0 Then
det = 1.0 / det
End If
Var bX As Double = det * (k22 * rhsX - k12 * rhsY)
Var bY As Double = det * (k11 * rhsY - k12 * rhsX)
Var oldX As Double = sims.RevoluteLinearImpulseX.Items[index]
Var oldY As Double = sims.RevoluteLinearImpulseY.Items[index]
Var impX As Double = -massScale * bX - impulseScale * oldX
Var impY As Double = -massScale * bY - impulseScale * oldY
sims.RevoluteLinearImpulseX.Items[index] = oldX + impX
sims.RevoluteLinearImpulseY.Items[index] = oldY + impY

vAX = vAX - mA * impX
vAY = vAY - mA * impY
wA = wA - iA * (rAX * impY - rAY * impX)
vBX = vBX + mB * impX
vBY = vBY + mB * impY
wB = wB + iB * (rBX * impY - rBY * impX)

If indexA <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexA] = vAX
states.LVY.Items[indexA] = vAY
states.AngularVelocity.Items[indexA] = wA
End If
If indexB <> PhysicsConstants.NULL_INDEX Then
states.LVX.Items[indexB] = vBX
states.LVY.Items[indexB] = vBY
states.AngularVelocity.Items[indexB] = wB
End If
End Sub

## Total force the revolute joint row applied this step, ported from
## b2GetRevoluteJointForce.
Shared Function GetRevoluteJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.RevoluteLinearImpulseX.Items[index], scale * sims.RevoluteLinearImpulseY.Items[index])
End Function

## Torque the revolute joint row applied this step, ported from
## b2GetRevoluteJointTorque: the motor and limit impulses combined.
Shared Function GetRevoluteJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * (sims.RevoluteMotorImpulse.Items[index] + sims.RevoluteLowerImpulse.Items[index] - sims.RevoluteUpperImpulse.Items[index])
End Function

## Total force the mouse joint row applied this step, ported from
## b2GetMouseJointForce.
Shared Function GetMouseJointForce(sims As JointSims, index As Integer, invH As Double) As Vector2
Var scale As Double = invH
Return New Vector2(scale * sims.MouseLinearImpulseX.Items[index], scale * sims.MouseLinearImpulseY.Items[index])
End Function

## Torque the mouse joint row applied this step, ported from
## b2GetMouseJointTorque.
Shared Function GetMouseJointTorque(sims As JointSims, index As Integer, invH As Double) As Double
Return invH * sims.MouseAngularImpulse.Items[index]
End Function

## Total force the distance joint row applied this step, ported from
## b2GetDistanceJointForce.
Shared Function GetDistanceJointForce(world As World, sims As JointSims, index As Integer) As Vector2
Var transformA As Transform = world.GetBodyTransformById(sims.BodyIdA.Items[index])
Var transformB As Transform = world.GetBodyTransformById(sims.BodyIdB.Items[index])
Var pA As Vector2 = Transform.TransformPoint(transformA, New Vector2(sims.LocalOriginAnchorAX.Items[index], sims.LocalOriginAnchorAY.Items[index]))
Var pB As Vector2 = Transform.TransformPoint(transformB, New Vector2(sims.LocalOriginAnchorBX.Items[index], sims.LocalOriginAnchorBY.Items[index]))
Var d As Vector2 = pB - pA
Var length As Double = d.Length()
Var axisX As Double = 0.0
Var axisY As Double = 0.0
If length >= PhysicsConstants.FLT_EPSILON Then
Var invLength As Double = 1.0 / length
axisX = invLength * d.X
axisY = invLength * d.Y
End If
Var force As Double = (sims.Impulse.Items[index] + sims.LowerImpulse.Items[index] - sims.UpperImpulse.Items[index] + sims.MotorImpulse.Items[index]) * world.InvH
Return New Vector2(force * axisX, force * axisY)
End Function
End Class

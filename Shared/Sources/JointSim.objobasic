# Hot joint simulation state shared by every family, ported from the base
# fields of upstream b2JointSim in joint.h. Family-specific state lives in
# subclasses that extend this record; the owning solver set or graph colour
# stores one instance per joint row. Anchors are relative to body origins,
# matching upstream localOriginAnchorA/B.
Class JointSim
## Joint slot this sim serves.
Property JointId As Integer
## Body slot of the first edge.
Property BodyIdA As Integer
## Body slot of the second edge.
Property BodyIdB As Integer
## Family discriminator.
Property Type As JointType
## X component of the first anchor relative to body A's origin.
Property LocalOriginAnchorAX As Double
## Y component of the first anchor relative to body A's origin.
Property LocalOriginAnchorAY As Double
## X component of the second anchor relative to body B's origin.
Property LocalOriginAnchorBX As Double
## Y component of the second anchor relative to body B's origin.
Property LocalOriginAnchorBY As Double
## Inverse mass of body A.
Property InvMassA As Double
## Inverse rotational inertia of body A.
Property InvIA As Double
## Inverse mass of body B.
Property InvMassB As Double
## Inverse rotational inertia of body B.
Property InvIB As Double
## Solver hertz clamp for this joint, ported from constraintHertz.
Property ConstraintHertz As Double
## Solver damping ratio clamp for this joint, ported from
## constraintDampingRatio.
Property ConstraintDampingRatio As Double
## Soft-step softness derived from the tuning each step.
Property ConstraintSoftness As Softness
End Class

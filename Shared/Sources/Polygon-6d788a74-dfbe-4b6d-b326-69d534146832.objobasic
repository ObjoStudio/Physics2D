# A solid convex polygon with counter-clockwise winding, ported from upstream
# b2Polygon in collision.h and the factory functions in geometry.c.
#
# The interior lies to the left of each edge. Polygons hold at most
# MAX_POLYGON_VERTICES vertices. Use the Shared factories (MakeBox,
# MakePolygon, and friends) instead of the raw constructor: the factories
# compute normals and centroid and validate their input. Vertices and normals
# are owned arrays, copied on construction, so editing the polygon never
# mutates caller data and factory input never mutates the polygon.
Class Polygon
## The polygon vertices.
Property Vertices() As Vector2
## The outward normal vectors of the polygon sides.
Property Normals() As Vector2
## The centroid of the polygon.
Property Centroid As Vector2
## The external radius for rounded polygons.
Property Radius As Double
## The number of polygon vertices.
Property Count As Integer

## Creates an empty polygon. Use the Shared factories instead.
Constructor()
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)
Me.Centroid = New Vector2(0.0, 0.0)
Me.Radius = 0.0
Me.Count = 0
End Constructor

## Builds a polygon from a validated hull, ported from upstream b2MakePolygon.
## Throws InvalidArgumentException when the hull is not valid or the radius
## is negative or not finite.
Constructor(hullData As Hull, radius As Double)
If Not Hull.Validate(hullData) Then
Throw New InvalidArgumentException("Polygon hull must be valid")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If

Me.Count = hullData.Count
Me.Radius = radius
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)

# Copy vertices.
For i As Integer = 0 To Me.Count - 1
Me.Vertices.Append(New Vector2(hullData.Points[i].X, hullData.Points[i].Y))
Next i

# Compute normals. Valid hull edges have non-zero length.
Polygon.ComputeNormals(Me.Vertices, Me.Normals, Me.Count)
Me.Centroid = Polygon.ComputeCentroid(Me.Vertices, Me.Count)
End Constructor

## Internal raw constructor used by factories and collide helpers. Copies the
## supplied arrays. Callers must guarantee valid, convex, counter-clockwise
## geometry with unit normals.
Constructor(vertices() As Vector2, normals() As Vector2, centroid As Vector2, radius As Double, count As Integer)
Me.Vertices = New Array(Of Vector2)
Me.Normals = New Array(Of Vector2)
For i As Integer = 0 To count - 1
Me.Vertices.Append(New Vector2(vertices[i].X, vertices[i].Y))
Me.Normals.Append(New Vector2(normals[i].X, normals[i].Y))
Next i
Me.Centroid = New Vector2(centroid.X, centroid.Y)
Me.Radius = radius
Me.Count = count
End Constructor

## Builds a polygon from a hull with a position and rotation offset, ported
## from upstream b2MakeOffsetPolygon (zero radius).
Shared Function MakeOffsetPolygon(hull As Hull, position As Vector2, rotation As Rot) As Polygon
Return Polygon.MakeOffsetRoundedPolygon(hull, position, rotation, 0.0)
End Function

## Builds a rounded polygon from a hull with a position and rotation offset,
## ported from upstream b2MakeOffsetRoundedPolygon.
Shared Function MakeOffsetRoundedPolygon(hullData As Hull, position As Vector2, rotation As Rot, radius As Double) As Polygon
If Not Hull.Validate(hullData) Then
Throw New InvalidArgumentException("Polygon hull must be valid")
End If
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If

Var shape As New Polygon
shape.Count = hullData.Count
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)

# Copy transformed vertices.
For i As Integer = 0 To shape.Count - 1
Var x As Double = rotation.C * hullData.Points[i].X - rotation.S * hullData.Points[i].Y + position.X
Var y As Double = rotation.S * hullData.Points[i].X + rotation.C * hullData.Points[i].Y + position.Y
shape.Vertices.Append(New Vector2(x, y))
Next i

Polygon.ComputeNormals(shape.Vertices, shape.Normals, shape.Count)
shape.Centroid = Polygon.ComputeCentroid(shape.Vertices, shape.Count)
Return shape
End Function

## Builds a square with the given half width, ported from upstream
## b2MakeSquare.
Shared Function MakeSquare(halfWidth As Double) As Polygon
Return Polygon.MakeBox(halfWidth, halfWidth)
End Function

## Builds an axis-aligned box from half extents, ported from upstream
## b2MakeBox. Throws InvalidArgumentException when a half extent is not
## finite or not positive.
Shared Function MakeBox(halfWidth As Double, halfHeight As Double) As Polygon
If Not halfWidth.IsFinite() Or halfWidth <= 0.0 Then
Throw New InvalidArgumentException("Box half width must be finite and positive")
End If
If Not halfHeight.IsFinite() Or halfHeight <= 0.0 Then
Throw New InvalidArgumentException("Box half height must be finite and positive")
End If

Var shape As New Polygon
shape.Count = 4
shape.Radius = 0.0
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
shape.Vertices.Append(New Vector2(-halfWidth, -halfHeight))
shape.Vertices.Append(New Vector2(halfWidth, -halfHeight))
shape.Vertices.Append(New Vector2(halfWidth, halfHeight))
shape.Vertices.Append(New Vector2(-halfWidth, halfHeight))
shape.Normals.Append(New Vector2(0.0, -1.0))
shape.Normals.Append(New Vector2(1.0, 0.0))
shape.Normals.Append(New Vector2(0.0, 1.0))
shape.Normals.Append(New Vector2(-1.0, 0.0))
shape.Centroid = New Vector2(0.0, 0.0)
Return shape
End Function

## Builds a rounded axis-aligned box, ported from upstream b2MakeRoundedBox.
Shared Function MakeRoundedBox(halfWidth As Double, halfHeight As Double, radius As Double) As Polygon
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If
Var shape As Polygon = Polygon.MakeBox(halfWidth, halfHeight)
shape.Radius = radius
Return shape
End Function

## Builds an offset box: half extents placed at centre with rotation, ported
## from upstream b2MakeOffsetBox.
Shared Function MakeOffsetBox(halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot) As Polygon
Return Polygon.MakeOffsetRoundedBox(halfWidth, halfHeight, center, rotation, 0.0)
End Function

## Builds an offset rounded box, ported from upstream
## b2MakeOffsetRoundedBox.
Shared Function MakeOffsetRoundedBox(halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot, radius As Double) As Polygon
If Not radius.IsFinite() Or radius < 0.0 Then
Throw New InvalidArgumentException("Polygon radius must be finite and non-negative")
End If
If Not halfWidth.IsFinite() Or halfWidth <= 0.0 Then
Throw New InvalidArgumentException("Box half width must be finite and positive")
End If
If Not halfHeight.IsFinite() Or halfHeight <= 0.0 Then
Throw New InvalidArgumentException("Box half height must be finite and positive")
End If

Var shape As New Polygon
shape.Count = 4
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, -1.0, -1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, 1.0, -1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, 1.0, 1.0)
Polygon.AppendTransformedCorner(shape, halfWidth, halfHeight, center, rotation, -1.0, 1.0)
Polygon.AppendTransformedNormal(shape, rotation, 0.0, -1.0)
Polygon.AppendTransformedNormal(shape, rotation, 1.0, 0.0)
Polygon.AppendTransformedNormal(shape, rotation, 0.0, 1.0)
Polygon.AppendTransformedNormal(shape, rotation, -1.0, 0.0)
shape.Centroid = New Vector2(center.X, center.Y)
Return shape
End Function

## Returns a transformed copy of the polygon, ported from upstream
## b2TransformPolygon.
Shared Function TransformPolygon(transform As Transform, polygon As Polygon) As Polygon
Var result As New Polygon
result.Count = polygon.Count
result.Radius = polygon.Radius
For i As Integer = 0 To polygon.Count - 1
Var vx As Double = transform.Q.C * polygon.Vertices[i].X - transform.Q.S * polygon.Vertices[i].Y + transform.P.X
Var vy As Double = transform.Q.S * polygon.Vertices[i].X + transform.Q.C * polygon.Vertices[i].Y + transform.P.Y
result.Vertices.Append(New Vector2(vx, vy))
Var nx As Double = transform.Q.C * polygon.Normals[i].X - transform.Q.S * polygon.Normals[i].Y
Var ny As Double = transform.Q.S * polygon.Normals[i].X + transform.Q.C * polygon.Normals[i].Y
result.Normals.Append(New Vector2(nx, ny))
Next i
Var cx As Double = transform.Q.C * polygon.Centroid.X - transform.Q.S * polygon.Centroid.Y + transform.P.X
Var cy As Double = transform.Q.S * polygon.Centroid.X + transform.Q.C * polygon.Centroid.Y + transform.P.Y
result.Centroid.Set(cx, cy)
Return result
End Function

## Builds the two-vertex capsule polygon used by collide dispatch, ported
## from the private upstream b2MakeCapsule in manifold.c.
Shared Function MakeCapsulePolygon(p1 As Vector2, p2 As Vector2, radius As Double) As Polygon
Var shape As New Polygon
shape.Count = 2
shape.Radius = radius
shape.Vertices = New Array(Of Vector2)
shape.Normals = New Array(Of Vector2)
shape.Vertices.Append(New Vector2(p1.X, p1.Y))
shape.Vertices.Append(New Vector2(p2.X, p2.Y))
shape.Centroid.Set(0.5 * (p1.X + p2.X), 0.5 * (p1.Y + p2.Y))

Var dx As Double = p2.X - p1.X
Var dy As Double = p2.Y - p1.Y
Var len As Double = Maths.Sqrt(dx * dx + dy * dy)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
# Normal points to the right of the axis.
Var nx As Double = dy * invLen
Var ny As Double = -dx * invLen
shape.Normals.Append(New Vector2(nx, ny))
shape.Normals.Append(New Vector2(-nx, -ny))
Return shape
End Function

## Appends one box corner transformed by centre and rotation.
Shared Sub AppendTransformedCorner(shape As Polygon, halfWidth As Double, halfHeight As Double, center As Vector2, rotation As Rot, signX As Double, signY As Double)
Var lx As Double = signX * halfWidth
Var ly As Double = signY * halfHeight
Var x As Double = rotation.C * lx - rotation.S * ly + center.X
Var y As Double = rotation.S * lx + rotation.C * ly + center.Y
shape.Vertices.Append(New Vector2(x, y))
End Sub

## Appends one box face normal transformed by the rotation.
Shared Sub AppendTransformedNormal(shape As Polygon, rotation As Rot, nx As Double, ny As Double)
Var x As Double = rotation.C * nx - rotation.S * ny
Var y As Double = rotation.S * nx + rotation.C * ny
shape.Normals.Append(New Vector2(x, y))
End Sub

## Computes outward unit normals for a counter-clockwise vertex loop.
Shared Sub ComputeNormals(vertices() As Vector2, normals() As Vector2, count As Integer)
For i As Integer = 0 To count - 1
Var i1 As Integer = i
Var i2 As Integer = i
If i1 < count - 1 Then
i2 = i1 + 1
Else
i2 = 0
End If
Var ex As Double = vertices[i2].X - vertices[i1].X
Var ey As Double = vertices[i2].Y - vertices[i1].Y
Var len As Double = Maths.Sqrt(ex * ex + ey * ey)
Var invLen As Double = 0.0
If len > 0.0 Then
invLen = 1.0 / len
End If
# b2CrossVS(edge, 1) rotates the edge left; outward for CCW winding.
normals.Append(New Vector2(ey * invLen, -ex * invLen))
Next i
End Sub

## Area-weighted centroid via triangle fans, ported from the private
## upstream b2ComputePolygonCentroid.
Shared Function ComputeCentroid(vertices() As Vector2, count As Integer) As Vector2
Var centerX As Double = 0.0
Var centerY As Double = 0.0
Var area As Double = 0.0

# Use the first vertex as reference point to reduce round-off error.
Var ox As Double = vertices[0].X
Var oy As Double = vertices[0].Y

Var inv3 As Double = 1.0 / 3.0

For i As Integer = 1 To count - 2
# Triangle edges.
Var e1x As Double = vertices[i].X - ox
Var e1y As Double = vertices[i].Y - oy
Var e2x As Double = vertices[i + 1].X - ox
Var e2y As Double = vertices[i + 1].Y - oy
Var a As Double = 0.5 * (e1x * e2y - e1y * e2x)

# Area weighted centroid.
Var w As Double = a * inv3
centerX = centerX + w * (e1x + e2x)
centerY = centerY + w * (e1y + e2y)
area = area + a
Next i

If area <= 0.0000001192092896 Then
Throw New RuntimeException("Polygon area is degenerate")
End If

Var invArea As Double = 1.0 / area
Return New Vector2(ox + centerX * invArea, oy + centerY * invArea)
End Function
## Computes the mass data of the polygon, ported from upstream
## b2ComputePolygonMass. One- and two-vertex polygons delegate to the
## circle and capsule mass. Rounded polygons approximate their mass by
## pushing vertices outward. Inertia is about the local origin.
Function ComputeMass(density As Double) As MassData
Var data As New MassData
Return Me.ComputeMassTo(density, data)
End Function

## Caller-owned output form of ComputeMass for warm paths. The plain
## polygon path allocates nothing; rounded polygons still build a temporary
## pushed-out vertex array and are treated as a cold path.
Function ComputeMassTo(density As Double, out As MassData) As MassData
Var vertices As Array(Of Vector2) = Me.Vertices
If Me.Radius > 0.0 Then
# Approximate the mass of rounded polygons by pushing out the vertices.
Var pushed As New Array(Of Vector2)
Var sqrt2 As Double = 1.412
For i As Integer = 0 To Me.Count - 1
Var j As Integer = i - 1
If i = 0 Then
j = Me.Count - 1
End If
Var n1 As Vector2 = Me.Normals[j]
Var n2 As Vector2 = Me.Normals[i]
Var midX As Double = n1.X + n2.X
Var midY As Double = n1.Y + n2.Y
Var midLen As Double = Maths.Sqrt(midX * midX + midY * midY)
If midLen > PhysicsConstants.FLT_EPSILON Then
midX = midX / midLen
midY = midY / midLen
Else
midX = 0.0
midY = 0.0
End If
pushed.Append(New Vector2(Me.Vertices[i].X + sqrt2 * Me.Radius * midX, Me.Vertices[i].Y + sqrt2 * Me.Radius * midY))
Next i
vertices = pushed
End If

Var centerX As Double = 0.0
Var centerY As Double = 0.0
Var area As Double = 0.0
Var rotationalInertia As Double = 0.0

# Reference point for forming triangles: the first vertex reduces
# round-off error.
Var rx As Double = vertices[0].X
Var ry As Double = vertices[0].Y

Var inv3 As Double = 1.0 / 3.0

For i As Integer = 1 To Me.Count - 2
# Triangle edges.
Var e1x As Double = vertices[i].X - rx
Var e1y As Double = vertices[i].Y - ry
Var e2x As Double = vertices[i + 1].X - rx
Var e2y As Double = vertices[i + 1].Y - ry

Var crossD As Double = e1x * e2y - e1y * e2x

Var triangleArea As Double = 0.5 * crossD
area = area + triangleArea

# Area weighted centroid, r at origin.
Var sumX As Double = e1x + e2x
Var sumY As Double = e1y + e2y
centerX = centerX + triangleArea * inv3 * sumX
centerY = centerY + triangleArea * inv3 * sumY

Var intx2 As Double = e1x * e1x + e2x * e1x + e2x * e2x
Var inty2 As Double = e1y * e1y + e2y * e1y + e2y * e2y

rotationalInertia = rotationalInertia + (0.25 * inv3 * crossD) * (intx2 + inty2)
Next i

# Total mass.
out.Mass = density * area

# Centre of mass, shifted back from the origin at r.
If area <= PhysicsConstants.FLT_EPSILON Then
Throw New RuntimeException("Polygon area must be positive")
End If
Var invArea As Double = 1.0 / area
out.Center.Set(rx + centerX * invArea, ry + centerY * invArea)

# Inertia tensor relative to the local origin.
out.RotationalInertia = density * rotationalInertia

# Shift to the centre of mass.
Var cc As Double = out.Center.X * out.Center.X + out.Center.Y * out.Center.Y
Var localX As Double = centerX * invArea
Var localY As Double = centerY * invArea
Var c2 As Double = localX * localX + localY * localY
out.RotationalInertia = out.RotationalInertia + out.Mass * (cc - c2)

Return out
End Function

## Computes the world-space AABB of the transformed polygon, ported from
## upstream b2ComputePolygonAABB.
Function ComputeAABB(transform As Transform) As AABB
Return Me.ComputeAABBTo(transform, New AABB)
End Function

## Caller-owned output form of ComputeAABB for warm paths.
Function ComputeAABBTo(transform As Transform, out As AABB) As AABB
If Me.Count <= 0 Then
Throw New RuntimeException("Polygon must hold at least one vertex")
End If
Var lowerX As Double = transform.Q.C * Me.Vertices[0].X - transform.Q.S * Me.Vertices[0].Y + transform.P.X
Var lowerY As Double = transform.Q.S * Me.Vertices[0].X + transform.Q.C * Me.Vertices[0].Y + transform.P.Y
Var upperX As Double = lowerX
Var upperY As Double = lowerY
For i As Integer = 1 To Me.Count - 1
Var vx As Double = transform.Q.C * Me.Vertices[i].X - transform.Q.S * Me.Vertices[i].Y + transform.P.X
Var vy As Double = transform.Q.S * Me.Vertices[i].X + transform.Q.C * Me.Vertices[i].Y + transform.P.Y
If vx < lowerX Then
lowerX = vx
End If
If vy < lowerY Then
lowerY = vy
End If
If vx > upperX Then
upperX = vx
End If
If vy > upperY Then
upperY = vy
End If
Next i
out.LowerBound.Set(lowerX - Me.Radius, lowerY - Me.Radius)
out.UpperBound.Set(upperX + Me.Radius, upperY + Me.Radius)
Return out
End Function

## Determines whether the point lies within the polygon, ported from
## upstream b2PointInPolygon. Uses the GJK distance between the polygon's
## point cloud and the single query point.
Function ContainsPoint(point As Vector2) As Boolean
Var input As New DistanceInput
input.ProxyA = ShapeProxy.Make(Me.Vertices, Me.Count, 0.0)
Var onePoint As New Array(Of Vector2)
onePoint.Append(point)
input.ProxyB = ShapeProxy.Make(onePoint, 1, 0.0)
input.UseRadii = False
Var cache As New SimplexCache
Var output As DistanceOutput = Distance.ShapeDistance(input, cache)
Return output.Distance <= Me.Radius
End Function
End Class

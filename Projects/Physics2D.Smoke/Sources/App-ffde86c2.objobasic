# Smoke application. It proves that the Physics2D module assembles from nested
# Shared Code source items and compiles in a project-type-neutral program, and
# doubles as the compact distance-, mouse-, motor-, revolute-, and prismatic-
# joint examples: two boxes connected by a spring-loaded distance joint that
# is stretched and released, a third box dragged to a target with a mouse
# joint, a fourth box driven to a position and angle pose with a motor joint,
# a fifth box swinging on a revolute hinge held by a rotational spring, and a
# sixth box shuttling along a prismatic rail under a sine-speed motor.
Import Physics2D

Class App Inherits CommandLineApplication
Event Run(args() As String) As Integer
Pragma Unused args

Var world As New World()

Var groundDef As New BodyDefinition()
groundDef.Type = BodyType.StaticBody
Var ground As Body = world.CreateBody(groundDef)
ground.CreateSegment(New ShapeDefinition(), New Segment(-10.0, 0.0, 10.0, 0.0))

Var bodyDef As New BodyDefinition()
bodyDef.Type = BodyType.DynamicBody
bodyDef.Position = New Vector2(-2.0, 8.0)
Var bodyA As Body = world.CreateBody(bodyDef)
bodyA.CreateCircle(New ShapeDefinition(), New Circle(New Vector2(0.0, 0.0), 0.5))

bodyDef.Position = New Vector2(2.0, 8.0)
Var bodyB As Body = world.CreateBody(bodyDef)
bodyB.CreateCircle(New ShapeDefinition(), New Circle(New Vector2(0.0, 0.0), 0.5))

Var jointDef As New DistanceJointDefinition()
jointDef.BodyA = ground
jointDef.BodyB = bodyA
jointDef.LocalAnchorB = New Vector2(0.0, 0.5)
jointDef.Length = 8.0
jointDef.EnableSpring = True
jointDef.Hertz = 1.0
jointDef.DampingRatio = 0.7
Var spring As DistanceJoint = world.CreateDistanceJoint(jointDef)

Var rodDef As New DistanceJointDefinition()
rodDef.BodyA = bodyA
rodDef.BodyB = bodyB
rodDef.Length = 4.0
Var rod As DistanceJoint = world.CreateDistanceJoint(rodDef)

For i As Integer = 1 To 120
  world.StepWorld(1.0 / 60.0)
Next

# Drag a box with a mouse joint: settle at the grab point, then retarget
# and wake like an interactive drag. The scalar overload keeps the
# per-frame retarget allocation-free.
Var dragDef As New BodyDefinition()
dragDef.Type = BodyType.DynamicBody
dragDef.Position = New Vector2(5.0, 4.0)
Var dragged As Body = world.CreateBody(dragDef)
dragged.CreateCircle(New ShapeDefinition(), New Circle(New Vector2(0.0, 0.0), 0.5))

Var mouseDef As New MouseJointDefinition()
mouseDef.BodyA = ground
mouseDef.BodyB = dragged
mouseDef.Target = New Vector2(5.0, 4.0)
mouseDef.Hertz = 5.0
mouseDef.DampingRatio = 0.7
mouseDef.MaxForce = 1000.0
Var drag As MouseJoint = world.CreateMouseJoint(mouseDef)

For i As Integer = 1 To 60
  world.StepWorld(1.0 / 60.0)
Next
drag.SetTarget(7.0, 5.0)
dragged.SetAwake(True)
For i As Integer = 1 To 180
  world.StepWorld(1.0 / 60.0)
Next

# Drive a box to a pose with a motor joint: settle at the offset pose,
# then retarget and wake like an interactive pose tween. Offset changes
# do not wake a sleeping body, so the retarget wakes explicitly.
Var drivenDef As New BodyDefinition()
drivenDef.Type = BodyType.DynamicBody
drivenDef.Position = New Vector2(-5.0, 4.0)
Var driven As Body = world.CreateBody(drivenDef)
driven.CreatePolygon(New ShapeDefinition(), Polygon.MakeBox(0.25, 0.25))

Var motorDef As New MotorJointDefinition()
motorDef.BodyA = ground
motorDef.BodyB = driven
motorDef.LinearOffset = New Vector2(-5.0, 6.0)
motorDef.AngularOffset = 0.5
motorDef.MaxForce = 500.0
motorDef.MaxTorque = 200.0
Var motor As MotorJoint = world.CreateMotorJoint(motorDef)

For i As Integer = 1 To 120
  world.StepWorld(1.0 / 60.0)
Next
motor.SetLinearOffset(-4.0, 6.0)
motor.SetAngularOffset(0.25)
driven.SetAwake(True)
For i As Integer = 1 To 240
  world.StepWorld(1.0 / 60.0)
Next

# Swing a box on a hinge: kick it, let the swing decay, then hold it with
# a damped rotational spring driving toward a target angle.
Var pendulumDef As New BodyDefinition()
pendulumDef.Type = BodyType.DynamicBody
pendulumDef.Position = New Vector2(-2.0, 1.75)
pendulumDef.AngularDamping = 2.0
Var pendulum As Body = world.CreateBody(pendulumDef)
pendulum.CreatePolygon(New ShapeDefinition(), Polygon.MakeBox(0.25, 0.25))

Var hingeDef As New RevoluteJointDefinition()
hingeDef.BodyA = ground
hingeDef.BodyB = pendulum
hingeDef.LocalAnchorA = New Vector2(-2.0, 2.0)
hingeDef.LocalAnchorB = New Vector2(0.0, 0.25)
hingeDef.EnableSpring = True
hingeDef.Hertz = 2.0
hingeDef.DampingRatio = 0.6
hingeDef.TargetAngle = 0.8
Var hinge As RevoluteJoint = world.CreateRevoluteJoint(hingeDef)

pendulum.SetAngularVelocity(1.0)
For i As Integer = 1 To 240
  world.StepWorld(1.0 / 60.0)
Next

# Slide a box on a rail: a motor-driven prismatic joint shuttles the box
# along the axis with a sine speed profile.
Var sliderDef As New BodyDefinition()
sliderDef.Type = BodyType.DynamicBody
sliderDef.Position = New Vector2(4.0, 1.5)
Var slider As Body = world.CreateBody(sliderDef)
slider.CreatePolygon(New ShapeDefinition(), Polygon.MakeBox(0.25, 0.25))

Var railDef As New PrismaticJointDefinition()
railDef.BodyA = ground
railDef.BodyB = slider
railDef.LocalAnchorA = New Vector2(4.0, 1.5)
railDef.LocalAnchorB = New Vector2(0.0, 0.0)
railDef.LocalAxisA = New Vector2(1.0, 0.0)
railDef.EnableMotor = True
railDef.MaxMotorForce = 20.0
Var rail As PrismaticJoint = world.CreatePrismaticJoint(railDef)

For i As Integer = 1 To 240
  rail.SetMotorSpeed(0.75 * Maths.Sin(0.1 * i))
  world.StepWorld(1.0 / 60.0)
Next

Print("Physics2D module imported successfully.")
Print("Hanging box at (" + spring.GetBodyB().GetPosition().X.ToString() + ", " + spring.GetBodyB().GetPosition().Y.ToString() + ") after resting on the ground")
Print("Rod force " + rod.GetConstraintForce().ToString() + " N")
Print("Dragged box at (" + dragged.GetPosition().X.ToString() + ", " + dragged.GetPosition().Y.ToString() + ") after the mouse joint drag")
Print("Driven box at (" + driven.GetPosition().X.ToString() + ", " + driven.GetPosition().Y.ToString() + ") angle " + Rot.GetAngle(driven.GetRotation()).ToString() + " rad after the motor joint drive")
Print("Pendulum at angle " + hinge.GetAngle().ToString() + " rad held by the revolute spring")
Print("Slider at translation " + rail.GetTranslation().ToString() + " m on the prismatic rail")
Return 0
End Event
End Class

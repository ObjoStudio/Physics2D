# Smoke application. It proves that the Physics2D module assembles from nested
# Shared Code source items and compiles in a project-type-neutral program, and
# doubles as the compact distance-joint example: two boxes connected by a
# spring-loaded distance joint that is stretched and released.
Import Physics2D

Class App Inherits CommandLineApplication
Event Run(args() As String) As Integer
Pragma Unused args

Var world As New World()

Var groundDef As New BodyDefinition()
groundDef.Type = BodyType.StaticBody
Var ground As Body = world.CreateBody(groundDef)
ground.CreateSegment(New ShapeDefinition(), New Segment(-10.0, 0.0, 10.0, 0.0))

Var bodyDef As New BodyDefinition()
bodyDef.Type = BodyType.DynamicBody
bodyDef.Position = New Vector2(-2.0, 8.0)
Var bodyA As Body = world.CreateBody(bodyDef)
bodyA.CreateCircle(New ShapeDefinition(), New Circle(New Vector2(0.0, 0.0), 0.5))

bodyDef.Position = New Vector2(2.0, 8.0)
Var bodyB As Body = world.CreateBody(bodyDef)
bodyB.CreateCircle(New ShapeDefinition(), New Circle(New Vector2(0.0, 0.0), 0.5))

Var jointDef As New DistanceJointDefinition()
jointDef.BodyA = ground
jointDef.BodyB = bodyA
jointDef.LocalAnchorB = New Vector2(0.0, 0.5)
jointDef.Length = 8.0
jointDef.EnableSpring = True
jointDef.Hertz = 1.0
jointDef.DampingRatio = 0.7
Var spring As DistanceJoint = world.CreateDistanceJoint(jointDef)

Var rodDef As New DistanceJointDefinition()
rodDef.BodyA = bodyA
rodDef.BodyB = bodyB
rodDef.Length = 4.0
Var rod As DistanceJoint = world.CreateDistanceJoint(rodDef)

For i As Integer = 1 To 120
  world.StepWorld(1.0 / 60.0)
Next

Print("Physics2D module imported successfully.")
Print("Hanging box at (" + spring.GetBodyB().GetPosition().X.ToString() + ", " + spring.GetBodyB().GetPosition().Y.ToString() + ") after resting on the ground")
Print("Rod force " + rod.GetConstraintForce().ToString() + " N")
Return 0
End Event
End Class

# Stage 9 tests: distance and mouse joints, covering constraint
# satisfaction, spring, limits, motor, collide-connected toggling, joint
# placement across solver sets, destruction, validation, determinism, and
# golden fixtures for both families.
Import Physics2D

Class Stage9Tests Inherits TestCase

## Joint used by the tuning validation helpers.
Private Property mTuningJoint As DistanceJoint

## Definition reused by the cross-world throwers.
Private Property mCrossWorldDef As DistanceJointDefinition

## Mouse definition reused by the cross-world throwers.
Private Property mCrossMouseDef As MouseJointDefinition

## Mouse joint used by the validation throwers.
Private Property mMouseThrowJoint As MouseJoint

## Motor definition reused by the cross-world throwers.
Private Property mCrossMotorDef As MotorJointDefinition

## Motor joint used by the validation throwers.
Private Property mMotorThrowJoint As MotorJoint

## Revolute joint used by the validation throwers.
Private Property mRevoluteThrowJoint As RevoluteJoint

## Revolute definition reused by the cross-world throwers.
Private Property mCrossRevoluteDef As RevoluteJointDefinition

## Invalid revolute definition reused by the creation thrower.
Private Property mBadRevoluteDef As RevoluteJointDefinition

## Prismatic joint used by the validation throwers.
Private Property mPrismaticThrowJoint As PrismaticJoint

## Prismatic definition reused by the cross-world throwers.
Private Property mCrossPrismaticDef As PrismaticJointDefinition

## Invalid prismatic definition reused by the creation thrower.
Private Property mBadPrismaticDef As PrismaticJointDefinition

## Builds a world with a wide static ground box whose top surface is y=0.
Shared Function MakeWorld() As World
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var groundDef As New BodyDefinition
groundDef.Position = New Vector2(0.0, -0.5)
Var ground As Body = world.CreateBody(groundDef)
ground.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(50.0, 0.5))
Return world
End Function

## Builds a dynamic box body with unit density.
Shared Function MakeBox(world As World, x As Double, y As Double, halfWidth As Double, halfHeight As Double) As Body
Var def As New BodyDefinition
def.Type = BodyType.DynamicBody
def.Position = New Vector2(x, y)
Var body As Body = world.CreateBody(def)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
body.CreatePolygon(shapeDef, Polygon.MakeBox(halfWidth, halfHeight))
Return body
End Function

## Steps the world at 60 Hz.
Shared Sub Steps(world As World, count As Integer)
Var i As Integer = 0
While i < count
world.StepWorld(1.0 / 60.0)
i = i + 1
Wend
End Sub

## Builds a rigid distance joint between two bodies at the given world
## separation along x, with anchors at the body centres.
Shared Function MakeRope(world As World, bodyA As Body, bodyB As Body, length As Double) As DistanceJoint
Var def As New DistanceJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
def.Length = length
Return world.CreateDistanceJoint(def)
End Function

## Builds a world matching the golden mouse-joint fixture: a wide static
## ground box whose top surface is y=0.
Shared Function MakeMouseWorld() As World
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var groundDef As New BodyDefinition
groundDef.Position = New Vector2(0.0, -1.0)
Var ground As Body = world.CreateBody(groundDef)
ground.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(50.0, 1.0))
Return world
End Function

## Builds the 0.25 kg dragged box used by the mouse-joint tests.
Shared Function MakeDraggedBox(world As World, x As Double, y As Double) As Body
Var def As New BodyDefinition
def.Type = BodyType.DynamicBody
def.Position = New Vector2(x, y)
Var body As Body = world.CreateBody(def)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
body.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Return body
End Function

## Builds a mouse joint dragging the box toward the target with the given
## spring tuning and force clamp.
Shared Function MakeMouseJoint(world As World, ground As Body, box As Body, target As Vector2, hertz As Double, dampingRatio As Double, maxForce As Double) As MouseJoint
Var def As New MouseJointDefinition
def.BodyA = ground
def.BodyB = box
def.Target = target
def.Hertz = hertz
def.DampingRatio = dampingRatio
def.MaxForce = maxForce
Return world.CreateMouseJoint(def)
End Function

## Builds a motor joint driving the box toward the offset pose with the
## given force clamp, torque clamp, and correction factor.
Shared Function MakeMotorJoint(world As World, bodyA As Body, bodyB As Body, offsetX As Double, offsetY As Double, angularOffset As Double, maxForce As Double, maxTorque As Double, correctionFactor As Double) As MotorJoint
Var def As New MotorJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
def.LinearOffset = New Vector2(offsetX, offsetY)
def.AngularOffset = angularOffset
def.MaxForce = maxForce
def.MaxTorque = maxTorque
def.CorrectionFactor = correctionFactor
Return world.CreateMotorJoint(def)
End Function

## Builds the hanging-hinge scene shared by the revolute tests: a 0.25 kg
## box pinned at (2, -0.25) through its top edge, hanging straight down.
Shared Function MakeHingeWorld(angularDamping As Double) As World
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
boxDef.Position = New Vector2(2.0, -0.5)
boxDef.AngularDamping = angularDamping
Var box As Body = world.CreateBody(boxDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
box.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Var def As New RevoluteJointDefinition
def.BodyA = ground
def.BodyB = box
# The ground body sits at (0, -1), so the local anchor (2, 0.75) puts the
# world pivot at (2, -0.25), matching the golden fixture scenes.
def.LocalAnchorA = New Vector2(2.0, 0.75)
def.LocalAnchorB = New Vector2(0.0, 0.25)
world.CreateRevoluteJoint(def)
Return world
End Function

## Returns the revolute joint of the single-joint hinge scene.
Shared Function HingeJoint(world As World) As RevoluteJoint
Return RevoluteJoint(world.Bodies[1].GetJoints()[0])
End Function

## Builds the slider scene shared by the prismatic tests: a 0.25 kg box
## pinned at (0, -0.5) through its centre, free to slide along the world X
## axis, or along a tilted diagonal rail when tilted is true.
Shared Function MakeSliderWorld(tilted As Boolean) As World
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
boxDef.Position = New Vector2(0.0, -0.5)
Var box As Body = world.CreateBody(boxDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
box.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Var def As New PrismaticJointDefinition
def.BodyA = ground
def.BodyB = box
def.LocalAnchorA = New Vector2(0.0, 0.5)
def.LocalAnchorB = New Vector2(0.0, 0.0)
If tilted Then
def.LocalAxisA = New Vector2(1.0, 1.0)
End If
world.CreatePrismaticJoint(def)
Return world
End Function

## Returns the prismatic joint of the single-joint slider scene.
Shared Function SliderJoint(world As World) As PrismaticJoint
Return PrismaticJoint(world.Bodies[1].GetJoints()[0])
End Function

## A rigid distance joint holds two hanging boxes at the rest length.
Public Sub TestRigidDistanceConstraintHoldsLength()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.Equal(2.0, joint.GetLength(), "rest length round trip")
Stage9Tests.Steps(world, 120)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(2.0, separation, 0.02, 0.02, "rigid distance holds rest length")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxA).X, 0.05, 0.05, "box A settles")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxB).X, 0.05, 0.05, "box B settles")
world.Validate()
End Sub

## A soft spring with damping restores the rest length after a disturbance.
Public Sub TestSpringRestoresRestLength()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 3.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.Hertz = 5.0
def.DampingRatio = 0.7
def.EnableSpring = True
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.True(joint.IsSpringEnabled(), "spring enabled round trip")
Assert.Equal(5.0, joint.GetSpringHertz(), "spring hertz round trip")
Assert.Equal(0.7, joint.GetSpringDampingRatio(), "damping ratio round trip")
Stage9Tests.Steps(world, 240)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(2.0, separation, 0.03, 0.03, "spring pulls bodies to rest length")
world.Validate()
End Sub

## Length limits clamp a motor-driven stretch.
Public Sub TestLimitsClampMotorStretch()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.EnableSpring = True
def.EnableLimit = True
def.MinLength = 1.0
def.MaxLength = 3.0
def.EnableMotor = True
def.MotorSpeed = 2.0
def.MaxMotorForce = 50.0
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.True(joint.IsLimitEnabled(), "limit enabled round trip")
Assert.Equal(1.0, joint.GetMinLength(), "min length round trip")
Assert.Equal(3.0, joint.GetMaxLength(), "max length round trip")
Stage9Tests.Steps(world, 240)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
Assert.True(separation <= 3.1, "separation stays under the upper limit")
Assert.True(separation >= 0.98, "separation stays over the lower limit")
Assert.True(joint.GetMotorForce() > 0.0, "motor reports positive force")
world.Validate()
End Sub

## A motor stretches a rigid rope at the requested speed until limits stop it.
Public Sub TestMotorDrivesSeparation()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.EnableSpring = True
def.EnableMotor = True
def.MotorSpeed = 1.0
def.MaxMotorForce = 10000.0
world.CreateDistanceJoint(def)
Stage9Tests.Steps(world, 60)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(3.0, separation, 0.2, 0.2, "motor stretches one metre per second")
world.Validate()
End Sub

## SetCollideConnected destroys and restores the contact between the bodies.
Public Sub TestCollideConnectedDestroysAndRestoresContact()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -0.15, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.15, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 0.3
def.CollideConnected = False
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Stage9Tests.Steps(world, 10)
Assert.Equal(0, world.ContactCount, "overlapping joined bodies hold no contact")
joint.SetCollideConnected(True)
Stage9Tests.Steps(world, 10)
Assert.Equal(1, world.ContactCount, "collide connected restores the contact")
joint.SetCollideConnected(False)
Stage9Tests.Steps(world, 10)
Assert.Equal(0, world.ContactCount, "collide connected off destroys the contact again")
world.Validate()
End Sub

## Joint placement covers static-static, disabled, and awake graph cases.
Public Sub TestJointPlacementAcrossSolverSets()
Var world As World = Stage9Tests.MakeWorld()
Var staticOne As Body = world.CreateBody(New BodyDefinition)
Var staticTwo As Body = world.CreateBody(New BodyDefinition)
Var def As New DistanceJointDefinition
def.BodyA = staticOne
def.BodyB = staticTwo
def.Length = 1.0
Var staticJoint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.Equal(PhysicsConstants.STATIC_SET, staticJoint.SetIndex, "static-static joint sits in the static set")

Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var awakeDef As New DistanceJointDefinition
awakeDef.BodyA = boxA
awakeDef.BodyB = boxB
awakeDef.Length = 2.0
Var awakeJoint As DistanceJoint = world.CreateDistanceJoint(awakeDef)
Assert.Equal(PhysicsConstants.AWAKE_SET, awakeJoint.SetIndex, "awake joint sits in the graph")
Assert.True(awakeJoint.ColorIndex >= 0 And awakeJoint.ColorIndex < PhysicsConstants.GRAPH_COLOUR_COUNT, "awake joint holds a graph colour")

boxA.Disable()
Var disabledDef As New DistanceJointDefinition
disabledDef.BodyA = boxA
disabledDef.BodyB = boxB
disabledDef.Length = 2.0
Var disabledJoint As DistanceJoint = world.CreateDistanceJoint(disabledDef)
Assert.Equal(PhysicsConstants.DISABLED_SET, disabledJoint.SetIndex, "joint with a disabled body sits in the disabled set")
Assert.Equal(3, world.JointCount, "three live joints")
world.Validate()
End Sub

## Destroying a joint unlinks both bodies and wakes the attached islands.
Public Sub TestDestroyJointUnlinksAndWakes()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.Equal(1, boxA.GetJointCount(), "body A holds one joint")
Assert.Equal(1, boxB.GetJointCount(), "body B holds one joint")
Assert.Equal(1, world.JointCount, "world holds one joint")
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, boxA.GetJointCount(), "body A unlinked after destroy")
Assert.Equal(0, boxB.GetJointCount(), "body B unlinked after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
boxB.SetLinearVelocity(New Vector2(2.0, 0.0))
Stage9Tests.Steps(world, 30)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
Assert.True(separation > 2.1, "bodies drift apart after the rope is destroyed")
world.Validate()
End Sub

## Destroying a body destroys its attached joints and keeps the partner.
Public Sub TestDestroyBodyDestroysAttachedJoints()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
world.DestroyBody(boxA)
Assert.Equal(0, world.JointCount, "attached joints destroyed with the body")
Assert.Equal(0, boxB.GetJointCount(), "surviving body holds no joints")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Body.GetJoints returns every attached joint and survives slot reuse.
Public Sub TestGetJointsListsAllAttachments()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var boxC As Body = Stage9Tests.MakeBox(world, 3.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Stage9Tests.MakeRope(world, boxB, boxC, 2.0)
Assert.Equal(2, boxB.GetJointCount(), "middle body holds two joints")
Var joints As Array(Of Joint) = boxB.GetJoints()
Assert.Equal(2, joints.Count, "GetJoints returns both attachments")
Assert.Equal(2, world.JointCount, "world holds two joints")
Stage9Tests.Steps(world, 30)
world.Validate()
End Sub

## Destroyed joint slots are reused and stale facades stay invalid.
Public Sub TestSlotReuseAndGenerationGuard()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
joint.Destroy()
Var replacement As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.True(replacement.IsValid(), "replacement facade is valid")
Assert.False(joint.IsValid(), "stale facade still invalid after slot reuse")
Assert.Equal(0, replacement.Id, "slot reused for the replacement")
Assert.Equal(1, world.JointCount, "world holds one live joint")
world.Validate()
End Sub

## Constraint tuning setters validate inputs and round trip through sims.
Public Sub TestConstraintTuningValidation()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Me.mTuningJoint = joint
joint.SetConstraintHertz(30.0)
joint.SetConstraintDampingRatio(0.5)
Assert.Equal(30.0, joint.GetConstraintHertz(), "constraint hertz round trip")
Assert.Equal(0.5, joint.GetConstraintDampingRatio(), "damping ratio round trip")
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowNegativeHertz)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowNegativeDampingRatio)
joint.SetLength(-1.0)
Assert.Equal(PhysicsConstants.LINEAR_SLOP, joint.GetLength(), "negative length clamps to the slop")
joint.SetLengthRange(2.0, 1.0)
Assert.Equal(1.0, joint.GetMinLength(), "inverted range orders the lower bound first")
Assert.Equal(2.0, joint.GetMaxLength(), "inverted range orders the upper bound second")
joint.SetUserData(world)
Assert.True(joint.GetUserData() = world, "user data round trip")
joint.SetUserData(Nothing)
Assert.True(joint.GetUserData() = Nothing, "user data cleared")
world.Validate()
End Sub

## A joint must never connect bodies from two different worlds, and the
## definition bodies must be live. Regression for the repair-1 gate.
Public Sub TestCreateDistanceJointRejectsCrossWorldBodies()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeBox(worldA, -1.0, 5.0, 0.2, 0.2)
Var bodyB As Body = Stage9Tests.MakeBox(worldB, 1.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyB = Nothing
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyA = Nothing
def.BodyB = bodyB
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyA = bodyA
def.BodyB = worldA.CreateBody(New BodyDefinition)
Me.mCrossWorldDef = def
Var joint As DistanceJoint = worldA.CreateDistanceJoint(def)
joint.Destroy()
worldA.DestroyBody(bodyA)
def.BodyA = bodyA
def.BodyB = Nothing
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
worldA.Validate()
worldB.Validate()
End Sub

## Two coincident bodies joined with a spring distance joint must receive
## no impulse while their separation stays degenerate, even though an
## unrelated horizontal rope joint is solved earlier in the same graph
## colour. The solver reuses one scratch record per step, so the axis must
## reset before the degenerate-separation branch. Regression for the
## repair-2 gate: a stale axis would push the pair apart along x.
Public Sub TestCoincidentAnchorsIgnoreStaleAxis()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Var filter As New Filter
filter.GroupIndex = -2
Var shapeDefC As New ShapeDefinition
shapeDefC.Density = 1.0
shapeDefC.Filter = filter
Var shapeDefD As New ShapeDefinition
shapeDefD.Density = 1.0
shapeDefD.Filter = filter
Var coincidentDef As New BodyDefinition
coincidentDef.Type = BodyType.DynamicBody
coincidentDef.Position = New Vector2(5.0, 5.0)
Var boxC As Body = world.CreateBody(coincidentDef)
boxC.CreatePolygon(shapeDefC, Polygon.MakeBox(0.2, 0.2))
Var coincidentDefB As New BodyDefinition
coincidentDefB.Type = BodyType.DynamicBody
coincidentDefB.Position = New Vector2(5.0, 5.0)
Var boxD As Body = world.CreateBody(coincidentDefB)
boxD.CreatePolygon(shapeDefD, Polygon.MakeBox(0.2, 0.2))
Var springDef As New DistanceJointDefinition
springDef.BodyA = boxC
springDef.BodyB = boxD
springDef.Length = 2.0
springDef.EnableSpring = True
springDef.Hertz = 5.0
springDef.DampingRatio = 0.7
world.CreateDistanceJoint(springDef)
Var i As Integer = 0
While i < 10
world.StepWorld(1.0 / 60.0)
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxC).X, 0.000000001, 0.000000001, "coincident joint leaves body C x velocity untouched")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxD).X, 0.000000001, 0.000000001, "coincident joint leaves body D x velocity untouched")
PhysicsAssert.Near(5.0, world.GetBodyTransform(boxC).P.X, 0.000000001, 0.000000001, "body C x position untouched")
PhysicsAssert.Near(5.0, world.GetBodyTransform(boxD).P.X, 0.000000001, 0.000000001, "body D x position untouched")
i = i + 1
Wend
world.Validate()
End Sub

## Recreates the four deterministic distance-joint scenes of the
## joint_distance golden fixture and compares final transforms, awake
## flags, constraint forces, lengths, and motor forces against upstream
## Box2D 3.1.1 output generated from the pinned sources.
Public Sub TestDistanceJointMatchesGoldenFixture()
Var lines() As String = PhysicsAssert.FixtureLines("joint_distance.txt")

Var ropeWorld As World = Stage9Tests.MakeWorld()
Var ropeA As Body = Stage9Tests.MakeBox(ropeWorld, -1.0, 6.0, 0.25, 0.25)
Var ropeB As Body = Stage9Tests.MakeBox(ropeWorld, 1.0, 6.0, 0.25, 0.25)
Var ropeJoint As DistanceJoint = Stage9Tests.MakeRope(ropeWorld, ropeA, ropeB, 2.0)
Stage9Tests.Steps(ropeWorld, 90)

Var limitWorld As New World
limitWorld.Gravity = New Vector2(0.0, -10.0)
Var limitAnchorDef As New BodyDefinition
limitAnchorDef.Position = New Vector2(0.0, 8.0)
Var limitAnchor As Body = limitWorld.CreateBody(limitAnchorDef)
Var limitDef As New BodyDefinition
limitDef.Type = BodyType.DynamicBody
limitDef.Position = New Vector2(0.0, 6.5)
limitDef.LinearVelocity = New Vector2(0.0, -12.0)
Var limitBody As Body = limitWorld.CreateBody(limitDef)
limitBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var limitJointDef As New DistanceJointDefinition
limitJointDef.BodyA = limitAnchor
limitJointDef.BodyB = limitBody
limitJointDef.Length = 1.5
limitJointDef.EnableSpring = True
limitJointDef.Hertz = 5.0
limitJointDef.DampingRatio = 0.5
limitJointDef.EnableLimit = True
limitJointDef.MinLength = 0.5
limitJointDef.MaxLength = 1.5
Var limitJoint As DistanceJoint = limitWorld.CreateDistanceJoint(limitJointDef)
Stage9Tests.Steps(limitWorld, 120)

Var springWorld As New World
springWorld.Gravity = New Vector2(0.0, -10.0)
Var springAnchorDef As New BodyDefinition
springAnchorDef.Position = New Vector2(0.0, 8.0)
Var springAnchor As Body = springWorld.CreateBody(springAnchorDef)
Var springBodyDef As New BodyDefinition
springBodyDef.Type = BodyType.DynamicBody
springBodyDef.Position = New Vector2(0.0, 5.5)
Var springBody As Body = springWorld.CreateBody(springBodyDef)
springBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var springJointDef As New DistanceJointDefinition
springJointDef.BodyA = springAnchor
springJointDef.BodyB = springBody
springJointDef.Length = 2.0
springJointDef.EnableSpring = True
springJointDef.Hertz = 3.0
springJointDef.DampingRatio = 0.6
Var springJoint As DistanceJoint = springWorld.CreateDistanceJoint(springJointDef)
Stage9Tests.Steps(springWorld, 240)

Var motorWorld As New World
motorWorld.Gravity = New Vector2(0.0, -10.0)
Var motorAnchorDef As New BodyDefinition
motorAnchorDef.Position = New Vector2(0.0, 8.0)
Var motorAnchor As Body = motorWorld.CreateBody(motorAnchorDef)
Var motorBodyDef As New BodyDefinition
motorBodyDef.Type = BodyType.DynamicBody
motorBodyDef.Position = New Vector2(0.0, 7.0)
Var motorBody As Body = motorWorld.CreateBody(motorBodyDef)
motorBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var motorJointDef As New DistanceJointDefinition
motorJointDef.BodyA = motorAnchor
motorJointDef.BodyB = motorBody
motorJointDef.Length = 0.5
motorJointDef.EnableSpring = True
motorJointDef.Hertz = 20.0
motorJointDef.DampingRatio = 1.0
motorJointDef.EnableLimit = True
motorJointDef.MinLength = 0.5
motorJointDef.MaxLength = 5.0
motorJointDef.EnableMotor = True
motorJointDef.MotorSpeed = 2.0
motorJointDef.MaxMotorForce = 2000.0
Var motorJoint As DistanceJoint = motorWorld.CreateDistanceJoint(motorJointDef)
Stage9Tests.Steps(motorWorld, 240)

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
If kind = "body" Then
Var bodyIndex As Integer = Integer.Parse(fields[3])
Var values() As String = fields[4].Split(" ")
Var expectedX As Double = Double.Parse(values[0])
Var expectedY As Double = Double.Parse(values[1])
Var expectedAngle As Double = Double.Parse(values[2])
Var expectedAwake As Integer = Integer.Parse(values[3])
Var label As String = caseName + " body " + bodyIndex.ToString()
Var world As World = Nothing
Var body As Body = Nothing
If caseName = "rope" And bodyIndex = 0 Then
world = ropeWorld
body = ropeA
ElseIf caseName = "rope" And bodyIndex = 1 Then
world = ropeWorld
body = ropeB
ElseIf caseName = "limit" Then
world = limitWorld
body = limitBody
ElseIf caseName = "spring" Then
world = springWorld
body = springBody
ElseIf caseName = "motor" Then
world = motorWorld
body = motorBody
Else
Assert.Fail("unknown joint fixture body " + caseName + " " + bodyIndex.ToString())
End If
Var transform As Transform = world.GetBodyTransform(body)
PhysicsAssert.Near(expectedX, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " x")
PhysicsAssert.Near(expectedY, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " y")
PhysicsAssert.Near(expectedAngle, Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " angle")
If expectedAwake = 1 Then
Assert.True(body.IsAwake(), label + " awake")
Else
Assert.True(body.IsAwake() = False, label + " asleep")
End If
ElseIf kind = "joint" Then
Var jointValues() As String = fields[3].Split(" ")
Var jointLabel As String = caseName + " joint"
Var jointWorld As World = Nothing
Var joint As DistanceJoint = Nothing
If caseName = "rope" Then
jointWorld = ropeWorld
joint = ropeJoint
ElseIf caseName = "limit" Then
jointWorld = limitWorld
joint = limitJoint
ElseIf caseName = "spring" Then
jointWorld = springWorld
joint = springJoint
ElseIf caseName = "motor" Then
jointWorld = motorWorld
joint = motorJoint
Else
Assert.Fail("unknown joint fixture joint " + caseName)
End If
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " torque")
PhysicsAssert.Near(Double.Parse(jointValues[3]), joint.GetCurrentLength(), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, jointLabel + " length")
PhysicsAssert.Near(Double.Parse(jointValues[4]), joint.GetMotorForce(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " motor force")
Else
Assert.Fail("unknown joint fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(9, checkedRecords)
ropeWorld.Validate()
limitWorld.Validate()
springWorld.Validate()
motorWorld.Validate()
End Sub

## After a warm-up that covers falling, resting, sleeping, waking, and
## re-sleeping with joints attached, further steps that wake the island and
## let it sleep again must allocate nothing. Gate for the Stage 9
## zero-allocation requirement across the joint migration paths.
Public Sub TestWarmJointSleepWakeAllocatesNothing()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -0.5, 5.0, 0.25, 0.25)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.5, 5.0, 0.25, 0.25)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 1.0)

# Warm-up: fall, land, sleep, then force a wake/sleep cycle so every
# migration buffer, graph colour list, and recycled solver set is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
boxA.SetAwake(True)
While warmIndex < 240
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
boxB.SetAwake(True)
While warmIndex < 360
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(boxA.IsAwake() = False, "box A asleep after warm-up")
Assert.True(boxB.IsAwake() = False, "box B asleep after warm-up sleepTime=" + boxB.SleepTime.ToString() + " awake=" + boxB.IsAwake().ToString())

# Measured window: wake the joined island, let it sleep, wake again.
Var before As Integer = System.AllocationCount
boxA.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 45 Then
boxB.SetAwake(True)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed joint sleep and wake allocate nothing")
Assert.True(boxA.IsAwake() = False, "box A asleep after measured window")
Assert.True(boxB.IsAwake() = False, "box B asleep after measured window")
world.Validate()
End Sub

## A soft mouse joint drags the body to the target and holds it against
## gravity with the expected equilibrium force. The joint is created with
## the target at the body centre so the constraint is a pure damped point
## pull, then retargeted and woken like the upstream sample's drag flow.
Public Sub TestMouseJointDragsBodyToTarget()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(0.0, 5.0), 5.0, 0.7, 1000.0)
Assert.Equal(JointType.MouseJoint, joint.GetJointType(), "mouse joint type")
PhysicsAssert.Near(0.0, joint.GetTarget().X, 0.0, 0.0, "target x round trip")
PhysicsAssert.Near(5.0, joint.GetTarget().Y, 0.0, 0.0, "target y round trip")
Assert.Equal(5.0, joint.GetSpringHertz(), "hertz round trip")
Assert.Equal(0.7, joint.GetSpringDampingRatio(), "damping ratio round trip")
Assert.Equal(1000.0, joint.GetMaxForce(), "max force round trip")
Stage9Tests.Steps(world, 120)
Var transform As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(0.0, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "held at target x")
PhysicsAssert.Near(5.0, transform.P.Y, 0.012, 0.012, "held at target y with spring sag")
Assert.True(box.IsAwake() = False, "dragged body falls asleep at the target")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force x")
PhysicsAssert.Near(2.5, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force holds the 0.25 kg weight")
PhysicsAssert.Near(0.0, joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled torque")
# Retarget two metres away and wake; the body re-converges and re-sleeps.
joint.SetTarget(2.0, 5.5)
box.SetAwake(True)
Stage9Tests.Steps(world, 180)
Var moved As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(2.0, moved.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "dragged to retarget x")
PhysicsAssert.Near(5.5, moved.P.Y, 0.012, 0.012, "dragged to retarget y with spring sag")
Assert.True(box.IsAwake() = False, "body sleeps at the new target")
Var anchor As Vector2 = joint.GetAnchorB()
PhysicsAssert.Near(2.0, anchor.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "drag anchor tracks the body")
world.Validate()
End Sub

## A mouse joint whose maximum force cannot hold the weight saturates its
## impulse clamp: the reported force magnitude never exceeds the clamp and
## the body falls at the expected reduced acceleration.
Public Sub TestMouseJointMaxForceClamps()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(0.0, 5.0), 5.0, 0.7, 1.0)
Stage9Tests.Steps(world, 150)
Var force As Vector2 = joint.GetConstraintForce()
Var magnitude As Double = Maths.Sqrt(force.X * force.X + force.Y * force.Y)
Assert.True(magnitude <= 1.0 + 0.01, "clamped force stays within the maximum")
PhysicsAssert.Near(1.0, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "clamp saturates upward pull")
# Recorded upstream endpoint of the same scene: the 1 N clamp against the
# 2.5 N weight yields the constant 6 m/s^2 fall (see joint_mouse.txt).
PhysicsAssert.Near(-13.8108187, world.GetBodyTransform(box).P.Y, 0.02, 0.02, "clamped body falls at 6 m/s^2")
Assert.True(box.IsAwake(), "clamped falling body stays awake")
world.Validate()
End Sub

## Mouse joint tuning setters round trip and validate their inputs; the
## target setter does not wake a sleeping body, matching upstream.
Public Sub TestMouseJointRuntimeProperties()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(0.0, 5.0), 5.0, 0.7, 1000.0)
Me.mMouseThrowJoint = joint
joint.SetSpringHertz(12.0)
joint.SetSpringDampingRatio(0.9)
joint.SetMaxForce(250.0)
Assert.Equal(12.0, joint.GetSpringHertz(), "runtime hertz round trip")
Assert.Equal(0.9, joint.GetSpringDampingRatio(), "runtime damping round trip")
Assert.Equal(250.0, joint.GetMaxForce(), "runtime max force round trip")
joint.SetTarget(New Vector2(1.0, 6.0))
PhysicsAssert.Near(1.0, joint.GetTarget().X, 0.0, 0.0, "runtime target x")
PhysicsAssert.Near(6.0, joint.GetTarget().Y, 0.0, 0.0, "runtime target y")
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowMouseNegativeHertz)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowMouseNegativeDamping)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowMouseNegativeMaxForce)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowMouseNonFiniteTarget)
joint.SetUserData(box)
Assert.True(joint.GetUserData() = box, "mouse user data round trip")
# A sleeping body stays asleep across a target change.
Stage9Tests.Steps(world, 120)
Assert.True(box.IsAwake() = False, "body asleep before retarget")
Var frozen As Transform = world.GetBodyTransform(box)
joint.SetTarget(New Vector2(3.0, 5.0))
Assert.True(box.IsAwake() = False, "retarget does not wake a sleeping body")
Stage9Tests.Steps(world, 30)
Var still As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(frozen.P.X, still.P.X, 0.001, 0.001, "sleeping body ignores the retarget")
PhysicsAssert.Near(frozen.P.Y, still.P.Y, 0.001, 0.001, "sleeping body ignores the retarget vertically")
box.SetAwake(True)
Stage9Tests.Steps(world, 180)
PhysicsAssert.Near(3.0, world.GetBodyTransform(box).P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "woken body chases the new target")
world.Validate()
End Sub

## Recreates the three mouse-joint scenes of the joint_mouse golden fixture
## and compares final transforms, awake flags, and constraint forces against
## upstream Box2D 3.1.1 output generated from the pinned sources.
Public Sub TestMouseJointMatchesGoldenFixture()
Var lines() As String = PhysicsAssert.FixtureLines("joint_mouse.txt")

Var dragWorld As World = Stage9Tests.MakeMouseWorld()
Var dragGround As Body = dragWorld.Bodies[0]
Var dragBody As Body = Stage9Tests.MakeDraggedBox(dragWorld, 0.0, 5.0)
Var dragJoint As MouseJoint = Stage9Tests.MakeMouseJoint(dragWorld, dragGround, dragBody, New Vector2(0.0, 5.0), 5.0, 0.7, 1000.0)
Var weakWorld As World = Stage9Tests.MakeMouseWorld()
Var weakGround As Body = weakWorld.Bodies[0]
Var weakBody As Body = Stage9Tests.MakeDraggedBox(weakWorld, 0.0, 5.0)
Var weakJoint As MouseJoint = Stage9Tests.MakeMouseJoint(weakWorld, weakGround, weakBody, New Vector2(0.0, 5.0), 5.0, 0.7, 1.0)
Var stiffWorld As World = Stage9Tests.MakeMouseWorld()
Var stiffGround As Body = stiffWorld.Bodies[0]
Var stiffBody As Body = Stage9Tests.MakeDraggedBox(stiffWorld, 0.0, 5.0)
Var stiffJoint As MouseJoint = Stage9Tests.MakeMouseJoint(stiffWorld, stiffGround, stiffBody, New Vector2(0.0, 5.0), 20.0, 1.0, 5000.0)

Var frameIndex As Integer = 0
While frameIndex < 180
Stage9Tests.StepFrame(dragWorld, dragJoint, dragBody, frameIndex)
Stage9Tests.StepFrame(stiffWorld, stiffJoint, stiffBody, frameIndex)
If frameIndex < 150 Then
weakWorld.StepWorld(1.0 / 60.0)
End If
frameIndex = frameIndex + 1
Wend

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
If kind = "body" Then
Var values() As String = fields[4].Split(" ")
Var expectedX As Double = Double.Parse(values[0])
Var expectedY As Double = Double.Parse(values[1])
Var expectedAngle As Double = Double.Parse(values[2])
Var expectedAwake As Integer = Integer.Parse(values[3])
Var label As String = caseName + " body"
Var world As World = Nothing
Var body As Body = Nothing
If caseName = "drag" Then
world = dragWorld
body = dragBody
ElseIf caseName = "weak" Then
world = weakWorld
body = weakBody
ElseIf caseName = "stiff" Then
world = stiffWorld
body = stiffBody
Else
Assert.Fail("unknown mouse fixture body " + caseName)
End If
Var transform As Transform = world.GetBodyTransform(body)
PhysicsAssert.Near(expectedX, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " x")
PhysicsAssert.Near(expectedY, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " y")
PhysicsAssert.Near(expectedAngle, Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " angle")
If expectedAwake = 1 Then
Assert.True(body.IsAwake(), label + " awake")
Else
Assert.True(body.IsAwake() = False, label + " asleep")
End If
ElseIf kind = "mouse" Then
Var jointValues() As String = fields[3].Split(" ")
Var joint As MouseJoint = Nothing
If caseName = "drag" Then
joint = dragJoint
ElseIf caseName = "weak" Then
joint = weakJoint
ElseIf caseName = "stiff" Then
joint = stiffJoint
Else
Assert.Fail("unknown mouse fixture joint " + caseName)
End If
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " torque")
Else
Assert.Fail("unknown mouse fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(6, checkedRecords)
dragWorld.Validate()
weakWorld.Validate()
stiffWorld.Validate()
End Sub

## Steps one frame of a golden mouse scene, applying the mid-scene
## retarget-and-wake at frame sixty.
Shared Sub StepFrame(world As World, joint As MouseJoint, body As Body, frameIndex As Integer)
world.StepWorld(1.0 / 60.0)
If frameIndex = 60 Then
joint.SetTarget(New Vector2(2.0, 5.5))
body.SetAwake(True)
End If
End Sub

## Mouse joint lifecycle: destruction, stale facades, slot reuse, and body
## destruction destroying the attached joint.
Public Sub TestMouseJointLifecycle()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(0.0, 5.0), 5.0, 0.7, 1000.0)
Assert.Equal(1, world.JointCount, "one live mouse joint")
Assert.Equal(1, ground.GetJointCount(), "ground holds the joint edge")
Assert.Equal(1, box.GetJointCount(), "box holds the joint edge")
Assert.True(joint.IsValid(), "facade valid after creation")
Var reusedId As Integer = joint.Id
Stage9Tests.Steps(world, 30)
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
Assert.Equal(0, ground.GetJointCount(), "ground unlinked")
Assert.Equal(0, box.GetJointCount(), "box unlinked")
Assert.True(box.IsAwake(), "destroy wakes the dragged body")
Var replacement As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(1.0, 5.0), 5.0, 0.7, 1000.0)
Assert.Equal(reusedId, replacement.Id, "slot reused")
Assert.False(joint.IsValid(), "stale facade stays invalid after slot reuse")
world.DestroyBody(box)
Assert.Equal(0, world.JointCount, "attached mouse joint destroyed with the body")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Cross-world and missing mouse joint bodies are rejected at creation.
Public Sub TestMouseJointRejectsCrossWorldBodies()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeDraggedBox(worldA, 0.0, 5.0)
Var bodyB As Body = Stage9Tests.MakeDraggedBox(worldB, 0.0, 5.0)
Var def As New MouseJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossMouseDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMouseJoint)
def.BodyB = Nothing
Me.mCrossMouseDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMouseJoint)
def.BodyA = Nothing
def.BodyB = bodyB
Me.mCrossMouseDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMouseJoint)
worldA.Validate()
worldB.Validate()
End Sub

## A mouse joint whose body B is static carries zero constraint mass and
## applies no impulse, matching upstream's singular inverse-mass handling.
Public Sub TestMouseJointOnStaticBodyBAppliesNothing()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var moverDef As New BodyDefinition
moverDef.Type = BodyType.DynamicBody
moverDef.Position = New Vector2(-4.0, 5.0)
Var mover As Body = world.CreateBody(moverDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
mover.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Var staticDef As New BodyDefinition
staticDef.Position = New Vector2(0.0, 5.0)
Var block As Body = world.CreateBody(staticDef)
block.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, mover, block, New Vector2(3.0, 5.0), 5.0, 0.7, 1000.0)
Stage9Tests.Steps(world, 60)
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "static body B force x")
PhysicsAssert.Near(0.0, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "static body B force y")
PhysicsAssert.Near(-4.0, world.GetBodyTransform(mover).P.X, 0.05, 0.05, "dynamic body A falls freely")
world.Validate()
End Sub

## A mouse joint drags the body deterministically across repeated worlds.
Public Sub TestMouseJointDeterminism()
Var first As World = Stage9Tests.MakeMouseDragWorld()
Var second As World = Stage9Tests.MakeMouseDragWorld()
Stage9Tests.Steps(first, 180)
Stage9Tests.Steps(second, 180)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "mouse drag repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## Builds a three-body drag scene with staggered targets and tunings.
Shared Function MakeMouseDragWorld() As World
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var boxA As Body = Stage9Tests.MakeDraggedBox(world, -1.0, 5.0)
Var boxB As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 4.0)
Var boxC As Body = Stage9Tests.MakeDraggedBox(world, 1.0, 5.0)
Stage9Tests.MakeMouseJoint(world, ground, boxA, New Vector2(1.0, 6.0), 5.0, 0.7, 500.0)
Stage9Tests.MakeMouseJoint(world, ground, boxB, New Vector2(0.0, 6.0), 10.0, 1.0, 100.0)
Stage9Tests.MakeMouseJoint(world, ground, boxC, New Vector2(-1.0, 6.0), 20.0, 1.0, 2000.0)
Return world
End Function

## After a warm-up that covers sleeping, waking, retargeting, and
## re-sleeping with a mouse joint attached, further steps must allocate
## nothing. Gate for the Stage 9 zero-allocation requirement on the mouse
## family, including the runtime target-change path.
Public Sub TestWarmMouseJointAllocatesNothing()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Var joint As MouseJoint = Stage9Tests.MakeMouseJoint(world, ground, box, New Vector2(0.0, 5.0), 5.0, 0.7, 1000.0)

# Warm-up: settle, sleep, wake with a retarget, sleep again so every
# migration buffer and graph colour list is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
joint.SetTarget(New Vector2(1.0, 5.0))
box.SetAwake(True)
While warmIndex < 240
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after first retarget warm-up")
box.SetAwake(True)
While warmIndex < 360
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after warm-up")

# Measured window: wake the body, retarget mid-window, let it sleep. The
# scalar SetTarget overload keeps the runtime tuning path allocation-free.
Var before As Integer = System.AllocationCount
box.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 30 Then
joint.SetTarget(2.0, 5.0)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed mouse joint stepping allocates nothing")
Assert.True(box.IsAwake() = False, "box asleep after measured window")
world.Validate()
End Sub

## A motor joint drives the box to the position and angle offset relative
## to a static ground and holds it against gravity with the weight as the
## equilibrium force. This is the upstream default correction factor.
Public Sub TestMotorJointDrivesBodyToPose()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Var joint As MotorJoint = Stage9Tests.MakeMotorJoint(world, ground, box, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)
Assert.Equal(JointType.MotorJoint, joint.GetJointType(), "motor joint type")
Var offset As Vector2 = joint.GetLinearOffset()
PhysicsAssert.Near(3.0, offset.X, 0.0, 0.0, "linear offset x round trip")
PhysicsAssert.Near(2.0, offset.Y, 0.0, 0.0, "linear offset y round trip")
Assert.Equal(0.5, joint.GetAngularOffset(), "angular offset round trip")
Assert.Equal(500.0, joint.GetMaxForce(), "max force round trip")
Assert.Equal(200.0, joint.GetMaxTorque(), "max torque round trip")
Assert.Equal(0.3, joint.GetCorrectionFactor(), "correction factor round trip")
Stage9Tests.Steps(world, 240)
Var transform As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(3.0, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "driven to offset pose x")
PhysicsAssert.Near(1.0, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "driven to offset pose y")
PhysicsAssert.Near(0.5, Rot.GetAngle(transform.Q), 0.001, 0.001, "driven to angular offset")
Assert.True(box.IsAwake() = False, "driven body falls asleep at the pose")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force x")
PhysicsAssert.Near(2.5, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force holds the 0.25 kg weight")
PhysicsAssert.Near(0.0, joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled torque")
Assert.Equal(0.0, joint.GetLinearSeparation(), "motor joint reports no linear separation")
world.Validate()
End Sub

## A motor joint whose maximum torque is zero rotates nothing while the
## linear drive still works, and one whose maximum force is below the
## weight saturates its impulse clamp so the body falls at the expected
## reduced acceleration.
Public Sub TestMotorJointClamps()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Stage9Tests.MakeMotorJoint(world, ground, box, 3.0, 2.0, 0.5, 500.0, 0.0, 1.0)
Stage9Tests.Steps(world, 240)
Var transform As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(3.0, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "zero-torque drive still reaches pose x")
PhysicsAssert.Near(1.0, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "zero-torque drive still reaches pose y")
PhysicsAssert.Near(0.0, Rot.GetAngle(transform.Q), 0.001, 0.001, "zero torque never rotates the body")
Assert.True(box.IsAwake() = False, "zero-torque driven body sleeps at the pose")
world.Validate()

Var weakWorld As World = Stage9Tests.MakeMouseWorld()
Var weakGround As Body = weakWorld.Bodies[0]
Var weakBox As Body = Stage9Tests.MakeDraggedBox(weakWorld, 3.0, 0.5)
Var weakJoint As MotorJoint = Stage9Tests.MakeMotorJoint(weakWorld, weakGround, weakBox, 3.0, 2.0, 0.5, 1.0, 200.0, 1.0)
Stage9Tests.Steps(weakWorld, 120)
Var force As Vector2 = weakJoint.GetConstraintForce()
Var magnitude As Double = Maths.Sqrt(force.X * force.X + force.Y * force.Y)
Assert.True(magnitude <= 1.0 + 0.01, "clamped motor force stays within the maximum")
PhysicsAssert.Near(1.0, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "motor clamp saturates upward pull")
# Recorded upstream endpoint of the same scene: the 1 N clamp against the
# 2.5 N weight yields the constant 6 m/s^2 fall (see the weak-clamp probe
# for joint_motor fixtures and the matching mouse scene).
PhysicsAssert.Near(-11.524978, weakWorld.GetBodyTransform(weakBox).P.Y, 0.02, 0.02, "clamped body falls at 6 m/s^2")
Assert.True(weakBox.IsAwake(), "clamped falling body stays awake")
weakWorld.Validate()
End Sub

## A motor joint drives body B to the offset pose relative to a dynamic
## body A; the relative pose converges and both bodies sleep.
Public Sub TestMotorJointBetweenDynamicBodies()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var carrierDef As New BodyDefinition
carrierDef.Type = BodyType.DynamicBody
carrierDef.Position = New Vector2(0.0, 0.5)
Var carrier As Body = world.CreateBody(carrierDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
carrier.CreatePolygon(shapeDef, Polygon.MakeBox(0.5, 0.5))
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Stage9Tests.MakeMotorJoint(world, carrier, box, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)
Stage9Tests.Steps(world, 240)
Var carrierTransform As Transform = world.GetBodyTransform(carrier)
Var boxTransform As Transform = world.GetBodyTransform(box)
Var relativeX As Double = boxTransform.P.X - carrierTransform.P.X
Var relativeY As Double = boxTransform.P.Y - carrierTransform.P.Y
PhysicsAssert.Near(3.0, relativeX, 0.005, 0.005, "relative pose offset x")
PhysicsAssert.Near(2.0, relativeY, 0.005, 0.005, "relative pose offset y")
Var relativeAngle As Double = Rot.GetAngle(boxTransform.Q) - Rot.GetAngle(carrierTransform.Q)
PhysicsAssert.Near(0.5, relativeAngle, 0.005, 0.005, "relative pose angle")
Assert.True(box.IsAwake() = False, "driven body sleeps")
Assert.True(carrier.IsAwake() = False, "carrier sleeps")
world.Validate()
End Sub

## Motor joint tuning setters round trip; force and torque clamp negative
## inputs to zero and the correction factor clamps into [0, 1] like
## upstream, non-finite inputs throw, and offset changes do not wake a
## sleeping body.
Public Sub TestMotorJointRuntimeProperties()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Var joint As MotorJoint = Stage9Tests.MakeMotorJoint(world, ground, box, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)
Me.mMotorThrowJoint = joint
joint.SetLinearOffset(New Vector2(1.0, 4.0))
joint.SetAngularOffset(-0.25)
joint.SetMaxForce(80.0)
joint.SetMaxTorque(40.0)
joint.SetCorrectionFactor(0.8)
Var offset As Vector2 = joint.GetLinearOffset()
PhysicsAssert.Near(1.0, offset.X, 0.0, 0.0, "runtime linear offset x")
PhysicsAssert.Near(4.0, offset.Y, 0.0, 0.0, "runtime linear offset y")
Assert.Equal(-0.25, joint.GetAngularOffset(), "runtime angular offset")
Assert.Equal(80.0, joint.GetMaxForce(), "runtime max force")
Assert.Equal(40.0, joint.GetMaxTorque(), "runtime max torque")
Assert.Equal(0.8, joint.GetCorrectionFactor(), "runtime correction factor")
# Upstream clamps rather than throwing for negative force and torque and
# for correction factors outside [0, 1].
joint.SetMaxForce(-5.0)
Assert.Equal(0.0, joint.GetMaxForce(), "negative max force clamps to zero")
joint.SetMaxTorque(-5.0)
Assert.Equal(0.0, joint.GetMaxTorque(), "negative max torque clamps to zero")
joint.SetCorrectionFactor(-1.0)
Assert.Equal(0.0, joint.GetCorrectionFactor(), "correction factor clamps at zero")
joint.SetCorrectionFactor(2.0)
Assert.Equal(1.0, joint.GetCorrectionFactor(), "correction factor clamps at one")
joint.SetCorrectionFactor(0.3)
joint.SetMaxForce(500.0)
joint.SetMaxTorque(200.0)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowMotorNonFiniteOffset)
joint.SetUserData(box)
Assert.True(joint.GetUserData() = box, "motor user data round trip")
# A sleeping body stays asleep across offset changes.
Stage9Tests.Steps(world, 120)
Assert.True(box.IsAwake() = False, "body asleep before retarget")
Var frozen As Transform = world.GetBodyTransform(box)
joint.SetLinearOffset(5.0, 4.0)
joint.SetAngularOffset(1.0)
Assert.True(box.IsAwake() = False, "retarget does not wake a sleeping body")
Stage9Tests.Steps(world, 30)
Var still As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(frozen.P.X, still.P.X, 0.001, 0.001, "sleeping body ignores the retarget")
PhysicsAssert.Near(frozen.P.Y, still.P.Y, 0.001, 0.001, "sleeping body ignores the retarget vertically")
box.SetAwake(True)
Stage9Tests.Steps(world, 240)
Var moved As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(5.0, moved.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "woken body chases the new pose")
PhysicsAssert.Near(3.0, moved.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, "woken body chases the new pose vertically")
PhysicsAssert.Near(1.0, Rot.GetAngle(moved.Q), 0.005, 0.005, "woken body chases the new angle")
Assert.True(box.IsAwake() = False, "body sleeps at the new pose")
world.Validate()
End Sub

## Recreates the three motor-joint scenes of the joint_motor golden fixture
## and compares final transforms, awake flags, and constraint forces against
## upstream Box2D 3.1.1 output generated from the pinned sources.
Public Sub TestMotorJointMatchesGoldenFixture()
Var lines() As String = PhysicsAssert.FixtureLines("joint_motor.txt")

Var poseWorld As World = Stage9Tests.MakeMouseWorld()
Var poseGround As Body = poseWorld.Bodies[0]
Var poseBody As Body = Stage9Tests.MakeDraggedBox(poseWorld, 3.0, 0.5)
Var poseJoint As MotorJoint = Stage9Tests.MakeMotorJoint(poseWorld, poseGround, poseBody, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)
Var retargetWorld As World = Stage9Tests.MakeMouseWorld()
Var retargetGround As Body = retargetWorld.Bodies[0]
Var retargetBody As Body = Stage9Tests.MakeDraggedBox(retargetWorld, 3.0, 0.5)
Var retargetJoint As MotorJoint = Stage9Tests.MakeMotorJoint(retargetWorld, retargetGround, retargetBody, 3.0, 1.5, 0.0, 2000.0, 800.0, 1.0)
Var clampedWorld As World = Stage9Tests.MakeMouseWorld()
Var clampedGround As Body = clampedWorld.Bodies[0]
Var clampedBody As Body = Stage9Tests.MakeDraggedBox(clampedWorld, 3.0, 0.5)
Var clampedJoint As MotorJoint = Stage9Tests.MakeMotorJoint(clampedWorld, clampedGround, clampedBody, 3.0, 2.0, 0.0, 3.0, 1.0, 1.0)

Var frameIndex As Integer = 0
While frameIndex < 240
Stage9Tests.StepMotorFrame(retargetWorld, retargetJoint, retargetBody, frameIndex)
If frameIndex < 239 Then
poseWorld.StepWorld(1.0 / 60.0)
clampedWorld.StepWorld(1.0 / 60.0)
End If
frameIndex = frameIndex + 1
Wend

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
If kind = "body" Then
Var values() As String = fields[4].Split(" ")
Var expectedX As Double = Double.Parse(values[0])
Var expectedY As Double = Double.Parse(values[1])
Var expectedAngle As Double = Double.Parse(values[2])
Var expectedAwake As Integer = Integer.Parse(values[3])
Var label As String = caseName + " body"
Var world As World = Nothing
Var body As Body = Nothing
If caseName = "pose" Then
world = poseWorld
body = poseBody
ElseIf caseName = "retarget" Then
world = retargetWorld
body = retargetBody
ElseIf caseName = "clamped" Then
world = clampedWorld
body = clampedBody
Else
Assert.Fail("unknown motor fixture body " + caseName)
End If
Var transform As Transform = world.GetBodyTransform(body)
PhysicsAssert.Near(expectedX, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " x")
PhysicsAssert.Near(expectedY, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " y")
PhysicsAssert.Near(expectedAngle, Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " angle")
If expectedAwake = 1 Then
Assert.True(body.IsAwake(), label + " awake")
Else
Assert.True(body.IsAwake() = False, label + " asleep")
End If
ElseIf kind = "motor" Then
Var jointValues() As String = fields[3].Split(" ")
Var joint As MotorJoint = Nothing
If caseName = "pose" Then
joint = poseJoint
ElseIf caseName = "retarget" Then
joint = retargetJoint
ElseIf caseName = "clamped" Then
joint = clampedJoint
Else
Assert.Fail("unknown motor fixture joint " + caseName)
End If
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " torque")
Else
Assert.Fail("unknown motor fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(6, checkedRecords)
poseWorld.Validate()
retargetWorld.Validate()
clampedWorld.Validate()
End Sub

## Steps one frame of a golden motor scene, applying the mid-scene
## retarget-and-wake at frame sixty.
Shared Sub StepMotorFrame(world As World, joint As MotorJoint, body As Body, frameIndex As Integer)
world.StepWorld(1.0 / 60.0)
If frameIndex = 60 Then
joint.SetLinearOffset(New Vector2(3.0, 3.0))
joint.SetAngularOffset(0.5)
body.SetAwake(True)
End If
End Sub

## Motor joint lifecycle: destruction, stale facades, slot reuse, and body
## destruction destroying the attached joint.
Public Sub TestMotorJointLifecycle()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Var joint As MotorJoint = Stage9Tests.MakeMotorJoint(world, ground, box, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)
Assert.Equal(1, world.JointCount, "one live motor joint")
Assert.Equal(1, ground.GetJointCount(), "ground holds the joint edge")
Assert.Equal(1, box.GetJointCount(), "box holds the joint edge")
Assert.True(joint.IsValid(), "facade valid after creation")
Var reusedId As Integer = joint.Id
Stage9Tests.Steps(world, 30)
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
Assert.Equal(0, ground.GetJointCount(), "ground unlinked")
Assert.Equal(0, box.GetJointCount(), "box unlinked")
Assert.True(box.IsAwake(), "destroy wakes the driven body")
Var replacement As MotorJoint = Stage9Tests.MakeMotorJoint(world, ground, box, 1.0, 2.0, 0.0, 500.0, 200.0, 0.3)
Assert.Equal(reusedId, replacement.Id, "slot reused")
Assert.False(joint.IsValid(), "stale facade stays invalid after slot reuse")
world.DestroyBody(box)
Assert.Equal(0, world.JointCount, "attached motor joint destroyed with the body")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Cross-world and missing motor joint bodies are rejected at creation.
Public Sub TestMotorJointRejectsCrossWorldBodies()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeDraggedBox(worldA, 3.0, 0.5)
Var bodyB As Body = Stage9Tests.MakeDraggedBox(worldB, 3.0, 0.5)
Var def As New MotorJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossMotorDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMotorJoint)
def.BodyB = Nothing
Me.mCrossMotorDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMotorJoint)
def.BodyA = Nothing
def.BodyB = bodyB
Me.mCrossMotorDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldMotorJoint)
worldA.Validate()
worldB.Validate()
End Sub

## A motor joint drags the body deterministically across repeated worlds.
Public Sub TestMotorJointDeterminism()
Var first As World = Stage9Tests.MakeMotorDriveWorld()
Var second As World = Stage9Tests.MakeMotorDriveWorld()
Stage9Tests.Steps(first, 240)
Stage9Tests.Steps(second, 240)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "motor drive repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## Builds a three-body drive scene with staggered offsets and tunings.
Shared Function MakeMotorDriveWorld() As World
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var boxA As Body = Stage9Tests.MakeDraggedBox(world, -1.0, 0.5)
Var boxB As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 0.5)
Var boxC As Body = Stage9Tests.MakeDraggedBox(world, 1.0, 0.5)
Stage9Tests.MakeMotorJoint(world, ground, boxA, -1.0, 3.0, 0.25, 500.0, 200.0, 0.3)
Stage9Tests.MakeMotorJoint(world, ground, boxB, 0.0, 3.0, 0.0, 1000.0, 400.0, 1.0)
Stage9Tests.MakeMotorJoint(world, ground, boxC, 1.0, 2.0, -0.5, 2000.0, 800.0, 0.5)
Return world
End Function

## After a warm-up that covers sleeping, waking, retargeting, and
## re-sleeping with a motor joint attached, further steps must allocate
## nothing. Gate for the Stage 9 zero-allocation requirement on the motor
## family, including the runtime offset-change path.
Public Sub TestWarmMotorJointAllocatesNothing()
Var world As World = Stage9Tests.MakeMouseWorld()
Var ground As Body = world.Bodies[0]
Var box As Body = Stage9Tests.MakeDraggedBox(world, 3.0, 0.5)
Var joint As MotorJoint = Stage9Tests.MakeMotorJoint(world, ground, box, 3.0, 2.0, 0.5, 500.0, 200.0, 0.3)

# Warm-up: settle, sleep, wake with a retarget, sleep again so every
# migration buffer and graph colour list is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
joint.SetLinearOffset(4.0, 3.0)
joint.SetAngularOffset(0.75)
box.SetAwake(True)
While warmIndex < 300
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after first retarget warm-up")
box.SetAwake(True)
While warmIndex < 420
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after warm-up")

# Measured window: wake the body, retarget mid-window, let it sleep. The
# scalar SetLinearOffset overload keeps the runtime tuning path
# allocation-free; the wake is explicit because offset changes do not wake
# a sleeping body.
Var before As Integer = System.AllocationCount
box.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 30 Then
joint.SetLinearOffset(5.0, 4.0)
box.SetAwake(True)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed motor joint stepping allocates nothing")
Assert.True(box.IsAwake() = False, "box asleep after measured window")
world.Validate()
End Sub

## A revolute hinge pins the box at the anchor point, holds its weight,
## and settles asleep after a kicked swing decays.
Public Sub TestRevoluteHingeHoldsAnchor()
Var world As World = Stage9Tests.MakeHingeWorld(5.0)
Var box As Body = world.Bodies[1]
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
Assert.Equal(JointType.RevoluteJoint, joint.GetJointType(), "revolute joint type")
PhysicsAssert.Near(0.0, joint.GetAngle(), 0.0, 0.0, "initial joint angle")
# Kick the box and let the swing decay.
Stage9Tests.Steps(world, 60)
box.SetAngularVelocity(1.0)
Stage9Tests.Steps(world, 180)
Var transform As Transform = world.GetBodyTransform(box)
Var anchor As Vector2 = transform.P
PhysicsAssert.Near(2.0, anchor.X, 0.002, 0.002, "hinge holds the anchor x")
PhysicsAssert.Near(-0.5, anchor.Y, 0.002, 0.002, "hinge holds the anchor y")
Assert.True(box.IsAwake() = False, "kicked hinge settles asleep")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force x")
PhysicsAssert.Near(2.5, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "settled force holds the 0.25 kg weight")
Assert.True(joint.IsSpringEnabled() = False, "spring disabled by default")
Assert.True(joint.IsLimitEnabled() = False, "limits disabled by default")
Assert.True(joint.IsMotorEnabled() = False, "motor disabled by default")
Assert.Equal(0.0, joint.GetMotorTorque(), "motor torque zero when disabled")
world.Validate()
End Sub

## A damped rotational spring drives the box toward the target angle and
## gravity sags the settled angle below the target.
Public Sub TestRevoluteSpringDrivesToTarget()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var box As Body = world.Bodies[1]
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
joint.EnableSpring(True)
joint.SetSpringHertz(2.0)
joint.SetSpringDampingRatio(0.6)
joint.SetTargetAngle(0.8)
Stage9Tests.Steps(world, 240)
Var angle As Double = joint.GetAngle()
PhysicsAssert.Near(0.590263, angle, 0.002, 0.002, "spring settles below the target under gravity sag")
Assert.True(box.IsAwake() = False, "spring-driven body falls asleep")
Assert.Equal(0.8, joint.GetTargetAngle(), "target angle round trip")
Assert.Equal(2.0, joint.GetSpringHertz(), "spring hertz round trip")
Assert.Equal(0.6, joint.GetSpringDampingRatio(), "spring damping round trip")
# Retarget with an explicit wake, matching the no-wake setter semantics.
joint.SetTargetAngle(0.0)
Assert.True(box.IsAwake() = False, "target change does not wake a sleeping body")
box.SetAwake(True)
Stage9Tests.Steps(world, 240)
PhysicsAssert.Near(0.0, joint.GetAngle(), 0.002, 0.002, "spring returns to the zero target")
Assert.True(box.IsAwake() = False, "body sleeps at the new target")
world.Validate()
End Sub

## A zero-speed motor acts as a torque-clamped brake, dissipating the kick
## and holding the box with a small residual torque.
Public Sub TestRevoluteMotorBrakeClampsTorque()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var box As Body = world.Bodies[1]
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
joint.EnableMotor(True)
joint.SetMaxMotorTorque(0.5)
Assert.True(joint.IsMotorEnabled(), "motor enabled")
Stage9Tests.Steps(world, 60)
box.SetAngularVelocity(1.0)
Stage9Tests.Steps(world, 180)
Assert.True(box.IsAwake() = False, "braked body falls asleep")
PhysicsAssert.Near(0.003622, joint.GetAngle(), 0.002, 0.002, "brake holds the box near the start angle")
Var torque As Double = joint.GetMotorTorque()
Assert.True(torque <= 0.5 + 0.01, "motor torque stays within the clamp")
PhysicsAssert.Near(0.002291, joint.GetConstraintTorque(), 0.0005, 0.0005, "constraint torque matches the residual motor torque")
# A motor spinning at constant speed tracks the requested speed.
joint.SetMaxMotorTorque(10.0)
joint.SetMotorSpeed(2.0)
box.SetAwake(True)
Stage9Tests.Steps(world, 60)
PhysicsAssert.Near(2.0, world.GetBodyAngularVelocity(box), 0.05, 0.05, "motor drives the box to the requested speed")
world.Validate()
End Sub

## Angle limits clamp the joint angle: the hanging equilibrium sits below
## the lower limit and the limit holds the box there against gravity.
Public Sub TestRevoluteLimitsHoldAtLowerLimit()
Var world As World = Stage9Tests.MakeHingeWorld(2.0)
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
joint.SetLimits(0.5, 0.9)
joint.EnableLimit(True)
Assert.True(joint.IsLimitEnabled(), "limits enabled")
Assert.Equal(0.5, joint.GetLowerLimit(), "lower limit round trip")
Assert.Equal(0.9, joint.GetUpperLimit(), "upper limit round trip")
Stage9Tests.Steps(world, 240)
PhysicsAssert.Near(0.5, joint.GetAngle(), 0.002, 0.002, "lower limit holds the box against gravity")
Assert.True(world.Bodies[1].IsAwake() = False, "limit-held body falls asleep")
PhysicsAssert.Near(0.2995, joint.GetConstraintTorque(), 0.001, 0.001, "limit torque balances the weight")
# Changing the limits clears the accumulated limit impulses; widening the
# range lets the box fall back to the hanging equilibrium.
joint.SetLimits(-0.9, 0.9)
Var box As Body = world.Bodies[1]
box.SetAwake(True)
Stage9Tests.Steps(world, 480)
PhysicsAssert.Near(0.0, joint.GetAngle(), 0.01, 0.01, "widened limits release the box to hang")
world.Validate()
End Sub

## Revolute joint setters round trip and reject invalid input; enabling
## and disabling clears the corresponding impulses.
Public Sub TestRevoluteRuntimeProperties()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
Me.mRevoluteThrowJoint = joint
joint.SetSpringHertz(3.0)
joint.SetSpringDampingRatio(0.8)
joint.SetTargetAngle(0.4)
joint.SetMotorSpeed(-1.5)
joint.SetMaxMotorTorque(25.0)
Assert.Equal(3.0, joint.GetSpringHertz(), "runtime hertz round trip")
Assert.Equal(0.8, joint.GetSpringDampingRatio(), "runtime damping round trip")
Assert.Equal(0.4, joint.GetTargetAngle(), "runtime target round trip")
Assert.Equal(-1.5, joint.GetMotorSpeed(), "runtime motor speed round trip")
Assert.Equal(25.0, joint.GetMaxMotorTorque(), "runtime max torque round trip")
joint.EnableSpring(True)
joint.EnableLimit(True)
joint.EnableMotor(True)
Assert.True(joint.IsSpringEnabled() And joint.IsLimitEnabled() And joint.IsMotorEnabled(), "all three toggles enabled")
joint.EnableSpring(False)
joint.EnableLimit(False)
joint.EnableMotor(False)
Assert.True(joint.IsSpringEnabled() = False And joint.IsLimitEnabled() = False And joint.IsMotorEnabled() = False, "all three toggles disabled")
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowRevoluteInvertedLimits)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowRevoluteWideLimits)
joint.SetUserData(world)
Assert.True(joint.GetUserData() = world, "revolute user data round trip")
world.Validate()
End Sub

## Recreates the four revolute-joint scenes of the joint_revolute golden
## fixture and compares final transforms, awake flags, constraint forces,
## torques, and joint angles against upstream Box2D 3.1.1 output generated
## from the pinned sources.
Public Sub TestRevoluteJointMatchesGoldenFixture()
Var lines() As String = PhysicsAssert.FixtureLines("joint_revolute.txt")

Var hingeWorld As World = Stage9Tests.MakeHingeWorld(5.0)
Var hingeJoint As RevoluteJoint = Stage9Tests.HingeJoint(hingeWorld)
Var springWorld As World = Stage9Tests.MakeHingeWorld(0.0)
Var springJoint As RevoluteJoint = Stage9Tests.HingeJoint(springWorld)
springJoint.EnableSpring(True)
springJoint.SetSpringHertz(2.0)
springJoint.SetSpringDampingRatio(0.6)
springJoint.SetTargetAngle(0.8)
Var brakeWorld As World = Stage9Tests.MakeHingeWorld(0.0)
Var brakeJoint As RevoluteJoint = Stage9Tests.HingeJoint(brakeWorld)
brakeJoint.EnableMotor(True)
brakeJoint.SetMaxMotorTorque(0.5)
Var limitsWorld As World = Stage9Tests.MakeHingeWorld(2.0)
Var limitsJoint As RevoluteJoint = Stage9Tests.HingeJoint(limitsWorld)
limitsJoint.SetLimits(0.5, 0.9)
limitsJoint.EnableLimit(True)

Var frameIndex As Integer = 0
While frameIndex < 240
hingeWorld.StepWorld(1.0 / 60.0)
brakeWorld.StepWorld(1.0 / 60.0)
springWorld.StepWorld(1.0 / 60.0)
limitsWorld.StepWorld(1.0 / 60.0)
If frameIndex = 60 Then
hingeWorld.Bodies[1].SetAngularVelocity(1.0)
brakeWorld.Bodies[1].SetAngularVelocity(1.0)
End If
frameIndex = frameIndex + 1
Wend

Var worlds() As World = [hingeWorld, springWorld, brakeWorld, limitsWorld]
Var joints() As RevoluteJoint = [hingeJoint, springJoint, brakeJoint, limitsJoint]
Var names() As String = ["hinge", "spring", "brake", "limits"]

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
Var sceneIndex As Integer = -1
Var nameIndex As Integer = 0
While nameIndex < 4
If names[nameIndex] = caseName Then
sceneIndex = nameIndex
End If
nameIndex = nameIndex + 1
Wend
If sceneIndex < 0 Then
Assert.Fail("unknown revolute fixture case " + caseName)
End If
Var world As World = worlds[sceneIndex]
Var joint As RevoluteJoint = joints[sceneIndex]
If kind = "body" Then
Var values() As String = fields[4].Split(" ")
Var transform As Transform = world.GetBodyTransform(world.Bodies[1])
PhysicsAssert.Near(Double.Parse(values[0]), transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body x")
PhysicsAssert.Near(Double.Parse(values[1]), transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body y")
PhysicsAssert.Near(Double.Parse(values[2]), Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body angle")
If Integer.Parse(values[3]) = 1 Then
Assert.True(world.Bodies[1].IsAwake(), caseName + " awake")
Else
Assert.True(world.Bodies[1].IsAwake() = False, caseName + " asleep")
End If
ElseIf kind = "revolute" Then
Var jointValues() As String = fields[3].Split(" ")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " torque")
PhysicsAssert.Near(Double.Parse(jointValues[3]), joint.GetAngle(), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " joint angle")
Else
Assert.Fail("unknown revolute fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(8, checkedRecords)
hingeWorld.Validate()
springWorld.Validate()
brakeWorld.Validate()
limitsWorld.Validate()
End Sub

## Revolute joint lifecycle: destruction, stale facades, slot reuse, body
## destruction destroying the attached joint, and collide-connected
## contact suppression.
Public Sub TestRevoluteJointLifecycle()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var ground As Body = world.Bodies[0]
Var box As Body = world.Bodies[1]
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
Assert.Equal(1, world.JointCount, "one live revolute joint")
Assert.True(joint.IsValid(), "facade valid after creation")
Var reusedId As Integer = joint.Id
Stage9Tests.Steps(world, 30)
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
Assert.Equal(0, ground.GetJointCount(), "ground unlinked")
Assert.Equal(0, box.GetJointCount(), "box unlinked")
Assert.True(box.IsAwake(), "destroy wakes the hinged body")
Var replacementDef As New RevoluteJointDefinition
replacementDef.BodyA = ground
replacementDef.BodyB = box
replacementDef.LocalAnchorA = New Vector2(1.0, -0.25)
replacementDef.LocalAnchorB = New Vector2(-1.0, 0.25)
Var replacement As RevoluteJoint = world.CreateRevoluteJoint(replacementDef)
Assert.Equal(reusedId, replacement.Id, "slot reused")
Assert.False(joint.IsValid(), "stale facade stays invalid after slot reuse")
world.DestroyBody(box)
Assert.Equal(0, world.JointCount, "attached revolute joint destroyed with the body")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Cross-world and missing revolute joint bodies are rejected at creation,
## and invalid definitions throw.
Public Sub TestRevoluteJointRejectsInvalidDefinitions()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeDraggedBox(worldA, 2.0, -0.5)
Var bodyB As Body = Stage9Tests.MakeDraggedBox(worldB, 2.0, -0.5)
Var def As New RevoluteJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossRevoluteDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldRevoluteJoint)
def.BodyB = Nothing
Me.mCrossRevoluteDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldRevoluteJoint)
worldA.Validate()
worldB.Validate()

Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var ground As Body = world.Bodies[0]
Var box As Body = world.Bodies[1]
Var badDef As New RevoluteJointDefinition
badDef.BodyA = ground
badDef.BodyB = box
Me.mBadRevoluteDef = badDef
badDef.LowerAngle = 0.6
badDef.UpperAngle = 0.2
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreateRevoluteJoint)
badDef.LowerAngle = -3.2
badDef.UpperAngle = 0.2
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreateRevoluteJoint)
badDef.LowerAngle = 0.2
badDef.UpperAngle = 3.2
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreateRevoluteJoint)
badDef.LowerAngle = 0.0
badDef.UpperAngle = 0.0
badDef.Hertz = -1.0
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreateRevoluteJoint)
world.Validate()
End Sub

## A hinge between two dynamic bodies converges and both bodies sleep.
Public Sub TestRevoluteJointBetweenDynamicBodies()
Var world As World = Stage9Tests.MakeMouseWorld()
Var carrierDef As New BodyDefinition
carrierDef.Type = BodyType.DynamicBody
carrierDef.Position = New Vector2(0.0, 0.5)
Var carrier As Body = world.CreateBody(carrierDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
carrier.CreatePolygon(shapeDef, Polygon.MakeBox(0.5, 0.5))
Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
boxDef.Position = New Vector2(1.5, 0.5)
boxDef.AngularDamping = 2.0
Var box As Body = world.CreateBody(boxDef)
box.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Var def As New RevoluteJointDefinition
def.BodyA = carrier
def.BodyB = box
def.LocalAnchorA = New Vector2(0.5, 0.0)
def.LocalAnchorB = New Vector2(-0.75, 0.0)
world.CreateRevoluteJoint(def)
Stage9Tests.Steps(world, 240)
Assert.True(carrier.IsAwake() = False, "carrier sleeps")
Assert.True(box.IsAwake() = False, "box sleeps")
world.Validate()
End Sub

## A hinge swings the box deterministically across repeated worlds.
Public Sub TestRevoluteJointDeterminism()
Var first As World = Stage9Tests.MakeHingeWorld(2.0)
Var second As World = Stage9Tests.MakeHingeWorld(2.0)
Stage9Tests.Steps(first, 60)
Stage9Tests.Steps(second, 60)
first.Bodies[1].SetAngularVelocity(1.0)
second.Bodies[1].SetAngularVelocity(1.0)
Stage9Tests.Steps(first, 180)
Stage9Tests.Steps(second, 180)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "revolute swing repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## After a warm-up that covers sleeping, waking, kicking, retargeting, and
## re-sleeping with a revolute joint attached, further steps must allocate
## nothing. Gate for the Stage 9 zero-allocation requirement on the
## revolute family, including the runtime tuning path.
Public Sub TestWarmRevoluteJointAllocatesNothing()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
Var box As Body = world.Bodies[1]
Var joint As RevoluteJoint = Stage9Tests.HingeJoint(world)
joint.EnableSpring(True)
joint.SetSpringHertz(2.0)
joint.SetSpringDampingRatio(0.6)

# Warm-up: settle, sleep, wake with a kick and a retarget, sleep again so
# every migration buffer and graph colour list is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
joint.SetTargetAngle(0.5)
box.SetAwake(True)
While warmIndex < 300
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after first retarget warm-up")
box.SetAwake(True)
While warmIndex < 420
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after warm-up")

# Measured window: wake the body, retarget mid-window, let it sleep. All
# setters below are scalar overloads, so the runtime tuning path stays
# allocation-free.
Var before As Integer = System.AllocationCount
box.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 30 Then
joint.SetTargetAngle(-0.4)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed revolute joint stepping allocates nothing")
Assert.True(box.IsAwake() = False, "box asleep after measured window")
world.Validate()
End Sub

## A slider holds the box on the rail: a kick along the axis slides the
## box at constant speed while the perpendicular constraint carries its
## weight, and the translation and speed queries track the motion.
Public Sub TestPrismaticSliderSlidesFreely()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
Assert.Equal(JointType.PrismaticJoint, joint.GetJointType(), "prismatic joint type")
Var axis As Vector2 = joint.GetLocalAxisA()
PhysicsAssert.Near(1.0, axis.X, 0.0, 0.0, "default axis x")
PhysicsAssert.Near(0.0, axis.Y, 0.0, 0.0, "default axis y")
Assert.Equal(0.0, joint.GetReferenceAngle(), "reference angle default")
Stage9Tests.Steps(world, 30)
world.SetBodyLinearVelocity(box, New Vector2(1.5, 0.0))
Stage9Tests.Steps(world, 30)
PhysicsAssert.Near(0.75, joint.GetTranslation(), 0.01, 0.01, "box slides along the axis")
PhysicsAssert.Near(1.5, joint.GetSpeed(), 0.02, 0.02, "speed query tracks the slide")
Var transform As Transform = world.GetBodyTransform(box)
PhysicsAssert.Near(-0.5, transform.P.Y, 0.002, 0.002, "perpendicular constraint holds the rail line")
PhysicsAssert.Near(0.0, Rot.GetAngle(transform.Q), 0.002, 0.002, "angular constraint holds the orientation")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "no axial force while coasting")
PhysicsAssert.Near(2.5, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "perpendicular force carries the weight")
world.Validate()
End Sub

## Translation limits stop the kicked box at the upper limit and hold it
## there.
Public Sub TestPrismaticLimitsStopAndHold()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
joint.SetLimits(-1.0, 1.0)
joint.EnableLimit(True)
Assert.True(joint.IsLimitEnabled(), "limits enabled")
Assert.Equal(-1.0, joint.GetLowerLimit(), "lower limit round trip")
Assert.Equal(1.0, joint.GetUpperLimit(), "upper limit round trip")
Stage9Tests.Steps(world, 30)
world.SetBodyLinearVelocity(box, New Vector2(1.5, 0.0))
Stage9Tests.Steps(world, 210)
PhysicsAssert.Near(1.0, joint.GetTranslation(), 0.002, 0.002, "upper limit stops the box")
PhysicsAssert.Near(0.0, joint.GetSpeed(), 0.001, 0.001, "box at rest at the limit")
Assert.True(box.IsAwake() = False, "limit-held box falls asleep")
world.Validate()
End Sub

## A tilted rail carries a gravity component, so the lower limit holds the
## box against part of its weight.
Public Sub TestPrismaticTiltedRailHoldsAgainstGravity()
Var world As World = Stage9Tests.MakeSliderWorld(True)
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
Var axis As Vector2 = joint.GetLocalAxisA()
PhysicsAssert.Near(0.7071067811865476, axis.X, 1e-9, 1e-9, "tilted axis x normalized")
PhysicsAssert.Near(0.7071067811865476, axis.Y, 1e-9, 1e-9, "tilted axis y normalized")
joint.SetLimits(-0.5, 0.5)
joint.EnableLimit(True)
Stage9Tests.Steps(world, 240)
PhysicsAssert.Near(-0.5, joint.GetTranslation(), 0.002, 0.002, "lower limit holds the box on the diagonal")
Assert.True(world.Bodies[1].IsAwake() = False, "tilted box falls asleep")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(0.0, force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "tilted force x")
PhysicsAssert.Near(2.5, force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, "tilted force balances the weight")
world.Validate()
End Sub

## A damped linear spring drives the box to the target translation; with
## gravity perpendicular to the axis the settled translation matches the
## target exactly.
Public Sub TestPrismaticSpringDrivesToTarget()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
joint.EnableSpring(True)
joint.SetSpringHertz(3.0)
joint.SetSpringDampingRatio(0.7)
joint.SetTargetTranslation(0.5)
Stage9Tests.Steps(world, 240)
PhysicsAssert.Near(0.5, joint.GetTranslation(), 0.002, 0.002, "spring settles at the target")
Assert.True(box.IsAwake() = False, "spring-driven box falls asleep")
# Retarget with an explicit wake, matching the no-wake setter semantics.
joint.SetTargetTranslation(-0.25)
Assert.True(box.IsAwake() = False, "target change does not wake a sleeping body")
box.SetAwake(True)
Stage9Tests.Steps(world, 240)
PhysicsAssert.Near(-0.25, joint.GetTranslation(), 0.002, 0.002, "spring drives to the new target")
Assert.True(box.IsAwake() = False, "box sleeps at the new target")
world.Validate()
End Sub

## A zero-speed motor acts as a force-clamped brake, and a non-zero speed
## drives the box at the requested speed with the force within the clamp.
Public Sub TestPrismaticMotorBrakeAndSpeedTracking()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
joint.EnableMotor(True)
joint.SetMaxMotorForce(5.0)
Assert.True(joint.IsMotorEnabled(), "motor enabled")
Stage9Tests.Steps(world, 30)
world.SetBodyLinearVelocity(box, New Vector2(1.5, 0.0))
Stage9Tests.Steps(world, 210)
Assert.True(box.IsAwake() = False, "braked box falls asleep")
PhysicsAssert.Near(0.053125, joint.GetTranslation(), 0.002, 0.002, "brake stops the box near the work-equivalent distance")
Assert.True(joint.GetMotorForce() <= 5.0 + 0.01, "motor force stays within the clamp")
# Track a constant speed against nothing but inertia.
joint.SetMotorSpeed(0.5)
box.SetAwake(True)
Stage9Tests.Steps(world, 120)
PhysicsAssert.Near(0.5, joint.GetSpeed(), 0.01, 0.01, "motor drives the box to the requested speed")
world.Validate()
End Sub

## Prismatic joint setters round trip and reject invalid input.
Public Sub TestPrismaticRuntimeProperties()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
Me.mPrismaticThrowJoint = joint
joint.SetSpringHertz(4.0)
joint.SetSpringDampingRatio(0.9)
joint.SetTargetTranslation(-0.75)
joint.SetMotorSpeed(2.0)
joint.SetMaxMotorForce(30.0)
Assert.Equal(4.0, joint.GetSpringHertz(), "runtime hertz round trip")
Assert.Equal(0.9, joint.GetSpringDampingRatio(), "runtime damping round trip")
Assert.Equal(-0.75, joint.GetTargetTranslation(), "runtime target round trip")
Assert.Equal(2.0, joint.GetMotorSpeed(), "runtime motor speed round trip")
Assert.Equal(30.0, joint.GetMaxMotorForce(), "runtime max force round trip")
joint.EnableSpring(True)
joint.EnableLimit(True)
joint.EnableMotor(True)
Assert.True(joint.IsSpringEnabled() And joint.IsLimitEnabled() And joint.IsMotorEnabled(), "all three toggles enabled")
joint.EnableSpring(False)
joint.EnableLimit(False)
joint.EnableMotor(False)
Assert.True(joint.IsSpringEnabled() = False And joint.IsLimitEnabled() = False And joint.IsMotorEnabled() = False, "all three toggles disabled")
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowPrismaticInvertedLimits)
joint.SetUserData(world)
Assert.True(joint.GetUserData() = world, "prismatic user data round trip")
world.Validate()
End Sub

## Recreates the four prismatic-joint scenes of the joint_prismatic golden
## fixture and compares final transforms, awake flags, constraint forces,
## torques, and translations against upstream Box2D 3.1.1 output generated
## from the pinned sources.

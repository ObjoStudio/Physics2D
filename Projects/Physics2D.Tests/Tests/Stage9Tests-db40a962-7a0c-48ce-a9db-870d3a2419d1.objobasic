brakeJoint.EnableMotor(True)
brakeJoint.SetMaxMotorForce(5.0)

Var frameIndex As Integer = 0
While frameIndex < 240
limitsWorld.StepWorld(1.0 / 60.0)
tiltedWorld.StepWorld(1.0 / 60.0)
springWorld.StepWorld(1.0 / 60.0)
brakeWorld.StepWorld(1.0 / 60.0)
If frameIndex = 30 Then
limitsWorld.Bodies[1].SetLinearVelocity(New Vector2(1.5, 0.0))
brakeWorld.Bodies[1].SetLinearVelocity(New Vector2(1.5, 0.0))
End If
frameIndex = frameIndex + 1
Wend

Var worlds() As World = [limitsWorld, tiltedWorld, springWorld, brakeWorld]
Var joints() As PrismaticJoint = [limitsJoint, tiltedJoint, springJoint, brakeJoint]
Var names() As String = ["limits", "tilted", "spring", "brake"]

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
Var sceneIndex As Integer = -1
Var nameIndex As Integer = 0
While nameIndex < 4
If names[nameIndex] = caseName Then
sceneIndex = nameIndex
End If
nameIndex = nameIndex + 1
Wend
If sceneIndex < 0 Then
Assert.Fail("unknown prismatic fixture case " + caseName)
End If
Var world As World = worlds[sceneIndex]
Var joint As PrismaticJoint = joints[sceneIndex]
If kind = "body" Then
Var values() As String = fields[4].Split(" ")
Var transform As Transform = world.GetBodyTransform(world.Bodies[1])
PhysicsAssert.Near(Double.Parse(values[0]), transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body x")
PhysicsAssert.Near(Double.Parse(values[1]), transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body y")
PhysicsAssert.Near(Double.Parse(values[2]), Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " body angle")
If Integer.Parse(values[3]) = 1 Then
Assert.True(world.Bodies[1].IsAwake(), caseName + " awake")
Else
Assert.True(world.Bodies[1].IsAwake() = False, caseName + " asleep")
End If
ElseIf kind = "prismatic" Then
Var jointValues() As String = fields[3].Split(" ")
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, caseName + " torque")
PhysicsAssert.Near(Double.Parse(jointValues[3]), joint.GetTranslation(), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, caseName + " translation")
Else
Assert.Fail("unknown prismatic fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(8, checkedRecords)
limitsWorld.Validate()
tiltedWorld.Validate()
springWorld.Validate()
brakeWorld.Validate()
End Sub

## Prismatic joint lifecycle: destruction, stale facades, slot reuse, and
## body destruction destroying the attached joint.
Public Sub TestPrismaticJointLifecycle()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var ground As Body = world.Bodies[0]
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
Assert.Equal(1, world.JointCount, "one live prismatic joint")
Assert.True(joint.IsValid(), "facade valid after creation")
Var reusedId As Integer = joint.Id
Stage9Tests.Steps(world, 30)
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
Assert.Equal(0, ground.GetJointCount(), "ground unlinked")
Assert.Equal(0, box.GetJointCount(), "box unlinked")
Assert.True(box.IsAwake(), "destroy wakes the sliding body")
Var replacementDef As New PrismaticJointDefinition
replacementDef.BodyA = ground
replacementDef.BodyB = box
replacementDef.LocalAnchorA = New Vector2(1.0, 0.5)
replacementDef.LocalAxisA = New Vector2(0.0, 1.0)
Var replacement As PrismaticJoint = world.CreatePrismaticJoint(replacementDef)
Assert.Equal(reusedId, replacement.Id, "slot reused")
Assert.False(joint.IsValid(), "stale facade stays invalid after slot reuse")
world.DestroyBody(box)
Assert.Equal(0, world.JointCount, "attached prismatic joint destroyed with the body")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Cross-world and missing prismatic joint bodies are rejected at creation,
## and invalid definitions throw.
Public Sub TestPrismaticJointRejectsInvalidDefinitions()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeDraggedBox(worldA, 0.0, -0.5)
Var bodyB As Body = Stage9Tests.MakeDraggedBox(worldB, 0.0, -0.5)
Var def As New PrismaticJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossPrismaticDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldPrismaticJoint)
def.BodyB = Nothing
Me.mCrossPrismaticDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldPrismaticJoint)
worldA.Validate()
worldB.Validate()

Var world As World = Stage9Tests.MakeSliderWorld(False)
Var ground As Body = world.Bodies[0]
Var box As Body = world.Bodies[1]
Var badDef As New PrismaticJointDefinition
badDef.BodyA = ground
badDef.BodyB = box
Me.mBadPrismaticDef = badDef
badDef.LowerTranslation = 0.6
badDef.UpperTranslation = 0.2
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreatePrismaticJoint)
badDef.LowerTranslation = 0.0
badDef.UpperTranslation = 0.0
badDef.Hertz = -1.0
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreatePrismaticJoint)
badDef.Hertz = 0.0
badDef.MaxMotorForce = -2.0
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCreatePrismaticJoint)
world.Validate()
End Sub

## A slider between two dynamic bodies converges and both bodies sleep.
Public Sub TestPrismaticJointBetweenDynamicBodies()
Var world As World = Stage9Tests.MakeMouseWorld()
Var carrierDef As New BodyDefinition
carrierDef.Type = BodyType.DynamicBody
carrierDef.Position = New Vector2(0.0, 0.5)
Var carrier As Body = world.CreateBody(carrierDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
carrier.CreatePolygon(shapeDef, Polygon.MakeBox(0.5, 0.5))
Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
boxDef.Position = New Vector2(1.5, 0.5)
Var box As Body = world.CreateBody(boxDef)
box.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Var def As New PrismaticJointDefinition
def.BodyA = carrier
def.BodyB = box
def.LocalAnchorA = New Vector2(0.5, 0.0)
def.LocalAnchorB = New Vector2(-0.75, 0.0)
def.LocalAxisA = New Vector2(1.0, 0.0)
def.EnableSpring = True
def.Hertz = 2.0
def.DampingRatio = 0.8
def.TargetTranslation = 0.25
world.CreatePrismaticJoint(def)
Stage9Tests.Steps(world, 300)
Assert.True(carrier.IsAwake() = False, "carrier sleeps")
Assert.True(box.IsAwake() = False, "box sleeps")
world.Validate()
End Sub

## A slider scene runs deterministically across repeated worlds.
Public Sub TestPrismaticJointDeterminism()
Var first As World = Stage9Tests.MakeSliderWorld(True)
Var second As World = Stage9Tests.MakeSliderWorld(True)
Stage9Tests.Steps(first, 240)
Stage9Tests.Steps(second, 240)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "prismatic scene repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## After a warm-up that covers sleeping, waking, kicking, retargeting, and
## re-sleeping with a prismatic joint attached, further steps must allocate
## nothing. Gate for the Stage 9 zero-allocation requirement on the
## prismatic family, including the runtime tuning path.
Public Sub TestWarmPrismaticJointAllocatesNothing()
Var world As World = Stage9Tests.MakeSliderWorld(False)
Var box As Body = world.Bodies[1]
Var joint As PrismaticJoint = Stage9Tests.SliderJoint(world)
joint.EnableSpring(True)
joint.SetSpringHertz(3.0)
joint.SetSpringDampingRatio(0.7)

# Warm-up: settle, sleep, wake with a kick and a retarget, sleep again so
# every migration buffer and graph colour list is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
joint.SetTargetTranslation(0.5)
box.SetAwake(True)
While warmIndex < 300
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after first retarget warm-up")
box.SetAwake(True)
While warmIndex < 420
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(box.IsAwake() = False, "box asleep after warm-up")

# Measured window: wake the body, retarget mid-window, let it sleep. All
# setters below are scalar overloads, so the runtime tuning path stays
# allocation-free.
Var before As Integer = System.AllocationCount
box.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 30 Then
joint.SetTargetTranslation(-0.4)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed prismatic joint stepping allocates nothing")
Assert.True(box.IsAwake() = False, "box asleep after measured window")
world.Validate()
End Sub

## A chain of distance joints swings and settles deterministically.
Public Sub TestJointChainDeterminism()
Var first As World = Stage9Tests.MakeJointChainWorld()
Var second As World = Stage9Tests.MakeJointChainWorld()
Stage9Tests.Steps(first, 240)
Stage9Tests.Steps(second, 240)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "joint chain repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## Builds a hanging two-link rope chain used by the determinism test.
Shared Function MakeJointChainWorld() As World
Var world As World = Stage9Tests.MakeWorld()
Var anchorDef As New BodyDefinition
anchorDef.Position = New Vector2(0.0, 6.0)
Var anchor As Body = world.CreateBody(anchorDef)
Var linkA As Body = Stage9Tests.MakeBox(world, 1.0, 6.0, 0.15, 0.15)
Var linkB As Body = Stage9Tests.MakeBox(world, 3.0, 6.0, 0.15, 0.15)
Var anchorDef2 As New DistanceJointDefinition
anchorDef2.BodyA = anchor
anchorDef2.BodyB = linkA
anchorDef2.Length = 1.0
world.CreateDistanceJoint(anchorDef2)
Var linkDef As New DistanceJointDefinition
linkDef.BodyA = linkA
linkDef.BodyB = linkB
linkDef.Length = 2.0
world.CreateDistanceJoint(linkDef)
Return world
End Function

## Builds a hanging chain of the given link count from a static anchor.
Shared Function MakeJointChainWorld(linkCount As Integer) As World
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var anchorDef As New BodyDefinition
anchorDef.Position = New Vector2(0.0, 10.0)
Var anchor As Body = world.CreateBody(anchorDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
Var previous As Body = anchor
Var def As New DistanceJointDefinition
Var linkIndex As Integer = 0
While linkIndex < linkCount
Var linkDef As New BodyDefinition
linkDef.Type = BodyType.DynamicBody
linkDef.Position = New Vector2(0.25 * (linkIndex + 1), 10.0)
Var link As Body = world.CreateBody(linkDef)
link.CreatePolygon(shapeDef, Polygon.MakeBox(0.15, 0.15))
def.BodyA = previous
def.BodyB = link
def.LocalAnchorA = New Vector2(0.25, 0.0)
def.LocalAnchorB = New Vector2(-0.25, 0.0)
def.Length = 0.5
world.CreateDistanceJoint(def)
previous = link
linkIndex = linkIndex + 1
Wend
world.UpdateBroadPhasePairs()
Return world
End Function

## Squared separation between two bodies' origins.
Shared Function SeparationSquared(world As World, bodyA As Body, bodyB As Body) As Double
Var pA As Vector2 = world.GetBodyTransform(bodyA).P
Var pB As Vector2 = world.GetBodyTransform(bodyB).P
Var dx As Double = pB.X - pA.X
Var dy As Double = pB.Y - pA.Y
Return dx * dx + dy * dy
End Function

## Throws a negative constraint hertz.
Private Sub ThrowNegativeHertz()
Me.mTuningJoint.SetConstraintHertz(-1.0)
End Sub

## Throws a negative damping ratio.
Private Sub ThrowNegativeDampingRatio()
Me.mTuningJoint.SetConstraintDampingRatio(-1.0)
End Sub

## Throws a negative length.
Private Sub ThrowNegativeLength()
Me.mTuningJoint.SetLength(-1.0)
End Sub

## Throws while creating a joint with a definition that mixes worlds.
Private Sub ThrowCrossWorldJoint()
Var world As World = Stage9Tests.MakeWorld()
world.CreateDistanceJoint(Me.mCrossWorldDef)
End Sub

## Throws a negative mouse spring hertz.
Private Sub ThrowMouseNegativeHertz()
Me.mMouseThrowJoint.SetSpringHertz(-1.0)
End Sub

## Throws a negative mouse spring damping ratio.
Private Sub ThrowMouseNegativeDamping()
Me.mMouseThrowJoint.SetSpringDampingRatio(-0.5)
End Sub

## Throws a negative mouse maximum force.
Private Sub ThrowMouseNegativeMaxForce()
Me.mMouseThrowJoint.SetMaxForce(-1.0)
End Sub

## Throws a non-finite mouse target.
Private Sub ThrowMouseNonFiniteTarget()
Me.mMouseThrowJoint.SetTarget(New Vector2(Double.Infinity, 0.0))
End Sub

## Throws while creating a mouse joint with a definition that mixes worlds.
Private Sub ThrowCrossWorldMouseJoint()
Var world As World = Stage9Tests.MakeMouseWorld()
world.CreateMouseJoint(Me.mCrossMouseDef)
End Sub

## Throws a non-finite motor offset.
Private Sub ThrowMotorNonFiniteOffset()
Me.mMotorThrowJoint.SetAngularOffset(Double.Infinity)
End Sub

## Throws while creating a motor joint with a definition that mixes worlds.
Private Sub ThrowCrossWorldMotorJoint()
Var world As World = Stage9Tests.MakeMouseWorld()
world.CreateMotorJoint(Me.mCrossMotorDef)
End Sub

## Throws an inverted revolute limit range.
Private Sub ThrowRevoluteInvertedLimits()
Me.mRevoluteThrowJoint.SetLimits(0.6, 0.2)
End Sub

## Throws revolute limits outside the upstream range.
Private Sub ThrowRevoluteWideLimits()
Me.mRevoluteThrowJoint.SetLimits(-3.2, 0.2)
End Sub

## Throws while creating a revolute joint with an invalid definition.
Private Sub ThrowCreateRevoluteJoint()
Var world As World = Stage9Tests.MakeHingeWorld(0.0)
world.CreateRevoluteJoint(Me.mBadRevoluteDef)
End Sub

## Throws while creating a revolute joint with a definition that mixes
## worlds.
Private Sub ThrowCrossWorldRevoluteJoint()
Var world As World = Stage9Tests.MakeMouseWorld()
world.CreateRevoluteJoint(Me.mCrossRevoluteDef)
End Sub

## Throws an inverted prismatic limit range.
Private Sub ThrowPrismaticInvertedLimits()
Me.mPrismaticThrowJoint.SetLimits(0.6, 0.2)
End Sub

## Throws while creating a prismatic joint with an invalid definition.
Private Sub ThrowCreatePrismaticJoint()
Var world As World = Stage9Tests.MakeSliderWorld(False)
world.CreatePrismaticJoint(Me.mBadPrismaticDef)
End Sub

## Throws while creating a prismatic joint with a definition that mixes
## worlds.
Private Sub ThrowCrossWorldPrismaticJoint()
Var world As World = Stage9Tests.MakeMouseWorld()
world.CreatePrismaticJoint(Me.mCrossPrismaticDef)
End Sub

## Throws an inverted length range.
Private Sub ThrowInvertedLengthRange()
Me.mTuningJoint.SetLengthRange(2.0, 1.0)
End Sub

## Folds every live body transform into a golden checksum.
Shared Function FoldWorld(world As World) As Integer
Var checksum As Integer = 0
For i As Integer = 0 To world.Bodies.Count - 1
Var body As Body = world.Bodies[i]
If body <> Nothing And body.Id <> PhysicsConstants.NULL_INDEX Then
Var transform As Transform = world.GetBodyTransform(body)
checksum = PhysicsAssert.FoldDouble(checksum, transform.P.X)
checksum = PhysicsAssert.FoldDouble(checksum, transform.P.Y)
checksum = PhysicsAssert.FoldDouble(checksum, transform.Q.C)
checksum = PhysicsAssert.FoldDouble(checksum, transform.Q.S)
End If
Next i
Return checksum
End Function

End Class

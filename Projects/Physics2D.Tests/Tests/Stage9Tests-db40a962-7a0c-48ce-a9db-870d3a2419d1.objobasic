springJoint.EnableSpring(True)
springJoint.SetSpringHertz(3.0)
springJoint.SetSpringDampingRatio(0.7)
springJoint.SetTargetTranslation(0.5)
Var brakeWorld As World = Stage9Tests.MakeSliderWorld(False)

# Stage 9 tests: distance joints, covering constraint satisfaction, spring,
# limits, motor, collide-connected toggling, joint placement across solver
# sets, destruction, validation, and determinism.
Import Physics2D

Class Stage9Tests Inherits TestCase

## Joint used by the tuning validation helpers.
Private Property mTuningJoint As DistanceJoint

## Definition reused by the cross-world throwers.
Private Property mCrossWorldDef As DistanceJointDefinition

## Builds a world with a wide static ground box whose top surface is y=0.
Shared Function MakeWorld() As World
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var groundDef As New BodyDefinition
groundDef.Position = New Vector2(0.0, -0.5)
Var ground As Body = world.CreateBody(groundDef)
ground.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(50.0, 0.5))
Return world
End Function

## Builds a dynamic box body with unit density.
Shared Function MakeBox(world As World, x As Double, y As Double, halfWidth As Double, halfHeight As Double) As Body
Var def As New BodyDefinition
def.Type = BodyType.DynamicBody
def.Position = New Vector2(x, y)
Var body As Body = world.CreateBody(def)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
body.CreatePolygon(shapeDef, Polygon.MakeBox(halfWidth, halfHeight))
Return body
End Function

## Steps the world at 60 Hz.
Shared Sub Steps(world As World, count As Integer)
Var i As Integer = 0
While i < count
world.StepWorld(1.0 / 60.0)
i = i + 1
Wend
End Sub

## Builds a rigid distance joint between two bodies at the given world
## separation along x, with anchors at the body centres.
Shared Function MakeRope(world As World, bodyA As Body, bodyB As Body, length As Double) As DistanceJoint
Var def As New DistanceJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
def.Length = length
Return world.CreateDistanceJoint(def)
End Function

## A rigid distance joint holds two hanging boxes at the rest length.
Public Sub TestRigidDistanceConstraintHoldsLength()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.Equal(2.0, joint.GetLength(), "rest length round trip")
Stage9Tests.Steps(world, 120)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(2.0, separation, 0.02, 0.02, "rigid distance holds rest length")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxA).X, 0.05, 0.05, "box A settles")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxB).X, 0.05, 0.05, "box B settles")
world.Validate()
End Sub

## A soft spring with damping restores the rest length after a disturbance.
Public Sub TestSpringRestoresRestLength()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 3.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.Hertz = 5.0
def.DampingRatio = 0.7
def.EnableSpring = True
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.True(joint.IsSpringEnabled(), "spring enabled round trip")
Assert.Equal(5.0, joint.GetSpringHertz(), "spring hertz round trip")
Assert.Equal(0.7, joint.GetSpringDampingRatio(), "damping ratio round trip")
Stage9Tests.Steps(world, 240)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(2.0, separation, 0.03, 0.03, "spring pulls bodies to rest length")
world.Validate()
End Sub

## Length limits clamp a motor-driven stretch.
Public Sub TestLimitsClampMotorStretch()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.EnableSpring = True
def.EnableLimit = True
def.MinLength = 1.0
def.MaxLength = 3.0
def.EnableMotor = True
def.MotorSpeed = 2.0
def.MaxMotorForce = 50.0
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.True(joint.IsLimitEnabled(), "limit enabled round trip")
Assert.Equal(1.0, joint.GetMinLength(), "min length round trip")
Assert.Equal(3.0, joint.GetMaxLength(), "max length round trip")
Stage9Tests.Steps(world, 240)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
Assert.True(separation <= 3.1, "separation stays under the upper limit")
Assert.True(separation >= 0.98, "separation stays over the lower limit")
Assert.True(joint.GetMotorForce() > 0.0, "motor reports positive force")
world.Validate()
End Sub

## A motor stretches a rigid rope at the requested speed until limits stop it.
Public Sub TestMotorDrivesSeparation()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -3.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 2.0
def.EnableSpring = True
def.EnableMotor = True
def.MotorSpeed = 1.0
def.MaxMotorForce = 10000.0
world.CreateDistanceJoint(def)
Stage9Tests.Steps(world, 60)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
PhysicsAssert.Near(3.0, separation, 0.2, 0.2, "motor stretches one metre per second")
world.Validate()
End Sub

## SetCollideConnected destroys and restores the contact between the bodies.
Public Sub TestCollideConnectedDestroysAndRestoresContact()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -0.15, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.15, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = boxA
def.BodyB = boxB
def.Length = 0.3
def.CollideConnected = False
Var joint As DistanceJoint = world.CreateDistanceJoint(def)
Stage9Tests.Steps(world, 10)
Assert.Equal(0, world.ContactCount, "overlapping joined bodies hold no contact")
joint.SetCollideConnected(True)
Stage9Tests.Steps(world, 10)
Assert.Equal(1, world.ContactCount, "collide connected restores the contact")
joint.SetCollideConnected(False)
Stage9Tests.Steps(world, 10)
Assert.Equal(0, world.ContactCount, "collide connected off destroys the contact again")
world.Validate()
End Sub

## Joint placement covers static-static, disabled, and awake graph cases.
Public Sub TestJointPlacementAcrossSolverSets()
Var world As World = Stage9Tests.MakeWorld()
Var staticOne As Body = world.CreateBody(New BodyDefinition)
Var staticTwo As Body = world.CreateBody(New BodyDefinition)
Var def As New DistanceJointDefinition
def.BodyA = staticOne
def.BodyB = staticTwo
def.Length = 1.0
Var staticJoint As DistanceJoint = world.CreateDistanceJoint(def)
Assert.Equal(PhysicsConstants.STATIC_SET, staticJoint.SetIndex, "static-static joint sits in the static set")

Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var awakeDef As New DistanceJointDefinition
awakeDef.BodyA = boxA
awakeDef.BodyB = boxB
awakeDef.Length = 2.0
Var awakeJoint As DistanceJoint = world.CreateDistanceJoint(awakeDef)
Assert.Equal(PhysicsConstants.AWAKE_SET, awakeJoint.SetIndex, "awake joint sits in the graph")
Assert.True(awakeJoint.ColorIndex >= 0 And awakeJoint.ColorIndex < PhysicsConstants.GRAPH_COLOUR_COUNT, "awake joint holds a graph colour")

boxA.Disable()
Var disabledDef As New DistanceJointDefinition
disabledDef.BodyA = boxA
disabledDef.BodyB = boxB
disabledDef.Length = 2.0
Var disabledJoint As DistanceJoint = world.CreateDistanceJoint(disabledDef)
Assert.Equal(PhysicsConstants.DISABLED_SET, disabledJoint.SetIndex, "joint with a disabled body sits in the disabled set")
Assert.Equal(3, world.JointCount, "three live joints")
world.Validate()
End Sub

## Destroying a joint unlinks both bodies and wakes the attached islands.
Public Sub TestDestroyJointUnlinksAndWakes()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.Equal(1, boxA.GetJointCount(), "body A holds one joint")
Assert.Equal(1, boxB.GetJointCount(), "body B holds one joint")
Assert.Equal(1, world.JointCount, "world holds one joint")
joint.Destroy()
Assert.False(joint.IsValid(), "stale facade invalid after destroy")
Assert.Equal(0, boxA.GetJointCount(), "body A unlinked after destroy")
Assert.Equal(0, boxB.GetJointCount(), "body B unlinked after destroy")
Assert.Equal(0, world.JointCount, "world empty after destroy")
boxB.SetLinearVelocity(New Vector2(2.0, 0.0))
Stage9Tests.Steps(world, 30)
Var separation As Double = Maths.Sqrt(Stage9Tests.SeparationSquared(world, boxA, boxB))
Assert.True(separation > 2.1, "bodies drift apart after the rope is destroyed")
world.Validate()
End Sub

## Destroying a body destroys its attached joints and keeps the partner.
Public Sub TestDestroyBodyDestroysAttachedJoints()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
world.DestroyBody(boxA)
Assert.Equal(0, world.JointCount, "attached joints destroyed with the body")
Assert.Equal(0, boxB.GetJointCount(), "surviving body holds no joints")
Stage9Tests.Steps(world, 10)
world.Validate()
End Sub

## Body.GetJoints returns every attached joint and survives slot reuse.
Public Sub TestGetJointsListsAllAttachments()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var boxC As Body = Stage9Tests.MakeBox(world, 3.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Stage9Tests.MakeRope(world, boxB, boxC, 2.0)
Assert.Equal(2, boxB.GetJointCount(), "middle body holds two joints")
Var joints As Array(Of Joint) = boxB.GetJoints()
Assert.Equal(2, joints.Count, "GetJoints returns both attachments")
Assert.Equal(2, world.JointCount, "world holds two joints")
Stage9Tests.Steps(world, 30)
world.Validate()
End Sub

## Destroyed joint slots are reused and stale facades stay invalid.
Public Sub TestSlotReuseAndGenerationGuard()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
joint.Destroy()
Var replacement As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Assert.True(replacement.IsValid(), "replacement facade is valid")
Assert.False(joint.IsValid(), "stale facade still invalid after slot reuse")
Assert.Equal(0, replacement.Id, "slot reused for the replacement")
Assert.Equal(1, world.JointCount, "world holds one live joint")
world.Validate()
End Sub

## Constraint tuning setters validate inputs and round trip through sims.
Public Sub TestConstraintTuningValidation()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Me.mTuningJoint = joint
joint.SetConstraintHertz(30.0)
joint.SetConstraintDampingRatio(0.5)
Assert.Equal(30.0, joint.GetConstraintHertz(), "constraint hertz round trip")
Assert.Equal(0.5, joint.GetConstraintDampingRatio(), "damping ratio round trip")
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowNegativeHertz)
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowNegativeDampingRatio)
joint.SetLength(-1.0)
Assert.Equal(PhysicsConstants.LINEAR_SLOP, joint.GetLength(), "negative length clamps to the slop")
joint.SetLengthRange(2.0, 1.0)
Assert.Equal(1.0, joint.GetMinLength(), "inverted range orders the lower bound first")
Assert.Equal(2.0, joint.GetMaxLength(), "inverted range orders the upper bound second")
joint.SetUserData(world)
Assert.True(joint.GetUserData() = world, "user data round trip")
joint.SetUserData(Nothing)
Assert.True(joint.GetUserData() = Nothing, "user data cleared")
world.Validate()
End Sub

## A joint must never connect bodies from two different worlds, and the
## definition bodies must be live. Regression for the repair-1 gate.
Public Sub TestCreateDistanceJointRejectsCrossWorldBodies()
Var worldA As New World
Var worldB As New World
Var bodyA As Body = Stage9Tests.MakeBox(worldA, -1.0, 5.0, 0.2, 0.2)
Var bodyB As Body = Stage9Tests.MakeBox(worldB, 1.0, 5.0, 0.2, 0.2)
Var def As New DistanceJointDefinition
def.BodyA = bodyA
def.BodyB = bodyB
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyB = Nothing
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyA = Nothing
def.BodyB = bodyB
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
def.BodyA = bodyA
def.BodyB = worldA.CreateBody(New BodyDefinition)
Me.mCrossWorldDef = def
Var joint As DistanceJoint = worldA.CreateDistanceJoint(def)
joint.Destroy()
worldA.DestroyBody(bodyA)
def.BodyA = bodyA
def.BodyB = Nothing
Me.mCrossWorldDef = def
Assert.Throws(TypeOf(New InvalidArgumentException("x")), AddressOf Me.ThrowCrossWorldJoint)
worldA.Validate()
worldB.Validate()
End Sub

## Two coincident bodies joined with a spring distance joint must receive
## no impulse while their separation stays degenerate, even though an
## unrelated horizontal rope joint is solved earlier in the same graph
## colour. The solver reuses one scratch record per step, so the axis must
## reset before the degenerate-separation branch. Regression for the
## repair-2 gate: a stale axis would push the pair apart along x.
Public Sub TestCoincidentAnchorsIgnoreStaleAxis()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -1.0, 5.0, 0.2, 0.2)
Var boxB As Body = Stage9Tests.MakeBox(world, 1.0, 5.0, 0.2, 0.2)
Stage9Tests.MakeRope(world, boxA, boxB, 2.0)
Var filter As New Filter
filter.GroupIndex = -2
Var shapeDefC As New ShapeDefinition
shapeDefC.Density = 1.0
shapeDefC.Filter = filter
Var shapeDefD As New ShapeDefinition
shapeDefD.Density = 1.0
shapeDefD.Filter = filter
Var coincidentDef As New BodyDefinition
coincidentDef.Type = BodyType.DynamicBody
coincidentDef.Position = New Vector2(5.0, 5.0)
Var boxC As Body = world.CreateBody(coincidentDef)
boxC.CreatePolygon(shapeDefC, Polygon.MakeBox(0.2, 0.2))
Var coincidentDefB As New BodyDefinition
coincidentDefB.Type = BodyType.DynamicBody
coincidentDefB.Position = New Vector2(5.0, 5.0)
Var boxD As Body = world.CreateBody(coincidentDefB)
boxD.CreatePolygon(shapeDefD, Polygon.MakeBox(0.2, 0.2))
Var springDef As New DistanceJointDefinition
springDef.BodyA = boxC
springDef.BodyB = boxD
springDef.Length = 2.0
springDef.EnableSpring = True
springDef.Hertz = 5.0
springDef.DampingRatio = 0.7
world.CreateDistanceJoint(springDef)
Var i As Integer = 0
While i < 10
world.StepWorld(1.0 / 60.0)
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxC).X, 0.000000001, 0.000000001, "coincident joint leaves body C x velocity untouched")
PhysicsAssert.Near(0.0, world.GetBodyLinearVelocity(boxD).X, 0.000000001, 0.000000001, "coincident joint leaves body D x velocity untouched")
PhysicsAssert.Near(5.0, world.GetBodyTransform(boxC).P.X, 0.000000001, 0.000000001, "body C x position untouched")
PhysicsAssert.Near(5.0, world.GetBodyTransform(boxD).P.X, 0.000000001, 0.000000001, "body D x position untouched")
i = i + 1
Wend
world.Validate()
End Sub

## Recreates the four deterministic distance-joint scenes of the
## joint_distance golden fixture and compares final transforms, awake
## flags, constraint forces, lengths, and motor forces against upstream
## Box2D 3.1.1 output generated from the pinned sources.
Public Sub TestDistanceJointMatchesGoldenFixture()
Var lines() As String = PhysicsAssert.FixtureLines("joint_distance.txt")

Var ropeWorld As World = Stage9Tests.MakeWorld()
Var ropeA As Body = Stage9Tests.MakeBox(ropeWorld, -1.0, 6.0, 0.25, 0.25)
Var ropeB As Body = Stage9Tests.MakeBox(ropeWorld, 1.0, 6.0, 0.25, 0.25)
Var ropeJoint As DistanceJoint = Stage9Tests.MakeRope(ropeWorld, ropeA, ropeB, 2.0)
Stage9Tests.Steps(ropeWorld, 90)

Var limitWorld As New World
limitWorld.Gravity = New Vector2(0.0, -10.0)
Var limitAnchorDef As New BodyDefinition
limitAnchorDef.Position = New Vector2(0.0, 8.0)
Var limitAnchor As Body = limitWorld.CreateBody(limitAnchorDef)
Var limitDef As New BodyDefinition
limitDef.Type = BodyType.DynamicBody
limitDef.Position = New Vector2(0.0, 6.5)
limitDef.LinearVelocity = New Vector2(0.0, -12.0)
Var limitBody As Body = limitWorld.CreateBody(limitDef)
limitBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var limitJointDef As New DistanceJointDefinition
limitJointDef.BodyA = limitAnchor
limitJointDef.BodyB = limitBody
limitJointDef.Length = 1.5
limitJointDef.EnableSpring = True
limitJointDef.Hertz = 5.0
limitJointDef.DampingRatio = 0.5
limitJointDef.EnableLimit = True
limitJointDef.MinLength = 0.5
limitJointDef.MaxLength = 1.5
Var limitJoint As DistanceJoint = limitWorld.CreateDistanceJoint(limitJointDef)
Stage9Tests.Steps(limitWorld, 120)

Var springWorld As New World
springWorld.Gravity = New Vector2(0.0, -10.0)
Var springAnchorDef As New BodyDefinition
springAnchorDef.Position = New Vector2(0.0, 8.0)
Var springAnchor As Body = springWorld.CreateBody(springAnchorDef)
Var springBodyDef As New BodyDefinition
springBodyDef.Type = BodyType.DynamicBody
springBodyDef.Position = New Vector2(0.0, 5.5)
Var springBody As Body = springWorld.CreateBody(springBodyDef)
springBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var springJointDef As New DistanceJointDefinition
springJointDef.BodyA = springAnchor
springJointDef.BodyB = springBody
springJointDef.Length = 2.0
springJointDef.EnableSpring = True
springJointDef.Hertz = 3.0
springJointDef.DampingRatio = 0.6
Var springJoint As DistanceJoint = springWorld.CreateDistanceJoint(springJointDef)
Stage9Tests.Steps(springWorld, 240)

Var motorWorld As New World
motorWorld.Gravity = New Vector2(0.0, -10.0)
Var motorAnchorDef As New BodyDefinition
motorAnchorDef.Position = New Vector2(0.0, 8.0)
Var motorAnchor As Body = motorWorld.CreateBody(motorAnchorDef)
Var motorBodyDef As New BodyDefinition
motorBodyDef.Type = BodyType.DynamicBody
motorBodyDef.Position = New Vector2(0.0, 7.0)
Var motorBody As Body = motorWorld.CreateBody(motorBodyDef)
motorBody.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.25, 0.25))
Var motorJointDef As New DistanceJointDefinition
motorJointDef.BodyA = motorAnchor
motorJointDef.BodyB = motorBody
motorJointDef.Length = 0.5
motorJointDef.EnableSpring = True
motorJointDef.Hertz = 20.0
motorJointDef.DampingRatio = 1.0
motorJointDef.EnableLimit = True
motorJointDef.MinLength = 0.5
motorJointDef.MaxLength = 5.0
motorJointDef.EnableMotor = True
motorJointDef.MotorSpeed = 2.0
motorJointDef.MaxMotorForce = 2000.0
Var motorJoint As DistanceJoint = motorWorld.CreateDistanceJoint(motorJointDef)
Stage9Tests.Steps(motorWorld, 240)

Var checkedRecords As Integer = 0
For Each line As String In lines
Var fields() As String = PhysicsAssert.Fields(line)
Var caseName As String = fields[1]
Var kind As String = fields[2]
If kind = "body" Then
Var bodyIndex As Integer = Integer.Parse(fields[3])
Var values() As String = fields[4].Split(" ")
Var expectedX As Double = Double.Parse(values[0])
Var expectedY As Double = Double.Parse(values[1])
Var expectedAngle As Double = Double.Parse(values[2])
Var expectedAwake As Integer = Integer.Parse(values[3])
Var label As String = caseName + " body " + bodyIndex.ToString()
Var world As World = Nothing
Var body As Body = Nothing
If caseName = "rope" And bodyIndex = 0 Then
world = ropeWorld
body = ropeA
ElseIf caseName = "rope" And bodyIndex = 1 Then
world = ropeWorld
body = ropeB
ElseIf caseName = "limit" Then
world = limitWorld
body = limitBody
ElseIf caseName = "spring" Then
world = springWorld
body = springBody
ElseIf caseName = "motor" Then
world = motorWorld
body = motorBody
Else
Assert.Fail("unknown joint fixture body " + caseName + " " + bodyIndex.ToString())
End If
Var transform As Transform = world.GetBodyTransform(body)
PhysicsAssert.Near(expectedX, transform.P.X, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " x")
PhysicsAssert.Near(expectedY, transform.P.Y, Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " y")
PhysicsAssert.Near(expectedAngle, Rot.GetAngle(transform.Q), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, label + " angle")
If expectedAwake = 1 Then
Assert.True(body.IsAwake(), label + " awake")
Else
Assert.True(body.IsAwake() = False, label + " asleep")
End If
ElseIf kind = "joint" Then
Var jointValues() As String = fields[3].Split(" ")
Var jointLabel As String = caseName + " joint"
Var jointWorld As World = Nothing
Var joint As DistanceJoint = Nothing
If caseName = "rope" Then
jointWorld = ropeWorld
joint = ropeJoint
ElseIf caseName = "limit" Then
jointWorld = limitWorld
joint = limitJoint
ElseIf caseName = "spring" Then
jointWorld = springWorld
joint = springJoint
ElseIf caseName = "motor" Then
jointWorld = motorWorld
joint = motorJoint
Else
Assert.Fail("unknown joint fixture joint " + caseName)
End If
Var force As Vector2 = joint.GetConstraintForce()
PhysicsAssert.Near(Double.Parse(jointValues[0]), force.X, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " force x")
PhysicsAssert.Near(Double.Parse(jointValues[1]), force.Y, Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " force y")
PhysicsAssert.Near(Double.Parse(jointValues[2]), joint.GetConstraintTorque(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " torque")
PhysicsAssert.Near(Double.Parse(jointValues[3]), joint.GetCurrentLength(), Tolerances.SCENE_ABS, Tolerances.SCENE_REL, jointLabel + " length")
PhysicsAssert.Near(Double.Parse(jointValues[4]), joint.GetMotorForce(), Tolerances.JOINT_FORCE_ABS, Tolerances.JOINT_FORCE_REL, jointLabel + " motor force")
Else
Assert.Fail("unknown joint fixture kind " + kind)
End If
checkedRecords = checkedRecords + 1
Next line
Assert.Equal(9, checkedRecords)
ropeWorld.Validate()
limitWorld.Validate()
springWorld.Validate()
motorWorld.Validate()
End Sub

## After a warm-up that covers falling, resting, sleeping, waking, and
## re-sleeping with joints attached, further steps that wake the island and
## let it sleep again must allocate nothing. Gate for the Stage 9
## zero-allocation requirement across the joint migration paths.
Public Sub TestWarmJointSleepWakeAllocatesNothing()
Var world As World = Stage9Tests.MakeWorld()
Var boxA As Body = Stage9Tests.MakeBox(world, -0.5, 5.0, 0.25, 0.25)
Var boxB As Body = Stage9Tests.MakeBox(world, 0.5, 5.0, 0.25, 0.25)
Var joint As DistanceJoint = Stage9Tests.MakeRope(world, boxA, boxB, 1.0)

# Warm-up: fall, land, sleep, then force a wake/sleep cycle so every
# migration buffer, graph colour list, and recycled solver set is sized.
Var warmIndex As Integer = 0
While warmIndex < 120
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
boxA.SetAwake(True)
While warmIndex < 240
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
boxB.SetAwake(True)
While warmIndex < 360
world.StepWorld(1.0 / 60.0)
warmIndex = warmIndex + 1
Wend
Assert.True(boxA.IsAwake() = False, "box A asleep after warm-up")
Assert.True(boxB.IsAwake() = False, "box B asleep after warm-up sleepTime=" + boxB.SleepTime.ToString() + " awake=" + boxB.IsAwake().ToString())

# Measured window: wake the joined island, let it sleep, wake again.
Var before As Integer = System.AllocationCount
boxA.SetAwake(True)
Var stepIndex As Integer = 0
While stepIndex < 90
world.StepWorld(1.0 / 60.0)
If stepIndex = 45 Then
boxB.SetAwake(True)
End If
stepIndex = stepIndex + 1
Wend
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed joint sleep and wake allocate nothing")
Assert.True(boxA.IsAwake() = False, "box A asleep after measured window")
Assert.True(boxB.IsAwake() = False, "box B asleep after measured window")
world.Validate()
End Sub

## A chain of distance joints swings and settles deterministically.
Public Sub TestJointChainDeterminism()
Var first As World = Stage9Tests.MakeJointChainWorld()
Var second As World = Stage9Tests.MakeJointChainWorld()
Stage9Tests.Steps(first, 240)
Stage9Tests.Steps(second, 240)
Var firstChecksum As Integer = Stage9Tests.FoldWorld(first)
Var secondChecksum As Integer = Stage9Tests.FoldWorld(second)
Assert.Equal(firstChecksum, secondChecksum, "joint chain repeats bit for bit")
first.Validate()
second.Validate()
End Sub

## Builds a hanging two-link rope chain used by the determinism test.
Shared Function MakeJointChainWorld() As World
Var world As World = Stage9Tests.MakeWorld()
Var anchorDef As New BodyDefinition
anchorDef.Position = New Vector2(0.0, 6.0)
Var anchor As Body = world.CreateBody(anchorDef)
Var linkA As Body = Stage9Tests.MakeBox(world, 1.0, 6.0, 0.15, 0.15)
Var linkB As Body = Stage9Tests.MakeBox(world, 3.0, 6.0, 0.15, 0.15)
Var anchorDef2 As New DistanceJointDefinition
anchorDef2.BodyA = anchor
anchorDef2.BodyB = linkA
anchorDef2.Length = 1.0
world.CreateDistanceJoint(anchorDef2)
Var linkDef As New DistanceJointDefinition
linkDef.BodyA = linkA
linkDef.BodyB = linkB
linkDef.Length = 2.0
world.CreateDistanceJoint(linkDef)
Return world
End Function

## Builds a hanging chain of the given link count from a static anchor.
Shared Function MakeJointChainWorld(linkCount As Integer) As World
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var anchorDef As New BodyDefinition
anchorDef.Position = New Vector2(0.0, 10.0)
Var anchor As Body = world.CreateBody(anchorDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
Var previous As Body = anchor
Var def As New DistanceJointDefinition
Var linkIndex As Integer = 0
While linkIndex < linkCount
Var linkDef As New BodyDefinition
linkDef.Type = BodyType.DynamicBody
linkDef.Position = New Vector2(0.25 * (linkIndex + 1), 10.0)
Var link As Body = world.CreateBody(linkDef)
link.CreatePolygon(shapeDef, Polygon.MakeBox(0.15, 0.15))
def.BodyA = previous
def.BodyB = link
def.LocalAnchorA = New Vector2(0.25, 0.0)
def.LocalAnchorB = New Vector2(-0.25, 0.0)
def.Length = 0.5
world.CreateDistanceJoint(def)
previous = link
linkIndex = linkIndex + 1
Wend
world.UpdateBroadPhasePairs()
Return world
End Function

## Squared separation between two bodies' origins.
Shared Function SeparationSquared(world As World, bodyA As Body, bodyB As Body) As Double
Var pA As Vector2 = world.GetBodyTransform(bodyA).P
Var pB As Vector2 = world.GetBodyTransform(bodyB).P
Var dx As Double = pB.X - pA.X
Var dy As Double = pB.Y - pA.Y
Return dx * dx + dy * dy
End Function

## Throws a negative constraint hertz.
Private Sub ThrowNegativeHertz()
Me.mTuningJoint.SetConstraintHertz(-1.0)
End Sub

## Throws a negative damping ratio.
Private Sub ThrowNegativeDampingRatio()
Me.mTuningJoint.SetConstraintDampingRatio(-1.0)
End Sub

## Throws a negative length.
Private Sub ThrowNegativeLength()
Me.mTuningJoint.SetLength(-1.0)
End Sub

## Throws while creating a joint with a definition that mixes worlds.
Private Sub ThrowCrossWorldJoint()
Var world As World = Stage9Tests.MakeWorld()
world.CreateDistanceJoint(Me.mCrossWorldDef)
End Sub

## Throws an inverted length range.
Private Sub ThrowInvertedLengthRange()
Me.mTuningJoint.SetLengthRange(2.0, 1.0)
End Sub

## Folds every live body transform into a golden checksum.
Shared Function FoldWorld(world As World) As Integer
Var checksum As Integer = 0
For i As Integer = 0 To world.Bodies.Count - 1
Var body As Body = world.Bodies[i]
If body <> Nothing And body.Id <> PhysicsConstants.NULL_INDEX Then
Var transform As Transform = world.GetBodyTransform(body)
checksum = PhysicsAssert.FoldDouble(checksum, transform.P.X)
checksum = PhysicsAssert.FoldDouble(checksum, transform.P.Y)
checksum = PhysicsAssert.FoldDouble(checksum, transform.Q.C)
checksum = PhysicsAssert.FoldDouble(checksum, transform.Q.S)
End If
Next i
Return checksum
End Function
End Class

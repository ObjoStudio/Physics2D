# Stage 10 tests: API reconciliation between the Stage 0 inventory and the
# implementation. Covers the static-tree rebuild entry and the body-level
# event enablers, the last unmapped inventory rows.
Import Physics2D

Class Stage10Tests Inherits TestCase

## Rebuilding the static tree after moving static geometry keeps queries,
## contacts, and validation consistent, ported from b2World_RebuildStaticTree.
Public Sub TestRebuildStaticTree()
Var world As New World
world.Gravity = New Vector2(0.0, -10.0)
Var platformDef As New BodyDefinition
platformDef.Position = New Vector2(6.0, 0.0)
Var platform As Body = world.CreateBody(platformDef)
platform.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(1.0, 0.5))
Var secondDef As New BodyDefinition
secondDef.Position = New Vector2(-6.0, 0.0)
Var second As Body = world.CreateBody(secondDef)
second.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(1.0, 0.5))

# A falling box lands on the platform.
Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
boxDef.Position = New Vector2(6.0, 4.0)
Var box As Body = world.CreateBody(boxDef)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
box.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Stage10Tests.Steps(world, 90)
PhysicsAssert.Near(0.75, world.GetBodyTransform(box).P.Y, 0.02, 0.02, "box rests on the platform")

# Move the platform away and rebuild the static tree. A sleeping box
# stays asleep exactly like upstream (moving static geometry does not
# wake touching bodies, verified against a pinned-source C probe); an
# explicitly woken box falls past the moved platform.
platform.SetTransform(New Vector2(20.0, 0.0), New Rot(1.0, 0.0))
world.RebuildStaticTree()
world.Validate()
Stage10Tests.Steps(world, 180)
Assert.True(box.IsAwake() = False, "sleeping box stays asleep like upstream")
PhysicsAssert.Near(0.75, world.GetBodyTransform(box).P.Y, 0.02, 0.02, "sleeping box keeps its rest pose")
box.SetAwake(True)
Stage10Tests.Steps(world, 180)
Assert.True(world.GetBodyTransform(box).P.Y < 0.0, "woken box falls past the moved platform")
# An overlap query at the new static position finds the moved platform.
Var bounds As New AABB(New Vector2(19.5, -0.5), New Vector2(20.5, 0.5))
Var hits As New ShapeHitList
world.OverlapBoundsInto(bounds, New QueryFilter, hits)
Assert.Equal(1, hits.Count, "query finds the moved static platform after the rebuild")
world.Validate()
End Sub

## Body-level event enablers write through to every attached shape, ported
## from b2Body_EnableContactEvents and b2Body_EnableHitEvents.
Public Sub TestBodyEventEnablers()
Var world As New World
Var bodyDef As New BodyDefinition
Var body As Body = world.CreateBody(bodyDef)
Assert.True(body.AreContactEventsEnabled() = False, "empty body reports no contact events")
Assert.True(body.AreHitEventsEnabled() = False, "empty body reports no hit events")
Var shapeDef As New ShapeDefinition
body.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
body.CreateCircle(shapeDef, New Circle(New Vector2(0.5, 0.0), 0.25))
Assert.True(body.AreContactEventsEnabled() = False, "event flags default off")
Assert.True(body.AreHitEventsEnabled() = False, "hit flags default off")
body.EnableContactEvents(True)
body.EnableHitEvents(True)
Assert.True(body.AreContactEventsEnabled(), "body-level contact enable writes through")
Assert.True(body.AreHitEventsEnabled(), "body-level hit enable writes through")
# Disabling one shape's flag makes the body-level getter false.
Var shapes As Array(Of Shape) = body.GetShapes()
shapes[0].EnableContactEvents = False
Assert.True(body.AreContactEventsEnabled() = False, "one disabled shape clears the body-level getter")
Assert.True(body.AreHitEventsEnabled(), "hit flags unaffected")
body.EnableContactEvents(True)
Assert.True(body.AreContactEventsEnabled(), "re-enabling restores the body-level getter")
world.Validate()
End Sub

## Builds a dynamic box for the explosion tests.
Shared Function MakeExplosionBox(world As World, x As Double, y As Double) As Body
Var def As New BodyDefinition
def.Type = BodyType.DynamicBody
def.Position = New Vector2(x, y)
Var body As Body = world.CreateBody(def)
Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
body.CreatePolygon(shapeDef, Polygon.MakeBox(0.25, 0.25))
Return body
End Function

## Steps the world at 60 Hz.
Shared Sub Steps(world As World, count As Integer)
Var i As Integer = 0
While i < count
world.StepWorld(1.0 / 60.0)
i = i + 1
Wend
End Sub

## CastMover sweeps a capsule through the world: the fraction shrinks at
## walls, overlapping starts are ignored (encroachment), and filters are
## honoured, ported from b2World_CastMover.
Public Sub TestCastMover()
Var world As World = Stage10Tests.MakeMoverWorld()
# A vertical capsule sweeping right hits the wall's left face at
# x = 2.5: the leading edge starts at 1.2, so the contact fraction is
# (2.5 - 1.2 - 0.2 radius start...) = 1.3 / 4 = 0.325.
Var mover As New Capsule(New Vector2(1.0, 1.0), New Vector2(1.0, 1.2), 0.2)
Var fraction As Double = world.CastMover(mover, New Vector2(4.0, 0.0), New QueryFilter)
PhysicsAssert.Near(0.325, fraction, 0.01, 0.01, "mover hits the wall face at the expected fraction")
# Sweeping left from the open side reaches the full translation.
fraction = world.CastMover(mover, New Vector2(-4.0, 0.0), New QueryFilter)
Assert.Equal(1.0, fraction, "open side reaches the full translation")
# A filter that rejects the wall also reaches the full translation.
Var filter As New QueryFilter
filter.CategoryBits = 2
filter.MaskBits = 4
fraction = world.CastMover(mover, New Vector2(4.0, 0.0), filter)
Assert.Equal(1.0, fraction, "rejected wall does not block the mover")
# Starting overlapped with the wall: encroachment ignores it.
Var overlapped As New Capsule(New Vector2(2.9, 1.0), New Vector2(2.9, 1.2), 0.2)
fraction = world.CastMover(overlapped, New Vector2(4.0, 0.0), New QueryFilter)
Assert.Equal(1.0, fraction, "overlapping shapes are ignored on start")
# Downward sweep onto the floor.
Var faller As New Capsule(New Vector2(1.0, 3.0), New Vector2(1.2, 3.0), 0.2)
fraction = world.CastMover(faller, New Vector2(0.0, -4.0), New QueryFilter)
# The capsule bottom starts at 2.8 of a 4 m sweep: contact at fraction 0.7
# plus the small encroachment allowance.
PhysicsAssert.Near(0.7, fraction, 0.02, 0.02, "mover lands on the floor")
world.Validate()
End Sub

## CollideMover registers one world-space collision plane per overlapping
## shape, ported from b2World_CollideMover.
Public Sub TestCollideMoverRegistersPlanes()
Var world As World = Stage10Tests.MakeMoverWorld()
Var callback As MoverPlaneRecorder = New MoverPlaneRecorder
# A mover slightly sunk into the floor registers an upward plane: the
# centre-line distance 0.15 against the 0.2 radius leaves a 0.05 plane
# offset.
Var mover As New Capsule(New Vector2(1.0, 0.15), New Vector2(1.4, 0.15), 0.2)
world.CollideMover(mover, New QueryFilter, callback)
Assert.Equal(1, callback.Shapes.Count, "floor registers one plane")
Var floor As Shape = callback.Shapes[0]
Var result As PlaneResult = callback.Results[0]
Assert.True(result.Hit, "floor plane hit")
PhysicsAssert.Near(0.0, result.Plane.Normal.X, 1e-9, 1e-9, "floor plane normal x")
PhysicsAssert.Near(1.0, result.Plane.Normal.Y, 1e-9, 1e-9, "floor plane normal y")
PhysicsAssert.Near(0.05, result.Plane.Offset, 0.01, 0.01, "floor plane offset from the sink depth")
Assert.True(callback.KeepGoing, "callback continued the traversal")
# A mover pressed against the wall registers its leftward plane: the
# centre line ends at x = 2.35, leaving a 0.15 centre-line distance
# against the 0.2 radius.
Var recorder As MoverPlaneRecorder = New MoverPlaneRecorder
Var corridor As New Capsule(New Vector2(2.15, 1.0), New Vector2(2.35, 1.0), 0.2)
world.CollideMover(corridor, New QueryFilter, recorder)
Assert.Equal(1, recorder.Shapes.Count, "wall registers one plane")
Assert.True(recorder.Results[0].Plane.Normal.X < 0.0, "wall plane pushes left")
world.Validate()
End Sub

## The collision callback can stop the traversal early.
Public Sub TestCollideMoverCallbackStops()
Var world As World = Stage10Tests.MakeMoverWorld()
Var callback As MoverPlaneRecorder = New MoverPlaneRecorder
callback.StopAfterFirst = True
Var mover As New Capsule(New Vector2(1.0, 0.15), New Vector2(1.4, 0.15), 0.2)
world.CollideMover(mover, New QueryFilter, callback)
Assert.True(callback.KeepGoing = False, "callback stopped the traversal")
Assert.Equal(1, callback.Shapes.Count, "only the first plane is reported")
world.Validate()
End Sub

## Builds the mover test world: a floor and a vertical wall at x = 3.
Shared Function MakeMoverWorld() As World
Var world As New World
Var groundDef As New BodyDefinition
Var ground As Body = world.CreateBody(groundDef)
ground.CreateSegment(New ShapeDefinition, New Segment(-20.0, 0.0, 20.0, 0.0))
Var wallDef As New BodyDefinition
wallDef.Position = New Vector2(3.0, 2.0)
Var wall As Body = world.CreateBody(wallDef)
wall.CreatePolygon(New ShapeDefinition, Polygon.MakeBox(0.5, 2.0))
world.UpdateBroadPhasePairs()
Return world
End Function
## An explosion pushes boxes away from the centre with the facing-perimeter
## impulse, scaled by the falloff, and skips shapes out of range, ported
## from b2World_Explode. The expected velocities were recorded from the
## pinned upstream source.
Public Sub TestExplosionAppliesImpulses()
Var world As New World
Var boxA As Body = Stage10Tests.MakeExplosionBox(world, 0.8, 0.3)
Var boxB As Body = Stage10Tests.MakeExplosionBox(world, 2.0, 0.3)
Var boxC As Body = Stage10Tests.MakeExplosionBox(world, 5.0, 0.3)
Var def As New ExplosionDefinition
def.Position = New Vector2(0.0, 0.0)
def.Radius = 1.0
def.Falloff = 2.0
def.ImpulsePerLength = 2.0
boxC.SetAwake(False)
world.Explode(def)
Var velocityA As Vector2 = world.GetBodyLinearVelocity(boxA)
Var velocityB As Vector2 = world.GetBodyLinearVelocity(boxB)
Var velocityC As Vector2 = world.GetBodyLinearVelocity(boxC)
PhysicsAssert.Near(4.327869, velocityA.X, 0.01, 0.01, "inner box push x")
PhysicsAssert.Near(0.393443, velocityA.Y, 0.01, 0.01, "inner box push y")
PhysicsAssert.Near(2.567863, velocityB.X, 0.01, 0.01, "falloff box push x")
PhysicsAssert.Near(0.073368, velocityB.Y, 0.01, 0.01, "falloff box push y")
PhysicsAssert.Near(0.0, velocityC.X, 1e-9, 1e-9, "out-of-range box untouched x")
PhysicsAssert.Near(0.0, velocityC.Y, 1e-9, 1e-9, "out-of-range box untouched y")
Assert.True(boxA.IsAwake(), "explosion wakes the inner box")
Assert.True(boxC.IsAwake() = False, "out-of-range box stays asleep")
world.Validate()
# A negative impulse per length implodes: the blast centre sits 0.95 m
# from box C's near face, inside the 1.0 m radius.
Var implodeDef As New ExplosionDefinition
implodeDef.Position = New Vector2(3.8, 0.3)
implodeDef.Radius = 1.0
implodeDef.Falloff = 0.5
implodeDef.ImpulsePerLength = -2.0
world.Explode(implodeDef)
Var pullX As Double = world.GetBodyLinearVelocity(boxC).X
Assert.True(pullX < 0.0, "negative impulse pulls the box toward the centre")
world.Validate()
End Sub
## World counters reflect the live scene, ported from b2World_GetCounters.
Public Sub TestCounters()
Var world As World = Stage10Tests.MakeMoverWorld()
Var boxA As Body = Stage9Tests.MakeDraggedBox(world, -0.6, 6.0)
Var boxB As Body = Stage9Tests.MakeDraggedBox(world, 0.6, 6.0)
Var def As New RevoluteJointDefinition
def.BodyA = boxA
def.BodyB = boxB
world.CreateRevoluteJoint(def)
# While the scene is awake the colour counts cover the live constraint
# rows.
Stage10Tests.Steps(world, 30)
Var counters As WorldCounters = world.Counters()
# Two ground shapes (segment and polygon) plus two boxes.
Assert.Equal(4, counters.BodyCount, "body count")
Assert.Equal(4, counters.ShapeCount, "shape count")
Assert.Equal(1, counters.JointCount, "joint count")
Assert.True(counters.IslandCount >= 1, "islands exist")
Assert.True(counters.StaticTreeHeight >= 1, "static tree has height")
Assert.True(counters.TreeHeight >= 1, "dynamic tree has height")
Var colourSum As Integer = 0
Var i As Integer = 0
While i < 12
colourSum = colourSum + counters.ColorCounts[i]
i = i + 1
Wend
Assert.True(colourSum >= counters.JointCount, "colour counts cover the awake joint rows")
# After the scene sleeps the constraint rows leave the graph colours and
# move into the sleeping solver set, so the colour sum drops to zero
# while the live joint count stays.
Stage10Tests.Steps(world, 150)
counters = world.Counters()
Assert.Equal(1, counters.JointCount, "sleeping joint stays live")
Assert.True(counters.ContactCount >= 1, "resting boxes hold ground contacts")
colourSum = 0
i = 0
While i < 12
colourSum = colourSum + counters.ColorCounts[i]
i = i + 1
Wend
Assert.Equal(0, colourSum, "sleeping scene empties the graph colours")
world.Validate()
End Sub

## The step profile reports positive stage times, ported from
## b2World_GetProfile at Physics2D's stage granularity.
Public Sub TestStepProfile()
Var world As World = Stage10Tests.MakeMoverWorld()
Var box As Body = Stage9Tests.MakeDraggedBox(world, 0.0, 5.0)
Stage10Tests.Steps(world, 60)
Var profile As WorldProfile = world.Profile()
Assert.True(profile.StepMs >= 0.0, "step time recorded")
Assert.True(profile.PairsMs >= 0.0, "pairs time recorded")
Assert.True(profile.CollideMs >= 0.0, "collide time recorded")
Assert.True(profile.SolveMs >= 0.0, "solve time recorded")
Assert.True(profile.SensorsMs >= 0.0, "sensors time recorded")
# Coarse clocks can report exact zeros for fast stages, so only bound
# the totals after a heavy step.
Stage10Tests.Steps(world, 240)
profile = world.Profile()
Assert.True(profile.StepMs > 0.0, "stepped world records a positive step time")
world.Validate()
End Sub
End Class

# Records mover collision planes for the Stage 10 tests. StopAfterFirst
# makes VisitPlane return False after the first plane.
Class MoverPlaneRecorder Inherits WorldMoverPlaneCallback
## The shapes whose planes were reported.
Property Shapes As Array(Of Shape)

## The plane results in report order.
Property Results As Array(Of PlaneResult)

## True while the traversal should continue.
Property KeepGoing As Boolean

## When True, the first reported plane stops the traversal.
Property StopAfterFirst As Boolean

## Creates an empty recorder.
Constructor()
Me.Shapes = New Array(Of Shape)
Me.Results = New Array(Of PlaneResult)
Me.KeepGoing = True
Me.StopAfterFirst = False
End Constructor

## Records the plane and honours the stop switch.
Override Function VisitPlane(shape As Shape, result As PlaneResult) As Boolean
Me.Shapes.Append(shape)
Me.Results.Append(result)
If Me.StopAfterFirst Then
Me.KeepGoing = False
Return False
End If
Return True
End Function
End Class

# The pyramid and stack scene: sleeping, wake-up, and stability. A ten
# level pyramid rests asleep until a heavy ball lands on it, teaching how
# islands wake and re-sleep.
Class PyramidScene Inherits DemoScene
## Time until the wrecking ball drops.
Property DropCountdown As Double

## The wrecking ball body.
Property Ball As Body

## Creates the pyramid scene.
Constructor()
Super.Constructor("Pyramid and stack", "A sleeping pyramid holds until the ball lands. Watch islands wake, settle, and re-sleep.")
Me.DropCountdown = 2.0
End Constructor

## Builds the pyramid and the suspended ball. Levels stack toward
## negative Y, which is up on screen under the positive-Y convention.
Override Sub Build(world As World)
Var groundDef As New BodyDefinition
Var ground As Body = world.CreateBody(groundDef)
ground.CreateSegment(New ShapeDefinition, New Segment(-16.0, 0.0, 16.0, 0.0))

Var shapeDef As New ShapeDefinition
shapeDef.Density = 1.0
shapeDef.Material.Friction = 0.6

Var boxDef As New BodyDefinition
boxDef.Type = BodyType.DynamicBody
Var halfWidth As Double = 0.5
Var levels As Integer = 10
For level As Integer = 0 To levels - 1
Var count As Integer = levels - level
Var y As Double = -(halfWidth + level * (2.0 * halfWidth + 0.02))
For i As Integer = 0 To count - 1
Var x As Double = (i - (count - 1) * 0.5) * (2.0 * halfWidth + 0.04)
boxDef.Position = New Vector2(x, y)
Var box As Body = world.CreateBody(boxDef)
box.CreatePolygon(shapeDef, Polygon.MakeBox(halfWidth, halfWidth))
Next i
Next level

# The wrecking ball hangs off to the side until the countdown ends.
boxDef.Position = New Vector2(2.0, -14.0)
boxDef.LinearDamping = 0.05
Me.Ball = world.CreateBody(boxDef)
Var heavy As New ShapeDefinition
heavy.Density = 8.0
heavy.Material.Restitution = 0.05
Me.Ball.CreateCircle(heavy, New Circle(New Vector2(0.0, 0.0), 0.8))
Me.Ball.SetAwake(False)
world.Validate()
End Sub

## Drops the ball after the countdown.
Override Sub Update(world As World, elapsed As Double)
Pragma Unused world
If Me.DropCountdown > 0.0 Then
Me.DropCountdown = Me.DropCountdown - elapsed
If Me.DropCountdown <= 0.0 And Me.Ball <> Nothing Then
Me.Ball.SetAwake(True)
End If
End If
End Sub
End Class

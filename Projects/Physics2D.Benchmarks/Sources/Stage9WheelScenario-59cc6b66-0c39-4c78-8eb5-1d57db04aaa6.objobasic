# Stage 9 benchmark scenario wrapping the wheel drive workload.
Import Physics2D

Class Stage9WheelScenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As WheelDriveWorkload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage9-wheel-drive-30"
Me.Description = "Drives 30 motorized cars with suspension springs through the full Stage 9 solver four times per iteration."
Me.WarmupIterations = 3
Me.MeasuredIterations = 8
Me.mWorkload = New WheelDriveWorkload
End Constructor

## Describes the drive parameters.
Override Function Parameters() As String
Return "cars=30,joints=30,bodies=60,steps=4,hz=60"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured iteration.
Override Sub Run()
Me.mWorkload.RunKernels()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.Checksum()
End Function
End Class

# Stage 4 geometry benchmark scenarios.
#
# Thin BenchmarkScenario wrappers around the geometry workloads. Every
# scenario runs five unmeasured warm-up iterations and twenty measured
# iterations; identical folded checksums across runs prove the workload did
# not shrink, and the reported allocation count must stay at zero after
# warm-up.
Class Stage4DistanceScenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As DistanceWorkload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage4-distance"
Me.Description = "GJK shape distance: box versus capsule proxy over 12 offsets with reused output."
Me.WarmupIterations = 5
Me.MeasuredIterations = 20
Me.mWorkload = New DistanceWorkload
End Constructor

## Describes the distance parameters.
Override Function Parameters() As String
Return "queries=12,proxyA=4pts,proxyB=2pts,radii=0.05"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured iteration.
Override Sub Run()
Me.mWorkload.Execute()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.FoldedChecksum()
End Function
End Class


# Stage 12 benchmark scenarios wrapping the optimisation-audit workloads.
#
# The long-horizon pyramid uses zero warm-up and two measured iterations
# because one iteration alone runs 256 simulated frames; everything else
# follows the standard three warm-up and four-to-eight measured pattern.
Import Physics2D

Class Stage12Pyramid256Scenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As Pyramid256Workload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage12-pyramid-256"
Me.Description = "Steps a 40-level box pyramid (820 bodies) for 256 frames per iteration at one substep; the long-horizon required scenario."
Me.WarmupIterations = 0
Me.MeasuredIterations = 2
Me.mWorkload = New Pyramid256Workload
End Constructor

## Describes the pyramid parameters.
Override Function Parameters() As String
Return "levels=40,boxes=820,steps=256,hz=60"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured iteration.
Override Sub Run()
Me.mWorkload.RunKernels()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.Checksum()
End Function
End Class


# Per-stage profiler for the optimisation audit.
#
# Runs a fixed number of steps per workload after a short warm-up and prints
# accumulated World.Profile() stage times, mean milliseconds per step, final
# world counters, and the allocation count over the profiled steps. This is
# a diagnostic mode (the scenarios never read the clock); it only reads the
# public Profile and Counters records.
Class Stage12Profiler
## Warms up one prepared workload, then profiles its steps and prints one
## report row.
Shared Sub ProfileWorld(name As String, world As World, subSteps As Integer, warmupSteps As Integer, profiledSteps As Integer)
Var warmup As Integer = 0
While warmup < warmupSteps
world.StepWorld(1.0 / 60.0, subSteps)
warmup = warmup + 1
Wend

Var pairs As Double = 0.0
Var collide As Double = 0.0
Var solve As Double = 0.0
Var sensors As Double = 0.0
Var total As Double = 0.0
Var allocations As Integer = System.AllocationCount
Var stepIndex As Integer = 0
While stepIndex < profiledSteps
world.StepWorld(1.0 / 60.0, subSteps)
Var profile As WorldProfile = world.Profile()
pairs = pairs + profile.PairsMs
collide = collide + profile.CollideMs
solve = solve + profile.SolveMs
sensors = sensors + profile.SensorsMs
total = total + profile.StepMs
stepIndex = stepIndex + 1
Wend
allocations = System.AllocationCount - allocations

Var meanStep As Double = total / profiledSteps.ToDouble()
Var meanPairs As Double = pairs / profiledSteps.ToDouble()
Var meanCollide As Double = collide / profiledSteps.ToDouble()
Var meanSolve As Double = solve / profiledSteps.ToDouble()
Var meanSensors As Double = sensors / profiledSteps.ToDouble()
Var counters As WorldCounters = world.Counters()

Print(name + " steps=" + profiledSteps.ToString() + " substeps=" + subSteps.ToString() + " ms/step=" + Maths.Round(meanStep, 2).ToString())
Print("  pairs " + Maths.Round(meanPairs, 2).ToString() + "ms (" + Integer(Maths.Round(100.0 * meanPairs / meanStep)).ToString() + "%)  collide " + Maths.Round(meanCollide, 2).ToString() + "ms (" + Integer(Maths.Round(100.0 * meanCollide / meanStep)).ToString() + "%)  solve " + Maths.Round(meanSolve, 2).ToString() + "ms (" + Integer(Maths.Round(100.0 * meanSolve / meanStep)).ToString() + "%)  sensors " + Maths.Round(meanSensors, 2).ToString() + "ms (" + Integer(Maths.Round(100.0 * meanSensors / meanStep)).ToString() + "%)")
Print("  bodies=" + counters.BodyCount.ToString() + " shapes=" + counters.ShapeCount.ToString() + " contacts=" + counters.ContactCount.ToString() + " joints=" + counters.JointCount.ToString() + " islands=" + counters.IslandCount.ToString() + " treeH=" + counters.TreeHeight.ToString() + " staticH=" + counters.StaticTreeHeight.ToString() + " profile-allocs=" + allocations.ToString())
End Sub

## Profiles every step workload with representative parameters.
Shared Sub RunAll(profiledSteps As Integer)
Print("stage12 profile: " + profiledSteps.ToString() + " profiled steps per workload after 5 warm-up steps")

Var pyramid As New Pyramid256Workload
pyramid.Prepare()
ProfileWorld("pyramid-40 (1 substep)", pyramid.World, pyramid.SubSteps, 5, profiledSteps)

Var sleepWake As New SleepWakeStacksWorkload
sleepWake.Prepare()
sleepWake.WakeAll()
ProfileWorld("sleep-wake-600 awake (1 substep)", sleepWake.World, sleepWake.SubSteps, 5, profiledSteps)

Var tumbler As New TumblerWorkload
tumbler.Prepare()
# Populate the box supply so the profiled steps carry the real workload.
tumbler.RunKernels()
tumbler.RunKernels()
ProfileWorld("tumbler (1 substep)", tumbler.World, tumbler.SubSteps, 5, profiledSteps)

Var dense As New DenseContactsWorkload
dense.Prepare()
dense.WakeAll()
ProfileWorld("dense-contacts-240 awake (1 substep)", dense.World, dense.SubSteps, 5, profiledSteps)

Var bullets As New BulletCcdWorkload
bullets.Prepare()
# Let the bullet stream reach the wall so the profiled steps carry CCD load.
bullets.RunKernels()
bullets.RunKernels()
ProfileWorld("bullet-ccd-24 (1 substep)", bullets.World, bullets.SubSteps, 5, profiledSteps)

Var sensors As New SensorFieldWorkload
sensors.Prepare()
ProfileWorld("sensor-field (1 substep)", sensors.World, sensors.SubSteps, 5, profiledSteps)

Var machine As New JointMachineWorkload
machine.Prepare()
machine.WakeAll()
ProfileWorld("joint-machine awake (1 substep)", machine.World, machine.SubSteps, 5, profiledSteps)

Var demo As New DemoBenchmarkSceneWorkload
demo.Prepare()
ProfileWorld("demo-benchmark-pyramid (4 substeps)", demo.World, demo.SubSteps, 3, profiledSteps)
End Sub
End Class

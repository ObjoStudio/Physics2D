Class Stage5BroadPhasePairsScenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As BroadPhasePairsWorkload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage5-broadphase-pairs"
Me.Description = "Moves 32 of 512 dynamic proxies among kinematic and static trees and reports pairs."
Me.WarmupIterations = 5
Me.MeasuredIterations = 20
Me.mWorkload = New BroadPhasePairsWorkload
End Constructor

## Describes the broad-phase parameters.
Override Function Parameters() As String
Return "dynamic=512,kinematic=128,static=128,movers=32"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured iteration.
Override Sub Run()
Me.mWorkload.Execute()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.FoldedChecksum()
End Function
End Class

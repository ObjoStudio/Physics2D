# Stage 9 benchmark scenario wrapping the joint chain workload.
Import Physics2D

Class Stage9JointChainScenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As JointChainWorkload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage9-joint-chain-60"
Me.Description = "Steps a 60-link distance-joint chain (60 dynamic bodies) through the full Stage 9 solver four times per iteration."
Me.WarmupIterations = 3
Me.MeasuredIterations = 8
Me.mWorkload = New JointChainWorkload
End Constructor

## Describes the chain parameters.
Override Function Parameters() As String
Return "links=60,bodies=60,joints=60,steps=4,hz=60"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured iteration.
Override Sub Run()
Me.mWorkload.RunKernels()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.Checksum()
End Function
End Class

Class Stage2TreeIndexedScenario Inherits BenchmarkScenario
## Wrapped tree candidate.
Private Property mTree As Stage2TreeCandidate

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage2-tree-indexed"
Me.Description = "Dynamic tree workload over a parallel-array node pool with free list."
Me.WarmupIterations = 5
Me.MeasuredIterations = 20
Me.mTree = New IndexedTreeCandidate
End Constructor

## Describes the shared tree workload parameters.
Override Function Parameters() As String
Return "proxies=2000,queries=1000,moves=800,churn=200"
End Function

## Builds tree storage.
Override Sub Prepare()
Me.mTree.Prepare()
End Sub

## Runs one measured iteration of the tree workload.
Override Sub Run()
Me.mTree.Execute()
End Sub

## Returns the tree's folded checksum.
Override Function Checksum() As Integer
Return Me.mTree.FoldedChecksum()
End Function
End Class


# Stage 2 representation bake-off scenarios.
#
# Thin BenchmarkScenario wrappers around the six body-state store candidates
# and the two tree candidates. Every scenario runs five unmeasured warm-up
# iterations and twenty measured iterations; the folded store checksums prove
# all candidates performed identical work.
Class Stage2ObjectNodesScenario Inherits BenchmarkScenario
## Wrapped store candidate.
Private Property mStore As Stage2BodyStore

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage2-object-nodes"
Me.Description = "10k bodies as objects with Vector2 children running full body kernels."
Me.WarmupIterations = 5
Me.MeasuredIterations = 20
Me.mStore = New ObjectNodeBodyStore
End Constructor

## Describes the shared body kernel parameters.
Override Function Parameters() As String
Return "bodies=10000,substeps=4,contacts=1500"
End Function

## Builds store state.
Override Sub Prepare()
Me.mStore.Prepare()
End Sub

## Runs one measured iteration of every body kernel.
Override Sub Run()
Me.mStore.Execute()
End Sub

## Returns the store's folded checksum.
Override Function Checksum() As Integer
Return Me.mStore.FoldedChecksum()
End Function
End Class


Class Stage3ScratchListsScenario Inherits BenchmarkScenario
## Wrapped workload.
Private Property mWorkload As Stage3Workload

## Creates the scenario.
Constructor()
Super.Constructor()
Me.Name = "stage3-scratch-lists"
Me.Description = "IntegerList and DoubleList scratch arenas: fill 10000, 3000 swap removals, 100 pops."
Me.WarmupIterations = 5
Me.MeasuredIterations = 20
Me.mWorkload = New ScratchListWorkload
End Constructor

## Describes the scratch parameters.
Override Function Parameters() As String
Return "elements=10000,removals=3000,pops=100"
End Function

## Builds workload state.
Override Sub Prepare()
Me.mWorkload.Prepare()
End Sub

## Runs one measured scratch iteration.
Override Sub Run()
Me.mWorkload.Execute()
End Sub

## Returns the workload's folded checksum.
Override Function Checksum() As Integer
Return Me.mWorkload.FoldedChecksum()
End Function
End Class

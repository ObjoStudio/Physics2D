Public Sub TestWorkloadSampleBuffersAreSized()
Var workloads() As Stage3Workload
workloads = New Array(Of Stage3Workload)
workloads.Append(New SlotPoolWorkload)
workloads.Append(New BitSetWorkload)
workloads.Append(New PairKeySetWorkload)
workloads.Append(New ScratchListWorkload)
Var expectedSamples() As Integer
expectedSamples = New Array(Of Integer)
expectedSamples.Append(3)
expectedSamples.Append(4)
expectedSamples.Append(2)
expectedSamples.Append(3)
For i As Integer = 0 To workloads.Count - 1
workloads[i].Prepare()
workloads[i].Execute()
Assert.Equal(expectedSamples[i], workloads[i].SampleCount, "workload " + i.ToString() + " must fill exactly its declared samples")
Assert.True(workloads[i].FoldedChecksum() <> 0, "workload " + i.ToString() + " checksum must be nonzero")
Next i
End Sub
End Class

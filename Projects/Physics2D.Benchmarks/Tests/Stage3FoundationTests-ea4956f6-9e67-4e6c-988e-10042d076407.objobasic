# Stage 3 foundation container gates.
#
# Every workload must be deterministic (identical folded checksums across
# consecutive iterations) and must execute a warmed iteration without any
# allocation, which is the foundation requirement for the zero-allocation
# step path.
Import Physics2D

Class Stage3FoundationTests Inherits TestCase
Public Sub TestSlotPoolWorkloadIsDeterministicAndAllocationFree()
Var workload As New SlotPoolWorkload
workload.Prepare()
workload.Execute()
Var checksum As Integer = workload.FoldedChecksum()
workload.Execute()
Assert.Equal(checksum, workload.FoldedChecksum(), "slot pool workload diverged between iterations")
Var before As Integer = System.AllocationCount
workload.Execute()
Var after As Integer = System.AllocationCount
Assert.Equal(0, after - before, "warmed slot pool iteration must not allocate")
End Sub

